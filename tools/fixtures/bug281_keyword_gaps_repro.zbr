# BUG-281 repro — the families that are STILL OPEN. A, C, D and F were fixed in both
# compilers on 2026-08-12 and their shapes moved into test/bug280_keyword_idents.zbr,
# where the gate and smoke both see them. What is left:
#
#   B  a class/struct NAMED for a Zig keyword   -> `pub const opaque = struct {`
#   E  a METHOD named for a Zig keyword         -> `pub fn volatile(self: ...)`
#   G  a TOP-LEVEL FN named for a Zig keyword   -> bootstrap only; the SELFHOST is
#                                                  immune because it already prefixes
#                                                  the name (`_zbr_fn_anyframe`)
#
# NEITHER COMPILER CAN BUILD THIS, which is why it lives here and not in test/. A corpus
# file in that state would put full_sweep, smoke and registration_check in the red for
# debt that is already filed and understood. Move each shape into the test/ fixture as it
# is fixed, and delete this file when the last one goes.
#
# READ THE EMITTED .zig, NOT the compiler's first complaint — Zig stops at the first
# parse error, so one broken family masks the rest:
#
#   $ zebra-bootstrap --emit-zig tools/fixtures/bug281_keyword_gaps_repro.zbr > p.zig
#   $ grep -nwE 'align|volatile|opaque|packed|noalias|anyframe' p.zig
#
# AND WIDEN IT BEFORE BELIEVING A FAMILY COUNT. This bug was filed as three families
# because the first probe reached three; adding an enum member, a union variant, a method
# name, a top-level fn name and a bare field read turned up four more in one emit.

# ── family B: the type NAME itself ───────────────────────────────────────────────
class opaque
    var count: int = 0

    def get(): int
        return .count

# ── family E: a METHOD named for a keyword — declaration AND call site ───────────
class Holder
    var count: int = 5

    def volatile(): int
        return .count

# ── family G: a TOP-LEVEL fn named for a keyword (bootstrap only) ────────────────
def anyframe(): int
    return 1

def main()
    var o = opaque()
    o.count = 4
    print(o.get())

    var h = Holder()
    print(h.volatile())

    print(anyframe())

    print("bug281 probe: emitted")
