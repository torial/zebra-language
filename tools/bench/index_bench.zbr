# IN-PROCESS index benchmark. Not a test -- a measuring instrument.
#
# External `time`-the-process benchmarking could not resolve the BUG-313 bounds-check cost:
# on an IDLE machine the MINIMUM over 15 rounds still moved 517 / 555 / 560 ms for the same
# binary, so process-level noise alone was ~8%, and one unlucky batch produced a "91%"
# reading that later runs put nearer 14%.
#
# Timing INSIDE the process removes startup, loader and first-touch costs from the sample,
# and makes many rounds cheap enough to take the minimum of a large number of them.
#
# Reports the BEST round, because the best round is the one least interfered with. Also
# reports the worst, so the reader can see the spread and judge whether the best is trusted.
def matvec(M: List(List(float)), v: List(float), out: List(float))
    var i = 0
    while i < M.len
        var row = M.at(i)
        var s: float = 0.0
        var j = 0
        while j < v.len
            s += row.at(j) * v.at(j)
            j += 1
        out.set(i, s)
        i += 1

def main()
    var n = 128
    var M = List(List(float))()
    var i = 0
    while i < n
        var row = List(float)()
        var j = 0
        while j < n
            row.add(0.001 * (i + j).toFloat())
            j += 1
        M.add(row)
        i += 1
    var v = List(float)()
    var out = List(float)()
    i = 0
    while i < n
        v.add(0.5)
        out.add(0.0)
        i += 1

    var best: int = 999999999
    var worst: int = 0
    var rounds = 0
    while rounds < 25
        var t0 = DateTime.now().toEpoch()
        var c = 0
        while c < 12000
            matvec(M, v, out)
            c += 1
        var t1 = DateTime.now().toEpoch()
        var d = t1 - t0
        if d < best
            best = d
        if d > worst
            worst = d
        rounds += 1

    # a checksum so the work cannot be optimised away, printed LAST so the timings parse first
    var chk: float = 0.0
    i = 0
    while i < n
        chk += out.at(i)
        i += 1
    print("best ${best} worst ${worst} checksum ${chk}")
