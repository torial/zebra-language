# A dialog needs the window, so it belongs to the VIEW; a button only sends a message.
# The idiom (zebra-ide's): update records WHICH dialog was asked for, the next render
# shows it and sends the answer as a message, and update clears the request.
struct Model
    var path: str
    var status: str
    var want: int          # 0 none, 1 open, 2 save, 3 folder, 4 alert, 5 error

union Msg
    ask: int
    opened: str
    saved: str
    foldered: str
    shown

def init(): Model
    return Model(path: "", status: "No dialog opened yet", want: 0)

def update(model: Model, msg: Msg): Model
    branch msg
        on Msg.ask as which
            return model except want = which
        on Msg.opened as p
            return Model(path: p, status: "Opened: " + p, want: 0)
        on Msg.saved as p
            return Model(path: p, status: "Saved: " + p, want: 0)
        on Msg.foldered as p
            return Model(path: p, status: "Folder: " + p, want: 0)
        on Msg.shown
            return model except want = 0

def view(g: Gui, model: Model)
    g.text("File Dialog Smoke Test")
    g.text("Status: " + model.status)
    g.separator()
    g.button("Open File", Msg.ask(1))
    g.button("Save File", Msg.ask(2))
    g.button("Open Folder", Msg.ask(3))
    g.separator()
    g.button("Show Alert", Msg.ask(4))
    g.button("Show Error", Msg.ask(5))
    # the dialog asked for last update, shown on this render
    if model.want == 1
        var p = g.openFile()
        if p as path
            g.send(Msg.opened(path))
        else
            g.send(Msg.shown)
    else if model.want == 2
        var p = g.saveFile()
        if p as path
            g.send(Msg.saved(path))
        else
            g.send(Msg.shown)
    else if model.want == 3
        var p = g.openFolder()
        if p as path
            g.send(Msg.foldered(path))
        else
            g.send(Msg.shown)
    else if model.want == 4
        g.msgBox("File Dialogs", "All three dialog types are working.")
        g.send(Msg.shown)
    else if model.want == 5
        g.msgBoxError("Error", "This is an error message box.")
        g.send(Msg.shown)

def main()
    Gui.run("File Dialog Smoke", 400, 300, init, update, view)
