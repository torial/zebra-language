        return "/\\/\\/\\===\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\=====\\/\\/\\/\\/\\/\\/\\/\\/\\/^^==^^^^^|||^^^^^^^^^/\\/\\/\\"
    if y == 25
        return "/\\/\\/A=\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^==^^^^|||^^^^^^^^/\\/\\/\\/\\"
    if y == 26
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^==^^^^|||^^^^^^^\\/\\/\\/\\/\\"
