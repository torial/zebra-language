    if y == 28
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^==^^^^|||^^^^^^^^\\/\\/\\/\\/\\"
    if y == 29
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^==^^^^|||^^^^^^/\\/\\/\\/\\/\\"
    return ""

def tileAt(x: int, y: int): str
    if x < 0 or y < 0 or y > 29 or x > 79
        return "/"
    var row = mapRow(y)
    return row[x..x + 1]

def isPassable(tile: str): bool
    if tile == "=" or tile == "." or tile == "^"
        return true
    if tile == "A" or tile == "T" or tile == "H" or tile == "C"
        return true
    return false

# The eleven canonical encounter points from MapCreationHelper's bulk-add.
def isEncounterPoint(x: int, y: int): bool
    if x == 7 and y == 24
        return true
    if x == 15 and y == 21
        return true
    if x == 23 and y == 20
        return true
    if x == 23 and y == 11
        return true
    if x == 29 and y == 10
        return true
    if x == 33 and y == 7
        return true
    if x == 38 and y == 6
        return true
    if x == 45 and y == 5
        return true
    if x == 52 and y == 4
        return true
    if x == 55 and y == 28
        return true
    if x == 38 and y == 22
        return true
    return false

def encFlag(x: int, y: int): str
    return "E" + x.toString() + "_" + y.toString()

def dropFlag(m: GameModel, f: str): GameModel
    var out: List(str) = []
    var i = 0
    while i < m.states.len
        if m.states.at(i) != f
            out.add(m.states.at(i))
        i = i + 1
    return m except states = out

# An ambush at a canonical point: fresh Ruffians, initiative by difficulty,
# OnRoad flag so victory returns to the map.
def roadBattle(model: GameModel): GameModel
    var m = withFlag(model, "OnRoad")
    m = m except e0Hp = 20, e1Hp = 20, round = 1
    m = withLog(m, "Ruffians spring from the rocks!")
    if playerFirst(m.diff, levelAgi(m), 30)
        return m except phase = 1
    return m except phase = 3

# One step of travel: passability, healing, encounters, and Thas arrival.
def tryMove(model: GameModel, dx: int, dy: int): GameModel
    var nx = model.px + dx
    var ny = model.py + dy
    var tile = tileAt(nx, ny)
    if not isPassable(tile)
        return model
    var m = model except px = nx, py = ny
    var heal = 2 - m.diff
    var cap = levelMaxHp(m)
    if heal > 0 and m.pHp < cap
        var nh = m.pHp + heal
        if nh > cap
            nh = cap
        m = m except pHp = nh
    if tile == "T"
        m = withLog(m, "The walls of Thas rise before you.")
        return m except phase = 8, story = 0
    if isEncounterPoint(nx, ny)
        if not hasFlag(m, encFlag(nx, ny))
            m = withFlag(m, encFlag(nx, ny))
            return roadBattle(m)
    return m

def resumeWalk(model: GameModel): GameModel
    var m = dropFlag(model, "OnRoad")
    return m except phase = 11

# ---------------------------------------------------------------------------
# Save / Load (the C#'s Save/New/Open, ported small): one line-per-field file.
# Saving is offered while on the map ("Make camp"); loading from the title.
# NOTE: File IO inside update() is a deliberate MVU impurity, confined to
# these two handlers.
# ---------------------------------------------------------------------------

def saveGame(m: GameModel): GameModel
    var sb: StringBuilder = StringBuilder()
    sb.append("tears-save-v1\n")
    sb.append(m.diff.toString() + "\n")
    sb.append(m.pHp.toString() + "\n")
    sb.append(m.xp.toString() + "\n")
    sb.append(m.level.toString() + "\n")
    sb.append(m.px.toString() + "\n")
    sb.append(m.py.toString() + "\n")
    sb.append(m.rngSeed.toString() + "\n")
    var i = 0
    var flags = ""
    while i < m.states.len
        if i > 0
            flags = flags + ";"
        flags = flags + m.states.at(i)
        i = i + 1
    sb.append(flags + "\n")
    File.write("tears_save.txt", sb.build())
    return withLog(m, "Yehu makes camp; the journey is recorded.")

def loadGame(): GameModel
    var m = init()
    if not File.exists("tears_save.txt")
        return m
    var src = File.read("tears_save.txt")
    var lines: List(str) = []
    for ln in src.split("\n")
        lines.add(ln)
    if lines.len < 9 or lines.at(0) != "tears-save-v1"
        return m
    m = m except diff = lines.at(1).toInt(), pHp = lines.at(2).toInt(), xp = lines.at(3).toInt(), level = lines.at(4).toInt(), px = lines.at(5).toInt(), py = lines.at(6).toInt(), rngSeed = lines.at(7).toInt()
    var st: List(str) = []
    if lines.at(8) != ""
        for f in lines.at(8).split(";")
            st.add(f)
    m = m except states = st, phase = 11, story = 0
    return withLog(m, "The recorded journey resumes.")

def startJourney(model: GameModel, diff: int): GameModel
    var m = model except diff = diff, phase = 11, px = 5, py = 25
    return withLog(m, "On " + diffName(diff) + " -- Yehu sets out from Arna for Thas.")

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Phases: 0 title  1 chooseWeapon  2 chooseTarget  3 enemyTurn
#         4 won    5 lost          6 fled
#         7 story (intro pages)    8 epilogue (post-victory pages)
#         9 mission: The Cubs of Thas (model.story = scene id)

struct GameModel
    var phase: int
    var diff: int
    var pHp: int
    var e0Hp: int
    var e1Hp: int
    var selWeapon: int
    var round: int
    var xp: int
    var level: int
    var story: int
    var states: List(str)
    var px: int
    var py: int
    var rngSeed: int
    var log: List(str)

union Msg
    selEasy
    selMedium
    selHard
    atkSword
    atkBow
    tgt0
    tgt1
    doFlee
    enemyTurn
    restart
    pageNext
    getCubs
    contTale
    startMission
    mA
    mB
    mC
    mvN
    mvS
    mvW
    mvE
    walkOn
    saveCamp
    loadCamp
    embRide

def init(): GameModel
    var seed = Random.randInt(1, 2000000000)
    var noFlags: List(str) = []
    return GameModel(phase: 7, diff: 1, pHp: 35, e0Hp: 20, e1Hp: 20, selWeapon: 0, round: 1, xp: 0, level: 1, story: 0, states: noFlags, px: 5, py: 25, rngSeed: seed, log: ["Two Ruffians block the mountain road. Yehu draws his blade."])

# ---------------------------------------------------------------------------
# MISSION: The Cubs of Thas (phase 9) — the untold interior of Episode I.
# ---------------------------------------------------------------------------
# The novella (Episode 1, ch. 5-6) sends Commander Yehu's score into Thas by
# the slave-ruse and then follows Gratta; the infiltration itself happens
# offstage ("the Torialites have freed the cubs but will be overwhelmed").
# This mission composes that interior, contradicting nothing: the sale at the
# gate (Aidden's haggling, Lamek, one hundred shekels), the split of the
# score, the pen with its fifty guards, the barel's judgment, Gratta at the
# gate-beam, and Namal's flaming spear at the bridge. Its moral spine is
# Keanna's rebuke: the battle is won by waiting for Yah Elyon's sign, not by
# the strength of the score. Scene data are pure functions; the player's
# flags ride model.states (the DecisionEngine criteria idea, ported small).

def hasFlag(model: GameModel, f: str): bool
    var i = 0
    while i < model.states.len
        if model.states.at(i) == f
            return true
        i = i + 1
    return false

def withFlag(m: GameModel, f: str): GameModel
    var st = m.states
    st.add(f)
    return m except states = st

def missionPage(model: GameModel): str
    var id = model.story
    if id == 0
        return "[ The camp before Thas -- night ]||Aidden: 'Commander Yehu -- gather a score of your|mightiest men. We have a mission with need of great|deeds of valor.'||The plan is madness dressed as commerce: sell Chief|Gratta at the market of Thas, walk in as slavers, and|be inside the walls when the hour comes. Gratta bears|Arphad's wound -- the gift of truth."
    if id == 1
        return "[ The gates of Thas -- early dawn ]||A maeuw soldier prods Gratta with a spear. 'His|sickness is not fatal. You may sell him at the|market.'||Aidden haggles like a bandit born; Lamek of the gold|robes pays one hundred shekels. The gates of Thas|stand open, and your score walks in with the crowd --|spears low, eyes lower."
    if id == 2
        return "[ The streets of Thas ]||Perfume and torchlight. The cub-pen lies north by the|old cave; the gate-house south. A patrol rounds the|corner ahead: helmeted maeuw, spears slung, bored and|dangerous."
    if id == 3
        if hasFlag(model, "Alarm")
            return "[ The cub-pen -- north quarter ]||Horns still sound behind you from the bluff gone|wrong. Behind iron bars, tuon cubs huddle leashed|neck to neck. You count the guards twice and twice|despair: fifty maeuw, whips and spears -- and now|they are awake."
        return "[ The cub-pen -- north quarter ]||Behind iron bars, tuon cubs huddle in the dark,|leashed neck to neck. You count the guards twice and|twice despair: fifty maeuw, whips and spears, and the|pen in torchlight.||Ten men cannot do this. Nor twenty."
    if id == 4
        if hasFlag(model, "Struck")
            return "[ Blood at the pen ]||Your men take down six guards before the horns sound|the quarter awake -- and still the fifty come on.||Then the light comes down the road anyway, unasked. A|wind where no wind should be; the guards fall|convulsing. You live because heaven outran your plan.|Around you, three of your own lie still."
        return "[ The turning of the hour ]||A wind rises inside the walls where no wind should|be. Down the main road walks a light in the shape of|a maeuw, and the torches gutter before it.||The guards nearest the pen crouch and convulse. A|voice that is not a sound says: FREE THE CUBS. I WILL|BE YOUR WALL."
    if id == 5
        return "[ The south gate ]||Cubs at your back; the gate-team at the beam. Chief|Gratta comes leaping the crouching guards, tosses the|cross-beam aside and hauls the doors wide.||'I WILL NOW ASSIST MY COMPANION IN JUDGMENT. HURRY.'||Keanna the Judge runs beside you toward the bridge."
    if id == 6
        return "[ The bridge over the Yellow Snake ]||Hooves behind: fifty riders, and at their head a|maeuw in brilliant robes. Namal.||He levels a spear at Keanna: 'I call down fiery wrath|upon you!' -- and the spear takes fire in the air as|it flies."
    # id 7 — endings by flags
    if hasFlag(model, "SavedKeanna")
        if hasFlag(model, "Waited")
            return "[ Morning on the far bank ]||The spear splits the planks where Keanna stood; you|taste smoke and river fog. Namal falls before Gratta|and Aidden, and the riders break.||Keanna finds you after. 'El Roi saw you wait, and saw|you dive. Tell your children, human: the battle was|never yours to win -- only yours to be faithful in.'||[ ENDING: The Faithful Score ]"
        return "[ Morning on the far bank ]||Namal falls; the riders break; the cubs are counted|twice and all are living. But three cairns stand by|the road for the men the pen took.||Keanna binds your arm in silence, then: 'Valor is a|good servant and a poor master. Next time, wait for|the wall.'||[ ENDING: Valor and Graves ]"
    return "[ Morning on the far bank ]||You held the line and the line held -- but it was a|blazing hand from heaven that turned the spear, not|yours. Keanna rises from the planks unaided and looks|at you a long moment, saying nothing at all.||The cubs are safe. The song, when they sing it, will|not carry your name.||[ ENDING: The Unbent Line ]"

# Choice labels per scene ("" = no second choice).
def missionChoiceA(model: GameModel): str
    var id = model.story
    if id == 0
        return "March at dawn"
    if id == 1
        return "Split the score -- ten to the pen, ten to the gates"
    if id == 2
        return "Melt into an alley and let the patrol pass"
    if id == 3
        return "Strike now, while surprise is yours"
    if id == 4
        return "Break the pen"
    if id == 5
        return "To the bridge"
    if id == 6
        return "Dive -- knock her clear"
    return "Sing the song of the day"

def missionChoiceB(model: GameModel): str
    var id = model.story
    if id == 1
        return "Keep the score together"
    if id == 2
        return "Bluff as slavers seeking the market"
    if id == 3
        return "Hold. Watch. The tuon say Yah Elyon sees"
    if id == 6
        return "Hold your line at the beam"
    return ""

# The mission FSM: pure, deterministic, testable.
def missionStep(model: GameModel, pickB: bool): GameModel
    var id = model.story
    if id == 0
        return model except story = 1
    if id == 1
        var m1 = model
        if not pickB
            m1 = withFlag(m1, "Split")
        return m1 except story = 2
    if id == 2
        # Bluffing works only with the papers-of-sale story a split team
        # keeps straight; a bunched score bluffing raises the alarm.
        var m2 = model
        if pickB and not hasFlag(m2, "Split")
            m2 = withFlag(m2, "Alarm")
        return m2 except story = 3
    if id == 3
        var m3 = model
        if pickB
            m3 = withFlag(m3, "Waited")
        else
            m3 = withFlag(m3, "Struck")
        return m3 except story = 4
    if id == 4
        var m4 = withFlag(model, "CubsFree")
        return m4 except story = 5
    if id == 5
        return model except story = 6
    if id == 6
        var m6 = model
        if not pickB
            m6 = withFlag(m6, "SavedKeanna")
        return m6 except story = 7
    # the mission's last page leads to the victory feast and its singers
    return model except phase = 10, story = 0

# ---------------------------------------------------------------------------
# THE DISPUTE OF SWORD AND BOW (phase 10) -- a playable dispute-poem.
# ---------------------------------------------------------------------------
# The oldest literary genre on record: the Mesopotamian precedence-contest
# (Hoe vs Plough, Sheep vs Grain), carried by Syriac into the church (Ephrem's
# Death and Satan, Carmina Nisibena 52) and by the church into Europe (The Owl
# and the Nightingale). Composed here by Fable in the tale's own world: sung
# at the victory feast, the boasts cite the game's REAL mechanics, and the
# player holds the genre's load-bearing slot -- THE VERDICT. Three crowns:
# Sword or Bow (a god's verdict: one contestant wins), or the third voice the
# refrain taught us: neither boaster, but the Giver of the day.

def disputePage(model: GameModel): str
    var id = model.story
    if id == 0
        return "[ The victory feast, on the far bank ]||Fires and roast squirrels; cubs asleep in a heap of|fur. A tuon singer rises, strikes a rib-bone drum,|and calls in the old meter:||'I HEARD THE SWORD AND THE BOW DISPUTING|WHICH WAS STRONGER THAN THE OTHER IN THE HAND|OF YEHU.'"
    if id == 1
        return "[ The Sword's boast ]||'Sister, I am your better; I take precedence over|you. Fifteen wounds ride every blow of mine, and one|stroke in five finds the vital and deals twenty-five.|I end what I begin. At my length there is no doubt,|no wind, no mercy of distance. The bridge remembers|me; ask Namal if the far hill saved him.'"
    if id == 2
        return "[ The Bow's answer ]||'Brother, your reach is an arm and a boast. I answer|quarrels before they arrive: twelve wounds from the|far hill, and my sharpest one in seven strikes for|twenty-five. I kept watch when the score walked the|streets of Thas; I am the wall a coward calls|cowardice. You drink blood at spear-length -- I|decline the invitation.'"
    if id == 3
        return "[ The second round ]||Sword: 'The wind owns half your arrows; my edge pays|no tax to weather.'||Bow: 'And the night owns all your reach. When the|riders came four abreast, who thinned them before|they were upon us?'||The singer lifts a paw: the boasts are spent. 'WHO|SHALL JUDGE BETWEEN THEM?' -- and the feast looks|at YOU."
    if hasFlag(model, "CrownSword")
        return "[ The verdict of the feast ]||'The SWORD takes precedence,' you say, and the tuon|roar approval, for the tuon love the close red work.|The singer crowns the hilt with a wreath of river|reeds.||But the Bow unstrings itself in silence, and out on|the dark road, distance keeps its own opinion.||[ The song ends as songs of Sumer ended: one crowned,|one bowed. The feast is content. ]"
    if hasFlag(model, "CrownBow")
        return "[ The verdict of the feast ]||'The BOW takes precedence,' you say, and the cubs|cheer, for it was arrows that watched over their|leashes. The singer nets the bow in a wreath of|hawk-feathers.||The Sword says nothing, being a sword; but at the|next bridge there will be work no feather reaches.||[ The song ends as songs of Sumer ended: one crowned,|one bowed. The feast is content. ]"
    return "[ The verdict of the feast ]||'Neither,' you say, and the fires gutter as if a wind|crossed them. 'The Sword missed four times on the|road, and the Bow hung idle at the pen. The day was|not won at any length of arm.'||You lift the cup instead: 'TO YOU BE GLORY, YAH|ELYON, SHEPHERD OF ALL -- who saved the flock from|the hidden wolves that had swallowed it.'||The singer is quiet a long moment. Then: 'The wisest|verdict is the oldest one made new. Neither blade nor|string -- the Hand above the hand.'||[ ENDING: The Third Voice -- and the feast sings the|refrain until the stars change watch. ]"

def disputeChoiceA(model: GameModel): str
    if model.story < 3
        return "Hear more"
    if model.story == 3
        return "Crown the Sword"
    return "Let the feast burn low"

def disputeChoiceB(model: GameModel): str
    if model.story == 3
        return "Crown the Bow"
    return ""

def disputeChoiceC(model: GameModel): str
    if model.story == 3
        return "Crown neither -- honor the Giver of the day"
    return ""

def disputeStep(model: GameModel, pick: int): GameModel
    if model.story < 3
        return model except story = model.story + 1
    if model.story == 3
        var m = model
        if pick == 0
            m = withFlag(m, "CrownSword")
        if pick == 1
            m = withFlag(m, "CrownBow")
        if pick == 2
            m = withFlag(m, "CrownGiver")
        return m except story = 4
    # the feast burns low, and the king has one more errand: Episode II
    return model except phase = 12, story = 0


# ---------------------------------------------------------------------------
# EPISODE II MISSION: THE HERALD'S ROAD (phase 12)
# ---------------------------------------------------------------------------
# Composed canon-interior from the full read of Shadow of Ikral (see
# tears_episode2_script.md): Yehu's UNNAMED dangerous mission (Ikral ch.4-6,
# offstage in the novella; El Roi's charter for it spoken in ch.2). Anayah
# sends Yehu to the Prince of Pyrr to tell the Clans what Thas meant before
# they decide it themselves. Moral spine: Episode I taught patience (wait for
# the sign); this one teaches CANDOR (the truth, told whole). Episode III --
# the road to Muze -- is Sean's, and the Open Door ending points at it.

def ep2Page(model: GameModel): str
    var id = model.story
    if id == 0
        return "[ Nurah -- the throne room, at night ]||Anayah, off the record, his voice low: 'The cats|will decide this season what Thas MEANT. I would|have them hear it from the man who was inside it.||You will carry no treaty, Commander -- only the|truth, told whole. That is the more dangerous|cargo.'"
    if id == 1
        return "[ The ford at the border river ]||Keanna waits at the crossing as if appointed. 'El|Roi mentioned you would be passing,' she says, and|does not explain.||The road beyond is Lyssan country, and the bull-mark|of Ikral has been seen on the waystones."
    if id == 2
        return "[ The burned waystation ]||The parasa post stands scorched and empty, the|king's banner torn down, Ikral's bull chalked on the|door. Whoever did this did not fear the crown.||Night is coming. The forest ahead is dark and close."
    if id == 3
        if hasFlag(model, "Watched")
            return "[ The grove before the border ]||They step from the trees at dusk: red-haired men|with bull-amulets, spears low. Pilisian zealots of|Ikral.||'The cat-woman is a blasphemer of Ikral,' their|leader spits, 'and you her dog.'||You counted them last night from the cold camp: nine|men -- and a leader who flinched at the king's name."
        return "[ The grove before the border ]||They step from the trees at dusk: red-haired men|with bull-amulets, spears low. Pilisian zealots of|Ikral.||'The cat-woman is a blasphemer of Ikral,' their|leader spits, 'and you her dog.'"
    if id == 4
        return "[ Pyrr -- the small hall of a small clan ]||No throne. A mat, a low table, the Prince pouring|the tea himself while the Elders watch from the|walls.||He asks one question only: 'Tell me what my Judge|could not see from inside a cell. WHY did your|people come to Thas?'"
    if id == 5
        return "[ The feast of the clans ]||An Elder of another clan rises, cup high: 'Let our|guests honor the gods of every land, as courtesy|commands.' The court turns. Keanna goes very still.||The cup is poured and waiting."
    if id == 6
        return "[ The Prince's garden, before dawn ]||He is alone, and smaller than his word. 'My command|was despised in Thas until the day fire vindicated|it. I do not know your god, soldier. But what I|commanded and what he judged were the same thing.||Tell me. Does El Roi SEE a maeuw?'"
    # id 7 -- endings
    if hasFlag(model, "PrinceHeart")
        return "[ The road home ]||The Prince sends you out with a small carved token:|'For the day my clans and your king must speak|again.'||At the ford Keanna reins in. 'Matisyahu fasted for|you daily at the temple. His fasting was not wasted|-- though he will never know what it bought.'||[ ENDING: The Open Door ]||EPISODE III: the road to MUZE awaits."
    if hasFlag(model, "Bowed")
        return "[ The road home ]||The Elders toasted the flexible human twice. The|Prince did not appear again.||At the burned waystation men stand posted once more|-- wearing the bull-amulet openly now.||[ ENDING: The Poured Cup -- some doors close|politely. ]"
    return "[ The road home ]||Peace, of a thinner kind. The Prince bowed exactly|as low as protocol required, and no lower.||Keanna rides in silence until the ford. 'You told|them a smaller Thas than the one that happened.|Smaller truths buy smaller peaces.'||[ ENDING: The Sealed Account ]"

def ep2ChoiceA(model: GameModel): str
    var id = model.story
    if id == 0
        return "Take the road south"
    if id == 1
        return "Ask the Judge to ride with you"
    if id == 2
        return "Press on by night"
    if id == 3
        return "Draw and fight"
    if id == 4
        return "The whole truth -- cubs, ruse, and a judgment that was no man's"
    if id == 5
        return "Set the cup down: 'My God watches me even here'"
    if id == 6
        return "Answer with the Judge's own commission"
    return "Ride home to Nurah"

def ep2ChoiceB(model: GameModel): str
    var id = model.story
    if id == 1
        return "Decline, to spare her the road"
    if id == 2
        return "Camp cold and watch the road"
    if id == 3
        if hasFlag(model, "Watched")
            return "Invoke the king -- and Ikral's own honor"
        return ""
    if id == 4
        return "The polished truth -- the judgment left vague"
    if id == 5
        return "Pour the libation -- courtesy is cheap"
    return ""

def ep2Step(model: GameModel, pickedB: bool): GameModel
    var id = model.story
    if id == 0
        return model except story = 1
    if id == 1
        var m1 = model
        if not pickedB
            m1 = withFlag(m1, "Escort")
        return m1 except story = 2
    if id == 2
        var m2 = model
        if pickedB
            m2 = withFlag(m2, "Watched")
        return m2 except story = 3
    if id == 3
        # the Matisyahu gambit needs the cold camp's knowledge; otherwise steel
        if pickedB and hasFlag(model, "Watched")
            return model except story = 4
        var m3 = withFlag(model, "RoadBlood")
        m3 = withFlag(m3, "OnEmbassy")
        m3 = m3 except e0Hp = 20, e1Hp = 20, round = 1
        m3 = withLog(m3, "The zealots close in with spears!")
        if playerFirst(m3.diff, levelAgi(m3), 30)
            return m3 except phase = 1
        return m3 except phase = 3
    if id == 4
        var m4 = model
        if pickedB
            m4 = withFlag(m4, "TruthShaded")
        else
            m4 = withFlag(m4, "TruthTold")
        return m4 except story = 5
    if id == 5
        var m5 = model
        if pickedB
            m5 = withFlag(m5, "Bowed")
        if hasFlag(m5, "TruthTold") and not hasFlag(m5, "Bowed")
            return m5 except story = 6
        return m5 except story = 7
    if id == 6
        var m6 = withFlag(model, "PrinceHeart")
        return m6 except story = 7
    return init()

def rideOn(model: GameModel): GameModel
    var m = dropFlag(model, "OnEmbassy")
    return m except phase = 12, story = 4

# ---------------------------------------------------------------------------
# Update helpers (deterministic given the model's seed — testable)
# ---------------------------------------------------------------------------

def diffName(diff: int): str
    if diff == 0
        return "Easy"
    if diff == 2
        return "Hard"
    return "Medium"

def aliveEnemies(model: GameModel): int
    var n = 0
    if model.e0Hp > 0
        n = n + 1
    if model.e1Hp > 0
        n = n + 1
    return n

# Append a battle-log line functionally. A List field reached through an
# `except`-copy of a const model is a *const pointer, so `m.log.add(...)`
# won't compile; copying the list, appending, and re-binding it does.
def withLog(m: GameModel, line: str): GameModel
    var lg = m.log
    lg.add(line)
    return m except log = lg

# Resolve Yehu's attack (his selected weapon) against enemy `tgt` (0 or 1).
def playerAttack(model: GameModel, tgt: int): GameModel
    var w = swordW()
    if model.selWeapon == 1
        w = bowW()
    var tgtName = "Ruffian A"
    var tgtHp = model.e0Hp
    if tgt == 1
        tgtName = "Ruffian B"
        tgtHp = model.e1Hp
    var out = resolveAttack(model.rngSeed, "Yehu", levelAgi(model), levelStr(model), w, tgtName, 15, 10, true, model.diff)
    var m = model except rngSeed = out.nextSeed
    m = withLog(m, out.message)
    if out.hit
        var nh = tgtHp - out.damage
        if nh < 0
            nh = 0
        if tgt == 0
            m = m except e0Hp = nh
        else
            m = m except e1Hp = nh
        if nh <= 0
            m = withLog(m, tgtName + " collapses.")
    if m.e0Hp <= 0 and m.e1Hp <= 0
        m = withLog(m, "The Ruffians are defeated! Yehu gains 50 experience.")
        m = applyExperience(m, 50)
        return m except phase = 4
    return m except phase = 3

# One enemy attacks Yehu, picking a weapon by the difficulty AI.
def oneEnemyAttack(model: GameModel, which: int): GameModel
    var wi = chooseEnemyWeapon(model.rngSeed, bowW(), daggerW(), model.diff)
    var w = bowW()
    if wi == 1
        w = daggerW()
    var ename = "Ruffian A"
    if which == 1
        ename = "Ruffian B"
    var out = resolveAttack(model.rngSeed, ename, 15, 10, w, "Yehu", levelAgi(model), 10, false, model.diff)
    var m = model except rngSeed = out.nextSeed
    m = withLog(m, out.message)
    if out.hit
        var nh = m.pHp - out.damage
        if nh < 0
            nh = 0
        m = m except pHp = nh
        if nh <= 0
            m = withLog(m, "Yehu collapses!")
    return m

def runEnemyTurn(model: GameModel): GameModel
    var m = model
    if m.e0Hp > 0 and m.pHp > 0
        m = oneEnemyAttack(m, 0)
    if m.e1Hp > 0 and m.pHp > 0
        m = oneEnemyAttack(m, 1)
    if m.pHp <= 0
        return m except phase = 5
    return m except phase = 1, round = m.round + 1

def attemptFlee(model: GameModel): GameModel
    var enemyAgi = aliveEnemies(model) * 15
    var rng = Random.new(model.rngSeed)
    var probe = rng.nextInt(1, 2000000000)
    var m = model except rngSeed = probe
    if tryFlee(model.rngSeed, levelAgi(model), enemyAgi, model.diff)
        m = withLog(m, "Yehu breaks away and escapes down the road.")
        return m except phase = 6
    m = withLog(m, "Yehu tries to flee but the Ruffians cut him off!")
    return m except phase = 3

# ---------------------------------------------------------------------------
# Update
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Leveling (faithful to CombatEngine.ApplyExperienceToPlayer + the Human
# EntityType JSON: thresholds 0,100,200,400... doubling to 409600; each level
# grants +3 Agility, +3 Health, +3 Strength).
# ---------------------------------------------------------------------------

def expLevelMax(level: int): int
    if level <= 1
        return 0
    if level >= 14
        return 409600
    # thresholds double from 100 at level 2
    var maxExp = 100
    var l = 2
    while l < level
        maxExp = maxExp * 2
        l = l + 1
    return maxExp

def levelAgi(m: GameModel): int
    return 25 + (m.level - 1) * 3

def levelStr(m: GameModel): int
    return 15 + (m.level - 1) * 3

def levelMaxHp(m: GameModel): int
    return 35 + (m.level - 1) * 3

# C# do-while: level up while Experience > ExperienceLevels[Level-1].
def applyExperience(model: GameModel, won: int): GameModel
    var m = model except xp = model.xp + won
    while m.level < 14 and m.xp > expLevelMax(m.level)
        m = m except level = m.level + 1
        m = withLog(m, "Yehu leveled up!")
    return m

# "Get the Cubs" (the intro scene's one choice, per the C# original) jumps to
# the port-added bridge page; from the bridge it enters the difficulty title.
def chooseGetCubs(model: GameModel): GameModel
    if model.story < 4
        return model except story = 4
    return model except phase = 0, story = 0

# Advance a story/epilogue page (phase 7 or 8). In the intro, pageNext stops
# at the choice page (the muster) — only Msg.getCubs passes it, so the scene's
# choice is required by the FSM itself, not just by which buttons the view
# happens to draw. The last epilogue page likewise holds (restart is the exit).
def nextPage(model: GameModel): GameModel
    var last = introPageCount() - 1
    if model.phase == 8
        last = epiloguePageCount()
    if model.story + 1 < last
        return model except story = model.story + 1
    return model

# Choice routers: mA/mB serve both the mission (phase 9) and the dispute
# (phase 10); mC is the dispute's third crown only.
def pickA(model: GameModel): GameModel
    if model.phase == 10
        return disputeStep(model, 0)
    if model.phase == 12
        return ep2Step(model, false)
    return missionStep(model, false)

def pickB(model: GameModel): GameModel
    if model.phase == 10
        return disputeStep(model, 1)
    if model.phase == 12
        return ep2Step(model, true)
    return missionStep(model, true)

def update(model: GameModel, msg: Msg): GameModel
    branch msg
        on Msg.selEasy    return startJourney(model, 0)
        on Msg.selMedium  return startJourney(model, 1)
        on Msg.selHard    return startJourney(model, 2)
        on Msg.atkSword   return model except selWeapon = 0, phase = 2
        on Msg.atkBow     return model except selWeapon = 1, phase = 2
        on Msg.tgt0       return playerAttack(model, 0)
        on Msg.tgt1       return playerAttack(model, 1)
        on Msg.doFlee     return attemptFlee(model)
        on Msg.enemyTurn  return runEnemyTurn(model)
        on Msg.restart    return init()
        on Msg.pageNext   return nextPage(model)
        on Msg.getCubs    return chooseGetCubs(model)
        on Msg.contTale   return model except phase = 8, story = 0
        on Msg.startMission  return model except phase = 9, story = 0
        on Msg.mA         return pickA(model)
        on Msg.mB         return pickB(model)
        on Msg.mC         return disputeStep(model, 2)
        on Msg.mvN        return tryMove(model, 0, -1)
        on Msg.mvS        return tryMove(model, 0, 1)
        on Msg.mvW        return tryMove(model, -1, 0)
        on Msg.mvE        return tryMove(model, 1, 0)
        on Msg.walkOn     return resumeWalk(model)
        on Msg.saveCamp   return saveGame(model)
        on Msg.loadCamp   return loadGame()
        on Msg.embRide    return rideOn(model)

# ---------------------------------------------------------------------------
# View
# ---------------------------------------------------------------------------

def drawHud(g: Gui, model: GameModel)
    g.text("Round " + model.round.toString() + "   (" + diffName(model.diff) + ")")
    g.text("Yehu  Lv" + model.level.toString() + "  HP " + model.pHp.toString() + "/" + levelMaxHp(model).toString())
    var a = "down"
    if model.e0Hp > 0
        a = model.e0Hp.toString() + "/20"
    var b = "down"
    if model.e1Hp > 0
        b = model.e1Hp.toString() + "/20"
    g.text("Ruffian A  HP " + a)
    g.text("Ruffian B  HP " + b)
    g.separator()

def drawLog(g: Gui, model: GameModel)
    g.separator()
    var total = model.log.len
    var start = 0
    if total > 8
        start = total - 8
    var i = start
    while i < total
        g.text(model.log.at(i))
        i = i + 1

def viewTitle(g: Gui, model: GameModel)
    g.text("A pair of Ruffians blocks the road. Choose your trial:")
    g.separator()
    if g.button("Easy   — Yehu strikes first, fortune favours him")
        g.send(Msg.selEasy)
    if g.button("Medium — a fair fight")
        g.send(Msg.selMedium)
    if g.button("Hard   — the Ruffians are quick and cruel")
        g.send(Msg.selHard)
    if g.button("Resume a recorded journey")
        g.send(Msg.loadCamp)

def viewChooseWeapon(g: Gui, model: GameModel)
    drawHud(g, model)
    g.text("Yehu's move — attack with which weapon?")
    if g.button("Attack with Sword  (stabs, dmg 15, crit 20%)")
        g.send(Msg.atkSword)
    if g.button("Attack with Bow    (shoots, dmg 12, crit 15%)")
        g.send(Msg.atkBow)
    if g.button("Flee")
        g.send(Msg.doFlee)
    drawLog(g, model)

def viewChooseTarget(g: Gui, model: GameModel)
    drawHud(g, model)
    var wn = "Sword"
    if model.selWeapon == 1
        wn = "Bow"
    g.text("Strike with the " + wn + " — choose a target:")
    if model.e0Hp > 0
        if g.button("Ruffian A  (HP " + model.e0Hp.toString() + ")")
            g.send(Msg.tgt0)
    if model.e1Hp > 0
        if g.button("Ruffian B  (HP " + model.e1Hp.toString() + ")")
            g.send(Msg.tgt1)
    drawLog(g, model)

def viewEnemyTurn(g: Gui, model: GameModel)
    drawHud(g, model)
    g.text("The Ruffians ready their attack...")
    if g.button("Continue")
        g.send(Msg.enemyTurn)
    drawLog(g, model)

def viewWon(g: Gui, model: GameModel)
    g.text("VICTORY — the road is clear.")
    g.text("Yehu earned " + model.xp.toString() + " experience.")
    g.separator()
    if hasFlag(model, "OnRoad")
        if g.button("Walk on")
            g.send(Msg.walkOn)
    if hasFlag(model, "OnEmbassy")
        if g.button("Ride on")
            g.send(Msg.embRide)
    if g.button("Continue the tale")
        g.send(Msg.contTale)
    if g.button("Play again")
        g.send(Msg.restart)
    drawLog(g, model)

# Render a story page: one g.text per "|"-separated line.
def drawPage(g: Gui, page: str)
    for ln in page.split("|")
        g.text(ln)
    g.separator()

def viewStory(g: Gui, model: GameModel)
    drawPage(g, introPage(model.story))
    if model.story < 3
        if g.button("Continue")
            g.send(Msg.pageNext)
    if model.story == 3
        if g.button("Get the Cubs")
            g.send(Msg.getCubs)
    if model.story == 4
        if g.button("Stand your ground")
            g.send(Msg.getCubs)

def viewEpilogue(g: Gui, model: GameModel)
    drawPage(g, epiloguePage(model.story))
    if model.story + 1 < epiloguePageCount()
        if g.button("Continue")
            g.send(Msg.pageNext)
    else
        if g.button("Play the finale -- The Cubs of Thas")
            g.send(Msg.startMission)
        if g.button("Begin the tale anew")
            g.send(Msg.restart)

def viewLost(g: Gui, model: GameModel)
    g.text("DEFEAT — Yehu falls on the mountain road.")
    g.separator()
    if g.button("Try again")
        g.send(Msg.restart)
    drawLog(g, model)

def viewFled(g: Gui, model: GameModel)
    g.text("You fled. The Tuon's tears go unwept another day.")
    g.separator()
    if g.button("Face them again")
        g.send(Msg.restart)
    drawLog(g, model)

def viewMission(g: Gui, model: GameModel)
    drawPage(g, missionPage(model))
    var a = missionChoiceA(model)
    var b = missionChoiceB(model)
    if g.button(a)
        g.send(Msg.mA)
    if b != ""
        if g.button(b)
            g.send(Msg.mB)

def viewEp2(g: Gui, model: GameModel)
    drawPage(g, ep2Page(model))
    if g.button(ep2ChoiceA(model))
        g.send(Msg.mA)
    var b = ep2ChoiceB(model)
    if b != ""
        if g.button(b)
            g.send(Msg.mB)

def viewMap(g: Gui, model: GameModel)
    g.text("The Valley of ArnasThas   Yehu Lv" + model.level.toString() + " HP " + model.pHp.toString() + "/" + levelMaxHp(model).toString() + " XP " + model.xp.toString() + "   (" + diffName(model.diff) + ")")
    g.separator()
    var y = model.py - 6
    if y < 0
        y = 0
    var yEnd = y + 13
    if yEnd > 30
        yEnd = 30
        y = 17
    while y < yEnd
        var row = mapRow(y)
        var line = row
        if y == model.py
            line = row[0..model.px] + "@" + row[model.px + 1..80]
        g.text(line)
        y = y + 1
    g.separator()
    if g.button("North")
        g.send(Msg.mvN)
    if g.button("South")
        g.send(Msg.mvS)
    if g.button("West")
        g.send(Msg.mvW)
    if g.button("East")
        g.send(Msg.mvE)
    if g.button("Make camp (save)")
        g.send(Msg.saveCamp)

def viewDispute(g: Gui, model: GameModel)
    drawPage(g, disputePage(model))
    if g.button(disputeChoiceA(model))
        g.send(Msg.mA)
    var b = disputeChoiceB(model)
    if b != ""
        if g.button(b)
            g.send(Msg.mB)
    var c = disputeChoiceC(model)
    if c != ""
        if g.button(c)
            g.send(Msg.mC)

def view(g: Gui, model: GameModel)
    g.text("=== Tears of the Tuon ===")
    g.separator()
    if model.phase == 0
        viewTitle(g, model)
    if model.phase == 1
        viewChooseWeapon(g, model)
    if model.phase == 2
        viewChooseTarget(g, model)
    if model.phase == 3
        viewEnemyTurn(g, model)
    if model.phase == 4
        viewWon(g, model)
    if model.phase == 5
        viewLost(g, model)
    if model.phase == 6
        viewFled(g, model)
    if model.phase == 7
        viewStory(g, model)
    if model.phase == 8
        viewEpilogue(g, model)
    if model.phase == 9
        viewMission(g, model)
    if model.phase == 10
        viewDispute(g, model)
    if model.phase == 11
        viewMap(g, model)
    if model.phase == 12
        viewEp2(g, model)

def main()
    Gui.run("Tears of the Tuon", 640, 480, init, update, view)
