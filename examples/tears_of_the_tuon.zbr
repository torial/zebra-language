    if y == 5
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^^============^^^^^^^^^^^|||^^^^^^^^^^^^^^"
    if y == 6
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^^======^^^^^^^==========^^^^^|||^^^^^^^^^^^^^"
    if y == 7
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^=====^^^^/\\/\\/\\/\\/\\/^^^^======^^|||^^^^^^^^^^^^"
    if y == 8
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^===^^^^^\\/\\/\\/\\/\\/\\/\\/\\/\\^^^^^^==^^|||^^^^^^^^^^^"
    if y == 9
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^===^^^^/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^==^|||^^^^^^^^^^/"
    if y == 10
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^===^^^^^\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^==^|||^^^^^^^^^/\\"
    if y == 11
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^===^^^^^\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^^^==^|||^^^^^^^^//\\"
    if y == 12
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^===^^^/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^^^==^|||^^..../\\/\\/"
    if y == 13
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^===^^^^/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^^^^==HHH====T.\\/\\/\\"
    if y == 14
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^===^^^\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^^^^^^==|||^^....\\/\\/\\"
    if y == 15
        return "/\\/\\/\\/\\/\\/\\/\\/\\/^^^^^===^^^^\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^^^^^==^|||^^^^^^\\/\\/\\"
    if y == 16
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^===^^\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^^^^^^^^==^|||^^^^^^^/\\/\\"
    if y == 17
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^===^^\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^^^^^^^==^|||^^^^^^^^^\\/\\"
    if y == 18
        return "/\\/\\/\\/\\/\\/\\/\\/\\/\\/^^===^^\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\/\\^^^^^^^^==^^|||^^^^^^^^^^/\\"
