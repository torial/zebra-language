# Tears of the Tuon — a faithful port of Sean's C# interview RPG.
#
# Original brief: "Make a console based RPG that allows the characters to
# attack with 2 different items." This is the combat core of that game,
# ported to Zebra + the GameEngine MVU GUI (run it with --gui-backend=tui).
#
# Faithful to TearsOfTheTuon/Engines/CombatEngine.cs:
#   - agility-based hit rolls, difficulty bonuses that favour the player
#   - critical hits, the strength/armor damage formula
#   - initiative, enemy target/weapon AI, flee, and end-of-battle XP
# Roster matches the original story map (EnemiesList = "Ruffian,Ruffian"):
#   Yehu (the hero) vs two Ruffians.
#
# The pure combat functions at the top take primitives and return small
# result structs, so test/tears_combat_test.zbr can `use` this file and
# assert the exact faithful numbers with a fixed RNG seed — no GUI needed.
#
# RNG note (deliberate divergence): the C# original does
# `new Random((int)DateTime.Now.Ticks)` inside every roll, which correlates
# rolls made within one tick. We carry a single seeded stream in the model
# and advance it each turn instead — a strictly better, still-deterministic
# source. Do not "fix" it back to per-roll reseeding.

# ---------------------------------------------------------------------------
# Pure combat core (exposed for testing)
# ---------------------------------------------------------------------------

struct Weapon
    var name: str
    var action: str
    var damage: int
    var critChance: int
    var critDamage: int

def swordW(): Weapon
    return Weapon(name: "sword", action: "stabs", damage: 15, critChance: 20, critDamage: 25)

def bowW(): Weapon
    return Weapon(name: "bow", action: "shoots", damage: 12, critChance: 15, critDamage: 25)

def daggerW(): Weapon
    return Weapon(name: "dagger", action: "stabs", damage: 10, critChance: 10, critDamage: 20)

struct AttackOutcome
    var hit: bool
    var crit: bool
    var damage: int
    var message: str
    var nextSeed: int

# Faithful port of CombatEngine.DetermineAttackSuccess.
# diff: 0 = easy, 1 = medium, 2 = hard. Difficulty always favours the player:
# easy adds +2 to the player's roll, hard subtracts 2 (whether attacking or
# defending). Damage mirrors the C# expression, where `>>2` (== integer /4,
# operands are non-negative here) binds looser than `+`:
#   damage = base + ((rollDelta + strength) / 4) - (armor / 4)
def resolveAttack(seed: int, attackerName: str, attAgi: int, attStr: int, w: Weapon, victimName: str, defAgi: int, defArmor: int, isPlayerAttacker: bool, diff: int): AttackOutcome
    var rng = Random.new(seed)
    var attackRoll = rng.nextFloat() * attAgi.toFloat()
    var defenseRoll = rng.nextFloat() * defAgi.toFloat()
    if diff == 0
        if isPlayerAttacker
            attackRoll = attackRoll + 2.0
        else
            defenseRoll = defenseRoll + 2.0
    if diff == 2
        if isPlayerAttacker
            attackRoll = attackRoll - 2.0
        else
            defenseRoll = defenseRoll - 2.0
    var critRoll = rng.nextFloat() * 100.0
    var ns = rng.nextInt(1, 2000000000)
    if attackRoll < defenseRoll
        return AttackOutcome(hit: false, crit: false, damage: 0, message: attackerName + " " + w.action + " and misses!", nextSeed: ns)
    var isCrit = critRoll <= w.critChance.toFloat()
    var base = w.damage
    if isCrit
        base = w.critDamage
    var rollDelta = (attackRoll - defenseRoll).toInt()
    var dmg = base + ((rollDelta + attStr) / 4) - (defArmor / 4)
    if dmg < 1
        dmg = 1
    var msg = attackerName + " " + w.action
    if isCrit
        msg = msg + " and hits a vital organ of " + victimName + "!"
    else
        msg = msg + " and hits " + victimName + "."
    return AttackOutcome(hit: true, crit: isCrit, damage: dmg, message: msg, nextSeed: ns)

# Weapon "strength" used by the enemy AI (CombatEngine.DetermineWeaponEnemyUses).
def weaponScore(w: Weapon): int
    return w.damage + w.critChance * w.critDamage

# Enemy weapon choice: easy picks the weakest, hard the strongest, medium
# a seed-derived pick (kept off the attack stream so it never perturbs rolls).
# Returns 0 (first weapon) or 1 (second).
def chooseEnemyWeapon(seed: int, wa: Weapon, wb: Weapon, diff: int): int
    if diff == 0
        if weaponScore(wa) <= weaponScore(wb)
            return 0
        return 1
    if diff == 2
        if weaponScore(wa) >= weaponScore(wb)
            return 0
        return 1
    return seed % 2

# Faithful port of CanPlayersFlee.
def tryFlee(seed: int, playerAgiSum: int, enemyAgiSum: int, diff: int): bool
    var rng = Random.new(seed)
    var enemyRoll = rng.nextFloat() * enemyAgiSum.toFloat()
    var playerRoll = rng.nextFloat() * playerAgiSum.toFloat()
    if diff == 0
        playerRoll = playerRoll + 3.0
    if diff == 2
        playerRoll = playerRoll - 3.0
    return playerRoll >= enemyRoll

# Faithful port of DetermineInitiative: easy = player first, hard = enemy
# first, medium = higher total agility goes first.
def playerFirst(diff: int, playerAgiSum: int, enemyAgiSum: int): bool
    if diff == 0
        return true
    if diff == 2
        return false
    return playerAgiSum >= enemyAgiSum

# ---------------------------------------------------------------------------
# Story layer (scene data as pure functions — the episode-authoring surface)
# ---------------------------------------------------------------------------
# Ported from TearsOfTheTuon.Story/MapCreationHelper.cs Scene ID=1 (the Intro):
# four SceneTexts, then the single choice "Get the Cubs". Pages are one string
# each; "|" separates display lines (the TUI renders one g.text per line).
# Page 5 is port-added connective tissue (marked); the C# original walks the
# ArnaThas tile map between the intro and its combats, which the TUI slice
# does not yet carry.

def introPageCount(): int
    return 5

def introPage(i: int): str
    if i == 0
        return "[ Namal, prince of the maeuws ]||\"I want you to go capture some Tuon cubs so that|they will be slaves to work on my palace.\""
    if i == 1
        return "Chief Gratta was roasting a squirrel over a camp fire|when he heard his name being shouted.||\"Chief Gratta! Chief Gratta!\" yelled a young Tuon|warrior running toward him.||\"What is it?\" asked Gratta as he turned the squirrel|over the spit.||\"Someone has stolen the cubs from Arna!\"||Gratta stood when he heard this. \"I will go there at|once. Muster the Tuons in this area.\""
    if i == 2
        return "An hour later, Chief Gratta arrived at Arna. The|village was mostly abandoned, but in the distance|Gratta heard the sorrowful pleas to Yah Elyon. The|parents had gone up the hill to Yah Elyon's altar to|plead their case.||Gratta circled the cubs' pen, sniffing. At the edge|of the village he found what he feared.||\"Maeuwan! Those accursed troublemakers! Those|accursed cats!\" Gratta thought as he growled."
    if i == 3
        return "The loud crashing sound of tuons approaching caused|Gratta to look up. Two tuons stopped before him.|\"We came as soon as we heard the muster.\"||\"What are your names? I am Chief Gratta.\"||\"I am Gor!\" said one.|\"I am Kav!\" said the other.||\"I have found the scent of Maeuwan. They have done|this. Follow me as we search for the cubs.\"||\"Yes, sir!\" they said in unison."
    # Port-added bridge (not in the C# scene data): links the intro to the
    # mountain-road battle the combat slice carries.
    return "[ The road to Thas ]||Word of the muster ran ahead of the hunters, and the|mountain road emptied of honest folk. Yehu, carrying|news of the stolen cubs down to Thas, walked it alone.||Where the road bends under the cliffs, two ruffians|stepped from the rocks."

# The epilogue is the first Fable-composed material in this world — a coda in
# the story's own tone, and the hook where authored episodes will attach.
def epiloguePageCount(): int
    return 3

def epiloguePage(i: int): str
    if i == 0
        return "The ruffians fled or fell, and the road lay quiet.|Yehu cleaned his blade on the mountain grass and|looked back the way he had come.||Smoke stood over Arna, thin and far. Below, the roofs|of Thas caught the late sun."
    if i == 1
        return "He thought of the cubs, and of the mothers on the|hill at Yah Elyon's altar.||\"A man cannot carry news slower than his feet,\" he|said to no one, \"but grief runs faster than both.\"||He shouldered his bow and took the downhill road."
    return "[ Here ends the road-slice of Episode One. ]||Gratta's hunt follows the scent westward. Gor and Kav|keep his flanks. And in Thas, word is about to arrive|that will pull Yehu into the tuons' war.||EPISODE II awaits its composing."

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Phases: 0 title  1 chooseWeapon  2 chooseTarget  3 enemyTurn
#         4 won    5 lost          6 fled
#         7 story (intro pages)    8 epilogue (post-victory pages)
#         9 mission: The Cubs of Thas (model.story = scene id)

struct GameModel
    var phase: int
    var diff: int
    var pHp: int
    var e0Hp: int
    var e1Hp: int
    var selWeapon: int
    var round: int
    var xp: int
    var story: int
    var states: List(str)
    var rngSeed: int
    var log: List(str)

union Msg
    selEasy
    selMedium
    selHard
    atkSword
    atkBow
    tgt0
    tgt1
    doFlee
    enemyTurn
    restart
    pageNext
    getCubs
    contTale
    startMission
    mA
    mB

def init(): GameModel
    var seed = Random.randInt(1, 2000000000)
    var noFlags: List(str) = []
    return GameModel(phase: 7, diff: 1, pHp: 35, e0Hp: 20, e1Hp: 20, selWeapon: 0, round: 1, xp: 0, story: 0, states: noFlags, rngSeed: seed, log: ["Two Ruffians block the mountain road. Yehu draws his blade."])

# ---------------------------------------------------------------------------
# MISSION: The Cubs of Thas (phase 9) — the untold interior of Episode I.
# ---------------------------------------------------------------------------
# The novella (Episode 1, ch. 5-6) sends Commander Yehu's score into Thas by
# the slave-ruse and then follows Gratta; the infiltration itself happens
# offstage ("the Torialites have freed the cubs but will be overwhelmed").
# This mission composes that interior, contradicting nothing: the sale at the
# gate (Aidden's haggling, Lamek, one hundred shekels), the split of the
# score, the pen with its fifty guards, the barel's judgment, Gratta at the
# gate-beam, and Namal's flaming spear at the bridge. Its moral spine is
# Keanna's rebuke: the battle is won by waiting for Yah Elyon's sign, not by
# the strength of the score. Scene data are pure functions; the player's
# flags ride model.states (the DecisionEngine criteria idea, ported small).

def hasFlag(model: GameModel, f: str): bool
    var i = 0
    while i < model.states.len
        if model.states.at(i) == f
            return true
        i = i + 1
    return false

def withFlag(m: GameModel, f: str): GameModel
    var st = m.states
    st.add(f)
    return m except states = st

def missionPage(model: GameModel): str
    var id = model.story
    if id == 0
        return "[ The camp before Thas -- night ]||Aidden: 'Commander Yehu -- gather a score of your|mightiest men. We have a mission with need of great|deeds of valor.'||The plan is madness dressed as commerce: sell Chief|Gratta at the market of Thas, walk in as slavers, and|be inside the walls when the hour comes. Gratta bears|Arphad's wound -- the gift of truth."
    if id == 1
        return "[ The gates of Thas -- early dawn ]||A maeuw soldier prods Gratta with a spear. 'His|sickness is not fatal. You may sell him at the|market.'||Aidden haggles like a bandit born; Lamek of the gold|robes pays one hundred shekels. The gates of Thas|stand open, and your score walks in with the crowd --|spears low, eyes lower."
    if id == 2
        return "[ The streets of Thas ]||Perfume and torchlight. The cub-pen lies north by the|old cave; the gate-house south. A patrol rounds the|corner ahead: helmeted maeuw, spears slung, bored and|dangerous."
    if id == 3
        if hasFlag(model, "Alarm")
            return "[ The cub-pen -- north quarter ]||Horns still sound behind you from the bluff gone|wrong. Behind iron bars, tuon cubs huddle leashed|neck to neck. You count the guards twice and twice|despair: fifty maeuw, whips and spears -- and now|they are awake."
        return "[ The cub-pen -- north quarter ]||Behind iron bars, tuon cubs huddle in the dark,|leashed neck to neck. You count the guards twice and|twice despair: fifty maeuw, whips and spears, and the|pen in torchlight.||Ten men cannot do this. Nor twenty."
    if id == 4
        if hasFlag(model, "Struck")
            return "[ Blood at the pen ]||Your men take down six guards before the horns sound|the quarter awake -- and still the fifty come on.||Then the light comes down the road anyway, unasked. A|wind where no wind should be; the guards fall|convulsing. You live because heaven outran your plan.|Around you, three of your own lie still."
        return "[ The turning of the hour ]||A wind rises inside the walls where no wind should|be. Down the main road walks a light in the shape of|a maeuw, and the torches gutter before it.||The guards nearest the pen crouch and convulse. A|voice that is not a sound says: FREE THE CUBS. I WILL|BE YOUR WALL."
    if id == 5
        return "[ The south gate ]||Cubs at your back; the gate-team at the beam. Chief|Gratta comes leaping the crouching guards, tosses the|cross-beam aside and hauls the doors wide.||'I WILL NOW ASSIST MY COMPANION IN JUDGMENT. HURRY.'||Keanna the Judge runs beside you toward the bridge."
    if id == 6
        return "[ The bridge over the Yellow Snake ]||Hooves behind: fifty riders, and at their head a|maeuw in brilliant robes. Namal.||He levels a spear at Keanna: 'I call down fiery wrath|upon you!' -- and the spear takes fire in the air as|it flies."
    # id 7 — endings by flags
    if hasFlag(model, "SavedKeanna")
        if hasFlag(model, "Waited")
            return "[ Morning on the far bank ]||The spear splits the planks where Keanna stood; you|taste smoke and river fog. Namal falls before Gratta|and Aidden, and the riders break.||Keanna finds you after. 'El Roi saw you wait, and saw|you dive. Tell your children, human: the battle was|never yours to win -- only yours to be faithful in.'||[ ENDING: The Faithful Score ]"
        return "[ Morning on the far bank ]||Namal falls; the riders break; the cubs are counted|twice and all are living. But three cairns stand by|the road for the men the pen took.||Keanna binds your arm in silence, then: 'Valor is a|good servant and a poor master. Next time, wait for|the wall.'||[ ENDING: Valor and Graves ]"
    return "[ Morning on the far bank ]||You held the line and the line held -- but it was a|blazing hand from heaven that turned the spear, not|yours. Keanna rises from the planks unaided and looks|at you a long moment, saying nothing at all.||The cubs are safe. The song, when they sing it, will|not carry your name.||[ ENDING: The Unbent Line ]"

# Choice labels per scene ("" = no second choice).
def missionChoiceA(model: GameModel): str
    var id = model.story
    if id == 0
        return "March at dawn"
    if id == 1
        return "Split the score -- ten to the pen, ten to the gates"
    if id == 2
        return "Melt into an alley and let the patrol pass"
    if id == 3
        return "Strike now, while surprise is yours"
    if id == 4
        return "Break the pen"
    if id == 5
        return "To the bridge"
    if id == 6
        return "Dive -- knock her clear"
    return "Sing the song of the day"

def missionChoiceB(model: GameModel): str
    var id = model.story
    if id == 1
        return "Keep the score together"
    if id == 2
        return "Bluff as slavers seeking the market"
    if id == 3
        return "Hold. Watch. The tuon say Yah Elyon sees"
    if id == 6
        return "Hold your line at the beam"
    return ""

# The mission FSM: pure, deterministic, testable.
def missionStep(model: GameModel, pickB: bool): GameModel
    var id = model.story
    if id == 0
        return model except story = 1
    if id == 1
        var m1 = model
        if not pickB
            m1 = withFlag(m1, "Split")
        return m1 except story = 2
    if id == 2
        # Bluffing works only with the papers-of-sale story a split team
        # keeps straight; a bunched score bluffing raises the alarm.
        var m2 = model
        if pickB and not hasFlag(m2, "Split")
            m2 = withFlag(m2, "Alarm")
        return m2 except story = 3
    if id == 3
        var m3 = model
        if pickB
            m3 = withFlag(m3, "Waited")
        else
            m3 = withFlag(m3, "Struck")
        return m3 except story = 4
    if id == 4
        var m4 = withFlag(model, "CubsFree")
        return m4 except story = 5
    if id == 5
        return model except story = 6
    if id == 6
        var m6 = model
        if not pickB
            m6 = withFlag(m6, "SavedKeanna")
        return m6 except story = 7
    return init()

# ---------------------------------------------------------------------------
# Update helpers (deterministic given the model's seed — testable)
# ---------------------------------------------------------------------------

def diffName(diff: int): str
    if diff == 0
        return "Easy"
    if diff == 2
        return "Hard"
    return "Medium"

def aliveEnemies(model: GameModel): int
    var n = 0
    if model.e0Hp > 0
        n = n + 1
    if model.e1Hp > 0
        n = n + 1
    return n

# Append a battle-log line functionally. A List field reached through an
# `except`-copy of a const model is a *const pointer, so `m.log.add(...)`
# won't compile; copying the list, appending, and re-binding it does.
def withLog(m: GameModel, line: str): GameModel
    var lg = m.log
    lg.add(line)
    return m except log = lg

def beginBattle(model: GameModel, diff: int): GameModel
    var m = model except diff = diff
    if playerFirst(diff, 25, 30)
        m = withLog(m, "On " + diffName(diff) + " — Yehu goes first!")
        return m except phase = 1
    m = withLog(m, "On " + diffName(diff) + " — the Ruffians go first!")
    return m except phase = 3

# Resolve Yehu's attack (his selected weapon) against enemy `tgt` (0 or 1).
def playerAttack(model: GameModel, tgt: int): GameModel
    var w = swordW()
    if model.selWeapon == 1
        w = bowW()
    var tgtName = "Ruffian A"
    var tgtHp = model.e0Hp
    if tgt == 1
        tgtName = "Ruffian B"
        tgtHp = model.e1Hp
    var out = resolveAttack(model.rngSeed, "Yehu", 25, 15, w, tgtName, 15, 10, true, model.diff)
    var m = model except rngSeed = out.nextSeed
    m = withLog(m, out.message)
    if out.hit
        var nh = tgtHp - out.damage
        if nh < 0
            nh = 0
        if tgt == 0
            m = m except e0Hp = nh
        else
            m = m except e1Hp = nh
        if nh <= 0
            m = withLog(m, tgtName + " collapses.")
    if m.e0Hp <= 0 and m.e1Hp <= 0
        m = withLog(m, "The Ruffians are defeated! Yehu gains 50 experience.")
        return m except phase = 4, xp = m.xp + 50
    return m except phase = 3

# One enemy attacks Yehu, picking a weapon by the difficulty AI.
def oneEnemyAttack(model: GameModel, which: int): GameModel
    var wi = chooseEnemyWeapon(model.rngSeed, bowW(), daggerW(), model.diff)
    var w = bowW()
    if wi == 1
        w = daggerW()
    var ename = "Ruffian A"
    if which == 1
        ename = "Ruffian B"
    var out = resolveAttack(model.rngSeed, ename, 15, 10, w, "Yehu", 25, 10, false, model.diff)
    var m = model except rngSeed = out.nextSeed
    m = withLog(m, out.message)
    if out.hit
        var nh = m.pHp - out.damage
        if nh < 0
            nh = 0
        m = m except pHp = nh
        if nh <= 0
            m = withLog(m, "Yehu collapses!")
    return m

def runEnemyTurn(model: GameModel): GameModel
    var m = model
    if m.e0Hp > 0 and m.pHp > 0
        m = oneEnemyAttack(m, 0)
    if m.e1Hp > 0 and m.pHp > 0
        m = oneEnemyAttack(m, 1)
    if m.pHp <= 0
        return m except phase = 5
    return m except phase = 1, round = m.round + 1

def attemptFlee(model: GameModel): GameModel
    var enemyAgi = aliveEnemies(model) * 15
    var rng = Random.new(model.rngSeed)
    var probe = rng.nextInt(1, 2000000000)
    var m = model except rngSeed = probe
    if tryFlee(model.rngSeed, 25, enemyAgi, model.diff)
        m = withLog(m, "Yehu breaks away and escapes down the road.")
        return m except phase = 6
    m = withLog(m, "Yehu tries to flee but the Ruffians cut him off!")
    return m except phase = 3

# ---------------------------------------------------------------------------
# Update
# ---------------------------------------------------------------------------

# "Get the Cubs" (the intro scene's one choice, per the C# original) jumps to
# the port-added bridge page; from the bridge it enters the difficulty title.
def chooseGetCubs(model: GameModel): GameModel
    if model.story < 4
        return model except story = 4
    return model except phase = 0, story = 0

# Advance a story/epilogue page (phase 7 or 8). In the intro, pageNext stops
# at the choice page (the muster) — only Msg.getCubs passes it, so the scene's
# choice is required by the FSM itself, not just by which buttons the view
# happens to draw. The last epilogue page likewise holds (restart is the exit).
def nextPage(model: GameModel): GameModel
    var last = introPageCount() - 1
    if model.phase == 8
        last = epiloguePageCount()
    if model.story + 1 < last
        return model except story = model.story + 1
    return model

def update(model: GameModel, msg: Msg): GameModel
    branch msg
        on Msg.selEasy    return beginBattle(model, 0)
        on Msg.selMedium  return beginBattle(model, 1)
        on Msg.selHard    return beginBattle(model, 2)
        on Msg.atkSword   return model except selWeapon = 0, phase = 2
        on Msg.atkBow     return model except selWeapon = 1, phase = 2
        on Msg.tgt0       return playerAttack(model, 0)
        on Msg.tgt1       return playerAttack(model, 1)
        on Msg.doFlee     return attemptFlee(model)
        on Msg.enemyTurn  return runEnemyTurn(model)
        on Msg.restart    return init()
        on Msg.pageNext   return nextPage(model)
        on Msg.getCubs    return chooseGetCubs(model)
        on Msg.contTale   return model except phase = 8, story = 0
        on Msg.startMission  return model except phase = 9, story = 0
        on Msg.mA         return missionStep(model, false)
        on Msg.mB         return missionStep(model, true)

# ---------------------------------------------------------------------------
# View
# ---------------------------------------------------------------------------

def drawHud(g: Gui, model: GameModel)
    g.text("Round " + model.round.toString() + "   (" + diffName(model.diff) + ")")
    g.text("Yehu       HP " + model.pHp.toString() + "/35")
    var a = "down"
    if model.e0Hp > 0
        a = model.e0Hp.toString() + "/20"
    var b = "down"
    if model.e1Hp > 0
        b = model.e1Hp.toString() + "/20"
    g.text("Ruffian A  HP " + a)
    g.text("Ruffian B  HP " + b)
    g.separator()

def drawLog(g: Gui, model: GameModel)
    g.separator()
    var total = model.log.len
    var start = 0
    if total > 8
        start = total - 8
    var i = start
    while i < total
        g.text(model.log.at(i))
        i = i + 1

def viewTitle(g: Gui, model: GameModel)
    g.text("A pair of Ruffians blocks the road. Choose your trial:")
    g.separator()
    if g.button("Easy   — Yehu strikes first, fortune favours him")
        g.send(Msg.selEasy)
    if g.button("Medium — a fair fight")
        g.send(Msg.selMedium)
    if g.button("Hard   — the Ruffians are quick and cruel")
        g.send(Msg.selHard)

def viewChooseWeapon(g: Gui, model: GameModel)
    drawHud(g, model)
    g.text("Yehu's move — attack with which weapon?")
    if g.button("Attack with Sword  (stabs, dmg 15, crit 20%)")
        g.send(Msg.atkSword)
    if g.button("Attack with Bow    (shoots, dmg 12, crit 15%)")
        g.send(Msg.atkBow)
    if g.button("Flee")
        g.send(Msg.doFlee)
    drawLog(g, model)

def viewChooseTarget(g: Gui, model: GameModel)
    drawHud(g, model)
    var wn = "Sword"
    if model.selWeapon == 1
        wn = "Bow"
    g.text("Strike with the " + wn + " — choose a target:")
    if model.e0Hp > 0
        if g.button("Ruffian A  (HP " + model.e0Hp.toString() + ")")
            g.send(Msg.tgt0)
    if model.e1Hp > 0
        if g.button("Ruffian B  (HP " + model.e1Hp.toString() + ")")
            g.send(Msg.tgt1)
    drawLog(g, model)

def viewEnemyTurn(g: Gui, model: GameModel)
    drawHud(g, model)
    g.text("The Ruffians ready their attack...")
    if g.button("Continue")
        g.send(Msg.enemyTurn)
    drawLog(g, model)

def viewWon(g: Gui, model: GameModel)
    g.text("VICTORY — the road is clear.")
    g.text("Yehu earned " + model.xp.toString() + " experience.")
    g.separator()
    if g.button("Continue the tale")
        g.send(Msg.contTale)
    if g.button("Play again")
        g.send(Msg.restart)
    drawLog(g, model)

# Render a story page: one g.text per "|"-separated line.
def drawPage(g: Gui, page: str)
    for ln in page.split("|")
        g.text(ln)
    g.separator()

def viewStory(g: Gui, model: GameModel)
    drawPage(g, introPage(model.story))
    if model.story < 3
        if g.button("Continue")
            g.send(Msg.pageNext)
    if model.story == 3
        if g.button("Get the Cubs")
            g.send(Msg.getCubs)
    if model.story == 4
        if g.button("Stand your ground")
            g.send(Msg.getCubs)

def viewEpilogue(g: Gui, model: GameModel)
    drawPage(g, epiloguePage(model.story))
    if model.story + 1 < epiloguePageCount()
        if g.button("Continue")
            g.send(Msg.pageNext)
    else
        if g.button("Play the finale -- The Cubs of Thas")
            g.send(Msg.startMission)
        if g.button("Begin the tale anew")
            g.send(Msg.restart)

def viewLost(g: Gui, model: GameModel)
    g.text("DEFEAT — Yehu falls on the mountain road.")
    g.separator()
    if g.button("Try again")
        g.send(Msg.restart)
    drawLog(g, model)

def viewFled(g: Gui, model: GameModel)
    g.text("You fled. The Tuon's tears go unwept another day.")
    g.separator()
    if g.button("Face them again")
        g.send(Msg.restart)
    drawLog(g, model)

def viewMission(g: Gui, model: GameModel)
    drawPage(g, missionPage(model))
    var a = missionChoiceA(model)
    var b = missionChoiceB(model)
    if g.button(a)
        g.send(Msg.mA)
    if b != ""
        if g.button(b)
            g.send(Msg.mB)

def view(g: Gui, model: GameModel)
    g.text("=== Tears of the Tuon ===")
    g.separator()
    if model.phase == 0
        viewTitle(g, model)
    if model.phase == 1
        viewChooseWeapon(g, model)
    if model.phase == 2
        viewChooseTarget(g, model)
    if model.phase == 3
        viewEnemyTurn(g, model)
    if model.phase == 4
        viewWon(g, model)
    if model.phase == 5
        viewLost(g, model)
    if model.phase == 6
        viewFled(g, model)
    if model.phase == 7
        viewStory(g, model)
    if model.phase == 8
        viewEpilogue(g, model)
    if model.phase == 9
        viewMission(g, model)

def main()
    Gui.run("Tears of the Tuon", 640, 480, init, update, view)
