struct Node
	var children: List(^Node)
	var node_type: NodeType
	
enum NodeType
	Text(String)
	Element(ElementData)
	
struct ElementData
	var tag_Name: String
	var attrs: AttrMap
	
type AttrMap = HashMap(String, String)

def text(data: String): Node
	return Node(children: List(^Node)(), node_type: NodeType.Text(data))

def elem(tag_name: String, attrs: AttrMap, children: List(^Node)): Node
	return Node(children, node_type: NodeType.Element(ElementData(tag_name, attrs)))
	
struct Parser
	var pos: uint
	var input: String
	
	# read the current character without consuming it
	def next_char(): char
		return self.input[self.pos..].chars().next().unwrap()
		
	# do the next characters start with the given string?
	def starts_with(s: String): bool
		return self.input[self.pos ..].starts_with(s)
		
	# if the exact string `s` is found at the current position, consume it. 
	def expect(s: String)
		if .starts_with(s)
			.pos += s.len
		else:
			panic("Expected ${s} at byte ${.pos} but it was not found")
	
	# return true if all inptu is consumed
	def eof(): bool
		return .pos >= .input.len

	# "return the current character and advance .pos to the next char
	def consume_char(): char
		var c = .next_char()
		.pos += c.len_utf8()
		return c
	
	sig CharTest(char):bool
	# consume characters until `test` returns false
	def conume_while(test: CharTest): String
		result = StringBuilder()
		while not .eof() and test(.next_char())
			result.append(.consume_char())
		
		return result.toString()
		
	# consume and discard zero or more whitespace characters
	def consume_whitespace()
		.consume_while(char.IsWhitespace)
	
	# parse a tag or attribute name
	def parse_name(): String
		.consume_while(def(c) [c: is in A-Za-z-9]
	
	def parse_node(): Node
		if .starts_with("<")
			return .parse_element()
		else
			return .parse_text()
		
	def parse_text(): Node
		return text(.consume_while(def(c): c is not "<"))
		
	def parse_element(): Node
		# opening tag
		.expect("<")
		var tag_name = .parse_name()
		var attrs = .parse_attributes()
		.expect(">")
		
		# contents
		var children = .parse_nodes
		.expect("</")
		.expect(tag_name)
		.expect(">")
		
		return elem(tag_name, attrs, children)
		
	def parse_attr(): (String, String)
		var name = .parse_name()
		.expect("=")
		var value = .parse_attr_value()
		return (name, value)
	
	# parse a quoted value
	def parse_attr_value(): String
		var open_quote = .consume_char()
		assert(open_quote == "'" or open_quote == '"')
		var value = .consume_while(def(c) c != open_quote)
		var close_quote = .consume_char()
		assert(Eq, open_quote, close_quote)
		return value
	
	def parse_attributes(): AttrMap
		var attributes = HashMap(String, String)()
		.consume_whitespace()
		while .next_char() != '>'
			var (name, value) = .parse_attr()
			attributes[name] = value
			.consume_whitespace()
		return attributes
		
	def parse_nodes(): List(^Node)
		var nodes = List(^Node)()
		.consume_whitespace()
		while not .eof() and not .starts_with("</")
			nodes.append(.parse_node())
			.consume_whitespace()
		return nodes
		
	def parse(source: String): Node
		var nodes = Parser(pos:0, input: source).parse_nodes()
		
		# if document contains a root element, return it, or create it
		if nodes.len == 1
			return nodes.remove(0)
		else
			return elem("html", HashMap(String, String)(), nodes)


	def parse_simple_selector(): SimpleSelector
		var selector = SimpleSelector(tag_name: nil, id: nil, class: List(String)())
		while not .eof()
			branch .next_char() as c
				on "#"
					.consume_char()
					selector.id = .parse_identifier()
				on "."
					.consume_char()
					selector.class.add(.parse_identifier())
				on "*"
					# universal selector
					.consume_char()
				on valid_identifier_char(c)
					selector.tag_name = .parse_identifier()
				else
					pass
					
		return selector

	def specificity(): Specificity
		var Selector.Simple(ref simple) = this
		var selector_id_len = simple.id.iter().count()
		var class_len = simple.class.len
		var tag_name = simple.tag_name.iter().count()
		
		return Specificity(selector_id_len, class_len, tag_name)

	def parse_rule(): Rule
		return Rule(selectors: .parse_selectors(), declarations: .parse_declarations())
		
	def parse_selectors(): List(Selector)
		var selectors = List(Selector)()
		selectors.append(Selector.Simple(.parse_simple_selector())
		.consume_whitespace()
		var next = .next_char()
		while next != "{"
			branch next
				on ","
					.consume_char()
					.consume_whitespace()
				else
					raise "Unexpected character ${next} in selector list"
					
			selectors.append(Selector.Simple(.parse_simple_selector())
			.consume_whitespace()

		# Return selectors with highest scecifity first, for use in matching
		selectors.sort_by(def(a,b) b.specificity().cmp(a.specificity()))
		return selectors
		
	


def valid_identifier_char(c: char): bool
	branch c
		on 'a'..'z' or 'A'..'Z' or '0'..'9' or '-' or '_'
			return true
		else
			return false

struct Stylesheet
	var rules: List(Rule)

struct Rule
	var selectors: List(Selector)
	var declarations: List(Declaration)
	
enum Selector
	Simple(SimpleSelector)
	
struct SimpleSelector
	var tag_name: String?
	var id: String?
	var class: List(String)
	
struct Declaration
	var name: String
	var value: Value
	
enum Value
	Keyword(String)
	Length(float32, Unit)
	ColorValue(Color)
	
enum Unit
	Px
	
struct Color
	var r: uint8
	var g: uint8
	var b: uint8
	var a: uint8

class Specificity
	var selector_id_len: uint
	var class_len: uint
	var tag_name_len: uint
	
