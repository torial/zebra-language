struct Model
    var count: int

union Msg
    inc
    reset

def init(): Model
    return Model(count: 0)

def update(model: Model, msg: Msg): Model
    branch msg
        on Msg.inc   return Model(count: model.count + 1)
        on Msg.reset return Model(count: 0)

def view(g: Gui, model: Model)
    g.panel("Controls", def(g: Gui)
        g.button("+1", Msg.inc)
        g.sameLine()
        g.button("Reset", Msg.reset)
    )
    g.panel("Status", def(g: Gui)
        # `model` belongs to the ENCLOSING function, and Zebra lambdas do not capture
        # implicitly -- a bare read emits Zig's "'model' not accessible from inner
        # function". An explicit `capture` block is the documented mechanism.
        capture
            var model: Model = model
        g.text("Count: " + model.count.toString())
    )

def main()
    Gui.run("Panel Smoke", 400, 300, init, update, view)
