# NPC reactions — the 12/19/01 notebook's reaction table, made executable.
#
# Sean's notebook (writings/torial_game_notes/TRANSCRIPTION.md, §10) holds an
# 18x10 table: how each kind of NPC reacts to each visible quality of the
# player character, in the notebook's own arrow notation.  This file is that
# table as DATA plus a pure scoring function over it.  Nothing here has
# state; everything is testable.
#
# The table is stored one row per NPC type, one character per quality, so the
# source keeps the shape of the page it came from:
#
#     @ = +3 overwhelming      . =  0 none
#     # = +2 strong            - = -1 slight   (inverse)
#     + = +1 slight            = = -2 strong   (inverse)
#                              ~ = -3 overwhelming (inverse)
#
# Column order is the notebook's:
#   0 wisdom  1 faith  2 leadership  3 loyalty  4 perception
#   5 humility  6 honor  7 courage  8 kindness  9 prowess

struct Qualities
    var wis: int
    var faith: int
    var ldr: int
    var loyalty: int
    var perception: int
    var humility: int
    var honor: int
    var courage: int
    var kindness: int
    var prowess: int

# A reaction, with the reasoning that produced it.  The trace is the point:
# a number alone cannot be reviewed, but "cold because he weighs humility
# double and yours reads low" can.
struct Reaction
    var score: int
    var band: str
    var why: str

# ---------------------------------------------------------------------------
# The table.  One row per NPC type, in notebook order.
# ---------------------------------------------------------------------------

def rxnTable(): List(str)
    var t: List(str) = []
    t.add("#+...#..#.")     #  0 Farmer
    t.add(".+++-#.+#+")     #  1 Servant
    t.add(".-..#.#--+")     #  2 Merchant
    t.add(".+@#.-####")     #  3 Soldier
    t.add("#.+##.#+##")     #  4 Captain
    t.add("+..#+.#+.#")     #  5 General
    t.add("#..@++#+.+")     #  6 King/Chief
    t.add("++....+-#.")     #  7 Elderly
    t.add("~=++--+++.")     #  8 Criminal
    t.add("#+.+.++.#-")     #  9 Levite
    t.add("##.#.#+.#.")     # 10 Priest
    t.add("+@.@.#++#+")     # 11 High Priest
    t.add("+@.+#@##+.")     # 12 Prophet
    t.add("+++..#++@+")     # 13 Children
    t.add("+-..+..-#=")     # 14 Physician
    t.add("#-.+#.#.++")     # 15 Advisor
    t.add("#+.#+##.++")     # 16 Town-elder
    t.add("~~~~~~==-.")     # 17 Fool
    return t

def npcName(i: int): str
    if i == 0
        return "Farmer"
    if i == 1
        return "Servant"
    if i == 2
        return "Merchant"
    if i == 3
        return "Soldier"
    if i == 4
        return "Captain"
    if i == 5
        return "General"
    if i == 6
        return "King"
    if i == 7
        return "Elderly"
    if i == 8
        return "Criminal"
    if i == 9
        return "Levite"
    if i == 10
        return "Priest"
    if i == 11
        return "HighPriest"
    if i == 12
        return "Prophet"
    if i == 13
        return "Children"
    if i == 14
        return "Physician"
    if i == 15
        return "Advisor"
    if i == 16
        return "TownElder"
    if i == 17
        return "Fool"
    return "?"

def npcIndex(name: str): int
    var i = 0
    while i < 18
        if npcName(i) == name
            return i
        i = i + 1
    return 0 - 1

def qualName(i: int): str
    if i == 0
        return "wisdom"
    if i == 1
        return "faith"
    if i == 2
        return "leadership"
    if i == 3
        return "loyalty"
    if i == 4
        return "perception"
    if i == 5
        return "humility"
    if i == 6
        return "honor"
    if i == 7
        return "courage"
    if i == 8
        return "kindness"
    if i == 9
        return "prowess"
    return "?"

def qualAt(q: Qualities, i: int): int
    if i == 0
        return q.wis
    if i == 1
        return q.faith
    if i == 2
        return q.ldr
    if i == 3
        return q.loyalty
    if i == 4
        return q.perception
    if i == 5
        return q.humility
    if i == 6
        return q.honor
    if i == 7
        return q.courage
    if i == 8
        return q.kindness
    if i == 9
        return q.prowess
    return 0

# ---------------------------------------------------------------------------
# Weights
# ---------------------------------------------------------------------------

def weightChar(c: str): int
    if c == "@"
        return 3
    if c == "#"
        return 2
    if c == "+"
        return 1
    if c == "-"
        return 0 - 1
    if c == "="
        return 0 - 2
    if c == "~"
        return 0 - 3
    return 0

# The weight NPC type `t` puts on quality `q`, straight off the notebook page.
def npcWeight(t: int, q: int): int
    var tbl = rxnTable()
    if t < 0
        return 0
    if t >= tbl.len
        return 0
    if q < 0
        return 0
    if q >= 10
        return 0
    var row = tbl.at(t)
    return weightChar(row[q..q + 1])

# ---------------------------------------------------------------------------
# Scoring
#
# Qualities run 0..5 with 3 as ordinary.  A reaction is measured as DEVIATION
# from how this NPC would read a wholly ordinary person, so an average
# stranger is neutral to everyone and the table expresses what each kind of
# person actually notices.  Without that baseline, NPC types with many
# positive weights would love everyone and the Fool would hate everyone
# regardless of who walked in.
# ---------------------------------------------------------------------------

def ordinaryLevel(): int
    return 3

def baselineFor(t: int): int
    var total = 0
    var i = 0
    while i < 10
        total = total + npcWeight(t, i) * ordinaryLevel()
        i = i + 1
    return total

def rawScore(t: int, q: Qualities): int
    var total = 0
    var i = 0
    while i < 10
        total = total + npcWeight(t, i) * qualAt(q, i)
        i = i + 1
    return total

# `bias` carries the notebook's other modifiers (special allegiances, needs,
# favors owed) already summed by the caller: modifier * strength, per the
# notebook's "Determine Modifiers" block.
def reactionScore(t: int, q: Qualities, bias: int): int
    return rawScore(t, q) - baselineFor(t) + bias

# Thresholds are a feel knob, not a truth: +/-6 and +/-12 per Sean's ruling
# (2026-07-31), chosen to make "neutral" the ordinary case.  Widen the inner
# band if the world feels swingy, narrow it if it feels flat.
def bandOf(score: int): str
    if score <= 0 - 12
        return "hostile"
    if score <= 0 - 6
        return "cold"
    if score < 6
        return "neutral"
    if score < 12
        return "warm"
    return "devoted"

# ---------------------------------------------------------------------------
# The trace: why this reaction, in terms a reviewer can judge.
# ---------------------------------------------------------------------------

def termOf(t: int, q: Qualities, i: int): int
    return npcWeight(t, i) * (qualAt(q, i) - ordinaryLevel())

def absOf(v: int): int
    if v < 0
        return 0 - v
    return v

def signed(v: int): str
    if v < 0
        return v.toString()
    return "+" + v.toString()

# The three terms that moved this reaction furthest from neutral, largest
# first.  Ties break toward the notebook's column order, which keeps the
# output stable for characterization tests.
def traceOf(t: int, q: Qualities): str
    var out = ""
    var used: List(int) = []
    var n = 0
    while n < 3
        var best = 0 - 1
        var bestMag = 0
        var i = 0
        while i < 10
            var taken = false
            var u = 0
            while u < used.len
                if used.at(u) == i
                    taken = true
                u = u + 1
            if taken == false
                var mag = absOf(termOf(t, q, i))
                if mag > bestMag
                    bestMag = mag
                    best = i
            i = i + 1
        if best >= 0
            used.add(best)
            if out != ""
                out = out + "; "
            var lvl = "level"
            if qualAt(q, best) > ordinaryLevel()
                lvl = "high"
            if qualAt(q, best) < ordinaryLevel()
                lvl = "low"
            out = out + lvl + " " + qualName(best) + " (" + signed(termOf(t, q, best)) + ")"
        n = n + 1
    if out == ""
        return "nothing about this person moves him"
    return out

def reactionOf(t: int, q: Qualities, bias: int): Reaction
    var s = reactionScore(t, q, bias)
    var tr = traceOf(t, q)
    if bias != 0
        tr = tr + "; standing " + signed(bias)
    return Reaction(score: s, band: bandOf(s), why: tr)

# A one-line report, for eyeballing a cast or a scene.
def describe(t: int, q: Qualities, bias: int): str
    var r = reactionOf(t, q, bias)
    return npcName(t) + ": " + r.band + " (" + signed(r.score) + ") -- " + r.why


# ---------------------------------------------------------------------------
# Standing -- what the player has done for (or owes) this person.  The
# notebook keeps these separate from character qualities, and so do we: a
# quality is who you are, standing is what has passed between you.  This is
# the lever a player can actually pull in the moment.
#
# Weights are deliberately unequal.  A favour owed outranks a gift, because
# the notebook's own example is about obligation ("I don't think it's a good
# idea, but since I owe Joe -- I'll do it"), not payment.
# ---------------------------------------------------------------------------

struct Standing
    var favorsOwed: int       # times this NPC owes you
    var service: int          # help rendered to him or his people
    var gifts: int            # goods, coin, hospitality
    var allegiance: int       # -1 opposed, 0 none, +1 aligned (per the notebook)
    var allegianceStrength: int

def noStanding(): Standing
    return Standing(favorsOwed: 0, service: 0, gifts: 0, allegiance: 0, allegianceStrength: 0)

def standingBias(s: Standing): int
    return s.favorsOwed * 4 + s.service * 2 + s.gifts * 1 + s.allegiance * s.allegianceStrength * 3

# ---------------------------------------------------------------------------
# Fear.  Sean's observation: what someone will TELL you is not the same as
# how much they like you.  A frightened man is more compliant and less
# truthful, which is a different axis from warmth -- so we score it
# separately and let the two interact.
#
# Susceptibility per NPC type, 0 (unshakeable) .. 3 (easily cowed).  Prophets
# and kings are 0 on purpose: this world's prophets say hard things to
# thrones.
# ---------------------------------------------------------------------------

def fearTable(): str
    return "232110021210032211"

def intimidability(t: int): int
    if t < 0
        return 0
    if t >= 18
        return 0
    var row = fearTable()
    var c = row[t..t + 1]
    if c == "3"
        return 3
    if c == "2"
        return 2
    if c == "1"
        return 1
    return 0

# How threatening this player reads: prowess and courage above the ordinary,
# less whatever kindness softens.
def menaceOf(q: Qualities): int
    var m = (q.prowess - ordinaryLevel()) + (q.courage - ordinaryLevel()) - (q.kindness - ordinaryLevel())
    if m < 0
        return 0
    return m

def fearOf(t: int, q: Qualities): int
    return intimidability(t) * menaceOf(q)

# Fear that survives the relationship.  Someone who genuinely likes you is
# less governed by being afraid of you -- without this, a farmer who owes you
# two favours still lies to your face because you carry a sword, which reads
# as a bug even though every term in it is correct.
def netFearOf(t: int, q: Qualities, s: Standing): int
    var f = fearOf(t, q)
    var sc = reactionScore(t, q, standingBias(s))
    if sc > 0
        f = f - sc / 2
    if f < 0
        return 0
    return f

# ---------------------------------------------------------------------------
# Disposition -- the plumbing a scene actually consumes.  Content (the words
# themselves) stays with the author; this decides register, willingness, and
# truthfulness, and hands the scene a reason it can print.
# ---------------------------------------------------------------------------

struct Disposition
    var score: int
    var band: str
    var tone: str
    var willHelp: int         # 0 refuses .. 4 goes out of his way
    var candor: str
    var fear: int
    var why: str

def toneOf(band: str, fear: int): str
    if band == "hostile"
        if fear >= 6
            return "afraid and hostile"
        return "hostile"
    if band == "cold"
        if fear >= 6
            return "wary"
        return "curt"
    if band == "neutral"
        if fear >= 6
            return "careful"
        return "plain"
    if band == "warm"
        return "friendly"
    return "eager"

def helpLevelOf(band: str, fear: int): int
    var h = 2
    if band == "hostile"
        h = 0
    if band == "cold"
        h = 1
    if band == "warm"
        h = 3
    if band == "devoted"
        h = 4
    # Fear buys compliance, but only from someone not already willing.
    if fear >= 6
        if h < 3
            h = h + 1
    return h

# Candor is where fear and warmth pull apart: frightened people answer, and
# frightened people shade.  Intimidation gets you words, not truth.
def candorOf(band: str, fear: int): str
    if fear >= 12
        return "tells you what you want to hear"
    if fear >= 6
        if band == "warm"
            return "straight, but choosing words"
        if band == "devoted"
            return "straight, but choosing words"
        return "shades the truth"
    if band == "hostile"
        return "refuses"
    if band == "cold"
        return "guarded"
    if band == "neutral"
        return "answers what is asked"
    if band == "warm"
        return "straight"
    return "confides"

def dispositionOf(t: int, q: Qualities, s: Standing): Disposition
    var bias = standingBias(s)
    var sc = reactionScore(t, q, bias)
    var bd = bandOf(sc)
    var fr = netFearOf(t, q, s)
    var tr = traceOf(t, q)
    if bias != 0
        tr = tr + "; standing " + signed(bias)
    if fr >= 6
        tr = tr + "; and you frighten him"
    return Disposition(score: sc, band: bd, tone: toneOf(bd, fr), willHelp: helpLevelOf(bd, fr), candor: candorOf(bd, fr), fear: fr, why: tr)

def describeDisposition(t: int, q: Qualities, s: Standing): str
    var d = dispositionOf(t, q, s)
    return npcName(t) + ": " + d.tone + " (" + signed(d.score) + ", help " + d.willHelp.toString() + ", " + d.candor + ") -- " + d.why

def main()
    var soldierly = Qualities(wis: 2, faith: 2, ldr: 4, loyalty: 4, perception: 2, humility: 1, honor: 4, courage: 5, kindness: 2, prowess: 5)
    var gentle = Qualities(wis: 4, faith: 4, ldr: 2, loyalty: 3, perception: 4, humility: 5, honor: 4, courage: 2, kindness: 5, prowess: 1)
    var i = 0
    while i < 18
        print(describe(i, soldierly, 0))
        i = i + 1
    print("")
    i = 0
    while i < 18
        print(describe(i, gentle, 0))
        i = i + 1
    print("")
    print("-- the same farmer, as the player changes what has passed between them --")
    var farmer = 0
    print(describeDisposition(farmer, soldierly, noStanding()))
    print(describeDisposition(farmer, soldierly, Standing(favorsOwed: 0, service: 2, gifts: 0, allegiance: 0, allegianceStrength: 0)))
    print(describeDisposition(farmer, soldierly, Standing(favorsOwed: 2, service: 2, gifts: 1, allegiance: 1, allegianceStrength: 2)))
    print("")
    print("-- fear and warmth are different axes --")
    var frightening = Qualities(wis: 2, faith: 1, ldr: 4, loyalty: 3, perception: 2, humility: 1, honor: 2, courage: 5, kindness: 0, prowess: 5)
    print(describeDisposition(13, frightening, noStanding()))
    print(describeDisposition(12, frightening, noStanding()))
    print(describeDisposition(3, frightening, noStanding()))
