# NPC reactions — the 12/19/01 notebook's reaction table, made executable.
#
# Sean's notebook (writings/torial_game_notes/TRANSCRIPTION.md, §10) holds an
# 18x10 table: how each kind of NPC reacts to each visible quality of the
# player character, in the notebook's own arrow notation.  This file is that
# table as DATA plus a pure scoring function over it.  Nothing here has
# state; everything is testable.
#
# The table is stored one row per NPC type, one character per quality, so the
# source keeps the shape of the page it came from:
#
#     @ = +3 overwhelming      . =  0 none
#     # = +2 strong            - = -1 slight   (inverse)
#     + = +1 slight            = = -2 strong   (inverse)
#                              ~ = -3 overwhelming (inverse)
#
# Column order is the notebook's:
#   0 wisdom  1 faith  2 leadership  3 loyalty  4 perception
#   5 humility  6 honor  7 courage  8 kindness  9 prowess

struct Qualities
    var wis: int
    var faith: int
    var ldr: int
    var loyalty: int
    var perception: int
    var humility: int
    var honor: int
    var courage: int
    var kindness: int
    var prowess: int

# A reaction, with the reasoning that produced it.  The trace is the point:
# a number alone cannot be reviewed, but "cold because he weighs humility
# double and yours reads low" can.
struct Reaction
    var score: int
    var band: str
    var why: str

# ---------------------------------------------------------------------------
# The table.  One row per NPC type, in notebook order.
# ---------------------------------------------------------------------------

def rxnTable(): List(str)
    var t: List(str) = []
    t.add("#+...#..#.")     #  0 Farmer
    t.add(".+++-#.+#+")     #  1 Servant
    t.add(".-..#.#--+")     #  2 Merchant
    t.add(".+@#.-####")     #  3 Soldier
    t.add("#.+##.#+##")     #  4 Captain
    t.add("+..#+.#+.#")     #  5 General
    t.add("#..@++#+.+")     #  6 King/Chief
    t.add("++....+-#.")     #  7 Elderly
    t.add("~=++--+++.")     #  8 Criminal
    t.add("#+.+.++.#-")     #  9 Levite
    t.add("##.#.#+.#.")     # 10 Priest
    t.add("+@.@.#++#+")     # 11 High Priest
    t.add("+@.+#@##+.")     # 12 Prophet
    t.add("+++..#++@+")     # 13 Children
    t.add("+-..+..-#=")     # 14 Physician
    t.add("#-.+#.#.++")     # 15 Advisor
    t.add("#+.#+##.++")     # 16 Town-elder
    t.add("~~~~~~==-.")     # 17 Fool
    return t

def npcName(i: int): str
    if i == 0
        return "Farmer"
    if i == 1
        return "Servant"
    if i == 2
        return "Merchant"
    if i == 3
        return "Soldier"
    if i == 4
        return "Captain"
    if i == 5
        return "General"
    if i == 6
        return "King"
    if i == 7
        return "Elderly"
    if i == 8
        return "Criminal"
    if i == 9
        return "Levite"
    if i == 10
        return "Priest"
    if i == 11
        return "HighPriest"
    if i == 12
        return "Prophet"
    if i == 13
        return "Children"
    if i == 14
        return "Physician"
    if i == 15
        return "Advisor"
    if i == 16
        return "TownElder"
    if i == 17
        return "Fool"
    return "?"

def npcIndex(name: str): int
    var i = 0
    while i < 18
        if npcName(i) == name
            return i
        i = i + 1
    return 0 - 1

def qualName(i: int): str
    if i == 0
        return "wisdom"
    if i == 1
        return "faith"
    if i == 2
        return "leadership"
    if i == 3
        return "loyalty"
    if i == 4
        return "perception"
    if i == 5
        return "humility"
    if i == 6
        return "honor"
    if i == 7
        return "courage"
    if i == 8
        return "kindness"
    if i == 9
        return "prowess"
    return "?"

def qualAt(q: Qualities, i: int): int
    if i == 0
        return q.wis
    if i == 1
        return q.faith
    if i == 2
        return q.ldr
    if i == 3
        return q.loyalty
    if i == 4
        return q.perception
    if i == 5
        return q.humility
    if i == 6
        return q.honor
    if i == 7
        return q.courage
    if i == 8
        return q.kindness
    if i == 9
        return q.prowess
    return 0

# ---------------------------------------------------------------------------
# Weights
# ---------------------------------------------------------------------------

def weightChar(c: str): int
    if c == "@"
        return 3
    if c == "#"
        return 2
    if c == "+"
        return 1
    if c == "-"
        return 0 - 1
    if c == "="
        return 0 - 2
    if c == "~"
        return 0 - 3
    return 0

# The weight NPC type `t` puts on quality `q`, straight off the notebook page.
def npcWeight(t: int, q: int): int
    var tbl = rxnTable()
    if t < 0
        return 0
    if t >= tbl.len
        return 0
    if q < 0
        return 0
    if q >= 10
        return 0
    var row = tbl.at(t)
    return weightChar(row[q..q + 1])

# ---------------------------------------------------------------------------
# Scoring
#
# Qualities run 0..5 with 3 as ordinary.  A reaction is measured as DEVIATION
# from how this NPC would read a wholly ordinary person, so an average
# stranger is neutral to everyone and the table expresses what each kind of
# person actually notices.  Without that baseline, NPC types with many
# positive weights would love everyone and the Fool would hate everyone
# regardless of who walked in.
# ---------------------------------------------------------------------------

def ordinaryLevel(): int
    return 3

def baselineFor(t: int): int
    var total = 0
    var i = 0
    while i < 10
        total = total + npcWeight(t, i) * ordinaryLevel()
        i = i + 1
    return total

def rawScore(t: int, q: Qualities): int
    var total = 0
    var i = 0
    while i < 10
        total = total + npcWeight(t, i) * qualAt(q, i)
        i = i + 1
    return total

# `bias` carries the notebook's other modifiers (special allegiances, needs,
# favors owed) already summed by the caller: modifier * strength, per the
# notebook's "Determine Modifiers" block.
def reactionScore(t: int, q: Qualities, bias: int): int
    return rawScore(t, q) - baselineFor(t) + bias

# Thresholds are a feel knob, not a truth: +/-6 and +/-12 per Sean's ruling
# (2026-07-31), chosen to make "neutral" the ordinary case.  Widen the inner
# band if the world feels swingy, narrow it if it feels flat.
def bandOf(score: int): str
    if score <= 0 - 12
        return "hostile"
    if score <= 0 - 6
        return "cold"
    if score < 6
        return "neutral"
    if score < 12
        return "warm"
    return "devoted"

# ---------------------------------------------------------------------------
# The trace: why this reaction, in terms a reviewer can judge.
# ---------------------------------------------------------------------------

def termOf(t: int, q: Qualities, i: int): int
    return npcWeight(t, i) * (qualAt(q, i) - ordinaryLevel())

def absOf(v: int): int
    if v < 0
        return 0 - v
    return v

def signed(v: int): str
    if v < 0
        return v.toString()
    return "+" + v.toString()

# The three terms that moved this reaction furthest from neutral, largest
# first.  Ties break toward the notebook's column order, which keeps the
# output stable for characterization tests.
def traceOf(t: int, q: Qualities): str
    var out = ""
    var used: List(int) = []
    var n = 0
    while n < 3
        var best = 0 - 1
        var bestMag = 0
        var i = 0
        while i < 10
            var taken = false
            var u = 0
            while u < used.len
                if used.at(u) == i
                    taken = true
                u = u + 1
            if taken == false
                var mag = absOf(termOf(t, q, i))
                if mag > bestMag
                    bestMag = mag
                    best = i
            i = i + 1
        if best >= 0
            used.add(best)
            if out != ""
                out = out + "; "
            var lvl = "level"
            if qualAt(q, best) > ordinaryLevel()
                lvl = "high"
            if qualAt(q, best) < ordinaryLevel()
                lvl = "low"
            out = out + lvl + " " + qualName(best) + " (" + signed(termOf(t, q, best)) + ")"
        n = n + 1
    if out == ""
        return "nothing about this person moves him"
    return out

def reactionOf(t: int, q: Qualities, bias: int): Reaction
    var s = reactionScore(t, q, bias)
    var tr = traceOf(t, q)
    if bias != 0
        tr = tr + "; standing " + signed(bias)
    return Reaction(score: s, band: bandOf(s), why: tr)

# A one-line report, for eyeballing a cast or a scene.
def describe(t: int, q: Qualities, bias: int): str
    var r = reactionOf(t, q, bias)
    return npcName(t) + ": " + r.band + " (" + signed(r.score) + ") -- " + r.why


# ---------------------------------------------------------------------------
# Standing -- what the player has done for (or owes) this person.  The
# notebook keeps these separate from character qualities, and so do we: a
# quality is who you are, standing is what has passed between you.  This is
# the lever a player can actually pull in the moment.
#
# Weights are deliberately unequal.  A favour owed outranks a gift, because
# the notebook's own example is about obligation ("I don't think it's a good
# idea, but since I owe Joe -- I'll do it"), not payment.
# ---------------------------------------------------------------------------

struct Standing
    var favorsOwed: int       # times this NPC owes you
    var service: int          # help rendered to him or his people
    var gifts: int            # goods, coin, hospitality
    var allegiance: int       # -1 opposed, 0 none, +1 aligned (per the notebook)
    var allegianceStrength: int

def noStanding(): Standing
    return Standing(favorsOwed: 0, service: 0, gifts: 0, allegiance: 0, allegianceStrength: 0)

def standingBias(s: Standing): int
    return s.favorsOwed * 4 + s.service * 2 + s.gifts * 1 + s.allegiance * s.allegianceStrength * 3

# ---------------------------------------------------------------------------
# Fear.  Sean's observation: what someone will TELL you is not the same as
# how much they like you.  A frightened man is more compliant and less
# truthful, which is a different axis from warmth -- so we score it
# separately and let the two interact.
#
# Susceptibility per NPC type, 0 (unshakeable) .. 3 (easily cowed).  Prophets
# and kings are 0 on purpose: this world's prophets say hard things to
# thrones.
# ---------------------------------------------------------------------------

def fearTable(): str
    return "232110021210032211"

def intimidability(t: int): int
    if t < 0
        return 0
    if t >= 18
        return 0
    var row = fearTable()
    var c = row[t..t + 1]
    if c == "3"
        return 3
    if c == "2"
        return 2
    if c == "1"
        return 1
    return 0

# How threatening this player reads: prowess and courage above the ordinary,
# less whatever kindness softens.
def menaceOf(q: Qualities): int
    var m = (q.prowess - ordinaryLevel()) + (q.courage - ordinaryLevel()) - (q.kindness - ordinaryLevel())
    if m < 0
        return 0
    return m

def fearOf(t: int, q: Qualities): int
    return intimidability(t) * menaceOf(q)

# Fear that survives the relationship.  Someone who genuinely likes you is
# less governed by being afraid of you -- without this, a farmer who owes you
# two favours still lies to your face because you carry a sword, which reads
# as a bug even though every term in it is correct.
def netFearOf(t: int, q: Qualities, s: Standing): int
    var f = fearOf(t, q)
    var sc = reactionScore(t, q, standingBias(s))
    if sc > 0
        f = f - sc / 2
    if f < 0
        return 0
    return f

# ---------------------------------------------------------------------------
# Disposition -- the plumbing a scene actually consumes.  Content (the words
# themselves) stays with the author; this decides register, willingness, and
# truthfulness, and hands the scene a reason it can print.
# ---------------------------------------------------------------------------

struct Disposition
    var score: int
    var band: str
    var tone: str
    var willHelp: int         # 0 refuses .. 4 goes out of his way
    var candor: str
    var fear: int
    var why: str

def toneOf(band: str, fear: int): str
    if band == "hostile"
        if fear >= 6
            return "afraid and hostile"
        return "hostile"
    if band == "cold"
        if fear >= 6
            return "wary"
        return "curt"
    if band == "neutral"
        if fear >= 6
            return "careful"
        return "plain"
    if band == "warm"
        return "friendly"
    return "eager"

def helpLevelOf(band: str, fear: int): int
    var h = 2
    if band == "hostile"
        h = 0
    if band == "cold"
        h = 1
    if band == "warm"
        h = 3
    if band == "devoted"
        h = 4
    # Fear buys compliance, but only from someone not already willing.
    if fear >= 6
        if h < 3
            h = h + 1
    return h

# Candor is where fear and warmth pull apart: frightened people answer, and
# frightened people shade.  Intimidation gets you words, not truth.
def candorOf(band: str, fear: int): str
    if fear >= 12
        return "tells you what you want to hear"
    if fear >= 6
        if band == "warm"
            return "straight, but choosing words"
        if band == "devoted"
            return "straight, but choosing words"
        return "shades the truth"
    if band == "hostile"
        return "refuses"
    if band == "cold"
        return "guarded"
    if band == "neutral"
        return "answers what is asked"
    if band == "warm"
        return "straight"
    return "confides"

def dispositionOf(t: int, q: Qualities, s: Standing): Disposition
    var bias = standingBias(s)
    var sc = reactionScore(t, q, bias)
    var bd = bandOf(sc)
    var fr = netFearOf(t, q, s)
    var tr = traceOf(t, q)
    if bias != 0
        tr = tr + "; standing " + signed(bias)
    if fr >= 6
        tr = tr + "; and you frighten him"
    return Disposition(score: sc, band: bd, tone: toneOf(bd, fr), willHelp: helpLevelOf(bd, fr), candor: candorOf(bd, fr), fear: fr, why: tr)

def describeDisposition(t: int, q: Qualities, s: Standing): str
    var d = dispositionOf(t, q, s)
    return npcName(t) + ": " + d.tone + " (" + signed(d.score) + ", help " + d.willHelp.toString() + ", " + d.candor + ") -- " + d.why


# ---------------------------------------------------------------------------
# Regions.  Sean's idea (2026-07-31): the same kind of person does not weigh
# the same things in Torial, in Pilisia, and among the Tuon Tribes.
#
# Rather than eighteen-by-ten tables per nation -- an authoring burden that
# would never be finished, and impossible to review -- a region is stored as
# an OVERLAY on the base table: only the cells where that culture differs.
# The consequence is that a nation is legible as its deviations.  You can
# read what a people has become by reading the short list of places its
# table departs from the ordinary.
#
# An overlay record is four characters: two digits of NPC type, one digit of
# quality, one weight character.  "035~" = Soldier (03) weighs humility (5)
# as overwhelming inverse (~).
#
# The overlays below are PROPOSALS grounded in canon, not rulings: Pilisia
# from its child-sacrifice to Ikral and the judgment that its people were
# "not noble, nor worthy of any praise"; the Tuon from song, honour, and the
# defence of cubs.  Sean owns the values; the machinery does not care.
# ---------------------------------------------------------------------------

def regionName(r: int): str
    if r == 0
        return "Torial"
    if r == 1
        return "Pilisia"
    if r == 2
        return "TuonTribes"
    return "?"

def regionOverlay(r: int): List(str)
    var o: List(str) = []
    if r == 1
        # Pilisia: a land that fed its firstborn to a bull-headed god.
        o.add("105-")   # Priest x humility: strong -> slight inverse
        o.add("108-")   # Priest x kindness: strong -> slight inverse
        o.add("005.")   # Farmer x humility: strong -> none
        o.add("026-")   # Merchant x honor: strong -> slight inverse
        o.add("069#")   # King x prowess: slight -> strong
        o.add("138#")   # Children x kindness: overwhelming -> strong
        o.add("071-")   # Elderly x faith: slight -> slight inverse
    if r == 2
        # The Tuon Tribes: song, honour, and the cubs.
        o.add("007+")   # Farmer x courage: none -> slight
        o.add("026@")   # Merchant x honor: strong -> overwhelming
        o.add("036@")   # Soldier x honor: strong -> overwhelming
        o.add("137#")   # Children x courage: slight -> strong
        o.add("076#")   # Elderly x honor: slight -> strong
        o.add("088=")   # Criminal x kindness: slight -> strong inverse
    return o

def digitOf(c: str): int
    if c == "1"
        return 1
    if c == "2"
        return 2
    if c == "3"
        return 3
    if c == "4"
        return 4
    if c == "5"
        return 5
    if c == "6"
        return 6
    if c == "7"
        return 7
    if c == "8"
        return 8
    if c == "9"
        return 9
    return 0

# The weight this NPC type puts on this quality, in this part of the world.
def regionWeight(r: int, t: int, q: int): int
    var o = regionOverlay(r)
    var i = 0
    while i < o.len
        var rec = o.at(i)
        var rt = digitOf(rec[0..1]) * 10 + digitOf(rec[1..2])
        var rq = digitOf(rec[2..3])
        if rt == t
            if rq == q
                return weightChar(rec[3..4])
        i = i + 1
    return npcWeight(t, q)

def regionBaseline(r: int, t: int): int
    var total = 0
    var i = 0
    while i < 10
        total = total + regionWeight(r, t, i) * ordinaryLevel()
        i = i + 1
    return total

def regionScore(r: int, t: int, q: Qualities, bias: int): int
    var total = 0
    var i = 0
    while i < 10
        total = total + regionWeight(r, t, i) * qualAt(q, i)
        i = i + 1
    return total - regionBaseline(r, t) + bias

# --- Reading a nation's character out of what its people reward ------------
#
# Five of the ten qualities are virtues in this world's own terms: wisdom,
# faith, humility, kindness, honour.  A culture that rewards them scores
# positive; one that punishes them scores negative.  The Fool's row is
# inverse to every virtue, so a nation drifting toward the Fool is a nation
# becoming foolish -- which is a thing this world says in prose and can now
# say in a number.

def virtueSign(q: int): int
    if q == 0
        return 1        # wisdom
    if q == 1
        return 1        # faith
    if q == 5
        return 1        # humility
    if q == 6
        return 1        # honor
    if q == 8
        return 1        # kindness
    return 0

def virtueIndex(r: int): int
    var total = 0
    var t = 0
    while t < 18
        var q = 0
        while q < 10
            total = total + regionWeight(r, t, q) * virtueSign(q)
            q = q + 1
        t = t + 1
    return total

# How far this region's table has moved from the base one, in cells.
def regionDrift(r: int): int
    var n = 0
    var t = 0
    while t < 18
        var q = 0
        while q < 10
            if regionWeight(r, t, q) != npcWeight(t, q)
                n = n + 1
            q = q + 1
        t = t + 1
    return n


# ---------------------------------------------------------------------------
# Pressures -- the reaction as a VECTOR rather than a sum.
#
# Sean's observation (2026-08-01), by way of the ABC software metric: a single
# score cannot hold what actually decides behaviour, because different forces
# of equal size are not interchangeable.
#
#   * A scalar loses the SOURCE.  +5 because he admires your humility and +5
#     because you paid him produce the same number and should not produce the
#     same man: the fond one defends you behind your back, the paid one does
#     not.
#   * A constraint is not a preference.  A guild blacksmith is not lukewarm --
#     he is willing and GATED, which produces help in hiding.  That is a mode,
#     not a degree, and no sum can express it.
#   * Rival fears do not add, they COMPETE.  Your menace and the local
#     strongman's do not combine into "very afraid": the stronger governs, and
#     its identity decides whom he is hiding from.  That is an argmax.
#
# The scalar is not discarded -- it becomes a PROJECTION of the vector, so
# every earlier result and test still holds.
# ---------------------------------------------------------------------------

struct Pressures
    var affinity: int       # what he thinks of your character (the table)
    var obligation: int     # favours owed, service rendered
    var payment: int        # goods, coin, hospitality
    var ideology: int       # allegiance for or against
    var fearOfYou: int      # how much you frighten him
    var fearOfOther: int    # what else he is more afraid of
    var otherName: str      # who that is -- concealment needs a target
    var constraint: int     # oath, guild rule, law: wants to, may not
    var constraintName: str

def noPressureExtras(): Pressures
    return Pressures(affinity: 0, obligation: 0, payment: 0, ideology: 0, fearOfYou: 0, fearOfOther: 0, otherName: "", constraint: 0, constraintName: "")

# Build the vector from the parts the engine already knows, then let the
# caller add the world's own pressures (a guild, a warlord, a debt to someone
# else) before resolving.
def pressuresOf(r: int, t: int, q: Qualities, s: Standing): Pressures
    var aff = regionScore(r, t, q, 0)
    var obl = s.favorsOwed * 4 + s.service * 2
    var pay = s.gifts * 1
    var ide = s.allegiance * s.allegianceStrength * 3
    var fear = fearOf(t, q)
    var warm = aff + obl + pay + ide
    if warm > 0
        fear = fear - warm / 2
    if fear < 0
        fear = 0
    return Pressures(affinity: aff, obligation: obl, payment: pay, ideology: ide, fearOfYou: fear, fearOfOther: 0, otherName: "", constraint: 0, constraintName: "")

def withRival(p: Pressures, name: str, strength: int): Pressures
    return p except fearOfOther = strength, otherName = name

def withConstraint(p: Pressures, name: str, strength: int): Pressures
    return p except constraint = strength, constraintName = name

# The old scalar, recovered as a projection of the vector.
def projectScore(p: Pressures): int
    return p.affinity + p.obligation + p.payment + p.ideology

# ---------------------------------------------------------------------------
# Resolution.  Behaviour is read off the whole vector, not off its sum.
# ---------------------------------------------------------------------------

struct Outcome
    var band: str
    var willing: int        # 0 refuses .. 4 goes out of his way
    var mode: str           # "openly", "in hiding", "not at all"
    var candor: str
    var governedBy: str     # which pressure actually decided it
    var why: str

# Who is he most afraid of?  The stronger fear governs, and it matters WHO it
# is: a man hides from the power he fears, not from the one he is talking to.
def governingFear(p: Pressures): str
    if p.fearOfOther > p.fearOfYou
        return p.otherName
    if p.fearOfYou > 0
        return "you"
    return ""

def resolveOutcome(p: Pressures): Outcome
    var warm = projectScore(p)
    var bd = bandOf(warm)
    var w = helpLevelOf(bd, p.fearOfYou)
    var gov = governingFear(p)
    var mode = "openly"
    var cand = candorOf(bd, p.fearOfYou)
    var why = ""

    # A constraint gates rather than cools: it can turn open help into hidden
    # help, or -- if it outweighs every reason he has to help you -- into none.
    if p.constraint > 0
        if w == 0
            mode = "not at all"
        if w > 0
            if p.constraint >= w * 3
                mode = "not at all"
                w = 0
            if p.constraint < w * 3
                mode = "in hiding"
        why = why + "bound by " + p.constraintName + " (" + p.constraint.toString() + ")"

    # A rival power he fears more than you does the same thing, but the
    # concealment has a name attached.
    if p.fearOfOther > p.fearOfYou
        if p.fearOfOther >= 12
            w = 0
            mode = "not at all"
            cand = "will not speak of it"
        if p.fearOfOther < 12
            if mode == "openly"
                mode = "in hiding"
        if why != ""
            why = why + "; "
        why = why + "fears " + p.otherName + " more than you"

    # And when YOU are the greatest fear in the room, compliance rises and
    # truth falls -- intimidation buys words, not accuracy.
    if p.fearOfYou > p.fearOfOther
        if p.fearOfYou >= 6
            if why != ""
                why = why + "; "
            why = why + "you are the thing he fears most"

    if why == ""
        why = "nothing constrains him"
    return Outcome(band: bd, willing: w, mode: mode, candor: cand, governedBy: gov, why: why)

def describeOutcome(t: int, p: Pressures): str
    var o = resolveOutcome(p)
    var s = npcName(t) + ": " + o.band + ", helps " + o.willing.toString() + " " + o.mode
    s = s + " (" + o.candor + ")"
    if o.governedBy != ""
        s = s + " [governed by fear of " + o.governedBy + "]"
    return s + " -- " + o.why

def main()
    var soldierly = Qualities(wis: 2, faith: 2, ldr: 4, loyalty: 4, perception: 2, humility: 1, honor: 4, courage: 5, kindness: 2, prowess: 5)
    var gentle = Qualities(wis: 4, faith: 4, ldr: 2, loyalty: 3, perception: 4, humility: 5, honor: 4, courage: 2, kindness: 5, prowess: 1)
    var i = 0
    while i < 18
        print(describe(i, soldierly, 0))
        i = i + 1
    print("")
    i = 0
    while i < 18
        print(describe(i, gentle, 0))
        i = i + 1
    print("")
    print("-- the same farmer, as the player changes what has passed between them --")
    var farmer = 0
    print(describeDisposition(farmer, soldierly, noStanding()))
    print(describeDisposition(farmer, soldierly, Standing(favorsOwed: 0, service: 2, gifts: 0, allegiance: 0, allegianceStrength: 0)))
    print(describeDisposition(farmer, soldierly, Standing(favorsOwed: 2, service: 2, gifts: 1, allegiance: 1, allegianceStrength: 2)))
    print("")
    print("-- fear and warmth are different axes --")
    var frightening = Qualities(wis: 2, faith: 1, ldr: 4, loyalty: 3, perception: 2, humility: 1, honor: 2, courage: 5, kindness: 0, prowess: 5)
    print(describeDisposition(13, frightening, noStanding()))
    print(describeDisposition(12, frightening, noStanding()))
    print(describeDisposition(3, frightening, noStanding()))
    print("")
    print("-- the same gentle scribe, in three parts of the world --")
    var r = 0
    while r < 3
        print("  " + regionName(r) + ": priest " + signed(regionScore(r, 10, gentle, 0)) + ", farmer " + signed(regionScore(r, 0, gentle, 0)) + ", children " + signed(regionScore(r, 13, gentle, 0)))
        r = r + 1
    print("")
    print("-- what each people rewards, totalled over virtue --")
    r = 0
    while r < 3
        print("  " + regionName(r) + ": virtue index " + signed(virtueIndex(r)) + ", cells differing from Torial: " + regionDrift(r).toString())
        r = r + 1
    print("")
    print("-- the same blacksmith, differently placed --")
    var buyer = Qualities(wis: 3, faith: 3, ldr: 3, loyalty: 3, perception: 4, humility: 3, honor: 3, courage: 3, kindness: 3, prowess: 3)
    var paid = Standing(favorsOwed: 0, service: 0, gifts: 4, allegiance: 0, allegianceStrength: 0)
    var smith = 2
    var base = pressuresOf(0, smith, buyer, paid)
    print("  village smith:  " + describeOutcome(smith, base))
    print("  guild smith:    " + describeOutcome(smith, withConstraint(base, "his guild oath", 6)))
    print("  under a warlord:" + describeOutcome(smith, withRival(base, "the warlord", 9)))
    print("")
    print("-- two fears in one room --")
    var hardMan = Qualities(wis: 2, faith: 2, ldr: 4, loyalty: 3, perception: 2, humility: 1, honor: 2, courage: 5, kindness: 1, prowess: 5)
    var p2 = pressuresOf(0, smith, hardMan, noStanding())
    print("  you are the worst thing here: " + describeOutcome(smith, p2))
    print("  the warlord is worse:         " + describeOutcome(smith, withRival(p2, "the warlord", 14)))
