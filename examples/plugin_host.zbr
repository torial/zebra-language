interface IGreeter
    def greet(name: str): str

def main() throws
    var lib = DynLib.open("hello_plugin")
    # `lookup` returns the interface value itself (QUICKSTART §44); the older
    # `^IGreeter?` + `as` form predates BUG-356 and stopped compiling with it.
    var g = lib.lookup(IGreeter, "plugin_create")
    print(g.greet("World"))
    lib.close()
