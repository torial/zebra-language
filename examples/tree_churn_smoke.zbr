# Tree churn smoke (2026-09-17; the declarative-retained section, concept_zebra-gui-declarative §3).
# Every tick the view changes SHAPE, not just text: a vbox that exists on odd ticks,
# a run of text lines whose count changes, keyed buttons whose ORDER rotates, a
# panel that comes and goes, and a tab strip whose pages rotate. Under the old
# adapter each of these was a frame-0 rule or a hidden-not-removed widget; under
# the tree they are inserts, removes and moves. Compile control: --gui-backend=tui.

class Model
    var ticks: int = 0
    var pressed: str = ""

def churnInit(): Model
    return Model()

# int messages: 1 = tick, 2 = the odd-tick button, 10 + k = rotating button k
def update(m: Model, msg: int): Model
    if msg == 1
        m.ticks = m.ticks + 1
    else if msg == 2
        m.pressed = "odd"
    else if msg >= 10
        m.pressed = "b${msg - 10}"
    return m

def view(g: Gui, m: Model)
    g.every(500, 1)
    using g.vbox("##root", true)
        g.text("tick ${m.ticks}   last pressed: ${m.pressed}")
        # 1. a box that exists only on odd ticks, in the MIDDLE of its siblings
        if m.ticks % 2 == 1
            using g.hbox("##odd", false)
                g.text("odd-tick box")
                g.button("odd button", 2)
        g.text("after the odd box")
        # 2. a run of positional lines whose count changes
        var i: int = 0
        while i < 1 + (m.ticks % 4)
            g.text("line ${i}")
            i = i + 1
        # 3. buttons whose order rotates every tick (a button is keyed by its label)
        using g.hbox("##rot", false)
            var k: int = 0
            while k < 3
                var which: int = (k + m.ticks) % 3
                g.button("button ${which}", 10 + which)
                k = k + 1
        # 4. a panel that comes and goes every third tick
        if m.ticks % 3 != 0
            if g.beginPanel("Sometimes")
                g.text("inside the panel")
                g.endPanel("Sometimes")
        # 5. a strip whose pages rotate and rename
        g.beginTabs("##strip", true)
        var p: int = 0
        while p < 2 + (m.ticks % 2)
            var pg: int = (p + m.ticks) % 3
            g.beginTabPage("##p${pg}", "page ${pg} (t${m.ticks % 10})")
            g.text("content ${pg}")
            g.endTabPage()
            p = p + 1
        g.endTabs()

def main()
    Gui.run("Tree Churn Smoke", 700, 500, churnInit, update, view)
