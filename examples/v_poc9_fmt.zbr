# v_poc9_fmt.zbr -- string interpolation of floats on the V backend (2026-10-23).
# The emitter takes a fast path when every hole is a float with an explicit `.Nf`
# spec: one formatted write (zfmt_f: one C.snprintf, one copy) instead of V's
# str_intp, which makes a heap string per formatted value. The claim is byte-for-
# byte agreement with the Zig backend's allocPrint `{d:.Nf}`, so the rows here are
# the ones where C's printf and Zig's formatting could disagree: exact-binary ties,
# a tiny value rounding to zero, signed zero, nan and the infinities, a large
# magnitude, a `%` in the literal, twelve holes, a result longer than the fast
# path's stack buffer. The rows with an int or a string hole, or a bare `${x}`, are
# the slow path, printed beside them so the two paths read alike.

# The positive control for the runtime's naming rule (v_backend_poc.md item 22, 2026-10-26): module
# consts named after the runtime's former locals -- the formatter's (tmp, tp, hole, at) and the
# most common of the rest of the file's before tools/prefix_rt_locals.py prefixed them all (buf, pos,
# m, out, x, c, r, n, p, old, i, s, k, b, l). The runtime file is compiled into this program's
# module, and V 0.5.2 silently miscompiles a runtime local that shares a const's name; with every
# runtime local prefixed this prints, and a bare name returning to zebra_rt.v fails the lane here
# (the C stage, or the lane's own CONST SHADOW refusal of V's warning).
const tmp: int = 7
const tp: int = 9
const hole: int = 1
const at: int = 4
const buf: str = "b"
const pos: int = 2
const m: int = 3
const out: int = 5
const x: int = 6
const c: int = 8
const r: int = 10
const n: int = 11
const p: int = 12
const old: int = 13
const i: int = 14
const s: int = 15
const k: int = 16
const b: int = 17
const l: int = 18

def mk(x: float): float
    return x

def main()
    var r: float = 10.3
    var g: float = 0.123456
    print("one|${r:.1f}|${g:.4f}")
    print("ten|${r:.1f}|${g:.1f}|${r:.1f}|${g:.1f}|${r:.4f}|${g:.4f}|${r:.4f}|${g:.4f}|${r:.4f}|${g:.1f}")
    # ties and near-ties under the language's rule since 2026-10-26 (exact binary, ties to even:
    # Python's digits): 0.125 is an exact tie -> 0.12 (even), 2.675 is 2.67499... -> 2.67,
    # 0.5 -> 0, 1.5 -> 2, 2.5 -> 2
    var t1: float = 0.125
    var t2: float = 2.675
    var t3: float = 0.5
    var t4: float = 1.5
    var t5: float = 2.5
    print("ties|${t1:.2f}|${t2:.2f}|${t3:.0f}|${t4:.0f}|${t5:.0f}")
    # tiny, signed zero, a tiny negative rounding to zero
    var tiny: float = 0.0000001
    var negz: float = 0.0 - 0.0
    var negtiny: float = 0.0 - 0.001
    print("zero|${tiny:.1f}|${negz:.1f}|${negtiny:.1f}|${negtiny:.3f}")
    # nan and the infinities
    var zero: float = 0.0
    var inf: float = 1.0 / zero
    var ninf: float = 0.0 - 1.0 / zero
    var nan: float = zero / zero
    print("special|${inf:.1f}|${ninf:.1f}|${nan:.1f}")
    # large magnitudes: every integer digit
    var big: float = 100000000000000000000.0
    var big2: float = 123456789012345678.0
    print("big|${big:.1f}|${big2:.1f}|${big:.0f}")
    # a percent in the literal
    print("pct|100%|${r:.1f}%|%%")
    # twelve holes, the most the fast path takes
    print("twelve|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}")
    # thirteen holes: the slow path
    print("thirteen|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}|${r:.1f}")
    # a result longer than 512 bytes: the fast path formats again into a buffer of its size
    var pad: str = "0123456789"
    var long: str = ""
    var i: int = 0
    while i < 60
        long = long + pad
        i = i + 1
    var longLine: str = "${long}|${r:.4f}"
    print("long|" + longLine.len.toString() + "|" + longLine.substring(595, longLine.len))
    # the slow path beside the fast: an int hole, a string hole, a bare float hole
    var k: int = 42
    var name: str = "Part7"
    print("slow|${k}|${name}|${r}|${r:.1f}")
    # a call in a hole
    print("call|${mk(2.5):.2f}|${mk(r) * 2.0:.1f}")
    # carries and signs: 1.005, 0.045 and 9.995 are binary values just under their decimal ties and
    # round down (1.00, 0.04, 9.99); 99.5 and 0.5 are exact ties and go to even (100, 0); -2.675
    # keeps its sign (-2.67); 1e16 at .0f is an exact integer (V's own .0f printed "10" for it on 0.5.2)
    var c1: float = 1.005
    var c2: float = 0.045
    var c3: float = 9.995
    var c4: float = 99.5
    var c5: float = 0.0 - 2.675
    var c6: float = 10000000000000000.0
    print("carry|${c1:.2f}|${c2:.2f}|${c3:.2f}|${c4:.0f}|${t3:.0f}|${c5:.2f}|${c6:.0f}")
    # the sign and the point: -9.995 and 0.995 lie under their ties (-9.99, 0.99); at .0f they are
    # no ties (-10, 1); and the Zig fixture's own two: 1.45 holds 1.4499... (1.4), 9.996 carries (10.00)
    var c7: float = 0.0 - 9.995
    var c8: float = 0.995
    var c9: float = 1.45
    var c10: float = 9.996
    print("carry2|${c7:.2f}|${c8:.2f}|${c7:.0f}|${c8:.0f}|${c9:.1f}|${c10:.2f}")
    # exact ties at every parity, .0f and .2f: 0.5 2.5 -> even down, 1.5 3.5 -> even up; 0.125 ->
    # 0.12, 0.375 -> 0.38; the negative halves mirror (-0.5 -> -0, -1.5 -> -2)
    var h1: float = 3.5
    var h2: float = 0.375
    var h3: float = 0.0 - 0.5
    var h4: float = 0.0 - 1.5
    print("halves|${t3:.0f}|${t4:.0f}|${t5:.0f}|${h1:.0f}|${t1:.2f}|${h2:.2f}|${h3:.0f}|${h4:.0f}")
    # a mixed interpolation's float holes go the same way (one at a tie, one carrying)
    print("mixed|${name}|${t2:.2f}|${k}|${c3:.2f}|${c5:.1f}")
    print("consts|${tmp}|${tp}|${hole}|${at}|${buf}|${pos}|${m}|${out}|${x}|${c}|${r}|${n}|${p}|${old}|${i}|${s}|${k}|${b}|${l}")
    # a BARE float hole (no spec) and a float's toString: the Zig backend's {d} spelling -- the
    # shortest round-trip digits, never an exponent, ".0" when whole (V's own str() says 1e+20)
    var b1: float = 100000000000000000000.0
    var b2: float = 1.0 / 3.0
    var b3: float = 123456789012345680000.0
    var b4: float = 0.0 - 0.00000000015
    var b5: float = 2.0
    var b6: float = 0.1
    var b7: float = 12345.678
    print("bare|${b1}|${g}|${b2}|${nan}|${inf}|${ninf}|${negz}|${b3}|${b4}|${b5}|${b6}|${b7}|${tiny}")
    var b8: float = 1.0
    var i2: int = 0
    while i2 < 300
        b8 = b8 * 10.0
        i2 = i2 + 1
    var b8s: str = "${b8}"
    print("bare300|" + b8s.len.toString() + "|" + b8s.substring(0, 5) + "|" + b8s.substring(b8s.len - 3, b8s.len))
    print("tostr|" + b1.toString() + "|" + b5.toString() + "|" + b4.toString())
    # negative zero itself (0.0 - 0.0 is positive zero): bare, at .1f, and through toString
    var nz: float = 0.0 * (0.0 - 1.0)
    print("negzero|${nz}|${nz:.1f}|" + nz.toString())
