# Faithful-math regression test for examples/tears_of_the_tuon.zbr.
#
# Imports only the PURE combat functions from the game (the GUI `main` is not
# run on import), so we can pin the exact ported numbers with a fixed RNG
# seed — no GUI backend involved. This is the payoff of keeping `update`'s
# combat logic in seed-in / result-out pure functions.

use tears_of_the_tuon exposing Weapon, swordW, bowW, daggerW, AttackOutcome, resolveAttack, weaponScore, chooseEnemyWeapon, tryFlee, playerFirst, GameModel, Msg, update, hasFlag, tileAt, applyExperience, expLevelMax, levelAgi, levelMaxHp, saveGame, loadGame, arnaOutcome, arnaStep, arnaRegion, yehuQualities, arnaWhoName

def arnaMan(flags: List(str)): GameModel
    return GameModel(phase: 16, diff: 1, pHp: 35, e0Hp: 0, e1Hp: 0, selWeapon: 0, round: 1, xp: 0, level: 2, story: 0, states: flags, px: 5, py: 25, rngSeed: 7, log: ["at Arna"])

def main()
    # --- weapon data matches the original JSON ---
    var s = swordW()
    assert s.damage == 15 and s.critChance == 20 and s.critDamage == 25, "sword data"
    var b = bowW()
    assert b.damage == 12 and b.critChance == 15 and b.critDamage == 25, "bow data"
    var d = daggerW()
    assert d.damage == 10 and d.critChance == 10 and d.critDamage == 20, "dagger data"

    # --- weaponScore = damage + critChance*critDamage (enemy AI metric) ---
    assert weaponScore(s) == 15 + 20 * 25, "sword score"
    assert weaponScore(b) == 12 + 15 * 25, "bow score"
    assert weaponScore(d) == 10 + 10 * 20, "dagger score"

    # --- enemy weapon AI: easy = weakest, hard = strongest (bow vs dagger) ---
    # dagger score = 210, bow score = 387 → dagger is weaker.
    assert chooseEnemyWeapon(1, bowW(), daggerW(), 0) == 1, "easy picks weakest (dagger)"
    assert chooseEnemyWeapon(1, bowW(), daggerW(), 2) == 0, "hard picks strongest (bow)"
    # medium is seed-derived (seed % 2), off the attack stream.
    assert chooseEnemyWeapon(4, bowW(), daggerW(), 1) == 0, "medium seed 4 -> 0"
    assert chooseEnemyWeapon(5, bowW(), daggerW(), 1) == 1, "medium seed 5 -> 1"

    # --- resolveAttack is deterministic for a fixed seed ---
    # Yehu (agi 25, str 15) sword vs Ruffian (agi 15, armor 10), medium.
    var o1 = resolveAttack(42, "Yehu", 25, 15, swordW(), "Ruffian A", 15, 10, true, 1)
    var o2 = resolveAttack(42, "Yehu", 25, 15, swordW(), "Ruffian A", 15, 10, true, 1)
    assert o1.hit == o2.hit and o1.damage == o2.damage and o1.crit == o2.crit, "deterministic per seed"
    assert o1.nextSeed == o2.nextSeed, "seed advance deterministic"
    assert o1.nextSeed != 42, "stream actually advanced"

    # A hit's damage never drops below the 1-damage floor, and a miss deals 0.
    var seed = 1
    var hits = 0
    var misses = 0
    var minHitDmg = 9999
    var i = 0
    while i < 200
        var o = resolveAttack(seed, "Yehu", 25, 15, swordW(), "Ruffian", 15, 10, true, 1)
        if o.hit
            hits = hits + 1
            assert o.damage >= 1, "hit damage floor"
            if o.damage < minHitDmg
                minHitDmg = o.damage
        else
            misses = misses + 1
            assert o.damage == 0, "miss deals no damage"
        seed = o.nextSeed
        i = i + 1
    assert hits > 0 and misses > 0, "both hits and misses occur over 200 rolls"

    # --- difficulty favours the player: easy attacker beats hard attacker on
    #     the same seed (easy adds +2 to the attack roll, hard subtracts 2) ---
    var easyHits = 0
    var hardHits = 0
    seed = 7
    i = 0
    while i < 200
        var oe = resolveAttack(seed, "Yehu", 25, 15, swordW(), "Ruffian", 15, 10, true, 0)
        var oh = resolveAttack(seed, "Yehu", 25, 15, swordW(), "Ruffian", 15, 10, true, 2)
        if oe.hit
            easyHits = easyHits + 1
        if oh.hit
            hardHits = hardHits + 1
        seed = oe.nextSeed
        i = i + 1
    assert easyHits >= hardHits, "easy lands at least as many hits as hard"

    # --- initiative: easy = player first, hard = enemy first, medium by agility ---
    assert playerFirst(0, 25, 30) == true, "easy: player first"
    assert playerFirst(2, 25, 30) == false, "hard: enemy first"
    assert playerFirst(1, 30, 25) == true, "medium: higher agility first"
    assert playerFirst(1, 25, 30) == false, "medium: lower agility second"

    # --- end-to-end FSM: drive `update` through a full Easy battle ---
    # Fixed-seed model (bypasses init()'s entropy) so the playthrough is
    # reproducible. On Easy, Yehu (35 HP, +2 rolls) should beat two 20-HP
    # Ruffians. We auto-pick the sword and target the first standing enemy.
    var noFlags: List(str) = []
    var m = GameModel(phase: 1, diff: 0, pHp: 35, e0Hp: 20, e1Hp: 20, selWeapon: 0, round: 1, xp: 0, level: 1, story: 0, states: noFlags, px: 5, py: 25, rngSeed: 12345, log: ["start"])
    var steps = 0
    while m.phase != 4 and m.phase != 5 and steps < 500
        if m.phase == 1
            m = update(m, Msg.atkSword)
        if m.phase == 2
            if m.e0Hp > 0
                m = update(m, Msg.tgt0)
            else
                m = update(m, Msg.tgt1)
        if m.phase == 3
            m = update(m, Msg.enemyTurn)
        steps = steps + 1
    assert m.phase == 4, "easy battle ends in victory"
    assert m.xp == 50, "victory awards 50 xp (2 x killExp 25)"
    assert m.level == 2, "50 xp crosses the level-1 threshold (0) once"
    assert m.e0Hp <= 0 and m.e1Hp <= 0, "both Ruffians defeated"
    assert m.pHp > 0, "Yehu survives on Easy"

    # --- story FSM: intro pages -> Get the Cubs -> bridge -> title;
    #     victory -> epilogue pages -> last page holds ---
    var noFlags2: List(str) = []
    var sm = GameModel(phase: 7, diff: 1, pHp: 35, e0Hp: 20, e1Hp: 20, selWeapon: 0, round: 1, xp: 0, level: 1, story: 0, states: noFlags2, px: 5, py: 25, rngSeed: 1, log: ["start"])
    sm = update(sm, Msg.pageNext)
    sm = update(sm, Msg.pageNext)
    sm = update(sm, Msg.pageNext)
    assert sm.phase == 7 and sm.story == 3, "three page-turns reach the muster page"
    sm = update(sm, Msg.pageNext)
    assert sm.story == 3, "pageNext holds at the choice page (choice required)"
    sm = update(sm, Msg.getCubs)
    assert sm.phase == 7 and sm.story == 4, "Get the Cubs jumps to the bridge page"
    sm = update(sm, Msg.getCubs)
    assert sm.phase == 0, "the bridge leads to the difficulty title"
    var em = m
    em = update(em, Msg.contTale)
    assert em.phase == 8 and em.story == 0, "victory continues into the epilogue"
    em = update(em, Msg.pageNext)
    em = update(em, Msg.pageNext)
    assert em.story == 2, "two page-turns reach the last epilogue page"
    em = update(em, Msg.pageNext)
    assert em.story == 2, "the last epilogue page holds (restart is the exit)"

    # --- mission FSM: The Cubs of Thas — canonical path and valor path ---
    var cm = update(em, Msg.startMission)
    assert cm.phase == 9 and cm.story == 0, "epilogue offers the mission"
    cm = update(cm, Msg.mA)                       # march at dawn
    cm = update(cm, Msg.mA)                       # split the score
    assert hasFlag(cm, "Split"), "splitting sets the Split flag"
    cm = update(cm, Msg.mB)                       # bluff (works when split)
    assert not hasFlag(cm, "Alarm"), "split team bluffs without alarm"
    cm = update(cm, Msg.mB)                       # wait for the sign
    assert hasFlag(cm, "Waited"), "waiting sets Waited"
    cm = update(cm, Msg.mA)                       # break the pen
    assert hasFlag(cm, "CubsFree"), "the cubs are freed"
    cm = update(cm, Msg.mA)                       # to the bridge
    cm = update(cm, Msg.mA)                       # dive
    assert hasFlag(cm, "SavedKeanna") and cm.story == 7, "canonical ending reached"
    cm = update(cm, Msg.mA)                       # sing the song of the day
    assert cm.phase == 10 and cm.story == 0, "the mission ends at the feast"
    cm = update(cm, Msg.mA)
    cm = update(cm, Msg.mA)
    cm = update(cm, Msg.mA)
    assert cm.story == 3, "three pages of boasts reach the verdict"
    cm = update(cm, Msg.mC)                       # crown neither -- the Third Voice
    assert hasFlag(cm, "CrownGiver") and cm.story == 4, "the Third Voice verdict"
    var fm = update(cm, Msg.mB)                   # INTERLUDE: follow the Judge
    assert fm.phase == 14 and fm.story == 0, "the feast offers the Judge's road"
    fm = update(fm, Msg.mA)                       # enter the city
    fm = update(fm, Msg.mA)                       # the soldiers first
    assert hasFlag(fm, "MercyFoe"), "her jailers are tended first"
    fm = update(fm, Msg.mB)                       # take the spared one's hands
    assert hasFlag(fm, "Helper"), "the spared serves"
    fm = update(fm, Msg.mA)                       # free them to tend Thas
    assert hasFlag(fm, "ServeStay"), "the freed stay to rebuild"
    fm = update(fm, Msg.mB)                       # 'ask him yourself'
    assert hasFlag(fm, "WitnessFound"), "the Witness is found"
    fm = update(fm, Msg.mB)                       # begin with the children
    fm = update(fm, Msg.mB)                       # 'why OUR cubs'
    assert fm.story == 7, "the lament takes every verse without scoring"
    fm = update(fm, Msg.mA)                       # the turn toward trust
    assert hasFlag(fm, "LamentTrust") and fm.story == 8, "the qinah turns"
    fm = update(fm, Msg.mA)                       # the road to the ford
    assert fm.phase == 12 and fm.story == 0, "the Appointed Ford opens Episode II"

    cm = update(cm, Msg.mA)                       # the feast burns low
    assert cm.phase == 12 and cm.story == 0, "the feast leads into Episode II"

    # --- Episode II: The Herald's Road -- canonical (Open Door) path ---
    cm = update(cm, Msg.mA)                       # take the road south
    cm = update(cm, Msg.mA)                       # ask the Judge to ride
    assert hasFlag(cm, "Escort"), "Keanna rides along"
    cm = update(cm, Msg.mB)                       # camp cold and watch
    assert hasFlag(cm, "Watched"), "the cold camp counts the zealots"
    cm = update(cm, Msg.mB)                       # the Matisyahu gambit
    assert cm.story == 4 and not hasFlag(cm, "RoadBlood"), "the gambit passes the grove without blood"
    cm = update(cm, Msg.mA)                       # the whole truth
    assert hasFlag(cm, "TruthTold"), "the truth told whole"
    cm = update(cm, Msg.mA)                       # set the cup down
    assert cm.story == 6, "candor and the untouched cup earn the garden"
    cm = update(cm, Msg.mA)                       # the Judge's commission
    assert hasFlag(cm, "PrinceHeart") and cm.story == 7, "the Open Door ending"
    cm = update(cm, Msg.mB)                       # Episode III: the north road
    assert cm.phase == 13 and cm.story == 0, "the Open Door leads to Muze"

    # --- Episode III: The Road of Wings -- the merciful path sees the king ---
    cm = update(cm, Msg.mA)                       # take the north road
    cm = update(cm, Msg.mA)                       # strike his chains
    assert hasFlag(cm, "SpyFriend"), "the wing-oath is given"
    cm = update(cm, Msg.mA)                       # bread and salt for the nanae
    cm = update(cm, Msg.mA)                       # the prophet's word
    assert hasFlag(cm, "Warned"), "Yosef's warning is carried"
    cm = update(cm, Msg.mA)                       # enter openly
    cm = update(cm, Msg.mB)                       # ask for the king's own hall
    assert cm.story == 6, "mercy and warning open the true hall"
    cm = update(cm, Msg.mA)                       # take the feather
    assert hasFlag(cm, "FeatherHeld") and cm.story == 7, "the Feather Carried ending"
    cm = update(cm, Msg.mB)                       # to the scriptorium of Rhea
    assert cm.phase == 15 and cm.story == 0, "the token seeks its reader"

    # --- The Scribe of Rhea: the faithful hand ---
    cm = update(cm, Msg.mA)                       # fetch the notes
    cm = update(cm, Msg.mB)                       # test the gloss first
    assert hasFlag(cm, "CheckedFirst"), "the Vorlage-instinct"
    cm = update(cm, Msg.mB)                       # keep BOTH readings
    assert hasFlag(cm, "VariantsKept"), "kethiv and qere both stand"
    cm = update(cm, Msg.mB)                       # the dotted mark
    assert hasFlag(cm, "GlossHumble"), "the stubborn sign stays open"
    cm = update(cm, Msg.mA)                       # unsay the pen in public
    assert hasFlag(cm, "CorrectedGloss"), "the gloss monopoly is broken"
    cm = update(cm, Msg.mA)                       # the seal, exactly
    cm = update(cm, Msg.mA)                       # send the whole truth
    assert hasFlag(cm, "SentWhole") and cm.story == 7, "the Faithful Hand colophon"

    # --- the smooth text diverges honestly ---
    var noFlags6: List(str) = []
    var sc = GameModel(phase: 15, diff: 1, pHp: 35, e0Hp: 0, e1Hp: 0, selWeapon: 0, round: 1, xp: 0, level: 1, story: 6, states: noFlags6, px: 5, py: 25, rngSeed: 2, log: ["letter"])
    sc = update(sc, Msg.mB)                       # send only the clean reading
    assert not hasFlag(sc, "SentWhole") and sc.story == 7, "the Smooth Text travels light"

    # --- Episode III: without mercy, the veils hold ---
    var noFlags5: List(str) = []
    var e3 = GameModel(phase: 13, diff: 1, pHp: 35, e0Hp: 0, e1Hp: 0, selWeapon: 0, round: 1, xp: 0, level: 1, story: 5, states: noFlags5, px: 5, py: 25, rngSeed: 3, log: ["court"])
    var e3b = update(e3, Msg.mB)                  # B without SpyFriend/Warned
    assert e3b.story == 7 and not hasFlag(e3b, "FeatherHeld"), "the veils hold against the unwarned"

    # --- Episode II: the gambit is gated; unwatched B fights instead ---
    var noFlags4: List(str) = []
    var e2 = GameModel(phase: 12, diff: 1, pHp: 35, e0Hp: 0, e1Hp: 0, selWeapon: 0, round: 1, xp: 0, level: 1, story: 3, states: noFlags4, px: 5, py: 25, rngSeed: 5, log: ["grove"])
    e2 = update(e2, Msg.mB)                       # gambit without Watched
    assert hasFlag(e2, "RoadBlood") and hasFlag(e2, "OnEmbassy"), "without the cold camp, steel decides"
    assert e2.e0Hp == 20 and e2.e1Hp == 20, "fresh zealots"
    var e2w = e2 except phase = 4
    e2w = update(e2w, Msg.embRide)
    assert e2w.phase == 12 and e2w.story == 4 and not hasFlag(e2w, "OnEmbassy"), "victory rides on to the court"

    # --- the valley: tiles, movement, healing, ambush ---
    assert tileAt(5, 25) == "A", "Arna is where MakePoint said"
    assert tileAt(73, 13) == "T", "Thas is where the T is"
    var noFlags3: List(str) = []
    var wm = GameModel(phase: 11, diff: 1, pHp: 20, e0Hp: 20, e1Hp: 20, selWeapon: 0, round: 1, xp: 0, level: 1, story: 0, states: noFlags3, px: 5, py: 25, rngSeed: 9, log: ["at Arna"])
    var held = update(wm, Msg.mvW)
    assert held.px == 5 and held.py == 25, "mountains block the west"
    wm = update(wm, Msg.mvE)
    assert wm.px == 6 and wm.py == 25, "the road east of Arna is open"
    assert wm.pHp == 21, "travel heals +1 on medium"
    wm = update(wm, Msg.mvN)
    wm = update(wm, Msg.mvE)
    assert wm.px == 7 and wm.py == 24, "two more steps reach the first ambush point"
    assert hasFlag(wm, "E7_24") and hasFlag(wm, "OnRoad"), "the ambush triggers once"
    assert wm.phase == 1 or wm.phase == 3, "battle begins by initiative"
    assert wm.e0Hp == 20 and wm.e1Hp == 20, "fresh Ruffians on the road"
    var wmWon = wm except phase = 4
    var back = update(wmWon, Msg.walkOn)
    assert back.phase == 11 and not hasFlag(back, "OnRoad"), "victory walks on"
    back = update(back, Msg.mvW)
    back = update(back, Msg.mvE)
    assert back.phase == 11, "a consumed ambush does not retrigger"

    # --- leveling: faithful thresholds and bonuses ---
    assert expLevelMax(1) == 0 and expLevelMax(2) == 100 and expLevelMax(3) == 200 and expLevelMax(4) == 400, "threshold table"
    var lm = applyExperience(back, 200)
    assert lm.level >= 3, "200 xp reaches level 3 (0,100,200 quirk-faithful)"
    assert levelAgi(lm) == 25 + (lm.level - 1) * 3, "agility scales +3 per level"
    assert levelMaxHp(lm) == 35 + (lm.level - 1) * 3, "max hp scales +3 per level"

    # --- save / load round-trip ---
    var sv = saveGame(lm)
    var ld = loadGame()
    assert ld.phase == 11, "a loaded game resumes on the map"
    assert ld.diff == sv.diff and ld.pHp == sv.pHp and ld.xp == sv.xp and ld.level == sv.level, "stats survive the camp"
    assert ld.px == sv.px and ld.py == sv.py, "position survives the camp"
    assert hasFlag(ld, "E7_24") == hasFlag(sv, "E7_24"), "consumed ambushes survive the camp"
    # valor path: bunched score, bluff raises alarm; strike costs lives
    var vm = update(em, Msg.startMission)
    vm = update(vm, Msg.mA)
    vm = update(vm, Msg.mB)                       # keep the score together
    vm = update(vm, Msg.mB)                       # bluff -> alarm
    assert hasFlag(vm, "Alarm"), "bunched bluff raises the alarm"
    vm = update(vm, Msg.mA)                       # strike now
    assert hasFlag(vm, "Struck"), "striking sets Struck"

    # --- THE VILLAGE OF ARNA: the same four people, two different men ---------
    # Every scenario builds its own flag list.  Copying one list and .add()-ing
    # to the copy would risk sharing a backing buffer and silently contaminating
    # later scenarios -- we would then be pinning behaviour that does not exist.
    assert arnaRegion() == 2, "Arna is Tuon country, and is weighed as such"

    # the man who waited, freed the cubs, carried Keanna out, told the whole truth
    var keptF: List(str) = []
    keptF.add("Waited")
    keptF.add("CubsFree")
    keptF.add("SavedKeanna")
    keptF.add("TruthTold")
    keptF.add("SpyFriend")
    keptF.add("FeatherHeld")
    keptF.add("LamentTrust")
    # the man who struck first, shaded the truth, poured the cup, left blood
    var hardF: List(str) = []
    hardF.add("Struck")
    hardF.add("TruthShaded")
    hardF.add("Bowed")
    hardF.add("RoadBlood")

    var qKept = yehuQualities(arnaMan(keptF))
    var qHard = yehuQualities(arnaMan(hardF))
    assert qKept.honor > qHard.honor, "the truth told at court outranks the truth shaded"
    assert qKept.faith > qHard.faith, "the poured cup costs faith"
    assert qKept.kindness > qHard.kindness, "blood on the road costs kindness"
    assert qHard.prowess >= qKept.prowess, "the shorter way makes a harder soldier"
    assert qHard.faith >= 0 and qHard.honor >= 0, "qualities clamp at zero, never negative"
    # The scoring measures deviation from 3 across a 0..5 domain, so a quality
    # that escapes the range silently over-weights its whole column.  A merciful
    # run used to reach kindness 6 (only prowess was clamped at the top).
    assert qKept.kindness <= 5 and qKept.wis <= 5 and qKept.honor <= 5, "qualities clamp at five"
    assert qKept.faith <= 5 and qKept.humility <= 5 and qKept.prowess <= 5, "every quality, both ends"

    # Nobody authored these receptions; they are computed.  What the harness
    # fences is that the village can TELL THE TWO MEN APART.
    var warmer = 0
    var candorDiffs = 0
    var vi = 1
    while vi < 5
        var ok = arnaOutcome(arnaMan(keptF), vi)
        var oh = arnaOutcome(arnaMan(hardF), vi)
        assert ok.willing >= oh.willing, "keeping faith never buys LESS help than breaking it"
        if ok.willing > oh.willing
            warmer = warmer + 1
        if ok.candor != oh.candor
            candorDiffs = candorDiffs + 1
        vi = vi + 1
    assert candorDiffs >= 3, "the village speaks to the two men differently"

    # The interesting result, and the one worth pinning: the engine discriminates
    # through CANDOR more than through willingness.  An intimidating dishonest man
    # is not refused -- he is answered, and lied to.  Fear buys compliance and
    # costs truth, so his help-count stays middling while his candor collapses.
    var kirKept = arnaOutcome(arnaMan(keptF), 1)
    var kirHard = arnaOutcome(arnaMan(hardF), 1)
    assert kirKept.candor == "confides", "the herdsman opens up to the man who kept faith"
    assert kirHard.candor != "confides", "and does not to the man who did not"
    assert kirHard.willing >= 2, "yet he is not refused -- he is feared, not defied"

    # Standing: the trader is bound by an oath until Yehu disclaims the river trade.
    var gannaBound = arnaOutcome(arnaMan(hardF), 2)
    assert gannaBound.why.contains("river-traders"), "Ganna's oath constrains him by default"
    var guildF: List(str) = []
    guildF.add("Struck")
    guildF.add("TruthShaded")
    guildF.add("Bowed")
    guildF.add("RoadBlood")
    guildF.add("ArnaGuild")
    var gannaFree = arnaOutcome(arnaMan(guildF), 2)
    assert not gannaFree.why.contains("river-traders"), "swearing off the river trade unbinds him"

    # Payment is weighed BELOW service, per the notebook: coin at the gate may
    # soften a villager, but it cannot buy what keeping faith earns.
    var paidF: List(str) = []
    paidF.add("Struck")
    paidF.add("TruthShaded")
    paidF.add("Bowed")
    paidF.add("RoadBlood")
    paidF.add("ArnaPaid")
    var pi = 1
    while pi < 5
        var op = arnaOutcome(arnaMan(paidF), pi)
        var okp = arnaOutcome(arnaMan(keptF), pi)
        assert op.willing <= okp.willing, "a purse never outbuys a record"
        pi = pi + 1

    # An ordinary stranger with no history is received neutrally -- the baseline
    # that keeps the whole table honest.
    var plainF: List(str) = []
    var ni = 1
    while ni < 5
        var onp = arnaOutcome(arnaMan(plainF), ni)
        assert onp.willing >= 1, "a stranger who has done nothing is not turned away"
        ni = ni + 1

    # The gate: coin at the door sets the flag and moves on to the herdsman.
    var gateM = arnaMan(plainF)
    var gatePaid = arnaStep(gateM, true)
    assert hasFlag(gatePaid, "ArnaPaid") and gatePaid.story == 1, "coin at the gate is noticed and priced"
    var gateFree = arnaStep(gateM, false)
    assert not hasFlag(gateFree, "ArnaPaid") and gateFree.story == 1, "walking in costs nothing"

    # The door INTO the village: the scribe's colophon sends Yehu home through Arna.
    var doorM = GameModel(phase: 15, diff: 1, pHp: 35, e0Hp: 0, e1Hp: 0, selWeapon: 0, round: 1, xp: 0, level: 2, story: 7, states: plainF, px: 5, py: 25, rngSeed: 7, log: ["letter"])
    var doorNext = update(doorM, Msg.mA)
    assert doorNext.phase == 16 and doorNext.story == 0, "the road home from Rhea passes through Arna"

    # And the door OUT: past the well, Yehu steps into the valley at Arna's tile.
    var outM = arnaMan(plainF) except story = 4
    var outNext = arnaStep(outM, false)
    assert outNext.phase == 11, "leaving the well puts Yehu on the valley road"


    print("tears_combat_test: OK  (" + hits.toString() + " hits / " + misses.toString() + " misses; easy " + easyHits.toString() + " vs hard " + hardHits.toString() + "; won in " + steps.toString() + " steps, Yehu " + m.pHp.toString() + " HP; story FSM OK)")
