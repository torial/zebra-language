# Headless full playthrough of Tears of the Tuon — Fable at the controls.
# Drives the real update() FSM from title to mission ending, printing every
# page and battle-log line. Deterministic given the hardcoded seed.

use tears_of_the_tuon exposing GameModel, Msg, update, introPage, epiloguePage, missionPage, missionChoiceA, missionChoiceB, disputePage, disputeChoiceA, disputeChoiceC, hasFlag

def showPage(page: str)
    for ln in page.split("|")
        print("  " + ln)

def showNewLog(m: GameModel, since: int): int
    var i = since
    while i < m.log.len
        print("  > " + m.log.at(i))
        i = i + 1
    return m.log.len

def choose(label: str)
    print("")
    print("  [Fable chooses: " + label + "]")
    print("")

def main()
    var noFlags: List(str) = []
    var m = GameModel(phase: 7, diff: 1, pHp: 35, e0Hp: 20, e1Hp: 20, selWeapon: 0, round: 1, xp: 0, level: 1, story: 0, states: noFlags, px: 5, py: 25, rngSeed: 20260730, log: ["Two Ruffians block the mountain road. Yehu draws his blade."])
    print("==== TEARS OF THE TUON — a playthrough by Fable ====")
    print("")
    # intro pages
    while m.phase == 7
        showPage(introPage(m.story))
        if m.story < 3
            choose("Continue")
            m = update(m, Msg.pageNext)
        else
            if m.story == 3
                choose("Get the Cubs")
            else
                choose("Stand your ground")
            m = update(m, Msg.getCubs)
    # difficulty -> the valley
    print("  The mountain road runs from Arna to Thas. Choose your trial.")
    choose("Easy -- five cairns taught Yehu humility; the road is long")
    var logAt = m.log.len
    m = update(m, Msg.selEasy)
    logAt = showNewLog(m, logAt)
    # walk the BFS road; fight each ambush; count the miles
    var road = "ENEENEEEEENEENEENEEENEEESEEESESEESESEEEENEEEENEEEEEEENEEEEEEEEEEEEEEEEENENNENNENNNEEEEEEEE"
    var stepsWalked = 0
    var battles = 0
    var ri = 0
    while ri < road.len
        if m.phase == 8
            break
        var mv = road[ri..ri + 1]
        ri = ri + 1
        if mv == "E"
            m = update(m, Msg.mvE)
        if mv == "W"
            m = update(m, Msg.mvW)
        if mv == "N"
            m = update(m, Msg.mvN)
        if mv == "S"
            m = update(m, Msg.mvS)
        stepsWalked = stepsWalked + 1
        if m.phase == 1 or m.phase == 3
            battles = battles + 1
            logAt = showNewLog(m, logAt)
            print("  -- ambush " + battles.toString() + " at (" + m.px.toString() + "," + m.py.toString() + "), " + stepsWalked.toString() + " miles out; Yehu HP " + m.pHp.toString() + " --")
            var bs = 0
            while m.phase != 4 and m.phase != 5 and bs < 200
                if m.phase == 1
                    m = update(m, Msg.atkSword)
                if m.phase == 2
                    if m.e0Hp > 0
                        m = update(m, Msg.tgt0)
                    else
                        m = update(m, Msg.tgt1)
                if m.phase == 3
                    m = update(m, Msg.enemyTurn)
                logAt = showNewLog(m, logAt)
                bs = bs + 1
            if m.phase == 5
                break
            choose("Walk on")
            m = update(m, Msg.walkOn)
    var steps = stepsWalked
    var attempt = 1
    while m.phase == 5 and attempt < 6
        print("")
        print("  DEFEAT -- Yehu falls on the mountain road.")
        choose("Try again (attempt " + (attempt + 1).toString() + ")")
        var noFlagsR: List(str) = []
        m = GameModel(phase: 11, diff: 0, pHp: 35, e0Hp: 20, e1Hp: 20, selWeapon: 0, round: 1, xp: 0, level: 1, story: 0, states: noFlagsR, px: 5, py: 25, rngSeed: 20260730 + attempt * 7919, log: ["Yehu rises, spits blood, and takes up his blade again."])
        logAt = showNewLog(m, 0)
        var ri2 = 0
        while ri2 < road.len
            if m.phase == 8
                break
            var mv2 = road[ri2..ri2 + 1]
            ri2 = ri2 + 1
            if mv2 == "E"
                m = update(m, Msg.mvE)
            if mv2 == "W"
                m = update(m, Msg.mvW)
            if mv2 == "N"
                m = update(m, Msg.mvN)
            if mv2 == "S"
                m = update(m, Msg.mvS)
            if m.phase == 1 or m.phase == 3
                var bs2 = 0
                while m.phase != 4 and m.phase != 5 and bs2 < 200
                    if m.phase == 1
                        m = update(m, Msg.atkSword)
                    if m.phase == 2
                        if m.e0Hp > 0
                            m = update(m, Msg.tgt0)
                        else
                            m = update(m, Msg.tgt1)
                    if m.phase == 3
                        m = update(m, Msg.enemyTurn)
                    logAt = showNewLog(m, logAt)
                    bs2 = bs2 + 1
                if m.phase == 5
                    break
                m = update(m, Msg.walkOn)
        attempt = attempt + 1
    if m.phase != 8
        print("  (The road kept its toll five times. The tale waits for a better swordsman.)")
        return
    print("")
    print("  Yehu walked " + steps.toString() + " miles and fought " + battles.toString() + " ambushes; he reaches the gates at Level " + m.level.toString() + " with " + m.xp.toString() + " experience.")
    while m.phase == 8
        showPage(epiloguePage(m.story))
        if m.story + 1 < 3
            choose("Continue")
            m = update(m, Msg.pageNext)
        else
            choose("Play the finale -- The Cubs of Thas")
            m = update(m, Msg.startMission)
    # the mission — Fable plays the faithful path
    while m.phase == 9 and m.story < 7
        showPage(missionPage(m))
        var a = missionChoiceA(m)
        var b = missionChoiceB(m)
        # policy: split the score; pass quietly; wait for the sign; dive.
        if m.story == 1 or m.story == 6
            choose(a)
            m = update(m, Msg.mA)
        else
            if b != ""
                if m.story == 3
                    choose(b)
                    m = update(m, Msg.mB)
                else
                    choose(a)
                    m = update(m, Msg.mA)
            else
                choose(a)
                m = update(m, Msg.mA)
    showPage(missionPage(m))
    choose("Sing the song of the day")
    m = update(m, Msg.mA)
    # the feast: hear the whole dispute, then crown neither -- the Third Voice
    while m.phase == 10 and m.story < 3
        showPage(disputePage(m))
        choose(disputeChoiceA(m))
        m = update(m, Msg.mA)
    showPage(disputePage(m))
    choose(disputeChoiceC(m))
    m = update(m, Msg.mC)
    showPage(disputePage(m))
    print("")
    print("==== The playthrough ends. Flags: Split=" + hasFlag(m, "Split").toString() + " Waited=" + hasFlag(m, "Waited").toString() + " CubsFree=" + hasFlag(m, "CubsFree").toString() + " SavedKeanna=" + hasFlag(m, "SavedKeanna").toString() + " ThirdVoice=" + hasFlag(m, "CrownGiver").toString() + " ====")
