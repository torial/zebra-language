# BUG-767's control: a lambda that handles a throwing call's error itself, and one that calls
# a function that cannot fail, build and run.

def risky(n: int): int throws
    if n < 0
        raise "neg"
    return n * 10

def safe(n: int): int
    return n + 1

def main()
    var hs: List(def(int): str) = []
    hs.add(def(n: int): str
        var v = risky(n) catch -1
        return "handled ${v}"
    )
    hs.add(def(n: int): str
        return "safe ${safe(n)}"
    )
    print(hs.at(0)(2))
    print(hs.at(0)(-2))
    print(hs.at(1)(2))
    print("bug767: OK")
