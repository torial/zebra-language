# BUG-280 / BUG-281 regression: a Zig keyword that Zebra does NOT reserve must be usable
# as an identifier in every position, because codegen has to escape it as @"name" on the
# way out. Before the fix, `emitName` existed and did the right thing — but the field
# paths never called it, so a class field named `align` emitted `align: i64 = 0,` and the
# generated Zig would not parse.
#
# The words below are all Zig keywords and none are Zebra keywords, so a user can write
# them today and nothing warns them. `align` is the control that matters: it was never
# reserved by Zebra, so this tests the LIVE bug rather than a word freed alongside it.
#
# THIS FIXTURE IS THE GATE'S COVERAGE — keyword_ident_check.sh can only see positions
# exercised here. That is not a footnote: BUG-281 was filed as three broken families and
# a WIDENED probe found seven, because the first probe only reached three. If you add an
# emit path, add a shape here in the same commit.
#
# STILL DELIBERATELY ABSENT — the BUG-281 families that remain broken:
#   E  a METHOD named for a keyword        (`def volatile()`) — both compilers
#   G  a TOP-LEVEL FN named for a keyword  (bootstrap only; the selfhost prefixes it)
# They live in tools/fixtures/bug281_keyword_gaps_repro.zbr. Move each one here as it is
# fixed. A corpus file neither compiler can build would redden full_sweep, smoke and
# registration_check for debt that is already filed.
#
# FAMILY B (the type NAME itself) MOVED HERE 2026-08-12, and the shapes below are the
# gate's only view of it. B was fixed by PREFIXING rather than escaping — a Zebra type
# emits as `_zbr_ty_<name>`, so a keyword type name can no longer collide at all. That
# also means this gate sees B differently from the other families: it passes not because
# `opaque` is escaped but because the bare word never reaches the output. `_zbr_ty_opaque`
# is not a whole-word match for `opaque`, so the check is still live rather than vacuous —
# revert the prefix and these emit `pub const opaque = struct`, which it flags.
#
# THIS FILE IS SELFHOST-ONLY FROM HERE ON. BUG-281 B was landed in selfhost/CodeGen.zbr
# and not in src/CodeGen.zig (the bootstrap is being retired; paying the tax twice was
# judged not worth it), so `zebra-bootstrap --emit-zig` still emits bare type names for
# the two declarations below and cannot build this file. That is a BOOTSTRAP GAP —
# informational in divergence_check, which gates only on selfhost gaps — and it is why
# the gate runner passes no `--bootstrap` leg here.

class Route
    var align: int = 0
    var volatile: str = ""
    static var opaque: int = 7

    def bump()
        .align = .align + 1

struct Point
    var align: int = 0
    var packed: int = 0

def takes(align: int, noalias: str): str
    return align.toString() + noalias

# BUG-281 family A: @derive bodies emit `self.<field>` for toString / eql / hash.
@derive(Debug, Eq, Hash)
struct Der
    var align: int = 0
    var volatile: int = 0

# BUG-281 family D: enum members and union variants, at DECLARATION and at USE.
enum Mode
    align
    packed

union Shape
    volatile: int
    noalias: str

# BUG-281 family F: a bare field read inside a method takes a different emit path
# from the `.align` form above — it goes through the ident walker, not member access.
class Bare
    var align: int = 3

    def readBare(): int
        return align

# BUG-281 family B: the TYPE NAME itself — a class and a struct named for a Zig keyword.
# Every position the name reaches has to agree: the declaration, the method receiver, the
# synthesised init and its return type, construction, and qualified static access.
class opaque
    var n: int = 1
    static var total: int = 100

    def twice(): int
        return .n * 2

struct volatile
    var v: int = 0

def takesKwTypes(o: opaque, s: volatile): int
    return o.n + s.v

# BUG-281 family E: the METHOD NAME. Unlike the type name (B), a method is namespaced
# inside its type, so it cannot collide at file scope and needs ESCAPING rather than a
# prefix — the same one-line `emitName` routing A/C/D/F took. Both the declaration and
# every call site have to agree; escaped-at-one-end is what made C, D and F broken
# rather than uniformly wrong.
class KwMethods
    var base: int = 10

    def align(): int
        return .base + 1

    static def packed(n: int): int
        return n * 2

    def callsSibling(): int
        return align() + 100

def main()
    # instance field: declaration, constructor init, read, write
    var r = Route()
    r.align = 5
    r.volatile = "v"
    r.bump()
    print("${r.align} ${r.volatile}")

    # static field: qualified declaration and access
    Route.opaque = 9
    print(Route.opaque)

    # struct literal — designator and the synthesised init parameter
    var p = Point(align: 7, packed: 8)
    print("${p.align} ${p.packed}")

    # `except` update — writes the field name into a temp-copy assignment
    var q = p except align = 11
    print(q.align)

    # ordinary parameters and locals (these already worked; kept as the both-directions half)
    var anyframe = 3
    print(takes(anyframe, "n"))

    # A: derived toString reads every field; derived eql compares them
    var d1 = Der(align: 1, volatile: 2)
    var d2 = Der(align: 1, volatile: 2)
    print(d1.toString())
    print(d1 == d2)

    # D: enum member and union variant, constructed and matched
    var m = Mode.packed
    var mlabel = "?"
    branch m
        on Mode.align
            mlabel = "a"
        on Mode.packed
            mlabel = "p"
    print(mlabel)

    var s = Shape.volatile(12)
    var slabel = "?"
    branch s
        on Shape.volatile as sv
            slabel = sv.toString()
        on Shape.noalias as sn
            slabel = sn
    print(slabel)

    # F: bare field read inside a method
    print(Bare().readBare())

    # C: a capture DECLARED escaped must be READ escaped in the body
    var noalias: int = 5
    var addIt = def(v: int): int
        capture
            var noalias: int = noalias
        return v + noalias
    print(addIt(1))

    # B: a keyword-named class and struct — declaration, receiver, init, construction,
    # qualified static access, and the name in parameter position
    var kw = opaque()
    kw.n = 4
    print(kw.twice())
    opaque.total = 101
    print(opaque.total)
    var kws = volatile(v: 6)
    print(kws.v)
    print(takesKwTypes(kw, kws))

    # E: a keyword-named method — instance call, static call, and a bare sibling call
    # from inside another method (which takes a different emit path from `obj.m()`)
    var km = KwMethods()
    print(km.align())
    print(KwMethods.packed(21))
    print(km.callsSibling())

    print("bug280: OK")
