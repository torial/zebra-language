# BUG-615 control: one name in DIFFERENT namespaces is fine -- the same method in two
# classes, a member named like a top-level function, a local named like a method.

def width(): int
    return 100

class Box
    var w: int
    cue init(w: int)
        .w = w
    def width(): int
        return .w

class Pane
    var w: int
    cue init(w: int)
        .w = w
    def width(): int
        return .w * 2

def main()
    var width2 = Box(3).width()
    var b = Pane(4)
    print("bug615: ${width2} ${b.width()} ${width()}")
