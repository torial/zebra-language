# BUG-410: a def declared to return a value whose body can fall off the end used to
# surface as Zig's "function with non-void return type 'i64' implicitly returns",
# anchored on a line in the GENERATED file. Now it names the def and says it in
# Zebra terms.
def sign(x: int): int
    if x > 0
        return 1
    else if x < 0
        return -1
def main()
    print(sign(3))
