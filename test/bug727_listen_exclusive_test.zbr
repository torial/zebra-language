# BUG-727: on Windows a second server listened on a port another server held, and neither said
# so -- Zig 0.17 binds through AFD in its shared mode, so the second listen succeeded, both stayed
# up, and the first answered (Fable: a rebuilt Graze app was answered by its stale predecessor).
# The runtime now binds exclusively there.
#
# The driver (no arguments) starts this executable as a server, as a user would, then starts a
# second copy on the same port:
#   1. for each of Tcp.serve, Http.serve and Ws.serve the second copy is REFUSED -- it prints
#      "cannot listen on 127.0.0.1:<port>: AddressInUse" and EXITS 1 (since 2026-11-15; it used
#      to print and let serve return), so the line after its serve never runs -- and the first
#      still answers. (A HOST-owned process keeps print-and-return: tools/library_mode_check.sh
#      leg 4.)
#   2. a port whose server answered requests and was stopped -- leaving connections in
#      TIME_WAIT on the SERVER's side, since Http.serve closes first -- can be listened on again
#      at once (the property SO_REUSEADDR exists for; an exclusive bind must not cost it).
# Each value is checked here, so the final line prints only when all are right.

def tcpH(conn: TcpConn)
    conn.write("tcp-up")
    conn.close()

def httpH(req: HttpRequest): HttpResponse
    return HttpResponse.ok("http-up")

def wsH(ws: WsConn)
    ws.close()

var failures: int = 0

def check(what: str, ok: bool, detail: str)
    if ok
        print("${what}: ok")
    else
        print("  WRONG: ${what}: ${detail}")
        failures += 1

# True when something accepts a TCP connection on the port.
def listening(port: int): bool
    if Tcp.connect("127.0.0.1", port) as c
        c.close()
        return true
    return false

def httpGet(port: int): str
    if Http.get("http://127.0.0.1:${port}/") as r
        return r.text
    return "<none>"

# Waits up to 10 s of wall clock (a Windows connect to a closed port retries ~2 s, so a count of
# tries would take minutes).
def waitUp(port: int): bool
    var t = Timer.start()
    while t.elapsed() < 10000.0
        if listening(port)
            return true
        sys.sleep(100)
    return false

def waitExit(p: SysProcess): int
    var t = Timer.start()
    while t.elapsed() < 15000.0 and p.isRunning()
        sys.sleep(100)
    return p.exitCode()

def start(mode: str): SysProcess
    var argv: List(str) = [sys.selfExe(), mode]
    return sys.spawnPiped(argv)

# The first server holds `port`; a second copy of the same mode must be refused and say so.
def secondRefused(name: str, mode: str, port: int)
    var first = start(mode)
    check("${name}-up", waitUp(port), "the first ${name} server never listened")
    var second = start(mode)
    var code = waitExit(second)
    var out = second.readAvailable()
    var err = second.readErrAvailable()
    check("${name}-second-exit1", code == 1, "the second ${name} server did not exit 1 (exit ${code}); stderr: ${err}")
    check("${name}-second-said", err.contains("cannot listen on 127.0.0.1:${port}: AddressInUse"), "the second ${name} server did not say the port is taken; stderr: ${err}")
    check("${name}-second-stopped", not out.contains("serve returned"), "the second ${name} server's program went on after serve; stdout: ${out}")
    check("${name}-first-alive", first.isRunning() and listening(port), "the first ${name} server stopped answering")
    if name == "http"
        var got = httpGet(port)
        check("http-first-answers", got == "http-up", "the held port answered '${got}'")
    first.kill()
    if second.isRunning()
        second.kill()

def drive()
    for port in [19981, 19982, 19983]
        if listening(port)
            print("bug727_listen_exclusive: REFUSED -- something already listens on port ${port}; stop it first")
            return
    # 1. a second server on a held port is refused, for each serve function
    secondRefused("tcp", "--tcp", 19981)
    secondRefused("http", "--http", 19982)
    secondRefused("ws", "--ws", 19983)

    # 2. stop a server that answered requests (server-side TIME_WAIT) and listen again at once
    var a = start("--http")
    check("reuse-up", waitUp(19982), "the HTTP server never listened")
    var i: int = 0
    var answered: int = 0
    while i < 5
        if httpGet(19982) == "http-up"
            answered += 1
        i += 1
    check("reuse-answered", answered == 5, "${answered} of 5 requests answered")
    a.kill()
    var t = Timer.start()
    while t.elapsed() < 5000.0 and listening(19982)
        sys.sleep(50)
    var b = start("--http")
    check("reuse-relisten", waitUp(19982) and httpGet(19982) == "http-up", "a server started right after the last one stopped did not listen; stderr: ${b.readErrAvailable()}")
    b.kill()

    if failures == 0
        print("bug727_listen_exclusive: OK")
    else
        print("bug727_listen_exclusive: ${failures} WRONG")

def main()
    var args = sys.args()
    var mode: str = ""
    if args.len >= 2
        mode = args.at(1)
    if mode == "--tcp"
        Tcp.serve(19981, tcpH)
        print("serve returned")
        return
    if mode == "--http"
        Http.serve(19982, httpH)
        print("serve returned")
        return
    if mode == "--ws"
        Ws.serve(19983, wsH)
        print("serve returned")
        return
    drive()
