# JSON edges (BUG-756, BUG-751; Fable's probe, 2026-11-16): what parses, what a number is,
# what stringify writes -- 84 lines, every one an assertion. Run by smoke_golden against
# json_edges_test.expected, the output of the 45b6a0a runtime (std.json's own tree, before
# BUG-751's node parser). The V route runs the same program (v_check.sh's json row).
def show(what: str, text: str)
    if Json.parse(text) as j
        var kind = "other"
        if j.tryInt() as i
            kind = "int ${i}"
        else if j.tryFloat() as f
            kind = "float ${f}"
        else if j.tryStr() as s
            kind = "str ${s.len}"
        else if j.isNull()
            kind = "null"
        print("${what}: ${j.stringify()} [${kind}]")
    else
        print("${what}: nil")

def main()
    show("int", "1")
    show("neg", "-7")
    show("zero", "0")
    show("neg-zero", "-0")
    show("float", "2.5")
    show("whole-float", "1.0")
