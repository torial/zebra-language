        print("FAIL not64 vector 1")
    checks = checks + 1
    if (a1 << s1) <> 21743271936
        fails = fails + 1
        print("FAIL shl64 vector 1")
    checks = checks + 1
    if (a1 >> s1) <> 0
        fails = fails + 1
        print("FAIL shr vector 1")

