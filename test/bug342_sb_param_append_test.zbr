# BUG-342: a StringBuilder parameter can be appended to (like List params).
def fill(sink: StringBuilder, n: int)
    var i: int = 0
    while i < n
        sink.append("ab")
        i = i + 1

class Writer
    var out: StringBuilder
    cue init()
        .out = StringBuilder()
    def emit(sink: StringBuilder)
        sink.append("<")
        sink.append(.out.build())
        sink.append(">")

def main()
    var sb = StringBuilder()
    fill(sb, 2)
    var w = Writer()
    w.out.append("q")
    w.emit(sb)
    assert sb.build() == "abab<q>"
    print("bug342: ok")
