# BUG-569 step 4: a captured STRUCT changed in place (a field write) after the closure
# exists. A struct is a value, so the variable itself is shared (a cell), not a copy of it.

struct P
    var x: int

def main()
    var p = P(x: sys.args().len)
    var f = def(): int = p.x
    p.x = 5
    print("bug569_struct_field: ${f()}")
