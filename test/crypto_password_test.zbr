# Crypto.randomToken / hashPassword / verifyPassword / equal (2026-11-12, for Graze).
#
# What it pins:
#   - randomToken comes from the OS CSPRNG, NOT the seedable PRNG: after the same
#     `Random.seed`, two tokens differ (Random.bytes would repeat). Length 2n, hex only.
#   - hashPassword is argon2id with OWASP's parameters, and its salt is random: two hashes of
#     one password differ, and each verifies.
#   - verifyPassword interoperates: the PHC string below was made by OpenSSL 3.5
#     (`openssl kdf ... ARGON2ID`, pass "password", salt "somesaltsomesalt", m=19456 t=2 p=1),
#     an implementation independent of Zig's. A wrong password, a malformed string and a
#     string asking for absurd memory are all false -- the last without running the KDF.
#   - equal: equal strings, a one-byte difference, different lengths, two empty strings.
# Hashes are counted: each is ~0.3 s in a Debug build.
def isHex(s: str): bool
    for c in s.chars()
        if not ("0123456789abcdef".contains(c.toString()))
            return false
    return true

def main()
    Random.seed(1)
    var t1 = Crypto.randomToken(16)
    Random.seed(1)
    var t2 = Crypto.randomToken(16)
    assert t1 != t2, "randomToken must not follow Random.seed"
    assert t1.len == 32
    assert isHex(t1)
    Random.seed(1)
    var b1 = Random.bytes(16)
    Random.seed(1)
    assert Random.bytes(16) == b1, "control: Random.bytes DOES follow the seed"
    print("randomToken: OK")

    var h1 = Crypto.hashPassword("hunter2")
    var h2 = Crypto.hashPassword("hunter2")
    assert h1.startsWith("$argon2id$v=19$m=19456,t=2,p=1$"), h1
    assert h1 != h2, "the salt is random"
    assert Crypto.verifyPassword("hunter2", h1)
    assert Crypto.verifyPassword("hunter2", h2)
    assert not Crypto.verifyPassword("hunter3", h1)
    print("hashPassword: OK")

    var openssl = "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$K13EBUiG7JV+9ZxztmHFTdb7J0WQsnj2V8bZaqyPptE"
    assert Crypto.verifyPassword("password", openssl), "verifies a hash OpenSSL made"
    assert not Crypto.verifyPassword("Password", openssl)
    assert not Crypto.verifyPassword("password", "not a hash")
    assert not Crypto.verifyPassword("password", "")
    # 2 GiB (m is in KiB): over the 1 GiB ceiling, and small enough that a missing ceiling is
    # SEEN -- the KDF would allocate it and run for tens of seconds. A far larger m would
    # simply fail to allocate and read false either way, which proves nothing.
    var greedy = "$argon2id$v=19$m=2097152,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$K13EBUiG7JV+9ZxztmHFTdb7J0WQsnj2V8bZaqyPptE"
    var tg = Timer.start()
    assert not Crypto.verifyPassword("password", greedy)
    assert tg.elapsed() < 1000.0, "refused before the KDF runs, not after it"
    print("verifyPassword: OK")

    assert Crypto.equal("abc", "abc")
    assert not Crypto.equal("abc", "abd")
    assert not Crypto.equal("abc", "abcd")
    assert Crypto.equal("", "")
    print("equal: OK")
    print("crypto_password: OK")
