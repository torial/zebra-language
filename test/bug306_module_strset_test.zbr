# BUG-306: a module-scope receiver of .add is typed by inference, not by
# declaration-reading oracles. `StrSet` is special-cased by the checker (an
# annotated one types as Type_.str_set), so a user class of that name pins it.
class StrSet
    var _items: List(str)
    var len: int
    cue init()
        _items = List(str)()
        len = 0
    def add(s: str)
        _items.add(s)
        len = _items.len

var s1 = StrSet()
var s2: StrSet = StrSet()
var s3: StrSet? = StrSet()
var a1: Atomic(int) = Atomic(int)(0)
var a2 = Atomic(int)(10)
var xs = List(int)()
var shadow = StrSet()

def useShadow(): int
    var shadow = List(int)()
    shadow.add(4)
    shadow.add(5)
    return shadow.len

def main()
    s1.add("a")
    s1.add("b")
    s2.add("b")
    s3!.add("c")
    a1.add(5)
    a1.add(2)
    a2.add(1)
    xs.add(9)
    print("bug306: ${s1.len} ${s2.len} ${s3!.len} ${a1.load()} ${a2.load()} ${xs.len} ${useShadow()} ${shadow.len}")
