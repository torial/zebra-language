# §28f: List.sort takes an OPTIONAL comparator.
#   sort()          — natural ascending order (numeric / lexicographic)
#   sort(def(a,b)=…)— custom comparator (same as sortBy)
# Prints "list_sort: OK" iff both orderings are correct (checked by smoke_run).

def main()
    var nums: List(int) = List()
    nums.add(3)
    nums.add(1)
    nums.add(4)
    nums.add(1)
    nums.add(5)
    nums.sort()                          # → [1,1,3,4,5]
    var lo = nums.at(0)                   # 1
    var hi = nums.at(4)                   # 5

    var desc: List(int) = List()
    desc.add(2)
    desc.add(8)
    desc.add(5)
    desc.sort(def(a, b) = a > b)          # descending → [8,5,2]
    var top = desc.at(0)                  # 8
    var bot = desc.at(2)                  # 2

    if lo == 1 and hi == 5 and top == 8 and bot == 2
        print("list_sort: OK")
    else
        print("list_sort: FAIL lo=${lo} hi=${hi} top=${top} bot=${bot}")
