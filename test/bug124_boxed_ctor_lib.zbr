# Library half of the BUG-124 pin. See test/bug124_boxed_nilable_ctor_test.zbr for why
# this is a cross-module pair rather than one file.

union Val
    int_val: int
    str_val: str

struct Container
    var opt_val: ^Val?
    cue init(opt_val: ^Val?)
        .opt_val = opt_val

# THE BOXING SITE. `v` is a value-typed union and the parameter is `^Val?`, so the
# constructor argument is heap-boxed here -- genBoxedArgExpr's path, which must create
# the PAYLOAD type (`*Val` behind a `?`) and not the nilable type (`*?Val`).
def makeContainer(n: int): Container
    var v = Val.int_val(n)
    return Container(v)
