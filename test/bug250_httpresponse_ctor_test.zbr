# BUG-250 regression fixture — `HttpResponse(status, text)`, the natural constructor form.
#
# It used to emit `HttpResponse(200, "x")` verbatim, which Zig reads as a CALL ON A TYPE:
#   error: type 'type' not a function
# The fix routes a bare `HttpResponse(...)` call to the SAME emit as the documented
# `HttpResponse.new(status, text)` factory, in both compilers.
#
# THE FIXTURE PRINTS AN INTERPOLATION, and that is not decoration. Fixing codegen alone
# left the BOOTSTRAP with a second, quieter defect: its TypeChecker did not type the bare
# constructor call, so `${a.text}` went through the `{any}` fallback and printed the byte
# ARRAY -- `{ 109, 97, 100, 101 }` instead of `made`. That is valid Zig producing the
# wrong output (BUG-226's class), and an `assert a.text == "made"` does NOT catch it: the
# comparison is on the string, and only the FORMATTING is wrong. The expected-output grep
# is what sees it.
#
# REGISTERED FOR BOTH COMPILERS (`smoke_run` and `smoke_run_bootstrap`), because two
# distinct fixes are being pinned: the codegen route (both) and the bootstrap's TC typing.
#
# WHY THE OLD COVERAGE MISSED IT: test/http_serve_test.zbr has used the broken form since
# it was written, and passes -- its `handleRequest` is never called, and Zig analyses
# functions lazily, so the constructor was never compiled. The same lazy-analysis trap
# recorded for BUG-269's probe. A fixture has to USE the value.

def viaReturn(): HttpResponse
    return HttpResponse(201, "returned")

def main()
    # bare var-init, no type context -- the shape that failed
    var a = HttpResponse(200, "made")
    assert a.status == 200
    assert a.text == "made"

    # annotated var-init
    var b: HttpResponse = HttpResponse(404, "annotated")
    assert b.status == 404
    assert b.text == "annotated"

    # return position, against a declared return type
    var c = viaReturn()
    assert c.status == 201
    assert c.text == "returned"

    # the factory spelling must keep working -- the fix routes to it, so if it breaks
    # the constructor breaks with it
    var d = HttpResponse.new(202, "factory")
    assert d.status == 202
    assert d.text == "factory"
    var e = HttpResponse.ok("okbody")
    assert e.status == 200

    # INTERPOLATED: catches the {any} formatting regression that the asserts cannot
    print("bug250: OK ${a.status} ${a.text} ${c.text} ${d.text}")
