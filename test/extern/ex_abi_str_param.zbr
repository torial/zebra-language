# @extern accepts
# ABI HAZARD, same class. Zebra `str` is a slice ([]const u8: pointer + length),
# NOT a NUL-terminated C string. Passing one to a C function expecting `char*`
# is wrong in a way that links.
#
# Recorded so that whoever adds a `cstr` type (decision B) has a probe already
# pointed at the problem it solves.
extern def zebra_probe_name(s: str): int32

def main()
    print("declared")
