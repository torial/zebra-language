# `^Struct` must emit `*Struct` (not `**Struct`) — struct discriminator for
# BUG-041. Rule: concept_zebra-class-auto-box-rule — the class short-circuit in
# genType's .ref_to arm MUST NOT fire for struct payloads; structs are
# value types and need the extra pointer.
#
# Passes on BOTH compilers as of BUG-170 fix (2026-07-09): the selfhost `genAssign`
# now heap-boxes a value struct assigned into a `^T` field (`{ const _rp =
# _allocator.create(Point) …; _rp.* = pt; self.p = _rp; }`), matching the bootstrap.
# Companion coverage for `^Class` recursion lives in `recursive_type_test.zbr`
# (plain `Class?`, since `^Class` is rejected as of BUG-078).
struct Point
    var x: int
    var y: int

class Holder
    var p: ^Point
    cue init(pt: Point)
        p = pt

class Main
    static def main()
        var pt = Point(x: 3, y: 4)
        var h = Holder(pt)
        assert h.p.x == 3
        assert h.p.y == 4
        print("ref_struct_test OK")
