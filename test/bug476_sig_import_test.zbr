# BUG-476: a `sig` imported with `exposing`, and named qualified, is a type here.
use bug476_sig_import_lib exposing Cb, Holder

def triple(n: int): int
    return n * 3

class User
    var cbs: List(Cb)
    var q: List(bug476_sig_import_lib.Cb)
    cue init()
        .cbs = List(Cb)()
        .q = List(bug476_sig_import_lib.Cb)()

def main()
    var u = User()
    u.cbs.add(triple)
    u.q.add(triple)
    var h = Holder()
    h.add(triple)
    var f: Cb = u.cbs.at(0)
    assert f(2) == 6
    assert u.q.at(0)(3) == 9
    assert h.cbs.at(0)(1) == 3
    print("bug476: OK")
