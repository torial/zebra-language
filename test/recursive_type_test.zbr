# Test recursive/self-referential class structures.  A class is already a
# reference (`*T`), so an optional self-link is just `Node?` — no `^` needed
# (the `^` heap-indirection form is for structs/unions; see ref_struct_test).
# A singly-linked list node where `next` points to another Node.

class Node
    var value: int
    var next : Node?

    cue init(v: int)
        value = v
        next = nil

# PairHolder holds a non-optional reference to a Pair declared in a different
# class — tests cross-class field assignment (`obj.field = x`).
class Pair
    var a: int
    var b: int
    cue init(pa: int, pb: int)
        a = pa
        b = pb

class PairHolder
    var p: Pair
    cue init(pair: Pair)
        p = pair

class Tree
    var value: int
    var left : Tree?
    var right: Tree?

    cue init(v: int)
        value = v
        left  = nil
        right = nil

def main()
    # Classes are reference types, so a.next = b links to the shared b.
    var c = Node(3)     # leaf

    var b = Node(2)
    b.next = c          # link b → c

    var a = Node(1)
    a.next = b          # link a → b

    assert a.value == 1

    # Traverse the chain
    var n = a.next
    assert n != nil
    assert n?.value == 2

    var n2 = n?.next
    assert n2 != nil
    assert n2?.value == 3

    # Nested optional assignment: set children on a tree node.
    var leaf_l = Tree(10)
    var leaf_r = Tree(20)
    var root   = Tree(5)
    root.left  = leaf_l
    root.right = leaf_r

    assert root.value == 5
    var rl = root.left
    assert rl != nil
    assert rl?.value == 10
    var rr = root.right
    assert rr != nil
    assert rr?.value == 20

    # Cross-class field: `holder.p = pair` where p: Pair is declared in
    # PairHolder, not in Main.  Tests cross-class field assignment.
    var pair  = Pair(7, 13)
    var holder = PairHolder(pair)
    assert holder.p.a == 7
    assert holder.p.b == 13

    print("recursive_type_test OK")
