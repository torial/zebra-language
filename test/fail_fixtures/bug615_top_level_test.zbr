# BUG-615: two declarations of one name in one namespace -- Zig has no overloading -- passed
# `zebra -c` and failed inside zig, "duplicate struct member name". Found by Fable: an edit
# script added a method the class already had 350 lines down.

def f(): int
    return 1

def f(): int
    return 2

def main()
    print(f())
