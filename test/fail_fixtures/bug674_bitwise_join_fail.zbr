# BUG-674: `b & n` (byte, int) is an int and does not narrow back into a byte on its own;
# a 64-bit unsigned beside a signed int is refused as it is for `+`.
def f(b: byte, n: int, u: uint): byte
    var c: byte = b & n
    var d: byte = b | n
    print(u ^ n)
    var s: byte = b & (1 << 3)
    print(c)
    print(s)
    return d
def main()
    print(f(5, 6, 7))
