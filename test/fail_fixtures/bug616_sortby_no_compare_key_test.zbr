# BUG-616: a class key with no `cue compare` has no order, so it cannot be a `.sortBy` key.
# It reached zig as "operator < not allowed for type '*P'".

class P
    var v: int
    cue init(v: int)
        .v = v

class Card
    var p: P
    var rank: int
    cue init(p: P, rank: int)
        .p = p
        .rank = rank

def main()
    var cs = [Card(P(2), 2), Card(P(1), 3)]
    cs.sortBy(def(c: Card): P = c.p)
    print(cs.at(0).rank)
