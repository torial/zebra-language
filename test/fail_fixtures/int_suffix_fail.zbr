# Literal suffixes (2026-11-05): each line is refused at the literal, by name.
def main()
    var a = 300_u8
    var b = 128_i8
    var c = -5_u8
    var d = 5_i7
    var e = 5_uint8
    var f = 1.5_f16
    var g = -1_u
    var h = 0xFF_7
    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f)
    print(g)
    print(h)
