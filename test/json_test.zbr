def main()
    # --- Parse and read ---
    var json = '{"name": "Alice", "age": 30, "score": 9.5, "active": true}'
    var data = Json.parse(json)
    assert data != nil, "parse returned nil"

    var d = data!
    var name: str = d["name"]?
    var age: int = d["age"]?
    var score: float = d["score"]?
    var active: bool = d["active"]?
    assert name == "Alice", "required str"
    assert age == 30, "required int"
    assert score > 9.4, "required float"
    assert active == true, "required bool"

    # --- A missing key is nil, never a zero value (BUG-331) ---
    assert d.tryStr("missing") == nil, "missing str key"
    assert d.tryInt("missing") == nil, "missing int key"
    assert d.tryBool("missing") == nil, "missing bool key"
    assert not d.has("missing"), "has on a missing key"
    assert (d.tryStr("missing") orelse "dflt") == "dflt", "optional read with a default"

    # --- Nested object ---
    var nested = '{"user": {"id": 42, "tag": "admin"}}'
    var nd = Json.parse(nested)!
    var user = nd["user"]?
    var uid: int = user["id"]?
    var utag: str = nd["user"]["tag"]?
    assert uid == 42, "nested int"
    assert utag == "admin", "nested str through one chain"

    # --- Array iteration ---
    var arr_json = '{"tags": ["alpha", "beta", "gamma"]}'
    var ad = Json.parse(arr_json)!
    var tags: List(JsonValue) = ad["tags"]?
    var count: int = 0
    for tag in tags
        if tag.isNull()
            count = count + 0
        else
            count = count + 1
    assert count == 3, "array element count"

    # --- Type predicates ---
    var obj = Json.object()
    assert obj.isObject() == true, "isObject"
    assert obj.isArray()  == false, "isArray on object"
    assert obj.isNull()   == false, "isNull on object"

    var arr = Json.array()
    assert arr.isArray()  == true, "isArray"

    # --- Object builder ---
    var builder = Json.object()
    builder.put("city", "Springfield")
    builder.putInt("pop", 50000)
    builder.putFloat("lat", 37.5)
    builder.putBool("capital", false)

    var out = Json.stringify(builder)
    assert out.contains("Springfield"), "stringify contains city"
    assert out.contains("50000"), "stringify contains pop"

    # --- Array builder ---
    var list = Json.array()
    list.append("one")
    list.appendInt(2)
    list.appendFloat(3.0)
    list.appendBool(true)

    var list_out = Json.stringify(list)
    assert list_out.contains("one"), "array stringify contains one"

    # --- Round-trip ---
    var rt_json = '{"x": 1, "y": 2}'
    var rt = Json.parse(rt_json)!
    var rt_str = Json.stringify(rt)
    assert rt_str.contains("\"x\""), "roundtrip contains x key"

    print("json_test: all assertions passed")
