# `guard`, `arena`, `readonly`, `abstract` and `vari` are ORDINARY IDENTIFIERS (freed
# 2026-09-15, Sean: "I'm not sure guard really has a lot of value ... it feels like it
# doesn't belong"). guard was `if not cond` with a second spelling and an `else,` comma
# form; arena's block construct was removed long before the word was; readonly was parsed
# into a flag nothing read; abstract and vari were reserved for features never built.
# Same shape as test/defer_freed_words_test.zbr: each word in the positions a user
# reaches for -- field, parameter, local, method, top-level def.
class Cell
    var guard: int
    var readonly: bool
    var abstract: str
    cue init(guard: int, readonly: bool, abstract: str)
        .guard = guard
        .readonly = readonly
        .abstract = abstract
    def vari(): int
        return .guard + 1

def arena(vari: int): int
    return vari * 2

def main()
    var guard = 4
    var readonly = true
    var abstract = "abs"
    var c = Cell(guard, readonly, abstract)
    var vari = arena(c.vari())
    print("${c.guard} ${c.readonly} ${c.abstract} ${vari} ${arena(guard)}")
    print("guard: freed")
