class Program
    static
        def main
            var nums: List(int) = List()
            nums.add(10)
            nums.add(20)
            nums.add(30)
            # `nums.items` was Zig leaking through (the ArrayList field); refused since
            # BUG-389. The Zebra form iterates the list itself.
            for x in nums
                print(x)
