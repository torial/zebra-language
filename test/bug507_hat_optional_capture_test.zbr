# BUG-507: `if h.s as v` on a `^T?` field binds the VALUE (a `^T` is transparent wherever
# it is bound); it bound the pointer, and passing `v` where a `T` is wanted failed in zig.
union Shape
    circle: float
    square: float

struct Holder
    var s: ^Shape?

struct Pt
    var x: int

struct PtBox
    var p: ^Pt?

def area(sh: Shape): float
    branch sh
        on Shape.circle as r
            return 3.0 * r * r
        on Shape.square as w
            return w * w

def main()
    var h = Holder(Shape.square(2.0))
    var got_area = 0.0
    if h.s as got
        got_area = area(got)
    assert got_area == 4.0
    var empty = Holder(nil)
    if empty.s as never
        got_area = area(never)
    assert got_area == 4.0
    # A binding the body MUTATES keeps the pointer: the write reaches the boxed value
    # (the first fix bound a copy and lost it silently -- the BUG-501 shape).
    var pb = PtBox(Pt(1))
    if pb.p as got_p
        got_p.x = 9
    if pb.p as again
        assert again.x == 9
    print("bug507: OK")
