# @boundary rejects is a copy of the inner list fetched with .at()
#
# BUG-314, resolved 2026-09-10 the STRICTLY-SAFE way: `.at()` on a List(List(T)) still
# hands back a COPY (the language's containers stay value-typed; the reference-semantics
# option -- boxing inner containers so `.at()` aliases the parent's slot -- is filed for
# Sean under BUG-314's closing note), but mutating that copy is now REFUSED at -c with the
# two idioms that do work, instead of being silently lost. This probe was the
# @boundary-pending pin of the silent loss; it FAILED the day the refusal landed, which
# was its purpose, and now asserts the refusal.

def main()
    var parent: List(List(float)) = List(List(float))()
    parent.add(List(float)())

    var r = parent.at(0)
    r.add(1.0)
    print(parent.at(0).len)
