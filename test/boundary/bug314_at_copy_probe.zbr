# @boundary runs
#
# BUG-314, both halves. 2026-09-10: `.at()` on a List(List(T)) handed back a COPY and a
# mutation through it was REFUSED at -c (this probe asserted the refusal). 2026-09-12,
# Sean's decision: inner containers get REFERENCE semantics. 2026-09-24, built: the inner
# container is heap-boxed, `.at()` hands back the parent's own box, and the mutation is
# seen by the parent -- the Python / C# / Go answer. The expectation below was written
# from that decision, not from the compiler.

def main()
    var parent: List(List(float)) = List(List(float))()
    parent.add(List(float)())

    var r = parent.at(0)
    r.add(1.0)
    print(parent.at(0).len)
