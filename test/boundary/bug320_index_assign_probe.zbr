# @boundary runs
#
# BUG-320 REGRESSION TEST. `xs[i] = v` worked until 2026-08-28, when BUG-313's
# bounds-checking change rewrote the index emitter from `.items[@intCast(i)]` -- a valid Zig
# lvalue -- to `_zbr_at(...)`, a function call. Reads kept working, so nothing looked wrong;
# `examples/lsystem.zbr` (`cell[y * w + x] = glyph`) silently stopped compiling for ~24
# hours.
#
# WHY IT ESCAPED: examples_sweep would have caught it, but it is a FULL-tier gate and only
# static/fast/quick were run after landing BUG-313. This file exists so the next occurrence
# is caught by a cheap tier instead of by a person.
#
# The fix emits `_zbr_set(recv, idx, value)` -- which KEEPS the bounds check BUG-313 added,
# so this probe also guards against "fixing" the assignment by reverting to a raw lvalue.
#
# NOT covered here: the COMPOUND forms (`xs[i] += v` and eleven others). They were fixed
# 2026-09-05 and are covered by bug320b_compound_index_assign_probe.zbr, which was a
# refusal-pin until then and is now a positive test.

def main()
    var xs: List(int) = List(int)()
    xs.add(1)
    xs.add(2)

    xs[0] = 77
    print(xs[0])          # 77 — the write lands
    print(xs[1])          # 2  — the neighbour is untouched
    print(xs.len)         # 2  — assignment does not grow the list

    # A non-int element type, because the emitted helper is generic over the element.
    var ys: List(str) = List(str)()
    ys.add("a")
    ys[0] = "z"
    print(ys[0])          # z
