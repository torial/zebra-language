# @boundary rejects too many arguments to 'one': expected at most 1, found 2
#
# BUG-142 REGRESSION GUARD, the cheap half. Same round trip as its too-few sibling:
# authored as a rejection, corrected to `warns`, pending, now back to the assertion.
#
# The two directions were never one decision, and the measurement proved it. The reason
# too-few stayed a warning is that Luau lets you omit trailing arguments (they become
# nil), so the translator emitted them pervasively — 19 files. NOTHING in Luau needs
# EXTRA arguments, and the regenerated 1,581-file corpus contained exactly ONE too-many
# site. Splitting the promotion by direction turned a 19-file decision into a 1-file one
# for half the value.
def one(a: int): int
    return a

def main()
    var r = one(1, 2)
    print(r)
