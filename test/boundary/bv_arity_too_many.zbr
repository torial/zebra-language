# @boundary rejects too many arguments
#
# BOUNDARY: MORE arguments than the function declares. A separate file because a
# rejection ends the compile, and a rejection sharing a file with other rows would
# silently take their coverage with it.
#
# INTENT: passing an argument a function has nowhere to put is a mistake the front
# end can see with certainty, so it should be a diagnostic against this line — not
# a silently discarded argument. The BUG-215 class is exactly what silent discard
# costs: `str.indexOf(sub, from)` dropped its second argument and turned a typo
# into a runtime panic three frames away.
def one(a: int): int
    return a

def main()
    print("${one(1, 2)}")
