# @boundary runs
#
# INTENT: reading a `^T` field off a for-loop variable yields a `T`, so this prints
# `bug294-loop=7`. `^T` is heap-indirection; the deref is the compiler's job.
#
# THIS PROBE WAS `@boundary-pending BUG-294` AND IT FIRED ON ITS OWN when the bug was
# fixed (2026-08-18) -- "expected the compiler to REJECT this, but it built and ran."
# That failure is the whole point of a pending probe, and it is now rewritten to assert
# the intent rather than the defect, exactly as the convention prescribes. Fourth
# pending tripwire to fire on a real fix.
#
# WHAT IT WAS PINNING: the selfhost emitted `sumOf(o.p)` where the bootstrap emitted
# `sumOf(o.p.*)`, so the generated Zig got a `*Point` where a `Point` was required. The
# cause was not the loop: the deref decision was driven by name-keyed side tables whose
# non-optional half was never seeded for a loop variable -- only a hardcoded special
# case for `DictEntry.key`/`.value` existed. Fixed by DERIVING the loop variable's `^T`
# fields from the element struct type, beside the `^T?` derivation that was already
# there.
#
# WHY THIS SHAPE AND NOT `o.p.x`: Zig auto-derefs field access through a single-item
# pointer, so `o.p.x` compiles with or without the bug and cannot discriminate. The
# `^T` value has to land where a `T` is required.
#
# Controls: test/bug294_hat_deref_controls_test.zbr -- parameter, plain local, copied
# loop variable and whole-struct pass, all of which ALREADY worked, so this probe is
# the one that moved.
struct Point
    var x: int
    var y: int

struct Node
    var p: ^Point
    cue init(pt: Point)
        p = pt

def sumOf(pt: Point): int
    return pt.x + pt.y

def main()
    var xs: List(Node) = List()
    xs.add(Node(Point(x: 3, y: 4)))
    for o in xs
        print("bug294-loop=${sumOf(o.p)}")
