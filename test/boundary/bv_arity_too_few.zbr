# @boundary rejects too few arguments
#
# BOUNDARY: FEWER arguments than the function declares, with no default to cover
# the gap.
#
# INTENT AS WRITTEN, AND THE KNOWN DISAGREEMENT: this asserts a hard rejection.
# BUG-142 recorded that today's compiler emits a non-fatal WARNING ("too few
# arguments to 'add'") and compiles anyway — test/arg_count_test.zbr pins that
# behaviour. So this probe is expected to disagree with the compiler on its first
# run, and that disagreement is a QUESTION for Sean recorded in
# docs/boundary_triage.md, not a bug filed by fiat: a warning was a deliberate
# choice at the time, and a boundary suite does not get to overturn one by
# asserting its own opinion. Whichever way it is decided, this file is where the
# decision gets pinned.
def add(a: int, b: int): int
    return a + b

def main()
    print("${add(1)}")
