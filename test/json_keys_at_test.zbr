# keys() / get() — the two accessors that let code COPY a JSON object whose shape it
# does not know: the typed reads (`j["k"]?`, tryStr...) need to name the type, and a
# relay cannot. (This file was written for keys()/at(); `at` was replaced by `get`,
# which is nil for a missing key instead of JSON null -- BUG-331.)
#
# Added 2026-09-04 for the `zebra debug` DAP relay, which must forward fields it does
# not understand without altering them.

def main()
    var src: str = "{\"seq\":7,\"type\":\"request\",\"args\":{\"line\":42},\"extra\":[1,2],\"flag\":true}"
    if Json.parse(src) as v
        # keys() enumerates in insertion order, which is what makes a faithful
        # re-serialisation possible at all.
        var ks: List(str) = v.keys()
        assert ks.len == 5
        assert ks.at(0) == "seq"
        assert ks.at(4) == "flag"

        # get() returns the value WHATEVER its type, and stringify round-trips it.
        # This is the property the relay depends on: a field can be copied without
        # the copier knowing what kind of thing it is.
        assert v.get("seq")!.stringify() == "7"
        assert v.get("type")!.stringify() == "\"request\""
        assert v.get("args")!.stringify() == "{\"line\":42}"
        assert v.get("extra")!.stringify() == "[1,2]"
        assert v.get("flag")!.stringify() == "true"

        # Nested access composes.
        assert (v.get("args")?.tryInt("line") orelse 0) == 42

        # A missing key is nil -- a stored null is not (get answers its value, and
        # has() is true): the presence test the old at() could not give.
        assert v.get("nope") == nil
        assert not v.has("nope")

        # keys() on a non-object is empty rather than an error.
        var arr = v.get("extra")!
        assert arr.keys().len == 0

        print("json_keys_at: OK")
    else
        print("json_keys_at: PARSE FAILED")
