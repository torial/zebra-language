# BUG-793: a struct constructor inside an interpolation hole passed -c and failed inside
# zig ("expected ',' after initializer") -- the hole emitted a struct literal as the
# receiver of .toString() without parentheses.
@derive(Debug)
struct One
    var x: int

@derive(Debug)
struct Named
    var s: str

class Box
    var v: int
    cue init(v: int)
        .v = v
    cue toString(): str
        return "Box<${.v}>"

def mk(s: str): Named
    return Named(s)

def main()
    var o = One(7)
    print("a ${One(4)} b ${Named("hi")} c ${Box(3)} d ${mk("q")} e ${o}")
