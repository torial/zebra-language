# BUG-313 — indexing is bounds-checked, and still WORKS.
#
# `.at(i)` used to lower to raw `items[@intCast(i)]`. Zig checks that in Debug and
# ReleaseSafe and NOT in ReleaseFast, which is what `zebra --release` passes -- so a shipped
# build read out of bounds, invented a value, and carried on. Two doors: an index past the
# end, and a NEGATIVE index (a Python reflex) wrapping through the @intCast.
#
# THIS FIXTURE IS THE POSITIVE HALF: every indexing path must still work in range. The
# refusal half cannot live here -- an out-of-range read PANICS, and the failure only appears
# under `--release`, which no smoke fixture builds. It lives in tools/release_mode_check.sh,
# the only gate that passes the flag.
#
# All four converted emitters are exercised, because they are four separate code paths in
# each compiler and a fix that missed one would otherwise pass:
#   1. List .at()          (two receiver branches in the selfhost)
#   2. List .set()
#   3. postfix list[i]
#   4. string .at() / str[i]
def main()
    var xs = List(int)()
    xs.add(10)
    xs.add(20)
    xs.add(30)

    # 1. .at() -- first and last element, so an off-by-one in the check itself shows up
    if xs.at(0) <> 10
        print("FAIL: at(0)")
        return
    if xs.at(2) <> 30
        print("FAIL: at(last) -- an off-by-one in the bounds check would reject this")
        return

    # 2. .set() writes through, in range
    xs.set(1, 99)
    if xs.at(1) <> 99
        print("FAIL: set")
        return

    # 3. postfix index
    if xs[0] <> 10
        print("FAIL: postfix xs[0]")
        return
    if xs[2] <> 30
        print("FAIL: postfix xs[last]")
        return

    # 4. string indexing
    var s = "hello"
    if s[0] <> 'h'
        print("FAIL: str[0]")
        return
    if s[4] <> 'o'
        print("FAIL: str[last]")
        return

    # nested containers -- the shape real numeric code uses
    var m = List(List(int))()
    var row = List(int)()
    row.add(7)
    row.add(8)
    m.add(row)
    if m.at(0).at(1) <> 8
        print("FAIL: nested at")
        return

    print("bug313: OK")
