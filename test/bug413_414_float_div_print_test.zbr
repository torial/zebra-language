# BUG-413: `7.0 / 2` (a float beside an int literal) hit Zig's "division of a comptime
# float and a comptime int" or an `@divTrunc` demand; BUG-414: a comptime float
# expression printed via `{d}` on a comptime_float. Both print as floats now.
def half(x: int): float
    return x / 2.0
def main()
    var a = 7.0 / 2
    var b = 1.0 / 3.0
    var c = 0.5 + 0.25
    print("${a} ${c}")
    print(b)
    print(half(5))
    print(10 / 4.0)
