class Validator
    static
        def checkPositive(n: int): int throws
            # was `guard n > 0 else` -- guard was freed as a keyword 2026-09-15; this
            # is the same early exit in the language's one spelling
            if not n > 0
                raise "expected positive number"
            return n

        def firstChar(s: str): str
            # was the inline form `guard s.len > 0 else, return "?"`
            if not s.len > 0: return "?"
            return s[0..1]

def testGuardSuccess()
    var x = Validator.checkPositive(42)?
    print(x)
catch |e|
    print("unexpected error: ".concat(e.message))

def testGuardFail()
    var bad = Validator.checkPositive(-5)?
    print(bad)
catch |e|
    print("guard raised: ".concat(e.message))

def main()
    # early-exit success path (this file was the `guard` keyword fixture until 2026-09-15;
    # it keeps its name and its golden output, with `if not` in place of `guard`)
    testGuardSuccess()

    # inline early exit
    var c = Validator.firstChar("hello")
    print(c)

    var empty = Validator.firstChar("")
    print(empty)

    # early exit that fires — verify error propagates with correct message
    testGuardFail()

    print("ok")
