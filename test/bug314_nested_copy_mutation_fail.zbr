# BUG-314: `.at()` on a List(List(T)) handed back a COPY of the inner list, so `.add()` on
# it was silently lost by the parent. From 2026-09-10 the three shapes below were REFUSED;
# since 2026-09-24 the inner container is heap-boxed and every one of them lands (the
# file keeps its name so the ledger's history reads; it is a smoke_run now, no longer a
# smoke_tc_fail). The full contract is test/nested_container_ref_test.zbr.
def main()
    var parent: List(List(float)) = List(List(float))()
    parent.add(List(float)())
    var r = parent.at(0)
    r.add(1.0)
    parent.at(0).add(2.0)
    for row in parent
        row.add(3.0)
    print(parent.count(), parent.at(0).count())
