# BUG-762: the loop variable of `for x in .items(n)` was typed str by the method's NAME
# (`items` is a Set's / map's element list), so a user method `items` returning List(int)
# had `s + x` falsely refused ("cannot concatenate 'int' and 'str'"). Its declared return
# wins now. Controls: the same with `vals`, and `.items()` on a str Set (still str).

class Bag
    def items(n: int): List(int)
        var out = List(int)()
        var i = 0
        while i < n
            out.add(i)
            i = i + 1
        return out

    def vals(n: int): List(int)
        return .items(n)

    def total(n: int): int
        var s = 0
        for x in .items(n)
            s = s + x
        return s

    def total2(n: int): int
        var s = 0
        for x in .vals(n)
            s = s + x
        return s

def main()
    var b = Bag()
    print("${b.total(3)} ${b.total2(3)}")
    var names: Set(str) = {}
    names.add("ann")
    for nm in names.items()
        print("hi " + nm)
    print("bug762: OK")
