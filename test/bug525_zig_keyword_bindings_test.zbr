    var r23 = boom() catch |threadlocal| take("${threadlocal}".len) * 0
    total = total + r23
    var b24 = Box.full(24)
    branch b24
        on Box.full as unreachable
            total = total + unreachable
        on Box.empty
            total = total + 0
    for unreachable in xs
        total = total + unreachable
    var r24 = boom() catch |unreachable| take("${unreachable}".len) * 0
    total = total + r24
    var b25 = Box.full(25)
    branch b25
        on Box.full as volatile
            total = total + volatile
        on Box.empty
            total = total + 0
    for volatile in xs
        total = total + volatile
    var r25 = boom() catch |volatile| take("${volatile}".len) * 0
    total = total + r25

    var bx = Boxed.one(Node(v: 19))
    branch bx
        on Boxed.one as pub
            print("boxed pub=${pub.v}")
        on Boxed.none
            print("none")
    print("kwbind total=${total}")
