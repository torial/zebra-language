# BUG-525: a binding named like a ZIG keyword that Zebra does not reserve (pub, fn, switch,
# error, defer, ...) was emitted bare in two positions -- a branch arm's capture
# (`on Box.full as pub` -> `|pub|`) and a postfix catch's (`catch |pub|`) -- while every USE was
# escaped (`@"pub"`), so zig refused code the user never wrote. Reported by the GameEngine
# session (`if .publisher as pub`). The 26 words are DERIVED: zig's own keyword table minus
# Zebra's vocabulary (tools/lint_zig_keywords.py + tools/zbr_vocab.py), not a hand list.
# The total is computed, not recorded: sum(0..25) + 6*26 = 481.
struct Node
    var v: int

union Boxed
    one: ^Node
    none

union Box
    full: int
    empty

def boom(): int throws
    raise "x"

def take(v: int): int
    return v + 1

def main()
    var total = 0
    var xs = [1, 2, 3]
    var b0 = Box.full(0)
    branch b0
        on Box.full as addrspace
            total = total + addrspace
        on Box.empty
            total = total + 0
    for addrspace in xs
        total = total + addrspace
    var r0 = boom() catch |addrspace| take("${addrspace}".len) * 0
    total = total + r0
    var b1 = Box.full(1)
    branch b1
        on Box.full as align
            total = total + align
        on Box.empty
            total = total + 0
    for align in xs
        total = total + align
    var r1 = boom() catch |align| take("${align}".len) * 0
    total = total + r1
    var b2 = Box.full(2)
    branch b2
        on Box.full as allowzero
            total = total + allowzero
        on Box.empty
            total = total + 0
    for allowzero in xs
        total = total + allowzero
    var r2 = boom() catch |allowzero| take("${allowzero}".len) * 0
    total = total + r2
    var b3 = Box.full(3)
    branch b3
        on Box.full as anyframe
            total = total + anyframe
        on Box.empty
            total = total + 0
    for anyframe in xs
        total = total + anyframe
    var r3 = boom() catch |anyframe| take("${anyframe}".len) * 0
    total = total + r3
    var b4 = Box.full(4)
    branch b4
        on Box.full as anytype
            total = total + anytype
        on Box.empty
            total = total + 0
    for anytype in xs
        total = total + anytype
    var r4 = boom() catch |anytype| take("${anytype}".len) * 0
    total = total + r4
    var b5 = Box.full(5)
    branch b5
        on Box.full as asm
            total = total + asm
        on Box.empty
            total = total + 0
    for asm in xs
        total = total + asm
    var r5 = boom() catch |asm| take("${asm}".len) * 0
    total = total + r5
    var b6 = Box.full(6)
    branch b6
        on Box.full as callconv
            total = total + callconv
        on Box.empty
            total = total + 0
    for callconv in xs
        total = total + callconv
    var r6 = boom() catch |callconv| take("${callconv}".len) * 0
    total = total + r6
    var b7 = Box.full(7)
    branch b7
        on Box.full as comptime
            total = total + comptime
        on Box.empty
            total = total + 0
    for comptime in xs
        total = total + comptime
    var r7 = boom() catch |comptime| take("${comptime}".len) * 0
    total = total + r7
    var b8 = Box.full(8)
    branch b8
        on Box.full as defer
            total = total + defer
        on Box.empty
            total = total + 0
    for defer in xs
