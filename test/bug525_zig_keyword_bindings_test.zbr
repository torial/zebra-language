            total = total + 0
    for pub in xs
        total = total + pub
    var r19 = boom() catch |pub| take("${pub}".len) * 0
    total = total + r19
    var b20 = Box.full(20)
    branch b20
        on Box.full as resume
            total = total + resume
        on Box.empty
            total = total + 0
    for resume in xs
        total = total + resume
    var r20 = boom() catch |resume| take("${resume}".len) * 0
    total = total + r20
    var b21 = Box.full(21)
    branch b21
        on Box.full as suspend
            total = total + suspend
        on Box.empty
            total = total + 0
    for suspend in xs
        total = total + suspend
    var r21 = boom() catch |suspend| take("${suspend}".len) * 0
    total = total + r21
    var b22 = Box.full(22)
    branch b22
        on Box.full as switch
            total = total + switch
        on Box.empty
            total = total + 0
    for switch in xs
