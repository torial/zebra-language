    total = total + r8
    var b9 = Box.full(9)
    branch b9
        on Box.full as errdefer
            total = total + errdefer
        on Box.empty
            total = total + 0
    for errdefer in xs
        total = total + errdefer
    var r9 = boom() catch |errdefer| take("${errdefer}".len) * 0
