# A class-typed ctor arg (`Node?`) passed to another Node's constructor must
# not be re-boxed at the call site (BUG-045). Companion to
# `recursive_type_test.zbr` which covers the field-assign path
# (`obj.field = x`); this covers the call-site arg materialization path in
# genBoxedArgExpr.  Classes are references, so no `^` is needed.
class Node
    var value: int
    var next : Node?
    cue init(v: int, nxt: Node?)
        this.value = v
        this.next  = nxt

class Main
    static def main()
        var c = Node(3, nil)
        var b = Node(2, c)
        var a = Node(1, b)
        assert a.value == 1
        assert b.value == 2
        assert c.value == 3
        print("ctor_arg_ref_test OK")
