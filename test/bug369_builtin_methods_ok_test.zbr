# BUG-369's CONTROL: the tables that refuse `frobnicate` must not refuse a real method.
# One call per documented str method family and per List method, at the arities the
# bogus fixtures use, RUN so the values are checked and not merely accepted. An
# over-broad table turns this file red before it turns a user's file red.
def main()
    var s: str = "  Hello, World  "
    var t: str = s.trim()
    assert t.upper() == "HELLO, WORLD"
    assert t.lower().startsWith("hello")
    assert t.substring(0, 5) == "Hello"
    assert t.indexOf("World") == 7
    assert t.replace("World", "Zebra").endsWith("Zebra")
    assert t.contains(",") and not t.isEmpty()
    assert t.split(",").len == 2
    assert "ab".repeat(2) == "abab"
    assert "7".toInt() == 7 and "ff".toIntBase(16) == 255
    assert "x".padLeft(3) == "  x"
    assert t.count("l") == 3
    assert "abc".reverse() == "cba"
    var n: int = 0
    for c in "hé".chars()
        n = n + 1
    assert n == 2
    var xs: List(int) = [3, 1, 2]
    xs.add(4)
    assert xs.count() == 4 and xs.at(0) == 3 and xs.contains(2)
    xs.set(0, 9)
    xs.remove(3)
    xs.sort()
    assert xs.at(0) == 1
    assert xs.any(def(x) = x > 8) and not xs.all(def(x) = x > 8)
    var big: List(int) = xs.filter(def(x) = x > 1)
    assert big.len == 2
    var total: int = xs.reduce(0, def(acc, x) = acc + x)
    assert total == 12
    var words: List(str) = ["a", "b"]
    assert words.join("-") == "a-b"
    xs.clear()
    assert xs.len == 0
    # second half: HashMap / Set / JsonValue, one call per documented member
    var m: HashMap(str, int) = HashMap(str, int)()
    m.set("a", 1)
    m.set("b", 2)
    assert m.count() == 2 and m.contains("a") and m.fetch("b") == 2
    assert m.get("zz") == nil
    var ks: List(str) = m.keys()
    var vs: List(int) = m.values()
    assert ks.len == 2 and vs.len == 2
    var esum: int = 0
    for k, v in m.entries()
        esum = esum + v
    assert esum == 3
    m.remove("a")
    assert m.len == 1
    var st: Set(int) = Set(int)()
    st.add(3)
    st.add(3)
    st.add(4)
    assert st.count() == 2 and st.contains(3) and not st.contains(9)
    st.remove(3)
    var its: List(int) = st.items()
    assert its.len == 1
    st.clear()
    assert st.len == 0
    if Json.parse("{\"k\": \"v\", \"n\": 2, \"xs\": [1, 2], \"o\": {\"f\": 1.5, \"b\": true}}") as j
        assert j.getStr("k") == "v" and j.getInt("n") == 2
        assert j.getList("xs").len == 2 and j.getObj("o").getFloat("f") > 1.0 and j.getObj("o").getBool("b")
        assert j.isObject() and not j.isNull() and j.at("xs").isArray()
        var jk: List(str) = j.keys()
        assert jk.len == 4
    var jb = Json.object()
    jb.put("city", "x")
    jb.putInt("added", 7)
    jb.putFloat("f", 1.5)
    jb.putBool("b", true)
    assert jb.stringify().contains("added")
    var ja = Json.array()
    ja.append("one")
    ja.appendInt(2)
    ja.appendFloat(2.5)
    ja.appendBool(false)
    assert ja.isArray()
    print("bug369: OK")
