# BUG-203: an explicit call to the @derive(Eq) equality method must work alongside `==`.
# Historically the generated method was `eql(other: *const Self)` and a bare `a.eql(b)`
# failed to compile ("expected *const Color, found Color"). Since cues (2026-09-16) the
# derived method is `equals(other: Self)` by value -- the same shape a hand-written
# `cue equals` has -- so `a.equals(b)` and `a == b` are the same call.

@derive(Eq)
struct Color
    var r: int
    var g: int
    var b: int

def main()
    var a = Color(r: 1, g: 2, b: 3)
    var b = Color(r: 1, g: 2, b: 3)
    var c = Color(r: 9, g: 9, b: 9)

    assert a.equals(b), "explicit eql: equal structs"
    assert not a.equals(c), "explicit eql: unequal structs"
    # Regression guard: the == rewrite (which already addressed the arg) still works.
    assert a == b, "== equal"
    assert a != c, "!= unequal"

    print("derive_eql_explicit: OK")
