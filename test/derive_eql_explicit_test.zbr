# BUG-203: an explicit `.eql(value)` call on a @derive(Eq) struct must address the
# value argument (the generated eql takes `other: *const Self`). Previously this
# emitted `a.eql(b)` and failed to compile ("expected *const Color, found Color");
# only the `==` operator worked. Both must now work.

@derive(Eq)
struct Color
    var r: int
    var g: int
    var b: int

def main()
    var a = Color(r: 1, g: 2, b: 3)
    var b = Color(r: 1, g: 2, b: 3)
    var c = Color(r: 9, g: 9, b: 9)

    assert a.eql(b), "explicit eql: equal structs"
    assert not a.eql(c), "explicit eql: unequal structs"
    # Regression guard: the == rewrite (which already addressed the arg) still works.
    assert a == b, "== equal"
    assert a != c, "!= unequal"

    print("derive_eql_explicit: OK")
