# @boundary runs
#
# BUG-501 -- THE INTENT PROBE for docs/design/container_reference_semantics.md. Written
# from that note's §2 rule and §6 decisions on 2026-09-30, BEFORE any of it was built, and
# committed UNRUN. It fails on today's compiler by construction. It moves to test/boundary/
# in Phase 1, unedited, as the acceptance test.
#
# The rule: primitives, str, structs, tuples, enums and unions are values; classes and
# containers (List, HashMap, Set, StringBuilder) are references. `==` on containers is
# structural; `copy()` is shallow; a container field with no initializer starts empty.

class Bag
    var items: List(int)
    cue init()
        .items = List(int)()
        .items.add(1)
    def all(): List(int)
        return .items

struct Rec
    var xs: List(int)
    var n: int

class Empty
    var xs: List(int)
    var m: HashMap(str, int)

def innerMap(outer: HashMap(str, HashMap(str, int)), k: str): HashMap(str, int)
    if outer.get(k) as found
        return found
    return HashMap(str, int)()

def main()
    # 1. assignment aliases
    var a = List(int)()
    a.add(10)
    var b = a
    b.add(20)
    a.add(30)
    print(a.len)
    print(b.len)
    print(b[1])

    # 2. a returned field IS the field
    var bag = Bag()
    var got = bag.all()
    got.add(2)
    bag.items.add(3)
    print(bag.items.len)
    print(got[1])

    # 3. a struct is a value whose container FIELD is a reference
    var xs0 = List(int)()
    xs0.add(1)
    var r1 = Rec(xs0, 0)
    var r2 = r1
    r2.xs.add(2)
    r1.xs.add(3)
    print(r1.xs.len)
    print(r2.xs[1])
    print(xs0.len)
    r2.n = 9
    print(r1.n)

    # 4. except shares a field it does not replace, and does not touch one it does
    var r3 = r1 except n = 5
    r3.xs.add(4)
    print(r1.xs.len)
    var r4 = r1 except xs = List(int)()
    print(r4.xs.len)
    print(r1.xs.len)

    # 5. set, then mutate the local: the stored list sees it
    var outer = HashMap(str, List(int))()
    var local = List(int)()
    local.add(1)
    outer.set("k", local)
    local.add(2)
    if outer.get("k") as stored
        print(stored.len)
        # 6. and a mutation through the bound value is seen by the local
        stored.add(3)
    print(local.len)

    # 7. a map returned from a def is the map -- even when it starts EMPTY
    var maps = HashMap(str, HashMap(str, int))()
    maps.set("a", HashMap(str, int)())
    var m1 = innerMap(maps, "a")
    m1.set("x", 5)
    if maps.get("a") as ma
        print(ma.len)
        print(ma.get("x") orelse -1)

    # 8. copy() is a new container -- shallow
    var c = a.copy()
    c.add(99)
    print(a.len)
    print(c.len)
    var nested = List(List(int))()
    nested.add(List(int)())
    var ncopy = nested.copy()
    ncopy.at(0).add(7)
    print(nested.at(0).len)

    # 9. == is structural
    var e1 = List(int)()
    e1.add(1)
    e1.add(2)
    var e2 = List(int)()
    e2.add(1)
    e2.add(2)
    print(e1 == e2)
    e2.add(3)
    print(e1 == e2)
    var h1 = HashMap(str, int)()
    h1.set("x", 1)
    var h2 = HashMap(str, int)()
    h2.set("x", 1)
    print(h1 == h2)

    # 10. a container field with no initializer starts empty and is usable
    var em = Empty()
    print(em.xs.len)
    em.xs.add(1)
    em.m.set("k", 2)
    print(em.xs.len)
    print(em.m.len)

    # 11. Set and StringBuilder alias too
    var s1 = Set(int)()
    var s2 = s1
    s2.add(4)
    print(s1.len)
    var sb = StringBuilder()
    sb.append("a")
    var sb2 = sb
    sb2.append("b")
    print(sb.build())
