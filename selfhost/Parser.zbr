# Phase 3: Recursive-descent parser - Parser.zbr
# Self-hosting demo: token stream - PNode parse tree.
#
# Design note: all recursive child references go through List(PNode) or union
# ^T variant auto-boxing - struct fields are only String/bool/int/List(T).
# This sidesteps the struct-field ^T auto-boxing gap (no compiler change needed).
# The gap is documented in SELFHOST_JOURNAL.md Phase 3 "Where Zebra felt worse".
#
# Language features exercised:
#   - throws auto-propagation through mutually-recursive parse methods
#   - Union variant ^T auto-boxing (PNode.stmt_if(PIf(...)))
#   - List(PNode) accumulation in parse loops
#   - branch dispatch on TokenKind union variants
#   - String comparison for keyword/operator detection
#   - Recursive method calls (parseExpr - parseAddSub - parseUnary - parsePostfix - parseAtom)

use Token exposing TokenKind
use Lexer

# The cues -- methods the compiler calls for you on a language event, declared with
# `cue` instead of `def` (2026-09-16). init on construction, toString on print and
# interpolation, equals on ==, hash for HashMap/Set keys (needs equals), compare on
# < <= > >= and sort(), iter/next on for-in. tools/surface_inventory.py reads this
# line for docs/SURFACE.md; the list is the surface.
var CUE_NAMES: str = "|init|toString|equals|hash|compare|iter|next|"

# -- Parse tree node types -----------------------------------------------------

union PNode
    # Top level
    module_: ^PModule
    use_: ^PUse
    class_: ^PClass
    struct_: ^PClass
    interface_: ^PClass
    mixin_: ^PClass
    extend_: ^PExtend
    enum_: ^PEnum
    union_decl: ^PUnionDecl
    sig_: ^PSig
    type_alias_: ^PTypeAlias
    namespace_decl: ^PNamespace

    # Members / declarations
    field_: ^PField
    method_: ^PMethod
    init_: ^PInit
    # Statements
    stmt_pass
    stmt_break
    stmt_continue
    stmt_return: ^PReturn
    stmt_if: ^PIf
    stmt_while: ^PWhile
    stmt_for_in: ^PForIn
    stmt_for_num: ^PForNum
    stmt_var: ^PVar
    stmt_assign: ^PAssign
    stmt_assert: ^PAssert
    stmt_raise: ^PRaise
    stmt_try_catch: ^PTryCatch
    stmt_expr: ^PNode
    stmt_print: List(PNode)
    stmt_allocate: ^PAllocate
    stmt_copy_out: ^PCopyOut
    stmt_with: ^PWith
    stmt_in: ^PInScope
    stmt_destruct: ^PDestruct
    stmt_require: List(PNode)
    stmt_ensure: List(PNode)
    invariant_decl: List(PNode)
    expr_orelse: ^POrelse
    expr_catch: ^PCatch
    expr_pipeline: ^PPipeline

    # Expressions (inline - no heap indirection)
    expr_int: ^PLit
    expr_float: ^PLit
    expr_bool: ^PBoolLit
    expr_nil: ^PPos
    expr_this: ^PPos
    expr_result: ^PPos
    expr_str: ^PLit
    expr_char: ^PLit
    expr_zig_lit: ^PZigLit
    expr_raw_str: ^PLit
    expr_format: ^PLit
    expr_id: ^PExprId

    # Expressions (heap-boxed - recursive)
    expr_member: ^PMember
    expr_call: ^PCall
    expr_named_arg: ^PNamedArg
    expr_index: ^PIndex
    expr_slice: ^PSlice
    expr_binary: ^PBinary
    expr_unary: ^PUnary
    expr_try: ^PNode
    expr_to_bang: ^PNode
    expr_except: ^PExcept
    expr_string_interp: ^PStringInterp
    expr_lambda: PLambda
    expr_tuple_lit: ^PTupleLit
    expr_array_lit: ^PArrayLit
    expr_list_lit: ^PArrayLit          # [a, b, c] — same shape as array, different lowering
    expr_set_lit: ^PArrayLit           # {a, b, c} — set literal (third lowering)
    expr_dict_lit: ^PDictLit           # {k: v, ...} — dict literal
    expr_chained_cmp: ^PChainedCmp    # a < b < c — chained comparison
    expr_opt_chain: ^POptChain         # expr?.member / expr?.method(args)
    expr_if_expr: ^PIfExpr             # if cond: val else: other  (inline ternary)

    # Branch statement
    stmt_branch: ^PBranch

struct PUnionDecl
    var name: str
    var variants: List(PUnionVariant)
    var line: int
    var col: int
    cue init(name: str, variants: List(PUnionVariant), line: int = 0, col: int = 0)
        .name = name
        .variants = variants
        .line = line
        .col = col

struct PUnionVariant
    var name: str
    var type_name: str
    # BUG-288: the variant NAME's position. Without it AstBuilder built UnionVariant
    # with zspan(), so `item: ^Payload` -- the double-box refusal -- reported 0:0.
    var line: int
    var col: int
    cue init(name: str, type_name: str, line: int, col: int)
        .name = name
        .type_name = type_name
        .line = line
        .col = col

struct PTypeAlias
    var name: str
    var params: List(PParam)
    var base_type: str
    var constraint: List(PNode)
    cue init(name: str, params: List(PParam), base_type: str, constraint: List(PNode))
        .name = name
        .params = params
        .base_type = base_type
        .constraint = constraint

struct PSig
    var name: str
    var params: List(PParam)
    var return_type: str
    var line: int
    var col: int
    cue init(name: str, params: List(PParam), return_type: str, line: int = 0, col: int = 0)
        .name = name
        .params = params
        .return_type = return_type
        .line = line
        .col = col

struct PBranch
    var subject: List(PNode)
    var arms: List(PBranchOn)
    var else_stmts: List(PNode)
    var line: int
    var col: int
    cue init(subject: List(PNode), arms: List(PBranchOn), else_stmts: List(PNode), line: int, col: int)
        .subject = subject
        .arms = arms
        .else_stmts = else_stmts
        .line = line
        .col = col

struct PBranchOn
    var patterns: List(str)
    var binding: str
    var filter_cond: List(PNode)
    var stmts: List(PNode)
    var struct_pat_node: List(PNode)
    var line: int          # of the `on` keyword (2026-09-16: an arm can carry a diagnostic)
    var col: int
    cue init(patterns: List(str), binding: str, filter_cond: List(PNode), stmts: List(PNode), line: int = 0, col: int = 0)
        .patterns = patterns
        .binding = binding
        .filter_cond = filter_cond
        .stmts = stmts
        .struct_pat_node = List(PNode)()
        .line = line
        .col = col

struct PTupleLit
    var elems: List(PNode)
    cue init(elems: List(PNode))
        .elems = elems

struct PArrayLit
    var elems: List(PNode)
    cue init(elems: List(PNode))
        .elems = elems

# {k: v, ...} dict literal — parallel key/value lists (lowered to ExprDictLit).
struct PDictLit
    var keys: List(PNode)
    var values: List(PNode)
    cue init(keys: List(PNode), values: List(PNode))
        .keys = keys
        .values = values

struct PExcept
    var base: List(PNode)
    var fields: List(PExceptField)
    cue init(base: List(PNode), fields: List(PExceptField))
        .base = base
        .fields = fields

struct PExceptField
    var name: str
    var value: List(PNode)
    cue init(name: str, value: List(PNode))
        .name = name
        .value = value

struct PStringInterp
    var parts: List(PNode)
    cue init(parts: List(PNode))
        .parts = parts

struct PLambda
    var params: List(PParam)
    var return_type: str
    var captures: List(PCaptureVar)
    var body_expr: List(PNode)
    var body_stmts: List(PNode)
    cue init(params: List(PParam), return_type: str, captures: List(PCaptureVar), body_expr: List(PNode), body_stmts: List(PNode))
        .params = params
        .return_type = return_type
        .captures = captures
        .body_expr = body_expr
        .body_stmts = body_stmts

struct PCaptureVar
    var name: str
    var type_name: str
    var init_expr: List(PNode)
    var is_const: bool
    cue init(name: str, type_name: str, init_expr: List(PNode), is_const: bool)
        .name = name
        .type_name = type_name
        .init_expr = init_expr
        .is_const = is_const

struct PUse
    var path: str
    var exposed: List(str)
    cue init(path: str, exposed: List(str))
        .path = path
        .exposed = exposed

struct PModule
    var decls: List(PNode)
    cue init(decls: List(PNode))
        .decls = decls

struct PNamespace
    var name: str
    var decls: List(PNode)
    var line: int
    var col: int
    cue init(name: str, decls: List(PNode), line: int = 0, col: int = 0)
        .name = name
        .decls = decls
        .line = line
        .col = col

struct PParam
    var name: str
    var type_name: str
    var default_expr: List(PNode)
    cue init(name: str, type_name: str, default_expr: List(PNode))
        .name = name
        .type_name = type_name
        .default_expr = default_expr

struct PClass
    var name: str
    var type_params: List(str)
    var ifaces: List(str)
    var mixins: List(str)
    var members: List(PNode)
    var invs: List(PNode)
    var is_reflectable: bool
    var is_derive_debug: bool
    var is_derive_eq: bool
    var is_derive_hash: bool
    var export_sym: str?
    var line: int
    var col: int
    cue init(name: str, type_params: List(str), ifaces: List(str), mixins: List(str), members: List(PNode), invs: List(PNode), is_reflectable: bool, is_derive_debug: bool = false, is_derive_eq: bool = false, is_derive_hash: bool = false, export_sym: str? = nil, line: int = 0, col: int = 0)
        .name = name
        .type_params = type_params
        .ifaces = ifaces
        .mixins = mixins
        .members = members
        .invs = invs
        .is_reflectable = is_reflectable
        .is_derive_debug = is_derive_debug
        .is_derive_eq = is_derive_eq
        .is_derive_hash = is_derive_hash
        .export_sym = export_sym
        .line = line
        .col = col

struct PExtend
    var target_name: str
    var members: List(PNode)
    cue init(target_name: str, members: List(PNode))
        .target_name = target_name
        .members = members

struct PEnum
    var name: str
    var variants: List(str)
    # B10: backing type name ("" = plain enum) and per-variant explicit values
    # (parallel to variants; each inner list is 0 or 1 value expr, like PField).
    var base: str
    var values: List(List(PNode))
    var line: int
    var col: int
    cue init(name: str, variants: List(str), base: str, values: List(List(PNode)), line: int = 0, col: int = 0)
        .name = name
        .variants = variants
        .base = base
        .values = values
        .line = line
        .col = col

struct PField
    var name: str
    var type_name: str
    var is_const: bool
    var is_static: bool
    var is_private: bool
    var is_public: bool
    var init_expr: List(PNode)
    var line: int
    var col: int
    cue init(name: str, type_name: str, is_const: bool, is_static: bool, is_private: bool, is_public: bool, init_expr: List(PNode), line: int = 0, col: int = 0)
        .name = name
        .type_name = type_name
        .is_const = is_const
        .is_static = is_static
        .is_private = is_private
        .is_public = is_public
        .init_expr = init_expr
        .line = line
        .col = col

struct PMethod
    var name: str
    var is_static: bool
    var is_private: bool
    var is_public: bool
    var throws_: bool
    var params: List(PParam)
    var return_type: str
    var stmts: List(PNode)
    var is_profile: bool
    var is_once: bool
    var tags: List(str)
    var is_export: bool
    var type_params: List(str)
    var is_pure: bool
    var is_node_export: bool
    # BUG-258. Defaulted, and declared AFTER every existing positional parameter,
    # so no current call site shifts. Ast.Modifiers takes 15 positional booleans
    # and nothing type-errors if one is inserted mid-list -- the same hazard lives
    # here, so new flags go on the end.
    var is_extern: bool
    var line: int
    var col: int
    var is_cue: bool       # declared with `cue`, not `def` (2026-09-16): a method the compiler calls
    cue init(name: str, is_static: bool, is_private: bool, is_public: bool, throws_: bool, params: List(PParam), return_type: str, stmts: List(PNode), is_profile: bool, is_once: bool, tags: List(str), is_export: bool, type_params: List(str), is_pure: bool = false, is_node_export: bool = false, line: int = 0, col: int = 0, is_extern: bool = false, is_cue: bool = false)
        .name = name
        .is_static = is_static
        .is_private = is_private
        .is_public = is_public
        .throws_ = throws_
        .params = params
        .return_type = return_type
        .stmts = stmts
        .is_profile = is_profile
        .is_once = is_once
        .tags = tags
        .is_export = is_export
        .type_params = type_params
        .is_pure = is_pure
        .is_node_export = is_node_export
        .is_extern = is_extern
        .is_cue = is_cue
        .line = line
        .col = col

struct PInit
    var params: List(PParam)
    var stmts: List(PNode)
    cue init(params: List(PParam), stmts: List(PNode))
        .params = params
        .stmts = stmts

struct PReturn
    var value: List(PNode)
    var line: int
    # BUG-288 batch 3: the statement's own column. A BARE `return` and an `in` scope
    # have no sub-expression to anchor a diagnostic on, so the statement position is all
    # there is -- and `Span(line, 0, ...)` was reporting column 0 for both.
    var col: int
    cue init(value: List(PNode), line: int, col: int)
        .value = value
        .line = line
        .col = col

struct PIf
    var cond: List(PNode)
    var is_capture: str?
    var then_stmts: List(PNode)
    var else_stmts: List(PNode)
    var line: int
    var col: int
    cue init(cond: List(PNode), then_stmts: List(PNode), else_stmts: List(PNode), line: int, col: int)
        .cond = cond
        .is_capture = nil
        .then_stmts = then_stmts
        .else_stmts = else_stmts
        .line = line
        .col = col

struct PWhile
    var cond: List(PNode)
    var stmts: List(PNode)
    var line: int
    var col: int
    cue init(cond: List(PNode), stmts: List(PNode), line: int, col: int)
        .cond = cond
        .stmts = stmts
        .line = line
        .col = col

struct PAllocate
    var source: List(PNode)
    var stmts: List(PNode)
    var is_scoped: bool
    var line: int
    var col: int
    cue init(source: List(PNode), stmts: List(PNode), is_scoped: bool, line: int, col: int)
        .source = source
        .stmts = stmts
        .is_scoped = is_scoped
        .line = line
        .col = col

struct PCopyOut
    var target: List(PNode)
    var value: List(PNode)
    var deep: bool           # true = `<<-` copy-out, false = `<-` channel op
    var line: int
    var col: int
    cue init(target: List(PNode), value: List(PNode), deep: bool, line: int, col: int)
        .target = target
        .value = value
        .deep = deep
        .line = line
        .col = col

struct PWith
    var target: List(PNode)
    var stmts: List(PNode)
    var line: int
    var col: int
    cue init(target: List(PNode), stmts: List(PNode), line: int, col: int)
        .target = target
        .stmts = stmts
        .line = line
        .col = col

struct PInScope
    var expr: List(PNode)
    var stmts: List(PNode)
    var line: int
    # BUG-288 batch 3: see PReturn.
    var col: int
    cue init(expr: List(PNode), stmts: List(PNode), line: int, col: int)
        .expr = expr
        .stmts = stmts
        .line = line
        .col = col

struct POrelse
    var expr: List(PNode)
    var fallback: List(PNode)
    cue init(expr: List(PNode), fallback: List(PNode))
        .expr = expr
        .fallback = fallback

struct PCatch
    var expr: List(PNode)
    var binding: str
    var fallback: List(PNode)
    cue init(expr: List(PNode), binding: str, fallback: List(PNode))
        .expr = expr
        .binding = binding
        .fallback = fallback

struct PPipeline
    var lhs: List(PNode)
    var rhs: List(PNode)
    cue init(lhs: List(PNode), rhs: List(PNode))
        .lhs = lhs
        .rhs = rhs

struct PForIn
    var var_names: List(str)
    var iter: List(PNode)
    var filter: List(PNode)
    var stmts: List(PNode)
    var else_stmts: List(PNode)
    var line: int
    var col: int
    cue init(var_names: List(str), iter: List(PNode), filter: List(PNode), stmts: List(PNode), else_stmts: List(PNode), line: int, col: int)
        .var_names = var_names
        .iter = iter
        .filter = filter
        .stmts = stmts
        .else_stmts = else_stmts
        .line = line
        .col = col

struct PForNum
    var var_name: str
    var start: List(PNode)
    var stop_: List(PNode)
    var step: List(PNode)
    var stmts: List(PNode)
    var else_stmts: List(PNode)
    var line: int
    var col: int
    cue init(var_name: str, start: List(PNode), stop_: List(PNode), step: List(PNode), stmts: List(PNode), else_stmts: List(PNode), line: int, col: int)
        .var_name = var_name
        .start = start
        .stop_ = stop_
        .step = step
        .stmts = stmts
        .else_stmts = else_stmts
        .line = line
        .col = col

struct PVar
    var name: str
    var is_const: bool
    var type_name: str
    var init_expr: List(PNode)
    var line: int
    # BUG-288 batch 3: the declaration's own column. Most var diagnostics anchor on
    # the init EXPRESSION instead (TypeChecker.varDiagCol), but an uninitialised
    # declaration has none, and `Span(line, 0, ...)` was reporting column 0 for it.
    var col: int
    cue init(name: str, is_const: bool, type_name: str, init_expr: List(PNode), line: int, col: int)
        .name = name
        .is_const = is_const
        .type_name = type_name
        .init_expr = init_expr
        .line = line
        .col = col

struct PDestruct
    var names: List(str)
    var init_expr: List(PNode)
    var is_struct: bool
    var line: int
    var col: int
    cue init(names: List(str), init_expr: List(PNode), is_struct: bool, line: int, col: int)
        .names = names
        .init_expr = init_expr
        .is_struct = is_struct
        .line = line
        .col = col

struct PAssign
    var op: str
    var target: List(PNode)
    var value: List(PNode)
    var line: int
    var col: int
    cue init(op: str, target: List(PNode), value: List(PNode), line: int, col: int)
        .op = op
        .target = target
        .value = value
        .line = line
        .col = col

struct PAssert
    var cond: List(PNode)
    var message: List(PNode)
    var line: int
    var col: int
    cue init(cond: List(PNode), message: List(PNode), line: int, col: int)
        .cond = cond
        .message = message
        .line = line
        .col = col

struct PRaise
    var message: List(PNode)
    var line: int
    var col: int
    cue init(message: List(PNode), line: int, col: int)
        .message = message
        .line = line
        .col = col

struct PTryCatch
    var body_stmts: List(PNode)
    var catch_binding: str
    var catch_stmts: List(PNode)
    var line: int
    var col: int
    cue init(body_stmts: List(PNode), catch_binding: str, catch_stmts: List(PNode), line: int, col: int)
        .body_stmts = body_stmts
        .catch_binding = catch_binding
        .catch_stmts = catch_stmts
        .line = line
        .col = col

struct PMember
    var base: List(PNode)
    var member: str
    var line: int
    var col: int
    cue init(base: List(PNode), member: str, line: int, col: int)
        .base = base
        .member = member
        .line = line
        .col = col

struct PCall
    var callee: List(PNode)
    var args: List(PNode)
    cue init(callee: List(PNode), args: List(PNode))
        .callee = callee
        .args = args

struct PNamedArg
    var name: str
    var value: List(PNode)
    cue init(name: str, value: List(PNode))
        .name = name
        .value = value

struct PIndex
    var object: List(PNode)
    var index: List(PNode)
    cue init(object: List(PNode), index: List(PNode))
        .object = object
        .index = index

struct PSlice
    var object: List(PNode)
    var start: List(PNode)
    var stop_: List(PNode)
    cue init(object: List(PNode), start: List(PNode), stop_: List(PNode))
        .object = object
        .start = start
        .stop_ = stop_

struct PBinary
    var op: str
    var left: List(PNode)
    var right: List(PNode)
    cue init(op: str, left: List(PNode), right: List(PNode))
        .op = op
        .left = left
        .right = right

struct PUnary
    var op: str
    var operand: List(PNode)
    cue init(op: str, operand: List(PNode))
        .op = op
        .operand = operand

struct PChainedCmp
    var ops: List(str)      # operator strings (length N)
    var operands: List(PNode)  # expressions (length N+1)
    cue init(ops: List(str), operands: List(PNode))
        .ops = ops
        .operands = operands

struct POptChain
    var base: List(PNode)    # single element: the optional expression
    var member: str          # member or method name
    var has_args: bool       # true = method call
    var args: List(PNode)    # call args (PNode or PNode.expr_named_arg)
    cue init(base: List(PNode), member: str, has_args: bool, args: List(PNode))
        .base = base
        .member = member
        .has_args = has_args
        .args = args

struct PIfExpr
    var cond: List(PNode)       # single element: condition expression
    var then_expr: List(PNode)  # single element: then-branch expression
    var else_expr: List(PNode)  # single element: else-branch expression
    cue init(cond: List(PNode), then_expr: List(PNode), else_expr: List(PNode))
        .cond = cond
        .then_expr = then_expr
        .else_expr = else_expr

# BUG-249: the position payload for parser variants that carry NOTHING ELSE.
# `nil`, `this` and `result` are single tokens, so their PNode variants held no data at
# all and `AstBuilder` had to build them with `zspan()` -- Span(0,0,0,0). Every
# front-end diagnostic anchored on one of them therefore reported 0:0, which caps the
# quality of the whole move-checking-inward programme: a check that cannot say WHERE is
# delivered half-finished.
#
# One struct shared by all three rather than three near-identical ones: they carry the
# same thing for the same reason, and a shared payload is one place to change if a span
# ever needs more than a point.
struct PPos
    var line: int
    var col: int
    cue init(line: int, col: int)
        .line = line
        .col = col

# BUG-288 batch 1: the payload for every LITERAL parse node.
#
# `expr_int`, `expr_float`, `expr_str`, `expr_char`, `expr_raw_str` and `expr_format` each
# had `str` as their ENTIRE payload, so there was nowhere to put a position and AstBuilder
# had no choice but `zspan()`. That is why `return "hello"` in an `int` method reported
# `file:2:0` — not "position unknown", but a plausible-looking coordinate that is simply
# wrong, which defeats caret rendering and sends an editor to the wrong column.
#
# ONE struct rather than six identical ones. `PZigLit` stays separate because it predates
# this and renaming it would be churn for no reader's benefit.
struct PLit
    var text: str
    var line: int
    var col: int
    cue init(text: str, line: int, col: int)
        .text = text
        .line = line
        .col = col

# The same, for `expr_bool`, whose payload is a bool rather than text.
struct PBoolLit
    var value: bool
    var line: int
    var col: int
    cue init(value: bool, line: int, col: int)
        .value = value
        .line = line
        .col = col

# BUG-284: a zig literal carried only its TEXT, so every diagnostic attached to one
# reported 0:0 -- a plausible-looking coordinate that is simply wrong, which also
# defeats caret rendering. The parser was holding the position all along; this is the
# same treatment PExprId already gets, for the same reason.
struct PZigLit
    var text: str
    var line: int
    var col: int
    cue init(text: str, line: int, col: int)
        .text = text
        .line = line
        .col = col

struct PExprId
    var name: str
    var line: int
    var col: int
    cue init(name: str, line: int, col: int)
        .name = name
        .line = line
        .col = col

# -- Parser class --------------------------------------------------------------

class Parser
    var tokens: List(Token.Token)
    var pos: int
    var file_name: str
    var parse_errors: List(str)
    var collected_decls: List(PNode)
    var source: str
    var expr_depth: int    # BUG-200: recursion-depth guard for parseExpr

    cue init(tokens: List(Token.Token), file_name: str, source: str = "")
        .tokens = tokens
        .pos = 0
        .file_name = file_name
        .parse_errors = List(str)()
        .collected_decls = List(PNode)()
        .source = source
        .expr_depth = 0

    # Contracts pilot (2026-07-30). Every clause here is a property that is ALREADY
    # true — the point is to state it so a violation is reported at the point of
    # breakage instead of surfacing later as a wrong parse or an index panic. Nothing
    # here is aspirational; an aspirational contract would just be a false failure.
    #
    # `--turbo` strips all of this, so release builds are unaffected.
    invariant
        .pos >= 0
        .pos <= .tokens.len
        .expr_depth >= 0

    # -- Cursor ----------------------------------------------------------------

    def peek(): Token.Token
        # The fallback indexes `.tokens.len - 1`, which is at(-1) on an empty list.
        # The Lexer always emits an EOF token (Lexer.zbr ~948) so this holds for any
        # lexed input — stating it names the dependency, and catches a hand-built
        # Parser given an empty token list.
        require
            .tokens.len > 0
        if .pos < .tokens.len
            return .tokens.at(.pos)
        return .tokens.at(.tokens.len - 1)

    def peekAt(offset: int): Token.Token
        # `.pos + offset` is used as an index without a lower-bound check, so a
        # sufficiently negative offset would index at(-n). Every call site today
        # passes 1 or 2; Lexer.peekAt already carries the sibling guard. Asserting the
        # SUM rather than the offset states the actual safety condition.
        require
            .tokens.len > 0
            .pos + offset >= 0
        var idx = .pos + offset
        if idx < .tokens.len
            return .tokens.at(idx)
        return .tokens.at(.tokens.len - 1)

    def advance()
        # The cursor only ever moves forward, and never past the end. A parser loop
        # that fails to advance is the BUG-199 shape (an 18-byte infinite loop), so
        # monotonicity is worth stating even though it cannot catch that case alone.
        ensure
            .pos >= old .pos
            .pos <= .tokens.len
        if .pos < .tokens.len
            .pos = .pos + 1

    def textIs(s: str): bool
        return .peek().text == s

    def sourceLine(li: int): str
        if .source.len == 0 or li < 0
            return ""
        var idx = 0
        for ln in .source.split("\n")
            if idx == li
                return ln
            idx = idx + 1
        return ""

    def errorAt(msg: str): str
        var tok = .peek()
        var head = .file_name + ":" + tok.line.toString() + ":" + tok.col.toString() + ": error: " + msg
        var src_line = .sourceLine(tok.line - 1)
        if src_line.len > 0
            var caret = StringBuilder()
            var c = 1
            while c < tok.col
                caret.append(" ")
                c = c + 1
            caret.append("^")
            return head + "\n" + src_line + "\n" + caret.build()
        return head

    # A friendlier diagnostic when a token shows up where an expression was
    # expected.  Statement keywords (`def`, `if`, `for`, …) leaking into
    # expression position are the most confusing case — name the actual problem
    # instead of the generic "unexpected expression token".
    # BUG-380: a Python-shaped trailing colon on a block header (`if x:`, `for x in xs:`,
    # `while c:`, `def main():`, `else:`, `class Foo:`) produced five different internal
    # messages depending on which parse path swallowed the colon. One check, one message.
    def refuseTrailingColon(): void throws
        if .textIs(":") and .peekAt(1).kind is TokenKind.eol
            raise .errorAt("a block header ends at the end of the line with no colon -- indent the body on the next line; `header: stmt` is the one-line form (QUICKSTART §1.5)")

    def unexpectedExprMsg(): str
        var t = .peek().text
        if t == "def"
            return .errorAt("a function definition ('def') can't appear in expression position — use a lambda `def(args) body`, or move it to its own statement")
        if t == "if" or t == "for" or t == "while" or t == "return" or t == "branch" or t == "raise" or t == "var" or t == "const" or t == "with"
            return .errorAt("'" + t + "' is a statement keyword and can't be used as an expression here")
        if t.len == 0
            return .errorAt("unexpected end of input while parsing an expression")
        # BUG-419: the JS/C# arrow lambda `x => x * 2` (also `(a, b) => a + b`) is a
        # `=` then a `>` in expression position; name the Zebra form.
        if t == "=" and .peekAt(1).text == ">"
            return .errorAt("there is no `x => expr` arrow lambda in Zebra: write `def(x) = expr` (QUICKSTART §1.5)")
        return .errorAt("unexpected expression token: '" + t + "'")

    # Friendlier diagnostic for a token that isn't a valid top-level declaration.
    # The common cause is loose executable code at module scope (Zebra only
    # allows declarations there) — say so instead of "unexpected top-level token".
    def unexpectedTopLevelMsg(): str
        var t = .peek().text
        if t == "if" or t == "for" or t == "while" or t == "return" or t == "branch" or t == "raise" or t == "with" or t == "print"
            return .errorAt("'" + t + "' is a statement and can't appear at the top level — only declarations (def, class, struct, enum, union, use, var, const) belong here; move it into a function")
        if t.len == 0
            return .errorAt("unexpected end of input at the top level")
        return .errorAt("unexpected top-level token: '" + t + "' — expected a declaration (def, class, struct, enum, union, use, var, const)")

    def expectText(s: str) throws
        if not .textIs(s)
            raise .errorAt("expected '" + s + "', got '" + .peek().text + "'")
        .advance()

    def isEol(): bool
        branch .peek().kind
            on TokenKind.eol
                return true
            else
                return false

    def isIndent(): bool
        branch .peek().kind
            on TokenKind.indent
                return true
            else
                return false

    def isDedent(): bool
        branch .peek().kind
            on TokenKind.dedent
                return true
            else
                return false

    def isEof(): bool
        branch .peek().kind
            on TokenKind.eof
                return true
            else
                return false

    # -- Error recovery --------------------------------------------------------

    def isRecoveryStarter(kind: Token.TokenKind): bool
        branch kind
            on TokenKind.kw_use
                return true
            on TokenKind.kw_namespace
                return true
            on TokenKind.kw_class
                return true
            on TokenKind.kw_interface
                return true
            on TokenKind.kw_struct
                return true
            on TokenKind.kw_def
                return true
            on TokenKind.kw_extend
                return true
            on TokenKind.at_id
                return true
            on TokenKind.kw_sig
                return true
            on TokenKind.kw_type
                return true
            on TokenKind.kw_public
                return true
            on TokenKind.kw_private
                return true
            on TokenKind.kw_export
                return true
            on TokenKind.kw_static
                return true
            on TokenKind.kw_extern
                return true
            else
                return false

    def skipToTopLevelBoundary()
        # Guarantee forward progress. If we re-enter already sitting on a top-level
        # boundary — the decl that just FAILED started here (e.g. `readonly struct …`,
        # a leading non-`static` modifier) — we must step past it, or parseModule's
        # retry loop re-parses the same token forever (infinite hang). Mirrors the
        # bootstrap's findRecoveryBoundary(pos + error_pos + 1): recovery always
        # resumes strictly AFTER the failure point.
        if not .isEof() and .peek().col == 1 and .isRecoveryStarter(.peek().kind)
            .advance()
        while not .isEof()
            const t = .peek()
            if t.col == 1 and .isRecoveryStarter(t.kind)
                return
            .advance()

    def tryParseTopDeclInto()
        .expr_depth = 0    # BUG-200: clear any depth leaked by a prior recovered error
        .collected_decls.add(.parseTopDecl()?)
    catch |e|
        .parse_errors.add(zig"_error_ctx.message")
        .skipToTopLevelBoundary()

    def isStmtKeyword(text: str): bool
        # Returns true when `text` starts a statement (not a branch pattern).
        # Used to distinguish `on Pat, print "stmt"` from `on Pat1, Pat2`.
        var kws = "|print|return|pass|break|continue|raise|assert|var|const|if|while|for|branch|try|with|allocate|filter|"
        var needle = "|" + text + "|"
        return needle in kws

    def isId(): bool
        branch .peek().kind
            on TokenKind.id
                return true
            else
                return false

    def isSizedTypeName(): bool
        branch .peek().kind
            on TokenKind.int_size
                return true
            on TokenKind.uint_size
                return true
            on TokenKind.float_size
                return true
            else
                return false

    # Type keywords used: expressions (e.g., List(int), HashMap(str, bool))
    def isTypeKeyword(): bool
        branch .peek().kind
            on TokenKind.kw_int
                return true
            on TokenKind.kw_uint
                return true
            on TokenKind.kw_float
                return true
            on TokenKind.kw_bool
                return true
            on TokenKind.kw_char
                return true
            else
                return false

    def isOpenCall(): bool
        branch .peek().kind
            on TokenKind.open_call
                return true
            else
                return false

    def isOpenCallAt(offset: int): bool
        branch .peekAt(offset).kind
            on TokenKind.open_call
                return true
            else
                return false

    def isIntLit(): bool
        branch .peek().kind
            on TokenKind.integer_lit
                return true
            # Hex. The LEXER has emitted these three since forever and the AST's
            # ExprIntLit has carried an IntBase field to receive them, but no parser rule
            # consumed one -- so `0xFF` was `error: unexpected expression token: '0xFF'`
            # in the selfhost while the bootstrap grammar has had `Atom -> hex_lit` all
            # along. No corpus file uses a hex literal, which is why `divergence` never
            # reported the gap.
            on TokenKind.hex_lit
                return true
            on TokenKind.hex_lit_unsign
                return true
            on TokenKind.hex_lit_explicit
                return true
            else
                return false

    def isFloatLit(): bool
        branch .peek().kind
            on TokenKind.float_lit
                return true
            else
                return false

    def isAtLbracket(): bool
        branch .peek().kind
            on TokenKind.at_lbracket
                return true
            else
                return false

    def isStringSingle(): bool
        branch .peek().kind
            on TokenKind.string_single
                return true
            else
                return false

    def isStringDouble(): bool
        branch .peek().kind
            on TokenKind.string_double
                return true
            else
                return false

    def isCharLit(): bool
        branch .peek().kind
            on TokenKind.char_lit_single
                return true
            on TokenKind.char_lit_double
                return true
            else
                return false

    def isZigLit(): bool
        branch .peek().kind
            on TokenKind.zig_single
                return true
            on TokenKind.zig_double
                return true
            else
                return false

    def isRawString(): bool
        branch .peek().kind
            on TokenKind.string_raw_single
                return true
            on TokenKind.string_raw_double
                return true
            else
                return false

    def isDocString(): bool
        branch .peek().kind
            on TokenKind.doc_string_line
                return true
            else
                return false

    def isStringStart(): bool
        branch .peek().kind
            on TokenKind.string_start_single
                return true
            on TokenKind.string_start_double
                return true
            else
                return false

    def isStringPart(): bool
        branch .peek().kind
            on TokenKind.string_part_single
                return true
            on TokenKind.string_part_double
                return true
            else
                return false

    def isStringStop(): bool
        branch .peek().kind
            on TokenKind.string_stop_single
                return true
            on TokenKind.string_stop_double
                return true
            else
                return false

    def isRcurlySpecial(): bool
        branch .peek().kind
            on TokenKind.rcurly_special
                return true
            else
                return false

    def isKwOld(): bool
        branch .peek().kind
            on TokenKind.kw_old
                return true
            else
                return false

    def isKwResult(): bool
        branch .peek().kind
            on TokenKind.kw_result
                return true
            else
                return false

    def isStringPartFormat(): bool
        branch .peek().kind
            on TokenKind.string_part_format
                return true
            else
                return false

    def skipEol()
        while .isEol()
            .advance()

    def eatId(): str throws
        if not .isId()
            raise .errorAt("expected identifier, got '" + .peek().text + "'")
        const text = .peek().text
        .advance()
        return text

    def eatName(): str throws
        if .isId()
            const text = .peek().text
            .advance()
            return text
        else if .isOpenCall()
            const text = .peek().text
            .advance()
            return text
        raise .errorAt("expected name, got '" + .peek().text + "'")

    # Consume a type-name token - accepts identifiers AND built-in type keywords
    # (int, bool, str, float, char, void) which the lexer promotes to keywords.
    # Also handles generic types like List(str) and HashMap(str,int) by consuming
    # the open_call token and its argument list.
    def eatTypeName(): str throws
        # Handle ^Type (heap-pointer prefix)
        if .textIs("^")
            .advance()
            var inner: str = .eatTypeName()?
            var sb: StringBuilder = StringBuilder()
            sb.append("^")
            sb.append(inner)
            return sb.build()
        # Function-pointer type (inline `sig`): `def(T1, T2): R` — encode using the
        # generic-type string form `__fnptr(T1,T2,R)` (return type LAST).  This reuses
        # the AstBuilder's bracket-aware generic decoder, so nested fn-types
        # (`def(def(int): int): int`) round-trip via balanced parens.
        if .textIs("def")
            .advance()
            .expectText("(")?
            var fn_params: List(str) = List(str)()
            while not .textIs(")")
                if .textIs(",")
                    .advance()
                else
                    fn_params.add(.eatTypeName()?)
            .expectText(")")?
            .expectText(":")?
            var fn_ret: str = .eatTypeName()?
            var sbf: StringBuilder = StringBuilder()
            sbf.append("__fnptr(")
            for fp in fn_params
                sbf.append(fp)
                sbf.append(",")
            sbf.append(fn_ret)
            sbf.append(")")
            return sbf.build()
        const text = .peek().text
        if .isOpenCall()
            .advance()  # consume "Name("
            # Detect value-parameterized alias: first arg is a literal or unary minus
            var first_kind = .peek().kind
            var is_value_args = first_kind == TokenKind.integer_lit or first_kind == TokenKind.float_lit or first_kind == TokenKind.string_single or first_kind == TokenKind.string_double or first_kind == TokenKind.minus
            if is_value_args
                # Parse as value-arg alias reference: encode as "__alias__Name__args__a,b,c"
                var value_args: List(str) = List(str)()
                while not .textIs(")")
                    if .textIs(",")
                        .advance()
                    else
                        var neg = ""
                        if .textIs("-")
                            .advance()
                            neg = "-"
                        value_args.add(neg + .peek().text)
                        .advance()
                .expectText(")")?
                var sb_a: StringBuilder = StringBuilder()
                sb_a.append("__alias__")
                sb_a.append(text)
                sb_a.append("__args__")
                var first_a = true
                for va in value_args
                    if not first_a
                        sb_a.append(",")
                    sb_a.append(va)
                    first_a = false
                return sb_a.build()
            # Generic type: "List(str)" — type args
            var args: List(str) = List(str)()
            while not .textIs(")")
                if .textIs(",")
                    .advance()
                else
                    var arg: str = .eatTypeName()?
                    if .textIs("?")
                        .advance()
                        arg = arg + "?"
                    args.add(arg)
            .expectText(")")?
            # Build "Name(arg1,arg2,...)" using StringBuilder to avoid cross-module str type issue
            var sb: StringBuilder = StringBuilder()
            sb.append(text)
            sb.append("(")
            var first = true
            for arg in args
                if not first
                    sb.append(",")
                sb.append(arg)
                first = false
            sb.append(")")
            return sb.build()
        if .isId()
            # `String` was an undocumented alias of `str` until 2026-09-15 (Sean: "nuke
            # String"). One spelling for one type; refuse it here, the chokepoint every
            # type annotation and `extend` target passes through, naming the rewrite.
            # (`String.X` is left alone: that is a module qualifier, not the alias.)
            if text == "String" and .peekAt(1).text != "."
                raise .errorAt("`String` is not a Zebra type: write `str`. (`String` was an alias of `str`; it was removed so the type has one spelling.)")
            .advance()
            # Handle dotted names: Token.Token, Ast.Module, etc.
            if .textIs(".")
                .advance()
                var rest: str = .eatTypeName()?
                var sb: StringBuilder = StringBuilder()
                sb.append(text)
                sb.append(".")
                sb.append(rest)
                return sb.build()
            return text
        # Accept built-in type keywords by text
        if text == "int" or text == "uint" or text == "float"
            .advance()
            # Check for sized variant: int(N), uint(N), float(N)
            if .textIs("(")
                .advance()
                var n_str = .peek().text
                .advance()
                .expectText(")")?
                var sb2: StringBuilder = StringBuilder()
                sb2.append(text)
                sb2.append("(")
                sb2.append(n_str)
                sb2.append(")")
                return sb2.build()
            return text
        if text == "bool" or text == "str" or text == "char" or text == "void" or text == "any"
            .advance()
            return text
        # Sized numeric type names: int8/int16/int32/int64, uint8/…, float32/float64
        if .isSizedTypeName()
            .advance()
            return text
        # `byte` alias (lexed: plain id above, so this branch handles it if
        # the lexer ever splits it out).
        if text == "byte"
            .advance()
            return text
        # (`same` was accepted here until 2026-09-16 -- freed; it is an identifier now.)
        # Tuple type: (T1, T2, ...) → "(T1,T2,...)"
        if text == "("
            .advance()
            var sb: StringBuilder = StringBuilder()
            sb.append("(")
            var first = true
            while not .textIs(")")
                if .textIs(",")
                    .advance()
                else
                    if not first
                        sb.append(",")
                    var elem: str = .eatTypeName()?
                    if .textIs("?")
                        .advance()
                        elem = elem + "?"
                    sb.append(elem)
                    first = false
            .expectText(")")?
            sb.append(")")
            return sb.build()
        raise .errorAt("expected type name, got '" + text + "'")

    # -- Module ----------------------------------------------------------------

    def parseModule(): PNode throws
        .skipEol()
        while not .isEof()
            .tryParseTopDeclInto()
            .skipEol()
        if .parse_errors.len > 0
            var msg: str = .parse_errors.at(0)
            var i: int = 1
            while i < .parse_errors.len
                msg = msg + "\n" + .parse_errors.at(i)
                i = i + 1
            raise msg
        return PNode.module_(PModule(.collected_decls))

    # -- Top-level declarations ------------------------------------------------

    def parseTopDecl(): PNode throws
        # `@directive` annotation — @reflectable, @profile, @once, @tag, @derive recognized.
        # Consume the directive and apply it to the immediately-following decl.
        var pending_reflectable: bool = false
        var pending_profile: bool = false
        var pending_once: bool = false
        var pending_pure: bool = false
        var pending_node_export: bool = false
        var pending_derive_debug: bool = false
        var pending_derive_eq: bool = false
        var pending_derive_hash: bool = false
        var pending_tags: List(str) = List(str)()
        var pending_export_sym: str? = nil
        var saw_directive: bool = true
        while saw_directive
            saw_directive = false
            branch .peek().kind
                on TokenKind.at_id
                    const dtext = .peek().text
                    .advance()
                    if dtext == "@reflectable"
                        .skipEol()
                        pending_reflectable = true
                    else if dtext == "@profile"
                        .skipEol()
                        pending_profile = true
                    else if dtext == "@once"
                        .skipEol()
                        pending_once = true
                    else if dtext == "@pure"
                        .skipEol()
                        pending_pure = true
                    else if dtext == "@node_export"
                        .skipEol()
                        pending_node_export = true
                    else if dtext == "@tag"
                        # Parse optional @tag("str", ...) argument list.
                        if .textIs("(")
                            .advance()
                            while not .textIs(")")
                                if .textIs(",")
                                    .advance()
                                else
                                    const raw_tag: str = .peek().text
                                    .advance()
                                    var tag_val: str = raw_tag
                                    if raw_tag.len >= 2
                                        tag_val = raw_tag.substring(1, raw_tag.len - 1)
                                    pending_tags.add(tag_val)
                            .expectText(")")?
                        .skipEol()
                    else if dtext == "@derive"
                        # Parse @derive(Debug, Eq, Hash) — extract identifier names.
                        if .textIs("(")
                            .advance()
                            while not .textIs(")")
                                if .textIs(",")
                                    .advance()
                                else
                                    const trait_name: str = .peek().text
                                    .advance()
                                    if trait_name == "Debug"
                                        pending_derive_debug = true
                                    else if trait_name == "Eq"
                                        pending_derive_eq = true
                                    else if trait_name == "Hash"
                                        pending_derive_hash = true
                                    else
                                        sys.errln("warning: unknown @derive trait '" + trait_name + "'; ignored")
                            .expectText(")")?
                        .skipEol()
                    else if dtext == "@export"
                        var export_raw: str = ""
                        if .textIs("(")
                            .advance()
                            if not .textIs(")")
                                export_raw = .peek().text
                                .advance()
                                if export_raw.len >= 2
                                    export_raw = export_raw.substring(1, export_raw.len - 1)
                            .expectText(")")?
                        .skipEol()
                        if export_raw != ""
                            pending_export_sym = export_raw
                    else
                        .skipEol()
                        sys.errln("warning: unknown @-directive '" + dtext + "'; ignored")
                    saw_directive = true
                else
                    saw_directive = false
        if .textIs("use")
            return .parseUseDecl()?
        else if .textIs("namespace")
            return .parseNamespaceDecl()?
        else if .textIs("class")
            return .parseClassDecl(pending_reflectable, pending_export_sym)?
        else if .textIs("struct")
            return .parseStructDecl(pending_reflectable, pending_derive_debug, pending_derive_eq, pending_derive_hash)?
        else if .textIs("interface")
            return .parseInterfaceDecl()?
        else if .textIs("mixin")
            return .parseMixinDecl()?
        else if .textIs("extend")
            return .parseExtendDecl()?
        else if .textIs("union")
            return .parseUnionDecl()?
        else if .textIs("enum")
            return .parseEnumDecl()?
        else if .textIs("sig")
            return .parseSigDecl()?
        else if .textIs("type")
            return .parseTypeAliasDecl()?
        else if .textIs("static")
            .advance()
            if .textIs("extern")
                .advance()
                if not .textIs("def")
                    raise .errorAt("`extern` may only precede `def` — extern declarations name a foreign FUNCTION")
                return .parseMethodDecl(true, false, false, pending_profile, pending_once, pending_tags, false, pending_pure, pending_node_export, true)?
            return .parseMethodDecl(true, false, false, pending_profile, pending_once, pending_tags, false, pending_pure, pending_node_export)?
        else if .textIs("export")
            .advance()
            return .parseMethodDecl(false, false, false, pending_profile, pending_once, pending_tags, true, pending_pure, pending_node_export)?
        # BUG-258: `extern def f(...)` declares a foreign symbol. Only `def` may
        # follow — `extern var` / `extern class` are out of scope, and out of
        # scope has to mean REFUSED. A silently-dropped modifier is exactly how
        # this bug existed in the first place: the bootstrap accepted `extern def`,
        # discarded the flag, and emitted something that compiled.
        else if .textIs("extern")
            .advance()
            if not .textIs("def")
                raise .errorAt("`extern` may only precede `def` — extern declarations name a foreign FUNCTION")
            return .parseMethodDecl(false, false, false, pending_profile, pending_once, pending_tags, false, pending_pure, pending_node_export, true)?
        else if .textIs("def")
            return .parseMethodDecl(false, false, false, pending_profile, pending_once, pending_tags, false, pending_pure, pending_node_export)?
        else if .textIs("var")
            return .parseVarStmt(false)?
        else if .textIs("const")
            return .parseVarStmt(true)?
        raise .unexpectedTopLevelMsg()

    def parseNamespaceDecl(): PNode throws
        .expectText("namespace")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        var name: str = .eatId()?
        while .textIs(".")
            .advance()
            name = name + "."
            name = name + .eatId()?
        .skipEol()
        var decls = List(PNode)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                decls.add(.parseTopDecl()?)
                .skipEol()
            if .isDedent()
                .advance()
        return PNode.namespace_decl(PNamespace(name, decls, _dl, _dc))

    def parseUseDecl(): PNode throws
        .expectText("use")?
        var path: str = .eatId()?
        while .textIs(".")
            .advance()
            path = path + "."
            path = path + .eatId()?
        var exposed = List(str)()
        if .textIs("exposing")
            .advance()
            exposed.add(.eatId()?)
            while .textIs(",")
                .advance()
                exposed.add(.eatId()?)
        .skipEol()
        return PNode.use_(PUse(path, exposed))

    def parseClassDecl(is_reflectable: bool, export_sym: str? = nil): PNode throws
        .expectText("class")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        var name: str = ""
        var type_params = List(str)()
        # Generic class: name is tokenized: open_call because `(` follows immediately.
        if .isOpenCall()
            name = .peek().text
            .advance()
            if not .textIs(")")
                var tp0: str = .eatId()?
                # Optional `where T implements Interface` constraint clause. Carried as
                # "T|Interface(T)" in the PNode (AstBuilder splits it into TypeParam.
                # constraint); the checker enforces it at instantiation (2026-09-16).
                if .textIs("where")
                    tp0 = tp0 + "|" + .parseConstraintClause(tp0)?
                type_params.add(tp0)
                while .textIs(",")
                    .advance()
                    var tpn: str = .eatId()?
                    if .textIs("where")
                        tpn = tpn + "|" + .parseConstraintClause(tpn)?
                    type_params.add(tpn)
            .expectText(")")?
        else
            name = .eatId()?
        var ifaces = List(str)()
        # BUG-404: `class Dog extends Animal` / `class Dog(Animal)` / `class Dog: Animal`
        # -- the inheritance a newcomer reaches for. Zebra has none (QUICKSTART §17):
        # say so and name the two things that exist, instead of "unexpected top-level
        # token: 'extends'" one line later.
        if .textIs("extends") or .textIs("inherits") or (.textIs(":") and .peekAt(1).kind is TokenKind.id)
            raise .errorAt("Zebra has no class inheritance: share behaviour with a mixin (`class Dog adds Barking`) and get polymorphism from an interface (`class Dog implements Animal`) -- QUICKSTART §5, §16, §17")
        if .textIs("implements")
            .advance()
            # `implements Comparable(Score)` (2026-09-16): a type name, which may carry
            # type arguments; eatTypeName reads either form.
            ifaces.add(.eatTypeName()?)
            while .textIs(",")
                .advance()
                ifaces.add(.eatTypeName()?)
        var mixins = List(str)()
        if .textIs("adds")
            .advance()
            mixins.add(.eatId()?)
            while .textIs(",")
                .advance()
                mixins.add(.eatId()?)
        .refuseTrailingColon()?
        .skipEol()
        var members = List(PNode)()
        var invs = List(PNode)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                if .textIs("static")
                    .advance()
                    .skipEol()
                    if .isIndent()
                        .advance()
                        while not .isDedent() and not .isEof()
                            .skipEol()
                            if .isDedent()
                                break
                            members.add(.parseMemberDecl(true)?)
                        if .isDedent()
                            .advance()
                    else
                        # Inline `static def foo()` — no indented block
                        members.add(.parseMemberDecl(true)?)
                else
                    var pd = .parseMemberDecl(false)?
                    if pd is PNode.invariant_decl as inv_exprs
                        var inv_list: List(PNode) = inv_exprs
                        for inv_e in inv_list
                            invs.add(inv_e)
                    else
                        members.add(pd)
            if .isDedent()
                .advance()
        return PNode.class_(PClass(name, type_params, ifaces, mixins, members, invs, is_reflectable, false, false, false, export_sym, _dl, _dc))

    def parseEnumDecl(): PNode throws
        .expectText("enum")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        # B10: backed enum `enum Status(int)` — the tokenizer merges `Status(`
        # into an open_call token (like a generic class name), so the backing
        # type sits inside the parens.  Plain `enum Color` is a bare id.
        var name: str = ""
        var base: str = ""
        if .isOpenCall()
            name = .peek().text
            .advance()
            base = .peek().text
            .advance()
            .expectText(")")?
        else
            name = .eatId()?
        .skipEol()
        var variants = List(str)()
        var values = List(List(PNode))()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                variants.add(.eatId()?)
                # B10: optional `= Expr` explicit value for this variant.
                var vlist = List(PNode)()
                if .textIs("=")
                    .advance()
                    vlist.add(.parseExpr()?)
                values.add(vlist)
                .skipEol()
            if .isDedent()
                .advance()
        if variants.len == 0
            raise .errorAt("enum '" + name + "' must have at least one variant")
        return PNode.enum_(PEnum(name, variants, base, values, _dl, _dc))

    def parseStructDecl(is_reflectable: bool, is_derive_debug: bool = false, is_derive_eq: bool = false, is_derive_hash: bool = false): PNode throws
        .expectText("struct")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        const name = .eatId()?
        .skipEol()
        var members = List(PNode)()
        var invs = List(PNode)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                var pd = .parseMemberDecl(false)?
                if pd is PNode.invariant_decl as inv_exprs
                    var inv_list: List(PNode) = inv_exprs
                    for inv_e in inv_list
                        invs.add(inv_e)
                else
                    members.add(pd)
            if .isDedent()
                .advance()
        var ifaces = List(str)()
        var type_params = List(str)()
        return PNode.struct_(PClass(name, type_params, ifaces, List(str)(), members, invs, is_reflectable, is_derive_debug, is_derive_eq, is_derive_hash, nil, _dl, _dc))

    # `where T implements Comparable(T)` (QUICKSTART §17: the full form, naming the
    # parameter again). Returns the interface text, e.g. "Comparable(T)". Parsed and
    # IGNORED from the day it was written until 2026-09-16; the checker enforces it now.
    def parseConstraintClause(tp: str): str throws
        .expectText("where")?
        const again: str = .eatId()?
        if again != tp
            raise .errorAt("`where` must name the type parameter it constrains: write `" + tp + " where " + tp + " implements ...`")
        .expectText("implements")?
        return .eatTypeName()?

    def parseInterfaceDecl(): PNode throws
        .expectText("interface")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        var name: str = ""
        var type_params = List(str)()
        # Generic interface (2026-09-16): `interface Comparable(T)` -- the name is
        # tokenized as open_call because `(` follows it, exactly as for a generic class.
        if .isOpenCall()
            name = .peek().text
            .advance()
            if not .textIs(")")
                type_params.add(.eatId()?)
                while .textIs(",")
                    .advance()
                    type_params.add(.eatId()?)
            .expectText(")")?
        else
            name = .eatId()?
        var ifaces = List(str)()
        if .textIs("implements")
            .advance()
            ifaces.add(.eatTypeName()?)
            while .textIs(",")
                .advance()
                ifaces.add(.eatTypeName()?)
        .skipEol()
        var members = List(PNode)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                members.add(.parseMemberDecl(false)?)
            if .isDedent()
                .advance()
        # Empty bodies are legal only for struct/class (marker types). interface/
        # mixin/extend/enum require a body — matches the grammar and the bootstrap.
        if members.len == 0
            raise .errorAt("interface '" + name + "' must have a body")
        return PNode.interface_(PClass(name, type_params, ifaces, List(str)(), members, List(PNode)(), false, false, false, false, nil, _dl, _dc))

    def parseMixinDecl(): PNode throws
        .expectText("mixin")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        const name = .eatId()?
        .skipEol()
        var members = List(PNode)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                members.add(.parseMemberDecl(false)?)
            if .isDedent()
                .advance()
        var empty_str_list = List(str)()
        if members.len == 0
            raise .errorAt("mixin '" + name + "' must have a body")
        return PNode.mixin_(PClass(name, empty_str_list, empty_str_list, empty_str_list, members, List(PNode)(), false, false, false, false, nil, _dl, _dc))

    def parseExtendDecl(): PNode throws
        .expectText("extend")?
        const target_name = .eatTypeName()?
        .skipEol()
        var members = List(PNode)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                members.add(.parseMemberDecl(false)?)
            if .isDedent()
                .advance()
        if members.len == 0
            raise .errorAt("extend '" + target_name + "' must have a body")
        return PNode.extend_(PExtend(target_name, members))

    def parseUnionDecl(): PNode throws
        .expectText("union")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        const name = .eatId()?
        .skipEol()
        var variants = List(PUnionVariant)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                const vname_line = .peek().line
                const vname_col = .peek().col
                const vname = .eatId()?
                var vtype: str = ""
                if .textIs(":")
                    .advance()
                    # Handle ^Type prefix
                    if .textIs("^")
                        .advance()
                        vtype = "^" + .eatTypeName()?
                    else
                        vtype = .eatTypeName()?
                    if .textIs("?")
                        .advance()
                        vtype = vtype + "?"
                .skipEol()
                variants.add(PUnionVariant(vname, vtype, vname_line, vname_col))
            if .isDedent()
                .advance()
        return PNode.union_decl(PUnionDecl(name, variants, _dl, _dc))

    def parseSigDecl(): PNode throws
        .expectText("sig")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        var name = ""
        var has_params = false
        if .isOpenCall()
            name = .peek().text
            .advance()
            has_params = true
        else
            name = .eatId()?
        var params = List(PParam)()
        if has_params
            while not .textIs(")")
                if .textIs(",")
                    .advance()
                else
                    const pname = .eatId()?
                    var ptype = ""
                    if .textIs(":")
                        .advance()
                        ptype = .eatTypeName()?
                    var pdefault = List(PNode)()
                    if .textIs("=")
                        .advance()
                        pdefault.add(.parseExpr()?)
                    params.add(PParam(pname, ptype, pdefault))
            .expectText(")")?
        var return_type = ""
        if .textIs(":")
            .advance()
            return_type = .eatTypeName()?
        .skipEol()
        return PNode.sig_(PSig(name, params, return_type, _dl, _dc))

    def parseTypeAliasDecl(): PNode throws
        .expectText("type")?
        var params: List(PParam) = List(PParam)()
        var name: str = ""
        if .isOpenCall()
            # parametric: type Bounded(lo: int, hi: int) = ...
            # open_call token has the name; consume it then parse typed params
            name = .peek().text
            .advance()
            while not .textIs(")")
                if .textIs(",")
                    .advance()
                else
                    const pname = .eatId()?
                    .expectText(":")?
                    const ptype = .eatTypeName()?
                    params.add(PParam(pname, ptype, List(PNode)()))
            .expectText(")")?
        else
            name = .eatId()?
        .expectText("=")?
        const base_type = .eatTypeName()?
        var constraint: List(PNode) = List(PNode)()
        if .textIs("where")
            .advance()
            constraint.add(.parseExpr()?)
        .skipEol()
        return PNode.type_alias_(PTypeAlias(name, params, base_type, constraint))

    # -- Member declarations ---------------------------------------------------

    def parseMemberDecl(is_static: bool): PNode throws
        var pending_private: bool = false
        var pending_public: bool = false
        if .textIs("private") or .textIs("public")
            if .textIs("private")
                pending_private = true
            else
                pending_public = true
            .advance()
        var pending_profile: bool = false
        var pending_once: bool = false
        var pending_pure: bool = false
        var pending_node_export: bool = false
        var pending_tags: List(str) = List(str)()
        while .peek().kind == TokenKind.at_id
            const dtext = .peek().text
            .advance()
            if dtext == "@profile"
                .skipEol()
                pending_profile = true
            else if dtext == "@once"
                .skipEol()
                pending_once = true
            else if dtext == "@pure"
                .skipEol()
                pending_pure = true
            else if dtext == "@node_export"
                .skipEol()
                pending_node_export = true
            else if dtext == "@tag"
                if .textIs("(")
                    .advance()
                    while not .textIs(")")
                        if .textIs(",")
                            .advance()
                        else
                            const raw_tag: str = .peek().text
                            .advance()
                            var tag_val: str = raw_tag
                            if raw_tag.len >= 2
                                tag_val = raw_tag.substring(1, raw_tag.len - 1)
                            pending_tags.add(tag_val)
                    .expectText(")")?
                .skipEol()
            else
                .skipEol()
                sys.errln("warning: unknown member @-directive '" + dtext + "'; ignored")
        if .textIs("def")
            return .parseMethodDecl(is_static, pending_private, pending_public, pending_profile, pending_once, pending_tags, false, pending_pure, pending_node_export)?
        else if .textIs("var")
            return .parseDeclField(false, is_static, pending_private, pending_public)?
        else if .textIs("const")
            return .parseDeclField(true, is_static, pending_private, pending_public)?
        else if .textIs("cue")
            if .peekAt(1).text == "init"
                return .parseDeclInit()?
            # `cue toString()`, `cue equals(other: T)`, ... -- a method the COMPILER calls on
            # a language event (print, ==, HashMap keys, <, for-in), the way it calls init
            # on construction. Zebra's dunders (2026-09-16, Sean). The set is closed:
            var cue_base: str = .peekAt(1).text
            if not (("|" + cue_base + "|") in CUE_NAMES)
                raise .errorAt("unknown cue '" + cue_base + "': the cues are init, toString, equals, hash, compare, iter, next (a method the compiler calls for you; anything else is a `def`)")
            return .parseMethodDecl(is_static, pending_private, pending_public, false, false, List(str)(), false, false, false, false, true)?
        else if .textIs("invariant")
            return .parseInvariantDecl()?
        raise .errorAt("unexpected member: '" + .peek().text + "'")

    def parseInvariantDecl(): PNode throws
        .advance()
        .skipEol()
        var expr_nodes = List(PNode)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                expr_nodes.add(.parseExpr()?)
                .skipEol()
            if .isDedent()
                .advance()
        return PNode.invariant_decl(expr_nodes)

    def parseDeclField(is_const: bool, is_static: bool, is_private: bool, is_public: bool): PNode throws
        if is_const
            .expectText("const")?
        else
            .expectText("var")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        const name = .eatId()?
        var type_name: str = ""
        if .textIs(":")
            .advance()
            type_name = .eatTypeName()?
            if .textIs("?")
                .advance()
                type_name = type_name + "?"
        var init_expr = List(PNode)()
        if .textIs("=")
            .advance()
            init_expr.add(.parseExpr()?)
        .skipEol()
        return PNode.field_(PField(name, type_name, is_const, is_static, is_private, is_public, init_expr, _dl, _dc))

    def parseDeclInit(): PNode throws
        .expectText("cue")?
        if .peek().text != "init"
            raise .errorAt("expected 'init' after cue, got '" + .peek().text + "'")
        var was_open_call = .isOpenCall()
        .advance()
        if not was_open_call
            .expectText("(")?
        var params = List(PParam)()
        while not .textIs(")")
            if .textIs(",")
                .advance()
            else
                const pname = .eatId()?
                var ptype = ""
                if .textIs(":")
                    .advance()
                    ptype = .eatTypeName()?
                    if .textIs("?")
                        .advance()
                        ptype = ptype + "?"
                var pdefault = List(PNode)()
                if .textIs("=")
                    .advance()
                    pdefault.add(.parseExpr()?)
                params.add(PParam(pname, ptype, pdefault))
        .expectText(")")?
        .skipEol()
        var stmts = List(PNode)()
        if .isIndent()
            stmts = .parseBlock()?
        return PNode.init_(PInit(params, stmts))

    def parseMethodDecl(is_static: bool, is_private: bool, is_public: bool, is_profile: bool, is_once: bool, tags: List(str), is_export: bool, is_pure: bool = false, is_node_export: bool = false, is_extern: bool = false, is_cue: bool = false): PNode throws
        const line = .peek().line
        const col = .peek().col
        if is_cue
            .expectText("cue")?
        else
            .expectText("def")?
        const _dl = .peek().line
        const _dc = .peek().col - 1
        var name = ""
        var has_params = false
        var params = List(PParam)()
        var type_params = List(str)()
        if .isOpenCall()
            name = .peek().text
            .advance()
            has_params = true
        else
            name = .eatId()?
        if has_params
            # Speculative check: is the first group type params?
            # def identity(T)(x: T): T — first group has only bare identifiers,
            # and the closing `)` is followed by `(`.
            # If so, collect them as type_params and parse value params from the second `(`.
            var saved_pos = .pos
            var all_bare = true
            while not .textIs(")") and not .isEol() and not .isEof()
                if .textIs(",")
                    .advance()
                else if .isId() and .peekAt(1).text != ":" and .peekAt(1).text != "="
                    type_params.add(.peek().text)
                    .advance()
                else
                    all_bare = false
                    break
            if all_bare and .textIs(")") and .peekAt(1).text == "("
                # Confirmed type-param group: consume `)` and the opening `(` of value params.
                .advance()
                .advance()
            else
                # Not type params — restore position and clear any tentative entries.
                .pos = saved_pos
                type_params = List(str)()
            # Parse value params (either from the second `(` or the only `(`).
            while not .textIs(")")
                if .textIs(",")
                    .advance()
                else
                    const pname = .eatId()?
                    var ptype = ""
                    if .textIs(":")
                        .advance()
                        ptype = .eatTypeName()?
                        if .textIs("?")
                            .advance()
                            ptype = ptype + "?"
                    var pdefault = List(PNode)()
                    if .textIs("=")
                        .advance()
                        pdefault.add(.parseExpr()?)
                    params.add(PParam(pname, ptype, pdefault))
            .expectText(")")?
        var return_type = ""
        # BUG-380 sibling: `def f(x: int) -> int` is the Python/Rust arrow; the
        # top-level loop reported it as an unexpected declaration token.
        if has_params and .textIs("->")
            raise .errorAt("the return type is written with a colon, `def f(x: int): int`, not `->` (QUICKSTART §1.5)")
        # BUG-112: only allow return-type annotation when method has parens.
        # `def name: T` no-paren shorthand is non-canonical; use `def name(): T`.
        if has_params
            .refuseTrailingColon()?
        if has_params and .textIs(":")
            .advance()
            return_type = .eatTypeName()?
            if .textIs("?")
                .advance()
                return_type = return_type + "?"
        var throws_ = false
        if .textIs("throws")
            .advance()
            throws_ = true
        .skipEol()
        var stmts = List(PNode)()
        if .isIndent()
            stmts = .parseBlock()?
            # Method-level catch: optional catch clause(s) after the body block.
            if .textIs("catch")
                var catch_binding = ""
                .advance()
                if .textIs("|")
                    .advance()
                    catch_binding = .eatId()?
                    .expectText("|")?
                else if .peek().kind is TokenKind.id
                    # `catch e` (no pipes) is the shape every other language teaches;
                    # "expected indent, got 'e'" said nothing about pipes.
                    raise .errorAt("the catch binding goes between pipes: `catch |" + .peek().text + "|`")
                .skipEol()
                var catch_stmts = .parseBlock()?
                var wrapped = List(PNode)()
                wrapped.add(PNode.stmt_try_catch(PTryCatch(stmts, catch_binding, catch_stmts, line, col)))
                stmts = wrapped
        # BUG-270: `int` / `uint` are AMBIGUOUS across a C boundary, so refuse them in an
        # extern signature rather than guessing.
        #
        # Zebra's `int` is 64-bit; C's `int` is 32-bit on every platform Zebra targets.
        # `extern def f(): int` against a C `int` therefore reads 64 bits of a 32-bit
        # return — it LINKS CLEANLY and silently corrupts, and a negative value is where
        # it shows first. docs/extern_ffi_design.md §4 named this "the single most likely
        # way to get a green build and a wrong program" before anything could catch it.
        #
        # NOT silently remapped to c_int, and that is the whole judgement here: `int`
        # is genuinely correct when the C side is `long long` / `int64_t`, so a remap
        # would be wrong about half the time and wrong SILENTLY — trading one invisible
        # corruption for another. The author knows which they meant; the compiler does
        # not. So it asks, at the declaration, and names both answers.
        #
        # Checked in the PARSER because that is where the declaration is, and a
        # declaration should be checked when it is written rather than discovered broken
        # at the call site (the UNGIT "nothing ambient" test — a refusal must name the
        # reason AND the fix).
        if is_extern
            var ext_bad: str = ""
            var ext_where: str = ""
            if return_type == "int" or return_type == "uint"
                ext_bad = return_type
                ext_where = "return type"
            for ep in params
                if ext_bad == ""
                    if ep.type_name == "int" or ep.type_name == "uint"
                        ext_bad = ep.type_name
                        ext_where = "parameter `" + ep.name + "`"
            if ext_bad != ""
                var ext_sized: str = "int64"
                if ext_bad == "uint"
                    ext_sized = "uint64"
                var ext_small: str = "int32"
                if ext_bad == "uint"
                    ext_small = "uint32"
                raise .errorAt("`" + ext_bad + "` is ambiguous in an `extern` signature (" + ext_where + " of `" + name + "`): Zebra's `" + ext_bad + "` is 64-bit, C's `int` is 32-bit. Write `" + ext_small + "` for C `int`, or `" + ext_sized + "` for C `long long`/`int64_t`.")
            # BUG-269, the same family as the `int` check above and refused the same way.
            # Zebra's `str` is a SLICE (pointer + length), which has no C representation
            # at all — so `extern def f(): str` emitted `extern fn f() []const u8` and
            # `zig` answered `return type '[]const u8' not allowed in function with
            # calling convention 'x86_64_win'`, against generated code carrying no Zebra
            # source location.
            #
            # REFUSED rather than silently remapped to `[*:0]const u8`. A remap would
            # make the DECLARATION legal and then hand the caller a null-terminated
            # pointer while the type system still called it a `str`, which is the
            # silent-corruption shape BUG-270 exists to prevent — worse than the compile
            # error it replaces.
            #
            # `^byte` is the fix and it is a REAL one, verified rather than assumed:
            # it lowers to `*u8`, and `zig` accepts that in a C-ABI signature where it
            # rejects the slice. Span it back to a Zebra `str` with
            # `zig"std.mem.span(...)"` at the call site.
            var ext_str: str = ""
            var ext_str_where: str = ""
            if return_type == "str"
                ext_str = return_type
                ext_str_where = "return type"
            for sp in params
                if ext_str == ""
                    if sp.type_name == "str"
                        ext_str = sp.type_name
                        ext_str_where = "parameter `" + sp.name + "`"
            if ext_str != ""
                raise .errorAt("`" + ext_str + "` is not a C-ABI type in an `extern` signature (" + ext_str_where + " of `" + name + "`): Zebra's `" + ext_str + "` is a slice (pointer + length) and C has no such type. Write `^byte` for a C `char*`, then `zig\"std.mem.span(...)\"` to read it back as a str.")
        return PNode.method_(PMethod(name, is_static, is_private, is_public, throws_, params, return_type, stmts, is_profile, is_once, tags, is_export, type_params, is_pure, is_node_export, _dl, _dc, is_extern, is_cue))

    # -- Block and statements --------------------------------------------------

    def parseBlock(): List(PNode) throws
        if not .isIndent()
            raise .errorAt("expected indent, got '" + .peek().text + "'")
        .advance()
        var stmts = List(PNode)()
        while not .isDedent() and not .isEof()
            .skipEol()
            if .isDedent()
                break
            stmts.add(.parseStmt()?)
        if .isDedent()
            .advance()
        return stmts

    def parseStmt(): PNode throws
        # A `try` BLOCK (Python / Java shape) does not exist in Zebra, and `try` is an
        # ordinary identifier since 2026-08-13 -- so `try` alone on a line parsed as an
        # expression statement and died on the indented block after it with "unexpected
        # end of input while parsing an expression", pointing at the NEXT statement.
        # Name the real problem and the three forms that exist (QUICKSTART §12).
        if .textIs("try") and (.peekAt(1).kind is TokenKind.eol or .peekAt(1).text == ":")
            raise .errorAt("there is no `try` block in Zebra: propagate with `expr?`, take a fallback inline with `expr catch value`, or add a method-level `catch |e|` clause after the body (QUICKSTART §12)")
        if .textIs("catch") and (.peekAt(1).kind is TokenKind.eol or .peekAt(1).kind is TokenKind.id)
            raise .errorAt("a `catch` clause belongs after the method body, at the same indent as `def`, as `catch |e|`; there is no statement-level catch (QUICKSTART §12)")
        if .textIs("pass")
            .advance()
            .skipEol()
            return PNode.stmt_pass()
        else if .textIs("break")
            .advance()
            .skipEol()
            return PNode.stmt_break()
        else if .textIs("continue")
            .advance()
            .skipEol()
            return PNode.stmt_continue()
        else if .textIs("return")
            return .parseReturnStmt()?
        else if .textIs("if")
            return .parseIfStmt()?
        else if .textIs("while")
            return .parseWhileStmt()?
        else if .textIs("for")
            return .parseForInStmt()?
        else if .textIs("var")
            if .peekAt(1).text == "{" or .peekAt(1).text == "("
                return .parseDestructStmt()?
            return .parseVarStmt(false)?
        else if .textIs("const")
            return .parseVarStmt(true)?
        else if .textIs("assert")
            return .parseAssertStmt()?
        else if .textIs("raise")
            return .parseRaiseStmt()?

        else if .textIs("branch")
            return .parseBranchStmt()?
        else if .textIs("allocate")
            return .parseAllocateStmt()?
        else if .textIs("with")
            return .parseWithStmt()?
        else if .textIs("using")
            return .parseInStmt()?
        else if .textIs("require")
            return .parseContractStmt("require")?
        else if .textIs("ensure")
            return .parseContractStmt("ensure")?
        else if .textIs("print")
            # print is a function: `print( ExprList )` (statement form dropped, #220)
            .advance()
            .expectText("(")?
            const args = .parseCallArgs()?
            .skipEol()
            return PNode.stmt_print(args)
        else
            return .parseExprOrAssignStmt()?

    def parseReturnStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("return")?
        var value = List(PNode)()
        if not .isEol() and not .isEof() and not .isDedent()
            value.add(.parseExpr()?)
        .skipEol()
        return PNode.stmt_return(PReturn(value, line, col))

    def parseIfStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("if")?
        const cond_expr = .parseExpr()?
        # Optional capture binding: `if x is Variant as name`
        var capture_name: str? = nil
        if .textIs("as")
            .advance()
            capture_name = .eatId()?
        if .isEol()
            # Block form (existing)
            .skipEol()
            const then_stmts = .parseBlock()?
            var else_stmts = List(PNode)()
            if .textIs("else")
                .advance()
                if .textIs("if")
                    else_stmts.add(.parseIfStmt()?)
                else
                    .refuseTrailingColon()?
                    .skipEol()
                    else_stmts = .parseBlock()?
            var cond_list = List(PNode)()
            cond_list.add(cond_expr)
            var pif = PIf(cond_list, then_stmts, else_stmts, line, col)
            pif.is_capture = capture_name
            return PNode.stmt_if(pif)
        else
            # Inline form: `if cond: stmt` — colon required, capture not supported
            if capture_name != nil
                raise .errorAt("inline if does not support capture binding; use block form")
            .refuseTrailingColon()?
            .expectText(":")?
            var then_stmts = List(PNode)()
            then_stmts.add(.parseStmt()?)
            var else_stmts = List(PNode)()
            if .textIs("else")
                .advance()
                if .textIs("if")
                    else_stmts.add(.parseIfStmt()?)
                else
                    .expectText(":")?
                    else_stmts.add(.parseStmt()?)
            var cond_list = List(PNode)()
            cond_list.add(cond_expr)
            return PNode.stmt_if(PIf(cond_list, then_stmts, else_stmts, line, col))

    def parseWhileStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("while")?
        # Bind-and-filter form: `while var id = InitExpr, CondExpr eol Block`.
        # Desugared here to `while true { var id = InitExpr; if not CondExpr: break; body }`
        # so the existing StmtWhile/StmtVar/StmtIf/StmtBreak codegen path carries it.
        if .textIs("var")
            .advance()
            const bind_name = .eatId()?
            .expectText("=")?
            const init_expr_pn = .parseExpr()?
            .expectText(",")?
            const filter_expr_pn = .parseExpr()?
            .skipEol()
            var body_stmts: List(PNode) = .parseBlock()?
            var init_list = List(PNode)()
            init_list.add(init_expr_pn)
            var filter_operand = List(PNode)()
            filter_operand.add(filter_expr_pn)
            var if_cond_list = List(PNode)()
            if_cond_list.add(PNode.expr_unary(PUnary("not", filter_operand)))
            var break_list = List(PNode)()
            break_list.add(PNode.stmt_break())
            var empty_else = List(PNode)()
            var wrapped = List(PNode)()
            # Synthesized by the for-in desugaring: no source column to report.
            wrapped.add(PNode.stmt_var(PVar(bind_name, false, "", init_list, line, 0)))
            wrapped.add(PNode.stmt_if(PIf(if_cond_list, break_list, empty_else, line, col)))
            for bs in body_stmts
                wrapped.add(bs)
            var true_cond = List(PNode)()
            # Synthesized, not written by the user: no position, and never the
            # subject of a diagnostic. BUG-288 keeps 0 here deliberately.
            true_cond.add(PNode.expr_bool(PBoolLit(true, 0, 0)))
            return PNode.stmt_while(PWhile(true_cond, wrapped, line, col))
        const cond_expr = .parseExpr()?
        .refuseTrailingColon()?
        .skipEol()
        const stmts = .parseBlock()?
        var cond_list = List(PNode)()
        cond_list.add(cond_expr)
        return PNode.stmt_while(PWhile(cond_list, stmts, line, col))

    def parseContractStmt(kw: str): PNode throws
        .advance()
        .skipEol()
        var stmts: List(PNode) = .parseBlock()?
        # Unwrap stmt_expr wrappers to get raw expression PNodes.
        var expr_nodes = List(PNode)()
        for s in stmts
            branch s
                on PNode.stmt_expr as inner
                    expr_nodes.add(inner)
                else
                    expr_nodes.add(s)
        if kw == "ensure"
            return PNode.stmt_ensure(expr_nodes)
        return PNode.stmt_require(expr_nodes)

    def parseAllocateStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("allocate")?
        const source_expr = .parseExpr()?
        .skipEol()
        const stmts = .parseBlock()?
        var source_list = List(PNode)()
        source_list.add(source_expr)
        return PNode.stmt_allocate(PAllocate(source_list, stmts, false, line, col))

    def parseWithStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("with")?
        const target_expr = .parseExpr()?
        .skipEol()
        const stmts = .parseBlock()?
        var target_list = List(PNode)()
        target_list.add(target_expr)
        return PNode.stmt_with(PWith(target_list, stmts, line, col))

    def parseInStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("using")?
        const expr = .parseExpr()?
        .skipEol()
        const stmts = .parseBlock()?
        var expr_list = List(PNode)()
        expr_list.add(expr)
        return PNode.stmt_in(PInScope(expr_list, stmts, line, col))

    # parseGuardStmt was here until 2026-09-15: `guard` is an ordinary identifier now
    # (it was `if not cond` with a second spelling). PNode.stmt_guard / Stmt.guard_ and
    # their walker arms are dead code until bootstrap_sunset.md Step 4 removes them.

    def parseForInStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("for")?
        var var_names = List(str)()
        var_names.add(.eatId()?)
        while .textIs(",")
            .advance()
            var_names.add(.eatId()?)
        .expectText("in")?
        const start_expr = .parseExpr()?
        # Numeric range: for i in lo : hi [:step].  `..` is an alias for `:`
        # (BUG-165/F9): the bootstrap parses `for i in a..b`, so both spellings
        # must lower to the same i64 for_num counter loop in both compilers.
        .refuseTrailingColon()?
        if .textIs(":") or .textIs("..")
            var range_is_dotdot = .textIs("..")
            .advance()
            const stop_expr = .parseExpr()?
            var step_list = List(PNode)()
            # No step after `..` — the bootstrap rejects `a..b : step` too.
            if .textIs(":") and not range_is_dotdot
                .advance()
                step_list.add(.parseExpr()?)
            .skipEol()
            const stmts = .parseBlock()?
            var else_stmts = List(PNode)()
            if .textIs("else")
                .advance()
                .skipEol()
                else_stmts = .parseBlock()?
            var start_list = List(PNode)()
            start_list.add(start_expr)
            var stop_list = List(PNode)()
            stop_list.add(stop_expr)
            return PNode.stmt_for_num(PForNum(var_names.at(0), start_list, stop_list, step_list, stmts, else_stmts, line, col))
        # Iterator form: for i in expr [if filter]
        var filter_list = List(PNode)()
        if .textIs("if")
            .advance()
            filter_list.add(.parseExpr()?)
        .skipEol()
        const stmts = .parseBlock()?
        var else_stmts = List(PNode)()
        if .textIs("else")
            .advance()
            .skipEol()
            else_stmts = .parseBlock()?
        var iter_list = List(PNode)()
        iter_list.add(start_expr)
        return PNode.stmt_for_in(PForIn(var_names, iter_list, filter_list, stmts, else_stmts, line, col))

    # `var {x, y} = expr` (struct destructure) or `var (x, y) = expr` (tuple)
    def parseDestructStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("var")?
        var is_struct: bool = false
        var close: str = ")"
        if .textIs("{")
            is_struct = true
            close = "}"
            .advance()
        else
            .expectText("(")?
        var names = List(str)()
        names.add(.eatId()?)
        while .textIs(",")
            .advance()
            names.add(.eatId()?)
        .expectText(close)?
        .expectText("=")?
        var init_expr = List(PNode)()
        init_expr.add(.parseExpr()?)
        .skipEol()
        return PNode.stmt_destruct(PDestruct(names, init_expr, is_struct, line, col))

    def parseVarStmt(is_const: bool): PNode throws
        const line = .peek().line
        const col = .peek().col
        if is_const
            .expectText("const")?
        else
            .expectText("var")?
        const name = .eatId()?
        var type_name: str = ""
        if .textIs(":")
            .advance()
            type_name = .eatTypeName()?
            if .textIs("?")
                .advance()
                type_name = type_name + "?"
        var init_expr = List(PNode)()
        if .textIs("=")
            .advance()
            # Check for statement-body lambda: var x = def(params) eol indent [capture] stmts dedent
            if .textIs("def") and .peekAt(1).text == "("
                # Could be expression-body (def(x) = expr) or statement-body (def(x) eol ...)
                # Parse the def(params) [as T] prefix, then decide
                var lam = .parseLambdaPrefix()?
                if .textIs("=")
                    # Expression-body: def(params) = expr
                    .advance()
                    var body_expr = List(PNode)()
                    body_expr.add(.parseExpr()?)
                    .skipEol()
                    var lambda_node = PLambda(lam.params, lam.return_type, List(PCaptureVar)(), body_expr, List(PNode)())
                    init_expr.add(PNode.expr_lambda(lambda_node))
                    return PNode.stmt_var(PVar(name, is_const, type_name, init_expr, line, col))
                # Statement-body: def(params) eol indent [capture] stmts dedent
                .skipEol()
                if not .isIndent()
                    raise .errorAt("expected indent after lambda header")
                .advance()
                var captures = List(PCaptureVar)()
                if .textIs("capture")
                    captures = .parseCaptureBlock()?
                var body_stmts = List(PNode)()
                while not .isDedent() and not .isEof()
                    .skipEol()
                    if .isDedent()
                        break
                    body_stmts.add(.parseStmt()?)
                if .isDedent()
                    .advance()
                var lambda_node = PLambda(lam.params, lam.return_type, captures, List(PNode)(), body_stmts)
                init_expr.add(PNode.expr_lambda(lambda_node))
                return PNode.stmt_var(PVar(name, is_const, type_name, init_expr, line, col))
            init_expr.add(.parseExpr()?)
            # BUG-405: `var t = 5 if total > 3 else 0` -- the Python conditional
            # expression. The `if` opened a new (inline) if-statement on the same
            # line and died on the `else` with "expected ':', got 'else'".
            if .textIs("if") and .peek().line == line
                raise .errorAt("there is no `a if c else b` in Zebra: the conditional expression is the call form `if(c, a, b)` (QUICKSTART §1.5)")
        .skipEol()
        return PNode.stmt_var(PVar(name, is_const, type_name, init_expr, line, col))

    def parseAssertStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("assert")?
        const cond_expr = .parseExpr()?
        var cond_list = List(PNode)()
        cond_list.add(cond_expr)
        var msg_list = List(PNode)()
        if .textIs(",")
            .advance()
            msg_list.add(.parseExpr()?)
        .skipEol()
        return PNode.stmt_assert(PAssert(cond_list, msg_list, line, col))

    # parseAssertCmpStmt / parseAssertUnaryStmt were here until 2026-09-15: the four
    # assert_* keywords are ordinary identifiers now; `assert a == b` prints both operands
    # itself. PNode.stmt_assert_* / Stmt.assert_cmp / assert_unary and their walker arms
    # are dead code until bootstrap_sunset.md Step 4 removes them.

    def parseRaiseStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("raise")?
        var msg_list = List(PNode)()
        if not .isEol() and not .isEof() and not .isDedent()
            msg_list.add(.parseExpr()?)
            if .textIs(",")
                .advance()
                msg_list.add(.parseExpr()?)
        .skipEol()
        return PNode.stmt_raise(PRaise(msg_list, line, col))

    def parseBranchStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        .expectText("branch")?
        const subject = .parseExpr()?
        .skipEol()
        var arms = List(PBranchOn)()
        var else_stmts = List(PNode)()
        if .isIndent()
            .advance()
            while not .isDedent() and not .isEof()
                .skipEol()
                if .isDedent()
                    break
                if .textIs("on")
                    const on_line = .peek().line
                    const on_col = .peek().col
                    .advance()
                    # Parse pattern list: one or more comma-separated patterns.
                    # After a comma, if the next token is a statement keyword (print, return,
                    # pass, etc.), stop eating patterns — it's the inline-body comma form.
                    var patterns = List(str)()
                    var struct_pat_node = List(PNode)()
                    # Detect struct field pattern: UppercaseName followed by "(" means
                    # `on TypeName(field: val, ...)` — or `on Mod.TypeName(field: val, ...)`.
                    var first_tok: str = .peek().text
                    var first_char_upper = first_tok != "" and first_tok[0] >= c'A' and first_tok[0] <= c'Z'
                    var is_dotted = peekAt(1).text == "." and .isOpenCallAt(2)
                    # open_call token text is "TypeName(" — first char is always the type name's
                    # first char, so [0] uppercase check works. If tokenizer ever strips the "(",
                    # this needs to change to peekAt(2).text (without the index).
                    var dotted_upper = is_dotted and peekAt(2).text != "" and peekAt(2).text[0] >= c'A' and peekAt(2).text[0] <= c'Z'
                    if (first_char_upper and .isOpenCall()) or (is_dotted and dotted_upper)
                        struct_pat_node.add(.parseExpr()?)
                    else
                        patterns.add(.eatBranchPattern()?)
                        while .textIs(",")
                            # If the token after the comma is a stmt keyword (print, return,
                            # pass, …), stop — it's the inline-body comma form, not a second pattern.
                            if .isStmtKeyword(.peekAt(1).text)
                                break
                            .advance()
                            patterns.add(.eatBranchPattern()?)
                    # If we stopped at "," due to isStmtKeyword (inline-body comma form),
                    # consume the comma before parsing the inline body statement.
                    var inline_comma = false
                    if .textIs(",")
                        .advance()
                        inline_comma = true
                    var binding = ""
                    if not inline_comma
                        if .textIs("as")
                            .advance()
                            binding = .eatId()?
                    var filter_cond = List(PNode)()
                    if not inline_comma
                        if .textIs("if")
                            .advance()
                            filter_cond.add(.parseExpr()?)
                    .skipEol()
                    var stmts = List(PNode)()
                    if .isIndent()
                        stmts = .parseBlock()?
                    else if not .isEol() and not .isDedent() and not .isEof()
                        # Inline single-line arm: `on Pattern  return value` or `on Pat, stmt`
                        stmts.add(.parseStmt()?)
                    var arm = PBranchOn(patterns, binding, filter_cond, stmts, on_line, on_col)
                    arm.struct_pat_node = struct_pat_node
                    arms.add(arm)
                else if .textIs("else")
                    .advance()
                    if .textIs(",")
                        # Inline else form: `else, stmt`
                        .advance()
                        else_stmts.add(.parseStmt()?)
                    else
                        .skipEol()
                        if .isIndent()
                            else_stmts = .parseBlock()?
                else
                    break
            if .isDedent()
                .advance()
        var subj_list = List(PNode)()
        subj_list.add(subject)
        return PNode.stmt_branch(PBranch(subj_list, arms, else_stmts, line, col))

    def eatBranchPattern(): str throws
        # Collect pattern text: e.g., "TokenKind.eol", "PNode.class_", "c'0'..c'9'"
        var sb: StringBuilder = StringBuilder()
        # First token
        sb.append(.peek().text)
        .advance()
        # Continue with . member access and range operators
        var going: bool = true
        while going
            if .textIs(".")
                sb.append(".")
                .advance()
                sb.append(.peek().text)
                .advance()
            else if .textIs("..")
                sb.append("..")
                .advance()
                sb.append(.peek().text)
                .advance()
            else
                going = false
        return sb.build()

    def parseExprOrAssignStmt(): PNode throws
        const line = .peek().line
        const col = .peek().col
        const target_expr = .parseExpr()?
        var op: str = ""
        if .textIs("=")
            op = "="
        else if .textIs("+=")
            op = "+="
        else if .textIs("-=")
            op = "-="
        else if .textIs("*=")
            op = "*="
        # The other NINE. Every one already had a lexer token, an AssignOp variant and an
        # assignOpStr mapping; only this chain was missing, so `x ^= 1` was
        # `error: unexpected expression token: '^='` while the bootstrap accepted it.
        # Same lexer-yes/parser-no shape as `~` (BUG-256) and the binary bitwise operators.
        # Order does not matter here: the LEXER has already produced one token per operator,
        # so `//=` cannot be mis-read as `/=`.
        else if .textIs("/=")
            op = "/="
        else if .textIs("//=")
            op = "//="
        else if .textIs("%=")
            op = "%="
        else if .textIs("**=")
            op = "**="
        else if .textIs("&=")
            op = "&="
        else if .textIs("|=")
            op = "|="
        else if .textIs("^=")
            op = "^="
        else if .textIs("<<=")
            op = "<<="
        else if .textIs(">>=")
            op = ">>="
        if .textIs("<-") or .textIs("<<-")
            # §28d (2026-07-02): `<<-` = arena deep copy-out, `<-` = channel
            # send/recv only.  One stmt kind; `deep` records the token and
            # genCopyOut enforces the pairing.
            var co_deep = .textIs("<<-")
            .advance()
            const value_expr = .parseExpr()?
            .skipEol()
            var tgt = List(PNode)()
            tgt.add(target_expr)
            var val = List(PNode)()
            val.add(value_expr)
            return PNode.stmt_copy_out(PCopyOut(tgt, val, co_deep, line, col))
        if op != ""
            .advance()
            const value_expr = .parseExpr()?
            .skipEol()
            var tgt = List(PNode)()
            tgt.add(target_expr)
            var val = List(PNode)()
            val.add(value_expr)
            return PNode.stmt_assign(PAssign(op, tgt, val, line, col))
        .skipEol()
        return PNode.stmt_expr(target_expr)

    # -- Expressions -----------------------------------------------------------
    # Precedence (lowest - highest):
    # or - and - not - comparison - add/sub - mul/div - unary - - postfix - atom

    def parseExpr(): PNode throws
        # BUG-200: bound expression nesting depth. Every recursively-nested expression
        # (`((((…))))`, deep call/index args, nested data) re-enters here, so this is
        # the choke point that stops a runaway recursive descent from overflowing the
        # stack — the parser's *and* the downstream tree-walks' — with a clean
        # diagnostic instead of a segfault. Limit 200 is ~4x above any realistic nesting
        # and leaves a wide stack margin below the observed crash (~450 deep). On the
        # success path we decrement; the error path leaks by 1 but is cleared by the
        # per-top-level reset in tryParseTopDeclInto (parse errors recover to a
        # top-level boundary). NOTE residual: extreme single-operator FLAT chains
        # (`1+1+…` ~1000 terms) build depth via the iterative binary loops without
        # re-entering here — a pure fuzzer artifact, not realistic code; unfixed.
        .expr_depth += 1
        if .expr_depth > 200
            raise .errorAt("expression nested too deeply (max nesting depth 200)")
        var result = .parsePipeline()?
        .expr_depth -= 1
        return result

    def parsePipeline(): PNode throws
        var left = .parseOr()?
        while .textIs("->")
            .advance()
            const rhs = .parseOr()?
            var lhs_list = List(PNode)()
            lhs_list.add(left)
            var rhs_list = List(PNode)()
            rhs_list.add(rhs)
            left = PNode.expr_pipeline(PPipeline(lhs_list, rhs_list))
        while .textIs("catch")
            .advance()
            var binding = ""
            if .textIs("|")
                .advance()
                binding = .eatId()?
                .expectText("|")?
            const fallback = .parseOr()?
            var base = List(PNode)()
            base.add(left)
            var fb = List(PNode)()
            fb.add(fallback)
            left = PNode.expr_catch(PCatch(base, binding, fb))
        return left

    def parseOr(): PNode throws
        var left = .parseAnd()?
        while .textIs("or") or .textIs("orelse")
            const is_orelse = .textIs("orelse")
            .advance()
            const right = .parseAnd()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            if is_orelse
                left = PNode.expr_orelse(POrelse(l, r))
            else
                left = PNode.expr_binary(PBinary("or", l, r))
        return left

    def parseAnd(): PNode throws
        var left = .parseNot()?
        while .textIs("and")
            .advance()
            const right = .parseNot()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            left = PNode.expr_binary(PBinary("and", l, r))
        return left

    def parseNot(): PNode throws
        if .textIs("not")
            .advance()
            const operand = .parseNot()?
            var ops = List(PNode)()
            ops.add(operand)
            return PNode.expr_unary(PUnary("not", ops))
        return .parseComparison()?

    def parseComparison(): PNode throws
        var left = .parseBitOr()?
        var op: str = ""
        if .textIs("==")
            op = "=="
        else if .textIs("!=") or .textIs("<>")
            op = "!="
        else if .textIs("<=")
            op = "<="
        else if .textIs(">=")
            op = ">="
        else if .textIs("<")
            op = "<"
        else if .textIs(">")
            op = ">"
        else if .textIs("in")
            op = "in"
        else if .textIs("is")
            # Consume "is"; peek for `not` to handle `x is not T` → not (x is T)
            .advance()
            var negate_is = false
            if .textIs("not")
                .advance()
                negate_is = true
            const right = .parseBitOr()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            var tc_node = PNode.expr_binary(PBinary("is", l, r))
            if negate_is
                var inner = List(PNode)()
                inner.add(tc_node)
                return PNode.expr_unary(PUnary("not", inner))
            return tc_node
        else if .textIs("not")
            # Peek ahead: `not in` is a binary operator
            # Consume "not", then expect "in"
            .advance()
            if not .textIs("in")
                raise .errorAt("expected 'in' after 'not' in comparison")
            .advance()
            const right = .parseBitOr()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            # Desugar to `not (left in right)`
            var inner = List(PNode)()
            var lc = List(PNode)()
            lc.add(left)
            var rc = List(PNode)()
            rc.add(right)
            inner.add(PNode.expr_binary(PBinary("in", lc, rc)))
            return PNode.expr_unary(PUnary("not", inner))
        if op != ""
            .advance()
            const right = .parseBitOr()?
            # Check if this is a chainable comparison op that may start/extend a chain.
            # Chainable: == != < <= > >=  (not: is, in)
            if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
                # Peek for another comparison op to decide if this is a chain.
                var next_op: str = ""
                if .textIs("==")
                    next_op = "=="
                else if .textIs("!=") or .textIs("<>")
                    next_op = "!="
                else if .textIs("<=")
                    next_op = "<="
                else if .textIs(">=")
                    next_op = ">="
                else if .textIs("<")
                    next_op = "<"
                else if .textIs(">")
                    next_op = ">"
                if next_op != ""
                    # Build a chain: accumulate operands + ops until no more chainable ops.
                    var chain_ops: List(str) = List(str)()
                    var chain_nodes: List(PNode) = List(PNode)()
                    chain_ops.add(op)
                    chain_nodes.add(left)
                    chain_nodes.add(right)
                    while next_op != ""
                        chain_ops.add(next_op)
                        .advance()
                        const next_right = .parseBitOr()?
                        chain_nodes.add(next_right)
                        next_op = ""
                        if .textIs("==")
                            next_op = "=="
                        else if .textIs("!=") or .textIs("<>")
                            next_op = "!="
                        else if .textIs("<=")
                            next_op = "<="
                        else if .textIs(">=")
                            next_op = ">="
                        else if .textIs("<")
                            next_op = "<"
                        else if .textIs(">")
                            next_op = ">"
                    return PNode.expr_chained_cmp(PChainedCmp(chain_ops, chain_nodes))
            # Non-chaining or single comparison: plain binary.
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            return PNode.expr_binary(PBinary(op, l, r))
        return left

    # ── Bitwise: | then ^ then & , binding TIGHTER than comparison ────────────────
    #
    # PYTHON's precedence, deliberately, not C's. In C `&` binds looser than `==`, so
    # `x & 1 == 0` silently means `x & (1 == 0)`; Ritchie called that a mistake (`&`
    # predated `&&`). Python binds these tighter than comparison, so `x & 1 == 0` is
    # `(x & 1) == 0` -- what the reader expects.
    #
    # `|` cannot collide with the `catch |e|` binding: parseCatch consumes BOTH bars
    # itself before calling parseOr, and the grammar gives `|` no other delimiter role.
    def parseBitOr(): PNode throws
        var left = .parseBitXor()?
        while .textIs("|")
            const op = .peek().text
            .advance()
            const right = .parseBitXor()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            left = PNode.expr_binary(PBinary(op, l, r))
        return left

    # `^` is also the heap-indirection TYPE prefix (`^T`). No ambiguity: a TypeRef reaches
    # expression position only as the postfix `expr to T`, so prefix-^ and infix-^ never
    # compete for one slot -- the same way unary and binary `-` coexist.
    def parseBitXor(): PNode throws
        var left = .parseBitAnd()?
        while .textIs("^")
            const op = .peek().text
            .advance()
            const right = .parseBitAnd()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            left = PNode.expr_binary(PBinary(op, l, r))
        return left

    def parseBitAnd(): PNode throws
        var left = .parseShift()?
        while .textIs("&")
            const op = .peek().text
            .advance()
            const right = .parseShift()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            left = PNode.expr_binary(PBinary(op, l, r))
        return left

    # Shifts bind TIGHTER than `&` and LOOSER than `+` -- Python's order.
    #
    # `a << -b` NEEDS THE SPACE. `<<-` is the arena deep-copy-out token and out-munches
    # `<<` in the lexer, so `a<<-b` lexes as `a` `<<-` `b`. The tokenizer has carried a
    # note about that trade since §28d; this is the first construct that can hit it.
    def parseShift(): PNode throws
        var left = .parseAddSub()?
        while .textIs("<<") or .textIs(">>")
            const op = .peek().text
            .advance()
            const right = .parseAddSub()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            left = PNode.expr_binary(PBinary(op, l, r))
        return left

    def parseAddSub(): PNode throws
        var left = .parseMulDiv()?
        while .textIs("+") or .textIs("-")
            const op = .peek().text
            .advance()
            const right = .parseMulDiv()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            left = PNode.expr_binary(PBinary(op, l, r))
        return left

    def parseMulDiv(): PNode throws
        var left = .parseUnary()?
        while .textIs("*") or .textIs("/") or .textIs("%")
            const op = .peek().text
            .advance()
            const right = .parseUnary()?
            var l = List(PNode)()
            l.add(left)
            var r = List(PNode)()
            r.add(right)
            left = PNode.expr_binary(PBinary(op, l, r))
        return left

    def parseUnary(): PNode throws
        if .textIs("-")
            .advance()
            const operand = .parseUnary()?
            var ops = List(PNode)()
            ops.add(operand)
            return PNode.expr_unary(PUnary("-", ops))
        if .textIs("~")
            # BUG-256. Bitwise NOT. The grammar has had `Expr8 → tilde Expr9` all along, the
            # LEXER already produces the token (the old error named it: "unexpected
            # expression token: '~'"), CodeGen.zbr:10537 already emits it, and the bootstrap
            # accepts `~a` and emits valid Zig. Only THIS function and toUnaryOp were
            # missing, so `~` was a language feature the SHIPPING compiler could not parse.
            #
            # Found 2026-08-04 by checking the generated grammar before writing a probe --
            # exactly the habit adopted after three probes that session were written in
            # syntax Zebra does not have. Here the grammar said the syntax was real and the
            # compiler disagreed, which is the opposite and more interesting failure.
            .advance()
            const bnot_operand = .parseUnary()?
            var bnot_ops = List(PNode)()
            bnot_ops.add(bnot_operand)
            return PNode.expr_unary(PUnary("~", bnot_ops))
        if .isKwOld()
            # `old expr` — pre-call value in `ensure` contracts (Expr8 → kw_old Expr9).
            .advance()
            const operand = .parseUnary()?
            var ops = List(PNode)()
            ops.add(operand)
            return PNode.expr_unary(PUnary("old", ops))
        return .parsePostfix()?

    def parsePostfix(): PNode throws
        var expr = .parseAtom()?
        var going: bool = true
        while going
            if .textIs(".")
                .advance()
                if .isOpenCall()
                    # expr.method(args)
                    const mname = .peek().text
                    const mline = .peek().line
                    const mcol = .peek().col
                    .advance()
                    const args = .parseCallArgs()?
                    var base = List(PNode)()
                    base.add(expr)
                    var callee = List(PNode)()
                    callee.add(PNode.expr_member(PMember(base, mname, mline, mcol)))
                    expr = PNode.expr_call(PCall(callee, args))
                else if .textIs("to") and .peekAt(1).text == "("
                    # expr.to(args) — `to` is a keyword (used in `expr to T`,
                    # `expr!`, `expr to?`) but is also allowed as a method
                    # name in postfix call position so numeric range loops
                    # `for i in 0.to(5)` and similar reads naturally.
                    const to_line = .peek().line
                    const to_col = .peek().col
                    .advance()  # consume "to"
                    .advance()  # consume "("
                    const args = .parseCallArgs()?
                    var base = List(PNode)()
                    base.add(expr)
                    var callee = List(PNode)()
                    callee.add(PNode.expr_member(PMember(base, "to", to_line, to_col)))
                    expr = PNode.expr_call(PCall(callee, args))
                else if .isIntLit()
                    # expr.0 — tuple element access by numeric index
                    const field = .peek().text
                    const tline = .peek().line
                    const tcol = .peek().col
                    .advance()
                    var base = List(PNode)()
                    base.add(expr)
                    expr = PNode.expr_member(PMember(base, field, tline, tcol))
                else
                    # expr.field
                    const fline = .peek().line
                    const fcol = .peek().col
                    const field = .eatId()?
                    var base = List(PNode)()
                    base.add(expr)
                    expr = PNode.expr_member(PMember(base, field, fline, fcol))
            else if .textIs("?.")
                # Optional chain: expr?.member or expr?.method(args)
                .advance()  # consume "?."
                if .isOpenCall()
                    # expr?.method(args) — method call
                    const mname = .peek().text
                    .advance()
                    const cargs = .parseCallArgs()?
                    var base_list = List(PNode)()
                    base_list.add(expr)
                    expr = PNode.expr_opt_chain(POptChain(base_list, mname, true, cargs))
                else
                    # expr?.field — member access
                    const field = .eatId()?
                    var base_list = List(PNode)()
                    base_list.add(expr)
                    var empty_args = List(PNode)()
                    expr = PNode.expr_opt_chain(POptChain(base_list, field, false, empty_args))
            else if .textIs("?")
                .advance()
                expr = PNode.expr_try(expr)
            else if .textIs("!")
                # x! force-unwrap / non-nil assert
                .advance()
                expr = PNode.expr_to_bang(expr)
            else if .textIs("except")
                # struct update, two forms:
                #   block:  expr except \n field = value \n ...
                #   inline: expr except field = value, field = value   (B12)
                .advance()
                var fields = List(PExceptField)()
                if .isEol() or .isIndent()
                    # Block form: an eol then an indented field list.
                    .skipEol()
                    if .isIndent()
                        .advance()
                        while not .isDedent() and not .isEof()
                            .skipEol()
                            if .isDedent()
                                break
                            const fname = .eatId()?
                            .expectText("=")?
                            const fval = .parseExpr()?
                            .skipEol()
                            var vlist = List(PNode)()
                            vlist.add(fval)
                            fields.add(PExceptField(fname, vlist))
                        if .isDedent()
                            .advance()
                else
                    # B12 inline form: comma-separated `field = value` on one line.
                    var more = true
                    while more
                        const fname2 = .eatId()?
                        .expectText("=")?
                        const fval2 = .parseExpr()?
                        var vlist2 = List(PNode)()
                        vlist2.add(fval2)
                        fields.add(PExceptField(fname2, vlist2))
                        if .textIs(",")
                            .advance()
                        else
                            more = false
                var base_list = List(PNode)()
                base_list.add(expr)
                expr = PNode.expr_except(PExcept(base_list, fields))
            else if .textIs("[")
                # index or slice: expr[index] or expr[start..stop]
                .advance()
                const first = .parseExpr()?
                if .textIs("..")
                    # slice: expr[start..stop]
                    .advance()
                    const stop_expr = .parseExpr()?
                    .expectText("]")?
                    var obj = List(PNode)()
                    obj.add(expr)
                    var start_list = List(PNode)()
                    start_list.add(first)
                    var stop_list = List(PNode)()
                    stop_list.add(stop_expr)
                    expr = PNode.expr_slice(PSlice(obj, start_list, stop_list))
                else
                    .expectText("]")?
                    var obj = List(PNode)()
                    obj.add(expr)
                    var idx_list = List(PNode)()
                    idx_list.add(first)
                    expr = PNode.expr_index(PIndex(obj, idx_list))
            else if .textIs("(")
                # chained call: expr(args) — handles List(T)(), HashMap(K,V)(), etc.
                .advance()  # consume the "("
                const args = .parseCallArgs()?
                var callee = List(PNode)()
                callee.add(expr)
                expr = PNode.expr_call(PCall(callee, args))
            else
                going = false
        return expr

    def parseAtom(): PNode throws
        if .textIs("true")
            const t_line = .peek().line
            const t_col = .peek().col
            .advance()
            return PNode.expr_bool(PBoolLit(true, t_line, t_col))
        else if .textIs("false")
            const f_line = .peek().line
            const f_col = .peek().col
            .advance()
            return PNode.expr_bool(PBoolLit(false, f_line, f_col))
        else if .textIs("nil")
            const nil_line = .peek().line
            const nil_col = .peek().col
            .advance()
            return PNode.expr_nil(PPos(nil_line, nil_col))
        else if .textIs("this")
            const this_line = .peek().line
            const this_col = .peek().col
            .advance()
            return PNode.expr_this(PPos(this_line, this_col))
        else if .isKwResult()
            const res_line = .peek().line
            const res_col = .peek().col
            .advance()
            return PNode.expr_result(PPos(res_line, res_col))
        else if .isIntLit()
            const text = .peek().text
            const int_line = .peek().line
            const int_col = .peek().col
            .advance()
            return PNode.expr_int(PLit(text, int_line, int_col))
        else if .isFloatLit()
            const text = .peek().text
            const flt_line = .peek().line
            const flt_col = .peek().col
            .advance()
            return PNode.expr_float(PLit(text, flt_line, flt_col))
        else if .isStringStart()
            return .parseStringInterp()?
        else if .isStringSingle() or .isStringDouble()
            const text = .peek().text
            const s_line = .peek().line
            const s_col = .peek().col
            .advance()
            return PNode.expr_str(PLit(text, s_line, s_col))
        else if .isCharLit()
            const text = .peek().text
            const ch_line = .peek().line
            const ch_col = .peek().col
            .advance()
            return PNode.expr_char(PLit(text, ch_line, ch_col))
        else if .isZigLit()
            const text = .peek().text
            const zl_line = .peek().line
            const zl_col = .peek().col
            .advance()
            return PNode.expr_zig_lit(PZigLit(text, zl_line, zl_col))
        else if .isRawString()
            const text = .peek().text
            const rs_line = .peek().line
            const rs_col = .peek().col
            .advance()
            return PNode.expr_raw_str(PLit(text, rs_line, rs_col))
        else if .isDocString()
            const text = .peek().text
            const ds_line = .peek().line
            const ds_col = .peek().col
            .advance()
            return PNode.expr_str(PLit(text, ds_line, ds_col))
        else if .isAtLbracket()
            # @[elem, elem, ...] — array literal
            .advance()
            var elems = List(PNode)()
            if not .textIs("]")
                elems.add(.parseExpr()?)
                while .textIs(",")
                    .advance()
                    if .textIs("]")
                        break
                    elems.add(.parseExpr()?)
            .expectText("]")?
            return PNode.expr_array_lit(PArrayLit(elems))
        else if .textIs("[")
            # [elem, elem, ...] — list literal.  Lowers in codegen to a
            # labeled-block that builds std.ArrayList(T).  At the parse
            # level we share PArrayLit's shape with the @[...] form.
            .advance()
            var elems = List(PNode)()
            if not .textIs("]")
                elems.add(.parseExpr()?)
                while .textIs(",")
                    .advance()
                    if .textIs("]")
                        break
                    elems.add(.parseExpr()?)
            .expectText("]")?
            return PNode.expr_list_lit(PArrayLit(elems))
        else if .textIs("{")
            # Brace literal, disambiguated by a `:` after the first element:
            #   {k: v, ...}  → dict literal (→ HashMap(K, V))
            #   {a, b, ...}  → set literal (→ Set(T))
            #   {}           → empty dict literal (typed from a HashMap annotation
            #                  at codegen; a bare `{}` with no type context errors there).
            .advance()
            if .textIs("}")
                .advance()
                return PNode.expr_dict_lit(PDictLit(List(PNode)(), List(PNode)()))
            var first_be = .parseExpr()?
            if .textIs(":")
                # Dict literal: { k: v, k: v, ... }
                .advance()
                var first_bv = .parseExpr()?
                var dkeys = List(PNode)()
                var dvals = List(PNode)()
                dkeys.add(first_be)
                dvals.add(first_bv)
                while .textIs(",")
                    .advance()
                    if .textIs("}")
                        break
                    var dk = .parseExpr()?
                    .expectText(":")?
                    var dv = .parseExpr()?
                    dkeys.add(dk)
                    dvals.add(dv)
                .expectText("}")?
                return PNode.expr_dict_lit(PDictLit(dkeys, dvals))
            # Set literal: { a, b, c }
            var elems = List(PNode)()
            elems.add(first_be)
            while .textIs(",")
                .advance()
                if .textIs("}")
                    break
                elems.add(.parseExpr()?)
            .expectText("}")?
            return PNode.expr_set_lit(PArrayLit(elems))
        else if .textIs("(")
            .advance()
            const first = .parseExpr()?
            if .textIs(",")
                # Tuple literal: (expr, expr, ...)
                var elems = List(PNode)()
                elems.add(first)
                while .textIs(",")
                    .advance()
                    elems.add(.parseExpr()?)
                .expectText(")")?
                return PNode.expr_tuple_lit(PTupleLit(elems))
            .expectText(")")?
            return first
        else if .isOpenCall()
            # function/constructor call: name(args)
            const id_line = .peek().line
            const id_col = .peek().col
            const name = .peek().text
            .advance()
            const args = .parseCallArgs()?
            var callee = List(PNode)()
            callee.add(PNode.expr_id(PExprId(name, id_line, id_col)))
            return PNode.expr_call(PCall(callee, args))
        else if .textIs(".")
            # self-member access or self-call: .field or .method(args)
            .advance()
            if .isOpenCall()
                const mname = .peek().text
                const smline = .peek().line
                const smcol = .peek().col
                .advance()
                const args = .parseCallArgs()?
                var base = List(PNode)()
                var callee = List(PNode)()
                callee.add(PNode.expr_member(PMember(base, mname, smline, smcol)))
                return PNode.expr_call(PCall(callee, args))
            else
                const sfline = .peek().line
                const sfcol = .peek().col
                const field = .eatId()?
                var base = List(PNode)()
                return PNode.expr_member(PMember(base, field, sfline, sfcol))
        else if .isId()
            const id_line = .peek().line
            const id_col = .peek().col
            const name = .peek().text
            # BUG-384: `f"n={x}"` -- a Python f-string -- lexed as the identifier `f`
            # followed by a string and surfaced as "undefined name: 'f'". A one-letter
            # identifier glued to a string literal on the same line is that habit.
            if name.len == 1 and .peekAt(1).line == id_line and .peekAt(1).col == id_col + 1
                var nk = .peekAt(1).kind
                if nk is TokenKind.string_double or nk is TokenKind.string_single or nk is TokenKind.string_start_double or nk is TokenKind.string_start_single
                    raise .errorAt('no `' + name + '"..."` prefix: every Zebra string interpolates -- write "n=$' + '{x}" (QUICKSTART §1.5)')
            .advance()
            return PNode.expr_id(PExprId(name, id_line, id_col))
        else if .isTypeKeyword() or .isSizedTypeName()
            # type keyword used: expression (e.g. in List(int), HashMap(str, bool)).
            # isSizedTypeName covers int8/32/64, uint*, float32/float64 so they can
            # be generic args in value position — `List(float32)()` for SIMD (BUG-197).
            const id_line = .peek().line
            const id_col = .peek().col
            const name = .peek().text
            .advance()
            return PNode.expr_id(PExprId(name, id_line, id_col))
        else if .textIs("def") and .peekAt(1).text == "("
            return .parseLambdaExpr()?
        else if .textIs("if")
            # Ternary: if(cond, then_val, else_val) — call-form, matching the
            # bootstrap (BUG-167/F8: this parser previously accepted a colon
            # form `if c: t else: e` the bootstrap never did; converged on the
            # bootstrap's form — zero corpus usage of either at switch time).
            .advance()
            .expectText("(")?
            var cond_nodes = List(PNode)()
            cond_nodes.add(.parseExpr()?)
            .expectText(",")?
            var then_nodes = List(PNode)()
            then_nodes.add(.parseExpr()?)
            .expectText(",")?
            var else_nodes = List(PNode)()
            else_nodes.add(.parseExpr()?)
            .expectText(")")?
            return PNode.expr_if_expr(PIfExpr(cond_nodes, then_nodes, else_nodes))
        raise .unexpectedExprMsg()

    def parseLambdaExpr(): PNode throws
        # Lambda: expression-body `def(params) [as T] = expr`
        #      or statement-body  `def(params) [as T] eol indent stmts dedent`
        .expectText("def")?
        .expectText("(")?
        var params = List(PParam)()
        if not .textIs(")")
            params.add(.parseLambdaParam()?)
            while .textIs(",")
                .advance()
                params.add(.parseLambdaParam()?)
        .expectText(")")?
        var ret_type = ""
        if .textIs(":")
            .advance()
            ret_type = .eatTypeName()?
        if .textIs("=")
            # Expression-body form
            .advance()
            var body_expr = List(PNode)()
            body_expr.add(.parseExpr()?)
            return PNode.expr_lambda(PLambda(params, ret_type, List(PCaptureVar)(), body_expr, List(PNode)()))
        # Statement-body form: def(params) [as T] eol indent [capture] stmts dedent
        .skipEol()
        if not .isIndent()
            raise .errorAt("expected '=' or indent after lambda params")
        .advance()
        var captures = List(PCaptureVar)()
        if .textIs("capture")
            captures = .parseCaptureBlock()?
        var body_stmts = List(PNode)()
        while not .isDedent() and not .isEof()
            .skipEol()
            if .isDedent()
                break
            body_stmts.add(.parseStmt()?)
        if .isDedent()
            .advance()
        return PNode.expr_lambda(PLambda(params, ret_type, captures, List(PNode)(), body_stmts))

    def parseLambdaParam(): PParam throws
        const name = .eatId()?
        var type_name = ""
        if .textIs(":")
            .advance()
            type_name = .eatTypeName()?
        var pdefault = List(PNode)()
        if .textIs("=")
            .advance()
            pdefault.add(.parseExpr()?)
        return PParam(name, type_name, pdefault)

    def parseLambdaPrefix(): PLambda throws
        # Parse def(params) [as T] without consuming the body
        .expectText("def")?
        .expectText("(")?
        var params = List(PParam)()
        if not .textIs(")")
            params.add(.parseLambdaParam()?)
            while .textIs(",")
                .advance()
                params.add(.parseLambdaParam()?)
        .expectText(")")?
        var ret_type = ""
        if .textIs(":")
            .advance()
            ret_type = .eatTypeName()?
        return PLambda(params, ret_type, List(PCaptureVar)(), List(PNode)(), List(PNode)())

    def parseCaptureBlock(): List(PCaptureVar) throws
        # capture eol indent var_decls dedent
        .expectText("capture")?
        .skipEol()
        if not .isIndent()
            raise .errorAt("expected indent after 'capture'")
        .advance()
        var caps = List(PCaptureVar)()
        while not .isDedent() and not .isEof()
            .skipEol()
            if .isDedent()
                break
            var is_const = false
            if .textIs("const")
                is_const = true
                .advance()
            else
                .expectText("var")?
            const cap_line = .peek().line
            const cap_col = .peek().col
            const cap_name = .eatId()?
            var cap_type = ""
            if .textIs(":")
                .advance()
                cap_type = .eatTypeName()?
            var init_list = List(PNode)()
            if .textIs("=")
                .advance()
                init_list.add(.parseExpr()?)
            else
                init_list.add(PNode.expr_id(PExprId(cap_name, cap_line, cap_col)))
            .skipEol()
            caps.add(PCaptureVar(cap_name, cap_type, init_list, is_const))
        if .isDedent()
            .advance()
        return caps

    def parseStringInterp(): PNode throws
        # string_start_X  {expr rcurly_special [string_part_X expr rcurly_special]*}  string_stop_X
        var parts = List(PNode)()
        # Leading literal from string_start token (includes text before first ${)
        parts.add(PNode.expr_str(PLit(.peek().text, .peek().line, .peek().col)))
        .advance()
        # Parse interleaved expressions and literal parts
        while not .isStringStop() and not .isEof()
            # Parse the interpolated expression
            parts.add(.parseExpr()?)
            # Consume optional format spec token `:spec` (e.g. `:08x`, `:.2f`)
            if .isStringPartFormat()
                parts.add(PNode.expr_format(PLit(.peek().text, .peek().line, .peek().col)))
                .advance()
            # Consume rcurly_special (the closing } of ${...})
            if .isRcurlySpecial()
                .advance()
            # If followed by a string_part, consume it: literal
            if .isStringPart()
                parts.add(PNode.expr_str(PLit(.peek().text, .peek().line, .peek().col)))
                .advance()
        # Trailing literal from string_stop token
        if .isStringStop()
            parts.add(PNode.expr_str(PLit(.peek().text, .peek().line, .peek().col)))
            .advance()
        return PNode.expr_string_interp(PStringInterp(parts))

    def parseCallArgs(): List(PNode) throws
        var args = List(PNode)()
        while not .textIs(")")
            # Named-arg label `name:` — preserve the name in PNode.expr_named_arg
            # so astbuilder can populate Arg.name for named-arg reordering in codegen.
            if .isId() and .peekAt(1).text == ":"
                var label: str = .peek().text
                .advance()  # consume the id (label)
                .advance()  # consume ':'
                var val_pn = .parseExpr()?
                var val_list = List(PNode)()
                val_list.add(val_pn)
                args.add(PNode.expr_named_arg(PNamedArg(label, val_list)))
            else
                args.add(.parseExpr()?)
            if .textIs(",")
                .advance()
        .expectText(")")?
        return args

    # -- Public API ------------------------------------------------------------

    static def parse(src: str, file_name: str): PNode throws
        var toks = Parser.lexWithFile(src, file_name)?
        var p = Parser(toks, file_name, src)
        return p.parseModule()?

    # BUG-411: a lexer error carries `line:col: error: msg`; the file name is added
    # here, where it is known, so it reads like every parser diagnostic.
    static def lexWithFile(src: str, file_name: str): List(Token.Token) throws
        return Lexer.tokenize(src)?
    catch |e|
        raise file_name + ":" + e.message
