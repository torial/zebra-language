# selfhost/AstWalk.zbr — pure structural walks over the Ast types.
#
# WHY THIS MODULE EXISTS, because two more obvious homes were tried and BOTH failed
# for measured reasons. Two phases need one traversal: CodeGen (emit a `const _old_N`
# snapshot per node) and the TypeChecker (BUG-292 — refuse the inert `old <parameter>`).
#
#   CgHelpers — the natural home by its stated contract ("pure analysis passes on the
#     Zebra AST"), and where this walk first landed. But `CgHelpers` IMPORTS
#     `TypeChecker` (InferCtx/Type_/inferExpr, for the type-driven mutation analysis),
#     so a TypeChecker import closes a CYCLE. A two-module cycle compiles and runs, so
#     this looked safe — but adding the import to the real compiler, WITH NO CALL SITES
#     AT ALL, produced a zebra.exe that STACK-OVERFLOWS on hello-world. Isolated by
#     adding the bare `use` line and nothing else. See BUG-295.
#
#   Ast.zbr — a leaf, imported by everyone, and `src/Ast.zig` hosts free helpers
#     beside its declarations, so the shape matches the Zig side. But moving the walk
#     there made the SAME SOURCE emit differently: `collectOldNodesInto(u.operand, out)`
#     lost its deref, because `Expr` became a SAME-MODULE type instead of an imported
#     one. Second manifestation of the BUG-294 family; recorded there.
#
# So the requirement is precise: a module that IMPORTS `Ast` (keeping `^T` payload
# types imported, which is the shape that emits correctly) and is imported BY both
# consumers without closing a loop. That is this file. It imports Ast and nothing else.
#
# Keep it that way — a dependency added here can re-create the cycle from a distance.

use Ast exposing Expr, ExprOld, Arg, DictEntry, StringPart, LambdaBody, Stmt

# ── collectOldNodes ───────────────────────────────────────────────────────────
# TWO functions on purpose, and the split is forced by a compiler bug rather than
# chosen for taste — see BUG-293 before "simplifying" them into one.
#
#   collectOldNodesInto(expr, out)  — the recursion. An out-param, called only from
#                                     WITHIN this module.
#   collectOldNodes(expr): List     — the exported entry point. RETURNS the list.
#
# A mutated `List(T)` parameter lowers to `*std.ArrayList(T)`, so every call site must
# take `&arg`. The caller decides that by asking whether the CALLEE's body mutates the
# param — and the body lookup stops at the module boundary while the param lookup does
# not. So a cross-module call emits a bare `f(xs)` against a `*ArrayList` parameter and
# the generated Zig does not compile. Both compilers; repro in test/bug293_*.
#
# Hence the out-param recursion stays HOME, and only the returning form crosses the
# boundary. Cross-module `List(T)` RETURN was probed first and is clean, empty case
# included. When BUG-293 is fixed the wrapper may be collapsed — not before.
#
# Add every `Expr.old_` node reachable from `expr` into `out`, in TRAVERSAL ORDER.
#
# ORDER IS PRESERVED, but NOT for the reason it first appears. The `_old_N` uid is
# assigned by AstBuilder and is stable, so re-ordering would NOT rename anything. What
# it would change is the ORDER OF THE EMITTED `const` LINES — same names, same values,
# different sequence, i.e. a byte diff in generated code for no behavioural reason.
# Keep the order; do not sort.
#
# `old` does NOT recurse into its own operand, matching the original walker exactly.
# `old (old x)` is meaningless, and recursing would add a second node and shift every
# subsequent uid.
# expr-walker: exhaustive
# expr-walker-ok: zig_lit — a raw Zig literal cannot contain a Zebra `old` node.
# expr-walker-ok: ident — this hunts the node KIND Expr.old_, which AstBuilder
#   builds from an `old` construct with a snapshot uid, never from an identifier.
# expr-walker-ok: lambda — stmts body not walked; expr body is. Carried over from
#   the CodeGen original rather than re-decided.
def collectOldNodesInto(expr: Expr, out: List(ExprOld))
    branch expr
        on Expr.old_ as o
            out.add(o)
        on Expr.unary as u
            collectOldNodesInto(u.operand, out)
        on Expr.binary as b
            collectOldNodesInto(b.left, out)
            collectOldNodesInto(b.right, out)
        on Expr.call as c
            collectOldNodesInto(c.callee, out)
            for arg in c.args
                collectOldNodesInto(arg.value, out)
        on Expr.member as mem
            collectOldNodesInto(mem.object, out)
        on Expr.index as ix
            collectOldNodesInto(ix.object, out)
            collectOldNodesInto(ix.index, out)
        on Expr.cast as ca
            collectOldNodesInto(ca.expr, out)
        on Expr.to_non_nil as tnn
            collectOldNodesInto(tnn.expr, out)
        on Expr.is_nil as isn
            collectOldNodesInto(isn.expr, out)
        on Expr.orelse_ as or_
            collectOldNodesInto(or_.expr, out)
            collectOldNodesInto(or_.fallback, out)
        on Expr.catch_ as ca2
            collectOldNodesInto(ca2.expr, out)
            collectOldNodesInto(ca2.fallback, out)
        on Expr.if_expr as ie
            collectOldNodesInto(ie.cond, out)
            collectOldNodesInto(ie.then_expr, out)
            collectOldNodesInto(ie.else_expr, out)
        on Expr.try_ as tr
            collectOldNodesInto(tr.expr, out)
        on Expr.array_lit as al
            for elem in al.elems
                collectOldNodesInto(elem, out)
        on Expr.list_lit as ll
            for elem in ll.elems
                collectOldNodesInto(elem, out)
        on Expr.set_lit as sl
            for elem in sl.elems
                collectOldNodesInto(elem, out)
        on Expr.tuple_lit as tl
            for elem in tl.elems
                collectOldNodesInto(elem, out)
        on Expr.dict_lit as dl
            for entry in dl.entries
                collectOldNodesInto(entry.key, out)
                collectOldNodesInto(entry.value, out)
        on Expr.string_interp as si
            for part in si.parts
                if part is StringPart.expr_ as ex
                    collectOldNodesInto(ex, out)
        on Expr.type_check as tc
            collectOldNodesInto(tc.expr, out)
        on Expr.slice as slc
            collectOldNodesInto(slc.object, out)
            if slc.start != nil
                collectOldNodesInto(slc.start!, out)
            if slc.stop_ != nil
                collectOldNodesInto(slc.stop_!, out)
        on Expr.except_ as ex2
            collectOldNodesInto(ex2.base, out)
            for f in ex2.fields
                collectOldNodesInto(f.value, out)
        on Expr.chained_cmp as cc
            for op in cc.operands
                collectOldNodesInto(op, out)
        on Expr.opt_chain as oc
            collectOldNodesInto(oc.base, out)
            for oa in oc.args
                collectOldNodesInto(oa.value, out)
        on Expr.lambda as lam
            if lam.body_ is LambdaBody.expr_ as lbe
                collectOldNodesInto(lbe, out)
        else
            pass

# The exported entry point. Returns rather than filling an out-param so the call
# can cross a module boundary — see the BUG-293 note above the traversal.
def collectOldNodes(expr: Expr): List(ExprOld)
    var out: List(ExprOld) = List(ExprOld)()
    collectOldNodesInto(expr, out)
    return out

# ── name-use walkers (moved here from CgHelpers 2026-09-16) ──────────────────
# CgHelpers imports TypeChecker, so the checker could not reach these while they
# lived there; the unused-`as`-binding refusal needs them. Pure Ast walkers, no
# other dependency -- which is what this module is for.

# B3: true if `c` is a Zig identifier char [A-Za-z0-9_].
def isZigIdentChar(c: char): bool
    if c >= c'a' and c <= c'z'
        return true
    if c >= c'A' and c <= c'Z'
        return true
    if c >= c'0' and c <= c'9'
        return true
    return c == c'_'

# B3: true if `name` appears as a WHOLE identifier word in inline-Zig `code`.
# A param referenced from a `zig"…"` literal is used, so it must not be discarded.
def zigLitMentionsWord(code: str, name: str): bool
    var m: int = name.len
    if m == 0
        return false
    var n: int = code.len
    var i: int = 0
    while i < n
        if isZigIdentChar(code[i])
            var start: int = i
            while i < n and isZigIdentChar(code[i])
                i = i + 1
            if (i - start) == m
                var matched = true
                var k: int = 0
                while k < m
                    if code[start + k] != name[k]
                        matched = false
                        break
                    k = k + 1
                if matched
                    return true
        else
            i = i + 1
    return false

# CONSERVATIVE expression-level companion: TRUE for any expr form it doesn't
# model, so a use hidden inside one (type_check / if_expr / catch / …) is never
# missed.  Leaves (literals / nil / this) must return FALSE so a `var X = nil`
# stub isn't seen as using X.  Mirrors src/CodeGen.zig mightUseNameInExpr.
# expr-walker: exhaustive
def mightUseNameInExpr(name: str, expr: Expr): bool
    branch expr
        on Expr.ident as id
            return id.name == name
        on Expr.member as m
            return mightUseNameInExpr(name, m.object)
        on Expr.index as i
            if mightUseNameInExpr(name, i.object)
                return true
            return mightUseNameInExpr(name, i.index)
        on Expr.unary as u
            return mightUseNameInExpr(name, u.operand)
        on Expr.binary as b
            if mightUseNameInExpr(name, b.left)
                return true
            return mightUseNameInExpr(name, b.right)
        on Expr.call as c
            if mightUseNameInExpr(name, c.callee)
                return true
            for arg in c.args
                if mightUseNameInExpr(name, arg.value)
                    return true
            return false
        on Expr.tuple_lit as tl
            for telem in tl.elems
                if mightUseNameInExpr(name, telem)
                    return true
            return false
        on Expr.chained_cmp as cc
            for op in cc.operands
                if mightUseNameInExpr(name, op)
                    return true
            return false
        on Expr.string_interp as si
            for part in si.parts
                if part is StringPart.expr_ as e
                    if mightUseNameInExpr(name, e)
                        return true
            return false
        on Expr.orelse_ as o
            if mightUseNameInExpr(name, o.expr)
                return true
            return mightUseNameInExpr(name, o.fallback)
        # BUG-169: these expr forms were unmodelled (→ conservative `else => true`),
        # which SKIPS a needed unused-capture/local discard when one appears in the
        # body (fuzz F11: a ternary in an unused `if x as y` body).  Model them
        # exactly (mirroring nameUsedInExpr) so the discard fires.  `lambda` is
        # deliberately left to `else` (conservative — its shadowing logic is
        # error-prone to mirror, and over-approx here is the safe direction).
        on Expr.if_expr as ie
            if mightUseNameInExpr(name, ie.cond)
                return true
            if mightUseNameInExpr(name, ie.then_expr)
                return true
            return mightUseNameInExpr(name, ie.else_expr)
        on Expr.try_ as t
            return mightUseNameInExpr(name, t.expr)
        on Expr.catch_ as ca
            if mightUseNameInExpr(name, ca.expr)
                return true
            return mightUseNameInExpr(name, ca.fallback)
        on Expr.to_non_nil as tn
            return mightUseNameInExpr(name, tn.expr)
        on Expr.is_nil as isn
            return mightUseNameInExpr(name, isn.expr)
        on Expr.cast as cst
            return mightUseNameInExpr(name, cst.expr)
        on Expr.type_check as tc
            return mightUseNameInExpr(name, tc.expr)
        on Expr.slice as sl
            if mightUseNameInExpr(name, sl.object)
                return true
            if sl.start != nil
                if mightUseNameInExpr(name, sl.start!)
                    return true
            if sl.stop_ != nil
                return mightUseNameInExpr(name, sl.stop_!)
            return false
        on Expr.opt_chain as oc
            if mightUseNameInExpr(name, oc.base)
                return true
            for oca in oc.args
                if mightUseNameInExpr(name, oca.value)
                    return true
            return false
        on Expr.except_ as ex
            if mightUseNameInExpr(name, ex.base)
                return true
            for exf in ex.fields
                if mightUseNameInExpr(name, exf.value)
                    return true
            return false
        on Expr.set_lit as sl
            for se in sl.elems
                if mightUseNameInExpr(name, se)
                    return true
            return false
        on Expr.dict_lit as dl
            for de in dl.entries
                if mightUseNameInExpr(name, de.key)
                    return true
                if mightUseNameInExpr(name, de.value)
                    return true
            return false
        on Expr.int_lit
            return false
        on Expr.float_lit
            return false
        on Expr.bool_lit
            return false
        on Expr.char_lit
            return false
        on Expr.string_lit
            return false
        on Expr.nil_
            return false
        on Expr.this_
            return false
        # BUG-169 retirement: model every remaining ident-bearing expr, so the
        # final `else` only catches genuinely ident-free forms (result_; zig_lit
        # was in this list until BUG-267 showed it is NOT ident-free)
        # → false.  Mirrors the bootstrap's exhaustive switch (round-trip enforces
        # parity).  Retires the walker-drift class (F2/F6/F11).
        on Expr.lambda as lam
            for lcap in lam.captures
                if lcap.init_expr != nil
                    if mightUseNameInExpr(name, lcap.init_expr!)
                        return true
            for lp in lam.params
                if lp.name == name
                    return false
            for lcap2 in lam.captures
                if lcap2.name == name
                    return false
            branch lam.body_
                on LambdaBody.expr_ as lex
                    return mightUseNameInExpr(name, lex)
                on LambdaBody.stmts as lss
                    return mightUseName(name, lss)
        on Expr.list_lit as ll
            for lle in ll.elems
                if mightUseNameInExpr(name, lle)
                    return true
            return false
        on Expr.array_lit as al
            for ale in al.elems
                if mightUseNameInExpr(name, ale)
                    return true
            return false
        on Expr.old_ as ol
            return mightUseNameInExpr(name, ol.operand)
        on Expr.zig_lit as zl
            # BUG-267: an inline-Zig escape DOES contain user idents — it is the only
            # way to touch a C pointer, so it is where a local most often ends up being
            # read. `nameUsedInExpr` (the sibling walker, ~line 474) has scanned zig
            # literals for exactly this reason since B3: *"A param referenced from a
            # `zig\"…\"` literal is used, so it must not be discarded."* This walker,
            # which the LOCAL auto-discard consults, never learned it — so the identical
            # question got opposite answers depending on whether the name was a param or
            # a local, and a local read only from an escape got `_ = q;` emitted beside
            # a real use (`pointless discard of local constant`).
            #
            # LIMIT, stated rather than hidden: zigLitMentionsWord does not skip Zig
            # strings or comments, so a name appearing ONLY inside one counts as a use,
            # the discard is suppressed, and Zig reports `unused local variable`. That
            # is the same exposure parameters have carried all along without incident,
            # and it fails as a COMPILE ERROR rather than a silent miscompile. If it
            # ever does bite, the fix is to teach zigLitMentionsWord about string and
            # comment spans — not to add a `reads` clause to the language, which would
            # leave two mechanisms answering one question (see BUG-267 for that design
            # and why it was dropped).
            return zigLitMentionsWord(zl.text, name)
        else
            # result_ — no user idents.
            return false

# CONSERVATIVE "might `name` be read anywhere in `stmts`?" — returns true for any
# statement form it can't fully analyse, so a caller may safely emit an unused
# discard (`_ = X;`) only when this is false (never discarding a used name, which
# Zig rejects as a pointless discard).  Same core set as src/CodeGen.zig.
def mightUseName(name: str, stmts: List(Stmt)): bool
    for s in stmts
        if mightUseNameStmt(name, s)
            return true
    return false

def mightUseNameStmt(name: str, stmt: Stmt): bool
    branch stmt
        on Stmt.var_ as n
            if n.init_expr != nil
                return mightUseNameInExpr(name, n.init_expr!)
            return false
        on Stmt.assign as a
            if mightUseNameInExpr(name, a.target)
                return true
            return mightUseNameInExpr(name, a.value)
        on Stmt.return_ as r
            if r.value != nil
                return mightUseNameInExpr(name, r.value!)
            return false
        on Stmt.expr as e
            return mightUseNameInExpr(name, e)
        on Stmt.print_ as p
            var pi = 0
            while pi < p.args.len
                if mightUseNameInExpr(name, p.args.at(pi))
                    return true
                pi += 1
            return false
        on Stmt.destruct as d
            return mightUseNameInExpr(name, d.init_expr)
        on Stmt.if_ as si
            if mightUseNameInExpr(name, si.cond)
                return true
            if mightUseName(name, si.then_stmts)
                return true
            for ei in si.else_ifs
                if mightUseNameInExpr(name, ei.cond)
                    return true
                if mightUseName(name, ei.stmts)
                    return true
            if si.else_stmts as se
                return mightUseName(name, se)
            return false
        on Stmt.while_ as w
            if mightUseNameInExpr(name, w.cond)
                return true
            return mightUseName(name, w.stmts)
        on Stmt.for_in as f
            if mightUseNameInExpr(name, f.iter)
                return true
            return mightUseName(name, f.stmts)
        on Stmt.for_num as fnum
            if mightUseNameInExpr(name, fnum.start)
                return true
            if mightUseNameInExpr(name, fnum.stop_)
                return true
            return mightUseName(name, fnum.stmts)
        # BUG-169: statement forms that were unmodelled (→ conservative
        # `else => true`), which skips a needed unused-capture/local discard
        # when one appears in the body.  `branch_` is the one the fuzzer's
        # enum/union surface hits (a `branch` in an unused-capture body);
        # model these exactly (mirroring nameUsedInStmt) so the discard fires.
        on Stmt.branch_ as b
            if mightUseNameInExpr(name, b.expr)
                return true
            for bc in b.cases
                for bcv in bc.values
                    if mightUseNameInExpr(name, bcv)
                        return true
                if mightUseName(name, bc.stmts)
                    return true
            if b.else_ as be
                return mightUseName(name, be)
            return false
        on Stmt.try_catch as tcs
            if mightUseName(name, tcs.stmts)
                return true
            for cl in tcs.clauses
                if mightUseName(name, cl.stmts)
                    return true
            return false
        on Stmt.raise_ as r
            if r.message != nil
                if mightUseNameInExpr(name, r.message!)
                    return true
            if r.details != nil
                return mightUseNameInExpr(name, r.details!)
            return false
        on Stmt.assert_ as a
            if mightUseNameInExpr(name, a.cond)
                return true
            if a.message != nil
                return mightUseNameInExpr(name, a.message!)
            return false
        # BUG-169 retirement: model every remaining ident-bearing statement, so
        # the final `else` is unreachable (all selfhost Stmt forms handled) →
        # false.  Mirrors the bootstrap's exhaustive switch; round-trip enforces
        # parity.  Retires the walker-drift class (F2/F6/F11).
        on Stmt.with_ as wth
            if mightUseNameInExpr(name, wth.target)
                return true
            return mightUseName(name, wth.stmts)
        on Stmt.in_scope as ins
            if mightUseNameInExpr(name, ins.expr)
                return true
            return mightUseName(name, ins.stmts)
        on Stmt.allocate_ as alc
            if mightUseNameInExpr(name, alc.source)
                return true
            return mightUseName(name, alc.stmts)
        on Stmt.copy_out as cpo
            if mightUseNameInExpr(name, cpo.target)
                return true
            return mightUseNameInExpr(name, cpo.value)
        on Stmt.contract as ctr
            for ce in ctr.exprs
                if mightUseNameInExpr(name, ce)
                    return true
            return false
        on Stmt.break_
            return false
        on Stmt.continue_
            return false
        on Stmt.pass_
            return false
