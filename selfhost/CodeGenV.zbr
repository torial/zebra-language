# CodeGenV.zbr -- a V backend, proof of concept (2026-10-13).
#
# A second emitter over the same front end (Parser -> Resolver -> ASTBuilder):
# `zebra --target v file.zbr` writes file.v beside the source, for `v run`.
# The subset: free functions, classes (fields, `cue init`, methods), local
# and module-level vars, if / else if / else, while, `for x in list`,
# `for i in a.to(b)`, assign (and the compound ops), return, break,
# continue, print, assert, calls, member access, `this`, binary and unary
# ops, the literals, list literals, string interpolation, if-expressions,
# and a hand-mapped slice of the stdlib surface (str, List, Math, the
# numeric conversions). Everything else is REFUSED by name and line and
# listed at the end of the run -- nothing is skipped silently (the Zig
# emitter's method surface alone is 2,856 lines; the refusal list is the
# honest measure of the distance).
#
# V's own rules the emitter carries: function, method, variable and field
# names are snake_case (V refuses uppercase in them), types are
# CapitalCase, Zebra's int is 64-bit so it is V's i64, `this` is `self`,
# a class is a struct with `mut:` fields, `cue init` is `fn new_<name>()
# &Name`, a method is `fn (mut self Name) m()`.

use AstWalk exposing mightUseName, mightUseNameInExpr, mightUseNameStmt
use Ast exposing Module, Decl, DeclClass, DeclStruct, DeclEnum, EnumMember, DeclUnion, UnionVariant, DeclMethod, DeclVar, DeclInit, Param, TypeRef, NamedTypeRef, GenericTypeRef, Stmt, StmtIf, ElseIf, StmtWhile, StmtForIn, StmtForNum, StmtReturn, StmtAssert, StmtAssign, AssignOp, StmtPrint, StmtBranch, BranchOn, StmtRaise, StmtTryCatch, CatchClause, ExprTry, ExprCatch, Expr, ExprIntLit, IntBase, ExprFloatLit, ExprBoolLit, ExprCharLit, ExprSlice, ExprCast, ExprChainedCmp, ExprLambda, LambdaBody, DeclSig, ExprExcept, DeclInterface, DeclTypeAlias, ExprStringLit, StringKind, ExprStringInterp, StringPart, ExprIdent, ExprMember, ExprCall, Arg, ExprIndex, ExprBinary, BinaryOp, ExprUnary, UnaryOp, ExprListLit, ExprIf, ExprTypeCheck, Span

# a callee's parameters, for named arguments and defaults at the call
# (and which are references, hence `mut`)
class FnSig
    var names: List(str)
    var has_default: List(bool)
    var defaults: List(Expr)      # a nil placeholder where has_default is false
    var refs: List(bool)
    var types: List(str)          # the parameters' V types (a Json value converts to one at the call)

    cue init()
        .names = List(str)()
        .has_default = List(bool)()
        .defaults = List(Expr)()
        .refs = List(bool)()
        .types = List(str)()

# the emitter's answer: the V source and what it refused
class VResult
    var source: str
    var refused: List(str)
    var needs_math: bool
    var has_globals: bool    # a `__global` was emitted: the run needs -enable-globals

    cue init(source: str, refused: List(str), needs_math: bool, has_globals: bool = false)
        .source = source
        .refused = refused
        .needs_math = needs_math
        .has_globals = has_globals

# "setAnimate" -> "set_animate"; "winDist" -> "win_dist"; "x" -> "x"
def snakeCase(name: str): str
    if isAllCaps(name)
        return name.lower()   # CUE_NAMES -> cue_names
    var out: str = ""
    var first: bool = true
    for ch in name.chars()
        if ch >= 'A' and ch <= 'Z'
            if not first
                out = out + "_"
            out = out + lowerOf(ch)
        else
            out = out + ch.toString()
        first = false
    return out

def isAllCaps(name: str): bool
    var any: bool = false
    for ch in name.chars()
        if ch >= 'a' and ch <= 'z'
            return false
        if ch >= 'A' and ch <= 'Z'
            any = true
    return any

def lowerOf(ch: char): str
    # (a str index is a byte, and a byte's toString is its number -- "99" for
    # 'c'; the chars of the alphabet are iterated instead)
    var up: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var i: int = 0
    for lc in "abcdefghijklmnopqrstuvwxyz".chars()
        if up[i] == ch
            return lc.toString()
        i = i + 1
    return ch.toString()

# V's reserved words a Zebra name may collide with
def vSafe(name: str): str
    var s = snakeCase(name)
    if s.startsWith("_")
        s = "u" + s   # V refuses a name beginning with `_`
    if s == "match" or s == "type" or s == "struct" or s == "fn" or s == "mut" or s == "pub" or s == "import" or s == "module" or s == "go" or s == "select" or s == "lock" or s == "rlock" or s == "shared" or s == "atomic" or s == "none" or s == "sizeof" or s == "typeof" or s == "unsafe" or s == "defer" or s == "goto" or s == "asm" or s == "union" or s == "interface" or s == "enum" or s == "const" or s == "in" or s == "is" or s == "as" or s == "or" or s == "isreftype" or s == "dump" or s == "spawn" or s == "volatile" or s == "static" or s == "nil" or s == "sql" or s == "likely" or s == "unlikely" or s == "implements" or s == "true" or s == "false"
        return s + "_"
    # C's own words, which V emits verbatim into its C (tcc read a loop
    # variable `cdecl` as its calling-convention keyword)
    if s == "cdecl" or s == "stdcall" or s == "fastcall" or s == "int" or s == "char" or s == "float" or s == "double" or s == "long" or s == "short" or s == "void" or s == "signed" or s == "unsigned" or s == "auto" or s == "register" or s == "extern" or s == "inline" or s == "restrict" or s == "typedef" or s == "switch" or s == "case" or s == "default" or s == "do" or s == "while" or s == "for" or s == "if" or s == "else" or s == "break" or s == "continue" or s == "return" or s == "bool" or s == "near" or s == "far" or s == "pascal" or s == "huge"
        return s + "_"   # (near / far / pascal / huge: macros in tcc's Windows headers)
    # V's type names are no variable names (`mut map := ...`)
    if s == "map" or s == "string" or s == "array" or s == "chan" or s == "thread" or s == "any" or s == "voidptr" or s == "byte" or s == "rune" or s == "int" or s == "f32" or s == "f64" or s == "i8" or s == "i16" or s == "i32" or s == "i64" or s == "u8" or s == "u16" or s == "u32" or s == "u64" or s == "isize" or s == "usize" or s == "char"
        return s + "_"
    # the modules the emitted file imports: a parameter `time` was a duplicate of one
    if s == "time" or s == "os" or s == "math" or s == "strconv" or s == "rand" or s == "sha256" or s == "json2" or s == "bits"
        return s + "_"
    return s

class VGen
    var sb: StringBuilder
    var depth: int
    var refused: List(str)
    var class_names: List(str)
    var struct_names: List(str)   # value types: V structs by value
    var enum_names: List(str)
    var union_names: List(str)    # V sum types over per-variant structs
    var sigs: HashMap(str, FnSig) # by callee name: a function, `new_<type>`, a method (a name shared across types keeps the first)
    var member_counts: HashMap(str, int)   # a union's variants, an enum's members: whether a branch over them is exhaustive (V refuses an `else` on an exhaustive match)
    var current_params: List(Param)   # the enclosing def's parameters (a def-level catch closes over them)
    var current_ret: str              # the enclosing def's V return type ("" for none)
    var in_method: bool               # inside a method (a def-level catch there is refused: a closure's capture of self is V's call)
    var catch_bindings: List(str)     # the error bindings in scope: `e.message` is `e.msg()` on these
    var current_fields: List(str)     # the enclosing class's / struct's fields: a bare name among them is `self.<field>`
    var module_names: List(str)       # the used modules' names: `Mod.Name` is `Name` in the one V file
    var current_methods: List(str)    # the enclosing class's instance methods: a bare call among them is `self.m(...)`
    var current_statics: List(str)    # the enclosing class's static methods: a bare call among them is `class_m(...)`
    var local_types: HashMap(str, str)  # the V type of each param and local declared so far (what a receiver is)
    var field_types: HashMap(str, str)  # the V type of each field of the enclosing class / struct
    var heap_names: List(str)         # the structs some `^T` targets: reference types in V (their constructors allocate)
    var global_types: HashMap(str, str)  # the V type of each module-level var
    var union_payloads: HashMap(str, str)   # `U_v` -> the V type of the variant's payload
    var current_file: str             # the module being emitted (a refusal names it)
    var has_globals: bool             # a `__global` was emitted
    var sig_conflicts: List(str)      # a callee name two declarations share with different parameters: called by position
    var rets: HashMap(str, str)       # the V return type of each def / method by name (`Owner.name` for a static), "" when two differ
    var struct_mut: bool              # the struct being emitted has a method that assigns a field: every method is `mut self`
    var mut_structs: List(str)        # the structs whose methods are all `mut self` (a pass before emission)
    var in_cond: bool                 # emitting a loop's condition: no line may be hoisted before it
    var in_ctor: bool                 # emitting a constructor's body: a bare return is `return self`
    var current_exposed: HashMap(str, str)   # a name the module's `use ... exposing` lines name -> the stem that exposes it
    var def_modules: HashMap(str, List(str))   # a free function's name -> the module stems that declare it
    var current_stem: str             # the module being emitted, by its file's stem
    var current_uses: List(str)       # the stems the module being emitted uses
    var capturing: bool               # a function body is being captured (a stub replaces it if anything is refused)
    var fn_names: List(str)           # every free function's V name (a local of that name is renamed)
    var global_inits: List(str)       # `name = value` for every __global, set by zglobals_init() at main's start
    var global_modules: HashMap(str, List(str))   # a module-level var's name -> the module stems that declare it
    var iface_names: List(str)        # the interfaces: V interfaces, their values pointers to classes
    var sig_names: List(str)          # the sig types: a lambda passed as one is cast to its name
    var emitted_globals: List(str)    # every module-level const / var as emitted: a local of that name is renamed (V's one namespace)
    var sig_canon: HashMap(str, str)  # a sig's name -> the first-declared sig of its V shape (vlang/v#30282: one instantiation per shape)
    var sig_shapes: HashMap(str, str) # a V shape (param types with mut, the return) -> the first sig declared with it
    var narrowed: List(str)           # the nilable locals Zebra narrows in the current block: read as zunwrap(?T(x))
    var aliases: HashMap(str, TypeRef)   # `type Alias = Base`: resolved to the base wherever named
    var renames: HashMap(str, str)    # a local's Zebra name -> its V name when renamed
    var captured: List(str)           # the body's lines while capturing
    var all_field_types: HashMap(str, str)  # `Name.field` -> the V type, every class and struct
    var local_names: List(str)        # the params and locals declared so far in the enclosing def (they shadow a field)
    var matchN: int               # the temporaries bound for `branch`
    var current_class: str        # "" outside a class
    var needs_math: bool
    var tmpN: int                 # the temporaries bound for mutating calls on call results
    var ref_params: HashMap(str, List(bool))   # by callee name (a function, `new_<class>`, a method): which params are references, hence `mut` (V's rule for a param mutated through a method; a method name shared across classes keeps the first)

    cue init()
        .sb = StringBuilder()
        .depth = 0
        .refused = List(str)()
        .class_names = List(str)()
        .struct_names = List(str)()
        .enum_names = List(str)()
        .union_names = List(str)()
        .sigs = HashMap(str, FnSig)()
        .member_counts = HashMap(str, int)()
        .current_params = List(Param)()
        .current_ret = ""
        .in_method = false
        .catch_bindings = List(str)()
        .current_fields = List(str)()
        .module_names = List(str)()
        .current_methods = List(str)()
        .current_statics = List(str)()
        .local_types = HashMap(str, str)()
        .field_types = HashMap(str, str)()
        .heap_names = List(str)()
        .global_types = HashMap(str, str)()
        .union_payloads = HashMap(str, str)()
        .current_file = ""
        .has_globals = false
        .sig_conflicts = List(str)()
        .rets = HashMap(str, str)()
        .struct_mut = false
        .mut_structs = List(str)()
        .in_cond = false
        .in_ctor = false
        .current_exposed = HashMap(str, str)()
        .def_modules = HashMap(str, List(str))()
        .current_stem = ""
        .current_uses = List(str)()
        .capturing = false
        .captured = List(str)()
        .fn_names = List(str)()
        .global_inits = List(str)()
        .global_modules = HashMap(str, List(str))()
        .iface_names = List(str)()
        .sig_names = List(str)()
        .emitted_globals = List(str)()
        .sig_canon = HashMap(str, str)()
        .sig_shapes = HashMap(str, str)()
        .narrowed = List(str)()
        .aliases = HashMap(str, TypeRef)()
        .renames = HashMap(str, str)()
        .all_field_types = HashMap(str, str)()
        .local_names = List(str)()
        .matchN = 0
        .current_class = ""
        .needs_math = false
        .tmpN = 0
        .ref_params = HashMap(str, List(bool))()

    def refuse(what: str, span: Span)
        .refused.add(what + " (" + .current_file + ":" + span.line.toString() + ")")

    def line(s: str)
        var out: str = ""
        var i: int = 0
        while i < .depth
            out = out + "\t"
            i = i + 1
        out = out + s + "\n"
        if .capturing
            .captured.add(out)
        else
            .sb.append(out)

    # a function's body: captured, and replaced by a stub when any construct
    # in it was refused -- the program compiles and runs, and the gap names
    # itself when the function is reached (the refusal list says it was stubbed)
    def genBody(stmts: List(Stmt), what: str)
        var mark: int = .refused.count()
        .capturing = true
        .captured = List(str)()
        .genStmts(stmts)
        .capturing = false
        if .refused.count() > mark
            var reasons: str = ""
            var k: int = mark
            while k < .refused.count()
                if reasons != ""
                    reasons = reasons + "; "
                reasons = reasons + .refused.at(k)
                .refused.set(k, .refused.at(k) + " [in " + what + ": stubbed]")
                k = k + 1
            .line("panic('not on the V backend: " + .vEscape(what + ": " + reasons) + "')")
        else
            for l in .captured
                .sb.append(l)
        .captured = List(str)()

    # ── types ──────────────────────────────────────────────────────────────
    def vType(t: TypeRef?): str
        if t == nil
            return ""
        branch t!
            on TypeRef.named as n
                return .vNamed(n.name)
            on TypeRef.generic as g
                # the containers are references, as Zebra's are: the runtime's
                # boxed ZList / ZMap by reference (zebra_rt.v), never V's value arrays
                if g.name == "List" and g.args.count() == 1
                    return "&ZList[" + .vType(g.args.at(0)) + "]"
                if g.name == "HashMap" and g.args.count() == 2
                    return "&ZMap[" + .vType(g.args.at(0)) + ", " + .vType(g.args.at(1)) + "]"
                if g.name == "Set" and g.args.count() == 1
                    return "&ZSet[" + .vType(g.args.at(0)) + "]"
                .refused.add("generic type " + g.name)
                return "voidptr"
            on TypeRef.void_
                return ""
            on TypeRef.nilable as inner
                return "?" + .vType(inner)
            on TypeRef.ref_to as inner
                # `^T`: a reference; a class or a heap struct is one already, and
                # a union is V's sum type -- a boxed fat pointer by value
                var s: str = .vType(inner)
                if s.startsWith("?")
                    # `^T?`: an option of the reference (`?&Name`), of the union (`?U`)
                    var core: str = s.substring(1, s.len)
                    if core.startsWith("&") or .isUnionName(core)
                        return s
                    return "?&" + core
                if s.startsWith("&") or .isUnionName(s)
                    return s
                return "&" + s
            on TypeRef.tuple as tt
                # a tuple is the runtime's ZTuple2 / ZTuple3: fields f0, f1, f2
                if tt.elems.count() < 2 or tt.elems.count() > 3
                    .refused.add("a tuple of " + tt.elems.count().toString() + " (the runtime spells 2 and 3)")
                    return "voidptr"
                var parts: str = ""
                for et in tt.elems
                    if parts != ""
                        parts = parts + ", "
                    parts = parts + .vType(et)
                return "ZTuple" + tt.elems.count().toString() + "[" + parts + "]"
            else
                .refused.add("a type the subset does not spell (stream, error union, fn)")
                return "voidptr"

    def vNamed(qualified: str): str
        # `Token.Token` (a type of a used module) is `Token` in the one V file
        var segs: List(str) = qualified.split(".")
        var name: str = segs.at(segs.count() - 1)
        if name == "int": return "i64"
        if name == "float": return "f64"
        if name == "str": return "string"
        if name == "bool": return "bool"
        if name == "char": return "u8"
        if name == "void": return ""
        if name == "StringBuilder": return "&ZStringBuilder"
        if name == "Json" or name == "JsonValue": return "json2.Any"   # by value, as Zig's std.json.Value
        if .aliases.get(name) as at
            return .vType(at)   # `type Alias = Base`: the base, wherever named
        if .sig_canon.get(name) as owner
            return owner   # a sig of a shape an earlier sig owns: that name (vlang/v#30282)
        if name == "SqliteDb": return "&ZSqliteDb"
        if name == "SqliteRow": return "&ZSqliteRow"
        if name == "Random": return "&ZRandom"
        if name == "DateTime": return "ZDateTime"
        for cn in .class_names
            if cn == name
                return "&" + name
        return name

    def isStructName(name: str): bool
        for sn in .struct_names
            if sn == name
                return true
        return false

    def isEnumName(name: str): bool
        for en in .enum_names
            if en == name
                return true
        return false

    def isUnionName(name: str): bool
        for un in .union_names
            if un == name
                return true
        return false

    def isClassName(name: str): bool
        for cn in .class_names
            if cn == name
                return true
        return false

    def isSigName(name: str): bool
        for n in .sig_names
            if n == name
                return true
        return false

    # a lambda's declared return type, in V
    def lambdaRet(e: Expr): str
        branch e
            on Expr.lambda as lam
                return .vType(lam.return_type)
            else
                return ""

    def jsonTry(kind: str, obj: str, args: List(Arg), ja: str): str
        if args.count() == 1
            return "zjson_tryk_" + kind + "(" + obj + ", " + ja + ")"
        return "zjson_try_" + kind + "(" + obj + ")"

    # a nilable local Zebra reads narrowed: spelled zunwrap(?T(x)), no lvalue
    def isNarrowedIdent(e: Expr): bool
        branch e
            on Expr.ident as id
                return .isNarrowed(id.name)
            else
                return false

    def isIfaceName(name: str): bool
        for n in .iface_names
            if n == name
                return true
        return false

    def isModuleName(name: str): bool
        for mn in .module_names
            if mn == name
                return true
        return false

    # the name a static access stands on: `Name.x` -> Name, `Mod.Name.x` ->
    # Name when Mod is a used module; "" when the object is an expression
    def staticOwner(obj: Expr): str
        branch obj
            on Expr.ident as id
                return id.name
            on Expr.member as m
                branch m.object
                    on Expr.ident as id
                        if .isModuleRef(id.name)
                            return m.member
                    else
                        pass
                return ""
            else
                return ""

    # a module's name stands for the module only when nothing in scope has
    # it: the engine's modules are common nouns (tween, character, health,
    # door), and a local of that name is the value
    def isModuleRef(name: str): bool
        if .isLocalName(name) or .isCurrentField(name) or .isGlobalName(name)
            return false
        return .isModuleName(name)

    def isModuleIdent(obj: Expr): bool
        branch obj
            on Expr.ident as id
                return .isModuleRef(id.name)
            else
                return false

    # ── the module ─────────────────────────────────────────────────────────
    # every module in one V file: the used modules first (their declarations
    # the root's depend on), the root last; the passes see all of them
    def genModules(ms: List(Module)): str
        for m in ms
            for d in m.decls
                branch d
                    on Decl.use_ as u
                        var segs: List(str) = u.path.split("/")
                        .module_names.add(segs.at(segs.count() - 1))
                    else
                        pass
        for m in ms
            .noteTypeNames(m)
        for m in ms
            .noteRefTargets(m)
        for m in ms
            .noteSigShapes(m)   # (after the reference targets: a shape carries each param's mut)
        for m in ms
            .noteFieldTypes(m)
        for m in ms
            .noteDefs(m)   # (before the return types: those are keyed by the emitted name this pass decides)
        for m in ms
            .noteRets(m)
        for m in ms
            .noteMutStructs(m)
        for m in ms
            .noteSigs(m)
        for m in ms
            .noteEmittedGlobals(m)   # (after the definitions: which names two modules share)
        var last: int = ms.count() - 1
        var mi: int = 0
        for m in ms
            .enterModule(m)
            .line("// -- " + m.file + " --")
            for d in m.decls
                var skip: bool = false
                if mi != last
                    branch d
                        on Decl.method as mth
                            if mth.name == "main"
                                skip = true   # a used module's main: the root's runs
                                .line("// (" + m.file + "'s main is not emitted: the root's runs)")
                        else
                            pass
                if not skip
                    .genDecl(d)
            mi = mi + 1
        if .global_inits.count() > 0
            .line("// the module-level vars, set before main runs (the Zig backend's _initModuleVars)")
            .line("fn zglobals_init() {")
            for gi in .global_inits
                .line("\t" + gi)
            .line("}")
            .line("")
        return .sb.build()

    def noteTypeNames(m: Module)
        # the classes first, so a field or a return of a class type is `&Name`
        for d in m.decls
            branch d
                on Decl.class_ as c
                    .class_names.add(c.name)
                on Decl.struct_ as st
                    .struct_names.add(st.name)
                on Decl.enum_ as en
                    .enum_names.add(en.name)
                    .member_counts.set(en.name, en.members.count())
                on Decl.union_ as un
                    .union_names.add(un.name)
                    .member_counts.set(un.name, un.variants.count())
                on Decl.interface_ as di
                    .iface_names.add(di.name)
                on Decl.sig_ as sgn
                    .sig_names.add(sgn.name)
                on Decl.type_alias_ as ta
                    if ta.params.count() == 0 and ta.constraint == nil
                        .aliases.set(ta.name, ta.base)
                else
                    pass

    # two sigs of one V shape are one V name: V instantiates a generic's
    # methods once per resolved type and calls them under each alias, so the
    # second alias's instantiation is declared and never generated
    # (vlang/v#30282). The first sig declared with a shape owns it; a later
    # one is spelled by the owner wherever it is named (vNamed) and declared
    # as a comment.
    def noteSigShapes(m: Module)
        for d in m.decls
            branch d
                on Decl.sig_ as sg
                    var shape: str = .sigShape(sg.params, sg.return_type)
                    if .sig_shapes.get(shape) as owner
                        .sig_canon.set(sg.name, owner)
                    else
                        .sig_shapes.set(shape, sg.name)
                else
                    pass

    # the emitted name of every module-level const / var: a var two modules
    # declare is `<module>_<name>` in each (globalName), else its own name
    def noteEmittedGlobals(m: Module)
        for d in m.decls
            branch d
                on Decl.var_ as gv
                    if .global_modules.get(gv.name) as mods
                        if mods.count() > 1
                            for s in mods
                                .emitted_globals.add(snakeCase(s) + "_" + vSafe(gv.name))
                        else
                            .emitted_globals.add(vSafe(gv.name))
                    else
                        .emitted_globals.add(vSafe(gv.name))
                else
                    pass

    def isEmittedGlobal(name: str): bool
        for g in .emitted_globals
            if g == name
                return true
        return false

    def sigShape(params: List(Param), ret: TypeRef?): str
        var out: str = ""
        for p in params
            var pt: str = .vType(p.type_)
            if .isRefType(p.type_)
                pt = "mut " + pt
            out = out + pt + ","
        return out + "->" + .vType(ret)

    # a struct named under `^` anywhere (a union's payload, a field, a param,
    # a return) is a reference type in V: `&Name` wherever it is named, its
    # constructor allocating -- V cannot take the address of a call's result,
    # and a boxed node is a reference on the Zig backend too. The cost: a
    # by-value copy of such a struct elsewhere is a shared reference in V.
    def noteRefTargets(m: Module)
        for d in m.decls
            branch d
                on Decl.union_ as un
                    for v in un.variants
                        .refWalk(v.payload)
                on Decl.class_ as c
                    .refWalkMembers(c.members)
                on Decl.struct_ as st
                    .refWalkMembers(st.members)
                on Decl.method as mth
                    .refWalkMethod(mth)
                on Decl.var_ as gv
                    .refWalk(gv.type_)
                else
                    pass

    def refWalkMembers(members: List(Decl))
        for mem in members
            branch mem
                on Decl.var_ as f
                    .refWalk(f.type_)
                on Decl.method as mth
                    .refWalkMethod(mth)
                on Decl.init as ini
                    for p in ini.params
                        .refWalk(p.type_)
                else
                    pass

    def refWalkMethod(mth: DeclMethod)
        for p in mth.params
            .refWalk(p.type_)
        .refWalk(mth.return_type)

    def refWalk(t: TypeRef?)
        if t == nil
            return
        branch t!
            on TypeRef.ref_to as inner
                branch inner
                    on TypeRef.named as n
                        .markHeap(n.name)
                    else
                        pass
                .refWalk(inner)
            on TypeRef.nilable as inner
                .refWalk(inner)
            on TypeRef.generic as g
                for a in g.args
                    .refWalk(a)
            else
                pass

    def markHeap(qualified: str)
        var segs: List(str) = qualified.split(".")
        var name: str = segs.at(segs.count() - 1)
        if .isStructName(name) and not .isHeapName(name)
            .heap_names.add(name)
            var i: int = 0
            while i < .struct_names.count()
                if .struct_names.at(i) == name
                    .struct_names.remove(i)   # (Zebra's List.remove takes an index)
                    i = .struct_names.count()
                i = i + 1
            .class_names.add(name)

    def isHeapName(name: str): bool
        for h in .heap_names
            if h == name
                return true
        return false

    # every variant's payload type and every type's field types, for the
    # receiver-type reads (an `as` capture, a branch binding, a field chain)
    # the structs whose methods assign their fields: every method `mut self`,
    # and a call into one needs a mutable receiver
    def noteMutStructs(m: Module)
        for d in m.decls
            branch d
                on Decl.struct_ as st
                    .current_fields = fieldNames(st.members)
                    for mem in st.members
                        branch mem
                            on Decl.method as mth
                                if mth.stmts as b
                                    if .bodyAssignsField(b) and not .isMutStruct(st.name)
                                        .mut_structs.add(st.name)
                            else
                                pass
                    .current_fields = List(str)()
                else
                    pass

    # every module's free functions, by name: a name two modules declare is
    # prefixed with its module's stem wherever it is declared or called
    def noteDefs(m: Module)
        var stem: str = moduleStem(m.file)
        for d in m.decls
            branch d
                on Decl.method as mth
                    .fn_names.add(vSafe(mth.name))
                    if .def_modules.get(mth.name) as have
                        have.add(stem)
                    else
                        var fresh = List(str)()
                        fresh.add(stem)
                        .def_modules.set(mth.name, fresh)
                on Decl.var_ as gv
                    if .global_modules.get(gv.name) as have2
                        have2.add(stem)
                    else
                        var fresh2 = List(str)()
                        fresh2.add(stem)
                        .global_modules.set(gv.name, fresh2)
                else
                    pass

    # the V name of a free function: bare, unless two modules declare the
    # name -- then the current module's own (`<stem>_<name>`) when it declares
    # it, else the first used module's that does
    def freeFnName(name: str): str
        if name == "main"
            return "main"   # the root's main is V's; the used modules' are not emitted
        if .def_modules.get(name) as mods
            if mods.count() > 1
                for s in mods
                    if s == .current_stem
                        return snakeCase(.current_stem) + "_" + vSafe(name)
                if .current_exposed.get(name) as est
                    for s3 in mods
                        if s3 == est
                            return snakeCase(est) + "_" + vSafe(name)   # the use line that exposes the name
                for u in .current_uses
                    for s2 in mods
                        if s2 == u
                            return snakeCase(u) + "_" + vSafe(name)
                return snakeCase(mods.at(0)) + "_" + vSafe(name)
        return vSafe(name)

    # the V name of a module-level var: bare, unless two modules declare the
    # name -- then the current module's own (`<stem>_<name>`) when it declares
    # it, else the first used module's that does (as freeFnName)
    def globalName(name: str): str
        if .global_modules.get(name) as mods
            if mods.count() > 1
                for s in mods
                    if s == .current_stem
                        return snakeCase(.current_stem) + "_" + vSafe(name)
                if .current_exposed.get(name) as est
                    for s3 in mods
                        if s3 == est
                            return snakeCase(est) + "_" + vSafe(name)   # the use line that exposes the name
                for u in .current_uses
                    for s2 in mods
                        if s2 == u
                            return snakeCase(u) + "_" + vSafe(name)
                return snakeCase(mods.at(0)) + "_" + vSafe(name)
        return vSafe(name)

    def isGlobalName(name: str): bool
        return .global_modules.get(name) != nil

    # a nested emitter (a lambda's body) with this one's whole context: every
    # table shared by reference, the scalars copied; its own text and depth
    def cloneContext(): VGen
        var g = VGen()
        g.class_names = .class_names
        g.struct_names = .struct_names
        g.enum_names = .enum_names
        g.union_names = .union_names
        g.sigs = .sigs
        g.member_counts = .member_counts
        g.current_params = .current_params
        g.current_ret = .current_ret
        g.in_method = .in_method
        g.catch_bindings = .catch_bindings
        g.current_fields = .current_fields
        g.module_names = .module_names
        g.current_methods = .current_methods
        g.current_statics = .current_statics
        g.local_types = .local_types
        g.field_types = .field_types
        g.heap_names = .heap_names
        g.global_types = .global_types
        g.union_payloads = .union_payloads
        g.current_file = .current_file
        g.sig_conflicts = .sig_conflicts
        g.rets = .rets
        g.struct_mut = .struct_mut
        g.mut_structs = .mut_structs
        g.def_modules = .def_modules
        g.current_stem = .current_stem
        g.current_uses = .current_uses
        g.current_exposed = .current_exposed
        g.all_field_types = .all_field_types
        g.local_names = .local_names
        g.matchN = .matchN + 1000
        g.current_class = .current_class
        g.tmpN = .tmpN + 1000
        g.ref_params = .ref_params
        g.fn_names = .fn_names
        g.renames = .renames
        g.global_inits = .global_inits
        g.global_modules = .global_modules
        g.iface_names = .iface_names
        g.sig_names = .sig_names
        g.sig_canon = .sig_canon
        g.emitted_globals = .emitted_globals
        g.aliases = .aliases
        g.narrowed = .narrowed
        return g

    def isFnName(vname: str): bool
        for n in .fn_names
            if n == vname
                return true
        return false

    def isMutStruct(name: str): bool
        for n in .mut_structs
            if n == name
                return true
        return false

    # the return type of every def and method, for a call's type
    def noteRets(m: Module)
        .enterModule(m)
        for d in m.decls
            branch d
                on Decl.method as mth
                    .noteRet(.freeFnName(mth.name), mth)   # by the emitted name: a prefixed one has its own entry
                on Decl.class_ as c
                    .noteRetsOf(c.name, c.members)
                on Decl.interface_ as di
                    .noteRetsOf(di.name, di.members)
                on Decl.struct_ as st
                    .noteRetsOf(st.name, st.members)
                else
                    pass

    def noteRetsOf(owner: str, members: List(Decl))
        for mem in members
            branch mem
                on Decl.method as mth
                    .noteRet(owner + "." + mth.name, mth)   # by owner always: read when the receiver's type is known
                    if not mth.mods.is_static
                        .noteRet(mth.name, mth)
                else
                    pass

    def noteRet(key: str, mth: DeclMethod)
        var rt: str = .retType(mth)   # with its `!` when it throws: a `?`-call strips it
        if .rets.get(key) as have
            if have != rt
                .rets.set(key, "")   # two declarations of the name differ: unknown
            return
        .rets.set(key, rt)

    # the V type of a call's result ("" when unknown)
    def retOf(c: ExprCall): str
        branch c.callee
            on Expr.ident as id
                if .isClassName(id.name) or .isStructName(id.name)
                    return .vNamed(id.name)   # a constructor call: the type (a list literal of them is typed by it)
                # a bare call to a method of the enclosing type, a static of it,
                # or a free function
                if .current_class != "" and .isMethodName(id.name)
                    if .rets.get(.current_class + "." + id.name) as mr
                        return mr
                if .current_class != "" and .isStaticName(id.name)
                    if .rets.get(.current_class + "." + id.name) as sr
                        return sr
                if .rets.get(.freeFnName(id.name)) as r
                    return r
                return ""
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isClassName(owner) or .isStructName(owner)
                    if .rets.get(owner + "." + m.member) as r
                        return r
                    return ""
                if .rets.get(m.member) as r
                    return r
                return ""
            else
                return ""

    def noteFieldTypes(m: Module)
        for d in m.decls
            branch d
                on Decl.union_ as un
                    for v in un.variants
                        if v.payload as pt
                            .union_payloads.set(un.name + "_" + v.name, .vType(pt))
                on Decl.class_ as c
                    .noteFieldsOf(c.name, c.members)
                on Decl.struct_ as st
                    .noteFieldsOf(st.name, st.members)
                else
                    pass

    def noteFieldsOf(owner: str, members: List(Decl))
        for mem in members
            branch mem
                on Decl.var_ as f
                    .all_field_types.set(owner + "." + f.name, .vType(f.type_))
                else
                    pass

    # `base except f = v`: a copy with fields replaced -- V's struct update
    # (`Name{ ...base, f: v }`; a class is spread through its pointee and the
    # copy allocated)
    def exceptStr(ex: ExprExcept): str
        var bt: str = .vTypeOf(ex.base)
        var base: str = .exprStr(ex.base)
        if bt == ""
            .refuse("an `except` on an expression whose type the emitter does not know", ex.span)
            return base
        var is_ref: bool = bt.startsWith("&")
        var name: str = bt
        var spread: str = "..." + base
        var fvals = List(str)()
        for f in ex.fields
            var fv: str = .exprStr(f.value)
            if .isRefParamName(f.value)
                fv = "unsafe { " + fv + " }"
            fvals.add(fv)
        var out: str = ""
        if is_ref
            name = bt.substring(1, bt.len)
            spread = "...(*" + base + ")"
            out = "&"
        out = out + name + "{ " + spread
        var fi: int = 0
        for f in ex.fields
            out = out + ", " + vSafe(f.name) + ": " + fvals.at(fi)
            fi = fi + 1
        return out + " }"

    # `U_v` when the expression is a payload-less variant (`U.v` or `U.v()`), else ""
    def variantTypeName(e: Expr): str
        branch e
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner + "_" + m.member
                return ""
            on Expr.call as c
                if c.args.count() != 0
                    return ""
                branch c.callee
                    on Expr.member as m
                        var owner: str = .staticOwner(m.object)
                        if .isUnionName(owner)
                            return owner + "_" + m.member
                        return ""
                    else
                        return ""
            else
                return ""

    def noteSigs(m: Module)
        # the second pass: every callee's signature -- the parameter names and
        # defaults (named arguments are reordered to positions at the call,
        # missing ones filled from the defaults) and which are references (V
        # wants `mut` on a param mutated through a method, at the declaration
        # and at the call)
        .enterModule(m)
        for d in m.decls
            branch d
                on Decl.method as mth
                    .noteSig(.freeFnName(mth.name), mth.params)   # keyed as emitted: a module-prefixed name has its own entry
                on Decl.class_ as c
                    .noteMembers("new_" + snakeCase(c.name), c.members, c.name)
                on Decl.interface_ as di
                    .noteMembers("", di.members, di.name)
                on Decl.sig_ as sg
                    .noteSig("sig:" + sg.name, sg.params)   # a call through a value of this type
                on Decl.struct_ as st
                    .noteMembers("new_" + snakeCase(st.name), st.members, st.name)
                    .noteImplicitCtor("new_" + snakeCase(st.name), st.members)
                else
                    pass

    # the module being walked or emitted: its stem and the stems it uses
    def enterModule(m: Module)
        .current_file = m.file
        .current_stem = moduleStem(m.file)
        .current_uses = List(str)()
        .current_exposed = HashMap(str, str)()
        for d in m.decls
            branch d
                on Decl.use_ as u
                    var segs: List(str) = u.path.split("/")
                    .current_uses.add(segs.at(segs.count() - 1))
                    for ex in u.exposed
                        .current_exposed.set(ex, segs.at(segs.count() - 1))
                else
                    pass

    def genDecl(d: Decl)
        branch d
            on Decl.class_ as c
                .genClass(c)
            on Decl.method as mth
                .genFunction(mth)
            on Decl.var_ as v
                .genGlobal(v)
            on Decl.use_
                pass   # the route folded the used module into this file
            on Decl.struct_ as st
                .genStruct(st)
            on Decl.enum_ as en
                .genEnum(en)
            on Decl.interface_ as i
                .genInterface(i)
            on Decl.union_ as un
                .genUnion(un)
            on Decl.sig_ as sg
                # a function type: `sig F(c: char): bool` -> `type F = fn (c u8) bool`
                var ret = .vType(sg.return_type)
                var head = "type " + sg.name + " = fn (" + .genParams(sg.params) + ")"
                if ret != ""
                    head = head + " " + ret
                if .sig_canon.get(sg.name) as owner
                    # the same shape as an earlier sig: spelled by that name wherever it is named
                    .line("// " + head + "   -- spelled " + owner + " (one V instantiation per fn shape: vlang/v#30282)")
                else
                    .line(head)
                .line("")
            on Decl.namespace_ as ns
                .refuse("namespace " + ns.name + " (flattening is the next step)", ns.span)
            on Decl.type_alias_ as ta
                if ta.params.count() > 0 or ta.constraint != nil
                    .refuse("type alias " + ta.name + " with parameters or a constraint", ta.span)
                # else: resolved to its base wherever named; nothing emitted
            on Decl.mixin_ as mx
                .refuse("mixin " + mx.name, mx.span)
            on Decl.extend_ as ex
                .refuse("an extend declaration", ex.span)
            else
                .refused.add("a declaration kind the subset does not spell")

    def genGlobal(v: DeclVar)
        if v.init_expr != nil
            var rhs: str = .exprStr(v.init_expr!)
            var gname: str = .globalName(v.name)
            if v.type_ as t
                var gt: str = .vType(t)
                .global_types.set(gname, gt)   # keyed by the emitted name: two modules' same-named vars differ
                if gt == "i64" and isIntLit(v.init_expr!)
                    rhs = "i64(" + rhs + ")"
            if v.is_const
                .line("const " + gname + " = " + rhs)
            else
                # a mutable module-level var: V's __global, which the run must
                # enable (-enable-globals on the run line the route prints);
                # declared by type and set in zglobals_init() at main's start --
                # MSVC refuses V's static initializer for a string global
                var gt2: str = ""
                if v.type_ as t2
                    gt2 = .vType(t2)
                if gt2 == ""
                    gt2 = .ctorTypeOf(v.init_expr!)
                if gt2 == ""
                    gt2 = .vTypeOf(v.init_expr!)
                if gt2 == "" and isIntLit(v.init_expr!)
                    gt2 = "i64"
                if gt2 == "" and isStringLit(v.init_expr!)
                    gt2 = "string"
                if gt2 == ""
                    .refuse("module-level var " + v.name + " whose type the emitter cannot name (declare it)", v.span)
                    gt2 = "voidptr"
                .global_types.set(gname, gt2)
                .line("__global (")
                .line("\t" + gname + " " + gt2)
                .line(")")
                .global_inits.add(gname + " = " + rhs)
                .has_globals = true
        else
            .refuse("module-level var " + v.name + " without an initializer", v.span)

    def noteMembers(ctor: str, members: List(Decl), owner: str)
        for mem in members
            branch mem
                on Decl.init as ini
                    .noteSig(ctor, ini.params)
                on Decl.method as cm
                    if cm.mods.is_static
                        .noteSig(snakeCase(owner) + "_" + vSafe(cm.name), cm.params)   # as the static is emitted and called
                    else
                        .noteSig("." + vSafe(cm.name), cm.params)   # methods under `.name`: apart from the free functions
                        .noteSig(owner + "." + vSafe(cm.name), cm.params)   # by owner too: no collision when the receiver's type is known
                else
                    pass

    # a struct with no `cue init` is constructed from its fields, every one
    # named or in order, a missing one zero (Zebra's implicit constructor)
    def noteImplicitCtor(ctor: str, members: List(Decl))
        if .sigs.get(ctor) != nil
            return
        var fsig = FnSig()
        for mem in members
            branch mem
                on Decl.var_ as f
                    fsig.names.add(f.name)
                    fsig.has_default.add(true)
                    fsig.defaults.add(.zeroExpr(f))
                    fsig.refs.add(.isRefType(f.type_))
                    fsig.types.add(.vType(f.type_))
                else
                    pass
        .sigs.set(ctor, fsig)

    # a field's zero as an expression the call can spell (the literal kinds;
    # a container or a class field falls back to nil, which the V side
    # spells as its constructor through zeroOf at the struct literal)
    def zeroExpr(f: DeclVar): Expr
        var t = .vType(f.type_)
        if t == "i64": return Expr.int_lit(ExprIntLit(f.span, "0", IntBase.decimal))
        if t == "f64": return Expr.float_lit(ExprFloatLit(f.span, "0.0"))
        if t == "string": return Expr.string_lit(ExprStringLit(f.span, StringKind.plain, ""))
        if t == "bool": return Expr.bool_lit(ExprBoolLit(f.span, false))
        return Expr.nil_(f.span)

    def noteSig(name: str, params: List(Param))
        if .sigs.get(name) as have
            # another declaration of this name: the same parameter names keep the
            # table's entry; different ones make the name positional-only
            var same: bool = have.names.count() == params.count()
            if same
                var k: int = 0
                for p in params
                    if have.names.at(k) != p.name
                        same = false
                    k = k + 1
            if not same
                .sig_conflicts.add(name)
            return
        var fsig = FnSig()
        for p in params
            fsig.names.add(p.name)
            if p.default_ as d
                fsig.has_default.add(true)
                fsig.defaults.add(d)
            else
                fsig.has_default.add(false)
                fsig.defaults.add(Expr.nil_(p.span))
            fsig.refs.add(.isRefType(p.type_))
            fsig.types.add(.vType(p.type_))
        .sigs.set(name, fsig)
        var flags = List(bool)()
        for p in params
            flags.add(.isRefType(p.type_))
        .ref_params.set(name, flags)

    # a container or a class: by reference in V, so `mut` when passed to be mutated
    # a parameter (or a capture) of this type is `mut`: a reference (a class,
    # a heap struct, a container). Not a value struct: V would then demand
    # `mut` at every call site, and a method name many classes share is
    # called by position. `f(mut p.field)` through an immutable parameter is
    # the call site's problem (argsBySig binds the field to a local first).
    def isRefType(t: TypeRef?): bool
        if t == nil
            return false
        var vt: str = .vType(t)
        return vt.startsWith("&") or .isIfaceName(vt)   # (an interface value is a pointer; a method on it needs mut)

    def genParams(params: List(Param)): str
        var out: str = ""
        var first: bool = true
        for p in params
            if not first
                out = out + ", "
            first = false
            var mut_: str = ""
            var pt: str = .vType(p.type_)
            if .isRefType(p.type_)
                # `mut x T` for a reference, never `mut x &T`: V's `mut x &T` is a
                # pointer to the caller's slot, and x used as a value (stored,
                # passed on) is that slot's address, not the object
                mut_ = "mut "
                if pt.startsWith("&")
                    pt = pt.substring(1, pt.len)   # (an interface's value is passed plain)
            out = out + mut_ + vSafe(p.name) + " " + pt
        return out

    # a `throws` def returns V's result (`!T`, `!` for none); `raise` is
    # `return error(...)`, `?` is `!`
    # `!?T` in the type table is spelled `!ZOpt[T]` in a signature (V has no `!?T`)
    def retSpelling(ret: str): str
        if ret.startsWith("!?")
            return "!ZOpt[" + ret.substring(2, ret.len) + "]"
        return ret

    def retType(m: DeclMethod): str
        var ret = .vType(m.return_type)
        if m.throws_
            return "!" + ret
        return ret

    def genFunction(m: DeclMethod)
        var ret = .retType(m)
        var head = "fn " + .freeFnName(m.name) + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + .retSpelling(ret)
        .line(head + " {")
        .depth = .depth + 1
        if m.name == "main" and .has_globals
            .line("zglobals_init()")
        .current_params = m.params
        .current_ret = ret
        .in_method = false
        .resetLocals(m.params)
        if m.stmts as body
            .genBody(body, vSafe(m.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── classes ────────────────────────────────────────────────────────────
    def genClass(c: DeclClass)
        if c.type_params.count() > 0
            .refuse("class " + c.name + " with type parameters", c.span)
        if c.mixins.count() > 0
            .refuse("class " + c.name + " mixes in (mixins are outside the subset)", c.span)
        # (implements: nothing to emit -- V's interfaces are structural)
        .line("@[heap]")   # a class is a reference: allocated, and storable in a field (V's escape rule)
        .line("struct " + c.name + " {")
        .line("mut:")
        .depth = .depth + 1
        for mem in c.members
            branch mem
                on Decl.var_ as f
                    .line(vSafe(f.name) + " " + .vType(f.type_))
                else
                    pass
        .depth = .depth - 1
        .line("}")
        .line("")
        .current_class = c.name
        .current_fields = fieldNames(c.members)
        .field_types = .fieldTypes(c.members)
        .current_methods = methodNames(c.members, false)
        .current_statics = methodNames(c.members, true)
        var had_init: bool = false
        for mem in c.members
            branch mem
                on Decl.init as ini
                    had_init = true
                    .genInit(ini, c.name, c.members)
                on Decl.method as mth
                    if mth.mods.is_static
                        .genStaticMethod(mth, c.name)
                    else
                        .genMethod(mth, c.name)
                on Decl.var_
                    pass
                else
                    .refuse("a member kind the subset does not spell in class " + c.name, c.span)
        if not had_init
            .line("fn new_" + snakeCase(c.name) + "() &" + c.name + " {")
            .depth = .depth + 1
            .line("return " + .structLit(c.name, c.members))
            .depth = .depth - 1
            .line("}")
            .line("")
        .current_class = ""
        .current_methods = List(str)()
        .current_statics = List(str)()
        .current_fields = List(str)()

    # `&Name{ ... }` with every reference field initialised (V refuses an
    # uninitialised reference field): a container by its constructor, a
    # class-typed field by `unsafe { nil }` (Zebra's zero for it)
    def structLit(owner: str, members: List(Decl), by_ref: bool = true): str
        var out: str = owner + "{"
        if by_ref
            out = "&" + out
        var any: bool = false
        for mem in members
            branch mem
                on Decl.var_ as f
                    var ft = .vType(f.type_)
                    if ft.startsWith("&")
                        var field_init: str = "unsafe { nil }"   # (not `init`: it shadows a declaration in the emitted Zig)
                        if ft.startsWith("&ZList[") or ft.startsWith("&ZMap[") or ft.startsWith("&ZSet[") or ft == "&ZStringBuilder"
                            field_init = .zeroOf(ft)   # a container starts empty, never nil (Zebra's default)
                        if not any
                            out = out + "\n"
                        any = true
                        out = out + "\t" + vSafe(f.name) + ": " + field_init + "\n"
                else
                    pass
        return out + "}"

    # ── interfaces: V's, every method under mut: (a class's methods are mut self) ──
    def genInterface(i: DeclInterface)
        if i.type_params.count() > 0
            .refuse("interface " + i.name + " with type parameters", i.span)
        .line("interface " + i.name + " {")
        for base in i.ifaces
            .line("\t" + .vType(base))   # an embedded interface
        .line("mut:")
        for mem in i.members
            branch mem
                on Decl.method as mth
                    var ret: str = .retType(mth)
                    var head: str = "\t" + vSafe(mth.name) + "(" + .genParams(mth.params) + ")"
                    if ret != ""
                        head = head + " " + ret
                    .line(head)
                else
                    .refuse("a member kind the subset does not spell in interface " + i.name, i.span)
        .line("}")
        .line("")

    # ── value structs: V structs by value, a constructor by value, methods
    #    `mut` when the body assigns to a field ──────────────────────────────
    def genStruct(st: DeclStruct)
        var heap: bool = .isHeapName(st.name)
        var ret_name: str = st.name
        if heap
            .line("@[heap]")
            ret_name = "&" + st.name
        .line("struct " + st.name + " {")
        .line("pub mut:")
        .depth = .depth + 1
        for mem in st.members
            branch mem
                on Decl.var_ as f
                    .line(vSafe(f.name) + " " + .vType(f.type_))
                else
                    pass
        .depth = .depth - 1
        .line("}")
        .line("")
        .current_class = st.name
        .current_fields = fieldNames(st.members)
        .field_types = .fieldTypes(st.members)
        .current_methods = methodNames(st.members, false)
        .current_statics = methodNames(st.members, true)
        # every method `mut self` when any assigns a field (the pass decided):
        # a method that calls a mutating one needs the receiver mutable too,
        # and V refuses a mutation through an immutable receiver
        .struct_mut = .isMutStruct(st.name)
        var had_init: bool = false
        for mem in st.members
            branch mem
                on Decl.init as ini
                    had_init = true
                    .line("fn new_" + snakeCase(st.name) + "(" + .genParams(ini.params) + ") " + ret_name + " {")
                    .depth = .depth + 1
                    .resetLocals(ini.params)
                    .line("mut self := " + .structLit(st.name, st.members, heap))
                    if ini.stmts as body
                        .genStmts(body)
                    .line("return self")
                    .depth = .depth - 1
                    .line("}")
                    .line("")
                on Decl.method as mth
                    .genValueMethod(mth, st.name)
                on Decl.var_
                    pass
                else
                    .refuse("a member kind the subset does not spell in struct " + st.name, st.span)
        if not had_init
            # the implicit constructor: every field a parameter, in order
            var ps: str = ""
            var lit: str = st.name + "{"
            var any: bool = false
            for mem in st.members
                branch mem
                    on Decl.var_ as f
                        if ps != ""
                            ps = ps + ", "
                        var fpt: str = .vType(f.type_)
                        if .isRefType(f.type_)
                            ps = ps + "mut "   # (the recorded signature flags it: the call passes `mut`)
                            if fpt.startsWith("&")
                                fpt = fpt.substring(1, fpt.len)   # `mut x T`, never `mut x &T` (see genParams)
                        ps = ps + vSafe(f.name) + " " + fpt
                        if not any
                            lit = lit + "\n"
                        any = true
                        lit = lit + "\t" + vSafe(f.name) + ": " + vSafe(f.name) + "\n"
                    else
                        pass
            if heap
                lit = "&" + lit
            .line("fn new_" + snakeCase(st.name) + "(" + ps + ") " + ret_name + " {")
            .depth = .depth + 1
            .line("return " + lit + "}")
            .depth = .depth - 1
            .line("}")
            .line("")
        .current_class = ""
        .current_methods = List(str)()
        .current_statics = List(str)()
        .current_fields = List(str)()

    # a struct's method: `mut self` only when the body assigns to a field
    # (V refuses a mutation through an immutable receiver, and warns on a
    # `mut` never used); `cue toString()` is V's str()
    def genValueMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var mname = vSafe(m.name)
        if m.name == "toString" and m.params.count() == 0
            mname = "str"
        var recv: str = "self " + owner
        if .struct_mut
            recv = "mut self " + owner
        var head = "fn (" + recv + ") " + mname + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + .retSpelling(ret)
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .in_method = true
        .resetLocals(m.params)
        if m.stmts as body
            .genBody(body, vSafe(m.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── enums ──────────────────────────────────────────────────────────────
    def genEnum(en: DeclEnum)
        if en.base != nil
            .refuse("enum " + en.name + " with a base type", en.span)
        .line("enum " + en.name + " {")
        .depth = .depth + 1
        for mem in en.members
            if mem.value != nil
                .refuse("enum member " + en.name + "." + mem.name + " with a value", mem.span)
            .line(vSafe(mem.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── unions: a V sum type over one struct per variant (`U_v { payload T }`,
    #    empty when the variant carries none) ─────────────────────────────────
    def genUnion(un: DeclUnion)
        var names: str = ""
        for v in un.variants
            var vname = un.name + "_" + v.name
            if names != ""
                names = names + " | "
            names = names + vname
            if v.payload as pt
                .line("struct " + vname + " {")
                .line("pub mut:")
                .line("\tpayload " + .vType(pt))
                .line("}")
            else
                .line("struct " + vname + " {}")
            .line("")
        .line("type " + un.name + " = " + names)
        .line("")

    def genInit(ini: DeclInit, owner: str, members: List(Decl))
        .line("fn new_" + snakeCase(owner) + "(" + .genParams(ini.params) + ") &" + owner + " {")
        .depth = .depth + 1
        .resetLocals(ini.params)
        .line("mut self := " + .structLit(owner, members))
        if ini.stmts as body
            .in_ctor = true
            .genBody(body, "new_" + snakeCase(owner))
            .in_ctor = false
        .line("return self")
        .depth = .depth - 1
        .line("}")
        .line("")

    # a `static def` is a free function named <class>_<method>; a call on the
    # class's name reaches it
    def genStaticMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var head = "fn " + snakeCase(owner) + "_" + vSafe(m.name) + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + .retSpelling(ret)
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .in_method = false
        .resetLocals(m.params)
        var saved = .current_fields
        .current_fields = List(str)()   # no self in a static method
        if m.stmts as body
            .genBody(body, snakeCase(owner) + "_" + vSafe(m.name))
        .current_fields = saved
        .depth = .depth - 1
        .line("}")
        .line("")

    def resetLocals(params: List(Param))
        .local_names = List(str)()
        .local_types = HashMap(str, str)()
        for p in params
            .local_names.add(p.name)
            var pt: str = .vType(p.type_)
            if pt != ""
                .local_types.set(p.name, pt)

    def fieldTypes(members: List(Decl)): HashMap(str, str)
        var out = HashMap(str, str)()
        for mem in members
            branch mem
                on Decl.var_ as f
                    out.set(f.name, .vType(f.type_))
                else
                    pass
        return out

    # the V type of a name or a field access, "" when the emitter does not
    # know it (a call's result, an element): a local or a param first, then
    # a field of the enclosing type (bare, or through self)
    def vTypeOf(e: Expr): str
        branch e
            on Expr.ident as id
                if .local_types.get(id.name) as lt
                    if lt.startsWith("?") and .isNarrowed(id.name)
                        return lt.substring(1, lt.len)   # Zebra reads it narrowed: the inner type
                    return lt
                if .isCurrentField(id.name)
                    if .field_types.get(id.name) as ft
                        return ft
                if .isGlobalName(id.name) and not .isLocalName(id.name)
                    if .global_types.get(.globalName(id.name)) as gt
                        return gt
                return ""
            on Expr.member as m
                if exprRootIsThis(m.object)
                    if .field_types.get(m.member) as ft
                        return ft
                var ot: str = .vTypeOf(m.object)
                if ot.startsWith("&")
                    ot = ot.substring(1, ot.len)
                if ot.startsWith("ZTuple") and isDigits(m.member)
                    return tupleElemType(ot, m.member)
                if ot != ""
                    if .all_field_types.get(ot + "." + m.member) as ft2
                        return ft2
                return ""
            on Expr.call as c
                # `xs.at(i)`: the list's element type; else the callee's return type
                branch c.callee
                    on Expr.member as cm
                        if cm.member == "at" and c.args.count() == 1
                            return .elemOf(.vTypeOf(cm.object))
                        var ot: str = .vTypeOf(cm.object)
                        if cm.member == "last" and c.args.count() == 0
                            return .elemOf(ot)
                        var rown: str = ot
                        if rown.startsWith("&")
                            rown = rown.substring(1, rown.len)
                        if rown != ""
                            if .rets.get(rown + "." + cm.member) as orr
                                return orr   # the receiver's own method's type
                        if isStringReturningMethod(cm.member)
                            return "string"
                        var jowner: str = .staticOwner(cm.object)
                        if jowner == "Arg" and cm.member == "parse"
                            return "ZArgs"
                        if jowner == "Random" and cm.member == "new"
                            return "&ZRandom"
                        if jowner == "DateTime" and cm.member == "now"
                            return "ZDateTime"
                        if jowner == "Sqlite" and cm.member == "open"
                            return "?&ZSqliteDb"
                        if ot == "&ZSqliteDb" and cm.member == "query"
                            return "&ZList[&ZSqliteRow]"
                        if jowner == "Dir" and cm.member == "list"
                            return "&ZList[string]"
                        if jowner == "File" and (cm.member == "listDir" or cm.member == "readLines")
                            return "&ZList[string]"
                        if jowner == "sys"
                            if cm.member == "run"
                                return "ZRunResult"
                            if cm.member == "args"
                                return "&ZList[string]"
                            if cm.member == "getenv" or cm.member == "readLine"
                                return "?string"
                        if ot == "ZArgs"
                            if cm.member == "option" or cm.member == "unknownFlag" or cm.member == "usage"
                                return "string"
                            if cm.member == "optionInt"
                                return "i64"
                            if cm.member == "positional"
                                return "?string"
                            if cm.member == "contains" or cm.member == "flag"
                                return "bool"
                        if jowner == "Json"
                            if cm.member == "parse"
                                return "?json2.Any"
                            if cm.member == "object" or cm.member == "array"
                                return "json2.Any"
                        if ot == "json2.Any" or (ot == "" and isJsonOnlyMethod(cm.member))
                            if cm.member == "get" or cm.member == "tryObj"
                                return "?json2.Any"
                            if cm.member == "tryStr"
                                return "?string"
                            if cm.member == "tryInt"
                                return "?i64"
                            if cm.member == "tryFloat"
                                return "?f64"
                            if cm.member == "tryBool"
                                return "?bool"
                            if cm.member == "tryList"
                                return "?&ZList[json2.Any]"
                            if cm.member == "keys"
                                return "&ZList[string]"
                            if cm.member == "values"
                                return "&ZList[json2.Any]"
                        if (cm.member == "chars" or cm.member == "bytes") and c.args.count() == 0 and (ot == "string" or ot == "")
                            return "&ZList[u8]"
                        if (cm.member == "lines" and c.args.count() == 0) or (cm.member == "split" and c.args.count() == 1)
                            return "&ZList[string]"
                        if cm.member == "chars" and c.args.count() == 0
                            return "&ZList[u8]"
                        if (cm.member == "get" or cm.member == "fetch") and c.args.count() == 1 and ot.startsWith("&ZMap[")
                            # the map's value type: `?V` for get, V for fetch
                            var inner: str = ot.substring(6, ot.len - 1)
                            var cut: int = inner.indexOf(", ")
                            if cut > 0
                                var vt: str = inner.substring(cut + 2, inner.len)
                                if cm.member == "get"
                                    return "?" + vt
                                return vt
                        if c.args.count() == 0
                            if cm.member == "copy"
                                return ot
                            if cm.member == "items" and ot.startsWith("&ZSet[")
                                return "&ZList[" + ot.substring(6, ot.len - 1) + "]"
                            if (cm.member == "keys" or cm.member == "values") and ot.startsWith("&ZMap[")
                                var inner: str = ot.substring(6, ot.len - 1)
                                var cut: int = inner.indexOf(", ")
                                if cut > 0
                                    if cm.member == "keys"
                                        return "&ZList[" + inner.substring(0, cut) + "]"
                                    return "&ZList[" + inner.substring(cut + 2, inner.len) + "]"
                        return .retOf(c)
                    else
                        return .retOf(c)
            on Expr.try_ as t
                var tt: str = .vTypeOf(t.expr)   # `f()?`: the result's type, the `!` gone
                if tt.startsWith("!")
                    return tt.substring(1, tt.len)
                return tt
            on Expr.slice as sl
                return .vTypeOf(sl.object)   # a slice of a string is a string, of a list a list
            on Expr.string_lit
                return "string"
            on Expr.string_interp
                return "string"
            on Expr.int_lit
                return "i64"
            on Expr.float_lit
                return "f64"
            on Expr.bool_lit
                return "bool"
            on Expr.char_lit
                return "u8"
            on Expr.index as ix
                var ixo: str = .vTypeOf(ix.object)
                if ixo == "json2.Any"
                    return "!json2.Any"   # a subscript on a Json value is a result (`j[k]?`)
                if ixo.startsWith("&ZList[")
                    return .elemOf(ixo)
                if ixo == "string"
                    return "u8"
                return ""
            on Expr.orelse_ as oe
                var oet: str = .vTypeOf(oe.expr)   # `x orelse y`: the option's inner type
                if oet.startsWith("?")
                    return oet.substring(1, oet.len)
                return oet
            on Expr.catch_ as ce
                var cet: str = .vTypeOf(ce.expr)   # `f() catch y`: the result's type
                if cet.startsWith("!")
                    return cet.substring(1, cet.len)
                return cet
            on Expr.to_non_nil as tnn
                var it: str = .vTypeOf(tnn.expr)   # `x!`: the option's inner type
                if it.startsWith("?")
                    return it.substring(1, it.len)
                return it
            on Expr.this_
                if .current_class == ""
                    return ""
                if .isClassName(.current_class)
                    return "&" + .current_class
                return .current_class
            on Expr.list_lit as ll
                var lt: str = .listLitElemType(ll)   # (an iterated literal of references takes the mutable loop)
                if lt == ""
                    return ""
                return "&ZList[" + lt + "]"
            on Expr.unary as u
                # `-x`, `not x`: the operand's type (bool for not)
                if u.op == UnaryOp.not_
                    return "bool"
                return .vTypeOf(u.operand)
            on Expr.binary as bn
                # arithmetic: the left's type, else the right's; a comparison or
                # a logical op: bool (an untyped `var dot = 0 - 1` is i64 by it)
                if bn.op == BinaryOp.eq or bn.op == BinaryOp.ne or bn.op == BinaryOp.lt or bn.op == BinaryOp.le or bn.op == BinaryOp.gt or bn.op == BinaryOp.ge or bn.op == BinaryOp.and_ or bn.op == BinaryOp.or_ or bn.op == BinaryOp.in_
                    return "bool"
                if bn.op == BinaryOp.dotdot
                    return ""
                var blt: str = .vTypeOf(bn.left)
                if blt != "" and blt != "json2.Any"
                    return blt
                var brt: str = .vTypeOf(bn.right)
                if brt != "json2.Any"
                    return brt
                return ""
            on Expr.tuple_lit as tl
                var tparts: str = ""
                for el in tl.elems
                    var et: str = .vTypeOf(el)
                    if et == ""
                        return ""
                    if tparts != ""
                        tparts = tparts + ", "
                    tparts = tparts + et
                return "ZTuple" + tl.elems.count().toString() + "[" + tparts + "]"
            else
                return ""

    # a body that assigns a field of the enclosing type: through `this`, or by
    # a bare field name (Zebra allows it inside the type)
    def bodyAssignsField(stmts: List(Stmt)): bool
        for s in stmts
            if .stmtAssignsField(s)
                return true
        return false

    def stmtAssignsField(s: Stmt): bool
        branch s
            on Stmt.assign as a
                if exprRootIsThis(a.target)
                    return true
                branch a.target
                    on Expr.ident as id
                        return .isCurrentField(id.name)
                    on Expr.member as m
                        branch m.object
                            on Expr.ident as oid
                                return .isCurrentField(oid.name)   # `field.x = v`
                            else
                                return false
                    else
                        return false
            on Stmt.if_ as i
                if .bodyAssignsField(i.then_stmts)
                    return true
                for ei in i.else_ifs
                    if .bodyAssignsField(ei.stmts)
                        return true
                if i.else_stmts as es
                    return .bodyAssignsField(es)
                return false
            on Stmt.while_ as w
                return .bodyAssignsField(w.stmts)
            on Stmt.for_in as fi
                return .bodyAssignsField(fi.stmts)
            on Stmt.for_num as fnum
                return .bodyAssignsField(fnum.stmts)
            on Stmt.branch_ as b
                for arm in b.cases
                    if .bodyAssignsField(arm.stmts)
                        return true
                if b.else_ as es
                    return .bodyAssignsField(es)
                return false
            on Stmt.try_catch as tc
                if .bodyAssignsField(tc.stmts)
                    return true
                for cl in tc.clauses
                    if .bodyAssignsField(cl.stmts)
                        return true
                return false
            else
                return false

    # a binding of this type is `mut`: a struct, a class or a container may
    # be passed on as `mut x.field`, which V refuses through an immutable one
    def needsMut(vt: str): bool
        # a reference (a class, a heap struct, a container), a value struct or
        # an interface; V refuses `mut` on a sum type, an enum or a function type
        if vt.startsWith("&")
            return true
        return .isStructName(vt) or .isIfaceName(vt)

    # the element type of a list's V type ("" when it is not a list)
    def elemOf(vt: str): str
        if vt.startsWith("&ZList[") and vt.endsWith("]")
            return vt.substring(7, vt.len - 1)
        return ""

    def isContainerType(vt: str): bool
        return vt.startsWith("&ZList[") or vt.startsWith("&ZMap[") or vt.startsWith("&ZSet[")

    # the V type a constructor call makes, "" when it is not one
    def ctorTypeOf(e: Expr): str
        branch e
            on Expr.call as c
                branch c.callee
                    on Expr.ident as id
                        if .isClassName(id.name)
                            return "&" + id.name
                        if .isStructName(id.name)
                            return id.name
                        if id.name == "StringBuilder"
                            return "&ZStringBuilder"
                        return ""
                    on Expr.call as inner
                        branch inner.callee
                            on Expr.ident as cid
                                if cid.name == "List" and inner.args.count() == 1
                                    return "&ZList[" + .typeArgStr(inner.args.at(0).value) + "]"
                                if cid.name == "HashMap" and inner.args.count() == 2
                                    return "&ZMap[" + .typeArgStr(inner.args.at(0).value) + ", " + .typeArgStr(inner.args.at(1).value) + "]"
                                if cid.name == "Set" and inner.args.count() == 1
                                    return "&ZSet[" + .typeArgStr(inner.args.at(0).value) + "]"
                                return ""
                            else
                                return ""
                    else
                        return ""
            else
                return ""

    # the union a variant expression belongs to, "" when it is not one:
    # `U.v(x)`, `U.v()`, `U.v`
    def unionOfExpr(e: Expr): str
        branch e
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        var owner: str = .staticOwner(m.object)
                        if .isUnionName(owner)
                            return owner
                        return ""
                    else
                        return ""
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner
                return ""
            else
                return ""

    def isMethodName(name: str): bool
        for n in .current_methods
            if n == name
                return true
        return false

    def isStaticName(name: str): bool
        for n in .current_statics
            if n == name
                return true
        return false

    def isLocalName(name: str): bool
        for n in .local_names
            if n == name
                return true
        return false

    def isCurrentField(name: str): bool
        for f in .current_fields
            if f == name
                return true
        return false

    def genMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var mname: str = vSafe(m.name)
        if m.name == "toString" and m.params.count() == 0
            mname = "str"   # V's own name for it, as a struct's is
        var head = "fn (mut self " + owner + ") " + mname + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + .retSpelling(ret)
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .in_method = true
        .resetLocals(m.params)
        if m.stmts as body
            .genBody(body, vSafe(m.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── statements ─────────────────────────────────────────────────────────
    def genStmts(stmts: List(Stmt))
        var nmark: int = .narrowed.count()
        # a statement list is a scope: a local (and a rename) it declares is
        # gone after it, as in V and in Zebra -- else a capture declared in
        # one loop body reads as "already declared" in the next
        var saved_ln = .local_names.copy()   # (containers are references: the restore needs its own copy)
        var saved_rn = .renames.copy()
        var i: int = 0
        for s in stmts
            .genStmt(s)
            branch s
                on Stmt.var_ as v
                    # a local nothing after it READS (an assignment is no read to V):
                    # acknowledged, or V's unused variable
                    if not readsName(v.name, restOf(stmts, i + 1))
                        .line("_ = " + .localName(v.name))
                else
                    pass
            i = i + 1
        while .narrowed.count() > nmark
            .narrowed.remove(.narrowed.count() - 1)
        .local_names = saved_ln
        .renames = saved_rn

    def isNarrowed(zname: str): bool
        for n in .narrowed
            if n == zname
                return true
        return false

    def unnarrow(zname: str)
        var i: int = 0
        while i < .narrowed.count()
            if .narrowed.at(i) == zname
                .narrowed.remove(i)
                return
            i = i + 1

    # the LOCAL a condition compares with nil (`x != nil` when want_ne, else
    # `x == nil`): its Zebra name, "" for any other condition
    def nilCmpLocal(e: Expr, want_ne: bool): str
        branch e
            on Expr.binary as b
                var is_ne: bool = b.op == BinaryOp.ne
                var is_eq: bool = b.op == BinaryOp.eq
                if not (is_ne or is_eq)
                    return ""
                if is_ne != want_ne
                    return ""
                var side: Expr = b.left
                if isNilLit(b.left)
                    side = b.right
                else if not isNilLit(b.right)
                    return ""
                branch side
                    on Expr.ident as id
                        if .isLocalName(id.name)
                            if .local_types.get(id.name) as lt
                                if lt.startsWith("?")
                                    return id.name
                        return ""
                    on Expr.member as sm
                        # `.field == nil`: the field of this, keyed as it is spelled
                        branch sm.object
                            on Expr.this_
                                if .field_types.get(sm.member) as ft
                                    if ft.startsWith("?")
                                        return "self." + vSafe(sm.member)
                                return ""
                            else
                                return ""
                    else
                        return ""
            else
                return ""

    # a local's V name (renamed when it collides with a free function)
    def localName(zname: str): str
        if .renames.get(zname) as rn
            return rn
        return vSafe(zname)

    def genStmt(s: Stmt)
        branch s
            on Stmt.var_ as v
                .genLocal(v)
            on Stmt.assign as a
                branch a.target
                    on Expr.ident as aid
                        .unnarrow(aid.name)   # assigned again: nilable again
                    on Expr.member as am
                        branch am.object
                            on Expr.this_
                                .unnarrow("self." + vSafe(am.member))
                            else
                                pass
                    else
                        pass
                var tt: str = .vTypeOf(a.target)
                if isBareCtor(a.value) and tt != ""
                    .line(.exprStr(a.target) + " " + assignOpV(a.op) + " " + .zeroOf(tt))   # `out = List()`: the target's type
                else
                    var rhs: str = .coerced(a.value, tt)
                    if .isRefParamName(a.value) and (tt.startsWith("&") or tt.startsWith("?&"))
                        rhs = "unsafe { " + rhs + " }"   # a reference parameter kept in a field: V's escape rule refuses it plain
                    .line(.exprStr(a.target) + " " + assignOpV(a.op) + " " + rhs)
            on Stmt.expr as e
                .genExprStmt(e)
            on Stmt.if_ as i
                .genIf(i)
            on Stmt.while_ as w
                .in_cond = true
                var wcond: str = condStr(.exprStr(w.cond))
                .in_cond = false
                .line("for " + wcond + " {")
                .depth = .depth + 1
                .genStmts(w.stmts)
                .depth = .depth - 1
                .line("}")
            on Stmt.for_in as fi
                .genForIn(fi)
            on Stmt.for_num as fnum
                var v = vSafe(fnum.var_)
                .local_names.add(fnum.var_)
                var step: str = "++"
                if fnum.step != nil
                    step = " += " + .exprStr(fnum.step!)
                .line("for " + v + " := i64(" + .exprStr(fnum.start) + "); " + v + " < " + .exprStr(fnum.stop_) + "; " + v + step + " {")
                .depth = .depth + 1
                .genStmts(fnum.stmts)
                .depth = .depth - 1
                .line("}")
            on Stmt.return_ as r
                if r.value as rv
                    if .current_ret.startsWith("!?")
                        # a nilable-and-throws def: the value wrapped (see retSpelling)
                        var wt: str = .current_ret.substring(2, .current_ret.len)
                        if isNilLit(rv)
                            .line("return ZOpt[" + wt + "]{}")
                        else if .vTypeOf(rv).startsWith("?")
                            .line("return zopt_from(" + .exprStr(rv) + ")")
                        else
                            .line("return ZOpt[" + wt + "]{ has: true, val: " + .exprStr(rv) + " }")
                    else
                        .line("return " + .exprStr(rv))
                else if .in_ctor
                    .line("return self")   # a `cue init` returning early: the object
                else
                    .line("return")
            on Stmt.assert_ as asrt
                # never V's `assert`: -prod drops it, statement and all, and a
                # Zebra assert is evaluated in every build (the act is often
                # inside it: `assert h.damage(x) == "Dead"`). The Zig backend's
                # own words on failure.
                var place: str = .vStringLit("assert failed at " + .current_file + ":" + asrt.span.line.toString() + ": ")
                var cs: str = .exprStr(asrt.cond)   # (rendered once: a render binds temporaries)
                var what: str = ""
                if asrt.message as msg
                    what = .exprStr(msg)
                else
                    what = .vStringLit(cs)
                .line("if !(" + cs + ") {")
                .line("\tpanic(" + place + " + " + what + ")")
                .line("}")
            on Stmt.print_ as p
                .genPrint(p)
            on Stmt.break_
                .line("break")
            on Stmt.continue_
                .line("continue")
            on Stmt.pass_
                pass
            on Stmt.branch_ as b
                .genBranch(b)
            on Stmt.raise_ as r
                .genRaise(r)
            on Stmt.try_catch as tc
                .genTryCatch(tc)
            else
                .refused.add("a statement kind the subset does not spell (with, in, destructure, allocate, copy-out, contract, yield)")

    # an expression statement; a mutating method on a call's RESULT binds a
    # temporary first (V: "cannot pass expression as mut"): `rows.at(0).add(7)`
    def genExprStmt(e: Expr)
        branch e
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        if isJsonPutMethod(m.member) and isNameExpr(m.object) and (.vTypeOf(m.object) == "json2.Any" or (isJsonOnlyMethod(m.member) and .vTypeOf(m.object) == ""))
                            # `j.put(k, v)` -> `j = zjson_put(j, k, v)`: the value semantics kept
                            var jobj: str = .exprStr(m.object)
                            var helper: str = "zjson_" + snakeCase(m.member)
                            if m.member == "put" or m.member == "append"
                                # a Json value or a string: the last argument's type decides
                                var lastArg = c.args.at(c.args.count() - 1).value
                                var lt: str = .vTypeOf(lastArg)
                                if lt == "string" or isStringLit(lastArg)
                                    helper = helper + "_str"
                            .line(jobj + " = " + helper + "(" + jobj + ", " + .argsStr(c.args) + ")")
                            return
                        # (a call on a call's result: the method emitter binds the
                        # receiver when the call mutates it, with its type)
                    else
                        pass
            else
                pass
        .line(.exprStr(e))

    # `raise msg` -> `return error(msg)`; the details, when given, appended to
    # the message (V's error carries one string; nothing dropped)
    def genRaise(r: StmtRaise)
        var msg: str = "'raised'"
        if r.message as m
            msg = .exprStr(m)
        if r.details as d
            msg = "(" + msg + " + ': ' + " + .exprStr(d) + ")"
        .line("return error(" + msg + ")")

    # the def-level `catch |e|`: the body as a result-returning closure over
    # the def's parameters, the catch as its `or` block (V has no try
    # statement; a `return` inside the or block returns from the def, V's own
    # rule, so a value-returning def's catch must return or V says so)
    def genTryCatch(tc: StmtTryCatch)
        if tc.clauses.count() != 1
            .refuse("a catch with " + tc.clauses.count().toString() + " clauses (one is the subset)", tc.span)
        var caps: str = ""
        if .in_method
            caps = "mut self"   # the receiver captured (V allows it; probed)
        for p in .current_params
            if caps != ""
                caps = caps + ", "
            if .isRefType(p.type_)
                caps = caps + "mut " + vSafe(p.name)
            else
                caps = caps + vSafe(p.name)
        var capList: str = ""
        if caps != ""
            capList = "[" + caps + "] "
        var inner: str = .retSpelling(.current_ret)
        if not inner.startsWith("!")
            inner = "!" + inner
        var lead: str = ""
        if .current_ret != "" and not (.current_ret == "!")
            lead = "return "
        .line(lead + "fn " + capList + "() " + inner + " {")
        .depth = .depth + 1
        .genStmts(tc.stmts)
        .depth = .depth - 1
        .line("}() or {")
        .depth = .depth + 1
        for cl in tc.clauses
            if cl.type_ != nil
                .refuse("a typed catch clause", cl.span)
            if cl.binding as b
                .line(vSafe(b) + " := err")
                .catch_bindings.add(vSafe(b))
                .line("_ = " + vSafe(b))   # (always: a clause that never reads it would be V's unused variable)
            .genStmts(cl.stmts)
            if cl.binding != nil
                .catch_bindings = dropLast(.catch_bindings)
        .depth = .depth - 1
        .line("}")

    # `branch x` as V's `match` on a bound temporary (V smart-casts an
    # identifier, not an expression); a union arm's binding reads the
    # variant's payload; an `else` is always present (V wants exhaustiveness)
    def genBranch(b: StmtBranch)
        .matchN = .matchN + 1
        var t = "zm" + .matchN.toString()   # (V refuses a name beginning with `_`)
        .line(t + " := " + .exprStr(b.expr))
        .line("match " + t + " {")
        .depth = .depth + 1
        for arm in b.cases
            if arm.guard_expr.count() > 0
                .refuse("a branch arm with a guard", arm.span)
            if arm.struct_pat != nil
                .refuse("a branch arm with a struct pattern", arm.span)
            var vals: str = ""
            var first: bool = true
            for v in arm.values
                if not first
                    vals = vals + ", "
                first = false
                vals = vals + .armValueStr(v)
            .line(vals + " {")
            .depth = .depth + 1
            if arm.binding as bnd
                if bnd != "_"   # (a discarded binding is not bound: V's unused variable)
                    .local_names.add(bnd)
                    var lead: str = ""
                    if arm.values.count() == 1
                        var vk: str = .armValueStr(arm.values.at(0))
                        if .union_payloads.get(vk) as pt
                            .local_types.set(bnd, pt)
                            if .needsMut(pt)
                                lead = "mut "   # V refuses `mut x.field` through an immutable binding
                    .line(lead + vSafe(bnd) + " := " + t + ".payload")
                    if not mightUseName(bnd, arm.stmts)
                        .line("_ = " + vSafe(bnd))
            .genStmts(arm.stmts)
            .depth = .depth - 1
            .line("}")
        # V wants a match exhaustive OR with an else, and refuses an else on
        # an exhaustive one: over a union or an enum the arms are counted
        # against the type's members; over a plain value an else is always needed
        var exhaustive: bool = .armsExhaustive(b)
        if b.else_ as es
            if exhaustive
                .line("// (the branch's else: unreachable, every member is an arm; V refuses it)")
            else
                .line("else {")
                .depth = .depth + 1
                .genStmts(es)
                .depth = .depth - 1
                .line("}")
        else if not exhaustive
            .line("else {}")
        .depth = .depth - 1
        .line("}")

    def armsExhaustive(b: StmtBranch): bool
        var subject: str = ""
        var seen = List(str)()
        for arm in b.cases
            for v in arm.values
                branch v
                    on Expr.member as m
                        branch m.object
                            on Expr.ident as id
                                if .isUnionName(id.name) or .isEnumName(id.name)
                                    subject = id.name
                                    var key = m.member
                                    var had: bool = false
                                    for sn in seen
                                        if sn == key
                                            had = true
                                    if not had
                                        seen.add(key)
                            else
                                pass
                    else
                        pass
        if subject == ""
            return false
        return seen.count() >= (.member_counts.get(subject) orelse 0)

    # an arm's value: a union variant (`U.v`, the variant's struct type), an
    # enum member, or a plain value
    def armValueStr(v: Expr): str
        branch v
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner + "_" + m.member
                if .isEnumName(owner)
                    return "." + vSafe(m.member)   # a match on an enum spells its arms `.member`
                return .exprStr(v)
            on Expr.binary as rb
                if rb.op == BinaryOp.dotdot
                    # `on c'0'..c'9'`: V's inclusive range arm, three dots
                    return .exprStr(rb.left) + "..." + .exprStr(rb.right)
                return .exprStr(v)
            else
                return .exprStr(v)

    # `var x: int = 5` -> `mut x := i64(5)`; the type carried onto a numeric
    # literal, since V's untyped int is 32-bit and Zebra's is 64
    def genLocal(v: DeclVar)
        .local_names.add(v.name)
        var name = vSafe(v.name)
        if .isFnName(name)
            name = name + "_v"   # V refuses a call ambiguous between a function and a local of its name
            .renames.set(v.name, name)
        else if .isEmittedGlobal(name)
            name = name + "_v"   # a local shadowing a module-level const of any module: a warning -prod refuses
            .renames.set(v.name, name)
        if v.init_expr as ie
            var tname: str = ""
            if v.type_ as t
                tname = .vType(t)
            var rhs: str = ""
            if isUntypedListLit(ie) and tname.startsWith("&ZList[")
                # `var xs: List(int) = [...]`: the element type is the variable's
                rhs = .listLitWith(ie, tname.substring(7, tname.len - 1))
            else if isBareCtor(ie) and tname != ""
                rhs = .zeroOf(tname)   # `var xs: List(int) = List()`: the type is the variable's
            else
                rhs = .exprStr(ie)
                var un: str = .unionOfExpr(ie)
                if un != ""
                    # a variant is a value of its union: V would type the variable
                    # by the variant and refuse the next assignment
                    rhs = un + "(" + rhs + ")"
                    if tname == ""
                        tname = un
            if tname == ""
                tname = .ctorTypeOf(ie)
            if tname == ""
                tname = .vTypeOf(ie)   # the expression's type, when the emitter knows it
            if tname != ""
                .local_types.set(v.name, tname)
            if tname.startsWith("?") and isNilLit(ie)
                rhs = tname + "(none)"   # `var x: T? = nil`: V types `none` alone as none
            else if .vTypeOf(ie) == "json2.Any" and (tname == "i64" or tname == "f64" or tname == "bool" or tname == "string" or tname == "&ZList[json2.Any]")
                rhs = coerceRendered(rhs, tname)   # (rhs is rendered already: never render twice)
            else if tname == "i64"
                rhs = "i64(" + rhs + ")"   # (whatever the initializer: `-1` is V's int, a call's i64 is unchanged)
            else if tname == "f64"
                rhs = "f64(" + rhs + ")"
            else if tname == "" and isIntLit(ie)
                rhs = "i64(" + rhs + ")"
            else if tname.startsWith("&") and not tname.startsWith("&Z") and isIdentExpr(ie)
                # a reference by name: through its pointer cast -- inside a
                # closure capturing the name with [mut], a bare assignment
                # copies the struct (vlang/v#30348)
                rhs = tname + "(" + rhs + ")"
            .line("mut " + name + " := " + rhs)
        else
            if v.type_ as t
                .local_types.set(v.name, .vType(t))
                .line("mut " + name + " := " + .zeroOf(.vType(t)))
            else
                .refuse("var " + v.name + " without a type or a value", v.span)

    def zeroOf(vt: str): str
        if vt == "i64": return "i64(0)"
        if vt == "f64": return "f64(0)"
        if vt == "string": return "''"
        if vt == "bool": return "false"
        if vt.startsWith("&ZList["): return "new_zlist" + vt.substring(6, vt.len) + "()"
        if vt.startsWith("&ZMap["): return "new_zmap" + vt.substring(5, vt.len) + "()"
        if vt.startsWith("&ZSet["): return "new_zset" + vt.substring(5, vt.len) + "()"
        if vt == "&ZStringBuilder": return "new_zstring_builder()"
        if vt.startsWith("&"): return vt.substring(1, vt.len) + "{}"
        return vt + "{}"

    def genIf(i: StmtIf)
        var captured: str = ""
        var ne_name: str = ""
        var eq_name: str = ""
        if i.is_capture as cap
            captured = .genIfCapture(cap, i.cond)
        else
            ne_name = .nilCmpLocal(i.cond, true)
            eq_name = .nilCmpLocal(i.cond, false)
            .line("if " + condStr(.exprStr(i.cond)) + " {")
        .depth = .depth + 1
        if ne_name != ""
            .narrowed.add(ne_name)   # `if x != nil`: Zebra reads x as its inner type in the block
        if captured != ""
            .line(captured)
        if i.is_capture as cap2
            if not readsName(cap2, i.then_stmts)
                .line("_ = " + vSafe(cap2))   # a binding nothing reads (V's unused variable, an error under -prod)
        .genStmts(i.then_stmts)
        if ne_name != ""
            .unnarrow(ne_name)
        .depth = .depth - 1
        for ei in i.else_ifs
            if ei.is_capture as ecap
                .line("} else if " + vSafe(ecap) + " := " + .exprStr(ei.cond) + " {")
            else
                .line("} else if " + condStr(.exprStr(ei.cond)) + " {")
            .depth = .depth + 1
            .genStmts(ei.stmts)
            .depth = .depth - 1
        if i.else_stmts as es
            # Zebra's `else if` is an if alone in the else: V's `} else if`,
            # flat -- seventy nested elses (the autoplay's stage chain) passed
            # V's depth of forty. Not over a nil comparison: its narrowing
            # stays in the nested form.
            var chained: bool = false
            if eq_name == ""
                chained = .genElseIfChain(es)
            if not chained
                .line("} else {")
                .depth = .depth + 1
                if eq_name != "" and i.else_ifs.count() == 0
                    .narrowed.add(eq_name)   # the else of `if x == nil`
                .genStmts(es)
                if eq_name != "" and i.else_ifs.count() == 0
                    .unnarrow(eq_name)
                .depth = .depth - 1
        .line("}")
        if eq_name != "" and i.else_ifs.count() == 0 and i.else_stmts == nil and endsWithExit(i.then_stmts)
            .narrowed.add(eq_name)   # `if x == nil: return`: x is its inner type for the rest of the block

    # an else holding one plain if (no capture, no nil comparison): emitted as
    # `} else if cond {` and its own else the same way, flat; true when it was
    def genElseIfChain(es: List(Stmt)): bool
        if es.count() != 1
            return false
        branch es.at(0)
            on Stmt.if_ as ni
                if ni.is_capture != nil
                    return false
                if .nilCmpLocal(ni.cond, true) != "" or .nilCmpLocal(ni.cond, false) != ""
                    return false
                # the condition rendered in a cloned context first: one that binds
                # a temporary (a `mut` argument wants a variable) emits a line, and
                # V's `else if` has no place for it -- the nested form then. A
                # render that emitted nothing is pure, so its text is used as is.
                var probe = .cloneContext()
                probe.depth = .depth
                var cs: str = probe.exprStr(ni.cond)
                for r in probe.refused
                    .refused.add(r)
                if probe.sb.build() != ""
                    return false
                .line("} else if " + condStr(cs) + " {")
                .depth = .depth + 1
                .genStmts(ni.then_stmts)
                .depth = .depth - 1
                for ei in ni.else_ifs
                    if ei.is_capture as ecap
                        .line("} else if " + vSafe(ecap) + " := " + .exprStr(ei.cond) + " {")
                    else
                        .line("} else if " + condStr(.exprStr(ei.cond)) + " {")
                    .depth = .depth + 1
                    .genStmts(ei.stmts)
                    .depth = .depth - 1
                if ni.else_stmts as es2
                    if not .genElseIfChain(es2)
                        .line("} else {")
                        .depth = .depth + 1
                        .genStmts(es2)
                        .depth = .depth - 1
                return true
            else
                return false

    # `if cond as name`: a nilable's binding (`if name := cond {`), or a union
    # check's (`if x is U_v {` then `name := x.payload`, V's smart cast on an
    # identifier); returns the then-block's first line when there is one
    def genIfCapture(cap: str, cond: Expr): str
        branch cond
            on Expr.type_check as tc
                if tc.variant_name as vn
                    var subj = .exprStr(tc.expr)
                    if not isNameExpr(tc.expr)
                        # V smart-casts a name, not a call's result or an unwrap: the subject bound first
                        .tmpN = .tmpN + 1
                        var zs = "zs" + .tmpN.toString()
                        .line(zs + " := " + subj)
                        subj = zs
                    .line("if " + subj + " is " + tc.type_name + "_" + vn + " {")
                    .local_names.add(cap)
                    var lead: str = ""
                    if .union_payloads.get(tc.type_name + "_" + vn) as pt
                        .local_types.set(cap, pt)
                        if .needsMut(pt)
                            lead = "mut "
                    return lead + vSafe(cap) + " := " + subj + ".payload"
                .refuse("`is` on a class (not a union variant)", tc.span)
                .line("if true {")
                return ""
            else
                var ct: str = .vTypeOf(cond)
                var lead: str = ""
                if ct.startsWith("?")
                    var inner: str = ct.substring(1, ct.len)
                    .local_types.set(cap, inner)
                    if .needsMut(inner)
                        lead = "mut "   # V refuses `mut y.field` through an immutable binding
                .local_names.add(cap)
                .line("if " + lead + vSafe(cap) + " := " + .exprStr(cond) + " {")
                return ""

    def genForIn(fi: StmtForIn)
        if fi.vars.count() == 2
            # `for k, v in m`: a map's entries; V iterates the runtime's inner map
            var kname: str = fi.vars.at(0)
            var vname: str = fi.vars.at(1)
            .local_names.add(kname)
            .local_names.add(vname)
            var mt: str = .vTypeOf(fi.iter)
            if mt.startsWith("&ZMap[")
                var inner: str = mt.substring(6, mt.len - 1)
                var cut: int = inner.indexOf(", ")
                if cut > 0
                    .local_types.set(kname, inner.substring(0, cut))
                    .local_types.set(vname, inner.substring(cut + 2, inner.len))
            .line("for " + vSafe(kname) + ", " + vSafe(vname) + " in " + .exprStr(fi.iter) + ".m {")
            .depth = .depth + 1
            if not mightUseName(kname, fi.stmts)
                .line("_ = " + vSafe(kname))
            if not mightUseName(vname, fi.stmts)
                .line("_ = " + vSafe(vname))
            .genStmts(fi.stmts)
            .depth = .depth - 1
            .line("}")
            return
        if fi.vars.count() != 1
            .refuse("for with " + fi.vars.count().toString() + " loop variables", fi.span)
            return
        if fi.filter != nil
            .refuse("for ... if (a filtered loop)", fi.span)
        var v = vSafe(fi.vars.at(0))
        .local_names.add(fi.vars.at(0))
        # `for i in a..b`: a numeric range
        branch fi.iter
            on Expr.binary as rb
                if rb.op == BinaryOp.dotdot
                    .line("for " + v + " := i64(" + .exprStr(rb.left) + "); " + v + " < " + .exprStr(rb.right) + "; " + v + "++ {")
                    .depth = .depth + 1
                    .genStmts(fi.stmts)
                    .depth = .depth - 1
                    .line("}")
                    return
            else
                pass
        # `for i in a.to(b)`: a numeric range
        branch fi.iter
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        if m.member == "to" and c.args.count() == 1
                            .line("for " + v + " := i64(" + .exprStr(m.object) + "); " + v + " < " + .exprStr(c.args.at(0).value) + "; " + v + "++ {")
                            .depth = .depth + 1
                            .genStmts(fi.stmts)
                            .depth = .depth - 1
                            .line("}")
                            return
                    else
                        pass
            else
                pass
        var et: str = .elemOf(.vTypeOf(fi.iter))
        var v_unused: bool = not mightUseName(fi.vars.at(0), fi.stmts)
        if et != ""
            .local_types.set(fi.vars.at(0), et)
            if .needsMut(et)
                # an element passed on as `mut x.field`: by index, the element
                # copied into a mutable local (V's `for mut x` makes a reference
                # to the element and needs the list's root mutable)
                .tmpN = .tmpN + 1
                var it = "zit" + .tmpN.toString()
                var ix = "zix" + .tmpN.toString()
                .line(it + " := " + .exprStr(fi.iter))
                .line("for " + ix + " := 0; " + ix + " < " + it + ".count(); " + ix + "++ {")
                .depth = .depth + 1
                .line("mut " + v + " := " + it + ".at(" + ix + ")")
                .local_names.add(fi.vars.at(0))   # in scope: a module of its name is not meant
                if v_unused
                    .line("_ = " + v)
                .genStmts(fi.stmts)
                .depth = .depth - 1
                .line("}")
                return
        var iter_s: str = .exprStr(fi.iter)
        if .vTypeOf(fi.iter) == "json2.Any"
            iter_s = "zjson_list(" + iter_s + ")"   # a Json array iterated
            .local_types.set(fi.vars.at(0), "json2.Any")
        if not isNameExpr(fi.iter)
            # an expression iterated (a call, an unwrap, an orelse): bound first --
            # V's C for `(expr or { ... }).items` in a for header did not compile
            .tmpN = .tmpN + 1
            var zi = "zit" + .tmpN.toString()
            .line(zi + " := " + iter_s)
            iter_s = zi
        .line("for " + v + " in " + iter_s + ".items {")   # a list's items (the subset iterates lists)
        .depth = .depth + 1
        if v_unused
            .line("_ = " + v)
        .genStmts(fi.stmts)
        .depth = .depth - 1
        .line("}")

    def genPrint(p: StmtPrint)
        var fnname: str = "println"
        if not p.newline
            fnname = "print"
        if p.args.count() == 1
            .line(fnname + "(" + .exprStr(p.args.at(0)) + ")")
            return
        var parts: str = ""
        var first: bool = true
        for a in p.args
            if not first
                parts = parts + " "
            first = false
            parts = parts + "\${" + .exprStr(a) + "}"
        .line(fnname + "('" + parts + "')")

    # ── expressions ────────────────────────────────────────────────────────
    def exprStr(e: Expr): str
        branch e
            on Expr.int_lit as il
                return il.text
            on Expr.float_lit as fl
                return fl.text
            on Expr.bool_lit as bl
                if bl.value
                    return "true"
                return "false"
            on Expr.string_lit as sl
                return .vStringLit(sl.text)
            on Expr.string_interp as si
                return .vInterp(si)
            on Expr.this_
                return "self"
            on Expr.ident as id
                if .isNarrowed(id.name)
                    if .local_types.get(id.name) as nlt
                        return "zunwrap(" + nlt + "(" + .localName(id.name) + "))"   # Zebra reads it narrowed; V never narrows here
                if .renames.get(id.name) as rn
                    if .isLocalName(id.name)
                        return rn
                if .isGlobalName(id.name) and not .isLocalName(id.name) and not .isCurrentField(id.name)
                    return .globalName(id.name)   # a module-level var, prefixed when two modules declare the name
                if .isCurrentField(id.name) and not .isLocalName(id.name)
                    return "self." + vSafe(id.name)   # a bare field name inside its class (Zebra allows it)
                return vSafe(id.name)
            on Expr.member as m
                return .memberStr(m)
            on Expr.call as c
                return .callStr(c)
            on Expr.index as ix
                var ixt: str = .vTypeOf(ix.object)
                if ixt == "json2.Any"
                    var kt: str = .vTypeOf(ix.index)
                    if kt == "string"
                        return "zjson_idx(" + .exprStr(ix.object) + ", " + .exprStr(ix.index) + ")"   # Zebra's j[key]: a result
                    return "zjson_idx_at(" + .exprStr(ix.object) + ", " + .exprStr(ix.index) + ")"
                if ixt.startsWith("&ZList[")
                    return .exprStr(ix.object) + ".at(" + .exprStr(ix.index) + ")"   # the runtime's list
                if ixt.startsWith("&ZMap[")
                    return .exprStr(ix.object) + ".fetch(" + .exprStr(ix.index) + ")"
                return .exprStr(ix.object) + "[" + .exprStr(ix.index) + "]"
            on Expr.binary as b
                return .binaryStr(b)
            on Expr.unary as u
                if u.op == UnaryOp.neg
                    return "(-" + .exprStr(u.operand) + ")"
                if u.op == UnaryOp.not_
                    return "(!" + .exprStr(u.operand) + ")"
                return "(~" + .exprStr(u.operand) + ")"
            on Expr.list_lit as ll
                return .listLitStr(ll)
            on Expr.if_expr as ie
                return "(if " + condStr(.exprStr(ie.cond)) + " { " + .exprStr(ie.then_expr) + " } else { " + .exprStr(ie.else_expr) + " })"
            on Expr.type_check as tc
                if tc.variant_name as vn
                    if .isEnumName(tc.type_name)
                        return "(" + .exprStr(tc.expr) + " == ." + vSafe(vn) + ")"   # `x is Enum.member`
                    return "(" + .exprStr(tc.expr) + " is " + tc.type_name + "_" + vn + ")"
                .refuse("`is` on a class (not a union variant)", tc.span)
                return "true"
            on Expr.nil_
                return "none"
            on Expr.orelse_ as oe
                return "(" + .exprStr(oe.expr) + " or { " + .exprStr(oe.fallback) + " })"
            on Expr.to_non_nil as tnn
                # a helper: V smart-casts a name after a nil check and refuses `or`
                # on it; and a smart-cast sum type passed to the helper's `?T`
                # fails at V's C stage, so the option is cast explicitly when the
                # emitter knows the type
                branch tnn.expr
                    on Expr.ident as nid
                        if .isNarrowed(nid.name)
                            return .exprStr(tnn.expr)   # a narrowed name reads as its unwrap already
                    on Expr.member as nm
                        if exprRootIsThis(nm.object) and .isNarrowed("self." + vSafe(nm.member))
                            return .exprStr(tnn.expr)
                    else
                        pass
                var ot: str = .vTypeOf(tnn.expr)
                if ot.startsWith("?")
                    return "zunwrap(" + ot + "(" + .exprStr(tnn.expr) + "))"
                return "zunwrap(" + .exprStr(tnn.expr) + ")"
            on Expr.dict_lit as dl
                .refuse("a dict literal (maps are next)", dl.span)
                return "map[string]i64{}"
            on Expr.try_ as t
                if .vTypeOf(t.expr).startsWith("!?")
                    return "zopt_of(" + .exprStr(t.expr) + "!)"   # a nilable-and-throws callee: the wrapper opened
                return .exprStr(t.expr) + "!"
            on Expr.char_lit as cl
                return .charLitStr(cl.text)
            on Expr.slice as sl
                var a: str = ""
                var b: str = ""
                if sl.start as st
                    a = .exprStr(st)
                if sl.stop_ as sp
                    b = .exprStr(sp)
                return .exprStr(sl.object) + "[int(" + a + ")..int(" + b + ")]"   # int bounds: an i64 bound panics in range under MSVC, with or without -prod (vlang/v#30352)
            on Expr.cast as ca
                if .vTypeOf(ca.expr) == "json2.Any"
                    return .coerced(ca.expr, .vType(ca.target))
                return .vType(ca.target) + "(" + .exprStr(ca.expr) + ")"
            on Expr.chained_cmp as cc
                # a < b < c -> (a < b) && (b < c); the middle operands are spelled twice
                var out: str = "("
                var i: int = 0
                while i < cc.ops.count()
                    if i > 0
                        out = out + " && "
                    out = out + "(" + .exprStr(cc.operands.at(i)) + " " + cc.ops.at(i) + " " + .exprStr(cc.operands.at(i + 1)) + ")"
                    i = i + 1
                return out + ")"
            on Expr.lambda as lam
                return .lambdaStr(lam)
            on Expr.tuple_lit as tl
                if tl.elems.count() < 2 or tl.elems.count() > 3
                    .refuse("a tuple literal of " + tl.elems.count().toString() + " (the runtime spells 2 and 3)", tl.span)
                    return "0"
                var fields: str = ""
                var fi: int = 0
                for el in tl.elems
                    if fi > 0
                        fields = fields + ", "
                    fields = fields + "f" + fi.toString() + ": " + .exprStr(el)
                    fi = fi + 1
                return "ZTuple" + tl.elems.count().toString() + "{" + fields + "}"   # (V infers the type arguments from the fields)
            on Expr.set_lit as stl
                .refuse("a set literal", stl.span)
                return "new_zset[i64]()"
            on Expr.array_lit as al
                .refuse("an array literal", al.span)
                return "0"
            on Expr.zig_lit as zl
                if zl.text == "_error_ctx.message"
                    return "err.msg()"   # the compiler's own idiom for the caught error's message (inside a catch: V's err)
                if zl.text == "_zbr_version"
                    return "zbr_version"   # the compiler's own version string: a runtime const on this backend
                if zl.text == "builtin.zig_version_string"
                    return "'(no Zig: the V backend)'"
                if zl.text == "builtin.target.os.tag == .macos"
                    return "(os.user_os() == 'macos')"
                if zl.text == "@as([]const u8, @tagName(builtin.target.cpu.arch))"
                    return "zsys_arch()"
                if zl.text == "@as(i64, @intCast(std.os.windows.GetCurrentProcessId()))"
                    return "i64(os.getpid())"
                .refuse("a zig literal (Zig-backend code; no V for it)", zl.span)
                return "0"
            on Expr.opt_chain as oc
                .refuse("an optional chain (?.)", oc.span)
                return .exprStr(oc.base)
            on Expr.old_ as ol
                .refuse("an `old` expression (contracts)", ol.span)
                return .exprStr(ol.operand)
            on Expr.except_ as ex
                return .exceptStr(ex)
            on Expr.result_ as rs
                .refuse("`result` (contracts)", rs)
                return "0"
            on Expr.catch_ as c
                # `expr catch |e| fallback` -> `(expr or { e := err  fallback })`:
                # the or block's last expression is its value
                if c.err_var as ev
                    .catch_bindings.add(vSafe(ev))
                    var out = "(" + .exprStr(c.expr) + " or {\n" + vSafe(ev) + " := err\n_ = " + vSafe(ev) + "\n" + .exprStr(c.fallback) + "\n})"
                    .catch_bindings = dropLast(.catch_bindings)
                    return out
                return "(" + .exprStr(c.expr) + " or { " + .exprStr(c.fallback) + " })"
            else
                .refused.add("an expression kind the subset does not spell")
                return "0"

    # `c'A'` -> u8(`A`): Zebra's char is a byte; V's rune literal cast to u8
    # (the AST keeps the raw text, c-prefix and quotes included)
    def charLitStr(text: str): str
        var inner: str = text
        if inner.startsWith("c'") and inner.endsWith("'") and inner.len >= 3
            inner = inner.substring(2, inner.len - 1)
        else if inner.startsWith("'") and inner.endsWith("'") and inner.len >= 2
            inner = inner.substring(1, inner.len - 1)
        if inner == "\\'"
            inner = "'"
        if inner == "`"
            inner = "\\`"
        return "u8(`" + inner + "`)"

    # a lambda as V's anonymous function, its captures listed (V captures by
    # value unless `mut`; a captured container or class is a reference anyway)
    def lambdaStr(lam: ExprLambda): str
        var caps: str = ""
        for cv in lam.captures
            # `capture var rc: T = this`: V captures a variable of the enclosing
            # scope, so the capture is declared there first (a line before the
            # statement holding the lambda)
            var cname: str = vSafe(cv.name)   # the captured variable's V name
            if cv.init_expr as cie
                var same: bool = false
                branch cie
                    on Expr.ident as cid
                        same = cid.name == cv.name   # `capture var b = b`: the local itself
                    else
                        pass
                if same
                    if .renames.get(cv.name) as rn
                        cname = rn   # the local itself under its V name (renamed off a function or a global)
                if not same
                    # a reference is declared through its pointer cast: inside a
                    # closure capturing `[mut self]` (a try block's body), a bare
                    # `mut demo := self` copies the struct (vlang/v#30348)
                    var cinit: str = .exprStr(cie)
                    var cvt0: str = .vType(cv.type_)
                    if cvt0.startsWith("&") and not cvt0.startsWith("&Z")
                        cinit = cvt0 + "(" + cinit + ")"
                    if .isLocalName(cv.name)
                        .line(vSafe(cv.name) + " = " + cinit)   # a name a capture already declared
                    else
                        .line("mut " + vSafe(cv.name) + " := " + cinit)
            else
                .refuse("a capture without a value (" + cv.name + ")", cv.span)
            .local_names.add(cv.name)
            var cvt: str = .vType(cv.type_)
            if cvt != ""
                .local_types.set(cv.name, cvt)
            if caps != ""
                caps = caps + ", "
            if .isRefType(cv.type_)
                caps = caps + "mut " + cname
            else
                caps = caps + cname
        var capList: str = ""
        if caps != ""
            capList = "[" + caps + "] "
        var ret = .vType(lam.return_type)
        var head = "fn " + capList + "(" + .genParams(lam.params) + ")"
        if ret != ""
            head = head + " " + ret
        var saved_locals = .local_names.copy()   # (a container is a reference: the restore needs its own copy)
        for p in lam.params
            .local_names.add(p.name)
        var body: str = ""
        branch lam.body_
            on LambdaBody.expr_ as e
                body = "\n\treturn " + .exprStr(e) + "\n"
            on LambdaBody.stmts as sts
                # the statements through a nested writer: the lines are joined
                var inner = .cloneContext()
                inner.depth = 1
                inner.genStmts(sts)
                for r in inner.refused
                    .refused.add(r)
                body = "\n" + inner.sb.build()
        .local_names = saved_locals
        return head + " {" + body + "}"

    # "text" -> 'text' with V's escapes: a $ or a ' inside is escaped
    def vStringLit(text: str): str
        return "'" + .vEscape(text) + "'"

    # the text of a Zebra string (its escapes raw, as the lexer keeps them)
    # as V's: `\"` is a plain quote, `\$` stays one escape (not an escaped
    # backslash before an interpolation), a `$` or `'` is escaped
    def vEscape(text: str): str
        var out: str = ""
        var i: int = 0
        var n: int = text.len
        while i < n
            var ch = text[i]   # (a byte: compared with a char literal, appended as a one-byte substring)
            if ch == '\\' and i + 1 < n
                var nx = text[i + 1]
                if nx == '"'
                    out = out + "\""
                else if nx == '$'
                    out = out + "\\$"
                else if nx == '\''
                    out = out + "\\'"
                else
                    out = out + "\\" + text.substring(i + 1, i + 2)
                i = i + 2
            else
                if ch == '$'
                    out = out + "\\$"
                else if ch == '\''
                    out = out + "\\'"
                else
                    out = out + text.substring(i, i + 1)
                i = i + 1
        return out

    def vInterp(si: ExprStringInterp): str
        var out: str = "'"
        for part in si.parts
            branch part
                on StringPart.literal as lit
                    out = out + .vEscape(lit)
                on StringPart.expr_ as ex
                    out = out + "\${" + .exprStr(ex) + "}"
                on StringPart.format as f
                    # a format spec FOLLOWS its expression in the parts: spliced
                    # into the `${...}` just emitted (V's own spelling, `${x:.4f}`)
                    if out.endsWith("}")
                        out = out.substring(0, out.len - 1) + ":" + f + "}"
                    else
                        .refused.add("a format spec (" + f + ") with no expression before it")
        return out + "'"

    # a list literal's element type: the declared one, else the first
    # element's when the emitter knows it; "" when neither
    def listLitElemType(ll: ExprListLit): str
        var et: str = ""
        if ll.elem_type as t
            et = .vType(t)
        if et == "" and ll.elems.count() > 0
            var first = ll.elems.at(0)
            et = .vTypeOf(first)
            if et == "" and isStringLit(first)
                et = "string"
            if et == "" and isIntLit(first)
                et = "i64"
            if et == "" and isFloatLit(first)
                et = "f64"
            if et == "" and isBoolLit(first)
                et = "bool"
        return et

    def listLitStr(ll: ExprListLit): str
        var et: str = .listLitElemType(ll)
        if et == ""
            .refused.add("a list literal without an element type (write `var xs: List(T) = [...]`)")
            return "new_zlist[i64]()"
        return .listLitWith(Expr.list_lit(ll), et)

    # a list literal as the runtime's boxed list of a known element type
    def listLitWith(e: Expr, et: str): str
        branch e
            on Expr.list_lit as ll
                if ll.elems.count() == 0
                    return "new_zlist[" + et + "]()"
                var out: str = "zlist_of[" + et + "](["
                var first: bool = true
                for el in ll.elems
                    if not first
                        out = out + ", "
                    first = false
                    if et == "i64" and isIntLit(el)
                        out = out + "i64(" + .exprStr(el) + ")"
                    else if .isUnionName(et)
                        out = out + et + "(" + .exprStr(el) + ")"   # a sum type's element: cast, or V infers the first variant
                    else
                        out = out + .exprStr(el)
                return out + "])"
            else
                return .exprStr(e)

    # `.x` on this -> self.x; `a.len` (a property) -> a.len; else a.b
    def memberStr(m: ExprMember): str
        var owner: str = .staticOwner(m.object)
        if owner == "Math" and m.member == "PI"
            return "math.pi"
        if .isEnumName(owner)
            return owner + "." + vSafe(m.member)
        if .isUnionName(owner)
            return owner + "_" + m.member + "{}"   # a payload-less variant as a value
        if .isModuleIdent(m.object)
            return vSafe(m.member)   # `Mod.name`: the used module's declaration, in this file
        var obj = .exprStr(m.object)
        var ot: str = .vTypeOf(m.object)
        if isDigits(m.member)
            return obj + ".f" + m.member   # a tuple's element by position
        if .isUnionName(ot) and .union_payloads.get(ot + "_" + m.member) != nil
            return "(" + obj + " as " + ot + "_" + m.member + ").payload"   # Zebra's payload access by the variant's name
        if m.member == "len"
            if .isContainerType(ot)
                return obj + ".count()"   # Zebra's `.len` on a container
            return obj + ".len"
        if m.member == "message" and .isCatchBinding(obj)
            return obj + ".msg()"   # V's IError
        var plain: str = obj + "." + vSafe(m.member)
        if exprRootIsThis(m.object) and .isNarrowed(plain)
            if .field_types.get(m.member) as nft
                return "zunwrap(" + nft + "(" + plain + "))"   # Zebra reads the field narrowed
        return plain

    def isCatchBinding(name: str): bool
        for b in .catch_bindings
            if b == name
                return true
        return false

    # a call of this name on a receiver of this type mutates it: a class's
    # or a mutating struct's any method, a container's writers
    def mutatesReceiver(rtype: str, name: str): bool
        if rtype.startsWith("&ZList[") or rtype.startsWith("&ZMap[") or rtype.startsWith("&ZSet[") or rtype == "&ZStringBuilder" or rtype == ""
            return name == "add" or name == "set" or name == "put" or name == "clear" or name == "remove" or name == "removeAt" or name == "insert" or name == "append" or name == "appendChar" or name == "sort" or name == "sortBy" or name == "reverse" or name == "pop"
        if rtype.startsWith("&")
            return true
        return .isMutStruct(rtype)

    # a bare name whose type is a reference or an option of one (a parameter
    # or a local): kept in a field only through `unsafe { }`
    def isRefParamName(e: Expr): bool
        branch e
            on Expr.ident as id
                if .local_types.get(id.name) as lt
                    return lt.startsWith("&") or lt.startsWith("?&")
                return false
            else
                return false

    def isSigConflict(name: str): bool
        for c in .sig_conflicts
            if c == name
                return true
        return false

    def argsStr(args: List(Arg), callee: str = ""): str
        var sigOpt: FnSig? = nil
        if callee != "" and not .isSigConflict(callee)
            sigOpt = .sigs.get(callee)
        if sigOpt as fsig
            return .argsBySig(args, fsig, callee)
        # an unknown callee (the stdlib, a method the pass did not see): by position
        var out: str = ""
        var first: bool = true
        for a in args
            if not first
                out = out + ", "
            first = false
            if a.name != nil
                .refuse("a named argument (" + a.name! + ") to a callee the emitter has no signature for", a.span)
            out = out + .exprStr(a.value)
        return out

    # the arguments in the callee's order: a named argument to its parameter,
    # the unnamed ones in sequence to the rest, a missing one from its default
    def argsBySig(args: List(Arg), fsig: FnSig, callee: str = ""): str
        # a plan first, without rendering (rendering binds temporaries): a call
        # the signature cannot take -- more arguments than parameters, a named
        # one it lacks, a missing one without a default -- was matched by NAME to
        # another declaration's signature; Zebra's checker accepted the real
        # callee, so the arguments go by position
        if not .sigFits(args, fsig)
            return .positionalArgs(args, fsig)
        var slots = List(str)()
        var filled = List(bool)()
        for n in fsig.names
            slots.add("")
            filled.add(false)
        var pos: int = 0
        for a in args
            if a.name as an
                var k: int = 0
                var found: bool = false
                for n in fsig.names
                    if n == an
                        slots.set(k, .coerced(a.value, fsig.types.at(k)))
                        filled.set(k, true)
                        found = true
                    k = k + 1
                if not found
                    .refuse("a named argument (" + an + ") the callee has no parameter for", a.span)
            else
                while pos < fsig.names.count() and filled.at(pos)
                    pos = pos + 1
                if pos < fsig.names.count()
                    slots.set(pos, .coerced(a.value, fsig.types.at(pos)))
                    filled.set(pos, true)
                    pos = pos + 1
                else
                    .refuse("more arguments than the callee has parameters", a.span)
        var out: str = ""
        var i: int = 0
        while i < fsig.names.count()
            if i > 0
                out = out + ", "
            if not filled.at(i)
                if fsig.has_default.at(i)
                    slots.set(i, .exprStr(fsig.defaults.at(i)))
                else
                    .refused.add("a missing argument (" + fsig.names.at(i) + ") with no default in a call to " + callee + " (" + .current_file + ")")
                    slots.set(i, "0")
            if fsig.refs.at(i)
                var slot: str = slots.at(i)
                if slot.indexOf("(") >= 0 or slot.indexOf("[") >= 0 or (slot.indexOf(".") >= 0 and not slot.startsWith("self."))
                    # V takes `mut` on an lvalue only: a call's result (a fresh
                    # container, an element) is bound first; the line lands
                    # before the statement being built. A field path not rooted
                    # at self is bound too: V refuses `mut p.field` through an
                    # immutable parameter or binding, and a reference field
                    # copied is the same container
                    .tmpN = .tmpN + 1
                    var t = "zt" + .tmpN.toString()
                    .line("mut " + t + " := " + slot)
                    slots.set(i, t)
                out = out + "mut "
            out = out + slots.at(i)
            i = i + 1
        return out

    # an expression rendered for a place of a known type: a Json value
    # converts (Zebra's `var n: int = j["n"]?` reads by the receiving type)
    def coerced(e: Expr, want: str): str
        var s: str = .exprStr(e)
        if .vTypeOf(e) == "json2.Any"
            return coerceRendered(s, want)
        if .isSigName(want) and isLambdaExpr(e)
            return want + "(" + s + ")"   # the named function type: V instantiates generics by the lambda's anonymous type otherwise
        return s

    def sigFits(args: List(Arg), fsig: FnSig): bool
        var taken = List(bool)()
        for n in fsig.names
            taken.add(false)
        var pos: int = 0
        for a in args
            if a.name as an
                var found: bool = false
                var k: int = 0
                for n in fsig.names
                    if n == an
                        taken.set(k, true)
                        found = true
                    k = k + 1
                if not found
                    return false
            else
                while pos < fsig.names.count() and taken.at(pos)
                    pos = pos + 1
                if pos >= fsig.names.count()
                    return false
                taken.set(pos, true)
                pos = pos + 1
        var i: int = 0
        while i < fsig.names.count()
            if not taken.at(i) and not fsig.has_default.at(i)
                return false
            i = i + 1
        return true

    # the arguments in order, `mut` where the signature's position says so
    def positionalArgs(args: List(Arg), fsig: FnSig): str
        var out: str = ""
        var i: int = 0
        for a in args
            if i > 0
                out = out + ", "
            var s: str = .exprStr(a.value)
            if i < fsig.refs.count() and fsig.refs.at(i) and isNameExpr(a.value)
                out = out + "mut "
            out = out + s
            i = i + 1
        return out

    def callStr(c: ExprCall): str
        branch c.callee
            on Expr.member as m
                if .isModuleIdent(m.object) and not .isModuleClassStatic(m)
                    return .identCallStr(m.member, c.args)   # `Mod.Name(args)`: the used module's declaration
                return .methodCallStr(m, c.args, c.span)
            on Expr.ident as id
                return .identCallStr(id.name, c.args)
            on Expr.call as inner
                # List(T)() / HashMap(K, V)(): the runtime's constructors
                branch inner.callee
                    on Expr.ident as cid
                        if cid.name == "List" and inner.args.count() == 1
                            return "new_zlist[" + .typeArgStr(inner.args.at(0).value) + "]()"
                        if cid.name == "HashMap" and inner.args.count() == 2
                            return "new_zmap[" + .typeArgStr(inner.args.at(0).value) + ", " + .typeArgStr(inner.args.at(1).value) + "]()"
                        if cid.name == "Set" and inner.args.count() == 1
                            return "new_zset[" + .typeArgStr(inner.args.at(0).value) + "]()"
                    else
                        pass
                .refuse("a call on a call's result", c.span)
                return .exprStr(c.callee) + "(" + .argsStr(c.args) + ")"
            else
                .refuse("a call on an expression that is not a name or a member", c.span)
                return .exprStr(c.callee) + "(" + .argsStr(c.args) + ")"

    # `Mod.x(args)` where Mod is a used module AND a class of that name (Zebra's
    # `use Lexer` then `Lexer.tokenize(src)`): the class's static method --
    # unless x names a type (`Token.Token(...)` is the class's constructor)
    def isModuleClassStatic(m: ExprMember): bool
        branch m.object
            on Expr.ident as id
                if not (.isClassName(id.name) or .isStructName(id.name))
                    return false
                if .isClassName(m.member) or .isStructName(m.member) or .isUnionName(m.member) or .isEnumName(m.member)
                    return false
                return true
            else
                return false

    # a call on a bare name: a class or a struct constructed (Name(args) ->
    # new_name(args)), else a free function
    def identCallStr(name: str, args: List(Arg)): str
        if .isClassName(name) or .isStructName(name)
            return "new_" + snakeCase(name) + "(" + .argsStr(args, "new_" + snakeCase(name)) + ")"
        if name == "StringBuilder"
            return "new_zstring_builder()"
        if (name == "List" or name == "HashMap" or name == "Set") and args.count() == 0
            .refused.add("an untyped " + name + "() where the emitter does not know the target's type (a typed var or a field takes it)")
            return "new_zlist[i64]()"
        # a bare call naming a method of the enclosing class (Zebra allows it)
        if .in_method and .isMethodName(name)
            var mkey: str = "." + vSafe(name)
            if .sigs.get(.current_class + "." + vSafe(name)) != nil
                mkey = .current_class + "." + vSafe(name)
            return "self." + vSafe(name) + "(" + .argsStr(args, mkey) + ")"
        if .isStaticName(name)
            var skey: str = snakeCase(.current_class) + "_" + vSafe(name)
            return skey + "(" + .argsStr(args, skey) + ")"
        if .local_types.get(name) as lt
            if .sigs.get("sig:" + lt) != nil
                return .localName(name) + "(" + .argsStr(args, "sig:" + lt) + ")"   # a call through a function-typed value
        var fname: str = .freeFnName(name)
        return fname + "(" + .argsStr(args, fname) + ")"

    # a type named as a constructor's argument (`List(int)`, `HashMap(str, Box)`)
    def typeArgStr(e: Expr): str
        branch e
            on Expr.ident as id
                return .vNamed(id.name)
            on Expr.member as mm
                if .isModuleIdent(mm.object)
                    return .vNamed(mm.member)   # `List(Mod.Name)`
                .refused.add("a type argument the subset does not spell (a member)")
                return "voidptr"
            on Expr.call as c
                # a nested container type: List(List(int))
                branch c.callee
                    on Expr.ident as cid
                        if cid.name == "List" and c.args.count() == 1
                            return "&ZList[" + .typeArgStr(c.args.at(0).value) + "]"
                        if cid.name == "HashMap" and c.args.count() == 2
                            return "&ZMap[" + .typeArgStr(c.args.at(0).value) + ", " + .typeArgStr(c.args.at(1).value) + "]"
                        if cid.name == "Set" and c.args.count() == 1
                            return "&ZSet[" + .typeArgStr(c.args.at(0).value) + "]"
                    else
                        pass
                .refused.add("a type argument the subset does not spell")
                return "voidptr"
            else
                .refused.add("a type argument the subset does not spell")
                return "voidptr"

    # the stdlib surface the subset maps by hand: str, List, Math, the conversions
    def methodCallStr(m: ExprMember, args: List(Arg), span: Span): str
        var name = m.member
        var isMath: bool = false
        var owner: str = .staticOwner(m.object)
        if owner == "Math"
            isMath = true
        # a static method: Class.method(args) -> class_method(args)
        if .isClassName(owner) or .isStructName(owner)
            var skey2: str = snakeCase(owner) + "_" + vSafe(name)
            if .sigs.get(skey2) == nil
                # no such static declared: a builtin namespace of the same name
                # (`Arg.parse()` beside the AST's `Arg` struct)
                var bi: str = .staticCall(m, args, span)
                if bi != ""
                    return bi
            return skey2 + "(" + .argsStr(args, skey2) + ")"
        # a union variant constructed: U.v(x) -> U_v{ payload: x }, U.v() -> U_v{}
        if .isUnionName(owner)
            if args.count() == 0
                return owner + "_" + name + "{}"
            return owner + "_" + name + "{ payload: " + .exprStr(args.at(0).value) + " }"
        if isMath
            .needs_math = true
            if name == "sqrt" or name == "abs" or name == "floor" or name == "ceil" or name == "sin" or name == "cos" or name == "tan" or name == "pow" or name == "min" or name == "max" or name == "atan2"
                return "math." + name + "(" + .argsStr(args) + ")"
            if name == "round": return "zmath_round(" + .argsStr(args) + ")"
            if name == "clamp": return "zmath_clamp(" + .argsStr(args) + ")"
            .refuse("Math." + name, span)
            return "math." + name + "(" + .argsStr(args) + ")"
        var statics: str = .staticCall(m, args, span)
        if statics != ""
            return statics
        var obj = .exprStr(m.object)
        var rtype: str = .vTypeOf(m.object)
        if (not isNameExpr(m.object) or .isNarrowedIdent(m.object)) and not .in_cond and .mutatesReceiver(rtype, name)
            # V takes a mutating call on an lvalue only: the receiver (a call's
            # result, an unwrap) is bound first, on a line before the statement
            .tmpN = .tmpN + 1
            var tr = "zt" + .tmpN.toString()
            .line("mut " + tr + " := " + obj)
            .local_names.add(tr)
            if rtype != ""
                .local_types.set(tr, rtype)   # (the call on it resolves by the type too)
            obj = tr
        # a user type's own method: its signature, before the stdlib table's names
        var own: str = rtype
        if own.startsWith("&")
            own = own.substring(1, own.len)
        if own != "" and (.isClassName(own) or .isStructName(own) or .isIfaceName(own))
            if name == "toString" and args.count() == 0
                return obj + ".str()"   # a type's `cue toString` is V's str()
            var okey: str = "." + vSafe(name)
            if .sigs.get(own + "." + vSafe(name)) != nil
                okey = own + "." + vSafe(name)
            return obj + "." + vSafe(name) + "(" + .argsStr(args, okey) + ")"
        if rtype == "u8" and name == "toString" and args.count() == 0
            return obj + ".ascii_str()"   # a char's toString is the character (a byte's would be its number)
        if rtype == "&ZSqliteDb" and (name == "exec" or name == "query") and args.count() == 1
            return obj + "." + name + "(" + .argsStr(args) + ", new_zlist[string]())"   # without parameters
        if rtype == "string" and name == "toInt" and args.count() == 0
            return obj + ".i64()"   # parsed, not cast
        if rtype == "string" and name == "toFloat" and args.count() == 0
            return obj + ".f64()"
        if rtype == "&ZStringBuilder" and name == "toString" and args.count() == 0
            return obj + ".build()"   # a builder's text, not V's struct printer
        if rtype == "json2.Any" or (rtype == "" and isJsonOnlyMethod(name))
            var ja: str = .argsStr(args)
            if name == "get" and args.count() == 1: return "zjson_get(" + obj + ", " + ja + ")"
            if name == "has" and args.count() == 1: return "zjson_has(" + obj + ", " + ja + ")"
            # `v.tryX()` is the value itself as X; `v.tryX(key)` is the MEMBER
            # as X (the Zig backend's _json_self_X beside _json_try_X)
            if name == "tryStr": return .jsonTry("str", obj, args, ja)
            if name == "tryInt": return .jsonTry("int", obj, args, ja)
            if name == "tryFloat": return .jsonTry("float", obj, args, ja)
            if name == "tryBool": return .jsonTry("bool", obj, args, ja)
            if name == "tryObj": return .jsonTry("obj", obj, args, ja)
            if name == "tryList": return .jsonTry("list", obj, args, ja)
            if name == "keys": return "zjson_keys(" + obj + ")"
            if name == "values": return "zjson_values(" + obj + ")"
            if name == "isNull": return "zjson_is_null(" + obj + ")"
            if name == "isObject": return "zjson_is_object(" + obj + ")"
            if name == "isArray": return "zjson_is_array(" + obj + ")"
            if name == "stringify" or name == "toString": return obj + ".json_str()"
            if isJsonPutMethod(name)
                .refuse("Json." + name + " on a value that is not a name (the put family rewrites `j.put(k, v)` as `j = zjson_put(j, k, v)`)", span)
                return obj
        if rtype.startsWith("&ZList[")
            if (name == "add" or name == "set") and args.count() >= 1 and .isSigName(.elemOf(rtype))
                # a lambda into a list of a sig type: cast to the name (see coerced)
                var cargs: str = ""
                var ci: int = 0
                for a in args
                    if ci > 0
                        cargs = cargs + ", "
                    cargs = cargs + .coerced(a.value, .elemOf(rtype))
                    ci = ci + 1
                return obj + "." + name + "(" + cargs + ")"
            # the list's own, where the string's would be taken by name (the
            # comparing ones are free functions: see zebra_rt.v)
            if name == "indexOf" and args.count() == 1: return "zlist_index_of(" + obj + ", " + .argsStr(args) + ")"
            if name == "contains" and args.count() == 1: return "zlist_contains(" + obj + ", " + .argsStr(args) + ")"
            if name == "toString" and args.count() == 0: return "zlist_str(" + obj + ")"
            if name == "sort" and args.count() == 1 and isLambdaExpr(args.at(0).value)
                # a comparator: the runtime's stable sort (std.mem.sort is stable on the Zig backend)
                return "zlist_sort_with(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
            if name == "sortBy" and args.count() == 1 and isLambdaExpr(args.at(0).value)
                var kt: str = .lambdaRet(args.at(0).value)
                if kt == "i64": return "zlist_sort_by_i64(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
                if kt == "f64": return "zlist_sort_by_f64(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
                if kt == "string": return "zlist_sort_by_str(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
                .refuse("List.sortBy with a key of type " + kt + " (the runtime sorts by i64, f64 and str)", span)
                return "zlist_sort_by_i64(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
            if name == "sort" and args.count() == 0
                var et: str = .elemOf(rtype)
                if et == "string": return "zsort_str(mut " + obj + ")"
                if et == "i64": return "zsort_i64(mut " + obj + ")"
                if et == "f64": return "zsort_f64(mut " + obj + ")"
                .refuse("List(" + et + ").sort (the runtime sorts i64, f64 and str)", span)
                return "zsort_str(mut " + obj + ")"
            if name == "remove" and args.count() == 1: return obj + ".remove_at(" + .argsStr(args) + ")"   # Zebra's List.remove(i) is by index
            if name == "reverse" and args.count() == 0: return obj + ".reversed()"
        return .mappedCall(obj, name, args, span, rtype)

    # File / Path / sys as static calls onto the runtime's wrappers ("" when
    # the object is not one of them); Json is the next slice
    def staticCall(m: ExprMember, args: List(Arg), span: Span): str
        var ns: str = .staticOwner(m.object)
        if ns == ""
            return ""
        if not isBuiltinNs(ns)
            return ""   # (before the arguments are rendered: rendering binds temporaries, and a second rendering bound them twice)
        var name = m.member
        var a = .argsStr(args)
        if ns == "File"
            if name == "exists": return "zfile_exists(" + a + ")"
            if name == "read": return "zfile_read(" + a + ")"
            if name == "write": return "zfile_write(" + a + ")"
            if name == "append": return "zfile_append(" + a + ")"
            if name == "listDir": return "zfile_list_dir(" + a + ")"
            if name == "isDir": return "os.is_dir(" + a + ")"
            if name == "rename": return "os.mv(" + a + ") or {}"
            if name == "delete": return "os.rm(" + a + ") or {}"
            if name == "tryDelete": return "zfile_try_delete(" + a + ")"
            if name == "copy": return "os.cp(" + a + ") or {}"
            if name == "readLines": return "zstr_lines(zfile_read(" + a + "))"
            .refuse("File." + name, span)
            return "zfile_" + snakeCase(name) + "(" + a + ")"
        if ns == "Path"
            if name == "dirname": return "zpath_dirname(" + a + ")"
            if name == "basename": return "zpath_basename(" + a + ")"
            if name == "stem": return "zpath_stem(" + a + ")"
            if name == "join": return "zpath_join(" + a + ")"
            .refuse("Path." + name, span)
            return "zpath_" + snakeCase(name) + "(" + a + ")"
        if ns == "sys"
            if name == "exit": return "exit(int(" + a + "))"
            if name == "errln": return "eprintln(" + a + ")"
            if name == "err": return "eprint(" + a + ")"
            if name == "cwd": return "os.getwd()"
            if name == "args": return "zlist_of[string](os.args)"
            if name == "getenv": return "os.getenv_opt(" + a + ")"
            if name == "setenv": return "os.setenv(" + a + ", true)"
            if name == "selfExe": return "os.executable()"
            if name == "run": return "zsys_run(" + a + ")"
            if name == "sleep": return "time.sleep(i64(" + a + ") * time.millisecond)"
            if name == "readLine": return "zsys_readline()"
            if name == "exec_inherit": return "zsys_exec_inherit(" + a + ")"
            if name == "writeStdout": return "print(" + a + ")"
            .refuse("sys." + name, span)
            return "zsys_" + snakeCase(name) + "(" + a + ")"
        if ns == "Dir"
            if name == "exists": return "os.is_dir(" + a + ")"
            if name == "createAll": return "os.mkdir_all(" + a + ") or {}"
            if name == "list": return "zdir_list(" + a + ")"
            if name == "deleteAll": return "os.rmdir_all(" + a + ") or {}"
            if name == "tryDeleteAll": return "zdir_try_delete_all(" + a + ")"
            .refuse("Dir." + name, span)
            return "zdir_" + snakeCase(name) + "(" + a + ")"
        if ns == "Terminal"
            if name == "write" and args.count() == 2: return "print(" + .exprStr(args.at(0).value) + " + " + .exprStr(args.at(1).value) + ")"
            if name == "write": return "print(" + a + ")"
            if name == "writeln": return "println(" + a + ")"
            .refuse("Terminal." + name, span)
            return "zterm_" + snakeCase(name) + "(" + a + ")"
        if ns == "Arg"
            if name == "parse": return "zarg_parse()"
            .refuse("Arg." + name, span)
            return "zarg_" + snakeCase(name) + "()"
        if ns == "Json"
            if name == "parse": return "zjson_parse(" + a + ")"
            if name == "object": return "zjson_object()"
            if name == "array": return "zjson_array()"
            if name == "stringify": return "(" + a + ").json_str()"
            .refuse("Json." + name, span)
            return "zjson_" + snakeCase(name) + "(" + a + ")"
        if ns == "Sqlite"
            if name == "open": return "zsqlite_open(" + a + ")"
            .refuse("Sqlite." + name, span)
            return "zsqlite_" + snakeCase(name) + "(" + a + ")"
        if ns == "DateTime"
            if name == "now": return "zdatetime_now()"
            .refuse("DateTime." + name, span)
            return "zdatetime_now()"
        if ns == "Random"
            if name == "randInt": return "zrandom_int(" + a + ")"
            if name == "new": return "zrandom_new(" + a + ")"
            .refuse("Random." + name, span)
            return "zrandom_" + snakeCase(name) + "(" + a + ")"
        if ns == "Hash"
            if name == "sha256": return "zhash_sha256(" + a + ")"
            .refuse("Hash." + name, span)
            return "zhash_" + snakeCase(name) + "(" + a + ")"
        if ns == "Http"
            # V's net.http needs socket headers tcc on Windows does not ship: a stub
            .refuse("Http." + name + " (no HTTP client on this backend: V's net.http needs socket headers tcc does not ship on Windows)", span)
            return "none"
        return ""

    # the call on an object already spelled (a temporary, or the member's object)
    def mappedCall(obj: str, name: str, args: List(Arg), span: Span, rtype: str = ""): str
        if name == "toString" and args.count() == 0: return obj + ".str()"
        if name == "concat" and args.count() == 1: return "(" + obj + " + " + .argsStr(args) + ")"
        if name == "isNumeric" and args.count() == 0: return "zstr_is_numeric(" + obj + ")"
        if name == "toFloat" and args.count() == 0: return "f64(" + obj + ")"
        if name == "toInt" and args.count() == 0: return "i64(" + obj + ")"
        # the containers: the runtime's ZList / ZMap methods, by their names
        if name == "count" and args.count() == 0: return obj + ".count()"
        if name == "at" and args.count() == 1: return obj + ".at(" + .argsStr(args) + ")"
        if name == "add" and args.count() == 1: return obj + ".add(" + .argsStr(args) + ")"
        if name == "set" and args.count() == 2: return obj + ".set(" + .argsStr(args) + ")"
        if name == "get" and args.count() == 1: return obj + ".get(" + .argsStr(args) + ")"
        if name == "has" and args.count() == 1: return obj + ".has(" + .argsStr(args) + ")"
        if name == "keys" and args.count() == 0: return obj + ".keys()"
        if name == "remove" and args.count() == 1: return obj + ".remove(" + .argsStr(args) + ")"
        if name == "copy" and args.count() == 0: return obj + ".copy()"
        if name == "last" and args.count() == 0: return obj + ".last()"
        if name == "isEmpty" and args.count() == 0: return obj + ".is_empty()"
        if name == "values" and args.count() == 0: return obj + ".values()"
        if name == "put" and args.count() == 2: return obj + ".set(" + .argsStr(args) + ")"
        if name == "items" and args.count() == 0: return obj + ".items()"
        if name == "insert" or name == "removeAt"
            .refuse("List." + name + " (V 0.5.2 miscompiles array.insert on a generic element under two instantiations; vlang/v#30253)", span)
        # str (V's own names; a list's split / lines / chars come back boxed)
        if name == "split" and args.count() == 1: return "zstr_split(" + obj + ", " + .argsStr(args) + ")"
        if name == "lines" and args.count() == 0: return "zstr_lines(" + obj + ")"
        if name == "chars" and args.count() == 0: return "zlist_of[u8](" + obj + ".bytes())"   # Zebra's char is a byte
        if name == "bytes" and args.count() == 0: return "zlist_of[u8](" + obj + ".bytes())"   # Zebra's List(byte), the same
        if name == "join" and args.count() == 1: return "zjoin(" + obj + ", " + .argsStr(args) + ")"
        if name == "charAt" and args.count() == 1
            .refuse("str.charAt (Zebra's char is a number whose toString prints it; V has no char type to match -- the next slice decides a char's spelling)", span)
            return "zstr_char_at(" + obj + ", " + .argsStr(args) + ")"
        if name == "padLeft" and args.count() == 2: return "zstr_pad_left(" + obj + ", " + .argsStr(args) + ")"
        if name == "padRight" and args.count() == 2: return "zstr_pad_right(" + obj + ", " + .argsStr(args) + ")"
        if name == "tryInt" and args.count() == 0: return "zstr_try_int(" + obj + ")"
        if name == "tryFloat" and args.count() == 0: return "zstr_try_float(" + obj + ")"
        if name == "indexOf" and args.count() == 1: return "zstr_index_of(" + obj + ", " + .argsStr(args) + ")"
        if name == "replace" and args.count() == 2: return obj + ".replace(" + .argsStr(args) + ")"
        if name == "replaceAll" and args.count() == 2: return obj + ".replace(" + .argsStr(args) + ")"
        if name == "repeat" and args.count() == 1: return obj + ".repeat(int(" + .argsStr(args) + "))"
        if name == "reverse" and args.count() == 0: return obj + ".reverse()"
        if name == "trimLeft" and args.count() == 0: return obj + ".trim_space_left()"
        if name == "trimRight" and args.count() == 0: return obj + ".trim_space_right()"
        if name == "equals" and args.count() == 1: return "(" + obj + " == " + .argsStr(args) + ")"
        if name == "eqlIgnoreCase" and args.count() == 1: return "(" + obj + ".to_lower() == (" + .argsStr(args) + ").to_lower())"
        if name == "build" and args.count() == 0: return obj + ".build()"
        if name == "append" and args.count() == 1: return obj + ".append(" + .argsStr(args) + ")"
        if name == "lastIndexOf" and args.count() == 1: return "zstr_last_index_of(" + obj + ", " + .argsStr(args) + ")"
        if name == "sort" or name == "sortBy" or name == "map" or name == "filter" or name == "reduce" or name == "pop"
            .refuse("." + name + " (needs the receiver's type or a closure: the next slices)", span)
        if name == "contains" and args.count() == 1: return obj + ".contains(" + .argsStr(args) + ")"
        if name == "startsWith" and args.count() == 1: return obj + ".starts_with(" + .argsStr(args) + ")"
        if name == "endsWith" and args.count() == 1: return obj + ".ends_with(" + .argsStr(args) + ")"
        if name == "substring" and args.count() == 2: return obj + "[int(" + .exprStr(args.at(0).value) + ")..int(" + .exprStr(args.at(1).value) + ")]"   # int bounds: MSVC (vlang/v#30352)
        if name == "split" and args.count() == 1: return obj + ".split(" + .argsStr(args) + ")"
        if name == "trim" and args.count() == 0: return obj + ".trim_space()"
        if (name == "upper" or name == "toUpper") and args.count() == 0: return obj + ".to_upper()"
        if (name == "lower" or name == "toLower") and args.count() == 0: return obj + ".to_lower()"
        if name == "clear" and args.count() == 0: return obj + ".clear()"
        # a method on one of the program's own classes: self.m(...) / obj.m(...)
        var key: str = "." + vSafe(name)
        var rt: str = rtype
        if rt.startsWith("&")
            rt = rt.substring(1, rt.len)
        if rt != "" and .sigs.get(rt + "." + vSafe(name)) != nil
            key = rt + "." + vSafe(name)   # the receiver's own method, whatever other classes call theirs
        return obj + "." + vSafe(name) + "(" + .argsStr(args, key) + ")"

    def binaryStr(b: ExprBinary): str
        if b.op == BinaryOp.or_ or b.op == BinaryOp.and_ or b.op == BinaryOp.add
            # decided before any operand is rendered: rendering binds temporaries,
            # and the chain renders its operands itself
            if b.op != BinaryOp.add and .chainLen(b) > 30
                var terms = List(str)()
                .chainTerms(b, terms)
                var fn_: str = "zany"
                if b.op == BinaryOp.and_
                    fn_ = "zall"
                return fn_ + "([" + zjoinStr(terms, ", ") + "])"
            return "(" + .chainStr(b) + ")"
        var l = .exprStr(b.left)
        var r = .exprStr(b.right)
        if b.op == BinaryOp.pow
            .needs_math = true
            return "math.pow(" + l + ", " + r + ")"
        if b.op == BinaryOp.in_
            return r + ".contains(" + l + ")"
        if b.op == BinaryOp.eq or b.op == BinaryOp.ne
            # `x == nil`: through a helper, so V never smart-casts x (the cast
            # name would refuse an `or` block, keep its option type in a binding,
            # and break V's C stage passed back to a generic `?T`)
            var nil_side: str = ""
            if isNilLit(b.right)
                nil_side = .rawName(b.left, l)
            else if isNilLit(b.left)
                nil_side = .rawName(b.right, r)
            if nil_side != ""
                var nt: str = ""
                if isNilLit(b.right)
                    nt = .vTypeOf(b.left)
                else
                    nt = .vTypeOf(b.right)
                var call: str = "zis_none(" + nil_side + ")"
                if nt.startsWith("?")
                    call = "zis_none(" + nt + "(" + nil_side + "))"
                if b.op == BinaryOp.eq
                    return call
                return "(!" + call + ")"   # (parenthesized: `.str()` on it binds to the call otherwise)
            # `opt == value`: Zebra compares a nilable with a value; V does not
            var lt2: str = .vTypeOf(b.left)
            var rt2: str = .vTypeOf(b.right)
            if lt2.startsWith("?") and rt2 != "" and not rt2.startsWith("?")
                if b.op == BinaryOp.eq
                    return "zopt_eq(" + l + ", " + r + ")"
                return "!zopt_eq(" + l + ", " + r + ")"
            if rt2.startsWith("?") and lt2 != "" and not lt2.startsWith("?")
                if b.op == BinaryOp.eq
                    return "zopt_eq(" + r + ", " + l + ")"
                return "!zopt_eq(" + r + ", " + l + ")"
            # `kind == TokenKind.at_id` (a payload-less variant): V compares a sum
            # type with a variant by `is`, never by `==`
            var vt: str = .variantTypeName(b.right)
            var sub: str = l
            if vt == ""
                vt = .variantTypeName(b.left)
                sub = r
            if vt != ""
                if b.op == BinaryOp.eq
                    return "(" + sub + " is " + vt + ")"
                return "!(" + sub + " is " + vt + ")"
        if b.op == BinaryOp.dotdot
            .refused.add("a .. range expression")
            return l
        # (a chain of or / and / + was returned above, before the operands were
        # rendered: flat, and past thirty terms through zany / zall -- V's
        # checker gives up at forty nested levels, and every term is evaluated
        # there, no short-circuit)
        return "(" + l + " " + binaryOpV(b.op) + " " + r + ")"

    # a nil check reads the raw name, narrowed or not (a narrowed read would unwrap)
    def rawName(e: Expr, rendered: str): str
        branch e
            on Expr.ident as id
                if .isNarrowed(id.name)
                    return .localName(id.name)
                return rendered
            on Expr.member as m
                if exprRootIsThis(m.object) and .isNarrowed("self." + vSafe(m.member))
                    return "self." + vSafe(m.member)
                return rendered
            else
                return rendered

    def chainLen(b: ExprBinary): int
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    return .chainLen(lb) + 1
                return 2
            else
                return 2

    def chainTerms(b: ExprBinary, out: List(str))
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    .chainTerms(lb, out)
                else
                    out.add(.exprStr(b.left))
            else
                out.add(.exprStr(b.left))
        out.add(.exprStr(b.right))

    def chainStr(b: ExprBinary): str
        var l: str = ""
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    l = .chainStr(lb)
                else
                    l = .exprStr(b.left)
            else
                l = .exprStr(b.left)
        return l + " " + binaryOpV(b.op) + " " + .exprStr(b.right)

def binaryOpV(op: BinaryOp): str
    if op == BinaryOp.add: return "+"
    if op == BinaryOp.sub: return "-"
    if op == BinaryOp.mul: return "*"
    if op == BinaryOp.div: return "/"
    if op == BinaryOp.int_div: return "/"
    if op == BinaryOp.mod: return "%"
    if op == BinaryOp.bit_and: return "&"
    if op == BinaryOp.bit_or: return "|"
    if op == BinaryOp.bit_xor: return "^"
    if op == BinaryOp.shl: return "<<"
    if op == BinaryOp.shr: return ">>"
    if op == BinaryOp.eq: return "=="
    if op == BinaryOp.ne: return "!="
    if op == BinaryOp.lt: return "<"
    if op == BinaryOp.le: return "<="
    if op == BinaryOp.gt: return ">"
    if op == BinaryOp.ge: return ">="
    if op == BinaryOp.and_: return "&&"
    if op == BinaryOp.or_: return "||"
    return "?"

def assignOpV(op: AssignOp): str
    if op == AssignOp.assign: return "="
    if op == AssignOp.plus_eq: return "+="
    if op == AssignOp.minus_eq: return "-="
    if op == AssignOp.star_eq: return "*="
    if op == AssignOp.slash_eq: return "/="
    if op == AssignOp.slashslash_eq: return "/="
    if op == AssignOp.percent_eq: return "%="
    if op == AssignOp.ampersand_eq: return "&="
    if op == AssignOp.vertical_bar_eq: return "|="
    if op == AssignOp.caret_eq: return "^="
    if op == AssignOp.double_lt_eq: return "<<="
    if op == AssignOp.double_gt_eq: return ">>="
    return "="

# "selfhost/CodeGen.zbr" -> "CodeGen"
def moduleStem(file: str): str
    var segs: List(str) = file.split("/")
    var last: str = segs.at(segs.count() - 1)
    var bs: List(str) = last.split("\\")
    last = bs.at(bs.count() - 1)
    if last.endsWith(".zbr")
        return last.substring(0, last.len - 4)
    return last

def zjoinStr(xs: List(str), sep: str): str
    var out: str = ""
    var first: bool = true
    for x in xs
        if not first
            out = out + sep
        first = false
        out = out + x
    return out

def isDigits(s: str): bool
    if s.len == 0
        return false
    var i: int = 0
    while i < s.len
        if s[i] < '0' or s[i] > '9'
            return false
        i = i + 1
    return true

# the Nth type argument of `ZTuple2[A, B]` (a nested generic's commas sit deeper)
def tupleElemType(vt: str, n: str): str
    var open_: int = vt.indexOf("[")
    if open_ < 0
        return ""
    var inner: str = vt.substring(open_ + 1, vt.len - 1)
    var parts = List(str)()
    var depth: int = 0
    var cur: str = ""
    var i: int = 0
    while i < inner.len
        var ch = inner[i]
        if ch == '['
            depth = depth + 1
        if ch == ']'
            depth = depth - 1
        if ch == ',' and depth == 0
            parts.add(cur.trim())
            cur = ""
        else
            cur = cur + inner[i..i + 1]
        i = i + 1
    parts.add(cur.trim())
    var want: int = 0
    if n.tryInt() as w
        want = w
    if want < parts.count()
        return parts.at(want)
    return ""

def isIntLit(e: Expr): bool
    branch e
        on Expr.int_lit
            return true
        else
            return false

# the Json methods no other type has (dispatched without the receiver's type)
def isJsonOnlyMethod(name: str): bool
    # (not tryInt / tryFloat: a string has them)
    return name == "tryStr" or name == "tryBool" or name == "tryObj" or name == "tryList" or name == "isNull" or name == "isObject" or name == "isArray" or name == "putInt" or name == "putFloat" or name == "putBool" or name == "appendInt" or name == "appendFloat" or name == "appendBool"

# the stdlib methods whose result is a string, whatever the receiver
def isStringReturningMethod(name: str): bool
    return name == "trim" or name == "trimLeft" or name == "trimRight" or name == "upper" or name == "lower" or name == "substring" or name == "replace" or name == "replaceAll" or name == "repeat" or name == "padLeft" or name == "padRight" or name == "concat" or name == "join" or name == "toString" or name == "stringify" or name == "build"

def isJsonPutMethod(name: str): bool
    return name == "put" or name == "putInt" or name == "putFloat" or name == "putBool" or name == "append" or name == "appendInt" or name == "appendFloat" or name == "appendBool"

def isStringLit(e: Expr): bool
    branch e
        on Expr.string_lit
            return true
        on Expr.string_interp
            return true
        else
            return false

# a name READ somewhere in the statements: through expressions only, an
# assignment's target excluded (V counts an assigned-only local as unused)
def readsName(name: str, stmts: List(Stmt)): bool
    for s in stmts
        if readsNameStmt(name, s)
            return true
    return false

def readsNameStmt(name: str, s: Stmt): bool
    branch s
        on Stmt.assign as a
            if mightUseNameInExpr(name, a.value)
                return true
            branch a.target
                on Expr.member as m
                    return mightUseNameInExpr(name, m.object)
                on Expr.index as ix
                    return mightUseNameInExpr(name, ix.object) or mightUseNameInExpr(name, ix.index)
                else
                    return false
        on Stmt.var_ as v
            if v.init_expr as ie
                return mightUseNameInExpr(name, ie)
            return false
        on Stmt.expr as e
            return mightUseNameInExpr(name, e)
        on Stmt.if_ as i
            if mightUseNameInExpr(name, i.cond) or readsName(name, i.then_stmts)
                return true
            for ei in i.else_ifs
                if mightUseNameInExpr(name, ei.cond) or readsName(name, ei.stmts)
                    return true
            if i.else_stmts as es
                return readsName(name, es)
            return false
        on Stmt.while_ as w
            return mightUseNameInExpr(name, w.cond) or readsName(name, w.stmts)
        on Stmt.for_in as fi
            if mightUseNameInExpr(name, fi.iter) or readsName(name, fi.stmts)
                return true
            if fi.filter as flt
                return mightUseNameInExpr(name, flt)
            return false
        on Stmt.for_num as fnum
            if mightUseNameInExpr(name, fnum.start) or mightUseNameInExpr(name, fnum.stop_) or readsName(name, fnum.stmts)
                return true
            if fnum.step as st
                return mightUseNameInExpr(name, st)
            return false
        on Stmt.return_ as r
            if r.value as rv
                return mightUseNameInExpr(name, rv)
            return false
        on Stmt.branch_ as b
            if mightUseNameInExpr(name, b.expr)
                return true
            for arm in b.cases
                for v in arm.values
                    if mightUseNameInExpr(name, v)
                        return true
                if readsName(name, arm.stmts)
                    return true
            if b.else_ as es
                return readsName(name, es)
            return false
        on Stmt.try_catch as tc
            if readsName(name, tc.stmts)
                return true
            for cl in tc.clauses
                if readsName(name, cl.stmts)
                    return true
            return false
        on Stmt.print_ as p
            for a in p.args
                if mightUseNameInExpr(name, a)
                    return true
            return false
        else
            return mightUseNameStmt(name, s)   # the rest: the conservative walker

# the statements from index `from` on (a copy: the walker takes a list)
def restOf(stmts: List(Stmt), from: int): List(Stmt)
    var out = List(Stmt)()
    var i: int = from
    while i < stmts.count()
        out.add(stmts.at(i))
        i = i + 1
    return out

def isBoolLit(e: Expr): bool
    branch e
        on Expr.bool_lit
            return true
        else
            return false

# a block whose last statement leaves it: Zebra's narrowing holds after it
def endsWithExit(stmts: List(Stmt)): bool
    if stmts.count() == 0
        return false
    branch stmts.at(stmts.count() - 1)
        on Stmt.return_
            return true
        on Stmt.raise_
            return true
        on Stmt.break_
            return true
        on Stmt.continue_
            return true
        else
            return false

# a rendered Json value converted to the receiving type
def coerceRendered(s: str, want: str): str
    if want == "i64": return s + ".i64()"
    if want == "f64": return s + ".f64()"
    if want == "bool": return s + ".bool()"
    if want == "string": return "zjson_str(" + s + ")"
    if want == "&ZList[json2.Any]": return "zjson_list(" + s + ")"   # a Json array as a List(JsonValue)
    return s

def isLambdaExpr(e: Expr): bool
    branch e
        on Expr.lambda
            return true
        else
            return false

def isIdentExpr(e: Expr): bool
    branch e
        on Expr.ident
            return true
        else
            return false

def isNilLit(e: Expr): bool
    branch e
        on Expr.nil_
            return true
        else
            return false

def isUntypedListLit(e: Expr): bool
    branch e
        on Expr.list_lit as ll
            return ll.elem_type == nil
        else
            return false

# whether a body assigns to a field of this (`.x = ...`), through if / while /
# for bodies: a struct method that does needs a `mut` receiver
def exprRootIsThis(e: Expr): bool
    branch e
        on Expr.member as m
            return exprRootIsThis(m.object)
        on Expr.index as ix
            return exprRootIsThis(ix.object)
        on Expr.this_
            return true
        else
            return false

def dropLast(xs: List(str)): List(str)
    var out = List(str)()
    var i: int = 0
    while i < xs.count() - 1
        out.add(xs.at(i))
        i = i + 1
    return out

def methodNames(members: List(Decl), statics: bool): List(str)
    var out = List(str)()
    for mem in members
        branch mem
            on Decl.method as mth
                if mth.mods.is_static == statics
                    out.add(mth.name)
            else
                pass
    return out

def isBareCtor(e: Expr): bool
    branch e
        on Expr.call as c
            if c.args.count() != 0
                return false
            branch c.callee
                on Expr.ident as id
                    return id.name == "List" or id.name == "HashMap" or id.name == "Set"
                else
                    return false
        else
            return false

def fieldNames(members: List(Decl)): List(str)
    var out = List(str)()
    for mem in members
        branch mem
            on Decl.var_ as f
                out.add(f.name)
            else
                pass
    return out

# a name, or a field path of names: what V's smart cast takes
def isNameExpr(e: Expr): bool
    branch e
        on Expr.ident
            return true
        on Expr.this_
            return true
        on Expr.member as m
            return isNameExpr(m.object)
        else
            return false

def isCallExpr(e: Expr): bool
    branch e
        on Expr.call
            return true
        else
            return false

# a condition without its outer parentheses (V warns on `if (x) {`): one
# balanced outer pair is stripped, never an inner one
def condStr(s: str): str
    if s.len < 2 or not s.startsWith("(") or not s.endsWith(")")
        return s
    var depth: int = 0
    var i: int = 0
    var quote: char = ' '   # inside a '...' or `...` literal: its parentheses are text
    var in_lit: bool = false
    for ch in s.chars()
        if in_lit
            if ch == quote
                in_lit = false
        else if ch == '\'' or ch == '`'
            in_lit = true
            quote = ch
        else if ch == '('
            depth = depth + 1
        else if ch == ')'
            depth = depth - 1
            if depth == 0 and i < s.len - 1
                return s   # the first pair closes before the end: not an outer pair
        i = i + 1
    return s.substring(1, s.len - 1)

# the builtin namespaces a static access may name
def isBuiltinNs(ns: str): bool
    return ns == "File" or ns == "Path" or ns == "sys" or ns == "Dir" or ns == "Json" or ns == "Random" or ns == "Hash" or ns == "Http" or ns == "Arg" or ns == "Terminal" or ns == "Sqlite" or ns == "DateTime"

def isFloatLit(e: Expr): bool
    branch e
        on Expr.float_lit
            return true
        else
            return false

# the entry: the V source for a module, with the refusals
def generateV(ms: List(Module), runtime: str): VResult
    var g = VGen()
    var body = g.genModules(ms)
    var head: str = "// generated by zebra --target v (proof of concept, 2026-10-13); do not edit\n"
    # the runtime (inlined below) uses math, os and strconv: always imported
    # (an import the program itself never reaches is used by the runtime's
    # functions, so V does not warn)
    head = head + "import math\nimport math.bits\nimport os\nimport strconv\nimport time\nimport x.json2\nimport rand\nimport crypto.sha256\n"
    # the runtime's sqlite section (V's db.sqlite, 9 MB of C to compile) goes
    # in, with its import, only when the program names it
    var rt_text: str = runtime
    var needs_sqlite: bool = body.contains("zsqlite_") or body.contains("ZSqliteDb") or body.contains("ZSqliteRow")
    if needs_sqlite
        head = head + "import db.sqlite\n"
    else
        var sa: int = rt_text.indexOf("// == sqlite begin ==")
        var sb: int = rt_text.indexOf("// == sqlite end ==")
        if sa >= 0 and sb > sa
            rt_text = rt_text.substring(0, sa) + "// (the sqlite section is left out: the program has no database)\n" + rt_text.substring(sb + "// == sqlite end ==".len, rt_text.len)
    head = head + "\n// -- the Zebra runtime for V (selfhost/zebra_rt.v), inlined so one file runs --\n" + rt_text + "\n// -- the program --\n"
    return VResult(source: head + body, refused: g.refused, needs_math: g.needs_math, has_globals: g.has_globals)
