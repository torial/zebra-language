ce_skipping_top_frames_linux print_backtrace_skipping_top_frames_mingw print_backtrace_skipping_top_frames_msvc print_backtrace_skipping_top_frames_tcc print_libbacktrace race_stdio_read race_stdio_write reference_map_hash reference_word set_stream_binary_mode set_stream_unbuffered should_break_grapheme split_generic_params string_bytes_equal string_concat_pair string_contains_byte string_content_equal string_graphemes_impl string_index_byte string_index_pair string_int_base string_last_index_byte string_plus_many string_plus_many_general test_bool_size test_c_strstr_is_declared test_fixed_precision_float_interpolation test_fixed_precision_interpolation_allocation_budget test_float_interpolation_buffers_preserve_evaluation_order test_g_main_argc test_g_main_argv test_generic_fixed_float_interpolation_keeps_conversion_helpers test_live_local_in_asan_fake_frame_is_a_root test_map_hash_bytes_matches_the_reference_at_every_length_and_alignment test_prealloc_reclaims_cached_blocks_before_reporting_out_of_memory test_register_spills_keep_physical_stack_bounds test_saved_registers_are_roots_under_memory_sanitizer test_str_intp_fixed_float_builder_path test_v_getpid__and__v_gettid trace_error u128_to_bin u128_to_hex u64_to_hex u64_to_hex_no_leading_zeros unhandled_exception_handler utf8_decode_rune utf8_grapheme_visible_length utf8_is_continuation utf8_rune_visible_width v3_gcboehm_runtime_init v3_vgc_runtime_init v_fixed_index v_fixed_index_i64 v_fixed_index_ni v_fixed_index_u64 v_ni_index v_segmentation_fault_handler v_slice_index_i64 v_slice_index_u64 vbacktrace vbacktrace_symbols vbacktrace_symbols_fd vgc_alloc_large vgc_arena_map_add vgc_cache_get_span vgc_calloc vgc_can_use_work_fastpath vgc_central_file_span vgc_central_get_span vgc_central_return_span vgc_clear_mark_bits vgc_collect vgc_count_marked vgc_do_sweep vgc_drain_mark_work vgc_enable vgc_ensure_registered vgc_enter vgc_find_arena vgc_find_span vgc_free vgc_free_obj vgc_gc_run vgc_gc_start vgc_get_free_span vgc_get_obj_size vgc_heap_live vgc_heap_usage vgc_is_enabled vgc_is_heap_ptr vgc_live_sum vgc_malloc vgc_malloc_noscan vgc_malloc_noscan_opts vgc_malloc_typed vgc_malloc_typed_opts vgc_mark_data_segments vgc_mark_roots vgc_maybe_gc vgc_memdup vgc_memdup_noscan vgc_memdup_typed vgc_memory_use vgc_meta_alloc vgc_new_arena vgc_next_span vgc_on_thread_exit vgc_parallel_mark vgc_push_free_span vgc_put_free_span vgc_realloc vgc_refresh_stack_range_for_sp vgc_register_thread vgc_reset_cache vgc_safepoint vgc_safepoint_at vgc_safepoint_wait vgc_scan_precise vgc_scan_range vgc_scan_range_skipping vgc_scan_stack_range vgc_shade vgc_span_alloc vgc_span_alloc_obj vgc_span_init vgc_span_set_bitmaps vgc_sweep_and_file_span vgc_sweep_finish vgc_sweep_span vgc_sweep_spans vgc_take_free_span vgc_test_check_spill_bounds vgc_test_mark_register_window vgc_test_mark_stack_window vgc_test_root_marked vgc_total_alloc vgc_unregister_thread vgc_update_trigger vgc_wait_for_stops vgc_work_get vgc_work_put vgc_write_barrier vmemcpy_unchecked vmemory_abort_on_nil vmemory_align_up vmemory_block_current_or_new vmemory_block_free vmemory_block_free_after vmemory_block_free_chain vmemory_block_grow vmemory_block_init_thread vmemory_block_malloc vmemory_block_malloc_aligned vmemory_block_new vmemory_block_new_sized vmemory_block_size vmemory_block_used vmemory_effective_align vqsort vsort_ptr_at vstable_sort_merge write_buf_to_console write_buf_to_console_kernel32 write_buf_to_fd_kernel32 write_buf_to_fd_kernel32_or_exit write_buf_to_fd_kernel32_status write_buf_to_fd_windows_non_minimal write_buf_to_std_handle_kernel32 wtf8_from_wide wtf8_to_wide "

def isVBuiltinPrivate(s: str): bool
    return s.len > 3 and vBuiltinPrivateNames().contains(" " + s + " ")

# a class's or a struct's constructor: `new_<name>`, moved off a builtin's private name
def ctorName(name: str): str
    var n: str = "new_" + snakeCase(name)
    if isVBuiltinPrivate(n)
        return n + "_"
    return n

def vSafe(name: str): str
    var s = snakeCase(name)
    if s.startsWith("_")
        s = "u" + s   # V refuses a name beginning with `_`
    if s == "match" or s == "type" or s == "struct" or s == "fn" or s == "mut" or s == "pub" or s == "import" or s == "module" or s == "go" or s == "select" or s == "lock" or s == "rlock" or s == "shared" or s == "atomic" or s == "none" or s == "sizeof" or s == "typeof" or s == "unsafe" or s == "defer" or s == "goto" or s == "asm" or s == "union" or s == "interface" or s == "enum" or s == "const" or s == "in" or s == "is" or s == "as" or s == "or" or s == "isreftype" or s == "dump" or s == "spawn" or s == "volatile" or s == "static" or s == "nil" or s == "sql" or s == "likely" or s == "unlikely" or s == "implements" or s == "true" or s == "false" or s == "init" or s == "cleanup"
        return s + "_"   # (init / cleanup: V's module hooks -- `fn init() Counter` is "cannot have a return type", 2026-10-14)
    # C's own words, which V emits verbatim into its C (tcc read a loop
    # variable `cdecl` as its calling-convention keyword)
    if s == "cdecl" or s == "stdcall" or s == "fastcall" or s == "int" or s == "char" or s == "float" or s == "double" or s == "long" or s == "short" or s == "void" or s == "signed" or s == "unsigned" or s == "auto" or s == "register" or s == "extern" or s == "inline" or s == "restrict" or s == "typedef" or s == "switch" or s == "case" or s == "default" or s == "do" or s == "while" or s == "for" or s == "if" or s == "else" or s == "break" or s == "continue" or s == "return" or s == "bool" or s == "near" or s == "far" or s == "pascal" or s == "huge"
        return s + "_"   # (near / far / pascal / huge: macros in tcc's Windows headers)
    # V's type names are no variable names (`mut map := ...`)
    if s == "map" or s == "string" or s == "array" or s == "chan" or s == "thread" or s == "any" or s == "voidptr" or s == "byte" or s == "rune" or s == "int" or s == "f32" or s == "f64" or s == "i8" or s == "i16" or s == "i32" or s == "i64" or s == "u8" or s == "u16" or s == "u32" or s == "u64" or s == "isize" or s == "usize" or s == "char"
        return s + "_"
    # the modules the emitted file imports: a parameter `time` was a duplicate of one
    # every symbol the emitted file's imports bind (sync, sqlite and http were missing
    # until 2026-11-12; generateV refuses an import whose symbol is not here)
    if s == "time" or s == "os" or s == "math" or s == "strconv" or s == "rand" or s == "sha256" or s == "json2" or s == "bits" or s == "sync" or s == "sqlite" or s == "http" or s == "hmac" or s == "argon2" or s == "crand" or s == "net"
        return s + "_"
    # a private function of V's builtin module (vlang/v#32404)
    if isVBuiltinPrivate(s)
        return s + "_"
    return s

class VGen
    var sb: StringBuilder
    var depth: int
    var refused: List(str)
    var class_names: List(str)
    var struct_names: List(str)   # value types: V structs by value
    var enum_names: List(str)
    var union_names: List(str)    # V sum types over per-variant structs
    var sigs: HashMap(str, FnSig) # by callee name: a function, `new_<type>`, a method (a name shared across types keeps the first)
    var member_counts: HashMap(str, int)   # a union's variants, an enum's members: whether a branch over them is exhaustive (V refuses an `else` on an exhaustive match)
    var current_params: List(Param)   # the enclosing def's parameters (a def-level catch closes over them)
    var current_ret: str              # the enclosing def's V return type ("" for none)
    var in_method: bool               # inside a method (a def-level catch there is refused: a closure's capture of self is V's call)
    var catch_bindings: List(str)     # the error bindings in scope: `e.message` is `e.msg()` on these
    var current_fields: List(str)     # the enclosing class's / struct's fields: a bare name among them is `self.<field>`
    var module_names: List(str)       # the used modules' names: `Mod.Name` is `Name` in the one V file
    var current_methods: List(str)    # the enclosing class's instance methods: a bare call among them is `self.m(...)`
    var current_statics: List(str)    # the enclosing class's static methods: a bare call among them is `class_m(...)`
    var local_types: HashMap(str, str)  # the V type of each param and local declared so far (what a receiver is)
    var field_types: HashMap(str, str)  # the V type of each field of the enclosing class / struct
    var heap_names: List(str)         # the structs some `^T` targets: reference types in V (their constructors allocate)
    var global_types: HashMap(str, str)  # the V type of each module-level var
    var union_payloads: HashMap(str, str)   # `U_v` -> the V type of the variant's payload
    var boxed_variants: HashMap(str, bool)  # `U_v` -> whether its payload is boxed (`&ZBox[U_v's payload]`): decided once by isBoxed -- V master's sum is an inline tagged union (vlang/v#29578), a value cycle is refused
    var variant_union: HashMap(str, str)    # `U_v` -> `U`
    var current_file: str             # the module being emitted (a refusal names it)
    var has_globals: bool             # a `__global` was emitted
    var global_dedup: HashMap(str, str)   # a module-level var's numbered spelling when a sibling snake-cases alike
    var uses_gui: bool                # the program names Gui or CodeEditor: it needs a --gui-backend section
    var sig_conflicts: List(str)      # a callee name two declarations share with different parameters: called by position
    var rets: HashMap(str, str)       # the V return type of each def / method by name (`Owner.name` for a static), "" when two differ
    var struct_mut: bool              # the struct being emitted has a method that assigns a field: every method is `mut self`
    var mut_structs: List(str)        # the structs whose methods are all `mut self` (a pass before emission)
    var in_cond: bool                 # emitting a loop's condition: no line may be hoisted before it
    var in_ctor: bool                 # emitting a constructor's body: a bare return is `return self`
    var iface_target: bool            # rendering a value for an interface-typed place: a narrowed read is V's own unwrap there
    var narrowed_or_used: bool        # the last narrowed read was rendered in the `or` form (coerced binds it before an interface)
    var current_exposed: HashMap(str, str)   # a name the module's `use ... exposing` lines name -> the stem that exposes it
    var def_modules: HashMap(str, List(str))   # a free function's name -> the module stems that declare it
    var current_stem: str             # the module being emitted, by its file's stem
    var current_uses: List(str)       # the stems the module being emitted uses
    var capturing: bool               # a function body is being captured (a stub replaces it if anything is refused)
    var fn_names: List(str)           # every free function's V name (a local of that name is renamed)
    var global_inits: List(str)       # `name = value` for every __global, set by zglobals_init() at main's start
    var region_depth: int             # the `allocate` blocks (regions on the collected heap) open in the function being emitted
    var fn_region_base: int           # region_depth at the enclosing function's entry: a return / raise pops down to it
    var loop_region_base: int         # region_depth at the innermost loop's entry: a break / continue pops down to it
    var global_modules: HashMap(str, List(str))   # a module-level var's name -> the module stems that declare it
    var iface_names: List(str)        # the interfaces: V interfaces, their values pointers to classes
    var sig_names: List(str)          # the sig types: a lambda passed as one is cast to its name
    var emitted_globals: List(str)    # every module-level const / var as emitted: a local of that name is renamed (V's one namespace)
    var sig_canon: HashMap(str, str)  # a sig's name -> the first-declared sig of its V shape (vlang/v#30282: one instantiation per shape)
    var sig_shapes: HashMap(str, str) # a V shape (param types with mut, the return) -> the first sig declared with it
    var narrowed: List(str)           # the nilable locals Zebra narrows in the current block: read as zunwrap(?T(x))
    var aliases: HashMap(str, TypeRef)   # `type Alias = Base`: resolved to the base wherever named
    var renames: HashMap(str, str)    # a local's Zebra name -> its V name when renamed
    var captured: List(str)           # the body's lines while capturing
    var all_field_types: HashMap(str, str)  # `Name.field` -> the V type, every class and struct
    var local_names: List(str)        # the params and locals declared so far in the enclosing def (they shadow a field)
    var matchN: int               # the temporaries bound for `branch`
    var current_class: str        # "" outside a class
    var needs_math: bool
    var tmpN: int                 # the temporaries bound for mutating calls on call results
    var show_names: HashMap(str, str)    # BUG-723: a nested container's printer, by its V type and quoting -> the helper's name
    var show_helpers: List(str)          # those helpers' V text, appended after the program (a top-level fn each)
    var show_fields: HashMap(str, List(str))   # BUG-746: a class's / struct's fields in declared order, for its printed text
    var own_tostring: HashMap(str, bool)       # the classes and structs that declare `cue toString()`
    var refused_once: HashMap(str, bool)       # a refusal said once however often its cause is met (a type is spelled many times)
    var rt_fns: HashMap(str, bool)       # the runtime's free functions, read from zebra_rt.v (noteRuntime)
    var rt_types: HashMap(str, bool)     # the runtime's struct / type / enum / interface names, the same
    var rt_methods: HashMap(str, bool)   # `ZList.add`: the runtime's methods by receiver type, the same
    var rt_receivers: HashMap(str, bool) # the receiver types those methods hang on (a call on one is checked)
    var rt_unverified: int               # method calls on a receiver of unknown type: unchecked, and counted
    var arith_unchecked: int             # BUG-667: arithmetic on an operand of unknown or unmapped integer type: V wraps it, counted
    var ref_params: HashMap(str, List(bool))   # by callee name (a function, `new_<class>`, a method): which params are references, hence `mut` (V's rule for a param mutated through a method; a method name shared across classes keeps the first)

    cue init()
        .sb = StringBuilder()
        .depth = 0
        .refused = List(str)()
        .class_names = List(str)()
        .struct_names = List(str)()
        .enum_names = List(str)()
        .union_names = List(str)()
        .sigs = HashMap(str, FnSig)()
        .member_counts = HashMap(str, int)()
        .current_params = List(Param)()
        .current_ret = ""
        .in_method = false
        .catch_bindings = List(str)()
        .current_fields = List(str)()
        .module_names = List(str)()
        .current_methods = List(str)()
        .current_statics = List(str)()
        .local_types = HashMap(str, str)()
        .field_types = HashMap(str, str)()
        .heap_names = List(str)()
        .global_types = HashMap(str, str)()
        .union_payloads = HashMap(str, str)()
        .boxed_variants = HashMap(str, bool)()
        .variant_union = HashMap(str, str)()
        .current_file = ""
        .has_globals = false
        .sig_conflicts = List(str)()
        .rets = HashMap(str, str)()
        .struct_mut = false
        .mut_structs = List(str)()
        .in_cond = false
        .in_ctor = false
        .iface_target = false
        .narrowed_or_used = false
        .current_exposed = HashMap(str, str)()
        .def_modules = HashMap(str, List(str))()
        .current_stem = ""
        .current_uses = List(str)()
        .capturing = false
        .captured = List(str)()
        .fn_names = List(str)()
        .global_inits = List(str)()
        .region_depth = 0
        .fn_region_base = 0
        .loop_region_base = 0
        .global_modules = HashMap(str, List(str))()
        .iface_names = List(str)()
        .sig_names = List(str)()
        .emitted_globals = List(str)()
        .sig_canon = HashMap(str, str)()
        .sig_shapes = HashMap(str, str)()
        .narrowed = List(str)()
        .aliases = HashMap(str, TypeRef)()
        .renames = HashMap(str, str)()
        .all_field_types = HashMap(str, str)()
        .local_names = List(str)()
        .matchN = 0
        .current_class = ""
        .needs_math = false
        .tmpN = 0
        .show_names = HashMap(str, str)()
        .show_helpers = List(str)()
        .show_fields = HashMap(str, List(str))()
        .own_tostring = HashMap(str, bool)()
        .refused_once = HashMap(str, bool)()
        .ref_params = HashMap(str, List(bool))()
        .rt_fns = HashMap(str, bool)()
        .rt_types = HashMap(str, bool)()
        .rt_methods = HashMap(str, bool)()
        .rt_receivers = HashMap(str, bool)()
        .rt_unverified = 0
        .arith_unchecked = 0

    def refuse(what: str, span: Span)
        .refused.add(what + " (" + .current_file + ":" + span.line.toString() + ")")

    # a refusal that has no one place: said once
    def refuseOnce(what: str)
        if .refused_once.get(what) != nil
            return
        .refused_once.set(what, true)
        .refused.add(what)

    # A container of an optional: V's generics take no option type (`cannot use
    # Option type name as concrete type`), so the runtime's boxed containers
    # cannot hold one. Refused by name where the type is spelled; until the show
    # work of BUG-746 it reached V and failed there.
    def noOptionalElement(kind: str, et: str)
        if et.startsWith("?")
            .refuseOnce("a " + kind + " of an optional (" + et + "): V's generics take no option type, so the V route's containers cannot hold one")

    # ── the runtime's names ────────────────────────────────────────────────
    # What zebra_rt.v DEFINES, read from the runtime text itself rather than
    # kept by hand: the emitter writes `zstr_pad_left(...)` or `l.contains(x)`
    # on a ZList, and when the runtime has no such name the file used to be
    # reported "nothing refused" and then failed in V (the 2026-10-30 census:
    # 152 of 436 "clean" files did not build). A call the emitter writes into
    # the runtime is checked against this table and refused, by name, when
    # the runtime does not define it.
    def noteRuntime(text: str)
        for raw in text.split("\n")
            var ln: str = raw
            if ln.startsWith("pub ")
                ln = ln.substring(4, ln.len)
            if ln.startsWith("fn (")
                var close: int = ln.indexOf(")")
                if close > 4 and close + 2 < ln.len
                    var recv: List(str) = ln.substring(4, close).split(" ")
                    var ty: str = rtBaseType(recv.at(recv.count() - 1))
                    var mname: str = identPrefix(ln.substring(close + 2, ln.len))
                    if ty != "" and mname != ""
                        .rt_methods.set(ty + "." + mname, true)
                        .rt_receivers.set(ty, true)
            else if ln.startsWith("fn ")
                var fname: str = identPrefix(ln.substring(3, ln.len))
                if fname != ""
                    .rt_fns.set(fname, true)
            else
                for kw in ["struct ", "type ", "enum ", "interface "]
                    if ln.startsWith(kw)
                        var tname: str = identPrefix(ln.substring(kw.len, ln.len))
                        if tname != ""
                            .rt_types.set(tname, true)
        # A table that parsed to almost nothing would refuse every runtime call
        # (loud), and a check that silently stopped looking would refuse none
        # (quiet): both are reported, the second through its controls.
        if .rt_fns.count() < 50 or .rt_types.count() < 10 or .rt_methods.count() < 30
            .refused.add("the runtime-name check: zebra_rt.v parsed to " + .rt_fns.count().toString() + " functions, " + .rt_types.count().toString() + " types and " + .rt_methods.count().toString() + " methods, under its floor -- no call into the runtime was checked")
        else if .rt_fns.get("zlist_contains") == nil or .rt_methods.get("ZList.add") == nil or .rt_fns.get("zbr_control_never_defined") != nil
            .refused.add("the runtime-name check: its controls failed (zlist_contains and ZList.add must be found, zbr_control_never_defined must not) -- no call into the runtime was checked")

    # a call the emitter wrote: `zname(...)` / `zname[T](...)` into the runtime
    # (a name the emitter itself spells, never a user's), checked by name
    def rtFree(r: str, span: Span): str
        if not r.startsWith("z")
            return r
        var name: str = identPrefix(r)
        if name.len >= r.len or not name.contains("_")
            return r
        var next: str = r.substring(name.len, name.len + 1)
        if next != "(" and next != "["
            return r
        if .rt_fns.get(name) == nil
            .refuse("`" + name + "` (the emitter writes it; zebra_rt.v does not define it)", span)
        return r

    # `obj.m(...)` the emitter wrote on a receiver of the runtime's types,
    # checked against the methods zebra_rt.v declares for that type; on a
    # receiver of unknown type, counted rather than passed in silence
    def rtMethod(r: str, obj: str, rtype: str, span: Span): str
        if not r.startsWith(obj)
            return .rtFree(r, span)
        if not r.startsWith(obj + ".")
            return r   # the receiver itself, indexed or sliced (`s[a..b]`): no call into the runtime
        if rtype == ""
            .rt_unverified = .rt_unverified + 1
            return r
        var base: str = rtBaseType(rtype)
        if .rt_receivers.get(base) == nil
            return r
        var mname: str = identPrefix(r.substring(obj.len + 1, r.len))
        if mname != "" and mname != "str" and .rt_methods.get(base + "." + mname) == nil
            .refuse("`" + base + "." + mname + "` (the emitter writes it; zebra_rt.v declares no such method)", span)
        return r

    def line(s: str)
        var out: str = ""
        var i: int = 0
        while i < .depth
            out = out + "\t"
            i = i + 1
        out = out + s + "\n"
        if .capturing
            .captured.add(out)
        else
            .sb.append(out)

    # a line already indented and ended (one caught by chainStr), re-emitted
    # one level deeper
    def lineRaw(s: str)
        var out: str = "\t" + s
        if .capturing
            .captured.add(out)
        else
            .sb.append(out)

    # a function's body: captured, and replaced by a stub when any construct
    # in it was refused -- the program compiles and runs, and the gap names
    # itself when the function is reached (the refusal list says it was stubbed)
    def genBody(stmts: List(Stmt), what: str)
        var mark: int = .refused.count()
        .capturing = true
        .captured = List(str)()
        .genStmts(stmts)
        .capturing = false
        if .refused.count() > mark
            var reasons: str = ""
            var k: int = mark
            while k < .refused.count()
                if reasons != ""
                    reasons = reasons + "; "
                reasons = reasons + .refused.at(k)
                .refused.set(k, .refused.at(k) + " [in " + what + ": stubbed]")
                k = k + 1
            .line("zbr_panic('not on the V backend: " + .vEscape(what + ": " + reasons) + "')")
        else
            for l in .captured
                .sb.append(l)
        .captured = List(str)()

    # ── types ──────────────────────────────────────────────────────────────
    def vType(t: TypeRef?): str
        if t == nil
            return ""
        branch t!
            on TypeRef.named as n
                return .vNamed(n.name)
            on TypeRef.generic as g
                # the containers are references, as Zebra's are: the runtime's
                # boxed ZList / ZMap by reference (zebra_rt.v), never V's value arrays
                if g.name == "List" and g.args.count() == 1
                    var list_et: str = .vType(g.args.at(0))
                    .noOptionalElement("List", list_et)
                    return "&ZList[" + list_et + "]"
                if g.name == "HashMap" and g.args.count() == 2
                    var map_vt: str = .vType(g.args.at(1))
                    .noOptionalElement("HashMap", map_vt)
                    return "&ZMap[" + .vType(g.args.at(0)) + ", " + map_vt + "]"
                if g.name == "Set" and g.args.count() == 1
                    var set_et: str = .vType(g.args.at(0))
                    .noOptionalElement("Set", set_et)
                    return "&ZSet[" + set_et + "]"
                if g.name == "Chan" and g.args.count() == 1
                    return "chan " + .vType(g.args.at(0))   # V's own channel
                if g.name == "Atomic" and g.args.count() == 1
                    return "&ZAtomic[" + .vType(g.args.at(0)) + "]"   # the runtime's value under a mutex
                if (g.name == "int" or g.name == "uint") and g.args.count() == 1
                    # `int(8)`, `uint(16)`: the sized type by its width, where V has one
                    branch g.args.at(0)
                        on TypeRef.named as wn
                            var wsized: str = vSizedIntName(g.name + wn.name)
                            if wsized != "" and wsized != "?"
                                return wsized
                        else
                            pass
                    .refused.add("the type " + g.name + "(N) of a width V has no integer for (8, 16, 32 and 64 are mapped)")
                    return "i64"
                .refused.add("generic type " + g.name)
                return "voidptr"
            on TypeRef.void_
                return ""
            on TypeRef.nilable as inner
                return "?" + .vType(inner)
            on TypeRef.ref_to as inner
                # `^T`: a reference; a class or a heap struct is one already, and
                # a union is V's sum type -- a boxed fat pointer by value
                var s: str = .vType(inner)
                if s.startsWith("?")
                    # `^T?`: an option of the reference (`?&Name`), of the union (`?U`)
                    var core: str = s.substring(1, s.len)
                    if core.startsWith("&") or .isUnionName(core)
                        return s
                    return "?&" + core
                if s.startsWith("&") or .isUnionName(s)
                    return s
                return "&" + s
            on TypeRef.tuple as tt
                # a tuple is the runtime's ZTuple2 / ZTuple3: fields f0, f1, f2
                if tt.elems.count() < 2 or tt.elems.count() > 3
                    .refused.add("a tuple of " + tt.elems.count().toString() + " (the runtime spells 2 and 3)")
                    return "voidptr"
                var parts: str = ""
                for et in tt.elems
                    if parts != ""
                        parts = parts + ", "
                    parts = parts + .vType(et)
                return "ZTuple" + tt.elems.count().toString() + "[" + parts + "]"
            else
                .refused.add("a type the subset does not spell (stream, error union, fn)")
                return "voidptr"

    def vNamed(qualified: str): str
        # `Token.Token` (a type of a used module) is `Token` in the one V file
        var segs: List(str) = qualified.split(".")
        var name: str = segs.at(segs.count() - 1)
        if name == "int": return "i64"
        # BUG-761: the sized integers and `byte` by V's names (they were passed through as
        # written: `int8` and V's removed `byte` are unknown types there). V has no 128-bit
        # integer, so those are refused by name rather than narrowed.
        var sized: str = vSizedIntName(name)
        if sized == "?"
            .refused.add("the type " + name + " (V has no 128-bit integer)")
            return "i64"
        if sized != "": return sized
        if name == "float" or name == "float64" or name == "f64": return "f64"
        # BUG-768: float32 is V's f32 (it was passed through as written, an unknown type
        # there). V has no 16-bit float: refused by name rather than widened.
        if name == "float32" or name == "f32": return "f32"
        if name == "f16"
            .refused.add("the type " + name + " (V has no 16-bit float)")
            return "f32"
        if name == "str": return "string"
        if name == "bool": return "bool"
        if name == "char": return "rune"   # a codepoint (BUG-712: it was u8, and chars() yielded bytes)
        if name == "void": return ""
        if name == "StringBuilder": return "&ZStringBuilder"
        if name == "Json" or name == "JsonValue": return "&ZJson"   # a shared handle to a node of the runtime's own tree (BUG-751; x.json2's Any by value until 2026-11-16)
        if .aliases.get(name) as at
            return .vType(at)   # `type Alias = Base`: the base, wherever named
        if .sig_canon.get(name) as owner
            return owner   # a sig of a shape an earlier sig owns: that name (vlang/v#30282)
        if name == "SqliteDb": return "&ZSqliteDb"
        if name == "Gui" or name == "CodeEditor"
            .uses_gui = true
        if name == "SysProcess": return "&ZSysProcess"
        if name == "Timer": return "ZTimer"
        if name == "SqliteRow": return "&ZSqliteRow"
        if name == "Random": return "&ZRandom"
        if name == "DateTime": return "ZDateTime"
        for cn in .class_names
            if cn == name
                return "&" + name
        return name

    def isStructName(name: str): bool
        for sn in .struct_names
            if sn == name
                return true
        return false

    def isEnumName(name: str): bool
        for en in .enum_names
            if en == name
                return true
        return false

    # whether a V type reaches the union `un` by value: the union itself, an
    # option of it, or a value struct whose fields do -- a reference (`&`), a
    # container (`&ZList` ...) or a class breaks the cycle, as V's check does
    def reachesUnion(un: str, vt: str, depth: int): bool
        if depth > 12
            return false
        var t: str = vt
        if t.startsWith("?")
            t = t.substring(1, t.len)
        if t == un
            return true
        if t.startsWith("&") or not .isStructName(t)
            return false
        for k in .all_field_types.keys()
            if k.startsWith(t + ".")
                if .reachesUnion(un, .all_field_types.get(k) orelse "", depth + 1)
                    return true
        return false

    # a variant's payload is boxed when it reaches its own union by value;
    # decided once per variant, at the first emission that asks
    def isBoxed(vk: str): bool
        if .boxed_variants.get(vk) as b
            return b
        var boxed: bool = false
        if .variant_union.get(vk) as un
            if .union_payloads.get(vk) as pt
                boxed = .reachesUnion(un, pt, 0)
        .boxed_variants.set(vk, boxed)
        return boxed

    # `.v` after a boxed variant's payload: the value out of its ZBox
    def unbox(vk: str): str
        if .isBoxed(vk)
            return ".v"
        return ""

    def isUnionName(name: str): bool
        for un in .union_names
            if un == name
                return true
        return false

    def isClassName(name: str): bool
        for cn in .class_names
            if cn == name
                return true
        return false

    def isSigName(name: str): bool
        for n in .sig_names
            if n == name
                return true
        return false

    # a lambda's declared return type, in V
    def lambdaRet(e: Expr): str
        branch e
            on Expr.lambda as lam
                return .vType(lam.return_type)
            else
                return ""

    # a nilable read where Zebra has narrowed it: V's own unwrap, with no
    # generic in the path (master's new compiler miscompiles a reference that
    # comes out of a generic function into an interface: repro_v8), panicking
    # in the Zig backend's words when the narrowing was wrong
    # `vt`: the V type of the nilable ("?T", or "" when unknown): spelled on the
    # runtime generics when known, since V master infers a generic's T from an
    # assignment target of type ?T (vlang/v#30966); the explicit argument is the fix
    # `at`: the source place ("file.zbr:line") the panic names when the value is none
    def narrowedRead(rendered: str, what: str, vt: str, at: str): str
        if .iface_target
            # into an interface: V's own unwrap, no generic in the path -- master
            # infers a generic's T from the assignment target and boxes without a
            # method table (repro_v8)
            .narrowed_or_used = true
            return "(" + rendered + " or { zbr_panic(" + .vStringLit("narrowed read of " + what + " is none at " + .current_file) + ") })"
        # elsewhere the function form: 0.5.2 miscompiles an `or` expression used
        # directly as a call argument of a generic-struct pointer type
        if vt.startsWith("?") and vt.len > 1
            var payload: str = vt.substring(1, vt.len)
            return "zunwrap_at[" + payload + "](zopt_id[" + payload + "](" + rendered + "), " + .vStringLit(at) + ")"
        return "zunwrap_at(zopt_id(" + rendered + "), " + .vStringLit(at) + ")"

    # `j.put(k, v)` / `j.append(v)` and their typed forms as the runtime's call on
    # the handle; put / append take a JsonValue or a string, the last argument's
    # type deciding which
    def jsonPutCall(member: str, recv: str, args: List(Arg)): str
        var helper: str = "zjson_" + snakeCase(member)
        if (member == "put" or member == "append") and args.count() > 0
            var lastArg = args.at(args.count() - 1).value
            var lt: str = .vTypeOf(lastArg)
            if lt == "string" or isStringLit(lastArg)
                helper = helper + "_str"
        return helper + "(" + recv + ", " + .argsStr(args) + ")"

    def jsonTry(kind: str, obj: str, args: List(Arg), ja: str): str
        if args.count() == 1
            return "zjson_tryk_" + kind + "(" + obj + ", " + ja + ")"
        return "zjson_try_" + kind + "(" + obj + ")"

    # a nilable local Zebra reads narrowed: spelled zunwrap(?T(x)), no lvalue
    def isNarrowedIdent(e: Expr): bool
        branch e
            on Expr.ident as id
                return .isNarrowed(id.name)
            else
                return false

    def isIfaceName(name: str): bool
        for n in .iface_names
            if n == name
                return true
        return false

    def isModuleName(name: str): bool
        for mn in .module_names
            if mn == name
                return true
        return false

    # the name a static access stands on: `Name.x` -> Name, `Mod.Name.x` ->
    # Name when Mod is a used module; "" when the object is an expression
    def staticOwner(obj: Expr): str
        branch obj
            on Expr.ident as id
                if .isLocalName(id.name)
                    return ""   # a local or a parameter named like a namespace (`sys` in a test) is the local
                return id.name
            on Expr.member as m
                branch m.object
                    on Expr.ident as id
                        if .isModuleRef(id.name)
                            return m.member
                    else
                        pass
                return ""
            else
                return ""

    # a module's name stands for the module only when nothing in scope has
    # it: the engine's modules are common nouns (tween, character, health,
    # door), and a local of that name is the value
    def isModuleRef(name: str): bool
        if .isLocalName(name) or .isCurrentField(name) or .isGlobalName(name)
            return false
        return .isModuleName(name)

    def isModuleIdent(obj: Expr): bool
        branch obj
            on Expr.ident as id
                return .isModuleRef(id.name)
            else
                return false

    # ── the module ─────────────────────────────────────────────────────────
    # every module in one V file: the used modules first (their declarations
    # the root's depend on), the root last; the passes see all of them
    def genModules(ms: List(Module)): str
        for m in ms
            for d in m.decls
                branch d
                    on Decl.use_ as u
                        var segs: List(str) = u.path.split("/")
                        .module_names.add(segs.at(segs.count() - 1))
                    else
                        pass
        for m in ms
            .noteTypeNames(m)
        for m in ms
            .noteRefTargets(m)
        for m in ms
            .noteSigShapes(m)   # (after the reference targets: a shape carries each param's mut)
        for m in ms
            .noteFieldTypes(m)
        for m in ms
            .noteDefs(m)   # (before the return types: those are keyed by the emitted name this pass decides)
        for m in ms
            .noteRets(m)
        for m in ms
            .noteMutStructs(m)
        for m in ms
            .noteSigs(m)
        for m in ms
            .noteEmittedGlobals(m)   # (after the definitions: which names two modules share)
        var last: int = ms.count() - 1
        var mi: int = 0
        for m in ms
            .enterModule(m)
            .line("// -- " + m.file + " --")
            for d in m.decls
                var skip: bool = false
                if mi != last
                    branch d
                        on Decl.method as mth
                            if mth.name == "main"
                                skip = true   # a used module's main: the root's runs
                                .line("// (" + m.file + "'s main is not emitted: the root's runs)")
                        else
                            pass
                if not skip
                    .genDecl(d)
            mi = mi + 1
        if .global_inits.count() > 0
            .line("// the module-level vars, set before main runs (the Zig backend's _initModuleVars)")
            .line("fn zglobals_init() {")
            for gi in .global_inits
                .line("\t" + gi)
            .line("}")
            .line("")
        # a root without main whose defs are tests (`zebra test` on the Zig
        # backend): a main that runs them in order and reports as the Zig runner
        # does, on stderr. A failing assert is a panic on V, so it ends the run
        # where the Zig runner counts it and goes on -- said at the start.
        # Without this V built an exe that ran nothing and exited 0 (icons_test,
        # 2026-10-15): a green from a runner that never ran.
        var root_main: bool = false
        var root_tests: List(str) = List(str)()
        var class_main: str = ""
        var class_main_throws: bool = false
        for d in ms.at(last).decls
            branch d
                on Decl.method as rm
                    if rm.name == "main"
                        root_main = true
                    if rm.name.startsWith("test_")
                        root_tests.add(rm.name)
                on Decl.class_ as rc
                    for mem in rc.members
                        branch mem
                            on Decl.method as cm
                                if cm.mods.is_static and cm.name == "main" and cm.params.count() == 0 and class_main == ""
                                    class_main = snakeCase(rc.name) + "_main"
                                    class_main_throws = cm.throws_
                            else
                                pass
                else
                    pass
        # a root whose entry is a class `static def main` (the Zig backend's
        # BUG-539 entry): V's own main calls it. Without this V built an exe that
        # ran nothing and exited 0 -- 13 corpus programs printed nothing under
        # the V census of 2026-10-30, the icons_test shape again.
        if not root_main and class_main != ""
            .line("// the root's entry is a class static main")
            .line("fn main() {")
            if .has_globals
                .line("\tzglobals_init()")
            if class_main_throws
                .line("\t" + class_main + "() or { zbr_panic(err.msg()) }")
            else
                .line("\t" + class_main + "()")
            .line("}")
            .line("")
        if not root_main and class_main == "" and root_tests.count() > 0
            .line("// no main: the test_ defs run in order (zebra test on the V target)")
            .line("fn main() {")
            if .has_globals
                .line("\tzglobals_init()")
            .line("\teprintln('zebra test (V target): " + root_tests.count().toString() + " test(s); a failing assert ends the run')")
            for tn in root_tests
                .line("\t" + .freeFnName(tn) + "()")
                .line("\teprintln('PASS: " + tn + "')")
            .line("\teprintln('')")
            .line("\teprintln('" + root_tests.count().toString() + " passed, 0 failed')")
            .line("}")
            .line("")
        return .sb.build()

    def noteTypeNames(m: Module)
        # the classes first, so a field or a return of a class type is `&Name`
        for d in m.decls
            branch d
                on Decl.class_ as c
                    .class_names.add(c.name)
                on Decl.struct_ as st
                    .struct_names.add(st.name)
                on Decl.enum_ as en
                    .enum_names.add(en.name)
                    .member_counts.set(en.name, en.members.count())
                on Decl.union_ as un
                    .union_names.add(un.name)
                    .member_counts.set(un.name, un.variants.count())
                on Decl.interface_ as di
                    .iface_names.add(di.name)
                on Decl.sig_ as sgn
                    .sig_names.add(sgn.name)
                on Decl.type_alias_ as ta
                    if ta.params.count() == 0 and ta.constraint == nil
                        .aliases.set(ta.name, ta.base)
                else
                    pass

    # two sigs of one V shape are one V name: V instantiates a generic's
    # methods once per resolved type and calls them under each alias, so the
    # second alias's instantiation is declared and never generated
    # (vlang/v#30282). The first sig declared with a shape owns it; a later
    # one is spelled by the owner wherever it is named (vNamed) and declared
    # as a comment.
    def noteSigShapes(m: Module)
        for d in m.decls
            branch d
                on Decl.sig_ as sg
                    var shape: str = .sigShape(sg.params, sg.return_type)
                    if .sig_shapes.get(shape) as owner
                        .sig_canon.set(sg.name, owner)
                    else
                        .sig_shapes.set(shape, sg.name)
                else
                    pass

    # the emitted name of every module-level const / var: a var two modules
    # declare is `<module>_<name>` in each (globalName), else its own name
    def noteEmittedGlobals(m: Module)
        for d in m.decls
            branch d
                on Decl.var_ as gv
                    # two names of one module that snake-case alike (`Workspace`
                    # and `workspace` in robloxglobals_test): the later keeps a
                    # numbered spelling, read back through gspell
                    var sp: str = vSafe(gv.name)
                    if .global_dedup.get(gv.name) == nil
                        var taken: bool = false
                        for g0 in .emitted_globals
                            if g0 == sp
                                taken = true
                        if taken
                            var n2: int = 2
                            while .isEmittedGlobal(sp + "_" + n2.toString())
                                n2 = n2 + 1
                            .global_dedup.set(gv.name, sp + "_" + n2.toString())
                    if .global_modules.get(gv.name) as mods
                        if mods.count() > 1
                            for s in mods
                                .emitted_globals.add(snakeCase(s) + "_" + .gspell(gv.name))
                        else
                            .emitted_globals.add(.gspell(gv.name))
                    else
                        .emitted_globals.add(.gspell(gv.name))
                else
                    pass

    # a module-level var's own spelling: its V name, or the numbered one a
    # same-spelled sibling forced (noteEmittedGlobals)
    def gspell(name: str): str
        if .global_dedup.get(name) as d
            return d
        return vSafe(name)

    def isEmittedGlobal(name: str): bool
        for g in .emitted_globals
            if g == name
                return true
        return false

    def sigShape(params: List(Param), ret: TypeRef?): str
        var out: str = ""
        for p in params
            var pt: str = .vType(p.type_)
            if .isRefType(p.type_)
                pt = "mut " + pt
            out = out + pt + ","
        return out + "->" + .vType(ret)

    # a struct named under `^` anywhere (a union's payload, a field, a param,
    # a return) is a reference type in V: `&Name` wherever it is named, its
    # constructor allocating -- V cannot take the address of a call's result,
    # and a boxed node is a reference on the Zig backend too. The cost: a
    # by-value copy of such a struct elsewhere is a shared reference in V.
    def noteRefTargets(m: Module)
        for d in m.decls
            branch d
                on Decl.union_ as un
                    for v in un.variants
                        .refWalk(v.payload)
                on Decl.class_ as c
                    .refWalkMembers(c.members)
                on Decl.struct_ as st
                    .refWalkMembers(st.members)
                on Decl.method as mth
                    .refWalkMethod(mth)
                on Decl.var_ as gv
                    .refWalk(gv.type_)
                else
                    pass

    def refWalkMembers(members: List(Decl))
        for mem in members
            branch mem
                on Decl.var_ as f
                    .refWalk(f.type_)
                on Decl.method as mth
                    .refWalkMethod(mth)
                on Decl.init as ini
                    for p in ini.params
                        .refWalk(p.type_)
                else
                    pass

    def refWalkMethod(mth: DeclMethod)
        for p in mth.params
            .refWalk(p.type_)
        .refWalk(mth.return_type)

    def refWalk(t: TypeRef?)
        if t == nil
            return
        branch t!
            on TypeRef.ref_to as inner
                branch inner
                    on TypeRef.named as n
                        .markHeap(n.name)
                    else
                        pass
                .refWalk(inner)
            on TypeRef.nilable as inner
                .refWalk(inner)
            on TypeRef.generic as g
                for a in g.args
                    .refWalk(a)
            else
                pass

    def markHeap(qualified: str)
        var segs: List(str) = qualified.split(".")
        var name: str = segs.at(segs.count() - 1)
        if .isStructName(name) and not .isHeapName(name)
            .heap_names.add(name)
            var i: int = 0
            while i < .struct_names.count()
                if .struct_names.at(i) == name
                    .struct_names.remove(i)   # (Zebra's List.remove takes an index)
                    i = .struct_names.count()
                i = i + 1
            .class_names.add(name)

    def isHeapName(name: str): bool
        for h in .heap_names
            if h == name
                return true
        return false

    # every variant's payload type and every type's field types, for the
    # receiver-type reads (an `as` capture, a branch binding, a field chain)
    # the structs whose methods assign their fields: every method `mut self`,
    # and a call into one needs a mutable receiver
    def noteMutStructs(m: Module)
        for d in m.decls
            branch d
                on Decl.struct_ as st
                    .current_fields = fieldNames(st.members)
                    for mem in st.members
                        branch mem
                            on Decl.method as mth
                                if mth.stmts as b
                                    if .bodyAssignsField(b) and not .isMutStruct(st.name)
                                        .mut_structs.add(st.name)
                            else
                                pass
                    .current_fields = List(str)()
                else
                    pass

    # every module's free functions, by name: a name two modules declare is
    # prefixed with its module's stem wherever it is declared or called
    def noteDefs(m: Module)
        var stem: str = moduleStem(m.file)
        for d in m.decls
            branch d
                on Decl.method as mth
                    .fn_names.add(vSafe(mth.name))
                    if .def_modules.get(mth.name) as have
                        have.add(stem)
                    else
                        var fresh = List(str)()
                        fresh.add(stem)
                        .def_modules.set(mth.name, fresh)
                on Decl.var_ as gv
                    if .global_modules.get(gv.name) as have2
                        have2.add(stem)
                    else
                        var fresh2 = List(str)()
                        fresh2.add(stem)
                        .global_modules.set(gv.name, fresh2)
                else
                    pass

    # the V name of a free function: bare, unless two modules declare the
    # name -- then the current module's own (`<stem>_<name>`) when it declares
    # it, else the first used module's that does
    def freeFnName(name: str): str
        if name == "main"
            return "main"   # the root's main is V's; the used modules' are not emitted
        # a def whose snake name is a class's constructor name (`newSettingClass`
        # beside `class SettingClass`: both `new_setting_class`) keeps its own
        var sn0: str = vSafe(name)
        if sn0.startsWith("new_")
            for cn in .class_names
                if ctorName(cn) == sn0
                    return sn0 + "_fn"
            for stn in .struct_names
                if ctorName(stn) == sn0
                    return sn0 + "_fn"
        if .def_modules.get(name) as mods
            if mods.count() > 1
                for s in mods
                    if s == .current_stem
                        return snakeCase(.current_stem) + "_" + vSafe(name)
                if .current_exposed.get(name) as est
                    for s3 in mods
                        if s3 == est
                            return snakeCase(est) + "_" + vSafe(name)   # the use line that exposes the name
                for u in .current_uses
                    for s2 in mods
                        if s2 == u
                            return snakeCase(u) + "_" + vSafe(name)
                return snakeCase(mods.at(0)) + "_" + vSafe(name)
        return vSafe(name)

    # the V name of a module-level var: bare, unless two modules declare the
    # name -- then the current module's own (`<stem>_<name>`) when it declares
    # it, else the first used module's that does (as freeFnName)
    def globalName(name: str): str
        if .global_modules.get(name) as mods
            if mods.count() > 1
                for s in mods
                    if s == .current_stem
                        return snakeCase(.current_stem) + "_" + .gspell(name)
                if .current_exposed.get(name) as est
                    for s3 in mods
                        if s3 == est
                            return snakeCase(est) + "_" + .gspell(name)   # the use line that exposes the name
                for u in .current_uses
                    for s2 in mods
                        if s2 == u
                            return snakeCase(u) + "_" + .gspell(name)
                return snakeCase(mods.at(0)) + "_" + .gspell(name)
        return .gspell(name)

    def isGlobalName(name: str): bool
        return .global_modules.get(name) != nil

    # a nested emitter (a lambda's body) with this one's whole context: every
    # table shared by reference, the scalars copied; its own text and depth
    def cloneContext(): VGen
        var g = VGen()
        g.class_names = .class_names
        g.struct_names = .struct_names
        g.enum_names = .enum_names
        g.union_names = .union_names
        g.sigs = .sigs
        g.member_counts = .member_counts
        g.current_params = .current_params
        g.current_ret = .current_ret
        g.in_method = .in_method
        g.catch_bindings = .catch_bindings
        g.current_fields = .current_fields
        g.module_names = .module_names
        g.current_methods = .current_methods
        g.current_statics = .current_statics
        g.local_types = .local_types
        g.field_types = .field_types
        g.heap_names = .heap_names
        g.global_types = .global_types
        g.union_payloads = .union_payloads
        g.boxed_variants = .boxed_variants
        g.variant_union = .variant_union
        g.current_file = .current_file
        g.sig_conflicts = .sig_conflicts
        g.rets = .rets
        g.struct_mut = .struct_mut
        g.mut_structs = .mut_structs
        g.def_modules = .def_modules
        g.current_stem = .current_stem
        g.current_uses = .current_uses
        g.current_exposed = .current_exposed
        g.all_field_types = .all_field_types
        g.local_names = .local_names
        g.matchN = .matchN + 1000
        g.current_class = .current_class
        g.tmpN = .tmpN + 1000
        g.ref_params = .ref_params
        g.fn_names = .fn_names
        g.renames = .renames
        g.global_inits = .global_inits
        g.region_depth = .region_depth
        g.fn_region_base = .fn_region_base
        g.loop_region_base = .loop_region_base
        g.global_modules = .global_modules
        g.iface_names = .iface_names
        g.sig_names = .sig_names
        g.sig_canon = .sig_canon
        g.emitted_globals = .emitted_globals
        g.aliases = .aliases
        g.narrowed = .narrowed
        g.rt_fns = .rt_fns
        g.rt_types = .rt_types
        g.rt_methods = .rt_methods
        g.rt_receivers = .rt_receivers
        return g

    def isFnName(vname: str): bool
        for n in .fn_names
            if n == vname
                return true
        return false

    def isMutStruct(name: str): bool
        for n in .mut_structs
            if n == name
                return true
        return false

    # the return type of every def and method, for a call's type
    def noteRets(m: Module)
        .enterModule(m)
        for d in m.decls
            branch d
                on Decl.method as mth
                    .noteRet(.freeFnName(mth.name), mth)   # by the emitted name: a prefixed one has its own entry
                on Decl.class_ as c
                    .noteRetsOf(c.name, c.members)
                on Decl.interface_ as di
                    .noteRetsOf(di.name, di.members)
                on Decl.struct_ as st
                    .noteRetsOf(st.name, st.members)
                else
                    pass

    def noteRetsOf(owner: str, members: List(Decl))
        for mem in members
            branch mem
                on Decl.method as mth
                    .noteRet(owner + "." + mth.name, mth)   # by owner always: read when the receiver's type is known
                    if not mth.mods.is_static
                        .noteRet(mth.name, mth)
                else
                    pass

    def noteRet(key: str, mth: DeclMethod)
        var rt: str = .retType(mth)   # with its `!` when it throws: a `?`-call strips it
        if .rets.get(key) as have
            if have != rt
                .rets.set(key, "")   # two declarations of the name differ: unknown
            return
        .rets.set(key, rt)

    # the V type of a call's result ("" when unknown)
    def retOf(c: ExprCall): str
        branch c.callee
            on Expr.ident as id
                if .isClassName(id.name) or .isStructName(id.name)
                    return .vNamed(id.name)   # a constructor call: the type (a list literal of them is typed by it)
                # a bare call to a method of the enclosing type, a static of it,
                # or a free function
                if .current_class != "" and .isMethodName(id.name)
                    if .rets.get(.current_class + "." + id.name) as mr
                        return mr
                if .current_class != "" and .isStaticName(id.name)
                    if .rets.get(.current_class + "." + id.name) as sr
                        return sr
                if .rets.get(.freeFnName(id.name)) as r
                    return r
                return ""
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isClassName(owner) or .isStructName(owner)
                    if .rets.get(owner + "." + m.member) as r
                        return r
                    return ""
                if .rets.get(m.member) as r
                    return r
                return ""
            else
                return ""

    def noteFieldTypes(m: Module)
        for d in m.decls
            branch d
                on Decl.union_ as un
                    for v in un.variants
                        if v.payload as pt
                            .union_payloads.set(un.name + "_" + v.name, .vType(pt))
                            .variant_union.set(un.name + "_" + v.name, un.name)
                on Decl.class_ as c
                    .noteFieldsOf(c.name, c.members)
                on Decl.struct_ as st
                    .noteFieldsOf(st.name, st.members)
                else
                    pass

    def noteFieldsOf(owner: str, members: List(Decl))
        for mem in members
            branch mem
                on Decl.var_ as f
                    .all_field_types.set(owner + "." + f.name, .vType(f.type_))
                else
                    pass

    # `base except f = v`: a copy with fields replaced -- V's struct update
    # (`Name{ ...base, f: v }`; a class is spread through its pointee and the
    # copy allocated)
    def exceptStr(ex: ExprExcept): str
        var bt: str = .vTypeOf(ex.base)
        var base: str = .exprStr(ex.base)
        if bt == ""
            .refuse("an `except` on an expression whose type the emitter does not know", ex.span)
            return base
        var is_ref: bool = bt.startsWith("&")
        var name: str = bt
        var spread: str = "..." + base
        var fvals = List(str)()
        for f in ex.fields
            var fv: str = .exprStr(f.value)
            if .isRefParamName(f.value)
                fv = "unsafe { " + fv + " }"
            fvals.add(fv)
        var out: str = ""
        if is_ref
            name = bt.substring(1, bt.len)
            spread = "...(*" + base + ")"
            out = "&"
        out = out + name + "{ " + spread
        var fi: int = 0
        for f in ex.fields
            out = out + ", " + vSafe(f.name) + ": " + fvals.at(fi)
            fi = fi + 1
        return out + " }"

    # `U_v` when the expression is a payload-less variant (`U.v` or `U.v()`), else ""
    def variantTypeName(e: Expr): str
        branch e
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner + "_" + m.member
                return ""
            on Expr.call as c
                if c.args.count() != 0
                    return ""
                branch c.callee
                    on Expr.member as m
                        var owner: str = .staticOwner(m.object)
                        if .isUnionName(owner)
                            return owner + "_" + m.member
                        return ""
                    else
                        return ""
            else
                return ""

    def noteSigs(m: Module)
        # the second pass: every callee's signature -- the parameter names and
        # defaults (named arguments are reordered to positions at the call,
        # missing ones filled from the defaults) and which are references (V
        # wants `mut` on a param mutated through a method, at the declaration
        # and at the call)
        .enterModule(m)
        for d in m.decls
            branch d
                on Decl.method as mth
                    .noteSig(.freeFnName(mth.name), mth.params)   # keyed as emitted: a module-prefixed name has its own entry
                on Decl.class_ as c
                    .noteMembers(ctorName(c.name), c.members, c.name)
                on Decl.interface_ as di
                    .noteMembers("", di.members, di.name)
                on Decl.sig_ as sg
                    .noteSig("sig:" + sg.name, sg.params)   # a call through a value of this type
                on Decl.struct_ as st
                    .noteMembers(ctorName(st.name), st.members, st.name)
                    .noteImplicitCtor(ctorName(st.name), st.members)
                else
                    pass

    # the module being walked or emitted: its stem and the stems it uses
    def enterModule(m: Module)
        .current_file = m.file
        .current_stem = moduleStem(m.file)
        .current_uses = List(str)()
        .current_exposed = HashMap(str, str)()
        for d in m.decls
            branch d
                on Decl.use_ as u
                    var segs: List(str) = u.path.split("/")
                    .current_uses.add(segs.at(segs.count() - 1))
                    for ex in u.exposed
                        .current_exposed.set(ex, segs.at(segs.count() - 1))
                else
                    pass

    def genDecl(d: Decl)
        branch d
            on Decl.class_ as c
                .genClass(c)
            on Decl.method as mth
                .genFunction(mth)
            on Decl.var_ as v
                .genGlobal(v)
            on Decl.use_
                pass   # the route folded the used module into this file
            on Decl.struct_ as st
                .genStruct(st)
            on Decl.enum_ as en
                .genEnum(en)
            on Decl.interface_ as i
                .genInterface(i)
            on Decl.union_ as un
                .genUnion(un)
            on Decl.sig_ as sg
                # a function type: `sig F(c: char): bool` -> `type F = fn (c u8) bool`
                var ret = .vType(sg.return_type)
                var head = "type " + sg.name + " = fn (" + .genParams(sg.params) + ")"
                if ret != ""
                    head = head + " " + ret
                if .sig_canon.get(sg.name) as owner
                    # the same shape as an earlier sig: spelled by that name wherever it is named
                    .line("// " + head + "   -- spelled " + owner + " (one V instantiation per fn shape: vlang/v#30282)")
                else
                    .line(head)
                .line("")
            on Decl.namespace_ as ns
                .refuse("namespace " + ns.name + " (flattening is the next step)", ns.span)
            on Decl.type_alias_ as ta
                if ta.params.count() > 0 or ta.constraint != nil
                    .refuse("type alias " + ta.name + " with parameters or a constraint", ta.span)
                # else: resolved to its base wherever named; nothing emitted
            on Decl.mixin_ as mx
                .refuse("mixin " + mx.name, mx.span)
            on Decl.extend_ as ex
                .refuse("an extend declaration", ex.span)
            else
                .refused.add("a declaration kind the subset does not spell")

    def genGlobal(v: DeclVar)
        if v.init_expr != nil
            var rhs: str = .exprStr(v.init_expr!)
            var gname: str = .globalName(v.name)
            if v.type_ as t
                var gt: str = .vType(t)
                .global_types.set(gname, gt)   # keyed by the emitted name: two modules' same-named vars differ
                if gt == "i64" and isIntLit(v.init_expr!)
                    rhs = "i64(" + rhs + ")"
            if v.is_const
                .line("const " + gname + " = " + rhs)
            else
                # a mutable module-level var: V's __global, which the run must
                # enable (-enable-globals on the run line the route prints);
                # declared by type and set in zglobals_init() at main's start --
                # MSVC refuses V's static initializer for a string global
                var gt2: str = ""
                if v.type_ as t2
                    gt2 = .vType(t2)
                if gt2 == ""
                    gt2 = .ctorTypeOf(v.init_expr!)
                if gt2 == ""
                    gt2 = .vTypeOf(v.init_expr!)
                if gt2 == "" and isIntLit(v.init_expr!)
                    gt2 = "i64"
                if gt2 == "" and isStringLit(v.init_expr!)
                    gt2 = "string"
                if gt2 == ""
                    .refuse("module-level var " + v.name + " whose type the emitter cannot name (declare it)", v.span)
                    gt2 = "voidptr"
                .global_types.set(gname, gt2)
                .line("__global (")
                if gt2.startsWith("?")
                    # an option-typed global carries its initializer: declared by
                    # type alone, master's compiler emits the type-erased option
                    # (vlang/v, repro_v9)
                    .line("\t" + gname + " = " + gt2 + "(none)")
                else
                    .line("\t" + gname + " " + gt2)
                .line(")")
                .global_inits.add(gname + " = " + rhs)
                .has_globals = true
        else
            .refuse("module-level var " + v.name + " without an initializer", v.span)

    def noteMembers(ctor: str, members: List(Decl), owner: str)
        var shown = List(str)()
        for mem in members
            branch mem
                on Decl.var_ as fv
                    shown.add(fv.name)   # in declared order: what the type's printed text lists (BUG-746)
                on Decl.init as ini
                    .noteSig(ctor, ini.params)
                on Decl.method as cm
                    if cm.name == "toString" and cm.params.count() == 0 and not cm.mods.is_static
                        .own_tostring.set(owner, true)
                    if cm.mods.is_static
                        .noteSig(snakeCase(owner) + "_" + vSafe(cm.name), cm.params)   # as the static is emitted and called
                    else
                        .noteSig("." + vSafe(cm.name), cm.params)   # methods under `.name`: apart from the free functions
                        .noteSig(owner + "." + vSafe(cm.name), cm.params)   # by owner too: no collision when the receiver's type is known
                else
                    pass
        .show_fields.set(owner, shown)

    # a struct with no `cue init` is constructed from its fields, every one
    # named or in order, a missing one its declared default, else zero
    # (Zebra's implicit constructor). Until BUG-745 a missing one was ALWAYS
    # zero here: `Rgb()` for `var r: int = 3` built r = 0, where the Zig route
    # builds 3.
    def noteImplicitCtor(ctor: str, members: List(Decl))
        if .sigs.get(ctor) != nil
            return
        var fsig = FnSig()
        for mem in members
            branch mem
                on Decl.var_ as f
                    fsig.names.add(f.name)
                    fsig.has_default.add(true)
                    if f.init_expr as fie
                        fsig.defaults.add(fie)
                    else
                        fsig.defaults.add(.zeroExpr(f))
                    fsig.refs.add(.isRefType(f.type_))
                    fsig.types.add(.vType(f.type_))
                else
                    pass
        .sigs.set(ctor, fsig)

    # a field's zero as an expression the call can spell (the literal kinds;
    # a container or a class field falls back to nil, which the V side
    # spells as its constructor through zeroOf at the struct literal)
    def zeroExpr(f: DeclVar): Expr
        var t = .vType(f.type_)
        if t == "i64": return Expr.int_lit(ExprIntLit(f.span, "0", IntBase.decimal))
        if t == "f64" or t == "f32": return Expr.float_lit(ExprFloatLit(f.span, "0.0"))
        if t == "string": return Expr.string_lit(ExprStringLit(f.span, StringKind.plain, ""))
        if t == "bool": return Expr.bool_lit(ExprBoolLit(f.span, false))
        return Expr.nil_(f.span)

    def noteSig(name: str, params: List(Param))
        if .sigs.get(name) as have
            # another declaration of this name: the same parameter names keep the
            # table's entry; different ones make the name positional-only
            var same: bool = have.names.count() == params.count()
            if same
                var k: int = 0
                for p in params
                    if have.names.at(k) != p.name
                        same = false
                    k = k + 1
            if not same
                .sig_conflicts.add(name)
            return
        var fsig = FnSig()
        for p in params
            fsig.names.add(p.name)
            if p.default_ as d
                fsig.has_default.add(true)
                fsig.defaults.add(d)
            else
                fsig.has_default.add(false)
                fsig.defaults.add(Expr.nil_(p.span))
            fsig.refs.add(.isRefType(p.type_))
            fsig.types.add(.vType(p.type_))
        .sigs.set(name, fsig)
        var flags = List(bool)()
        for p in params
            flags.add(.isRefType(p.type_))
        .ref_params.set(name, flags)

    # a container or a class: by reference in V, so `mut` when passed to be mutated
    # a parameter (or a capture) of this type is `mut`: a reference (a class,
    # a heap struct, a container). Not a value struct: V would then demand
    # `mut` at every call site, and a method name many classes share is
    # called by position. `f(mut p.field)` through an immutable parameter is
    # the call site's problem (argsBySig binds the field to a local first).
    def isRefType(t: TypeRef?): bool
        if t == nil
            return false
        var vt: str = .vType(t)
        if vt == "&ZJson"
            return false   # a JsonValue is a handle the runtime changes through as it is: `j &ZJson`, no `mut` at the call
        return vt.startsWith("&") or .isIfaceName(vt)   # (an interface value is a pointer; a method on it needs mut)

    def genParams(params: List(Param)): str
        var out: str = ""
        var first: bool = true
        for p in params
            if not first
                out = out + ", "
            first = false
            var mut_: str = ""
            var pt: str = .vType(p.type_)
            if .isRefType(p.type_)
                # `mut x T` for a reference, never `mut x &T`: V's `mut x &T` is a
                # pointer to the caller's slot, and x used as a value (stored,
                # passed on) is that slot's address, not the object
                mut_ = "mut "
                if pt.startsWith("&")
                    pt = pt.substring(1, pt.len)   # (an interface's value is passed plain)
            var pn: str = vSafe(p.name)
            if .isEmittedGlobal(pn)
                pn = pn + "_v"   # a param shadowing a module-level var / const: V master refuses it
                .renames.set(p.name, pn)
            out = out + mut_ + pn + " " + pt
        return out

    # a `throws` def returns V's result (`!T`, `!` for none); `raise` is
    # `return error(...)`, `?` is `!`
    # `!?T` in the type table is spelled `!ZOpt[T]` in a signature (V has no `!?T`)
    def retSpelling(ret: str): str
        if ret.startsWith("!?")
            return "!ZOpt[" + ret.substring(2, ret.len) + "]"
        return ret

    def retType(m: DeclMethod): str
        var ret = .vType(m.return_type)
        if m.throws_
            return "!" + ret
        return ret

    # a field's declared default, as V's own field default (`activated i64 = -1`):
    # a class without an init was `&Model{}` before, every default zeroed
    def fieldDefault(f: DeclVar): str
        if f.init_expr as ie
            return " = " + .exprStr(ie)
        # a container field without an initializer: the empty container, as
        # Zebra's zero value (V wants every reference field initialized; the
        # IDE's GateSpec.argv, 2026-10-15)
        var vt: str = .vType(f.type_)
        if vt.startsWith("&ZList["): return " = new_zlist" + vt.substring(6, vt.len) + "()"
        if vt.startsWith("&ZMap["): return " = new_zmap" + vt.substring(5, vt.len) + "()"
        if vt.startsWith("&ZSet["): return " = new_zset" + vt.substring(5, vt.len) + "()"
        if vt == "&ZStringBuilder": return " = new_zstring_builder()"
        return ""

    def genFunction(m: DeclMethod)
        var ret = .retType(m)
        var fname: str = .freeFnName(m.name)
        if m.name == "main" and m.params.count() > 0
            # a class main a host calls (the game's `main(script, run, uis, ...)`):
            # V refuses a program entry with parameters, so the host provides
            # `fn main` and calls this by name (the engine's host_v/)
            fname = "script_main"
            .line("// the root's main takes " + m.params.count().toString() + " parameter(s): emitted as script_main, for a host's own fn main to call")
        var head = "fn " + fname + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + .retSpelling(ret)
        .line(head + " {")
        .depth = .depth + 1
        if m.name == "main" and .has_globals
            .line("zglobals_init()")
        if m.name == "main"
            .line("zr_stats_hook()")   # -d zbr_region_stats: the collector and the blocks reported at exit; nothing otherwise
        .current_params = m.params
        .current_ret = ret
        .region_depth = 0
        .fn_region_base = 0
        .loop_region_base = 0
        .in_method = false
        .resetLocals(m.params)
        if m.stmts as body
            .genBody(body, vSafe(m.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── classes ────────────────────────────────────────────────────────────
    def genClass(c: DeclClass)
        if c.type_params.count() > 0
            .refuse("class " + c.name + " with type parameters", c.span)
        if c.mixins.count() > 0
            .refuse("class " + c.name + " mixes in (mixins are outside the subset)", c.span)
        # (implements: nothing to emit -- V's interfaces are structural)
        .line("@[heap]")   # a class is a reference: allocated, and storable in a field (V's escape rule)
        .line("struct " + c.name + " {")
        .line("mut:")
        .depth = .depth + 1
        for mem in c.members
            branch mem
                on Decl.var_ as f
                    .line(vSafe(f.name) + " " + .vType(f.type_) + .fieldDefault(f))
                else
                    pass
        .depth = .depth - 1
        .line("}")
        .line("")
        .current_class = c.name
        .current_fields = fieldNames(c.members)
        .field_types = .fieldTypes(c.members)
        .current_methods = methodNames(c.members, false)
        .current_statics = methodNames(c.members, true)
        var had_init: bool = false
        for mem in c.members
            branch mem
                on Decl.init as ini
                    had_init = true
                    .genInit(ini, c.name, c.members)
                on Decl.method as mth
                    if mth.mods.is_static
                        .genStaticMethod(mth, c.name)
                    else
                        .genMethod(mth, c.name)
                on Decl.var_
                    pass
                else
                    .refuse("a member kind the subset does not spell in class " + c.name, c.span)
        if not had_init
            .line("fn " + ctorName(c.name) + "() &" + c.name + " {")
            .depth = .depth + 1
            .line("return " + .structLit(c.name, c.members))
            .depth = .depth - 1
            .line("}")
            .line("")
        .current_class = ""
        .current_methods = List(str)()
        .current_statics = List(str)()
        .current_fields = List(str)()

    # `&Name{ ... }` with every reference field initialised (V refuses an
    # uninitialised reference field): a container by its constructor, a
    # class-typed field by `unsafe { nil }` (Zebra's zero for it)
    def structLit(owner: str, members: List(Decl), by_ref: bool = true): str
        var out: str = owner + "{"
        if by_ref
            out = "&" + out
        var any: bool = false
        for mem in members
            branch mem
                on Decl.var_ as f
                    var ft = .vType(f.type_)
                    # a reference field WITH a declared default is left to it (the field's
                    # own `= ...` in the struct, fieldDefault): naming it here overrode the
                    # default with empty / nil -- `var tags: List(str) = ["a"]` started
                    # empty, `var owner: Owner = Owner()` started nil (BUG-745's family)
                    if ft.startsWith("&") and f.init_expr == nil
                        var field_init: str = "unsafe { nil }"   # (not `init`: it shadows a declaration in the emitted Zig)
                        if ft.startsWith("&ZList[") or ft.startsWith("&ZMap[") or ft.startsWith("&ZSet[") or ft == "&ZStringBuilder"
                            field_init = .zeroOf(ft)   # a container starts empty, never nil (Zebra's default)
                        if not any
                            out = out + "\n"
                        any = true
                        out = out + "\t" + vSafe(f.name) + ": " + field_init + "\n"
                else
                    pass
        return out + "}"

    # ── interfaces: V's, every method under mut: (a class's methods are mut self) ──
    def genInterface(i: DeclInterface)
        if i.type_params.count() > 0
            .refuse("interface " + i.name + " with type parameters", i.span)
        .line("interface " + i.name + " {")
        for base in i.ifaces
            .line("\t" + .vType(base))   # an embedded interface
        .line("mut:")
        for mem in i.members
            branch mem
                on Decl.method as mth
                    var ret: str = .retType(mth)
                    var head: str = "\t" + vSafe(mth.name) + "(" + .genParams(mth.params) + ")"
                    if ret != ""
                        head = head + " " + ret
                    .line(head)
                else
                    .refuse("a member kind the subset does not spell in interface " + i.name, i.span)
        .line("}")
        .line("")

    # ── value structs: V structs by value, a constructor by value, methods
    #    `mut` when the body assigns to a field ──────────────────────────────
    def genStruct(st: DeclStruct)
        var heap: bool = .isHeapName(st.name)
        var ret_name: str = st.name
        if heap
            .line("@[heap]")
            ret_name = "&" + st.name
        .line("struct " + st.name + " {")
        .line("pub mut:")
        .depth = .depth + 1
        for mem in st.members
            branch mem
                on Decl.var_ as f
                    .line(vSafe(f.name) + " " + .vType(f.type_) + .fieldDefault(f))
                else
                    pass
        .depth = .depth - 1
        .line("}")
        .line("")
        .current_class = st.name
        .current_fields = fieldNames(st.members)
        .field_types = .fieldTypes(st.members)
        .current_methods = methodNames(st.members, false)
        .current_statics = methodNames(st.members, true)
        # every method `mut self` when any assigns a field (the pass decided):
        # a method that calls a mutating one needs the receiver mutable too,
        # and V refuses a mutation through an immutable receiver
        .struct_mut = .isMutStruct(st.name)
        var had_init: bool = false
        for mem in st.members
            branch mem
                on Decl.init as ini
                    had_init = true
                    .line("fn " + ctorName(st.name) + "(" + .genParams(ini.params) + ") " + ret_name + " {")
                    .depth = .depth + 1
                    .resetLocals(ini.params)
                    .line("mut self := " + .structLit(st.name, st.members, heap))
                    if ini.stmts as body
                        .genStmts(body)
                    .line("return self")
                    .depth = .depth - 1
                    .line("}")
                    .line("")
                on Decl.method as mth
                    .genValueMethod(mth, st.name)
                on Decl.var_
                    pass
                else
                    .refuse("a member kind the subset does not spell in struct " + st.name, st.span)
        if not had_init
            # the implicit constructor: every field a parameter, in order
            var ps: str = ""
            var lit: str = st.name + "{"
            var any: bool = false
            for mem in st.members
                branch mem
                    on Decl.var_ as f
                        if ps != ""
                            ps = ps + ", "
                        var fpt: str = .vType(f.type_)
                        if .isRefType(f.type_)
                            ps = ps + "mut "   # (the recorded signature flags it: the call passes `mut`)
                            if fpt.startsWith("&")
                                fpt = fpt.substring(1, fpt.len)   # `mut x T`, never `mut x &T` (see genParams)
                        ps = ps + vSafe(f.name) + " " + fpt
                        if not any
                            lit = lit + "\n"
                        any = true
                        lit = lit + "\t" + vSafe(f.name) + ": " + vSafe(f.name) + "\n"
                    else
                        pass
            if heap
                lit = "&" + lit
            .line("fn " + ctorName(st.name) + "(" + ps + ") " + ret_name + " {")
            .depth = .depth + 1
            .line("return " + lit + "}")
            .depth = .depth - 1
            .line("}")
            .line("")
        .current_class = ""
        .current_methods = List(str)()
        .current_statics = List(str)()
        .current_fields = List(str)()

    # a struct's method: `mut self` only when the body assigns to a field
    # (V refuses a mutation through an immutable receiver, and warns on a
    # `mut` never used); `cue toString()` is V's str()
    def genValueMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var mname = vSafe(m.name)
        if m.name == "toString" and m.params.count() == 0
            mname = "str"
        var recv: str = "self " + owner
        if .struct_mut
            recv = "mut self " + owner
        var head = "fn (" + recv + ") " + mname + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + .retSpelling(ret)
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .region_depth = 0
        .fn_region_base = 0
        .loop_region_base = 0
        .in_method = true
        .resetLocals(m.params)
        if m.stmts as body
            .genBody(body, vSafe(m.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── enums ──────────────────────────────────────────────────────────────
    def genEnum(en: DeclEnum)
        if en.base != nil
            .refuse("enum " + en.name + " with a base type", en.span)
        .line("enum " + en.name + " {")
        .depth = .depth + 1
        for mem in en.members
            if mem.value != nil
                .refuse("enum member " + en.name + "." + mem.name + " with a value", mem.span)
            .line(vSafe(mem.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── unions: a V sum type over one struct per variant (`U_v { payload T }`,
    #    empty when the variant carries none) ─────────────────────────────────
    def genUnion(un: DeclUnion)
        var names: str = ""
        for v in un.variants
            var vname = un.name + "_" + v.name
            if names != ""
                names = names + " | "
            names = names + vname
            if v.payload as pt
                .line("struct " + vname + " {")
                .line("pub mut:")
                if .isBoxed(vname)
                    .line("\tpayload &ZBox[" + .vType(pt) + "]   // reaches " + un.name + " by value: boxed, a value cycle is refused by V master's tagged unions")
                else
                    .line("\tpayload " + .vType(pt))
                .line("}")
            else
                .line("struct " + vname + " {}")
            .line("")
        if un.variants.count() == 1
            # one variant: `type U = U_v` is an ALIAS to V, not a sum type, and a
            # match on it cannot name the variant (gui_modules_smoke, 2026-10-14);
            # a never-member makes it a sum type, and its match gains an else
            names = names + " | ZUnionPad"
        .line("type " + un.name + " = " + names)
        .line("")

    def genInit(ini: DeclInit, owner: str, members: List(Decl))
        .line("fn " + ctorName(owner) + "(" + .genParams(ini.params) + ") &" + owner + " {")
        .depth = .depth + 1
        .resetLocals(ini.params)
        .line("mut self := zr_o(" + .structLit(owner, members) + ")")   # the open allocate block's, if any
        if ini.stmts as body
            .in_ctor = true
            .genBody(body, ctorName(owner))
            .in_ctor = false
        .line("return self")
        .depth = .depth - 1
        .line("}")
        .line("")

    # a `static def` is a free function named <class>_<method>; a call on the
    # class's name reaches it
    def genStaticMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var head = "fn " + snakeCase(owner) + "_" + vSafe(m.name) + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + .retSpelling(ret)
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .region_depth = 0
        .fn_region_base = 0
        .loop_region_base = 0
        .in_method = false
        .resetLocals(m.params)
        var saved = .current_fields
        .current_fields = List(str)()   # no self in a static method
        if m.stmts as body
            .genBody(body, snakeCase(owner) + "_" + vSafe(m.name))
        .current_fields = saved
        .depth = .depth - 1
        .line("}")
        .line("")

    def resetLocals(params: List(Param))
        .local_names = List(str)()
        .local_types = HashMap(str, str)()
        .renames = HashMap(str, str)()   # a def's renames start empty; a param's (genParams) is re-made here
        for p in params
            .local_names.add(p.name)
            if .isEmittedGlobal(vSafe(p.name))
                .renames.set(p.name, vSafe(p.name) + "_v")
            var pt: str = .vType(p.type_)
            if pt != ""
                .local_types.set(p.name, pt)

    def fieldTypes(members: List(Decl)): HashMap(str, str)
        var out = HashMap(str, str)()
        for mem in members
            branch mem
                on Decl.var_ as f
                    out.set(f.name, .vType(f.type_))
                else
                    pass
        return out

    # the V type of a name or a field access, "" when the emitter does not
    # know it (a call's result, an element): a local or a param first, then
    # a field of the enclosing type (bare, or through self)
    def vTypeOf(e: Expr): str
        branch e
            on Expr.opt_chain as oc
                # the chain's type: the member's or the call's on the unwrapped base,
                # as an option (one level: an optional result stays as it is)
                var obt: str = .vTypeOf(oc.base)
                var oinner: str = obt
                if oinner.startsWith("?")
                    oinner = oinner.substring(1, oinner.len)
                .tmpN = .tmpN + 1
                var otmp: str = "zoct" + .tmpN.toString()
                if oinner != ""
                    .local_types.set(otmp, oinner)
                var otm = ExprMember(oc.span, Expr.ident(ExprIdent(oc.span, otmp)), oc.member)
                var ort: str = ""
                if oc.has_args
                    ort = .vTypeOf(Expr.call(ExprCall(oc.span, Expr.member(otm), oc.args)))
                else
                    ort = .vTypeOf(Expr.member(otm))
                if ort == "" or ort.startsWith("?")
                    return ort
                return "?" + ort
            on Expr.ident as id
                if .local_types.get(id.name) as lt
                    if lt.startsWith("?") and .isNarrowed(id.name)
                        return lt.substring(1, lt.len)   # Zebra reads it narrowed: the inner type
                    return lt
                if .isCurrentField(id.name)
                    if .field_types.get(id.name) as ft
                        return ft
                if .isGlobalName(id.name) and not .isLocalName(id.name)
                    if .global_types.get(.globalName(id.name)) as gt
                        return gt
                return ""
            on Expr.member as m
                if exprRootIsThis(m.object)
                    if .field_types.get(m.member) as ft
                        return ft
                branch m.object
                    on Expr.ident as eo
                        if .isEnumName(eo.name)
                            return eo.name   # `KeyCode.button_a`: the enum
                    else
                        pass
                var ot: str = .vTypeOf(m.object)
                if ot.startsWith("&")
                    ot = ot.substring(1, ot.len)
                if ot.startsWith("ZTuple") and isDigits(m.member)
                    return tupleElemType(ot, m.member)
                if ot != ""
                    if .all_field_types.get(ot + "." + m.member) as ft2
                        return ft2
                return ""
            on Expr.call as c
                # `xs.at(i)`: the list's element type; else the callee's return type
                branch c.callee
                    on Expr.member as cm
                        if cm.member == "at" and c.args.count() == 1
                            return .elemOf(.vTypeOf(cm.object))
                        var ot: str = .vTypeOf(cm.object)
                        if cm.member == "last" and c.args.count() == 0
                            return .elemOf(ot)
                        if cm.member == "pop" and c.args.count() == 0 and ot.startsWith("&ZList[")
                            return "!" + .elemOf(ot)   # the last element or an error (an empty list): `xs.pop()?` propagates
                        # (any other receiver's pop() is its own method, typed below: a class
                        # with `def pop(): str` was emitted `wire.pop()!` as a statement --
                        # the engine's wire_build_test, 2026-11-16)
                        var rown: str = ot
                        if rown.startsWith("&")
                            rown = rown.substring(1, rown.len)
                        if rown != ""
                            if .rets.get(rown + "." + cm.member) as orr
                                return orr   # the receiver's own method's type
                        if isStringReturningMethod(cm.member)
                            return "string"
                        # a builtin receiver's predicate is a bool (untyped, the option of one
                        # -- `xs?.contains(5)` -- was shown as V's `Option(true)`; found by
                        # BUG-765's fixture once the Zig route built it)
                        if vBuiltinBoolMethod(ot, cm.member)
                            return "bool"
                        var jowner: str = .staticOwner(cm.object)
                        if jowner == "Arg" and cm.member == "parse"
                            return "ZArgs"
                        if jowner == "Random" and cm.member == "new"
                            return "&ZRandom"
                        if jowner == "Timer" and cm.member == "start"
                            return "ZTimer"
                        if jowner == "Math"
                            # BUG-768: a float result is typed, so its text is the route's own
                            # (untyped, `${Math.pow(10.0, 20.0)}` was V's `1.e+20`). The
                            # checker's table: these three always a float, the rest a float
                            # for float arguments; an integer argument stays untyped here.
                            if cm.member == "pow" or cm.member == "atan2" or cm.member == "log"
                                return "f64"
                            if (cm.member == "sqrt" or cm.member == "abs" or cm.member == "floor" or cm.member == "ceil" or cm.member == "round" or cm.member == "sin" or cm.member == "cos" or cm.member == "tan" or cm.member == "exp" or cm.member == "min" or cm.member == "max" or cm.member == "clamp") and .mathArgsAllFloat(c.args)
                                return "f64"
                        if ot == "ZTimer"
                            if cm.member == "elapsed"
                                return "f64"
                            if cm.member == "elapsedMicros"
                                return "i64"
                        if jowner == "DateTime" and cm.member == "now"
                            return "ZDateTime"
                        if jowner == "Sqlite" and cm.member == "open"
                            return "?&ZSqliteDb"
                        if ot == "&ZSqliteDb" and cm.member == "query"
                            return "&ZList[&ZSqliteRow]"
                        if ot == "&ZSqliteDb" and cm.member == "journalMode"
                            return "string"
                        if ot == "&ZSqliteDb" and cm.member == "lastError"   # BUG-716
                            return "?string"
                        if ot == "&ZSqliteDb" and cm.member == "lastErrorCode"
                            return "i64"
                        if jowner == "Dir" and (cm.member == "list" or cm.member == "walk")
                            return "&ZList[string]"
                        if jowner == "File" and (cm.member == "listDir" or cm.member == "readLines")
                            return "&ZList[string]"
                        if jowner == "Http" and (cm.member == "get" or cm.member == "post")
                            return "?ZHttpResponse"
                        if jowner == "Net" and cm.member == "resolve"
                            return "&ZList[string]"
                        if jowner == "sys"
                            if cm.member == "run"
                                return "ZRunResult"
                            if cm.member == "spawnPiped" or cm.member == "spawnPipedIn"
                                return "&ZSysProcess"
                            if cm.member == "args"
                                return "&ZList[string]"
                            if cm.member == "getenv" or cm.member == "readLine" or cm.member == "readBytes"
                                return "?string"
                            if cm.member == "readStdinAvailable"
                                return "string"
                            if cm.member == "stdinClosed"
                                return "bool"
                        if ot == "ZArgs"
                            if cm.member == "option" or cm.member == "unknownFlag" or cm.member == "usage"
                                return "string"
                            if cm.member == "optionInt"
                                return "i64"
                            if cm.member == "positional"
                                return "?string"
                            if cm.member == "contains" or cm.member == "flag"
                                return "bool"
                        if jowner == "Json"
                            if cm.member == "parse"
                                return "?&ZJson"
                            if cm.member == "object" or cm.member == "array"
                                return "&ZJson"
                        if ot == "&ZJson" or (ot == "" and isJsonOnlyMethod(cm.member))
                            if cm.member == "get" or cm.member == "tryObj"
                                return "?&ZJson"
                            if cm.member == "tryStr"
                                return "?string"
                            if cm.member == "tryInt"
                                return "?i64"
                            if cm.member == "tryFloat"
                                return "?f64"
                            if cm.member == "tryBool"
                                return "?bool"
                            if cm.member == "tryList"
                                return "?&ZList[&ZJson]"
                            if cm.member == "keys"
                                return "&ZList[string]"
                            if cm.member == "values"
                                return "&ZList[&ZJson]"
                        if cm.member == "bytes" and c.args.count() == 0 and (ot == "string" or ot == "")
                            return "&ZList[u8]"
                        if cm.member == "chars" and c.args.count() == 0 and (ot == "string" or ot == "")
                            return "&ZList[rune]"
                        if ot == "rune" and c.args.count() == 0
                            if cm.member == "escapedByte"
                                return "?i64"
                            if cm.member == "toString"
                                return "string"
                        if ot == "string" and c.args.count() == 0
                            if cm.member == "codePointCount"
                                return "i64"
                            if cm.member == "isValidUtf8"
                                return "bool"
                        if (cm.member == "lines" and c.args.count() == 0) or (cm.member == "split" and c.args.count() == 1)
                            return "&ZList[string]"
                        if cm.member == "chars" and c.args.count() == 0
                            return "&ZList[rune]"
                        if ot.startsWith("chan ") and (cm.member == "recv" or cm.member == "tryRecv" or cm.member == "recvTimeout")
                            return "?" + ot.substring(5, ot.len)
                        if ot.startsWith("&ZAtomic[")
                            if cm.member == "cas"
                                return "bool"
                            if cm.member == "load" or cm.member == "swap" or cm.member == "add" or cm.member == "sub"
                                return ot.substring(9, ot.len - 1)
                        if (cm.member == "get" or cm.member == "fetch") and c.args.count() == 1 and ot.startsWith("&ZMap[")
                            # the map's value type: `?V` for get, V for fetch
                            var inner: str = ot.substring(6, ot.len - 1)
                            var cut: int = inner.indexOf(", ")
                            if cut > 0
                                var vt: str = inner.substring(cut + 2, inner.len)
                                if cm.member == "get"
                                    return "?" + vt
                                return vt
                        if c.args.count() == 0
                            # BUG-761: a conversion's result is its target type, whatever the
                            # receiver (untyped, `(n + 1).toInt8()` left the sum beside it
                            # unchecked: eight of the `sized` row's traps wrapped on V)
                            var conv_rt: str = vConvTarget(cm.member)
                            if conv_rt != ""
                                return conv_rt
                            if cm.member == "toByte"
                                return "u8"
                            if cm.member == "toFloat32"
                                return "f32"   # BUG-768
                            if cm.member == "toFloat" and (vIsFloat(ot) or vIntKind(ot) != 0)
                                return "f64"
                            if cm.member == "count" and (ot.startsWith("&ZList[") or ot.startsWith("&ZMap[") or ot.startsWith("&ZSet["))
                                return "i64"   # a container's count is an int (an untyped `var n = xs.count()` had no type here: BUG-761's fixture)
                            if cm.member == "copy"
                                return ot
                            if cm.member == "items" and ot.startsWith("&ZSet[")
                                return "&ZList[" + ot.substring(6, ot.len - 1) + "]"
                            if (cm.member == "keys" or cm.member == "values") and ot.startsWith("&ZMap[")
                                var inner: str = ot.substring(6, ot.len - 1)
                                var cut: int = inner.indexOf(", ")
                                if cut > 0
                                    if cm.member == "keys"
                                        return "&ZList[" + inner.substring(0, cut) + "]"
                                    return "&ZList[" + inner.substring(cut + 2, inner.len) + "]"
                        if ot == "string"
                            return vStringMethodRet(cm.member, c.args.count())
                        if ot.startsWith("&ZList[") or ot.startsWith("&ZMap[") or ot.startsWith("&ZSet[") or ot == "&ZJson"
                            # a builtin receiver: its method is not a declaration of the
                            # program's, so the by-name table below does not speak for it
                            # (a class with `def indexOf(...): str` typed a string's
                            # indexOf as a string: the emitted V did not compile)
                            return ""
                        return .retOf(c)
                    else
                        return .retOf(c)
            on Expr.try_ as t
                var tt: str = .vTypeOf(t.expr)   # `f()?`: the result's type, the `!` gone
                if tt.startsWith("!")
                    return tt.substring(1, tt.len)
                return tt
            on Expr.slice as sl
                return .vTypeOf(sl.object)   # a slice of a string is a string, of a list a list
            on Expr.string_lit
                return "string"
            on Expr.string_interp
                return "string"
            on Expr.int_lit as til
                var til_t: str = intLitVType(til.text)   # a suffixed literal has its suffix's type
                if til_t != ""
                    return til_t
                return "i64"
            on Expr.float_lit as flt
                if floatLitSuffix(flt.text) == "float32"
                    return "f32"   # `1.5_f32` carries its own type (BUG-768)
                return "f64"
            on Expr.bool_lit
                return "bool"
            on Expr.char_lit
                return "rune"
            on Expr.index as ix
                var ixo: str = .vTypeOf(ix.object)
                if ixo == "&ZJson" or ixo == "!&ZJson"
                    return "!&ZJson"   # a subscript on a Json value is a result (`j[k]?`); a chain too
                if ixo.startsWith("&ZList[")
                    return .elemOf(ixo)
                if ixo == "string"
                    return "u8"
                return ""
            on Expr.orelse_ as oe
                var oet: str = .vTypeOf(oe.expr)   # `x orelse y`: the option's inner type
                if oet.startsWith("?")
                    return oet.substring(1, oet.len)
                return oet
            on Expr.catch_ as ce
                var cet: str = .vTypeOf(ce.expr)   # `f() catch y`: the result's type
                if cet.startsWith("!")
                    return cet.substring(1, cet.len)
                return cet
            on Expr.to_non_nil as tnn
                var it: str = .vTypeOf(tnn.expr)   # `x!`: the option's inner type
                if it.startsWith("?")
                    return it.substring(1, it.len)
                return it
            on Expr.this_
                if .current_class == ""
                    return ""
                if .isClassName(.current_class)
                    return "&" + .current_class
                return .current_class
            on Expr.list_lit as ll
                var lt: str = .listLitElemType(ll)   # (an iterated literal of references takes the mutable loop)
                if lt == ""
                    return ""
                return "&ZList[" + lt + "]"
            on Expr.unary as u
                # `-x`, `not x`: the operand's type (bool for not)
                if u.op == UnaryOp.not_
                    return "bool"
                return .vTypeOf(u.operand)
            on Expr.binary as bn
                # arithmetic: the left's type, else the right's; a comparison or
                # a logical op: bool (an untyped `var dot = 0 - 1` is i64 by it)
                if bn.op == BinaryOp.eq or bn.op == BinaryOp.ne or bn.op == BinaryOp.lt or bn.op == BinaryOp.le or bn.op == BinaryOp.gt or bn.op == BinaryOp.ge or bn.op == BinaryOp.and_ or bn.op == BinaryOp.or_ or bn.op == BinaryOp.in_
                    return "bool"
                if bn.op == BinaryOp.dotdot
                    return ""
                var blt: str = .vTypeOf(bn.left)
                if bn.op == BinaryOp.add or bn.op == BinaryOp.sub or bn.op == BinaryOp.mul or bn.op == BinaryOp.div or bn.op == BinaryOp.mod
                    # a float with a float or an integer: the float join (BUG-768; until then
                    # the left's type, so `1 + 2.0` was an i64 and `a * f` an int)
                    var bfj: str = vFloatJoin(blt, .vTypeOf(bn.right), isNumLit(bn.left), isNumLit(bn.right))
                    if bfj != ""
                        return bfj
                if vIntKind(blt) != 0 and bn.op != BinaryOp.shl and bn.op != BinaryOp.shr
                    # two integers: the join (BUG-761); a shift keeps its left operand's type
                    var bjoin: str = vIntJoin(blt, .vTypeOf(bn.right), isIntLit(bn.left), isIntLit(bn.right))
                    if bjoin != ""
                        return bjoin
                if blt != "" and blt != "&ZJson"
                    return blt
                var brt: str = .vTypeOf(bn.right)
                if brt != "&ZJson"
                    return brt
                return ""
            on Expr.if_expr as ife
                # `if(c, a, b)`: the arms' type when they agree, or the typed arm's beside
                # a bare numeric literal (BUG-768: untyped, a float there was V's own text,
                # `1e+20`, and an integer sum beside it went unchecked). Anything else stays
                # unknown: an arm of nil makes the value an optional this does not spell.
                var ift: str = .vTypeOf(ife.then_expr)
                var ife_t: str = .vTypeOf(ife.else_expr)
                if ift == ife_t
                    return ift
                var ifnum_t: bool = vIsFloat(ift) or vIntKind(ift) != 0
                var ifnum_e: bool = vIsFloat(ife_t) or vIntKind(ife_t) != 0
                if ifnum_t and ifnum_e
                    if isNumLit(ife.else_expr) and not isNumLit(ife.then_expr) and (vIsFloat(ift) or not vIsFloat(ife_t))
                        return ift
                    if isNumLit(ife.then_expr) and not isNumLit(ife.else_expr) and (vIsFloat(ife_t) or not vIsFloat(ift))
                        return ife_t
                return ""
            on Expr.tuple_lit as tl
                var tparts: str = ""
                for el in tl.elems
                    var et: str = .vTypeOf(el)
                    if et == ""
                        return ""
                    if tparts != ""
                        tparts = tparts + ", "
                    tparts = tparts + et
                return "ZTuple" + tl.elems.count().toString() + "[" + tparts + "]"
            else
                return ""

    # a body that assigns a field of the enclosing type: through `this`, or by
    # a bare field name (Zebra allows it inside the type)
    def bodyAssignsField(stmts: List(Stmt)): bool
        for s in stmts
            if .stmtAssignsField(s)
                return true
        return false

    def stmtAssignsField(s: Stmt): bool
        branch s
            on Stmt.assign as a
                if exprRootIsThis(a.target)
                    return true
                branch a.target
                    on Expr.ident as id
                        return .isCurrentField(id.name)
                    on Expr.member as m
                        branch m.object
                            on Expr.ident as oid
                                return .isCurrentField(oid.name)   # `field.x = v`
                            else
                                return false
                    else
                        return false
            on Stmt.if_ as i
                if .bodyAssignsField(i.then_stmts)
                    return true
                for ei in i.else_ifs
                    if .bodyAssignsField(ei.stmts)
                        return true
                if i.else_stmts as es
                    return .bodyAssignsField(es)
                return false
            on Stmt.while_ as w
                return .bodyAssignsField(w.stmts)
            on Stmt.for_in as fi
                return .bodyAssignsField(fi.stmts)
            on Stmt.for_num as fnum
                return .bodyAssignsField(fnum.stmts)
            on Stmt.branch_ as b
                for arm in b.cases
                    if .bodyAssignsField(arm.stmts)
                        return true
                if b.else_ as es
                    return .bodyAssignsField(es)
                return false
            on Stmt.try_catch as tc
                if .bodyAssignsField(tc.stmts)
                    return true
                for cl in tc.clauses
                    if .bodyAssignsField(cl.stmts)
                        return true
                return false
            else
                return false

    # a binding of this type is `mut`: a struct, a class or a container may
    # be passed on as `mut x.field`, which V refuses through an immutable one
    def needsMut(vt: str): bool
        # a reference (a class, a heap struct, a container), a value struct or
        # an interface; V refuses `mut` on a sum type, an enum or a function type
        if vt.startsWith("&")
            return true
        return .isStructName(vt) or .isIfaceName(vt)

    # the element type of a list's V type ("" when it is not a list)
    def elemOf(vt: str): str
        if vt.startsWith("&ZList[") and vt.endsWith("]")
            return vt.substring(7, vt.len - 1)
        return ""

    def isContainerType(vt: str): bool
        return vt.startsWith("&ZList[") or vt.startsWith("&ZMap[") or vt.startsWith("&ZSet[")

    # the V type a constructor call makes, "" when it is not one
    def ctorTypeOf(e: Expr): str
        branch e
            on Expr.call as c
                branch c.callee
                    on Expr.ident as id
                        if .isClassName(id.name)
                            return "&" + id.name
                        if .isStructName(id.name)
                            return id.name
                        if id.name == "StringBuilder"
                            return "&ZStringBuilder"
                        return ""
                    on Expr.call as inner
                        branch inner.callee
                            on Expr.ident as cid
                                if cid.name == "List" and inner.args.count() == 1
                                    return "&ZList[" + .typeArgStr(inner.args.at(0).value) + "]"
                                if cid.name == "HashMap" and inner.args.count() == 2
                                    return "&ZMap[" + .typeArgStr(inner.args.at(0).value) + ", " + .typeArgStr(inner.args.at(1).value) + "]"
                                if cid.name == "Set" and inner.args.count() == 1
                                    return "&ZSet[" + .typeArgStr(inner.args.at(0).value) + "]"
                                return ""
                            else
                                return ""
                    else
                        return ""
            else
                return ""

    # the union a variant expression belongs to, "" when it is not one:
    # `U.v(x)`, `U.v()`, `U.v`
    def unionOfExpr(e: Expr): str
        branch e
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        var owner: str = .staticOwner(m.object)
                        if .isUnionName(owner)
                            return owner
                        return ""
                    else
                        return ""
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner
                return ""
            else
                return ""

    def isMethodName(name: str): bool
        for n in .current_methods
            if n == name
                return true
        return false

    def isStaticName(name: str): bool
        for n in .current_statics
            if n == name
                return true
        return false

    # a plain identifier naming a local of this function (not a module var, not a field)
    def isLocalIdent(e: Expr): bool
        branch e
            on Expr.ident as id
                return .isLocalName(id.name)
            else
                return false

    def isLocalName(name: str): bool
        for n in .local_names
            if n == name
                return true
        return false

    def isCurrentField(name: str): bool
        for f in .current_fields
            if f == name
                return true
        return false

    def genMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var mname: str = vSafe(m.name)
        if m.name == "toString" and m.params.count() == 0
            mname = "str"   # V's own name for it, as a struct's is
        var head = "fn (mut self " + owner + ") " + mname + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + .retSpelling(ret)
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .region_depth = 0
        .fn_region_base = 0
        .loop_region_base = 0
        .in_method = true
        .resetLocals(m.params)
        if m.stmts as body
            .genBody(body, vSafe(m.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── statements ─────────────────────────────────────────────────────────
    def genStmts(stmts: List(Stmt))
        var nmark: int = .narrowed.count()
        # a statement list is a scope: a local (and a rename) it declares is
        # gone after it, as in V and in Zebra -- else a capture declared in
        # one loop body reads as "already declared" in the next
        var saved_ln = .local_names.copy()   # (containers are references: the restore needs its own copy)
        var saved_rn = .renames.copy()
        var i: int = 0
        for s in stmts
            .genStmt(s)
            # a statement after a return or a raise never runs, and V refuses it
            # ("unreachable code"): not emitted, as the Zig backend does not emit
            # it either (the parser's `@[...]` arm kept its old body after the
            # BUG-565 raise, and the route stopped building under V, 2026-10-30)
            if (s is Stmt.return_ or s is Stmt.raise_) and i + 1 < stmts.count()
                .line("// (" + (stmts.count() - i - 1).toString() + " unreachable statement(s) after it: not emitted)")
                break
            branch s
                on Stmt.var_ as v
                    # a local nothing after it READS (an assignment is no read to V):
                    # acknowledged, or V's unused variable
                    if not readsName(v.name, restOf(stmts, i + 1))
                        .line("_ = " + .localName(v.name))
                else
                    pass
            i = i + 1
        while .narrowed.count() > nmark
            .narrowed.remove(.narrowed.count() - 1)
        .local_names = saved_ln
        .renames = saved_rn

    def isNarrowed(zname: str): bool
        for n in .narrowed
            if n == zname
                return true
        return false

    def unnarrow(zname: str)
        var i: int = 0
        while i < .narrowed.count()
            if .narrowed.at(i) == zname
                .narrowed.remove(i)
                return
            i = i + 1

    # the LOCAL a condition compares with nil (`x != nil` when want_ne, else
    # `x == nil`): its Zebra name, "" for any other condition
    def nilCmpLocal(e: Expr, want_ne: bool): str
        branch e
            on Expr.binary as b
                var is_ne: bool = b.op == BinaryOp.ne
                var is_eq: bool = b.op == BinaryOp.eq
                if not (is_ne or is_eq)
                    return ""
                if is_ne != want_ne
                    return ""
                var side: Expr = b.left
                if isNilLit(b.left)
                    side = b.right
                else if not isNilLit(b.right)
                    return ""
                branch side
                    on Expr.ident as id
                        if .isLocalName(id.name)
                            if .local_types.get(id.name) as lt
                                if lt.startsWith("?")
                                    return id.name
                        return ""
                    on Expr.member as sm
                        # `.field == nil`: the field of this, keyed as it is spelled
                        branch sm.object
                            on Expr.this_
                                if .field_types.get(sm.member) as ft
                                    if ft.startsWith("?")
                                        return "self." + vSafe(sm.member)
                                return ""
                            else
                                return ""
                    else
                        return ""
            else
                return ""

    # a local's V name (renamed when it collides with a free function)
    def localName(zname: str): str
        if .renames.get(zname) as rn
            return rn
        return vSafe(zname)

    def genStmt(s: Stmt)
        branch s
            on Stmt.var_ as v
                .genLocal(v)
            on Stmt.assign as a
                branch a.target
                    on Expr.ident as aid
                        .unnarrow(aid.name)   # assigned again: nilable again
                    on Expr.member as am
                        branch am.object
                            on Expr.this_
                                .unnarrow("self." + vSafe(am.member))
                            else
                                pass
                    else
                        pass
                var tt: str = .vTypeOf(a.target)
                # `xs[i] = v` / `m[k] = v` on the runtime's containers: a write is
                # set(), never the read's at() (V refuses a call as an lvalue; the
                # IDE's coverage.zbr, 2026-10-15); `xs[i] += v` reads then writes
                var aix_done: bool = false
                branch a.target
                    on Expr.index as aix
                        var aixt: str = .vTypeOf(aix.object)
                        if aixt.startsWith("&ZList[") or aixt.startsWith("&ZMap[")
                            var aobj: str = .exprStr(aix.object)
                            var aidx: str = .exprStr(aix.index)
                            var arhs: str = .coerced(a.value, tt)
                            var aop: str = assignOpV(a.op)
                            var acfn: str = checkedFnFor(compoundBase(a.op))
                            var asized: str = ""
                            if aop != "=" and acfn != ""
                                # (arhs is rendered and, when the value is an integer, already of
                                # the target's type: coerced() widened it -- never render twice)
                                var avt: str = .vTypeOf(a.value)
                                if vIntKind(avt) != 0
                                    avt = tt
                                asized = intArithStr(acfn, tt, avt, aobj + ".at(" + aidx + ")", arhs, false, isIntLit(a.value))
                            if aop != "=" and acfn != "" and tt == "i64" and .vTypeOf(a.value) == "i64"
                                arhs = acfn + "(" + aobj + ".at(" + aidx + "), " + arhs + ")"   # BUG-667
                            else if asized != ""
                                arhs = asized   # BUG-761: an element of a sized type, checked in the join
                            else if aop != "=" and vIsFloat(tt) and compoundBase(a.op) == BinaryOp.mod
                                .needs_math = true
                                arhs = floatModStr(aobj + ".at(" + aidx + ")", arhs, tt)   # BUG-768: V has no `%` on a float
                            else if aop != "="
                                if acfn != "" and (tt == "" or vIntKind(tt) != 0)
                                    .arith_unchecked = .arith_unchecked + 1
                                arhs = aobj + ".at(" + aidx + ") " + aop.substring(0, aop.len - 1) + " " + arhs
                            .line(aobj + ".set(" + aidx + ", " + arhs + ")")
                            aix_done = true
                    else
                        pass
                if aix_done
                    pass
                else if isBareCtor(a.value) and tt != ""
                    .line(.exprStr(a.target) + " " + assignOpV(a.op) + " " + .zeroOf(tt))   # `out = List()`: the target's type
                else
                    var rhs: str = .coerced(a.value, tt)
                    if .isRefParamName(a.value) and (tt.startsWith("&") or tt.startsWith("?&"))
                        rhs = "unsafe { " + rhs + " }"   # a reference parameter kept in a field: V's escape rule refuses it plain
                    var cfn: str = checkedFnFor(compoundBase(a.op))
                    if cfn != "" and tt == "i64" and .vTypeOf(a.value) == "i64" and isPlainPlace(a.target)
                        # BUG-667: `x += e` is `x = zadd(x, e)`; the place is a name or a
                        # field path, so reading it twice reads the same thing
                        var tgt: str = .exprStr(a.target)
                        .line(tgt + " = " + cfn + "(" + tgt + ", " + rhs + ")")
                    else
                        var csized: str = ""
                        if cfn != "" and isPlainPlace(a.target)
                            # BUG-761: `x += e` on a sized x, or with a sized e: checked in the join
                            # (rhs is rendered and, when the value is an integer, already of the
                            # target's type: coerced() widened it -- never render twice)
                            var cvt: str = .vTypeOf(a.value)
                            if vIntKind(cvt) != 0
                                cvt = tt
                            csized = intArithStr(cfn, tt, cvt, .exprStr(a.target), rhs, false, isIntLit(a.value))
                        if csized != ""
                            .line(.exprStr(a.target) + " = " + csized)
                        else if vIsFloat(tt) and compoundBase(a.op) == BinaryOp.mod and isPlainPlace(a.target)
                            .needs_math = true
                            .line(.exprStr(a.target) + " = " + floatModStr(.exprStr(a.target), rhs, tt))   # BUG-768: V has no `%` on a float
                        else
                            if cfn != "" and (tt == "" or vIntKind(tt) != 0)
                                .arith_unchecked = .arith_unchecked + 1
                            .line(.exprStr(a.target) + " " + assignOpV(a.op) + " " + rhs)
            on Stmt.expr as e
                .genExprStmt(e)
            on Stmt.if_ as i
                .genIf(i)
            on Stmt.while_ as w
                .in_cond = true
                var wcond: str = condStr(.exprStr(w.cond))
                .in_cond = false
                .line("for " + wcond + " {")
                .depth = .depth + 1
                var wlb: int = .loop_region_base
                .loop_region_base = .region_depth
                .genStmts(w.stmts)
                .loop_region_base = wlb
                .depth = .depth - 1
                .line("}")
            on Stmt.for_in as fi
                var filb: int = .loop_region_base
                .loop_region_base = .region_depth
                .genForIn(fi)
                .loop_region_base = filb
            on Stmt.for_num as fnum
                var v = vSafe(fnum.var_)
                .local_names.add(fnum.var_)
                var step: str = "++"
                if fnum.step != nil
                    step = " += " + .exprStr(fnum.step!)
                .local_types.set(fnum.var_, "i64")   # the loop variable is always an int (the checker's rule): `i.toInt16()` in the body is typed by it
                var stop_s: str = .exprStr(fnum.stop_)
                var stop_t: str = .vTypeOf(fnum.stop_)
                if vIntKind(stop_t) != 0 and stop_t != "i64" and stop_t != "u64" and not isIntLit(fnum.stop_)
                    stop_s = "i64(" + stop_s + ")"   # BUG-761: a sized bound, compared as the int the variable is
                .line("for " + v + " := i64(" + .exprStr(fnum.start) + "); " + v + " < " + stop_s + "; " + v + step + " {")
                .depth = .depth + 1
                var nlb: int = .loop_region_base
                .loop_region_base = .region_depth
                .genStmts(fnum.stmts)
                .loop_region_base = nlb
                .depth = .depth - 1
                .line("}")
                .popLocal(fnum.var_)
            on Stmt.return_ as r
                if r.value as rv
                    var rvs: str = .exprStr(rv)
                    if .region_depth > .fn_region_base and not isNilLit(rv)
                        # a value returned from inside an allocate block is computed
                        # and copied out BEFORE the pops free the block (a string or
                        # a List through zr_co_*; anything else as it is: an instance
                        # the block made is freed under it, as under the Zig arena).
                        # The first edge test returned a block's string after its
                        # pop and read the next caller's bytes.
                        .matchN = .matchN + 1
                        var rt: str = "zrv" + .matchN.toString()
                        .line(rt + " := " + .coWrap(rv, rvs))
                        rvs = rt
                    .popRegions(.fn_region_base)
                    if .current_ret.startsWith("!?")
                        # a nilable-and-throws def: the value wrapped (see retSpelling)
                        var wt: str = .current_ret.substring(2, .current_ret.len)
                        if isNilLit(rv)
                            .line("return ZOpt[" + wt + "]{}")
                        else if .vTypeOf(rv).startsWith("?")
                            .line("return zopt_from(" + rvs + ")")
                        else
                            .line("return ZOpt[" + wt + "]{ has: true, val: " + rvs + " }")
                    else
                        # BUG-768: an integer or a narrower float returned from a float
                        # function, said (V refuses an i64 where an f32 is returned)
                        var fret: str = .current_ret
                        if fret.startsWith("!")
                            fret = fret.substring(1, fret.len)
                        if fret.startsWith("?")
                            fret = fret.substring(1, fret.len)
                        if vIsFloat(fret)
                            var fhave: str = .vTypeOf(rv)
                            if fhave != fret and (vIsFloat(fhave) or vIntKind(fhave) != 0)
                                rvs = fret + "(" + rvs + ")"
                        .line("return " + .asChar(rv, rvs, .current_ret))
                else
                    .popRegions(.fn_region_base)
                    if .in_ctor
                        .line("return self")   # a `cue init` returning early: the object
                    else
                        .line("return")
            on Stmt.assert_ as asrt
                # never V's `assert`: -prod drops it, statement and all, and a
                # Zebra assert is evaluated in every build (the act is often
                # inside it: `assert h.damage(x) == "Dead"`). The Zig backend's
                # own words on failure.
                var place: str = .vStringLit("assert failed at " + .current_file + ":" + asrt.span.line.toString() + ": ")
                var cs: str = .exprStr(asrt.cond)   # (rendered once: a render binds temporaries)
                var what: str = ""
                if asrt.message as msg
                    what = .exprStr(msg)
                else
                    what = .vStringLit(cs)
                .line("if !(" + cs + ") {")
                .line("\tzbr_panic(" + place + " + " + what + ")")
                .line("}")
            on Stmt.print_ as p
                .genPrint(p)
            on Stmt.break_
                .popRegions(.loop_region_base)
                .line("break")
            on Stmt.continue_
                .popRegions(.loop_region_base)
                .line("continue")
            on Stmt.pass_
                pass
            on Stmt.branch_ as b
                .genBranch(b)
            on Stmt.raise_ as r
                .genRaise(r)
            on Stmt.try_catch as tc
                .genTryCatch(tc)
            on Stmt.in_scope as si
                .genInScope(si)
            on Stmt.with_ as ww
                .genStmts(ww.stmts)   # a `with` block: its statements, as the Zig target emits them
            on Stmt.allocate_ as al
                .genAllocate(al)
            on Stmt.copy_out as co
                .genCopyOut(co)
            else
                .refused.add("a statement kind the subset does not spell (destructure, contract, yield)")

    # an expression statement; a mutating method on a call's RESULT binds a
    # temporary first (V: "cannot pass expression as mut"): `rows.at(0).add(7)`
    def genExprStmt(e: Expr)
        branch e
            on Expr.zig_lit as zl
                # free-at-sweep (2026-11-07, the GameEngine's release paths): V's runtime is
                # collected, so nothing is FREED at a frame boundary -- but the queue is kept
                # (2026-11-16): which containers a release path queued, once each, until the
                # sweep empties it, so a program that pins its queueing reads the same on both
                # routes (the engine's signal_test and door_block_test read `pending 0 after
                # 0` while this was a constant).
                var fas: str = freeAtSweepArg(zl.text)
                if fas != ""
                    .line("zsweep_queue(voidptr(" + .localName(fas) + "))")
                    return
                if zl.text == "_zbr_sweep()"
                    .line("zsweep()")
                    return
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        if isJsonPutMethod(m.member) and (.vTypeOf(m.object) == "&ZJson" or (isJsonOnlyMethod(m.member) and .vTypeOf(m.object) == ""))
                            # `j.put(k, v)` -> `zjson_put(j, k, v)`: the value is a handle
                            # (BUG-751), changed where it is -- through any expression that
                            # reaches it, a name or not. (Until 2026-11-16 it was json2's Any
                            # by value and this wrote `j = zjson_put(j, k, v)`.)
                            .line(.jsonPutCall(m.member, .exprStr(m.object), c.args))
                            return
                        # (a call on a call's result: the method emitter binds the
                        # receiver when the call mutates it, with its type)
                    else
                        pass
            else
                pass
        var est: str = .exprStr(e)
        if .vTypeOf(e).startsWith("!")
            est = est + "!"   # a throwing call as a statement stands in a try body or a throwing def: propagated
        .line(est)

    # `raise msg` -> `return error(msg)`; the details, when given, appended to
    # the message (V's error carries one string; nothing dropped)
    def genRaise(r: StmtRaise)
        var msg: str = "'raised'"
        if r.message as m
            msg = .exprStr(m)
        if r.details as d
            msg = "(" + msg + " + ': ' + " + .exprStr(d) + ")"
        if .region_depth > .fn_region_base
            # the message copied out before the pops free the block it was built in
            .matchN = .matchN + 1
            var et: str = "zre" + .matchN.toString()
            .line(et + " := zr_co_str(" + msg + ")")
            msg = et
        .popRegions(.fn_region_base)
        .line("return error(" + msg + ")")

    # the def-level `catch |e|`: the body as a result-returning closure over
    # the def's parameters, the catch as its `or` block (V has no try
    # statement; a `return` inside the or block returns from the def, V's own
    # rule, so a value-returning def's catch must return or V says so)
    # `using EXPR eol Block` -> a handle bound, begin(), the body, end(): as the
    # Zig target's genInScope, except that V's defer is function-scoped, so the
    # end() is written after the body (an early return inside skips it)
    def genInScope(si: StmtIn)
        .tmpN = .tmpN + 1
        var tn: str = "zu" + .tmpN.toString()
        .line(tn + " := " + .exprStr(si.expr))
        .local_names.add(tn)
        .line(tn + ".begin()")
        .genStmts(si.stmts)
        .line(tn + ".end()")

    # the regions open above `base` closed before a jump out of them (a return,
    # a raise, a break, a continue): V's defer runs at the FUNCTION's end, not
    # the block's, so every exit is spelled
    def popRegions(base: int)
        var i: int = .region_depth
        while i > base
            .line("zr_region_pop()")
            i = i - 1

    # `allocate <source>` on the collected heap: a region -- the record of what
    # the runtime makes while the block is open, freed at its exit (zebra_rt.v,
    # the regions section; the GC proof of concept, 2026-11-09). Every allocator
    # source is the one region here; the comment says which was asked for. The
    # statements stand inline, not in a `{ }`: V's flow analysis does not look
    # into a bare block, so a def whose block ends in `return` read as "missing
    # return at end of function". Zebra ALLOWS a shadowing local, and inline the
    # block's names share the enclosing V scope: a block that declares a name
    # already declared is refused by name (the fix is a rename). A block whose
    # last statement leaves (return, raise, break, continue) had its pop
    # emitted before the jump; a pop after it is V's "unreachable code".
    def genAllocate(al: StmtAllocate)
        var kind: str = "an allocator"
        if al.source is Expr.call as c
            if c.callee is Expr.ident as id
                kind = id.name
        for st in al.stmts
            if st is Stmt.var_ as sv
                if .local_names.contains(sv.name)
                    .refuse("a local `" + sv.name + "` declared in an allocate block shadows an enclosing local (the block's statements stand in the enclosing V scope): rename one", sv.span)
        .line("// allocate " + kind + ": a region on the collected heap")
        .line("zr_region_push('" + .current_file + ":" + al.span.line.toString() + "')")
        .region_depth = .region_depth + 1
        .genStmts(al.stmts)
        .region_depth = .region_depth - 1
        if not endsWithJump(al.stmts)
            .line("zr_region_pop()")

    # `target <<- value`: inside a block, the value copied into the enclosing
    # context before the exit frees the block's (zr_co_*: a string, a List of
    # anything, a List of strings deep); outside one, a plain assignment, as the
    # Zig target spells it. A value type is assigned as it is: a struct holding a
    # string the block made keeps a freed string (the Zig arena's hazard too).
    def genCopyOut(co: StmtCopyOut)
        if not co.deep
            .refuse("'<-' is channel send/receive only; arena copy-out uses '<<-' (target <<- value)", co.span)
            return
        var val: str = .exprStr(co.value)
        if .region_depth > 0
            var vt: str = .vTypeOf(co.value)
            if vt.startsWith("&") and not vt.startsWith("&ZList[")
                .refuse("a copy-out of a " + vt + " (a string, a List or a value is the subset)", co.span)
            val = .coWrap(co.value, val)
        .line(.exprStr(co.target) + " = " + val)

    # a rendered value copied into the enclosing context (zr_co_*) when its type
    # is one the runtime copies -- a string, a List -- else as it is
    def coWrap(e: Expr, rendered: str): str
        var vt: str = .vTypeOf(e)
        if vt == "string"
            return "zr_co_str(" + rendered + ")"
        if vt.startsWith("&ZList[")
            return "zr_co_list(" + rendered + ")"
        return rendered

    def genTryCatch(tc: StmtTryCatch)
        if tc.clauses.count() != 1
            .refuse("a catch with " + tc.clauses.count().toString() + " clauses (one is the subset)", tc.span)
        var caps: str = ""
        if .in_method
            caps = "mut self"   # the receiver captured (V allows it; probed)
        for p in .current_params
            if caps != ""
                caps = caps + ", "
            if .isRefType(p.type_)
                caps = caps + "mut " + vSafe(p.name)
            else
                caps = caps + vSafe(p.name)
        var capList: str = ""
        if caps != ""
            capList = "[" + caps + "] "
        var inner: str = .retSpelling(.current_ret)
        if not inner.startsWith("!")
            inner = "!" + inner
        var lead: str = ""
        if .current_ret != "" and not (.current_ret == "!")
            lead = "return "
        # the regions open as the try is entered, a runtime count: a raise inside
        # a block in the body leaves the body's blocks open, and the catch
        # closes them (an error is a return from the closure, past their pops)
        .matchN = .matchN + 1
        var rd: str = "zrd" + .matchN.toString()
        .line(rd + " := zr_regions.len")
        .line(lead + "fn " + capList + "() " + inner + " {")
        .depth = .depth + 1
        var tfb: int = .fn_region_base
        var tlb: int = .loop_region_base
        .fn_region_base = .region_depth
        .loop_region_base = .region_depth
        .genStmts(tc.stmts)
        .fn_region_base = tfb
        .loop_region_base = tlb
        .depth = .depth - 1
        .line("}() or {")
        .depth = .depth + 1
        .line("zr_region_unwind(" + rd + ")")
        for cl in tc.clauses
            if cl.type_ != nil
                .refuse("a typed catch clause", cl.span)
            if cl.binding as b
                .line(vSafe(b) + " := err")
                .catch_bindings.add(vSafe(b))
                .line("_ = " + vSafe(b))   # (always: a clause that never reads it would be V's unused variable)
            .genStmts(cl.stmts)
            if cl.binding != nil
                .catch_bindings = dropLast(.catch_bindings)
        .depth = .depth - 1
        .line("}")

    # `branch x` as V's `match` on a bound temporary (V smart-casts an
    # identifier, not an expression); a union arm's binding reads the
    # variant's payload; an `else` is always present (V wants exhaustiveness)
    def genBranch(b: StmtBranch)
        .matchN = .matchN + 1
        var t = "zm" + .matchN.toString()   # (V refuses a name beginning with `_`)
        .line(t + " := " + .exprStr(b.expr))
        .line("match " + t + " {")
        .depth = .depth + 1
        for arm in b.cases
            if arm.guard_expr.count() > 0
                .refuse("a branch arm with a guard", arm.span)
            if arm.struct_pat != nil
                .refuse("a branch arm with a struct pattern", arm.span)
            var vals: str = ""
            var first: bool = true
            for v in arm.values
                if not first
                    vals = vals + ", "
                first = false
                vals = vals + .armValueStr(v)
            .line(vals + " {")
            .depth = .depth + 1
            if arm.binding as bnd
                if bnd != "_"   # (a discarded binding is not bound: V's unused variable)
                    .local_names.add(bnd)
                    var lead: str = ""
                    var vk: str = ""   # the variant key, for the payload type and the box
                    if arm.values.count() == 1
                        vk = .armValueStr(arm.values.at(0))
                        if .union_payloads.get(vk) as pt
                            .local_types.set(bnd, pt)
                            if .needsMut(pt)
                                lead = "mut "   # V refuses `mut x.field` through an immutable binding
                    .line(lead + vSafe(bnd) + " := " + t + ".payload" + .unbox(vk))
                    if not mightUseName(bnd, arm.stmts)
                        .line("_ = " + vSafe(bnd))
            .genStmts(arm.stmts)
            .depth = .depth - 1
            .line("}")
        # V wants a match exhaustive OR with an else, and refuses an else on
        # an exhaustive one: over a union or an enum the arms are counted
        # against the type's members; over a plain value an else is always needed
        var exhaustive: bool = .armsExhaustive(b)
        if b.else_ as es
            if exhaustive
                .line("// (the branch's else: unreachable, every member is an arm; V refuses it)")
            else
                .line("else {")
                .depth = .depth + 1
                .genStmts(es)
                .depth = .depth - 1
                .line("}")
        else if not exhaustive
            if .branchSubjectIsPaddedUnion(b)
                # the padded one-variant union: its else can never run, and an
                # empty one leaves V a path without a return when the arm returns
                .line("else { zbr_panic('unreachable: the pad of a one-variant union') }")
            else
                .line("else {}")
        .depth = .depth - 1
        .line("}")

    # the branch's subject is a union with one variant (padded with ZUnionPad)
    def branchSubjectIsPaddedUnion(b: StmtBranch): bool
        for arm in b.cases
            for v in arm.values
                branch v
                    on Expr.member as m
                        branch m.object
                            on Expr.ident as id
                                if .isUnionName(id.name) and (.member_counts.get(id.name) orelse 0) == 1
                                    return true
                            else
                                pass
                    else
                        pass
        return false

    def armsExhaustive(b: StmtBranch): bool
        var subject: str = ""
        var seen = List(str)()
        for arm in b.cases
            for v in arm.values
                branch v
                    on Expr.member as m
                        branch m.object
                            on Expr.ident as id
                                if .isUnionName(id.name) or .isEnumName(id.name)
                                    subject = id.name
                                    var key = m.member
                                    var had: bool = false
                                    for sn in seen
                                        if sn == key
                                            had = true
                                    if not had
                                        seen.add(key)
                            else
                                pass
                    else
                        pass
        if subject == ""
            return false
        if .isUnionName(subject) and (.member_counts.get(subject) orelse 0) == 1
            return false   # the one-variant union is padded with ZUnionPad: never exhaustive by its arms
        return seen.count() >= (.member_counts.get(subject) orelse 0)

    # an arm's value: a union variant (`U.v`, the variant's struct type), an
    # enum member, or a plain value
    def armValueStr(v: Expr): str
        branch v
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner + "_" + m.member
                if .isEnumName(owner)
                    return "." + vSafe(m.member)   # a match on an enum spells its arms `.member`
                return .exprStr(v)
            on Expr.binary as rb
                if rb.op == BinaryOp.dotdot
                    # `on c'0'..c'9'`: V's inclusive range arm, three dots
                    return .exprStr(rb.left) + "..." + .exprStr(rb.right)
                return .exprStr(v)
            else
                return .exprStr(v)

    # `var x: int = 5` -> `mut x := i64(5)`; the type carried onto a numeric
    # literal, since V's untyped int is 32-bit and Zebra's is 64
    def genLocal(v: DeclVar)
        # already in V's scope: a lambda's `capture var c` is declared in the
        # ENCLOSING scope (V captures a variable of it) and outlives the lambda
        # there, so a later `var c` of the same function -- legal Zebra, the
        # capture was the lambda's -- is V's "redefinition of `c`" (the
        # engine's instance_test, 2026-11-16). The later local takes a name of
        # its own; every read of it goes through the rename.
        var held: bool = .isLocalName(v.name)
        .local_names.add(v.name)
        var name = vSafe(v.name)
        if .isFnName(name)
            name = name + "_v"   # V refuses a call ambiguous between a function and a local of its name
            .renames.set(v.name, name)
        else if .isEmittedGlobal(name)
            name = name + "_v"   # a local shadowing a module-level const of any module: a warning -prod refuses
            .renames.set(v.name, name)
        else if held
            .tmpN = .tmpN + 1
            name = name + "_r" + .tmpN.toString()
            .renames.set(v.name, name)
        if v.init_expr as ie
            var tname: str = ""
            if v.type_ as t
                tname = .vType(t)
            var rhs: str = ""
            if isUntypedListLit(ie) and tname.startsWith("&ZList[")
                # `var xs: List(int) = [...]`: the element type is the variable's
                rhs = .listLitWith(ie, tname.substring(7, tname.len - 1))
            else if isBareCtor(ie) and tname != ""
                rhs = .zeroOf(tname)   # `var xs: List(int) = List()`: the type is the variable's
            else
                var tn0: str = tname
                if tn0.startsWith("?")
                    tn0 = tn0.substring(1, tn0.len)
                var decl_iface: bool = .isIfaceName(tn0)
                if decl_iface
                    .iface_target = true   # `var l: Loader = x!`: the narrowed read in V's own unwrap
                rhs = .exprStr(ie)
                if decl_iface
                    .iface_target = false
                var un: str = .unionOfExpr(ie)
                if un != ""
                    # a variant is a value of its union: V would type the variable
                    # by the variant and refuse the next assignment
                    rhs = un + "(" + rhs + ")"
                    if tname == ""
                        tname = un
            if tname == ""
                tname = .ctorTypeOf(ie)
            if tname == ""
                tname = .vTypeOf(ie)   # the expression's type, when the emitter knows it
            if tname != ""
                .local_types.set(v.name, tname)
            if tname.startsWith("?") and isNilLit(ie)
                rhs = tname + "(none)"   # `var x: T? = nil`: V types `none` alone as none
            else if .vTypeOf(ie) == "&ZJson" and (tname == "i64" or tname == "f64" or tname == "bool" or tname == "string" or tname == "&ZList[&ZJson]")
                rhs = coerceRendered(rhs, tname)   # (rhs is rendered already: never render twice)
            else if tname == "i64"
                rhs = "i64(" + rhs + ")"   # (whatever the initializer: `-1` is V's int, a call's i64 is unchanged)
            else if vIntKind(tname) != 0
                rhs = tname + "(" + rhs + ")"   # BUG-761: a sized local is its type (a literal or a narrower value: the checker let nothing else in)
            else if vIsFloat(tname)
                rhs = tname + "(" + rhs + ")"
            else if tname == "rune"
                rhs = .asChar(ie, rhs, tname)
            else if tname == "" and isIntLit(ie)
                rhs = "i64(" + rhs + ")"
            else if tname.startsWith("&") and not tname.startsWith("&Z") and isIdentExpr(ie)
                # a reference by name: through its pointer cast -- inside a
                # closure capturing the name with [mut], a bare assignment
                # copies the struct (vlang/v#30348)
                rhs = tname + "(" + rhs + ")"
            .line("mut " + name + " := " + rhs)
        else
            if v.type_ as t
                .local_types.set(v.name, .vType(t))
                .line("mut " + name + " := " + .zeroOf(.vType(t)))
            else
                .refuse("var " + v.name + " without a type or a value", v.span)

    def zeroOf(vt: str): str
        if vt == "i64": return "i64(0)"
        if vt == "f64": return "f64(0)"
        if vt == "f32": return "f32(0)"
        if vt == "string": return "''"
        if vt == "bool": return "false"
        if vt == "rune": return "rune(0)"
        if vIntKind(vt) != 0: return vt + "(0)"
        if vt.startsWith("&ZList["): return "new_zlist" + vt.substring(6, vt.len) + "()"
        if vt.startsWith("&ZMap["): return "new_zmap" + vt.substring(5, vt.len) + "()"
        if vt.startsWith("&ZSet["): return "new_zset" + vt.substring(5, vt.len) + "()"
        if vt == "&ZStringBuilder": return "new_zstring_builder()"
        if vt == "&ZJson": return "zjson_null()"
        if vt.startsWith("&"): return vt.substring(1, vt.len) + "{}"
        return vt + "{}"

    def genIf(i: StmtIf)
        var captured: str = ""
        var ne_name: str = ""
        var eq_name: str = ""
        if i.is_capture as cap
            captured = .genIfCapture(cap, i.cond)
        else
            ne_name = .nilCmpLocal(i.cond, true)
            eq_name = .nilCmpLocal(i.cond, false)
            .line("if " + condStr(.exprStr(i.cond)) + " {")
        .depth = .depth + 1
        if ne_name != ""
            .narrowed.add(ne_name)   # `if x != nil`: Zebra reads x as its inner type in the block
        if captured != ""
            .line(captured)
        if i.is_capture as cap2
            if not readsName(cap2, i.then_stmts)
                .line("_ = " + vSafe(cap2))   # a binding nothing reads (V's unused variable, an error under -prod)
        .genStmts(i.then_stmts)
        if ne_name != ""
            .unnarrow(ne_name)
        if i.is_capture as capn
            .popLocal(capn)
        .depth = .depth - 1
        for ei in i.else_ifs
            if ei.is_capture as ecap
                .line("} else if " + vSafe(ecap) + " := " + .exprStr(ei.cond) + " {")
            else
                .line("} else if " + condStr(.exprStr(ei.cond)) + " {")
            .depth = .depth + 1
            .genStmts(ei.stmts)
            .depth = .depth - 1
        if i.else_stmts as es
            # Zebra's `else if` is an if alone in the else: V's `} else if`,
            # flat -- seventy nested elses (the autoplay's stage chain) passed
            # V's depth of forty. Not over a nil comparison: its narrowing
            # stays in the nested form.
            var chained: bool = false
            if eq_name == ""
                chained = .genElseIfChain(es)
            if not chained
                .line("} else {")
                .depth = .depth + 1
                if eq_name != "" and i.else_ifs.count() == 0
                    .narrowed.add(eq_name)   # the else of `if x == nil`
                .genStmts(es)
                if eq_name != "" and i.else_ifs.count() == 0
                    .unnarrow(eq_name)
                .depth = .depth - 1
        .line("}")
        if eq_name != "" and i.else_ifs.count() == 0 and i.else_stmts == nil and endsWithExit(i.then_stmts)
            .narrowed.add(eq_name)   # `if x == nil: return`: x is its inner type for the rest of the block

    # an else holding one plain if (no capture, no nil comparison): emitted as
    # `} else if cond {` and its own else the same way, flat; true when it was
    def genElseIfChain(es: List(Stmt)): bool
        if es.count() != 1
            return false
        branch es.at(0)
            on Stmt.if_ as ni
                if ni.is_capture != nil
                    return false
                if .nilCmpLocal(ni.cond, true) != "" or .nilCmpLocal(ni.cond, false) != ""
                    return false
                # the condition rendered in a cloned context first: one that binds
                # a temporary (a `mut` argument wants a variable) emits a line, and
                # V's `else if` has no place for it -- the nested form then. A
                # render that emitted nothing is pure, so its text is used as is.
                var probe = .cloneContext()
                probe.depth = .depth
                var cs: str = probe.exprStr(ni.cond)
                for r in probe.refused
                    .refused.add(r)
                .rt_unverified = .rt_unverified + probe.rt_unverified
                .arith_unchecked = .arith_unchecked + probe.arith_unchecked
                if probe.sb.build() != ""
                    return false
                .line("} else if " + condStr(cs) + " {")
                .depth = .depth + 1
                .genStmts(ni.then_stmts)
                .depth = .depth - 1
                for ei in ni.else_ifs
                    if ei.is_capture as ecap
                        .line("} else if " + vSafe(ecap) + " := " + .exprStr(ei.cond) + " {")
                    else
                        .line("} else if " + condStr(.exprStr(ei.cond)) + " {")
                    .depth = .depth + 1
                    .genStmts(ei.stmts)
                    .depth = .depth - 1
                if ni.else_stmts as es2
                    if not .genElseIfChain(es2)
                        .line("} else {")
                        .depth = .depth + 1
                        .genStmts(es2)
                        .depth = .depth - 1
                return true
            else
                return false

    # `if cond as name`: a nilable's binding (`if name := cond {`), or a union
    # check's (`if x is U_v {` then `name := x.payload`, V's smart cast on an
    # identifier); returns the then-block's first line when there is one
    def genIfCapture(cap: str, cond: Expr): str
        branch cond
            on Expr.type_check as tc
                if tc.variant_name as vn
                    var subj = .exprStr(tc.expr)
                    if not isNameExpr(tc.expr)
                        # V smart-casts a name, not a call's result or an unwrap: the subject bound first
                        .tmpN = .tmpN + 1
                        var zs = "zs" + .tmpN.toString()
                        .line(zs + " := " + subj)
                        subj = zs
                    .line("if " + subj + " is " + tc.type_name + "_" + vn + " {")
                    .local_names.add(cap)
                    var lead: str = ""
                    if .union_payloads.get(tc.type_name + "_" + vn) as pt
                        .local_types.set(cap, pt)
                        if .needsMut(pt)
                            lead = "mut "
                    return lead + vSafe(cap) + " := " + subj + ".payload" + .unbox(tc.type_name + "_" + vn)
                .refuse("`is` on a class (not a union variant)", tc.span)
                .line("if true {")
                return ""
            else
                var ct: str = .vTypeOf(cond)
                var lead: str = ""
                if ct.startsWith("?")
                    var inner: str = ct.substring(1, ct.len)
                    .local_types.set(cap, inner)
                    if .needsMut(inner)
                        lead = "mut "   # V refuses `mut y.field` through an immutable binding
                .local_names.add(cap)
                .line("if " + lead + vSafe(cap) + " := " + .exprStr(cond) + " {")
                return ""

    # a block-scoped name (a loop variable, an `if x as y` binding) leaves the
    # local list at its block's end, as it leaves V's scope: a later
    # declaration of the name is a declaration again, not an assignment
    # (minigames_test: `for r in ...` then `capture var r = rec`, 2026-10-15)
    def popLocal(name: str)
        var last: int = -1
        var i: int = 0
        while i < .local_names.count()
            if .local_names.at(i) == name
                last = i
            i = i + 1
        if last < 0
            return
        var kept = List(str)()
        i = 0
        while i < .local_names.count()
            if i != last
                kept.add(.local_names.at(i))
            i = i + 1
        .local_names = kept

    # a loop's body, behind its filter when the loop has one (`for x in xs if
    # cond`: a continue at the head, V's own form)
    def genFilteredBody(fi: StmtForIn)
        if fi.filter as flt
            .line("if !(" + .exprStr(flt) + ") {")
            .depth = .depth + 1
            .line("continue")
            .depth = .depth - 1
            .line("}")
        .genStmts(fi.stmts)

    def genForIn(fi: StmtForIn)
        if fi.vars.count() == 2
            # `for k, v in m`: a map's entries; V iterates the runtime's inner map
            var kname: str = fi.vars.at(0)
            var vname: str = fi.vars.at(1)
            .local_names.add(kname)
            .local_names.add(vname)
            var mt: str = .vTypeOf(fi.iter)
            if mt.startsWith("&ZMap[")
                var inner: str = mt.substring(6, mt.len - 1)
                var cut: int = inner.indexOf(", ")
                if cut > 0
                    .local_types.set(kname, inner.substring(0, cut))
                    .local_types.set(vname, inner.substring(cut + 2, inner.len))
            .line("for " + vSafe(kname) + ", " + vSafe(vname) + " in " + .exprStr(fi.iter) + ".m {")
            .depth = .depth + 1
            if not mightUseName(kname, fi.stmts)
                .line("_ = " + vSafe(kname))
            if not mightUseName(vname, fi.stmts)
                .line("_ = " + vSafe(vname))
            .genFilteredBody(fi)
            .depth = .depth - 1
            .line("}")
            .popLocal(kname)
            .popLocal(vname)
            return
        if fi.vars.count() != 1
            .refuse("for with " + fi.vars.count().toString() + " loop variables", fi.span)
            return
        var v = vSafe(fi.vars.at(0))
        .local_names.add(fi.vars.at(0))
        # `for i in a..b`: a numeric range
        branch fi.iter
            on Expr.binary as rb
                if rb.op == BinaryOp.dotdot
                    .line("for " + v + " := i64(" + .exprStr(rb.left) + "); " + v + " < " + .exprStr(rb.right) + "; " + v + "++ {")
                    .depth = .depth + 1
                    .genFilteredBody(fi)
                    .depth = .depth - 1
                    .line("}")
                    .popLocal(fi.vars.at(0))
                    return
            else
                pass
        # `for i in a.to(b)`: a numeric range
        branch fi.iter
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        if m.member == "to" and c.args.count() == 1
                            .line("for " + v + " := i64(" + .exprStr(m.object) + "); " + v + " < " + .exprStr(c.args.at(0).value) + "; " + v + "++ {")
                            .depth = .depth + 1
                            .genFilteredBody(fi)
                            .depth = .depth - 1
                            .line("}")
                            .popLocal(fi.vars.at(0))
                            return
                    else
                        pass
            else
                pass
        var et: str = .elemOf(.vTypeOf(fi.iter))
        var v_unused: bool = not mightUseName(fi.vars.at(0), fi.stmts)
        if et != ""
            .local_types.set(fi.vars.at(0), et)
            if .needsMut(et)
                # an element passed on as `mut x.field`: by index, the element
                # copied into a mutable local (V's `for mut x` makes a reference
                # to the element and needs the list's root mutable)
                .tmpN = .tmpN + 1
                var it = "zit" + .tmpN.toString()
                var ix = "zix" + .tmpN.toString()
                .line(it + " := " + .exprStr(fi.iter))
                .line("for " + ix + " := 0; " + ix + " < " + it + ".count(); " + ix + "++ {")
                .depth = .depth + 1
                .line("mut " + v + " := unsafe { " + it + ".at(" + ix + ") }")   # (unsafe: master's "aliases mutable data from an immutable value" on the temporary)
                # (the variable is in the local list since the loop's head; a second
                # add here left one behind the pop at the end -- minigames_test's
                # later capture of the name read as an assignment, 2026-10-15)
                if v_unused
                    .line("_ = " + v)
                .genFilteredBody(fi)
                .depth = .depth - 1
                .line("}")
                .popLocal(fi.vars.at(0))
                return
        var iter_s: str = .exprStr(fi.iter)
        if .vTypeOf(fi.iter) == "&ZJson"
            iter_s = "zjson_list(" + iter_s + ")"   # a Json array iterated
            .local_types.set(fi.vars.at(0), "&ZJson")
        if not .isLocalIdent(fi.iter)
            # an expression iterated (a call, an unwrap, an orelse): bound first --
            # V's C for `(expr or { ... }).items` in a for header did not compile.
            # A MODULE VAR or a FIELD is bound too (BUG-681, 2026-11-07): V's C re-reads a
            # global's (or `self.f`'s) `.items` on every iteration, so a body that reassigned
            # the list (a release
            # path rebuilding it) switched the walk to the NEW list mid-way -- 40 where Zig,
            # which evaluates the header once, printed 45.
            .tmpN = .tmpN + 1
            var zi = "zit" + .tmpN.toString()
            .line(zi + " := " + iter_s)
            iter_s = zi
        .line("for " + v + " in " + iter_s + ".items {")   # a list's items (the subset iterates lists)
        .depth = .depth + 1
        if v_unused
            .line("_ = " + v)
        .genFilteredBody(fi)
        .depth = .depth - 1
        .line("}")
        .popLocal(fi.vars.at(0))

    def genPrint(p: StmtPrint)
        var fnname: str = "println"
        if not p.newline
            fnname = "print"
        if p.args.count() == 1
            .line(fnname + "(" + .charText(p.args.at(0), .exprStr(p.args.at(0))) + ")")
            return
        var parts: str = ""
        var first: bool = true
        for a in p.args
            if not first
                parts = parts + " "
            first = false
            parts = parts + "\${" + .charText(a, .exprStr(a)) + "}"
        .line(fnname + "('" + parts + "')")

    # A char where text is written (print, an interpolation hole): its text through the
    # runtime, never V's own rune.str() -- that would write an escape char as three bytes.
    # A container there (BUG-723): the Zig route's spelling through the runtime's
    # zshow_*, never V's own str() of the boxed type -- that printed the runtime's
    # internals (`&ZList[rune]{ items: [...] }`).
    def charText(e: Expr, rendered: str): str
        var ct: str = .vTypeOf(e)
        if ct == "rune"
            return "zchar_str(" + rendered + ")"
        if ct == "&ZJson"
            return "zjson_stringify(" + rendered + ")"   # a JsonValue as text is its JSON text (BUG-751's rule 14)
        if .isContainerType(ct)
            return .showContainer(ct, rendered)
        if .isShownType(ct)
            return .showValue(ct, rendered)
        if .isShownOptional(ct)
            return .showFn(ct, false) + "(" + rendered + ")"
        if ct == "f64"
            return "zshow_f(" + rendered + ")"   # BUG-768: print(x) of a float is the hole's text (it was V's str(): `1.e+20`)
        if ct == "f32"
            return "zshow_f32(" + rendered + ")"
        return rendered

    # An optional of something this route prints (BUG-746's ground: until 2026-11-15 one
    # in a print or a hole was V's own text -- `Option(none)`, `&Option(&nil)`, V's dump
    # of a class inside it -- where the Zig route writes `nil` or the value). Its printer
    # is the optional helper showFn already writes for a field.
    def isShownOptional(vt: str): bool
        if not vt.startsWith("?") or vt.len < 2
            return false
        var inner: str = vt.substring(1, vt.len)
        return inner == "string" or inner == "rune" or vIntKind(inner) != 0 or inner == "byte" or inner == "bool" or inner == "f64" or inner == "f32" or inner == "&ZJson" or .isContainerType(inner) or .isShownType(inner) or .isEnumName(inner)

    # a class or a struct by its V type (`&Pt`, `Rgb`): what print, a hole and
    # toString() give the Zig route's text for (BUG-746)
    def isShownType(vt: str): bool
        var bare: str = vt
        if bare.startsWith("&")
            bare = bare.substring(1, bare.len)
        return bare != "" and (.isClassName(bare) or .isStructName(bare))

    # A class or struct value as text. One that declares `cue toString()` is its
    # own str(), called by name: V's `${x}` of a reference writes `&` before it
    # (`&Named(own)`). One that does not is the Zig route's `Name{field: value}`,
    # through a helper written after the program -- never V's own dump.
    def showValue(vt: str, rendered: str): str
        var bare: str = vt
        if bare.startsWith("&")
            bare = bare.substring(1, bare.len)
        if .own_tostring.get(bare) != nil
            return rendered + ".str()"
        return .showFn(vt, true) + "(" + rendered + ")"

    # A container of V type `vt` as the Zig route prints it: the runtime's
    # zshow_list / zshow_map / zshow_set over the element's own printer.
    def showContainer(vt: str, rendered: str): str
        if vt.startsWith("&ZList[")
            return "zshow_list(" + rendered + ", " + .showFn(.elemOf(vt), true) + ")"
        var inner: str = vt.substring(6, vt.len - 1)   # "&ZMap[" and "&ZSet[" are both six long
        if vt.startsWith("&ZSet[")
            return "zshow_set(" + rendered + ", " + .showFn(inner, false) + ")"
        # a map's key is a scalar on this route, so the first ", " ends it
        var cut: int = inner.indexOf(", ")
        if cut <= 0
            .refused.add("printing a map whose V type is not understood (" + vt + ")")
            return "zshow_raw_str('')"
        return "zshow_map(" + rendered + ", " + .showFn(inner.substring(0, cut), false) + ", " + .showFn(inner.substring(cut + 2, inner.len), true) + ")"

    # The printer for one element of V type `et`: quoted as the Zig route quotes
    # an item inside a container (a string in double quotes, a char in single),
    # bare for a map's or a set's key. A nested container gets a helper function
    # of its own, written once per type after the program: a function literal
    # here would put braces inside a string's `${...}`. An element the runtime
    # has no printer for is REFUSED by name -- a class, an optional, a tuple, a
    # union -- where V's str() would have printed something of its own.
    def showFn(et: str, quoted: bool): str
        if et == "string"
            if quoted
                return "zshow_q_str"
            return "zshow_raw_str"
        if et == "rune"
            if quoted
                return "zshow_q_char"
            return "zshow_raw_char"
        if et == "i64": return "zshow_int"
        if et == "u8" or et == "byte": return "zshow_byte"   # (`byte` was this route's spelling of the element until BUG-761)
        if vIntKind(et) != 0: return "zshow_" + et   # BUG-761: the other sized integers, by their number
        if et == "bool": return "zshow_bool"
        if et == "f64": return "zshow_float"
        if et == "f32": return "zshow_f32"   # BUG-768: a float32's own shortest digits
        if et == "&ZJson": return "zjson_stringify"   # inside a container or an optional too: the JSON text
        var key: str = et
        if not quoted
            key = et + " (bare)"
        if .show_names.get(key) as known
            return known
        if .isContainerType(et)
            var at: int = .reserveShow(key)
            .show_helpers.set(at, "fn zshow_h" + at.toString() + "(zr_e " + et + ") string {\n\treturn " + .showContainer(et, "zr_e") + "\n}\n")
            return "zshow_h" + at.toString()
        if .isShownType(et)
            # a class or a struct (BUG-746): its own toString when it has one (the
            # method's receiver is `mut self`, so the helper takes its own handle),
            # else the Zig route's `Name{field: value, ...}`, each field as inside a
            # container -- a string quoted, a nested value through its own printer
            var bare: str = et
            if bare.startsWith("&")
                bare = bare.substring(1, bare.len)
            var cat: int = .reserveShow(key)
            var body: str = ""
            if .own_tostring.get(bare) != nil
                body = "\tmut zr_m := unsafe { zr_e }\n\treturn zr_m.str()\n"
            else
                var text: str = "'" + bare + "{'"
                var n: int = 0
                for fname in .show_fields.get(bare) orelse List(str)()
                    var ft: str = .all_field_types.get(bare + "." + fname) orelse ""
                    if n > 0
                        text = text + " + ', '"
                    text = text + " + '" + fname + ": ' + " + .showFn(ft, true) + "(zr_e." + vSafe(fname) + ")"
                    n = n + 1
                if et.startsWith("&")
                    # a class (BUG-749): one met again on the path being printed is
                    # `Name{...}` -- following it recursed until the stack ended. The
                    # runtime keeps the path per thread (zshow_enter / zshow_leave), as
                    # the Zig route's `_zbr_show_path`; a struct is a value and cannot
                    # reach itself, so it takes no place on the path there or here.
                    body = "\tif !zshow_enter(voidptr(zr_e)) {\n\t\treturn '" + bare + "{...}'\n\t}\n\tzr_txt := " + text + " + '}'\n\tzshow_leave()\n\treturn zr_txt\n"
                else
                    body = "\treturn " + text + " + '}'\n"
            .show_helpers.set(cat, "fn zshow_h" + cat.toString() + "(zr_e " + et + ") string {\n" + body + "}\n")
            return "zshow_h" + cat.toString()
        if .isEnumName(et)
            var eat: int = .reserveShow(key)
            .show_helpers.set(eat, "fn zshow_h" + eat.toString() + "(zr_e " + et + ") string {\n\treturn zr_e.str()\n}\n")
            return "zshow_h" + eat.toString()
        if et.startsWith("?") and et.len > 1
            # an optional: `nil`, else the value as its own printer has it
            var oat: int = .reserveShow(key)
            var inner_fn: str = .showFn(et.substring(1, et.len), quoted)
            .show_helpers.set(oat, "fn zshow_h" + oat.toString() + "(zr_e " + et + ") string {\n\tif zr_v := zr_e {\n\t\treturn " + inner_fn + "(zr_v)\n\t}\n\treturn 'nil'\n}\n")
            return "zshow_h" + oat.toString()
        .refused.add("printing a " + et + " (the V route prints str, char, int, byte, bool, float, an enum, a class, a struct, an optional or a container of those; V's own str() would print the runtime's internals)")
        return "zshow_raw_str"

    # the next helper's number, taken under `key` BEFORE its body is built: a
    # type that reaches itself (a node whose field is a node) finds its own name
    def reserveShow(key: str): int
        .show_names.set(key, "zshow_h" + .show_helpers.count().toString())
        .show_helpers.add("")
        return .show_helpers.count() - 1

    # ── expressions ────────────────────────────────────────────────────────
    def exprStr(e: Expr): str
        branch e
            on Expr.int_lit as il
                if intLitSuffix(il.text) != ""
                    # BUG-761: `300_i16`, `5_u8`, `7u` -- a value of that type, by V's cast
                    var lit_t: str = intLitVType(il.text)
                    if lit_t == ""
                        .refuse("a suffixed literal `" + il.text + "` (V has no integer of that width)", il.span)
                        return intLitDigits(il.text)
                    return lit_t + "(" + intLitDigits(il.text) + ")"
                return il.text
            on Expr.float_lit as fl
                var fsfx: str = floatLitSuffix(fl.text)
                if fsfx == "float32"
                    return "f32(" + floatLitDigits(fl.text) + ")"   # BUG-768: the suffix is V's cast
                if fsfx == "float"
                    return "f64(" + floatLitDigits(fl.text) + ")"
                if fsfx != ""
                    .refuse("a suffixed literal `" + fl.text + "` (its suffix names no float type this route maps)", fl.span)
                return fl.text
            on Expr.bool_lit as bl
                if bl.value
                    return "true"
                return "false"
            on Expr.string_lit as sl
                if sl.text.startsWith("\"\"\"")
                    return .vDocStringLit(sl.text)
                # (a raw string's text is kept pre-escaped by the lexer, for the Zig
                # literal: it takes the escape path like any other)
                return .vStringLit(sl.text)
            on Expr.string_interp as si
                return .vInterp(si)
            on Expr.this_
                return "self"
            on Expr.ident as id
                if .isNarrowed(id.name)
                    if .local_types.get(id.name) as nlt
                        return .narrowedRead(.localName(id.name), id.name, nlt, .current_file + ":" + id.span.line.toString())   # Zebra reads it narrowed; V never narrows here
                if .renames.get(id.name) as rn
                    if .isLocalName(id.name)
                        return rn
                if .isGlobalName(id.name) and not .isLocalName(id.name) and not .isCurrentField(id.name)
                    return .globalName(id.name)   # a module-level var, prefixed when two modules declare the name
                if .isCurrentField(id.name) and not .isLocalName(id.name)
                    return "self." + vSafe(id.name)   # a bare field name inside its class (Zebra allows it)
                return vSafe(id.name)
            on Expr.member as m
                return .memberStr(m)
            on Expr.call as c
                return .callStr(c)
            on Expr.index as ix
                var ixt: str = .vTypeOf(ix.object)
                if ixt == "&ZJson" or ixt == "!&ZJson"
                    # a chained index (`j["a"]["b"]`): the inner is a result, propagated
                    # with `!` -- the chain is one throwing expression under its one `?`
                    var jobj: str = .exprStr(ix.object)
                    if ixt == "!&ZJson"
                        jobj = jobj + "!"
                    var kt: str = .vTypeOf(ix.index)
                    if kt == "string"
                        return "zjson_idx(" + jobj + ", " + .exprStr(ix.index) + ")"   # Zebra's j[key]: a result
                    return "zjson_idx_at(" + jobj + ", " + .exprStr(ix.index) + ")"
                if ixt.startsWith("&ZList[")
                    return .exprStr(ix.object) + ".at(" + .exprStr(ix.index) + ")"   # the runtime's list
                if ixt.startsWith("&ZMap[")
                    return .exprStr(ix.object) + ".fetch(" + .exprStr(ix.index) + ")"
                return .exprStr(ix.object) + "[" + .exprStr(ix.index) + "]"
            on Expr.binary as b
                return .binaryStr(b)
            on Expr.unary as u
                if u.op == UnaryOp.neg
                    if .vTypeOf(u.operand) == "i64" and not isIntLit(u.operand)
                        return "zneg(" + .exprStr(u.operand) + ")"   # BUG-667: -min traps
                    var nt: str = .vTypeOf(u.operand)
                    if vIntKind(nt) == 1 and nt != "i64" and not isIntLit(u.operand)
                        return nt + "(zfit(zneg(i64(" + .exprStr(u.operand) + ")), " + vIntBounds(nt) + "))"   # BUG-761: -min of a narrow type traps too
                    return "(-" + .exprStr(u.operand) + ")"
                if u.op == UnaryOp.not_
                    return "(!" + .exprStr(u.operand) + ")"
                return "(~" + .exprStr(u.operand) + ")"
            on Expr.list_lit as ll
                return .listLitStr(ll)
            on Expr.if_expr as ie
                return "(if " + condStr(.exprStr(ie.cond)) + " { " + .exprStr(ie.then_expr) + " } else { " + .exprStr(ie.else_expr) + " })"
            on Expr.type_check as tc
                if tc.variant_name as vn
                    if .isEnumName(tc.type_name)
                        return "(" + .exprStr(tc.expr) + " == ." + vSafe(vn) + ")"   # `x is Enum.member`
                    return "(" + .exprStr(tc.expr) + " is " + tc.type_name + "_" + vn + ")"
                .refuse("`is` on a class (not a union variant)", tc.span)
                return "true"
            on Expr.nil_
                return "none"
            on Expr.orelse_ as oe
                return "(" + .exprStr(oe.expr) + " or { " + .exprStr(oe.fallback) + " })"
            on Expr.to_non_nil as tnn
                # a helper: V smart-casts a name after a nil check and refuses `or`
                # on it; and a smart-cast sum type passed to the helper's `?T`
                # fails at V's C stage, so the option is cast explicitly when the
                # emitter knows the type
                branch tnn.expr
                    on Expr.ident as nid
                        if .isNarrowed(nid.name)
                            return .exprStr(tnn.expr)   # a narrowed name reads as its unwrap already
                    on Expr.member as nm
                        if exprRootIsThis(nm.object) and .isNarrowed("self." + vSafe(nm.member))
                            return .exprStr(tnn.expr)
                    else
                        pass
                var ot: str = .vTypeOf(tnn.expr)
                if ot.startsWith("?")
                    return .narrowedRead(.exprStr(tnn.expr), "a value", ot, .current_file + ":" + tnn.span.line.toString())
                return "zunwrap_at(" + .exprStr(tnn.expr) + ", " + .vStringLit(.current_file + ":" + tnn.span.line.toString()) + ")"
            on Expr.dict_lit as dl
                .refuse("a dict literal (maps are next)", dl.span)
                return "map[string]i64{}"
            on Expr.try_ as t
                if .vTypeOf(t.expr).startsWith("!?")
                    return "zopt_of(" + .exprStr(t.expr) + "!)"   # a nilable-and-throws callee: the wrapper opened
                return .exprStr(t.expr) + "!"
            on Expr.char_lit as cl
                return .charLitStr(cl.text)
            on Expr.slice as sl
                var a: str = ""
                var b: str = ""
                if sl.start as st
                    a = .exprStr(st)
                if sl.stop_ as sp
                    b = .exprStr(sp)
                return .exprStr(sl.object) + "[int(" + a + ")..int(" + b + ")]"   # int bounds: an i64 bound panics in range under MSVC, with or without -prod (vlang/v#30352)
            on Expr.cast as ca
                if .vTypeOf(ca.expr) == "&ZJson"
                    return .coerced(ca.expr, .vType(ca.target))
                return .vType(ca.target) + "(" + .exprStr(ca.expr) + ")"
            on Expr.chained_cmp as cc
                # a < b < c -> (a < b) && (b < c); the middle operands are spelled twice
                var out: str = "("
                var i: int = 0
                while i < cc.ops.count()
                    if i > 0
                        out = out + " && "
                    out = out + "(" + .exprStr(cc.operands.at(i)) + " " + cc.ops.at(i) + " " + .exprStr(cc.operands.at(i + 1)) + ")"
                    i = i + 1
                return out + ")"
            on Expr.lambda as lam
                return .lambdaStr(lam)
            on Expr.tuple_lit as tl
                if tl.elems.count() < 2 or tl.elems.count() > 3
                    .refuse("a tuple literal of " + tl.elems.count().toString() + " (the runtime spells 2 and 3)", tl.span)
                    return "0"
                var fields: str = ""
                var fi: int = 0
                for el in tl.elems
                    if fi > 0
                        fields = fields + ", "
                    fields = fields + "f" + fi.toString() + ": " + .exprStr(el)
                    fi = fi + 1
                return "ZTuple" + tl.elems.count().toString() + "{" + fields + "}"   # (V infers the type arguments from the fields)
            on Expr.set_lit as stl
                # `{4, 5}`: the runtime's boxed set of the declared element type,
                # else the first element's when the emitter knows it
                var set_t: str = ""
                if stl.elem_type as sett
                    set_t = .vType(sett)
                if set_t == "" and stl.elems.count() > 0
                    var sfirst = stl.elems.at(0)
                    set_t = .vTypeOf(sfirst)
                    if set_t == "" and isStringLit(sfirst)
                        set_t = "string"
                    if set_t == "" and isIntLit(sfirst)
                        set_t = "i64"
                    if set_t == "" and isFloatLit(sfirst)
                        set_t = "f64"
                if set_t == ""
                    .refuse("a set literal whose element type the V route cannot tell (declare it: `Set(int)`)", stl.span)
                    return "new_zset[i64]()"
                var set_out: str = "zset_of[" + set_t + "](["
                var set_first: bool = true
                for sel in stl.elems
                    if not set_first
                        set_out = set_out + ", "
                    set_first = false
                    set_out = set_out + .coerced(sel, set_t)
                return set_out + "])"
            on Expr.array_lit as al
                .refuse("an array literal", al.span)
                return "0"
            on Expr.zig_lit as zl
                if zl.text == "_error_ctx.message"
                    return "err.msg()"   # the compiler's own idiom for the caught error's message (inside a catch: V's err)
                if zl.text == "_zbr_version"
                    return "zbr_version"   # the compiler's own version string: a runtime const on this backend
                if zl.text == "builtin.zig_version_string"
                    return "'(no Zig: the V backend)'"
                if zl.text == "builtin.target.os.tag == .macos"
                    return "(os.user_os() == 'macos')"
                if zl.text == "@as([]const u8, @tagName(builtin.target.cpu.arch))"
                    return "zsys_arch()"
                if zl.text == "@as(i64, @intCast(std.os.windows.GetCurrentProcessId()))"
                    return "i64(os.getpid())"
                if zl.text == "_zbr_sweep_pending()" or zl.text == "@as(i64, @intCast(_zbr_sweep_pending()))"
                    return "zsweep_pending()"   # free-at-sweep: the queue's length (kept on this route, nothing freed)
                .refuse("a zig literal (Zig-backend code; no V for it)", zl.span)
                return "0"
            on Expr.opt_chain as oc
                # `a?.b` / `a?.m(args)`: nil when the base is, else the member or the
                # call, through V's if-guard as an expression -- V infers the option
                # from the arms, and an arm that is an option already stays one level
                # (`j.tryObj("a")?.tryInt("b")` is `?i64`, as Zebra types it). The
                # unwrapped base is a temporary local typed as the base's inner type,
                # so the member or the call is spelled as on any local.
                var bt: str = .vTypeOf(oc.base)
                if bt != "" and not bt.startsWith("?")
                    # the base is not nilable here (narrowed, or never was): the plain access
                    var bv: Expr = oc.base
                    var pm = ExprMember(oc.span, bv, oc.member)
                    if oc.has_args
                        return .methodCallStr(pm, oc.args, oc.span)
                    return .memberStr(pm)
                .tmpN = .tmpN + 1
                var tmp: str = "zoc" + .tmpN.toString()
                .local_names.add(tmp)
                if bt != ""
                    .local_types.set(tmp, bt.substring(1, bt.len))
                var tmem = ExprMember(oc.span, Expr.ident(ExprIdent(oc.span, tmp)), oc.member)
                var tail: str = ""
                if oc.has_args
                    tail = .methodCallStr(tmem, oc.args, oc.span)
                else
                    tail = .memberStr(tmem)
                var base_s: str = .exprStr(oc.base)
                if .in_cond
                    # a loop's condition: nothing can be bound before it; the inline
                    # form, which V takes when the base is a name or a call
                    return "(if " + tmp + " := " + base_s + " { " + tail + " } else { none })"
                # V's if-guard takes a call or a name, and `or { }` follows a call or a
                # name: the base is bound first, then the guarded read, on lines
                # before the statement; the expression is the read's name (an
                # `orelse` on it, a further `?.` on it, are then V's own forms)
                .tmpN = .tmpN + 1
                var basen: str = "zocb" + .tmpN.toString()
                .line(basen + " := " + base_s)
                .local_names.add(basen)
                if bt != ""
                    .local_types.set(basen, bt)
                .tmpN = .tmpN + 1
                var resn: str = "zocr" + .tmpN.toString()
                var rt: str = .vTypeOf(Expr.opt_chain(oc))
                # the else arm: a bare `none` when the read is a plain value (V
                # infers the option; a cast there is refused as `int` against
                # `?int`), the read's own option type spelled when the read is an
                # option already (V did not unify a bare `none` with `?&ZList[...]`)
                var ort: str = ""
                if oc.has_args
                    ort = .vTypeOf(Expr.call(ExprCall(oc.span, Expr.member(tmem), oc.args)))
                else
                    ort = .vTypeOf(Expr.member(tmem))
                var none_s: str = "none"
                if ort.startsWith("?")
                    none_s = ort + "(none)"
                .line(resn + " := if " + tmp + " := " + basen + " { " + tail + " } else { " + none_s + " }")
                .local_names.add(resn)
                if rt != ""
                    .local_types.set(resn, rt)
                return resn
            on Expr.old_ as ol
                .refuse("an `old` expression (contracts)", ol.span)
                return .exprStr(ol.operand)
            on Expr.except_ as ex
                return .exceptStr(ex)
            on Expr.result_ as rs
                .refuse("`result` (contracts)", rs)
                return "0"
            on Expr.catch_ as c
                # `expr catch |e| fallback` -> `(expr or { e := err  fallback })`:
                # the or block's last expression is its value
                # a nilable-and-throws callee yields the `ZOpt[T]` wrapper, so the fallback
                # (a `?T`) is wrapped to match and the whole is opened back to `?T` (BUG-690)
                var cxt: str = .vTypeOf(c.expr)
                if cxt.startsWith("!?") and not isNilLit(c.fallback)
                    var inner: str = cxt.substring(2, cxt.len)
                    var bind: str = ""
                    var bound: bool = false
                    if c.err_var as ev2
                        .catch_bindings.add(vSafe(ev2))
                        bind = vSafe(ev2) + " := err\n_ = " + vSafe(ev2) + "\n"
                        bound = true
                    var wrapped = "zopt_of(" + .exprStr(c.expr) + " or {\n" + bind + "zopt_from[" + inner + "](" + .exprStr(c.fallback) + ")\n})"
                    if bound
                        .catch_bindings = dropLast(.catch_bindings)
                    return wrapped
                if c.err_var as ev
                    .catch_bindings.add(vSafe(ev))
                    var out = "(" + .exprStr(c.expr) + " or {\n" + vSafe(ev) + " := err\n_ = " + vSafe(ev) + "\n" + .exprStr(c.fallback) + "\n})"
                    .catch_bindings = dropLast(.catch_bindings)
                    return out
                if isNilLit(c.fallback)
                    # `f() catch nil`: the result as an option. V takes no result type as
                    # a generic argument (no helper), and its C stage miscompiles an
                    # if-expression over a result guard with a `none` arm (tuon_data_test,
                    # 2026-10-15): the option is declared by its type on a line before
                    # the statement and set inside a guard; the expression is its name
                    var crt: str = .vTypeOf(c.expr)
                    .tmpN = .tmpN + 1
                    var zr: str = "zr" + .tmpN.toString()
                    # a nilable-and-throws callee (`!?T`, spelled `!ZOpt[T]`): its value is
                    # the wrapper, opened with zopt_of, and the option is `?T` -- not `??T`,
                    # which V does not parse (BUG-690, from the engine's guiscene.zbr)
                    var nilable: bool = crt.startsWith("!?")
                    var opened: str = zr + "v"
                    if nilable
                        opened = "zopt_of(" + zr + "v)"
                    if crt.startsWith("!") and not .in_cond
                        var cot: str = "?" + crt.substring(1, crt.len)
                        if nilable
                            cot = crt.substring(1, crt.len)
                        .line("mut " + zr + " := " + cot + "(none)")
                        .local_names.add(zr)
                        .local_types.set(zr, cot)
                        .line("if " + zr + "v := " + .exprStr(c.expr) + " {")
                        .line("\t" + zr + " = " + opened)
                        .line("}")
                        return zr
                    if nilable
                        return "(if " + zr + "v := " + .exprStr(c.expr) + " { zopt_of(" + zr + "v) } else { none })"
                    return "(if " + zr + " := " + .exprStr(c.expr) + " { " + zr + " } else { none })"
                return "(" + .exprStr(c.expr) + " or { " + .exprStr(c.fallback) + " })"
            else
                .refused.add("an expression kind the subset does not spell")
                return "0"

    # `c'A'` -> rune(`A`): Zebra's char is a codepoint, V's rune (BUG-712; it was u8(`A`)
    # while this route's char was a byte). The cast is kept: it is what a match range arm
    # takes, and it says the type where V would infer one. `\u{HEX}` and `\xHH` are spelled
    # as the number: V's own escapes differ, and an escape char (\u{DC80}..\u{DCFF}, the
    # only surrogates the lexer lets through) has no V literal at all.
    # (the AST keeps the raw text, c-prefix and quotes included)
    def charLitStr(text: str): str
        var inner: str = text
        if (inner.startsWith("c'") and inner.endsWith("'") or inner.startsWith("c\"") and inner.endsWith("\"")) and inner.len >= 3
            inner = inner.substring(2, inner.len - 1)
        else if inner.startsWith("'") and inner.endsWith("'") and inner.len >= 2
            inner = inner.substring(1, inner.len - 1)
        if inner.startsWith("\\u{") and inner.endsWith("}")
            return "rune(0x" + inner.substring(3, inner.len - 1) + ")"
        if inner.startsWith("\\x") and inner.len == 4
            return "rune(0x" + inner.substring(2, 4) + ")"
        if inner == "\\0"
            return "rune(0)"
        if inner == "\\'"
            inner = "'"
        if inner == "\\\""
            inner = "\""
        if inner == "`"
            inner = "\\`"
        return "rune(`" + inner + "`)"

    # A byte where a char is wanted (`def peek(): char` returning `src[pos]`, a byte kept
    # in a `var c: char`): Zebra widens it, the char U+0000..U+00FF with that number. V does
    # not convert u8 to rune by itself in every position, so the emitter says it.
    def asChar(e: Expr, rendered: str, want: str): str
        if want == "rune" and .vTypeOf(e) == "u8"
            return "rune(" + rendered + ")"
        return rendered

    # a lambda as V's anonymous function, its captures listed (V captures by
    # value unless `mut`; a captured container or class is a reference anyway)
    def lambdaStr(lam: ExprLambda): str
        var caps: str = ""
        for cv in lam.captures
            # `capture var rc: T = this`: V captures a variable of the enclosing
            # scope, so the capture is declared there first (a line before the
            # statement holding the lambda)
            var cname: str = vSafe(cv.name)   # the captured variable's V name
            if cv.init_expr as cie
                var same: bool = false
                branch cie
                    on Expr.ident as cid
                        same = cid.name == cv.name   # `capture var b = b`: the local itself
                    else
                        pass
                if same
                    if .renames.get(cv.name) as rn
                        cname = rn   # the local itself under its V name (renamed off a function or a global)
                if not same
                    # a reference is declared through its pointer cast: inside a
                    # closure capturing `[mut self]` (a try block's body), a bare
                    # `mut demo := self` copies the struct (vlang/v#30348)
                    var cinit: str = .exprStr(cie)
                    var cvt0: str = .vType(cv.type_)
                    if cvt0.startsWith("&") and not cvt0.startsWith("&Z")
                        cinit = cvt0 + "(" + cinit + ")"
                    if .isLocalName(cv.name)
                        .line(vSafe(cv.name) + " = " + cinit)   # a name a capture already declared
                    else
                        .line("mut " + vSafe(cv.name) + " := " + cinit)
            else
                .refuse("a capture without a value (" + cv.name + ")", cv.span)
            .local_names.add(cv.name)
            var cvt: str = .vType(cv.type_)
            if cvt != ""
                .local_types.set(cv.name, cvt)
            if caps != ""
                caps = caps + ", "
            if .isRefType(cv.type_)
                caps = caps + "mut " + cname
            else
                caps = caps + cname
        var capList: str = ""
        if caps != ""
            capList = "[" + caps + "] "
        var ret = .vType(lam.return_type)
        var head = "fn " + capList + "(" + .genParams(lam.params) + ")"
        if ret != ""
            head = head + " " + ret
        var saved_locals = .local_names.copy()   # (a container is a reference: the restore needs its own copy)
        for p in lam.params
            .local_names.add(p.name)
        var body: str = ""
        branch lam.body_
            on LambdaBody.expr_ as e
                body = "\n\treturn " + .exprStr(e) + "\n"
            on LambdaBody.stmts as sts
                # the statements through a nested writer: the lines are joined
                var inner = .cloneContext()
                inner.depth = 1
                inner.genStmts(sts)
                for r in inner.refused
                    .refused.add(r)
                .rt_unverified = .rt_unverified + inner.rt_unverified
                .arith_unchecked = .arith_unchecked + inner.arith_unchecked
                body = "\n" + inner.sb.build()
        .local_names = saved_locals
        return head + " {" + body + "}"

    # "text" -> 'text' with V's escapes: a $ or a ' inside is escaped
    def vStringLit(text: str): str
        return "'" + .vEscape(text) + "'"

    # a doc string: the delimiters off, the newline after the opening one off
    # (the Zig backend's genDocStringLit), the content literal
    def vDocStringLit(text: str): str
        var parts: List(str) = text.split("\"\"\"")
        var content: str = ""
        if parts.count() >= 2
            content = parts.at(1)
        if content.startsWith("\n")
            content = content.substring(1, content.len)
        return .vLiteralText(content)

    # text taken byte for byte: a backslash, a quote and a dollar escaped for
    # V's single-quoted literal (a newline byte may stand in one)
    def vLiteralText(text: str): str
        var out: str = "'"
        var i: int = 0
        var n: int = text.len
        while i < n
            var ch = text[i]
            if ch == '\\'
                out = out + "\\\\"
            else if ch == '\''
                out = out + "\\'"
            else if ch == '$'
                out = out + "\\$"
            else
                out = out + text.substring(i, i + 1)
            i = i + 1
        return out + "'"

    # the text of a Zebra string (its escapes raw, as the lexer keeps them)
    # as V's: `\"` is a plain quote, `\$` stays one escape (not an escaped
    # backslash before an interpolation), a `$` or `'` is escaped
    def vEscape(text: str): str
        var out: str = ""
        var i: int = 0
        var n: int = text.len
        while i < n
            var ch = text[i]   # (a byte: compared with a char literal, appended as a one-byte substring)
            if ch == '\\' and i + 1 < n
                var nx = text[i + 1]
                var step: int = 2
                if nx == '"'
                    out = out + "\""
                else if nx == '$'
                    out = out + "\\$"
                else if nx == '\''
                    out = out + "\\'"
                else if nx == 'u' and i + 2 < n and text[i + 2] == '{'
                    # a code point in braces (the Zig route's spelling, which a Zebra
                    # string may carry: backslash, u, {1F600}) is V's backslash-u with
                    # four hex digits or backslash-U with eight; passed on as written,
                    # V refused the brace (2026-11-16)
                    var close: int = i + 3
                    while close < n and text[close] != '}'
                        close = close + 1
                    var hex: str = text.substring(i + 3, close)
                    if close < n and hex.len >= 1 and hex.len <= 4
                        out = out + "\\u" + "0000".substring(0, 4 - hex.len) + hex
                        step = close + 1 - i
                    else if close < n and hex.len >= 5 and hex.len <= 8
                        out = out + "\\U" + "00000000".substring(0, 8 - hex.len) + hex
                        step = close + 1 - i
                    else
                        out = out + "\\u"   # not a code point V can spell: as written, and V's error names it
                else
                    out = out + "\\" + text.substring(i + 1, i + 2)
                i = i + step
            else
                if ch == '$'
                    out = out + "\\$"
                else if ch == '\''
                    out = out + "\\'"
                else
                    out = out + text.substring(i, i + 1)
                i = i + 1
        return out

    # the fast path's test: every hole a float (f64 by vTypeOf) followed by an explicit `.Nf`
    # spec, one to twelve holes, no other format parts -- then the whole interpolation is one
    # formatted write through the runtime's zfmt_f (one snprintf, one copy) instead of V's
    # str_intp, which makes a heap string per formatted value (the memory-model note's fix (1),
    # 2026-10-23: the engine's GUI commands, ten floats each, cost 30 MB a window that way).
    # Anything else keeps V's interpolation: no spelling changes where printf and V could differ.
    def vInterpFloatsOnly(si: ExprStringInterp): bool
        var holes: int = 0
        var i: int = 0
        var n: int = si.parts.count()
        while i < n
            var part = si.parts.at(i)
            branch part
                on StringPart.literal
                    pass
                on StringPart.expr_ as ex
                    if .vTypeOf(ex) != "f64"
                        return false
                    if i + 1 >= n
                        return false
                    var nxt = si.parts.at(i + 1)
                    var okSpec: bool = false
                    branch nxt
                        on StringPart.format as f
                            okSpec = isFixedFloatSpec(f)
                        else
                            pass
                    if not okSpec
                        return false
                    holes = holes + 1
                    i = i + 1   # the spec, taken with its hole
                on StringPart.format
                    return false   # a spec with no hole before it: the slow path says so
            i = i + 1
        return holes >= 1 and holes <= 12

    # the printf format and the values of a floats-only interpolation
    def vInterpFmt(si: ExprStringInterp): str
        var fmt: str = ""
        var vals: str = ""
        var i: int = 0
        var n: int = si.parts.count()
        while i < n
            var part = si.parts.at(i)
            branch part
                on StringPart.literal as lit
                    fmt = fmt + .vEscape(lit).replace("%", "%%")
                on StringPart.expr_ as ex
                    var spec: str = ""
                    var nxt = si.parts.at(i + 1)
                    branch nxt
                        on StringPart.format as f
                            spec = f
                        else
                            pass
                    fmt = fmt + "%" + spec
                    if vals != ""
                        vals = vals + ", "
                    vals = vals + "f64(" + .exprStr(ex) + ")"
                    i = i + 1
                on StringPart.format
                    pass
            i = i + 1
        return "zfmt_f('" + fmt + "', [" + vals + "])"

    # A hole with a format spec whose V type the emitter knows (an integer, a float, a str,
    # a char with a width): the V expression that is the hole's text, built by the runtime.
    # V's own interpolation knows no `>`, `<`, `^`, no fill character and no space sign, and
    # it does not refuse them (vlang/v#32420): `'${n:>3}'` compiles and prints n, spec dropped
    # (2026-11-16: 21 of 37 holes differed from the Zig route that way, and `${f:8.2f}` did
    # not compile). So the spec is read here by the Zig route's own parser (parseFmtSpec:
    # one grammar, not two) and the same decisions are taken as CodeGen takes --
    # floatPrecArgs, zeroPadArgs, intSignArg, zigFmtSpec -- over runtime functions that
    # write the Zig route's text: zfmt_itext (BUG-725's sign), zfmt_zpad (BUG-631's zeros
    # after the sign), zfmt_one (the exact fixed-point digits), zshow_f (a float with a
    # spec and no precision is the bare hole's text, "2.0": BUG-760), zfmt_radix, zfmt_pad.
    # What the checker warns as ignored (`#`,
    # digit grouping, a sign on a float, `%`) is ignored here too, since the parser skips
    # it. What this route cannot write is refused by name: an exponent type, a float
    # precision over 9, a precision or a float type on an integer.
    # Returns "" for a hole the branches of vInterp own: a char's `c` / `x` / `X` / `d`, an
    # int's bare `c`, and a value whose type the emitter does not know -- where a spec V
    # would drop is refused, and any other is spliced as V's own, as before.
    # test/v_format_specs_test.zbr is the witness, compared line for line across the routes.
    def vSpecHole(ex: Expr, spec: str): str
        var t: str = .vTypeOf(ex)
        var e: str = .exprStr(ex)
        var parts = parseFmtSpec(spec)
        var fill: str = parts.at(0)
        var align: str = parts.at(1)
        var width: str = specWidth(parts.at(2))
        var prec: str = parts.at(3)
        var ty: str = parts.at(4)
        var sign: str = parts.at(5)
        var zero: bool = align == "="
        # the integer types this route has: int (i64) and byte (u8). The sized ints are not
        # mapped on this route at all (BUG-534's family): a hole over one has no known type
        var signed: bool = vIntKind(t) == 1      # BUG-761: every mapped width, not int and byte alone
        var unsigned: bool = vIntKind(t) == 2
        var body: str = ""
        var sign_aware: bool = false   # the `0` flag puts its zeros after a sign
        if signed or unsigned
            if spec == "c"
                return ""
            if prec != ""
                return .specRefused(spec, e, "a precision on an integer")
            if ty == "" or ty == "d" or ty == "i" or ty == "n"
                sign_aware = true
                if unsigned
                    body = "u64(" + e + ").str()"
                else if not zero and (width != "" or sign == "+" or sign == " ")
                    body = "zfmt_itext(i64(" + e + "), " + specSignCode(sign) + ")"
                else
                    body = "i64(" + e + ").str()"   # with the 0 flag a sign flag is dropped, as the Zig route's _zbr_zpad drops it (the checker warns)
            else if ty == "x" or ty == "X" or ty == "o" or ty == "b"
                var base: str = "16"
                if ty == "o"
                    base = "8"
                else if ty == "b"
                    base = "2"
                var upper: str = "false"
                if ty == "X"
                    upper = "true"
                var bits_of: str = "u64(" + e + ")"
                if signed and t != "i64"
                    bits_of = "u64(u" + vIntBits(t).toString() + "(" + e + "))"   # a narrow signed value's own bits: an int8 -3 is fd, not ffff...fd
                body = "zfmt_radix(" + bits_of + ", " + base + ", " + upper + ")"   # the bits, unsigned, as the Zig route's @bitCast prints them (-1 is ffffffffffffffff)
            else
                return .specRefused(spec, e, "the type `" + ty + "` on an integer (mapped: none, d, i, n, x, X, o, b, and a bare c)")
        else if t == "f64" or t == "f32"
            if ty == "e" or ty == "E"
                return .specRefused(spec, e, "the exponent type `" + ty + "` on a float")
            if ty == "s" or ty == "c" or ty == "u" or ty == "x" or ty == "X" or ty == "o" or ty == "b"
                return .specRefused(spec, e, "the type `" + ty + "` on a float")
            sign_aware = true
            if prec.len >= 2
                if prec.len != 2
                    return .specRefused(spec, e, "a float precision over 9")
                body = "zfmt_one(f64(" + e + "), " + prec.substring(1, 2) + ")"
            else
                body = "zshow_f(f64(" + e + "))"   # BUG-760: the bare hole's text, then the pad (until then Zig's {d}, which dropped a whole value's ".0")
                if t == "f32"
                    body = "zshow_f32(" + e + ")"   # BUG-768: a float32's own digits (widened, 0.1 reads 0.10000000149011612)
        else if t == "string"
            if prec != "" or sign != "" or (ty != "" and ty != "s")
                return .specRefused(spec, e, "on a str (mapped: a fill, an alignment, a width, s)")
            body = e
        else if t == "rune"
            if width == "" or prec != "" or sign != "" or (ty != "" and ty != "c" and ty != "u")
                return ""
            body = "zchar_str(" + e + ")"
        else
            if align == "<" or align == ">" or align == "^" or sign == " "
                return .specRefused(spec, e, "on a value whose type this route does not know (V's interpolation would drop the spec without a word: annotate the value)")
            return ""
        if zero and sign_aware
            if width == ""
                return body
            return "zfmt_zpad(" + body + ", " + width + ")"
        if width == ""
            return body
        var kind: str = align
        if kind == "" or kind == "="
            kind = ">"
        var fill_code: str = "32"
        if fill != ""
            fill_code = fill[0].toString()
        return "zfmt_pad(" + body + ", " + width + ", `" + kind + "`, " + fill_code + ")"

    # a spec this route cannot write: said in the refusals, the hole left bare
    def specRefused(spec: str, e: str, why: str): str
        .refused.add("a format spec (" + spec + "): " + why)
        return e

    # an interpolation with a hole is a string V builds: the open allocate
    # block's (zr_s); a literal with no hole is static and is not
    def vInterp(si: ExprStringInterp): str
        if .vInterpFloatsOnly(si)
            return "zr_s(" + .vInterpFmt(si) + ")"
        var out: str = "'"
        var holes: int = 0
        var i: int = 0
        var n: int = si.parts.count()
        while i < n
            var part = si.parts.at(i)
            branch part
                on StringPart.literal as lit
                    out = out + .vEscape(lit)
                on StringPart.expr_ as ex
                    holes = holes + 1
                    # a float hole with a fixed spec goes through the runtime's zfmt_one
                    # here too, so a float is spelled the same whatever its neighbours
                    # (the Zig backend's digits; V's str_intp differs on ties and specials)
                    var spec: str = ""
                    if i + 1 < n
                        var nxt = si.parts.at(i + 1)
                        branch nxt
                            on StringPart.format as f0
                                spec = f0
                            else
                                pass
                    # a spec'd hole of a known number, str or char type is text the runtime
                    # builds (vSpecHole): V's own interpolation drops a spec it does not know
                    var held: str = ""
                    if spec != ""
                        held = .vSpecHole(ex, spec)
                    if held != ""
                        out = out + "\${" + held + "}"
                        i = i + 1   # the spec, taken with its hole
                    else if .vTypeOf(ex) == "f64"
                        # a bare float hole: the Zig backend's _zbr_show_float spelling (the
                        # shortest digits, never an exponent, ".0" when whole), not V's str()
                        out = out + "\${zshow_f(" + .exprStr(ex) + ")}"
                    else if .vTypeOf(ex) == "f32"
                        out = out + "\${zshow_f32(" + .exprStr(ex) + ")}"   # BUG-768: the float32's own shortest digits
                    else if spec == "c" and .vTypeOf(ex) == "i64"
                        # `${n:c}` on an int: ONE byte, n as toUint8 would take it (BUG-713:
                        # V's own :c writes the int as a codepoint, UTF-8 encoded)
                        out = out + "\${zbyte_str(" + .exprStr(ex) + ")}"
                        i = i + 1
                    else if .vTypeOf(ex) == "rune" and (spec == "" or spec == "c")
                        out = out + "\${zchar_str(" + .exprStr(ex) + ")}"
                        if spec != ""
                            i = i + 1
                    else if .vTypeOf(ex) == "rune" and (spec == "x" or spec == "X" or spec == "d")
                        out = out + "\${i64(" + .exprStr(ex) + "):" + spec + "}"   # the codepoint, as a number (i64: V refuses :d on a u32)
                        i = i + 1
                    else if .vTypeOf(ex) == "rune"
                        .refused.add("a format spec (" + spec + ") on a char (mapped: none, c, x, X, d and a width)")
                        out = out + "\${zchar_str(" + .exprStr(ex) + ")}"
                        i = i + 1
                    else if spec == "" and .vTypeOf(ex) == "&ZJson"
                        out = out + "\${zjson_stringify(" + .exprStr(ex) + ")}"   # a JsonValue in a hole: its JSON text
                    else if spec == "" and .isContainerType(.vTypeOf(ex))
                        # a container in a hole: the Zig route's spelling (BUG-723)
                        out = out + "\${" + .showContainer(.vTypeOf(ex), .exprStr(ex)) + "}"
                    else if spec == "" and .isShownType(.vTypeOf(ex))
                        # a class or a struct in a hole: its text, never V's `&` before a reference (BUG-746)
                        out = out + "\${" + .showValue(.vTypeOf(ex), .exprStr(ex)) + "}"
                    else if spec == "" and .isShownOptional(.vTypeOf(ex))
                        # an optional in a hole: `nil` or the value's own text, never V's `Option(...)`
                        out = out + "\${" + .showFn(.vTypeOf(ex), false) + "(" + .exprStr(ex) + ")}"
                    else
                        out = out + "\${" + .exprStr(ex) + "}"
                on StringPart.format as f
                    # a format spec FOLLOWS its expression in the parts: spliced
                    # into the `${...}` just emitted (V's own spelling, `${x:.4f}`)
                    if out.endsWith("}")
                        out = out.substring(0, out.len - 1) + ":" + f + "}"
                    else
                        .refused.add("a format spec (" + f + ") with no expression before it")
            i = i + 1
        if holes > 0
            return "zr_s(" + out + "')"
        return out + "'"

    # a list literal's element type: the declared one, else the first
    # element's when the emitter knows it; "" when neither
    def listLitElemType(ll: ExprListLit): str
        var et: str = ""
        if ll.elem_type as t
            et = .vType(t)
        if et == "" and ll.elems.count() > 0
            var first = ll.elems.at(0)
            et = .vTypeOf(first)
            if et == "" and isStringLit(first)
                et = "string"
            if et == "" and isIntLit(first)
                et = "i64"
            if et == "" and isFloatLit(first)
                et = "f64"
            if et == "" and isBoolLit(first)
                et = "bool"
        return et

    # a SQLite bind list: the runtime binds text (V's db.sqlite takes []string and the
    # column's affinity converts), and a Zebra bind list is mixed by nature
    # (`[1, "alice"]`), which no ZList[T] holds -- so a literal is rendered element by
    # element as its text. Anything else is taken as the List(str) it must then be.
    def sqliteParamsStr(e: Expr): str
        branch e
            on Expr.list_lit as ll
                if ll.elems.count() == 0
                    return "new_zlist[string]()"
                var out: str = "zlist_of[string](["
                var first: bool = true
                for el in ll.elems
                    if not first
                        out = out + ", "
                    first = false
                    var t: str = .vTypeOf(el)
                    if t == "string" or isStringLit(el)
                        out = out + .exprStr(el)
                    else if t == "f64" or isFloatLit(el)
                        out = out + "zshow_f(" + .exprStr(el) + ")"
                    else
                        out = out + "(" + .exprStr(el) + ").str()"
                return out + "])"
            else
                return .exprStr(e)

    def listLitStr(ll: ExprListLit): str
        var et: str = .listLitElemType(ll)
        if et == ""
            .refused.add("a list literal without an element type (write `var xs: List(T) = [...]`)")
            return "new_zlist[i64]()"
        return .listLitWith(Expr.list_lit(ll), et)

    # a list literal as the runtime's boxed list of a known element type
    def listLitWith(e: Expr, et: str): str
        branch e
            on Expr.list_lit as ll
                if ll.elems.count() == 0
                    return "new_zlist[" + et + "]()"
                var out: str = "zlist_of[" + et + "](["
                var first: bool = true
                for el in ll.elems
                    if not first
                        out = out + ", "
                    first = false
                    if et == "i64" and isIntLit(el)
                        out = out + "i64(" + .exprStr(el) + ")"
                    else if .isUnionName(et)
                        out = out + et + "(" + .exprStr(el) + ")"   # a sum type's element: cast, or V infers the first variant
                    else
                        out = out + .exprStr(el)
                return out + "])"
            else
                return .exprStr(e)

    # `.x` on this -> self.x; `a.len` (a property) -> a.len; else a.b
    def memberStr(m: ExprMember): str
        var owner: str = .staticOwner(m.object)
        if owner == "Math" and m.member == "PI"
            return "math.pi"
        if .isEnumName(owner)
            return owner + "." + vSafe(m.member)
        if .isUnionName(owner)
            # a payload-less variant as a value, spelled as the sum type: into a
            # generic parameter V keeps the variant's own type (`g.button[T]` with
            # T = Msg_inc), and a run loop reading it back as Msg read garbage
            # (the libui PoC, 2026-10-14); everywhere else the wrap is a no-op
            return owner + "(" + owner + "_" + m.member + "{})"
        if .isModuleIdent(m.object)
            return vSafe(m.member)   # `Mod.name`: the used module's declaration, in this file
        var obj = .exprStr(m.object)
        var ot: str = .vTypeOf(m.object)
        if isDigits(m.member)
            return obj + ".f" + m.member   # a tuple's element by position
        if .isUnionName(ot) and .union_payloads.get(ot + "_" + m.member) != nil
            return "(" + obj + " as " + ot + "_" + m.member + ").payload" + .unbox(ot + "_" + m.member)   # Zebra's payload access by the variant's name
        if m.member == "len"
            if .isContainerType(ot)
                return obj + ".count()"   # Zebra's `.len` on a container
            return obj + ".len"
        if m.member == "message" and .isCatchBinding(obj)
            return obj + ".msg()"   # V's IError
        var plain: str = obj + "." + vSafe(m.member)
        if exprRootIsThis(m.object) and .isNarrowed(plain)
            if .field_types.get(m.member) as nft
                return .narrowedRead(plain, m.member, nft, .current_file + ":" + m.span.line.toString())   # Zebra reads the field narrowed
        return plain

    def isCatchBinding(name: str): bool
        for b in .catch_bindings
            if b == name
                return true
        return false

    # a call of this name on a receiver of this type mutates it: a class's
    # or a mutating struct's any method, a container's writers
    def mutatesReceiver(rtype: str, name: str): bool
        if rtype.startsWith("&ZList[") or rtype.startsWith("&ZMap[") or rtype.startsWith("&ZSet[") or rtype == "&ZStringBuilder" or rtype == ""
            return name == "add" or name == "set" or name == "put" or name == "clear" or name == "remove" or name == "removeAt" or name == "insert" or name == "append" or name == "appendChar" or name == "sort" or name == "sortBy" or name == "reverse" or name == "pop"
        if rtype.startsWith("&")
            return true
        return .isMutStruct(rtype)

    # a bare name whose type is a reference or an option of one (a parameter
    # or a local): kept in a field only through `unsafe { }`
    def isRefParamName(e: Expr): bool
        branch e
            on Expr.ident as id
                if .local_types.get(id.name) as lt
                    return lt.startsWith("&") or lt.startsWith("?&")
                return false
            else
                return false

    def isSigConflict(name: str): bool
        for c in .sig_conflicts
            if c == name
                return true
        return false

    def argsStr(args: List(Arg), callee: str = ""): str
        var sigOpt: FnSig? = nil
        if callee != "" and not .isSigConflict(callee)
            sigOpt = .sigs.get(callee)
        if sigOpt as fsig
            return .argsBySig(args, fsig, callee)
        # an unknown callee (the stdlib, a method the pass did not see): by position
        var out: str = ""
        var first: bool = true
        for a in args
            if not first
                out = out + ", "
            first = false
            if a.name != nil
                .refuse("a named argument (" + a.name! + ") to a callee the emitter has no signature for", a.span)
            out = out + .exprStr(a.value)
        return out

    # the arguments in the callee's order: a named argument to its parameter,
    # the unnamed ones in sequence to the rest, a missing one from its default
    def argsBySig(args: List(Arg), fsig: FnSig, callee: str = ""): str
        # a plan first, without rendering (rendering binds temporaries): a call
        # the signature cannot take -- more arguments than parameters, a named
        # one it lacks, a missing one without a default -- was matched by NAME to
        # another declaration's signature; Zebra's checker accepted the real
        # callee, so the arguments go by position
        if not .sigFits(args, fsig)
            return .positionalArgs(args, fsig)
        var slots = List(str)()
        var filled = List(bool)()
        for n in fsig.names
            slots.add("")
            filled.add(false)
        var pos: int = 0
        for a in args
            if a.name as an
                var k: int = 0
                var found: bool = false
                for n in fsig.names
                    if n == an
                        slots.set(k, .coerced(a.value, fsig.types.at(k)))
                        filled.set(k, true)
                        found = true
                    k = k + 1
                if not found
                    .refuse("a named argument (" + an + ") the callee has no parameter for", a.span)
            else
                while pos < fsig.names.count() and filled.at(pos)
                    pos = pos + 1
                if pos < fsig.names.count()
                    slots.set(pos, .coerced(a.value, fsig.types.at(pos)))
                    filled.set(pos, true)
                    pos = pos + 1
                else
                    .refuse("more arguments than the callee has parameters", a.span)
        var out: str = ""
        var i: int = 0
        while i < fsig.names.count()
            if i > 0
                out = out + ", "
            if not filled.at(i)
                if fsig.has_default.at(i)
                    slots.set(i, .exprStr(fsig.defaults.at(i)))
                else
                    .refused.add("a missing argument (" + fsig.names.at(i) + ") with no default in a call to " + callee + " (" + .current_file + ")")
                    slots.set(i, "0")
            if fsig.refs.at(i)
                var slot: str = slots.at(i)
                if slot.indexOf("(") >= 0 or slot.indexOf("[") >= 0 or (slot.indexOf(".") >= 0 and not slot.startsWith("self."))
                    # V takes `mut` on an lvalue only: a call's result (a fresh
                    # container, an element) is bound first; the line lands
                    # before the statement being built. A field path not rooted
                    # at self is bound too: V refuses `mut p.field` through an
                    # immutable parameter or binding, and a reference field
                    # copied is the same container
                    .tmpN = .tmpN + 1
                    var t = "zt" + .tmpN.toString()
                    .line("mut " + t + " := " + slot)
                    slots.set(i, t)
                out = out + "mut "
            out = out + slots.at(i)
            i = i + 1
        return out

    # an expression rendered for a place of a known type: a Json value
    # converts (Zebra's `var n: int = j["n"]?` reads by the receiving type)
    def coerced(e: Expr, want: str): str
        var want0: str = want
        if want0.startsWith("?")
            want0 = want0.substring(1, want0.len)
        var into_iface: bool = .isIfaceName(want0)
        if into_iface
            .iface_target = true
            .narrowed_or_used = false
        var s: str = .exprStr(e)
        if into_iface
            .iface_target = false
            if .narrowed_or_used and not .in_cond
                # two steps into the interface: the value bound to a local first --
                # master loses the method table when the `or` form sits in the
                # assignment inside a closure capturing [mut self] (vlang/v#30470)
                .tmpN = .tmpN + 1
                var tn: str = "zt" + .tmpN.toString()
                .line("mut " + tn + " := " + s)
                .local_names.add(tn)
                s = tn
            .narrowed_or_used = false
        if .vTypeOf(e) == "&ZJson"
            return coerceRendered(s, want)
        if .isSigName(want) and isLambdaExpr(e)
            return want + "(" + s + ")"   # the named function type: V instantiates generics by the lambda's anonymous type otherwise
        if vIntKind(want0) != 0 and not isIntLit(e)
            var have: str = .vTypeOf(e)
            if vIntKind(have) != 0 and have != want0
                return want0 + "(" + s + ")"   # BUG-761: a narrower integer into a wider slot, said (the checker let only a widening in)
        if vIsFloat(want0)
            # BUG-768: an integer or a narrower float into a float slot, said (V takes an i64
            # where an f64 is wanted, and refuses one where an f32 is)
            var fhave: str = .vTypeOf(e)
            if fhave != want0 and (vIsFloat(fhave) or vIntKind(fhave) != 0)
                return want0 + "(" + s + ")"
        return .asChar(e, s, want0)

    def sigFits(args: List(Arg), fsig: FnSig): bool
        var taken = List(bool)()
        for n in fsig.names
            taken.add(false)
        var pos: int = 0
        for a in args
            if a.name as an
                var found: bool = false
                var k: int = 0
                for n in fsig.names
                    if n == an
                        taken.set(k, true)
                        found = true
                    k = k + 1
                if not found
                    return false
            else
                while pos < fsig.names.count() and taken.at(pos)
                    pos = pos + 1
                if pos >= fsig.names.count()
                    return false
                taken.set(pos, true)
                pos = pos + 1
        var i: int = 0
        while i < fsig.names.count()
            if not taken.at(i) and not fsig.has_default.at(i)
                return false
            i = i + 1
        return true

    # the arguments in order, `mut` where the signature's position says so
    def positionalArgs(args: List(Arg), fsig: FnSig): str
        var out: str = ""
        var i: int = 0
        for a in args
            if i > 0
                out = out + ", "
            var s: str = .exprStr(a.value)
            if i < fsig.refs.count() and fsig.refs.at(i) and isNameExpr(a.value)
                out = out + "mut "
            out = out + s
            i = i + 1
        return out

    def callStr(c: ExprCall): str
        branch c.callee
            on Expr.member as m
                if .isModuleIdent(m.object) and not .isModuleClassStatic(m)
                    return .identCallStr(m.member, c.args)   # `Mod.Name(args)`: the used module's declaration
                return .methodCallStr(m, c.args, c.span)
            on Expr.ident as id
                return .identCallStr(id.name, c.args)
            on Expr.call as inner
                # List(T)() / HashMap(K, V)(): the runtime's constructors
                branch inner.callee
                    on Expr.ident as cid
                        if cid.name == "List" and inner.args.count() == 1
                            return "new_zlist[" + .typeArgStr(inner.args.at(0).value) + "]()"
                        if cid.name == "HashMap" and inner.args.count() == 2
                            return "new_zmap[" + .typeArgStr(inner.args.at(0).value) + ", " + .typeArgStr(inner.args.at(1).value) + "]()"
                        if cid.name == "Set" and inner.args.count() == 1
                            return "new_zset[" + .typeArgStr(inner.args.at(0).value) + "]()"
                        if cid.name == "Chan" and inner.args.count() == 1 and c.args.count() == 1
                            return "chan " + .typeArgStr(inner.args.at(0).value) + "{cap: int(" + .exprStr(c.args.at(0).value) + ")}"
                        if cid.name == "Atomic" and inner.args.count() == 1 and c.args.count() == 1
                            return "zatomic_new[" + .typeArgStr(inner.args.at(0).value) + "](" + .exprStr(c.args.at(0).value) + ")"
                    else
                        pass
                .refuse("a call on a call's result", c.span)
                return .exprStr(c.callee) + "(" + .argsStr(c.args) + ")"
            else
                .refuse("a call on an expression that is not a name or a member", c.span)
                return .exprStr(c.callee) + "(" + .argsStr(c.args) + ")"

    # `Mod.x(args)` where Mod is a used module AND a class of that name (Zebra's
    # `use Lexer` then `Lexer.tokenize(src)`): the class's static method --
    # unless x names a type (`Token.Token(...)` is the class's constructor)
    def isModuleClassStatic(m: ExprMember): bool
        branch m.object
            on Expr.ident as id
                if not (.isClassName(id.name) or .isStructName(id.name))
                    return false
                if .isClassName(m.member) or .isStructName(m.member) or .isUnionName(m.member) or .isEnumName(m.member)
                    return false
                return true
            else
                return false

    # a call on a bare name: a class or a struct constructed (Name(args) ->
    # new_name(args)), else a free function
    def identCallStr(name: str, args: List(Arg)): str
        if .isClassName(name) or .isStructName(name)
            return ctorName(name) + "(" + .argsStr(args, ctorName(name)) + ")"
        if name == "StringBuilder"
            return "new_zstring_builder()"
        if (name == "List" or name == "HashMap" or name == "Set") and args.count() == 0
            .refused.add("an untyped " + name + "() where the emitter does not know the target's type (a typed var or a field takes it)")
            return "new_zlist[i64]()"
        # a bare call naming a method of the enclosing class (Zebra allows it)
        if .in_method and .isMethodName(name)
            var mkey: str = "." + vSafe(name)
            if .sigs.get(.current_class + "." + vSafe(name)) != nil
                mkey = .current_class + "." + vSafe(name)
            return "self." + vSafe(name) + "(" + .argsStr(args, mkey) + ")"
        if .isStaticName(name)
            var skey: str = snakeCase(.current_class) + "_" + vSafe(name)
            return skey + "(" + .argsStr(args, skey) + ")"
        if .local_types.get(name) as lt
            if .sigs.get("sig:" + lt) != nil
                return .localName(name) + "(" + .argsStr(args, "sig:" + lt) + ")"   # a call through a function-typed value
        var fname: str = .freeFnName(name)
        if startsUpper(name) and not .isFnName(fname) and not .isEnumName(name) and not .isUnionName(name) and not .isIfaceName(name) and .rt_types.get(name) == nil
            .refused.add(name + "(...) (a type neither the program nor the V runtime declares: " + .current_file + ")")
        return fname + "(" + .argsStr(args, fname) + ")"

    # a type named as a constructor's argument (`List(int)`, `HashMap(str, Box)`)
    def typeArgStr(e: Expr): str
        branch e
            on Expr.ident as id
                return .vNamed(id.name)
            on Expr.member as mm
                if .isModuleIdent(mm.object)
                    return .vNamed(mm.member)   # `List(Mod.Name)`
                .refused.add("a type argument the subset does not spell (a member)")
                return "voidptr"
            on Expr.call as c
                # a nested container type: List(List(int))
                branch c.callee
                    on Expr.ident as cid
                        if cid.name == "List" and c.args.count() == 1
                            return "&ZList[" + .typeArgStr(c.args.at(0).value) + "]"
                        if cid.name == "HashMap" and c.args.count() == 2
                            return "&ZMap[" + .typeArgStr(c.args.at(0).value) + ", " + .typeArgStr(c.args.at(1).value) + "]"
                        if cid.name == "Set" and c.args.count() == 1
                            return "&ZSet[" + .typeArgStr(c.args.at(0).value) + "]"
                    else
                        pass
                .refused.add("a type argument the subset does not spell")
                return "voidptr"
            else
                .refused.add("a type argument the subset does not spell")
                return "voidptr"

    # the stdlib surface the subset maps by hand: str, List, Math, the conversions
    def methodCallStr(m: ExprMember, args: List(Arg), span: Span): str
        var name = m.member
        var isMath: bool = false
        var owner: str = .staticOwner(m.object)
        if owner == "Math"
            isMath = true
        # a static method: Class.method(args) -> class_method(args)
        if .isClassName(owner) or .isStructName(owner)
            var skey2: str = snakeCase(owner) + "_" + vSafe(name)
            if .sigs.get(skey2) == nil
                # no such static declared: a builtin namespace of the same name
                # (`Arg.parse()` beside the AST's `Arg` struct)
                var bi: str = .staticCall(m, args, span)
                if bi != ""
                    return .rtFree(bi, span)
            return skey2 + "(" + .argsStr(args, skey2) + ")"
        # a union variant constructed: U.v(x) -> U_v{ payload: x }, U.v() -> U_v{}
        if .isUnionName(owner)
            # (wrapped as the sum type, as the bare-member form above: see there)
            if args.count() == 0
                return owner + "(" + owner + "_" + name + "{})"
            if .isBoxed(owner + "_" + name)
                return owner + "(" + owner + "_" + name + "{ payload: zbox[" + (.union_payloads.get(owner + "_" + name) orelse owner) + "](" + .exprStr(args.at(0).value) + ") })"
            return owner + "(" + owner + "_" + name + "{ payload: " + .exprStr(args.at(0).value) + " })"
        if isMath
            .needs_math = true
            for ma in args
                if .vTypeOf(ma.value) == "f32"
                    # BUG-768: the Zig route computes Math.* of a float32 in float32 (its
                    # builtins take the argument's type); this route's math is f64, whose
                    # result would carry other digits. Refused, with the spelling that is
                    # the same computation on both routes.
                    .refuse("Math." + name + " on a float32 argument (the Zig route computes it in float32, this route's math is f64: pass `x.toFloat()`, and narrow the result with `toFloat32()` where a float32 is wanted)", span)
                    break
            if name == "sqrt" or name == "abs" or name == "floor" or name == "ceil" or name == "sin" or name == "cos" or name == "tan" or name == "pow" or name == "min" or name == "max" or name == "atan2"
                return "math." + name + "(" + .argsStr(args) + ")"
            if name == "round": return .rtFree("zmath_round(" + .argsStr(args) + ")", span)
            if name == "exp" or name == "log": return "math." + name + "(" + .argsStr(args) + ")"
            if name == "clamp": return .rtFree("zmath_clamp(" + .argsStr(args) + ")", span)
            .refuse("Math." + name, span)
            return "math." + name + "(" + .argsStr(args) + ")"
        var statics: str = .staticCall(m, args, span)
        if statics != ""
            return .rtFree(statics, span)
        var obj = .exprStr(m.object)
        var rtype: str = .vTypeOf(m.object)
        if (not isNameExpr(m.object) or .isNarrowedIdent(m.object)) and not .in_cond and .mutatesReceiver(rtype, name)
            # V takes a mutating call on an lvalue only: the receiver (a call's
            # result, an unwrap) is bound first, on a line before the statement
            .tmpN = .tmpN + 1
            var tr = "zt" + .tmpN.toString()
            .line("mut " + tr + " := " + obj)
            .local_names.add(tr)
            if rtype != ""
                .local_types.set(tr, rtype)   # (the call on it resolves by the type too)
            obj = tr
        # a user type's own method: its signature, before the stdlib table's names
        var own: str = rtype
        if own.startsWith("&")
            own = own.substring(1, own.len)
        if own != "" and (.isClassName(own) or .isStructName(own) or .isIfaceName(own))
            if name == "toString" and args.count() == 0
                if .isShownType(rtype)
                    return .showValue(rtype, obj)   # its own `cue toString` (V's str()), else the Zig route's `Name{...}` (BUG-746)
                return obj + ".str()"   # an interface's: the implementer's str()
            var okey: str = "." + vSafe(name)
            if .sigs.get(own + "." + vSafe(name)) != nil
                okey = own + "." + vSafe(name)
            return obj + "." + vSafe(name) + "(" + .argsStr(args, okey) + ")"
        if rtype == "rune" and name == "toString" and args.count() == 0
            return "zr_s(zchar_str(" + obj + "))"   # the char's text; an escape char's is its original byte (BUG-703)
        if rtype == "rune" and name == "escapedByte" and args.count() == 0
            return "zchar_escaped_byte(" + obj + ")"
        if rtype == "u8" and name == "toString" and args.count() == 0
            return obj + ".str()"   # a byte's toString is its number, as on the Zig route (until BUG-712 this route's char WAS a u8 and this printed the character)
        if vIntKind(rtype) != 0 and args.count() == 0
            # BUG-761: the checked conversions (`n.toInt8()`, `u.toInt()`, BUG-534's family)
            # on an integer of any mapped width; out of range traps with the Zig route's words
            var conv_t: str = vConvTarget(name)
            if conv_t != ""
                return intConvStr(obj, rtype, conv_t, zebraConvName(name))
            if name == "toByte" and rtype == "i64"
                return "u8(u64(" + obj + ") & 255)"   # the low eight bits: toByte on an int truncates (BUG-431)
            if name == "toFloat"
                return "f64(" + obj + ")"
            if name == "toFloat32"
                return "f32(" + obj + ")"   # BUG-768
            if name == "toString" and rtype != "i64"
                return obj + ".str()"
        if rtype == "" and args.count() == 0 and name != "toInt" and vConvTarget(name) != ""
            # the checked conversion is written from the receiver's type; without it the
            # fall-through below would guess a V method (`x.to_int16()`), which V has not
            .refuse("`" + name + "()` on a value whose type this route does not know (annotate the value: the conversion's range check is written from its type)", span)
            return obj
        if rtype == "&ZSqliteDb" and name == "journalMode" and args.count() == 0
            return obj + ".journal_mode()"
        if rtype == "&ZSqliteDb" and name == "lastError" and args.count() == 0   # BUG-716: the last call's refusal, nil after a success
            return obj + ".last_error()"
        if rtype == "&ZSqliteDb" and name == "lastErrorCode" and args.count() == 0
            return obj + ".last_error_code()"
        if rtype == "&ZSqliteDb" and (name == "exec" or name == "query") and args.count() == 2
            return obj + "." + name + "(" + .exprStr(args.at(0).value) + ", " + .sqliteParamsStr(args.at(1).value) + ")"
        if rtype == "&ZSqliteDb" and (name == "exec" or name == "query") and args.count() == 1
            return obj + "." + name + "(" + .argsStr(args) + ", new_zlist[string]())"   # without parameters
        if rtype == "string" and name == "toInt" and args.count() == 0
            return obj + ".i64()"   # parsed, not cast
        if rtype == "string" and name == "toFloat" and args.count() == 0
            return obj + ".f64()"
        if rtype == "&ZStringBuilder" and name == "toString" and args.count() == 0
            return obj + ".build()"   # a builder's text, not V's struct printer
        if rtype == "&ZJson" or (rtype == "" and isJsonOnlyMethod(name))
            var ja: str = .argsStr(args)
            if name == "get" and args.count() == 1: return "zjson_get(" + obj + ", " + ja + ")"
            if name == "has" and args.count() == 1: return "zjson_has(" + obj + ", " + ja + ")"
            # `v.tryX()` is the value itself as X; `v.tryX(key)` is the MEMBER
            # as X (the Zig backend's _json_self_X beside _json_try_X)
            if name == "tryStr": return .jsonTry("str", obj, args, ja)
            if name == "tryInt": return .jsonTry("int", obj, args, ja)
            if name == "tryFloat": return .jsonTry("float", obj, args, ja)
            if name == "tryBool": return .jsonTry("bool", obj, args, ja)
            if name == "tryObj": return .jsonTry("obj", obj, args, ja)
            if name == "tryList": return .jsonTry("list", obj, args, ja)
            if name == "keys": return "zjson_keys(" + obj + ")"
            if name == "values": return "zjson_values(" + obj + ")"
            if name == "isNull": return "zjson_is_null(" + obj + ")"
            if name == "isObject": return "zjson_is_object(" + obj + ")"
            if name == "isArray": return "zjson_is_array(" + obj + ")"
            if name == "stringify" or name == "toString": return "zjson_stringify(" + obj + ")"
            if isJsonPutMethod(name)
                return .jsonPutCall(name, obj, args)
        # a map's or a set's toString(): the text print gives it (BUG-723; the contract is
        # the print spelling -- BUG-743 is the Zig route catching up to it)
        if (rtype.startsWith("&ZMap[") or rtype.startsWith("&ZSet[")) and name == "toString" and args.count() == 0
            return .showContainer(rtype, obj)
        if rtype.startsWith("&ZList[")
            if (name == "add" or name == "set") and args.count() >= 1 and .isSigName(.elemOf(rtype))
                # a lambda into a list of a sig type: cast to the name (see coerced)
                var cargs: str = ""
                var ci: int = 0
                for a in args
                    if ci > 0
                        cargs = cargs + ", "
                    cargs = cargs + .coerced(a.value, .elemOf(rtype))
                    ci = ci + 1
                return obj + "." + name + "(" + cargs + ")"
            # the list's own, where the string's would be taken by name (the
            # comparing ones are free functions: see zebra_rt.v)
            if name == "indexOf" and args.count() == 1: return "zlist_index_of(" + obj + ", " + .argsStr(args) + ")"
            if name == "contains" and args.count() == 1: return "zlist_contains(" + obj + ", " + .argsStr(args) + ")"
            if name == "toString" and args.count() == 0: return .showContainer(rtype, obj)
            if name == "sort" and args.count() == 1 and isLambdaExpr(args.at(0).value)
                # a comparator: the runtime's stable sort (std.mem.sort is stable on the Zig backend)
                return "zlist_sort_with(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
            if name == "sortBy" and args.count() == 1 and isLambdaExpr(args.at(0).value)
                var kt: str = .lambdaRet(args.at(0).value)
                if kt == "i64": return "zlist_sort_by_i64(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
                if kt == "f64": return "zlist_sort_by_f64(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
                if kt == "string": return "zlist_sort_by_str(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
                .refuse("List.sortBy with a key of type " + kt + " (the runtime sorts by i64, f64 and str)", span)
                return "zlist_sort_by_i64(mut " + obj + ", " + .exprStr(args.at(0).value) + ")"
            if name == "sort" and args.count() == 0
                var et: str = .elemOf(rtype)
                if et == "string": return "zsort_str(mut " + obj + ")"
                if et == "i64": return "zsort_i64(mut " + obj + ")"
                if et == "f64": return "zsort_f64(mut " + obj + ")"
                .refuse("List(" + et + ").sort (the runtime sorts i64, f64 and str)", span)
                return "zsort_str(mut " + obj + ")"
            if name == "remove" and args.count() == 1: return obj + ".remove_at(" + .argsStr(args) + ")"   # Zebra's List.remove(i) is by index
            if name == "reverse" and args.count() == 0: return obj + ".reversed()"
        return .rtMethod(.mappedCall(obj, name, args, span, rtype), obj, rtype, span)

    # File / Path / sys as static calls onto the runtime's wrappers ("" when
    # the object is not one of them); Json is the next slice
    def staticCall(m: ExprMember, args: List(Arg), span: Span): str
        var ns: str = .staticOwner(m.object)
        if ns == ""
            return ""
        if not isBuiltinNs(ns)
            # a Zebra stdlib namespace the V emitter does not map (Regex, Csv,
            # ThreadPool's kin): refused by name, not written as a module call
            if namespaceMembers(ns) != "" and not (.isClassName(ns) or .isStructName(ns) or .isModuleName(ns) or .isEnumName(ns) or .isUnionName(ns) or .isIfaceName(ns))
                .refuse(ns + "." + m.member + " (the V runtime has no " + ns + " yet)", span)
            return ""   # (before the arguments are rendered: rendering binds temporaries, and a second rendering bound them twice)
        var name = m.member
        # Sqlite.open(path, writeAhead: bool = true, busyMs: int = 5000): the checker refuses
        # any other argument. Each one past the path is placed by sqliteOpenParamName -- the
        # checker's own resolution, which CodeGen's genSqliteCall uses too (BUG-717,
        # zebra-language e0ebc42) -- so a named `busyMs:` in second position is the busy
        # timeout; taken by POSITION, as this was, `Sqlite.open(p, busyMs: 0)` opened with
        # write-ahead off. Before the arguments are rendered together: argsStr refuses a
        # named argument to a callee it has no signature for, and this one is the runtime's.
        if ns == "Sqlite" and name == "open" and args.count() > 0
            var wa_s: str = "true"
            var busy_s: str = "5000"
            var ai: int = 1
            while ai < args.count()
                var pn: str = sqliteOpenParamName(args.at(ai), ai)
                if pn == "writeAhead"
                    wa_s = .exprStr(args.at(ai).value)
                else if pn == "busyMs"
                    busy_s = .exprStr(args.at(ai).value)
                ai = ai + 1
            return "zsqlite_open(" + .exprStr(args.at(0).value) + ", " + wa_s + ", " + busy_s + ")"
        var a = .argsStr(args)
        if ns == "File"
            if name == "exists": return "zfile_exists(" + a + ")"
            if name == "read": return "zfile_read(" + a + ")"
            if name == "write": return "zfile_write(" + a + ")"
            if name == "append": return "zfile_append(" + a + ")"
            if name == "listDir": return "zfile_list_dir(" + a + ")"
            if name == "isDir": return "os.is_dir(" + a + ")"
            if name == "rename": return "os.mv(" + a + ") or {}"
            if name == "delete": return "os.rm(" + a + ") or {}"
            if name == "tryDelete": return "zfile_try_delete(" + a + ")"
            if name == "copy": return "os.cp(" + a + ") or {}"
            if name == "readLines": return "zstr_lines(zfile_read(" + a + "))"
            .refuse("File." + name, span)
            return "zfile_" + snakeCase(name) + "(" + a + ")"
        if ns == "Path"
            if name == "dirname": return "zpath_dirname(" + a + ")"
            if name == "basename": return "zpath_basename(" + a + ")"
            if name == "stem": return "zpath_stem(" + a + ")"
            if name == "join": return "zpath_join(" + a + ")"
            .refuse("Path." + name, span)
            return "zpath_" + snakeCase(name) + "(" + a + ")"
        if ns == "sys"
            if name == "exit": return "exit(int(" + a + "))"
            if name == "errln": return "eprintln(" + a + ")"
            if name == "err": return "eprint(" + a + ")"
            if name == "cwd": return "os.getwd()"
            if name == "args": return "zlist_of[string](os.args)"
            if name == "getenv": return "os.getenv_opt(" + a + ")"
            if name == "setenv": return "os.setenv(" + a + ", true)"
            if name == "selfExe": return "os.executable()"
            if name == "run": return "zsys_run(" + a + ")"
            if name == "sleep": return "time.sleep(i64(" + a + ") * time.millisecond)"
            if name == "readLine": return "zsys_readline()"
            if name == "memStats": return "zsys_mem_stats()"   # arenaBytes: the collector's heap; the census fields -1
            if name == "readBytes": return "zsys_read_bytes(" + a + ")"
            if name == "readStdinAvailable": return "zsys_read_stdin_available()"
            if name == "stdinClosed": return "zsys_stdin_closed()"
            if name == "go": return "spawn " + a + "()"   # a goroutine: V's spawn of the closure
            if name == "exec_inherit": return "zsys_exec_inherit(" + a + ")"
            if name == "writeStdout": return "print(" + a + ")"
            if name == "spawnPiped": return "zsys_spawn_piped(" + a + ")"
            if name == "spawnPipedIn": return "zsys_spawn_piped_in(" + a + ")"
            .refuse("sys." + name, span)
            return "zsys_" + snakeCase(name) + "(" + a + ")"
        if ns == "Timer"
            if name == "start": return "ztimer_start()"
            .refuse("Timer." + name, span)
        if ns == "Tcp"
            .refuse("Tcp." + name + " (no TCP client in the V runtime yet)", span)
            return "0"
        if ns == "Net"
            # V's net, through the runtime's net section (inlined with its import
            # only when a program names it): the system resolver, as the Zig
            # route's Net.resolve asks it since BUG-726
            if name == "resolve": return "znet_resolve(" + a + ")"
            .refuse("Net." + name + " (resolve is mapped; the UDP calls are not)", span)
            return "0"
        if ns == "Dir"
            if name == "exists": return "os.is_dir(" + a + ")"
            if name == "createAll": return "os.mkdir_all(" + a + ") or {}"
            if name == "create": return "os.mkdir_all(" + a + ") or {}"   # the Zig backend's createDirPath: every segment
            if name == "list": return "zdir_list(" + a + ")"
            if name == "deleteAll": return "os.rmdir_all(" + a + ") or {}"
            if name == "tryDeleteAll": return "zdir_try_delete_all(" + a + ")"
            if name == "walk": return "zdir_walk(" + a + ")"
            if name == "delete": return "os.rmdir(" + a + ") or {}"
            .refuse("Dir." + name, span)
            return "zdir_" + snakeCase(name) + "(" + a + ")"
        if ns == "Terminal"
            if name == "write" and args.count() == 2: return "print(" + .exprStr(args.at(0).value) + " + " + .exprStr(args.at(1).value) + ")"
            if name == "write": return "print(" + a + ")"
            if name == "writeln": return "println(" + a + ")"
            .refuse("Terminal." + name, span)
            return "zterm_" + snakeCase(name) + "(" + a + ")"
        if ns == "Arg"
            if name == "parse": return "zarg_parse()"
            .refuse("Arg." + name, span)
            return "zarg_" + snakeCase(name) + "()"
        if ns == "Json"
            if name == "parse": return "zjson_parse(" + a + ")"
            if name == "object": return "zjson_object()"
            if name == "array": return "zjson_array()"
            if name == "stringify": return "zjson_stringify(" + a + ")"
            .refuse("Json." + name, span)
            return "zjson_" + snakeCase(name) + "(" + a + ")"
        if ns == "Sqlite"
            if name == "open": return "zsqlite_open(\"\", true, 5000)"   # no path at all: the Zig route opens ""
            .refuse("Sqlite." + name, span)
            return "zsqlite_" + snakeCase(name) + "(" + a + ")"
        if ns == "DateTime"
            if name == "now": return "zdatetime_now()"
            .refuse("DateTime." + name, span)
            return "zdatetime_now()"
        if ns == "Random"
            if name == "randInt": return "zrandom_int(" + a + ")"
            if name == "new": return "zrandom_new(" + a + ")"
            .refuse("Random." + name, span)
            return "zrandom_" + snakeCase(name) + "(" + a + ")"
        if ns == "Hash"
            if name == "sha256": return "zhash_sha256(" + a + ")"
            if name == "hmac256": return "zhash_hmac256(" + a + ")"
            .refuse("Hash." + name, span)
            return "zhash_" + snakeCase(name) + "(" + a + ")"
        if ns == "Crypto"
            # the runtime's crypto section (inlined with its imports only when a
            # program names it): V's crypto.rand, crypto.argon2 and crypto.hmac
            if name == "randomToken": return "zcrypto_random_token(" + a + ")"
            if name == "hashPassword": return "zcrypto_hash_password(" + a + ")"
            if name == "verifyPassword": return "zcrypto_verify_password(" + a + ")"
            if name == "equal": return "zcrypto_equal(" + a + ")"
            .refuse("Crypto." + name + " (randomToken, hashPassword, verifyPassword and equal are mapped; encrypt, decrypt and deriveKey are not)", span)
            return "zcrypto_" + snakeCase(name) + "(" + a + ")"
        if ns == "Http"
            # V's net.http, through the runtime's http section (inlined with its
            # import only when a program names it); the bundled tcc builds it on
            # Windows since 0.5.2 -- the earlier refusal was stale (2026-10-20)
            if name == "get": return "zhttp_get(" + a + ")"
            if name == "post": return "zhttp_post(" + a + ")"
            .refuse("Http." + name + " (get and post are mapped; the JSON forms and withHeader are next)", span)
            return "none"
        return ""

    # the call on an object already spelled (a temporary, or the member's object)
    def mappedCall(obj: str, name: str, args: List(Arg), span: Span, rtype: str = ""): str
        # a channel (`chan T`): send is V's push statement; the receives go through
        # the runtime, which keeps Zebra's rule (queued messages first, none once
        # closed and empty -- V's select on a closed channel fires with a zero value)
        if rtype.startsWith("chan ")
            var et: str = rtype.substring(5, rtype.len)
            if name == "send" and args.count() == 1: return obj + " <- " + .argsStr(args)
            if name == "recv" and args.count() == 0: return "zchan_recv[" + et + "](" + obj + ")"
            if name == "tryRecv" and args.count() == 0: return "zchan_try_recv[" + et + "](" + obj + ")"
            if name == "recvTimeout" and args.count() == 1: return "zchan_recv_timeout[" + et + "](" + obj + ", f64(" + .argsStr(args) + "))"
            if name == "close" and args.count() == 0: return obj + ".close()"
        if name == "toString" and args.count() == 0
            if rtype == "f64": return "zshow_f(" + obj + ")"   # a float's toString: the Zig backend's spelling
            if rtype == "f32": return "zshow_f32(" + obj + ")"
            return obj + ".str()"
        if name == "concat" and args.count() == 1: return "(" + obj + " + " + .argsStr(args) + ")"
        if name == "isNumeric" and args.count() == 0: return "zstr_is_numeric(" + obj + ")"
        if name == "toFloat" and args.count() == 0: return "f64(" + obj + ")"
        if name == "toFloat32" and args.count() == 0 and vIsFloat(rtype): return "f32(" + obj + ")"   # BUG-768
        if name == "toInt" and args.count() == 0 and vIsFloat(rtype): return "zfloat_int(f64(" + obj + "))"   # BUG-768: out of an int's range traps, as on the Zig route (V's cast answered i64's minimum)
        if name == "toInt" and args.count() == 0: return "i64(" + obj + ")"
        # the containers: the runtime's ZList / ZMap methods, by their names
        if name == "count" and args.count() == 0: return obj + ".count()"
        if name == "count" and args.count() == 1 and rtype == "string": return "i64(" + obj + ".count(" + .argsStr(args) + "))"   # a substring's occurrences: V's string.count
        if name == "at" and args.count() == 1: return obj + ".at(" + .argsStr(args) + ")"
        if name == "add" and args.count() == 1: return obj + ".add(" + .argsStr(args) + ")"
        if name == "set" and args.count() == 2: return obj + ".set(" + .argsStr(args) + ")"
        if name == "get" and args.count() == 1: return obj + ".get(" + .argsStr(args) + ")"
        if name == "has" and args.count() == 1: return obj + ".has(" + .argsStr(args) + ")"
        if name == "keys" and args.count() == 0: return obj + ".keys()"
        if name == "remove" and args.count() == 1: return obj + ".remove(" + .argsStr(args) + ")"
        if name == "copy" and args.count() == 0: return obj + ".copy()"
        if name == "last" and args.count() == 0: return obj + ".last()"
        if name == "isEmpty" and args.count() == 0 and rtype == "string": return "(" + obj + ".len == 0)"   # a V string has no is_empty (the emitted V did not compile)
        if name == "isEmpty" and args.count() == 0: return obj + ".is_empty()"
        if name == "values" and args.count() == 0: return obj + ".values()"
        if name == "put" and args.count() == 2: return obj + ".set(" + .argsStr(args) + ")"
        if name == "items" and args.count() == 0: return obj + ".items()"
        if name == "insert" or name == "removeAt"
            .refuse("List." + name + " (V 0.5.2 miscompiles array.insert on a generic element under two instantiations; vlang/v#30253)", span)
        # str (V's own names; a list's split / lines / chars come back boxed)
        if name == "split" and args.count() == 1: return "zstr_split(" + obj + ", " + .argsStr(args) + ")"
        if name == "lines" and args.count() == 0: return "zstr_lines(" + obj + ")"
        if name == "chars" and args.count() == 0: return "zstr_chars(" + obj + ")"   # the items: codepoints, and an escape char for a byte that is not UTF-8 (BUG-703 / 712)
        if name == "codePointCount" and args.count() == 0: return "zstr_cp_count(" + obj + ")"
        if name == "isValidUtf8" and args.count() == 0: return "zstr_is_valid_utf8(" + obj + ")"
        if name == "toValidUtf8" and args.count() == 0: return "zr_s(zstr_to_valid_utf8(" + obj + "))"
        if name == "padLeft" and args.count() == 1: return "zstr_pad_left(" + obj + ", " + .argsStr(args) + ", ' ')"
        if name == "padRight" and args.count() == 1: return "zstr_pad_right(" + obj + ", " + .argsStr(args) + ", ' ')"
        if name == "center" and args.count() == 1: return "zr_s(zstr_center(" + obj + ", " + .argsStr(args) + ", ' '))"
        if name == "center" and args.count() == 2: return "zr_s(zstr_center(" + obj + ", " + .argsStr(args) + "))"
        if name == "bytes" and args.count() == 0: return "zlist_of[u8](" + obj + ".bytes())"   # Zebra's List(byte), the same
        if name == "join" and args.count() == 1
            var jel: str = .elemOf(rtype)
            if jel != "" and jel != "string"
                # a list of anything but strings (BUG-723: a List(char) or a List(byte) is a
                # value now): each item's own text, bare, as the Zig route joins it
                return "zjoin_with(" + obj + ", " + .argsStr(args) + ", " + .showFn(jel, false) + ")"
            return "zjoin(" + obj + ", " + .argsStr(args) + ")"
        if name == "charAt" and args.count() == 1
            .refuse("str.charAt (Zebra's char is a number whose toString prints it; V has no char type to match -- the next slice decides a char's spelling)", span)
            return "zstr_char_at(" + obj + ", " + .argsStr(args) + ")"
        if name == "padLeft" and args.count() == 2: return "zstr_pad_left(" + obj + ", " + .argsStr(args) + ")"
        if name == "padRight" and args.count() == 2: return "zstr_pad_right(" + obj + ", " + .argsStr(args) + ")"
        if name == "tryInt" and args.count() == 0: return "zstr_try_int(" + obj + ")"
        if name == "tryFloat" and args.count() == 0: return "zstr_try_float(" + obj + ")"
        if name == "indexOf" and args.count() == 1: return "zstr_index_of(" + obj + ", " + .argsStr(args) + ")"
        # zr_s: a string V's builtin makes is the open allocate block's (the
        # regions section of zebra_rt.v); nothing when no block is open
        if name == "replace" and args.count() == 2: return "zr_s(" + obj + ".replace(" + .argsStr(args) + "))"
        if name == "replaceAll" and args.count() == 2: return "zr_s(" + obj + ".replace(" + .argsStr(args) + "))"
        if name == "repeat" and args.count() == 1: return "zr_s(" + obj + ".repeat(int(" + .argsStr(args) + ")))"
        if name == "reverse" and args.count() == 0 and rtype == "string": return "zr_s(zstr_reverse(" + obj + "))"   # by item, as the Zig route (V's reverse() is by byte)
        if name == "reverse" and args.count() == 0: return obj + ".reverse()"
        if name == "trimLeft" and args.count() == 0: return "zr_s(" + obj + ".trim_space_left())"
        if name == "trimRight" and args.count() == 0: return "zr_s(" + obj + ".trim_space_right())"
        if name == "equals" and args.count() == 1: return "(" + obj + " == " + .argsStr(args) + ")"
        if name == "eqlIgnoreCase" and args.count() == 1: return "(" + obj + ".to_lower() == (" + .argsStr(args) + ").to_lower())"
        if name == "build" and args.count() == 0: return obj + ".build()"
        if name == "append" and args.count() == 1: return obj + ".append(" + .argsStr(args) + ")"
        if name == "lastIndexOf" and args.count() == 1: return "zstr_last_index_of(" + obj + ", " + .argsStr(args) + ")"
        if name == "pop" and args.count() == 0 and rtype.startsWith("&ZList[")
            return obj + ".pop()"   # the runtime's pop: the last element or an error on an empty list, as the Zig side
        if name == "sort" or name == "sortBy" or name == "map" or name == "filter" or name == "reduce" or name == "pop"
            .refuse("." + name + " (needs the receiver's type or a closure: the next slices)", span)
        if name == "contains" and args.count() == 1: return obj + ".contains(" + .argsStr(args) + ")"
        if name == "startsWith" and args.count() == 1: return obj + ".starts_with(" + .argsStr(args) + ")"
        if name == "endsWith" and args.count() == 1: return obj + ".ends_with(" + .argsStr(args) + ")"
        if name == "substring" and args.count() == 2: return "zr_s(" + obj + "[int(" + .exprStr(args.at(0).value) + ")..int(" + .exprStr(args.at(1).value) + ")])"   # int bounds: MSVC (vlang/v#30352); a copy in V master (the probe of 2026-11-09)
        if name == "split" and args.count() == 1: return obj + ".split(" + .argsStr(args) + ")"
        if name == "trim" and args.count() == 0: return "zr_s(" + obj + ".trim_space())"
        if (name == "upper" or name == "toUpper") and args.count() == 0: return "zr_s(zstr_upper(" + obj + "))"   # ASCII letters only, as the Zig route (V's to_upper goes through runes)
        if (name == "lower" or name == "toLower") and args.count() == 0: return "zr_s(zstr_lower(" + obj + "))"
        if name == "clear" and args.count() == 0: return obj + ".clear()"
        # a method on one of the program's own classes: self.m(...) / obj.m(...)
        var key: str = "." + vSafe(name)
        var rt: str = rtype
        if rt.startsWith("&")
            rt = rt.substring(1, rt.len)
        if rt != "" and .sigs.get(rt + "." + vSafe(name)) != nil
            key = rt + "." + vSafe(name)   # the receiver's own method, whatever other classes call theirs
        if rt == "string" or rt == "u8" or rt == "rune" or rt == "i64" or rt == "f64" or rt == "bool"
            .refuse(rt + "." + vSafe(name) + " (no mapping for `" + name + "` on a V " + rt + ": the emitter would guess V's spelling)", span)
        return obj + "." + vSafe(name) + "(" + .argsStr(args, key) + ")"

    def binaryStr(b: ExprBinary): str
        if isWrapSatV(b.op)
            return .wrapSatStr(b)
        var ck: str = .checkedArith(b)
        if ck != ""
            return ck
        var fl: str = .floatBinStr(b)
        if fl != ""
            return fl
        if b.op == BinaryOp.or_ or b.op == BinaryOp.and_ or b.op == BinaryOp.add
            # decided before any operand is rendered: rendering binds temporaries,
            # and the chain renders its operands itself
            if b.op != BinaryOp.add and .chainLen(b) > 30
                var terms = List(str)()
                .chainTerms(b, terms)
                var fn_: str = "zany"
                if b.op == BinaryOp.and_
                    fn_ = "zall"
                return fn_ + "([" + zjoinStr(terms, ", ") + "])"
            return "(" + .chainStr(b) + ")"
        var l = .exprStr(b.left)
        var r = .exprStr(b.right)
        if b.op == BinaryOp.pow
            .needs_math = true
            return "math.pow(" + l + ", " + r + ")"
        if b.op == BinaryOp.in_
            return r + ".contains(" + l + ")"
        if b.op == BinaryOp.eq or b.op == BinaryOp.ne
            # `x == nil`: through a helper, so V never smart-casts x (the cast
            # name would refuse an `or` block, keep its option type in a binding,
            # and break V's C stage passed back to a generic `?T`)
            var nil_side: str = ""
            if isNilLit(b.right)
                nil_side = .rawName(b.left, l)
            else if isNilLit(b.left)
                nil_side = .rawName(b.right, r)
            if nil_side != ""
                var nt: str = ""
                if isNilLit(b.right)
                    nt = .vTypeOf(b.left)
                else
                    nt = .vTypeOf(b.right)
                var call: str = "zis_none(" + nil_side + ")"
                if nt.startsWith("?")
                    call = "zis_none(zopt_id(" + nil_side + "))"
                if b.op == BinaryOp.eq
                    return call
                return "(!" + call + ")"   # (parenthesized: `.str()` on it binds to the call otherwise)
            # `opt == value`: Zebra compares a nilable with a value; V does not
            var lt2: str = .vTypeOf(b.left)
            var rt2: str = .vTypeOf(b.right)
            if lt2.startsWith("?") and rt2 != "" and not rt2.startsWith("?")
                if b.op == BinaryOp.eq
                    return "zopt_eq(" + l + ", " + r + ")"
                return "!zopt_eq(" + l + ", " + r + ")"
            if rt2.startsWith("?") and lt2 != "" and not lt2.startsWith("?")
                if b.op == BinaryOp.eq
                    return "zopt_eq(" + r + ", " + l + ")"
                return "!zopt_eq(" + r + ", " + l + ")"
            # `kind == TokenKind.at_id` (a payload-less variant): V compares a sum
            # type with a variant by `is`, never by `==`
            var vt: str = .variantTypeName(b.right)
            var sub: str = l
            if vt == ""
                vt = .variantTypeName(b.left)
                sub = r
            if vt != ""
                if b.op == BinaryOp.eq
                    return "(" + sub + " is " + vt + ")"
                return "!(" + sub + " is " + vt + ")"
        if b.op == BinaryOp.dotdot
            .refused.add("a .. range expression")
            return l
        # (a chain of or / and / + was returned above, before the operands were
        # rendered: flat, and past thirty terms through zany / zall -- V's
        # checker gives up at forty nested levels, and every term is evaluated
        # there, no short-circuit)
        var mixed: str = .intMixedStr(b, l, r)
        if mixed != ""
            return mixed
        return "(" + l + " " + binaryOpV(b.op) + " " + r + ")"

    # BUG-761: a comparison, a bitwise operator or a shift on two integers that are not
    # both `int`. V will not compare or combine every pair of widths as Zebra does, so the
    # operands are brought to the join first (the checker's rule, vIntJoin); a comparison
    # with a bare literal is made in i64, where a literal the narrow side cannot hold
    # (`k < 300` on a byte) still compares; a narrow `<<` is computed in u64 and cut back
    # to the left operand's width, as the Zig route's is. "" when there is nothing to do.
    # BUG-768: arithmetic and a comparison with a float operand, written in the checker's
    # float join (vFloatJoin) with each operand cast to it where its type differs. Until
    # then the operator was V's own on whatever the operands were: an f64 with an i64
    # happened to promote, an f32 with one did not compile, and `%` on a float is refused
    # by V (the runtime's zfmod here: the dividend's sign, as the Zig route's @rem). "" when
    # neither operand is a float, when the other is no number the route knows, or for a
    # constant V folds itself.
    def floatBinStr(b: ExprBinary): str
        var is_arith: bool = b.op == BinaryOp.add or b.op == BinaryOp.sub or b.op == BinaryOp.mul or b.op == BinaryOp.div or b.op == BinaryOp.mod
        var is_cmp: bool = b.op == BinaryOp.eq or b.op == BinaryOp.ne or b.op == BinaryOp.lt or b.op == BinaryOp.le or b.op == BinaryOp.gt or b.op == BinaryOp.ge
        if not is_arith and not is_cmp
            return ""
        var lt: str = .vTypeOf(b.left)
        var rt: str = .vTypeOf(b.right)
        var l_lit: bool = isNumLit(b.left)
        var r_lit: bool = isNumLit(b.right)
        var j: str = vFloatJoin(lt, rt, l_lit, r_lit)
        if j == ""
            return ""
        if l_lit and r_lit and b.op != BinaryOp.mod
            return ""
        var ls: str = vFloatAs(.exprStr(b.left), lt, j)
        var rs: str = vFloatAs(.exprStr(b.right), rt, j)
        if b.op == BinaryOp.mod
            .needs_math = true
            return floatModStr(ls, rs, j)
        return "(" + ls + " " + binaryOpV(b.op) + " " + rs + ")"

    # every argument a float (f64), or a bare float literal: what makes a Math result a float
    def mathArgsAllFloat(args: List(Arg)): bool
        if args.count() == 0
            return false
        for a in args
            if .vTypeOf(a.value) != "f64"
                return false
        return true

    def intMixedStr(b: ExprBinary, l: str, r: str): str
        var lt: str = .vTypeOf(b.left)
        var rt: str = .vTypeOf(b.right)
        if vIntKind(lt) == 0 or vIntKind(rt) == 0
            return ""
        var l_lit: bool = isIntLit(b.left)
        var r_lit: bool = isIntLit(b.right)
        var op: str = binaryOpV(b.op)
        if b.op == BinaryOp.shl or b.op == BinaryOp.shr
            if l_lit or lt == "i64"
                return ""
            if b.op == BinaryOp.shl
                return lt + "(u64(" + l + ") << " + r + ")"
            return "(" + l + " >> " + r + ")"
        var is_cmp: bool = b.op == BinaryOp.eq or b.op == BinaryOp.ne or b.op == BinaryOp.lt or b.op == BinaryOp.le or b.op == BinaryOp.gt or b.op == BinaryOp.ge
        var is_bit: bool = b.op == BinaryOp.bit_and or b.op == BinaryOp.bit_or or b.op == BinaryOp.bit_xor
        if not is_cmp and not is_bit
            return ""
        if l_lit and r_lit
            return ""
        if is_cmp and (l_lit or r_lit)
            if l_lit and rt != "u64" and rt != "i64"
                return "(" + l + " " + op + " i64(" + r + "))"
            if r_lit and lt != "u64" and lt != "i64"
                return "(i64(" + l + ") " + op + " " + r + ")"
            return ""
        if lt == rt
            return ""
        var j: str = vIntJoin(lt, rt, l_lit, r_lit)
        if j == ""
            return ""
        return "(" + vIntAs(l, lt, j, l_lit) + " " + op + " " + vIntAs(r, rt, j, r_lit) + ")"

    # Wrapping (`+% -% *%`) and saturating (`+| -| *|`) arithmetic. Wrapping is computed in
    # u64 and cast back: a signed overflow in the C that V emits is undefined, and a narrow
    # product promotes to C `int`, so V's own operator is not the answer for every width.
    # Saturating has i64 helpers in the runtime. Any other width, and `<<|`, is refused by
    # name rather than guessed.
    def wrapSatStr(b: ExprBinary): str
        var t: str = .vTypeOf(b.left)
        if isIntLit(b.left)
            t = .vTypeOf(b.right)
        if isIntLit(b.left) and isIntLit(b.right)
            t = "i64"
        var ls: str = .exprStr(b.left)
        var rs: str = .exprStr(b.right)
        if not isIntLit(b.left) and not isIntLit(b.right)
            var rt0: str = .vTypeOf(b.right)
            if rt0 != t and (t == "i64" or rt0 == "i64") and (t == "u8" or t == "byte" or rt0 == "u8" or rt0 == "byte")
                # byte with int joins to int, as for `+` (the checker's numericJoin)
                t = "i64"
                ls = "i64(" + ls + ")"
                rs = "i64(" + rs + ")"
        var wop: str = ""
        if b.op == BinaryOp.add_wrap
            wop = "+"
        if b.op == BinaryOp.sub_wrap
            wop = "-"
        if b.op == BinaryOp.mul_wrap
            wop = "*"
        if wop != ""
            # BUG-761: every mapped width, in the operands' join (`int16 *% byte` is an
            # int16): u64 arithmetic wraps by definition, a narrower operand widens into
            # it with its sign, and the cast back keeps the join's low bits
            var wj: str = vIntJoin(.vTypeOf(b.left), .vTypeOf(b.right), isIntLit(b.left), isIntLit(b.right))
            if wj != ""
                return wj + "(u64(" + .exprStr(b.left) + ") " + wop + " u64(" + .exprStr(b.right) + "))"
            .refused.add("a wrapping operator on an operand of V type `" + t + "` (an integer of 8 to 64 bits is mapped)")
            return "0"
        var sfn: str = ""
        if b.op == BinaryOp.add_sat
            sfn = "zsadd"
        if b.op == BinaryOp.sub_sat
            sfn = "zssub"
        if b.op == BinaryOp.mul_sat
            sfn = "zsmul"
        if sfn != "" and t == "i64"
            return sfn + "(" + ls + ", " + rs + ")"
        if sfn == ""
            .refused.add("the saturating shift `<<|` (no V mapping yet)")
        else
            .refused.add("a saturating operator on an operand of V type `" + t + "` (only int is mapped)")
        return "0"

    # BUG-667: an i64 +, -, *, /, % through the runtime's checked helper; "" when the op
    # is not arithmetic or an operand is not an i64. An integer operand of a type the
    # emitter does not know (or a byte, which V keeps as u8 and wraps) is counted.
    def checkedArith(b: ExprBinary): str
        var fn_: str = checkedFnFor(b.op)
        if fn_ == ""
            return ""
        var lt: str = .vTypeOf(b.left)
        var rt: str = .vTypeOf(b.right)
        if lt == "i64" and rt == "i64"
            if isIntLit(b.left) and isIntLit(b.right)
                return ""   # a constant: V folds it at compile time
            return fn_ + "(" + .exprStr(b.left) + ", " + .exprStr(b.right) + ")"
        var sized: str = intArithStr(fn_, lt, rt, .exprStr(b.left), .exprStr(b.right), isIntLit(b.left), isIntLit(b.right))
        if sized != ""
            return sized   # BUG-761: two integers of any mapped width, in their join
        if lt == "" or rt == ""
            if not vIsFloat(lt) and not vIsFloat(rt) and lt != "string" and rt != "string"
                .arith_unchecked = .arith_unchecked + 1
        return ""

    # a nil check reads the raw name, narrowed or not (a narrowed read would unwrap)
    def rawName(e: Expr, rendered: str): str
        branch e
            on Expr.ident as id
                if .isNarrowed(id.name)
                    return .localName(id.name)
                return rendered
            on Expr.member as m
                if exprRootIsThis(m.object) and .isNarrowed("self." + vSafe(m.member))
                    return "self." + vSafe(m.member)
                return rendered
            else
                return rendered

    def chainLen(b: ExprBinary): int
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    return .chainLen(lb) + 1
                return 2
            else
                return 2

    def chainTerms(b: ExprBinary, out: List(str))
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    .chainTerms(lb, out)
                else
                    out.add(.exprStr(b.left))
            else
                out.add(.exprStr(b.left))
        out.add(.exprStr(b.right))

    def chainStr(b: ExprBinary): str
        var l: str = ""
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    l = .chainStr(lb)
                else
                    l = .exprStr(b.left)
            else
                l = .exprStr(b.left)
        if b.op == BinaryOp.add or .in_cond
            var joined: str = l + " " + binaryOpV(b.op) + " " + .exprStr(b.right)
            if b.op == BinaryOp.add and .vTypeOf(b.left) == "string"
                return "zr_s(" + joined + ")"   # a concatenation is the open allocate block's
            return joined
        # the right term rendered with its hoisted lines caught: a temporary
        # bound for it (a mutating call on a call's result, an unwrap) would
        # otherwise stand BEFORE the statement -- ahead of the left terms' side
        # effects and outside the short-circuit (character_test: play("lunge")
        # and then tracks.get("swing")!; the get ran first, 2026-10-15). With
        # lines caught, the chain so far is a bound boolean and the right term
        # is evaluated inside an if on it, its lines there.
        var outer: List(str) = .captured
        var was: bool = .capturing
        .captured = List(str)()
        .capturing = true
        var r: str = .exprStr(b.right)
        var mine: List(str) = .captured
        .captured = outer
        .capturing = was
        if mine.count() == 0
            return l + " " + binaryOpV(b.op) + " " + r
        .tmpN = .tmpN + 1
        var cn: str = "zc" + .tmpN.toString()
        .line("mut " + cn + " := " + l)
        .local_names.add(cn)
        if b.op == BinaryOp.and_
            .line("if " + cn + " {")
        else
            .line("if !" + cn + " {")
        .depth = .depth + 1
        for ml in mine
            .lineRaw(ml)
        .line(cn + " = " + r)
        .depth = .depth - 1
        .line("}")
        return cn

def isWrapSatV(op: BinaryOp): bool
    return op == BinaryOp.add_wrap or op == BinaryOp.sub_wrap or op == BinaryOp.mul_wrap or op == BinaryOp.add_sat or op == BinaryOp.sub_sat or op == BinaryOp.mul_sat or op == BinaryOp.shl_sat

# BUG-667: integer overflow TRAPS (Sean, 2026-10-30) and V's integer operators wrap, so
# an i64 +, -, *, / and % go through the runtime's checked helpers. "" for any other op.
# ── BUG-761: the sized integers ─────────────────────────────────────────────────────────
# The emitter knows an integer by its V type name. These are the checker's own rules
# (TypeChecker.numericJoin, numTypeName, intConvTarget) restated over those names, since
# vTypeOf answers in V's names and the checker's Type_ is not kept per expression here.
# tools/v_check.sh's `sized` row compares their result with the Zig route's, line by line.

# A Zebra integer type name as V's: "" when it is not one, "?" for a width V has no type for.
def vSizedIntName(name: str): str
    if name == "byte" or name == "uint8": return "u8"
    if name == "uint" or name == "uint64": return "u64"
    if name == "uint16": return "u16"
    if name == "uint32": return "u32"
    if name == "int8": return "i8"
    if name == "int16": return "i16"
    if name == "int32": return "i32"
    if name == "int64": return "i64"
    if name == "int128" or name == "uint128": return "?"
    return ""

# 1 signed, 2 unsigned, 0 not an integer the route maps
def vIntKind(t: str): int
    if t == "i8" or t == "i16" or t == "i32" or t == "i64": return 1
    if t == "u8" or t == "u16" or t == "u32" or t == "u64": return 2
    return 0

def vIntBits(t: str): int
    if t == "i8" or t == "u8": return 8
    if t == "i16" or t == "u16": return 16
    if t == "i32" or t == "u32": return 32
    return 64

# The type one operation on two integers is carried out in: the wider of two of one
# signedness, a signed type that holds both for a signed with a narrower unsigned, and ""
# for a signed with a 64-bit unsigned (the checker refuses that before any emitter runs).
# A bare literal takes the other side's type. "" too when either side is not an integer.
def vIntJoin(lt: str, rt: str, l_lit: bool, r_lit: bool): str
    var lk: int = vIntKind(lt)
    var rk: int = vIntKind(rt)
    if lk == 0 or rk == 0
        return ""
    if l_lit and r_lit
        return "i64"
    if l_lit
        return rt
    if r_lit
        return lt
    if lk == rk
        if vIntBits(lt) >= vIntBits(rt)
            return lt
        return rt
    var sw: int = vIntBits(lt)
    var uw: int = vIntBits(rt)
    if lk == 2
        sw = vIntBits(rt)
        uw = vIntBits(lt)
    if uw >= 64
        return ""
    var need: int = uw * 2
    if sw > need
        need = sw
    return "i" + need.toString()

# BUG-768: the float half of the checker's numericJoin, over V's type names. A float with
# a float is the wider; a float with an integer is that float (float32 with int stays
# float32); a bare literal takes the other side's type, except that a float literal beside
# an integer makes a float; two literals fold to a float. "" when neither side is a float,
# or when the other side is no number this route knows.
def vIsFloat(t: str): bool
    return t == "f64" or t == "f32"

def vFloatJoin(lt: str, rt: str, l_lit: bool, r_lit: bool): str
    var lf: bool = vIsFloat(lt)
    var rf: bool = vIsFloat(rt)
    if not lf and not rf
        return ""
    if (not lf and vIntKind(lt) == 0) or (not rf and vIntKind(rt) == 0)
        return ""
    if l_lit and r_lit
        return "f64"
    if l_lit
        if lf and not rf
            return "f64"
        return rt
    if r_lit
        if rf and not lf
            return "f64"
        return lt
    if lf and rf
        if lt == "f64" or rt == "f64"
            return "f64"
        return "f32"
    if lf
        return lt
    return rt

# an operand of a float operation, in the join's type
def vFloatAs(s: str, t: str, j: str): str
    if t == j
        return s
    return j + "(" + s + ")"

# `l % r` on floats of type j: C's fmod (the dividend's sign), computed in f64 -- exact for
# two float32 operands, whose remainder is a float32
def floatModStr(ls: str, rs: str, j: str): str
    if j == "f32"
        return "f32(zfmod(f64(" + ls + "), f64(" + rs + ")))"
    return "zfmod(" + ls + ", " + rs + ")"

# The Zebra spelling of a V integer type, as the Zig route's conversion message names it.
def zebraIntName(t: str): str
    if t == "i64": return "int"
    if t == "u8": return "byte"
    if t == "u64": return "uint64"
    if vIntKind(t) == 1: return "int" + vIntBits(t).toString()
    if vIntKind(t) == 2: return "uint" + vIntBits(t).toString()
    return t

# The V type a checked conversion method names: "" when the name is not one of them.
def vConvTarget(name: str): str
    if name == "toInt": return "i64"
    if name == "toInt8": return "i8"
    if name == "toInt16": return "i16"
    if name == "toInt32": return "i32"
    if name == "toInt64": return "i64"
    if name == "toUint" or name == "toUint64": return "u64"
    if name == "toUint8": return "u8"
    if name == "toUint16": return "u16"
    if name == "toUint32": return "u32"
    return ""

# The Zebra type a conversion method names, for the trap's message (`toUint8` is `byte`,
# `toUint` is `uint`: TypeChecker.numTypeName's spellings).
def zebraConvName(method: str): str
    if method == "toUint8": return "byte"
    if method.startsWith("toUint"): return "uint" + method.substring(6, method.len)
    if method.startsWith("toInt"): return "int" + method.substring(5, method.len)
    return method

# The bounds of a V integer type narrower than 64 bits, as V literals: "lo, hi".
def vIntBounds(t: str): str
    if t == "i8": return "-128, 127"
    if t == "i16": return "-32768, 32767"
    if t == "i32": return "-2147483648, 2147483647"
    if t == "u8": return "0, 255"
    if t == "u16": return "0, 65535"
    if t == "u32": return "0, 4294967295"
    return ""

# The largest value of a V integer type, as a V literal (for a conversion from a u64).
def vIntMax(t: str): str
    if t == "i8": return "127"
    if t == "i16": return "32767"
    if t == "i32": return "2147483647"
    if t == "i64": return "9223372036854775807"
    if t == "u8": return "255"
    if t == "u16": return "65535"
    if t == "u32": return "4294967295"
    return ""

# A checked `+ - * / %` (the runtime helper `cfn`: zadd, zsub, zmul, zdiv, zmod) on two
# integers, carried out in their join and trapping when the result does not fit it, as the
# Zig route's safety-checked arithmetic does. Below 64 bits both operands and every true
# result fit an i64, so the i64 helper computes and `zfit` refuses what the join cannot
# hold; a u64 has helpers of its own. "" when the operands are not two mapped integers.
def intArithStr(cfn: str, lt: str, rt: str, ls: str, rs: str, l_lit: bool, r_lit: bool): str
    var j: str = vIntJoin(lt, rt, l_lit, r_lit)
    if j == ""
        return ""
    if j == "i64"
        return cfn + "(" + vIntAs(ls, lt, "i64", l_lit) + ", " + vIntAs(rs, rt, "i64", r_lit) + ")"
    if j == "u64"
        var ul: str = vIntAs(ls, lt, "u64", l_lit)
        var ur: str = vIntAs(rs, rt, "u64", r_lit)
        if cfn == "zdiv": return "(" + ul + " / " + ur + ")"
        if cfn == "zmod": return "(" + ul + " % " + ur + ")"
        return "zu" + cfn.substring(1, cfn.len) + "(" + ul + ", " + ur + ")"   # zuadd, zusub, zumul
    return j + "(zfit(" + cfn + "(i64(" + ls + "), i64(" + rs + ")), " + vIntBounds(j) + "))"

# A checked conversion of an integer of V type `src` to `want` (`n.toInt8()`): the value
# when it fits, the Zig route's trap otherwise. `name` is the Zebra type for the message.
def intConvStr(obj: str, src: str, want: str, name: str): str
    if src == want
        return obj
    if src == "u64"
        return want + "(zuint_conv(" + obj + ", " + vIntMax(want) + ", '" + name + "'))"
    if want == "i64"
        return "i64(" + obj + ")"   # every other integer fits an int
    if want == "u64"
        return "u64(zint_conv(i64(" + obj + "), 0, 9223372036854775807, '" + name + "'))"
    return want + "(zint_conv(i64(" + obj + "), " + vIntBounds(want) + ", '" + name + "'))"

# An operand rendered as `want`: as it is when it already has that type, cast otherwise (a
# bare literal into an i64 slot is left bare: V reads it as the parameter's type).
def vIntAs(s: str, have: str, want: str, lit: bool): str
    if have == want and not lit
        return s
    if lit and want == "i64"
        return s
    return want + "(" + s + ")"

def checkedFnFor(op: BinaryOp): str
    if op == BinaryOp.add: return "zadd"
    if op == BinaryOp.sub: return "zsub"
    if op == BinaryOp.mul: return "zmul"
    if op == BinaryOp.div or op == BinaryOp.int_div: return "zdiv"
    if op == BinaryOp.mod: return "zmod"
    return ""

# the arithmetic op a compound assignment applies (BinaryOp.eq, i.e. none, otherwise)
def compoundBase(op: AssignOp): BinaryOp
    if op == AssignOp.plus_eq: return BinaryOp.add
    if op == AssignOp.minus_eq: return BinaryOp.sub
    if op == AssignOp.star_eq: return BinaryOp.mul
    if op == AssignOp.slash_eq or op == AssignOp.slashslash_eq: return BinaryOp.div
    if op == AssignOp.percent_eq: return BinaryOp.mod
    return BinaryOp.eq

# a place that reads the same thing twice: a name, or a field path from one
def isPlainPlace(e: Expr): bool
    branch e
        on Expr.ident
            return true
        on Expr.this_
            return true
        on Expr.member as m
            return isPlainPlace(m.object)
        else
            return false

def binaryOpV(op: BinaryOp): str
    if op == BinaryOp.add: return "+"
    if op == BinaryOp.sub: return "-"
    if op == BinaryOp.mul: return "*"
    if op == BinaryOp.div: return "/"
    if op == BinaryOp.int_div: return "/"
    if op == BinaryOp.mod: return "%"
    if op == BinaryOp.bit_and: return "&"
    if op == BinaryOp.bit_or: return "|"
    if op == BinaryOp.bit_xor: return "^"
    if op == BinaryOp.shl: return "<<"
    if op == BinaryOp.shr: return ">>"
    if op == BinaryOp.eq: return "=="
    if op == BinaryOp.ne: return "!="
    if op == BinaryOp.lt: return "<"
    if op == BinaryOp.le: return "<="
    if op == BinaryOp.gt: return ">"
    if op == BinaryOp.ge: return ">="
    if op == BinaryOp.and_: return "&&"
    if op == BinaryOp.or_: return "||"
    return "?"

def assignOpV(op: AssignOp): str
    if op == AssignOp.assign: return "="
    if op == AssignOp.plus_eq: return "+="
    if op == AssignOp.minus_eq: return "-="
    if op == AssignOp.star_eq: return "*="
    if op == AssignOp.slash_eq: return "/="
    if op == AssignOp.slashslash_eq: return "/="
    if op == AssignOp.percent_eq: return "%="
    if op == AssignOp.ampersand_eq: return "&="
    if op == AssignOp.vertical_bar_eq: return "|="
    if op == AssignOp.caret_eq: return "^="
    if op == AssignOp.double_lt_eq: return "<<="
    if op == AssignOp.double_gt_eq: return ">>="
    return "="

# "selfhost/CodeGen.zbr" -> "CodeGen"
def moduleStem(file: str): str
    var segs: List(str) = file.split("/")
    var last: str = segs.at(segs.count() - 1)
    var bs: List(str) = last.split("\\")
    last = bs.at(bs.count() - 1)
    if last.endsWith(".zbr")
        return last.substring(0, last.len - 4)
    return last

def zjoinStr(xs: List(str), sep: str): str
    var out: str = ""
    var first: bool = true
    for x in xs
        if not first
            out = out + sep
        first = false
        out = out + x
    return out

# a fixed-point float spec, `.Nf` with one digit (N 0..9: the runtime's zfmt_specs table)
def isFixedFloatSpec(spec: str): bool
    if spec.len != 3
        return false
    if not spec.startsWith(".") or not spec.endsWith("f")
        return false
    return isDigits(spec.substring(1, 2))

def isDigits(s: str): bool
    if s.len == 0
        return false
    var i: int = 0
    while i < s.len
        if s[i] < '0' or s[i] > '9'
            return false
        i = i + 1
    return true

# the Nth type argument of `ZTuple2[A, B]` (a nested generic's commas sit deeper)
def tupleElemType(vt: str, n: str): str
    var open_: int = vt.indexOf("[")
    if open_ < 0
        return ""
    var inner: str = vt.substring(open_ + 1, vt.len - 1)
    var parts = List(str)()
    var depth: int = 0
    var cur: str = ""
    var i: int = 0
    while i < inner.len
        var ch = inner[i]
        if ch == '['
            depth = depth + 1
        if ch == ']'
            depth = depth - 1
        if ch == ',' and depth == 0
            parts.add(cur.trim())
            cur = ""
        else
            cur = cur + inner[i..i + 1]
        i = i + 1
    parts.add(cur.trim())
    var want: int = 0
    if n.tryInt() as w
        want = w
    if want < parts.count()
        return parts.at(want)
    return ""

# a BARE integer literal: one that takes the type of what it meets. A suffixed literal
# (`5_u8`) is a value of its own type, like a variable of it (BUG-761).
def isIntLit(e: Expr): bool
    branch e
        on Expr.int_lit as il
            return intLitSuffix(il.text) == ""
        else
            return false

# The V type of an integer literal's text: i64 for a bare one, the suffix's type for a
# suffixed one, "" for a suffix V has no integer for (`_i128`).
def intLitVType(text: str): str
    var sfx: str = intLitSuffix(text)
    if sfx == "" or sfx == "int"
        return "i64"
    var t: str = vSizedIntName(sfx)
    if t == "?"
        return ""
    return t

# the Json methods no other type has (dispatched without the receiver's type)
def isJsonOnlyMethod(name: str): bool
    # (not tryInt / tryFloat: a string has them)
    return name == "tryStr" or name == "tryBool" or name == "tryObj" or name == "tryList" or name == "isNull" or name == "isObject" or name == "isArray" or name == "putInt" or name == "putFloat" or name == "putBool" or name == "appendInt" or name == "appendFloat" or name == "appendBool"

# A spec's width digits as a V integer literal: leading zeros off (`>05` is width 5; V
# reads a literal with a leading zero as something else). "" stays "": no width.
def specWidth(digits: str): str
    var out: str = digits
    while out.len > 1 and out.startsWith("0")
        out = out.substring(1, out.len)
    if out == "0"
        return ""
    return out

# The sign flag as the byte zfmt_itext takes: `+` 43, a space 32, none or `-` 45.
def specSignCode(sign: str): str
    if sign == "+"
        return "43"
    if sign == " "
        return "32"
    return "45"

# a string's method with a scalar result, where no row above typed it: the runtime's
# own signatures (zstr_index_of, zstr_last_index_of, V's count cast, zstr_try_int,
# zstr_try_float). "" for the rest: unknown, never another declaration's type.
def vStringMethodRet(name: str, argc: int): str
    if argc == 1 and (name == "indexOf" or name == "lastIndexOf" or name == "count")
        return "i64"
    if argc == 0 and name == "tryInt"
        return "?i64"
    if argc == 0 and name == "tryFloat"
        return "?f64"
    return ""

# the predicates of the builtin receivers, by the checker's tables (stringMethodReturn's
# bool rows; contains on the containers, any / all on a list; a Json value's tests).
# The receiver's type is asked first: a class of the program's own with a method of one
# of these names is typed by its declaration before this is reached.
def vBuiltinBoolMethod(ot: str, name: str): bool
    if ot == "string"
        return name == "contains" or name == "startsWith" or name == "endsWith" or name == "isEmpty" or name == "isAlpha" or name == "isNumeric" or name == "isValidUtf8" or name == "eqlIgnoreCase" or name == "isAlphanumeric" or name == "isPrintable" or name == "startsWithIgnoreCase" or name == "endsWithIgnoreCase" or name == "containsIgnoreCase"
    if ot.startsWith("&ZList[")
        return name == "contains" or name == "any" or name == "all"
    if ot.startsWith("&ZMap[") or ot.startsWith("&ZSet[")
        return name == "contains"
    if ot == "&ZJson"
        return name == "has" or name == "isNull" or name == "isObject" or name == "isArray"
    return false

# the stdlib methods whose result is a string, whatever the receiver
def isStringReturningMethod(name: str): bool
    return name == "trim" or name == "trimLeft" or name == "trimRight" or name == "upper" or name == "lower" or name == "substring" or name == "replace" or name == "replaceAll" or name == "repeat" or name == "padLeft" or name == "padRight" or name == "center" or name == "reverse" or name == "toValidUtf8" or name == "concat" or name == "join" or name == "toString" or name == "stringify" or name == "build"

def isJsonPutMethod(name: str): bool
    return name == "put" or name == "putInt" or name == "putFloat" or name == "putBool" or name == "append" or name == "appendInt" or name == "appendFloat" or name == "appendBool"

def isStringLit(e: Expr): bool
    branch e
        on Expr.string_lit
            return true
        on Expr.string_interp
            return true
        else
            return false

# a name READ somewhere in the statements: through expressions only, an
# assignment's target excluded (V counts an assigned-only local as unused)
def readsName(name: str, stmts: List(Stmt)): bool
    for s in stmts
        if readsNameStmt(name, s)
            return true
    return false

def readsNameStmt(name: str, s: Stmt): bool
    branch s
        on Stmt.assign as a
            if mightUseNameInExpr(name, a.value)
                return true
            branch a.target
                on Expr.member as m
                    return mightUseNameInExpr(name, m.object)
                on Expr.index as ix
                    return mightUseNameInExpr(name, ix.object) or mightUseNameInExpr(name, ix.index)
                else
                    return false
        on Stmt.var_ as v
            if v.init_expr as ie
                return mightUseNameInExpr(name, ie)
            return false
        on Stmt.expr as e
            return mightUseNameInExpr(name, e)
        on Stmt.if_ as i
            if mightUseNameInExpr(name, i.cond) or readsName(name, i.then_stmts)
                return true
            for ei in i.else_ifs
                if mightUseNameInExpr(name, ei.cond) or readsName(name, ei.stmts)
                    return true
            if i.else_stmts as es
                return readsName(name, es)
            return false
        on Stmt.while_ as w
            return mightUseNameInExpr(name, w.cond) or readsName(name, w.stmts)
        on Stmt.for_in as fi
            if mightUseNameInExpr(name, fi.iter) or readsName(name, fi.stmts)
                return true
            if fi.filter as flt
                return mightUseNameInExpr(name, flt)
            return false
        on Stmt.for_num as fnum
            if mightUseNameInExpr(name, fnum.start) or mightUseNameInExpr(name, fnum.stop_) or readsName(name, fnum.stmts)
                return true
            if fnum.step as st
                return mightUseNameInExpr(name, st)
            return false
        on Stmt.return_ as r
            if r.value as rv
                return mightUseNameInExpr(name, rv)
            return false
        on Stmt.branch_ as b
            if mightUseNameInExpr(name, b.expr)
                return true
            for arm in b.cases
                for v in arm.values
                    if mightUseNameInExpr(name, v)
                        return true
                if readsName(name, arm.stmts)
                    return true
            if b.else_ as es
                return readsName(name, es)
            return false
        on Stmt.try_catch as tc
            if readsName(name, tc.stmts)
                return true
            for cl in tc.clauses
                if readsName(name, cl.stmts)
                    return true
            return false
        on Stmt.print_ as p
            for a in p.args
                if mightUseNameInExpr(name, a)
                    return true
            return false
        else
            return mightUseNameStmt(name, s)   # the rest: the conservative walker

# the statements from index `from` on (a copy: the walker takes a list)
def restOf(stmts: List(Stmt), from: int): List(Stmt)
    var out = List(Stmt)()
    var i: int = from
    while i < stmts.count()
        out.add(stmts.at(i))
        i = i + 1
    return out

def isBoolLit(e: Expr): bool
    branch e
        on Expr.bool_lit
            return true
        else
            return false

# a block whose last statement leaves it: Zebra's narrowing holds after it
def endsWithExit(stmts: List(Stmt)): bool
    if stmts.count() == 0
        return false
    branch stmts.at(stmts.count() - 1)
        on Stmt.return_
            return true
        on Stmt.raise_
            return true
        on Stmt.break_
            return true
        on Stmt.continue_
            return true
        else
            return false

# a rendered Json value converted to the receiving type
def coerceRendered(s: str, want: str): str
    if want == "i64": return "zjson_as_int(" + s + ")"
    if want == "f64": return "zjson_as_float(" + s + ")"
    if want == "bool": return "zjson_as_bool(" + s + ")"
    if want == "string": return "zjson_str(" + s + ")"
    if want == "&ZList[&ZJson]": return "zjson_list(" + s + ")"   # a Json array as a List(JsonValue)
    return s

def isLambdaExpr(e: Expr): bool
    branch e
        on Expr.lambda
            return true
        else
            return false

def isIdentExpr(e: Expr): bool
    branch e
        on Expr.ident
            return true
        else
            return false

def isNilLit(e: Expr): bool
    branch e
        on Expr.nil_
            return true
        else
            return false

def isUntypedListLit(e: Expr): bool
    branch e
        on Expr.list_lit as ll
            return ll.elem_type == nil
        else
            return false

# whether a body assigns to a field of this (`.x = ...`), through if / while /
# for bodies: a struct method that does needs a `mut` receiver
def exprRootIsThis(e: Expr): bool
    branch e
        on Expr.member as m
            return exprRootIsThis(m.object)
        on Expr.index as ix
            return exprRootIsThis(ix.object)
        on Expr.this_
            return true
        else
            return false

def dropLast(xs: List(str)): List(str)
    var out = List(str)()
    var i: int = 0
    while i < xs.count() - 1
        out.add(xs.at(i))
        i = i + 1
    return out

def methodNames(members: List(Decl), statics: bool): List(str)
    var out = List(str)()
    for mem in members
        branch mem
            on Decl.method as mth
                if mth.mods.is_static == statics
                    out.add(mth.name)
            else
                pass
    return out

def isBareCtor(e: Expr): bool
    branch e
        on Expr.call as c
            if c.args.count() != 0
                return false
            branch c.callee
                on Expr.ident as id
                    return id.name == "List" or id.name == "HashMap" or id.name == "Set"
                else
                    return false
        else
            return false

def fieldNames(members: List(Decl)): List(str)
    var out = List(str)()
    for mem in members
        branch mem
            on Decl.var_ as f
                out.add(f.name)
            else
                pass
    return out

# a name, or a field path of names: what V's smart cast takes
def isNameExpr(e: Expr): bool
    branch e
        on Expr.ident
            return true
        on Expr.this_
            return true
        on Expr.member as m
            return isNameExpr(m.object)
        else
            return false

def isCallExpr(e: Expr): bool
    branch e
        on Expr.call
            return true
        else
            return false

# a condition without its outer parentheses (V warns on `if (x) {`): one
# balanced outer pair is stripped, never an inner one
def condStr(s: str): str
    if s.len < 2 or not s.startsWith("(") or not s.endsWith(")")
        return s
    var depth: int = 0
    var i: int = 0
    var quote: char = ' '   # inside a '...' or `...` literal: its parentheses are text
    var in_lit: bool = false
    for ch in s.chars()
        if in_lit
            if ch == quote
                in_lit = false
        else if ch == '\'' or ch == '`'
            in_lit = true
            quote = ch
        else if ch == '('
            depth = depth + 1
        else if ch == ')'
            depth = depth - 1
            if depth == 0 and i < s.len - 1
                return s   # the first pair closes before the end: not an outer pair
        i = i + 1
    return s.substring(1, s.len - 1)

# the builtin namespaces a static access may name
def startsUpper(name: str): bool
    for ch in name.chars()
        return ch >= 'A' and ch <= 'Z'
    return false

# the identifier a string starts with ("zstr_pad_left(x)" -> "zstr_pad_left")
def identPrefix(s: str): str
    var n: int = 0
    for ch in s.chars()
        if (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_'
            n = n + 1
        else
            break
    return s.substring(0, n)

# a V type as the runtime declares methods on it: `&ZList[T]` / `?&ZMap[K, V]` -> ZList
def rtBaseType(t: str): str
    var s: str = t
    while s.startsWith("&") or s.startsWith("?")
        s = s.substring(1, s.len)
    return identPrefix(s)

def isBuiltinNs(ns: str): bool
    return ns == "File" or ns == "Path" or ns == "sys" or ns == "Dir" or ns == "Json" or ns == "Random" or ns == "Hash" or ns == "Http" or ns == "Arg" or ns == "Terminal" or ns == "Sqlite" or ns == "DateTime" or ns == "Timer" or ns == "Tcp" or ns == "Crypto" or ns == "Net"

def isFloatLit(e: Expr): bool
    branch e
        on Expr.float_lit
            return true
        else
            return false

# the entry: the V source for a module, with the refusals
def generateV(ms: List(Module), runtime: str): VResult
    var g = VGen()
    g.noteRuntime(runtime)
    var body = g.genModules(ms)
    var head: str = "// generated by zebra --target v (proof of concept, 2026-10-13); do not edit\n"
    # the runtime (inlined below) uses math, os and strconv: always imported
    # (an import the program itself never reaches is used by the runtime's
    # functions, so V does not warn)
    head = head + "import math\nimport math.bits\nimport os\nimport strconv\nimport time\nimport x.json2\nimport rand\nimport crypto.sha256\nimport sync\n"
    # the runtime's sqlite section (V's db.sqlite, 9 MB of C to compile) goes
    # in, with its import, only when the program names it
    var rt_text: str = runtime
    var needs_sqlite: bool = body.contains("zsqlite_") or body.contains("ZSqliteDb") or body.contains("ZSqliteRow")
    if needs_sqlite
        head = head + "import db.sqlite\n"
    else
        var sa: int = rt_text.indexOf("// == sqlite begin ==")
        var sb: int = rt_text.indexOf("// == sqlite end ==")
        if sa >= 0 and sb > sa
            rt_text = rt_text.substring(0, sa) + "// (the sqlite section is left out: the program has no database)\n" + rt_text.substring(sb + "// == sqlite end ==".len, rt_text.len)
    # the runtime's http section (V's net.http: sockets, TLS) goes in, with
    # its import, only when the program names it
    var needs_http: bool = body.contains("zhttp_") or body.contains("ZHttpResponse")
    if needs_http
        head = head + "import net.http\n"
    else
        var ha: int = rt_text.indexOf("// == http begin ==")
        var hb: int = rt_text.indexOf("// == http end ==")
        if ha >= 0 and hb > ha
            rt_text = rt_text.substring(0, ha) + "// (the http section is left out: the program makes no request)\n" + rt_text.substring(hb + "// == http end ==".len, rt_text.len)
    # the runtime's net section (V's net: the resolver) goes in, with its import,
    # only when the program names it
    var needs_net: bool = body.contains("znet_")
    if needs_net
        head = head + "import net\n"
    else
        var na: int = rt_text.indexOf("// == net begin ==")
        var nb: int = rt_text.indexOf("// == net end ==")
        if na >= 0 and nb > na
            rt_text = rt_text.substring(0, na) + "// (the net section is left out: the program resolves no name)\n" + rt_text.substring(nb + "// == net end ==".len, rt_text.len)
    # the runtime's crypto section (argon2 and its blake2b are a second of V compile)
    # goes in, with its imports, only when the program names it
    var needs_crypto: bool = body.contains("zcrypto_") or body.contains("zhash_hmac256(")
    var crypto_imports: str = "import crypto.hmac\nimport crypto.argon2\nimport crypto.rand as crand\n"
    if needs_crypto
        head = head + crypto_imports
    else
        var ca: int = rt_text.indexOf("// == crypto begin ==")
        var cb: int = rt_text.indexOf("// == crypto end ==")
        if ca >= 0 and cb > ca
            rt_text = rt_text.substring(0, ca) + "// (the crypto section is left out: the program names no Crypto call)\n" + rt_text.substring(cb + "// == crypto end ==".len, rt_text.len)
    # Every module this header can import is a name V will not let a local shadow
    # (`duplicate of an import symbol`), so vSafe must rename each one's symbol: the
    # last path component, or the alias after ` as `. Checked HERE, where the imports
    # are declared: one added without its vSafe entry refuses at once and names the
    # fix. The conditional imports are checked whether or not this program has them.
    var import_lines: str = head + "import db.sqlite\nimport net.http\nimport net\n" + crypto_imports
    for iline in import_lines.split("\n")
        if iline.startsWith("import ")
            var ipath: str = iline.substring(7, iline.len).trim()
            var isym: str = ipath
            var as_at: int = ipath.indexOf(" as ")
            if as_at >= 0
                isym = ipath.substring(as_at + 4, ipath.len).trim()
            else
                var iparts: List(str) = ipath.split(".")
                isym = iparts.at(iparts.count() - 1)
            if vSafe(isym) == isym
                g.refused.add("internal: the V header imports `" + ipath + "` but vSafe does not rename a local named `" + isym + "` -- add it to the import list in vSafe (selfhost/CodeGenV.zbr)")
    head = head + "\n// -- the Zebra runtime for V (selfhost/zebra_rt.v), inlined so one file runs --\n" + rt_text + "\n// -- the program --\n"
    # the nested containers' printers (BUG-723), a top-level fn each, after the program
    var show_tail: str = ""
    for sh in g.show_helpers
        show_tail = show_tail + "\n" + sh
    if show_tail != ""
        show_tail = "\n// -- the printers of the nested containers this program prints --" + show_tail
    return VResult(source: head + body + show_tail, refused: g.refused, needs_math: g.needs_math, has_globals: g.has_globals, uses_gui: g.uses_gui, unverified: g.rt_unverified, unchecked_arith: g.arith_unchecked)
