# CodeGenV.zbr -- a V backend, proof of concept (2026-10-13).
#
# A second emitter over the same front end (Parser -> Resolver -> ASTBuilder):
# `zebra --target v file.zbr` writes file.v beside the source, for `v run`.
# The subset: free functions, classes (fields, `cue init`, methods), local
# and module-level vars, if / else if / else, while, `for x in list`,
# `for i in a.to(b)`, assign (and the compound ops), return, break,
# continue, print, assert, calls, member access, `this`, binary and unary
# ops, the literals, list literals, string interpolation, if-expressions,
# and a hand-mapped slice of the stdlib surface (str, List, Math, the
# numeric conversions). Everything else is REFUSED by name and line and
# listed at the end of the run -- nothing is skipped silently (the Zig
# emitter's method surface alone is 2,856 lines; the refusal list is the
# honest measure of the distance).
#
# V's own rules the emitter carries: function, method, variable and field
# names are snake_case (V refuses uppercase in them), types are
# CapitalCase, Zebra's int is 64-bit so it is V's i64, `this` is `self`,
# a class is a struct with `mut:` fields, `cue init` is `fn new_<name>()
# &Name`, a method is `fn (mut self Name) m()`.

use AstWalk exposing mightUseName, mightUseNameInExpr, mightUseNameStmt
use TypeChecker exposing namespaceMembers, intLitSuffix, intLitDigits, floatLitSuffix, floatLitDigits, isNumLit, sqliteOpenParamName
use CodeGen exposing parseFmtSpec
use Ast exposing Module, Decl, DeclClass, DeclStruct, DeclEnum, EnumMember, DeclUnion, UnionVariant, DeclMethod, DeclVar, DeclInit, Param, TypeRef, NamedTypeRef, GenericTypeRef, Stmt, StmtIf, ElseIf, StmtWhile, StmtAllocate, StmtCopyOut, StmtForIn, StmtForNum, StmtReturn, StmtAssert, StmtAssign, AssignOp, StmtPrint, StmtBranch, BranchOn, StmtRaise, StmtTryCatch, StmtIn, CatchClause, ExprTry, ExprCatch, Expr, ExprIntLit, IntBase, ExprFloatLit, ExprBoolLit, ExprCharLit, ExprSlice, ExprCast, ExprChainedCmp, ExprLambda, LambdaBody, DeclSig, ExprExcept, DeclInterface, DeclTypeAlias, ExprStringLit, StringKind, ExprStringInterp, StringPart, ExprIdent, ExprMember, ExprCall, Arg, ExprIndex, ExprBinary, BinaryOp, ExprUnary, UnaryOp, ExprListLit, ExprIf, ExprTypeCheck, Span

# a callee's parameters, for named arguments and defaults at the call
# (and which are references, hence `mut`)
class FnSig
    var names: List(str)
    var has_default: List(bool)
    var defaults: List(Expr)      # a nil placeholder where has_default is false
    var refs: List(bool)
    var types: List(str)          # the parameters' V types (a Json value converts to one at the call)

    cue init()
        .names = List(str)()
        .has_default = List(bool)()
        .defaults = List(Expr)()
        .refs = List(bool)()
        .types = List(str)()

# the emitter's answer: the V source and what it refused
class VResult
    var source: str
    var refused: List(str)
    var needs_math: bool
    var has_globals: bool    # a `__global` was emitted: the run needs -enable-globals
    var uses_gui: bool       # Gui / CodeEditor named: the file needs a --gui-backend section to build
    var unverified: int      # method calls on a receiver whose type the emitter did not know: not checked against the runtime
    var unchecked_arith: int # integer arithmetic the emitter could not route through a checked helper (BUG-667): V wraps there

    cue init(source: str, refused: List(str), needs_math: bool, has_globals: bool = false, uses_gui: bool = false, unverified: int = 0, unchecked_arith: int = 0)
        .source = source
        .refused = refused
        .needs_math = needs_math
        .has_globals = has_globals
        .uses_gui = uses_gui
        .unverified = unverified
        .unchecked_arith = unchecked_arith

# "setAnimate" -> "set_animate"; "winDist" -> "win_dist"; "x" -> "x"
def snakeCase(name: str): str
    if isAllCaps(name)
        return name.lower()   # CUE_NAMES -> cue_names
    var out: str = ""
    var first: bool = true
    for ch in name.chars()
        if ch >= 'A' and ch <= 'Z'
            if not first
                out = out + "_"
            out = out + lowerOf(ch)
        else
            out = out + ch.toString()
        first = false
    return out

def isAllCaps(name: str): bool
    var any: bool = false
    for ch in name.chars()
        if ch >= 'a' and ch <= 'z'
            return false
        if ch >= 'A' and ch <= 'Z'
            any = true
    return any

def lowerOf(ch: char): str
    # (a str index is a byte, and a byte's toString is its number -- "99" for
    # 'c'; the chars of the alphabet are iterated instead)
    var up: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var i: int = 0
    for lc in "abcdefghijklmnopqrstuvwxyz".chars()
        if up[i] == ch
            return lc.toString()
        i = i + 1
    return ch.toString()

# V's reserved words a Zebra name may collide with
# whether a statement list's last statement leaves it (the region's pop was
# emitted before the jump, and V refuses a statement after one)
def endsWithJump(stmts: List(Stmt)): bool
    if stmts.count() == 0
        return false
    branch stmts.at(stmts.count() - 1)
        on Stmt.return_
            return true
        on Stmt.raise_
            return true
        on Stmt.break_
            return true
        on Stmt.continue_
            return true
        else
            return false

# `_zbr_free_at_sweep(<ident>)` -> the ident, else "". A prefix match on the call, so a
# renamed local does not reopen the refusal; anything but a plain identifier argument is
# not this shape and falls through to the zig-literal refusal.
def freeAtSweepArg(t: str): str
    var pre: str = "_zbr_free_at_sweep("
    if not t.startsWith(pre) or not t.endsWith(")")
        return ""
    var id: str = t[pre.len .. t.len - 1].trim()
    if id == ""
        return ""
    var i: int = 0
    while i < id.len
        var c: char = id[i]
        var ok: bool = (c >= c'a' and c <= c'z') or (c >= c'A' and c <= c'Z') or c == c'_' or (i > 0 and c >= c'0' and c <= c'9')
        if not ok
            return ""
        i = i + 1
    return id

# The functions V's builtin module keeps to itself (vlib/builtin/*.v, the private top-level
# ones, as of the V pin). A program function of the same name and signature is silently
# given the builtin's body by V master's C generator -- `fn new_node() &Node` came back as
# the sorted map's `new_node() &mapnode`, every field default gone (vlang/v#32404; with
# another signature the C does not build). `class Node` writes exactly that constructor, so
# such a name gets a trailing `_` here. tools/v_check.sh's names row reads the same files
# beside the V in use and fails when this list has fallen behind them.
def vBuiltinPrivateNames(): str
    # one literal: this is asked of every identifier the emitter writes, and a string built
    # here would be built (and kept) each time
    return " __as_cast __at_least_one __malloc_at_least_one __new_array __new_array_aligned __new_array_noscan __new_array_with_array_default __new_array_with_array_default_noscan __new_array_with_default __new_array_with_default_noscan __new_array_with_map_default __new_array_with_multi_default __new_array_with_multi_default_noscan __print_assert_failure __v2_flag_all_int __v2_flag_has_int _ht_alloc _ht_free _memory_panic _write_buf_to_fd _writeln_to_fd abs64 add_unhandled_exception_handler alloc_array_data alloc_array_data_aligned alloc_array_data_noscan alloc_array_data_noscan_uninit alloc_array_data_uninit arena_align arena_alloc arena_alloc_current arena_checked arena_chunk_header_size arena_chunk_release arena_grow arena_lock arena_owner arena_owns_ptr arena_range_set arena_range_start arena_range_stop arena_realloc arena_registry_add arena_registry_begin_write arena_registry_end_write arena_registry_find arena_registry_remove arena_registry_upper arena_release_chunks arena_unlock array_data_allocation_size array_data_header_size array_sort_move autostr_addr_pop autostr_addr_type_in_stack autostr_addr_type_push backtrace_addr2line_executable backtrace_current_executable_name backtrace_exec_capture backtrace_shell_quote break_if_debugger_attached bsd_backtrace_resolve_atos builtin_init compare_lower_strings compare_strings_by_len copy_element_to data_alignment_exponent data_to_hex_string demangle_backtrace_sym demangle_v_symbol dense_array_allocate dense_array_free dense_array_resize drop_owned_result_error drop_owned_result_error_interface eprint_libbacktrace eprint_space_padding fabs32 fabs64 fast_string_eq format_float_sb free_unaliased gc_prepare_for_debugger_init gc_report_fatal_errors_on_stderr gc_restore_roots_after_debugger_init gc_runtime_init grapheme_break_property grapheme_hex_byte grapheme_hex_nibble grapheme_range_value grapheme_state_from_rune impl_i64_to_string impl_utf8_to_utf32 in_grapheme_ranges init_array_data install_segfault_handler instal