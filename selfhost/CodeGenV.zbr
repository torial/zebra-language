# CodeGenV.zbr -- a V backend, proof of concept (2026-10-13).
#
# A second emitter over the same front end (Parser -> Resolver -> ASTBuilder):
# `zebra --target v file.zbr` writes file.v beside the source, for `v run`.
# The subset: free functions, classes (fields, `cue init`, methods), local
# and module-level vars, if / else if / else, while, `for x in list`,
# `for i in a.to(b)`, assign (and the compound ops), return, break,
# continue, print, assert, calls, member access, `this`, binary and unary
# ops, the literals, list literals, string interpolation, if-expressions,
# and a hand-mapped slice of the stdlib surface (str, List, Math, the
# numeric conversions). Everything else is REFUSED by name and line and
# listed at the end of the run -- nothing is skipped silently (the Zig
# emitter's method surface alone is 2,856 lines; the refusal list is the
# honest measure of the distance).
#
# V's own rules the emitter carries: function, method, variable and field
# names are snake_case (V refuses uppercase in them), types are
# CapitalCase, Zebra's int is 64-bit so it is V's i64, `this` is `self`,
# a class is a struct with `mut:` fields, `cue init` is `fn new_<name>()
# &Name`, a method is `fn (mut self Name) m()`.

use Ast exposing Module, Decl, DeclClass, DeclStruct, DeclEnum, EnumMember, DeclUnion, UnionVariant, DeclMethod, DeclVar, DeclInit, Param, TypeRef, NamedTypeRef, GenericTypeRef, Stmt, StmtIf, ElseIf, StmtWhile, StmtForIn, StmtForNum, StmtReturn, StmtAssert, StmtAssign, AssignOp, StmtPrint, StmtBranch, BranchOn, StmtRaise, StmtTryCatch, CatchClause, ExprTry, ExprCatch, Expr, ExprIntLit, IntBase, ExprFloatLit, ExprBoolLit, ExprCharLit, ExprSlice, ExprCast, ExprChainedCmp, ExprLambda, LambdaBody, DeclSig, ExprStringLit, StringKind, ExprStringInterp, StringPart, ExprIdent, ExprMember, ExprCall, Arg, ExprIndex, ExprBinary, BinaryOp, ExprUnary, UnaryOp, ExprListLit, ExprIf, ExprTypeCheck, Span

# a callee's parameters, for named arguments and defaults at the call
# (and which are references, hence `mut`)
class FnSig
    var names: List(str)
    var has_default: List(bool)
    var defaults: List(Expr)      # a nil placeholder where has_default is false
    var refs: List(bool)

    cue init()
        .names = List(str)()
        .has_default = List(bool)()
        .defaults = List(Expr)()
        .refs = List(bool)()

# the emitter's answer: the V source and what it refused
class VResult
    var source: str
    var refused: List(str)
    var needs_math: bool
    var has_globals: bool    # a `__global` was emitted: the run needs -enable-globals

    cue init(source: str, refused: List(str), needs_math: bool, has_globals: bool = false)
        .source = source
        .refused = refused
        .needs_math = needs_math
        .has_globals = has_globals

# "setAnimate" -> "set_animate"; "winDist" -> "win_dist"; "x" -> "x"
def snakeCase(name: str): str
    if isAllCaps(name)
        return name.lower()   # CUE_NAMES -> cue_names
    var out: str = ""
    var first: bool = true
    for ch in name.chars()
        if ch >= 'A' and ch <= 'Z'
            if not first
                out = out + "_"
            out = out + lowerOf(ch)
        else
            out = out + ch.toString()
        first = false
    return out

def isAllCaps(name: str): bool
    var any: bool = false
    for ch in name.chars()
        if ch >= 'a' and ch <= 'z'
            return false
        if ch >= 'A' and ch <= 'Z'
            any = true
    return any

def lowerOf(ch: char): str
    # (a str index is a byte, and a byte's toString is its number -- "99" for
    # 'c'; the chars of the alphabet are iterated instead)
    var up: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var i: int = 0
    for lc in "abcdefghijklmnopqrstuvwxyz".chars()
        if up[i] == ch
            return lc.toString()
        i = i + 1
    return ch.toString()

# V's reserved words a Zebra name may collide with
def vSafe(name: str): str
    var s = snakeCase(name)
    if s.startsWith("_")
        s = "u" + s   # V refuses a name beginning with `_`
    if s == "match" or s == "type" or s == "struct" or s == "fn" or s == "mut" or s == "pub" or s == "import" or s == "module" or s == "go" or s == "select" or s == "lock" or s == "rlock" or s == "shared" or s == "atomic" or s == "none" or s == "sizeof" or s == "typeof" or s == "unsafe" or s == "defer" or s == "goto" or s == "asm" or s == "union" or s == "interface" or s == "enum" or s == "const" or s == "in" or s == "is" or s == "as" or s == "or" or s == "isreftype" or s == "dump" or s == "spawn" or s == "volatile" or s == "static" or s == "nil"
        return s + "_"
    return s

class VGen
    var sb: StringBuilder
    var depth: int
    var refused: List(str)
    var class_names: List(str)
    var struct_names: List(str)   # value types: V structs by value
    var enum_names: List(str)
    var union_names: List(str)    # V sum types over per-variant structs
    var sigs: HashMap(str, FnSig) # by callee name: a function, `new_<type>`, a method (a name shared across types keeps the first)
    var member_counts: HashMap(str, int)   # a union's variants, an enum's members: whether a branch over them is exhaustive (V refuses an `else` on an exhaustive match)
    var current_params: List(Param)   # the enclosing def's parameters (a def-level catch closes over them)
    var current_ret: str              # the enclosing def's V return type ("" for none)
    var in_method: bool               # inside a method (a def-level catch there is refused: a closure's capture of self is V's call)
    var catch_bindings: List(str)     # the error bindings in scope: `e.message` is `e.msg()` on these
    var current_fields: List(str)     # the enclosing class's / struct's fields: a bare name among them is `self.<field>`
    var module_names: List(str)       # the used modules' names: `Mod.Name` is `Name` in the one V file
    var current_methods: List(str)    # the enclosing class's instance methods: a bare call among them is `self.m(...)`
    var current_statics: List(str)    # the enclosing class's static methods: a bare call among them is `class_m(...)`
    var local_types: HashMap(str, str)  # the V type of each param and local declared so far (what a receiver is)
    var field_types: HashMap(str, str)  # the V type of each field of the enclosing class / struct
    var heap_names: List(str)         # the structs some `^T` targets: reference types in V (their constructors allocate)
    var global_types: HashMap(str, str)  # the V type of each module-level var
    var union_payloads: HashMap(str, str)   # `U_v` -> the V type of the variant's payload
    var current_file: str             # the module being emitted (a refusal names it)
    var has_globals: bool             # a `__global` was emitted
    var sig_conflicts: List(str)      # a callee name two declarations share with different parameters: called by position
    var rets: HashMap(str, str)       # the V return type of each def / method by name (`Owner.name` for a static), "" when two differ
    var all_field_types: HashMap(str, str)  # `Name.field` -> the V type, every class and struct
    var local_names: List(str)        # the params and locals declared so far in the enclosing def (they shadow a field)
    var matchN: int               # the temporaries bound for `branch`
    var current_class: str        # "" outside a class
    var needs_math: bool
    var tmpN: int                 # the temporaries bound for mutating calls on call results
    var ref_params: HashMap(str, List(bool))   # by callee name (a function, `new_<class>`, a method): which params are references, hence `mut` (V's rule for a param mutated through a method; a method name shared across classes keeps the first)

    cue init()
        .sb = StringBuilder()
        .depth = 0
        .refused = List(str)()
        .class_names = List(str)()
        .struct_names = List(str)()
        .enum_names = List(str)()
        .union_names = List(str)()
        .sigs = HashMap(str, FnSig)()
        .member_counts = HashMap(str, int)()
        .current_params = List(Param)()
        .current_ret = ""
        .in_method = false
        .catch_bindings = List(str)()
        .current_fields = List(str)()
        .module_names = List(str)()
        .current_methods = List(str)()
        .current_statics = List(str)()
        .local_types = HashMap(str, str)()
        .field_types = HashMap(str, str)()
        .heap_names = List(str)()
        .global_types = HashMap(str, str)()
        .union_payloads = HashMap(str, str)()
        .current_file = ""
        .has_globals = false
        .sig_conflicts = List(str)()
        .rets = HashMap(str, str)()
        .all_field_types = HashMap(str, str)()
        .local_names = List(str)()
        .matchN = 0
        .current_class = ""
        .needs_math = false
        .tmpN = 0
        .ref_params = HashMap(str, List(bool))()

    def refuse(what: str, span: Span)
        .refused.add(what + " (" + .current_file + ":" + span.line.toString() + ")")

    def line(s: str)
        var i: int = 0
        while i < .depth
            .sb.append("\t")
            i = i + 1
        .sb.append(s)
        .sb.append("\n")

    # ── types ──────────────────────────────────────────────────────────────
    def vType(t: TypeRef?): str
        if t == nil
            return ""
        branch t!
            on TypeRef.named as n
                return .vNamed(n.name)
            on TypeRef.generic as g
                # the containers are references, as Zebra's are: the runtime's
                # boxed ZList / ZMap by reference (zebra_rt.v), never V's value arrays
                if g.name == "List" and g.args.count() == 1
                    return "&ZList[" + .vType(g.args.at(0)) + "]"
                if g.name == "HashMap" and g.args.count() == 2
                    return "&ZMap[" + .vType(g.args.at(0)) + ", " + .vType(g.args.at(1)) + "]"
                if g.name == "Set" and g.args.count() == 1
                    return "&ZSet[" + .vType(g.args.at(0)) + "]"
                .refused.add("generic type " + g.name)
                return "voidptr"
            on TypeRef.void_
                return ""
            on TypeRef.nilable as inner
                return "?" + .vType(inner)
            on TypeRef.ref_to as inner
                # `^T`: a reference; a class or a heap struct is one already, and
                # a union is V's sum type -- a boxed fat pointer by value
                var s: str = .vType(inner)
                if s.startsWith("?")
                    # `^T?`: an option of the reference (`?&Name`), of the union (`?U`)
                    var core: str = s.substring(1, s.len)
                    if core.startsWith("&") or .isUnionName(core)
                        return s
                    return "?&" + core
                if s.startsWith("&") or .isUnionName(s)
                    return s
                return "&" + s
            else
                .refused.add("a type the subset does not spell (stream, error union, tuple, fn)")
                return "voidptr"

    def vNamed(qualified: str): str
        # `Token.Token` (a type of a used module) is `Token` in the one V file
        var segs: List(str) = qualified.split(".")
        var name: str = segs.at(segs.count() - 1)
        if name == "int": return "i64"
        if name == "float": return "f64"
        if name == "str": return "string"
        if name == "bool": return "bool"
        if name == "char": return "u8"
        if name == "void": return ""
        if name == "StringBuilder": return "&ZStringBuilder"
        for cn in .class_names
            if cn == name
                return "&" + name
        return name

    def isStructName(name: str): bool
        for sn in .struct_names
            if sn == name
                return true
        return false

    def isEnumName(name: str): bool
        for en in .enum_names
            if en == name
                return true
        return false

    def isUnionName(name: str): bool
        for un in .union_names
            if un == name
                return true
        return false

    def isClassName(name: str): bool
        for cn in .class_names
            if cn == name
                return true
        return false

    def isModuleName(name: str): bool
        for mn in .module_names
            if mn == name
                return true
        return false

    # the name a static access stands on: `Name.x` -> Name, `Mod.Name.x` ->
    # Name when Mod is a used module; "" when the object is an expression
    def staticOwner(obj: Expr): str
        branch obj
            on Expr.ident as id
                return id.name
            on Expr.member as m
                branch m.object
                    on Expr.ident as id
                        if .isModuleName(id.name)
                            return m.member
                    else
                        pass
                return ""
            else
                return ""

    def isModuleIdent(obj: Expr): bool
        branch obj
            on Expr.ident as id
                return .isModuleName(id.name)
            else
                return false

    # ── the module ─────────────────────────────────────────────────────────
    # every module in one V file: the used modules first (their declarations
    # the root's depend on), the root last; the passes see all of them
    def genModules(ms: List(Module)): str
        for m in ms
            for d in m.decls
                branch d
                    on Decl.use_ as u
                        var segs: List(str) = u.path.split("/")
                        .module_names.add(segs.at(segs.count() - 1))
                    else
                        pass
        for m in ms
            .noteTypeNames(m)
        for m in ms
            .noteRefTargets(m)
        for m in ms
            .noteFieldTypes(m)
        for m in ms
            .noteRets(m)
        for m in ms
            .noteSigs(m)
        var last: int = ms.count() - 1
        var mi: int = 0
        for m in ms
            .current_file = m.file
            .line("// -- " + m.file + " --")
            for d in m.decls
                var skip: bool = false
                if mi != last
                    branch d
                        on Decl.method as mth
                            if mth.name == "main"
                                skip = true   # a used module's main: the root's runs
                                .line("// (" + m.file + "'s main is not emitted: the root's runs)")
                        else
                            pass
                if not skip
                    .genDecl(d)
            mi = mi + 1
        return .sb.build()

    def noteTypeNames(m: Module)
        # the classes first, so a field or a return of a class type is `&Name`
        for d in m.decls
            branch d
                on Decl.class_ as c
                    .class_names.add(c.name)
                on Decl.struct_ as st
                    .struct_names.add(st.name)
                on Decl.enum_ as en
                    .enum_names.add(en.name)
                    .member_counts.set(en.name, en.members.count())
                on Decl.union_ as un
                    .union_names.add(un.name)
                    .member_counts.set(un.name, un.variants.count())
                else
                    pass

    # a struct named under `^` anywhere (a union's payload, a field, a param,
    # a return) is a reference type in V: `&Name` wherever it is named, its
    # constructor allocating -- V cannot take the address of a call's result,
    # and a boxed node is a reference on the Zig backend too. The cost: a
    # by-value copy of such a struct elsewhere is a shared reference in V.
    def noteRefTargets(m: Module)
        for d in m.decls
            branch d
                on Decl.union_ as un
                    for v in un.variants
                        .refWalk(v.payload)
                on Decl.class_ as c
                    .refWalkMembers(c.members)
                on Decl.struct_ as st
                    .refWalkMembers(st.members)
                on Decl.method as mth
                    .refWalkMethod(mth)
                on Decl.var_ as gv
                    .refWalk(gv.type_)
                else
                    pass

    def refWalkMembers(members: List(Decl))
        for mem in members
            branch mem
                on Decl.var_ as f
                    .refWalk(f.type_)
                on Decl.method as mth
                    .refWalkMethod(mth)
                on Decl.init as ini
                    for p in ini.params
                        .refWalk(p.type_)
                else
                    pass

    def refWalkMethod(mth: DeclMethod)
        for p in mth.params
            .refWalk(p.type_)
        .refWalk(mth.return_type)

    def refWalk(t: TypeRef?)
        if t == nil
            return
        branch t!
            on TypeRef.ref_to as inner
                branch inner
                    on TypeRef.named as n
                        .markHeap(n.name)
                    else
                        pass
                .refWalk(inner)
            on TypeRef.nilable as inner
                .refWalk(inner)
            on TypeRef.generic as g
                for a in g.args
                    .refWalk(a)
            else
                pass

    def markHeap(qualified: str)
        var segs: List(str) = qualified.split(".")
        var name: str = segs.at(segs.count() - 1)
        if .isStructName(name) and not .isHeapName(name)
            .heap_names.add(name)
            var i: int = 0
            while i < .struct_names.count()
                if .struct_names.at(i) == name
                    .struct_names.remove(i)   # (Zebra's List.remove takes an index)
                    i = .struct_names.count()
                i = i + 1
            .class_names.add(name)

    def isHeapName(name: str): bool
        for h in .heap_names
            if h == name
                return true
        return false

    # every variant's payload type and every type's field types, for the
    # receiver-type reads (an `as` capture, a branch binding, a field chain)
    # the return type of every def and method, for a call's type
    def noteRets(m: Module)
        for d in m.decls
            branch d
                on Decl.method as mth
                    .noteRet(mth.name, mth)
                on Decl.class_ as c
                    .noteRetsOf(c.name, c.members)
                on Decl.struct_ as st
                    .noteRetsOf(st.name, st.members)
                else
                    pass

    def noteRetsOf(owner: str, members: List(Decl))
        for mem in members
            branch mem
                on Decl.method as mth
                    if mth.mods.is_static
                        .noteRet(owner + "." + mth.name, mth)
                    else
                        .noteRet(mth.name, mth)
                else
                    pass

    def noteRet(key: str, mth: DeclMethod)
        var rt: str = .vType(mth.return_type)
        if .rets.get(key) as have
            if have != rt
                .rets.set(key, "")   # two declarations of the name differ: unknown
            return
        .rets.set(key, rt)

    # the V type of a call's result ("" when unknown)
    def retOf(c: ExprCall): str
        branch c.callee
            on Expr.ident as id
                if .rets.get(id.name) as r
                    return r
                return ""
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isClassName(owner) or .isStructName(owner)
                    if .rets.get(owner + "." + m.member) as r
                        return r
                    return ""
                if .rets.get(m.member) as r
                    return r
                return ""
            else
                return ""

    def noteFieldTypes(m: Module)
        for d in m.decls
            branch d
                on Decl.union_ as un
                    for v in un.variants
                        if v.payload as pt
                            .union_payloads.set(un.name + "_" + v.name, .vType(pt))
                on Decl.class_ as c
                    .noteFieldsOf(c.name, c.members)
                on Decl.struct_ as st
                    .noteFieldsOf(st.name, st.members)
                else
                    pass

    def noteFieldsOf(owner: str, members: List(Decl))
        for mem in members
            branch mem
                on Decl.var_ as f
                    .all_field_types.set(owner + "." + f.name, .vType(f.type_))
                else
                    pass

    # `U_v` when the expression is a payload-less variant (`U.v` or `U.v()`), else ""
    def variantTypeName(e: Expr): str
        branch e
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner + "_" + m.member
                return ""
            on Expr.call as c
                if c.args.count() != 0
                    return ""
                branch c.callee
                    on Expr.member as m
                        var owner: str = .staticOwner(m.object)
                        if .isUnionName(owner)
                            return owner + "_" + m.member
                        return ""
                    else
                        return ""
            else
                return ""

    def noteSigs(m: Module)
        # the second pass: every callee's signature -- the parameter names and
        # defaults (named arguments are reordered to positions at the call,
        # missing ones filled from the defaults) and which are references (V
        # wants `mut` on a param mutated through a method, at the declaration
        # and at the call)
        for d in m.decls
            branch d
                on Decl.method as mth
                    .noteSig(vSafe(mth.name), mth.params)
                on Decl.class_ as c
                    .noteMembers("new_" + snakeCase(c.name), c.members)
                on Decl.struct_ as st
                    .noteMembers("new_" + snakeCase(st.name), st.members)
                    .noteImplicitCtor("new_" + snakeCase(st.name), st.members)
                else
                    pass

    def genDecl(d: Decl)
        branch d
            on Decl.class_ as c
                .genClass(c)
            on Decl.method as mth
                .genFunction(mth)
            on Decl.var_ as v
                .genGlobal(v)
            on Decl.use_
                pass   # the route folded the used module into this file
            on Decl.struct_ as st
                .genStruct(st)
            on Decl.enum_ as en
                .genEnum(en)
            on Decl.interface_ as i
                .refuse("interface " + i.name, i.span)
            on Decl.union_ as un
                .genUnion(un)
            on Decl.sig_ as sg
                # a function type: `sig F(c: char): bool` -> `type F = fn (c u8) bool`
                var ret = .vType(sg.return_type)
                var head = "type " + sg.name + " = fn (" + .genParams(sg.params) + ")"
                if ret != ""
                    head = head + " " + ret
                .line(head)
                .line("")
            on Decl.namespace_ as ns
                .refuse("namespace " + ns.name + " (flattening is the next step)", ns.span)
            else
                .refused.add("a declaration kind the subset does not spell (mixin, extend, type alias)")

    def genGlobal(v: DeclVar)
        if v.init_expr != nil
            var rhs: str = .exprStr(v.init_expr!)
            if v.type_ as t
                var gt: str = .vType(t)
                .global_types.set(v.name, gt)
                if gt == "i64" and isIntLit(v.init_expr!)
                    rhs = "i64(" + rhs + ")"
            if v.is_const
                .line("const " + vSafe(v.name) + " = " + rhs)
            else
                # a mutable module-level var: V's __global, which the run must
                # enable (-enable-globals on the run line the route prints)
                .line("__global (")
                .line("\t" + vSafe(v.name) + " = " + rhs)
                .line(")")
                .has_globals = true
        else
            .refuse("module-level var " + v.name + " without an initializer", v.span)

    def noteMembers(ctor: str, members: List(Decl))
        for mem in members
            branch mem
                on Decl.init as ini
                    .noteSig(ctor, ini.params)
                on Decl.method as cm
                    .noteSig(vSafe(cm.name), cm.params)
                else
                    pass

    # a struct with no `cue init` is constructed from its fields, every one
    # named or in order, a missing one zero (Zebra's implicit constructor)
    def noteImplicitCtor(ctor: str, members: List(Decl))
        if .sigs.get(ctor) != nil
            return
        var fsig = FnSig()
        for mem in members
            branch mem
                on Decl.var_ as f
                    fsig.names.add(f.name)
                    fsig.has_default.add(true)
                    fsig.defaults.add(.zeroExpr(f))
                    fsig.refs.add(.isRefType(f.type_))
                else
                    pass
        .sigs.set(ctor, fsig)

    # a field's zero as an expression the call can spell (the literal kinds;
    # a container or a class field falls back to nil, which the V side
    # spells as its constructor through zeroOf at the struct literal)
    def zeroExpr(f: DeclVar): Expr
        var t = .vType(f.type_)
        if t == "i64": return Expr.int_lit(ExprIntLit(f.span, "0", IntBase.decimal))
        if t == "f64": return Expr.float_lit(ExprFloatLit(f.span, "0.0"))
        if t == "string": return Expr.string_lit(ExprStringLit(f.span, StringKind.plain, ""))
        if t == "bool": return Expr.bool_lit(ExprBoolLit(f.span, false))
        return Expr.nil_(f.span)

    def noteSig(name: str, params: List(Param))
        if .sigs.get(name) as have
            # another declaration of this name: the same parameter names keep the
            # table's entry; different ones make the name positional-only
            var same: bool = have.names.count() == params.count()
            if same
                var k: int = 0
                for p in params
                    if have.names.at(k) != p.name
                        same = false
                    k = k + 1
            if not same
                .sig_conflicts.add(name)
            return
        var fsig = FnSig()
        for p in params
            fsig.names.add(p.name)
            if p.default_ as d
                fsig.has_default.add(true)
                fsig.defaults.add(d)
            else
                fsig.has_default.add(false)
                fsig.defaults.add(Expr.nil_(p.span))
            fsig.refs.add(.isRefType(p.type_))
        .sigs.set(name, fsig)
        var flags = List(bool)()
        for p in params
            flags.add(.isRefType(p.type_))
        .ref_params.set(name, flags)

    # a container or a class: by reference in V, so `mut` when passed to be mutated
    # a parameter (or a capture) of this type is `mut`: a reference (a class,
    # a heap struct, a container). Not a value struct: V would then demand
    # `mut` at every call site, and a method name many classes share is
    # called by position. `f(mut p.field)` through an immutable parameter is
    # the call site's problem (argsBySig binds the field to a local first).
    def isRefType(t: TypeRef?): bool
        if t == nil
            return false
        return .vType(t).startsWith("&")

    def genParams(params: List(Param)): str
        var out: str = ""
        var first: bool = true
        for p in params
            if not first
                out = out + ", "
            first = false
            var mut_: str = ""
            if .isRefType(p.type_)
                mut_ = "mut "
            out = out + mut_ + vSafe(p.name) + " " + .vType(p.type_)
        return out

    # a `throws` def returns V's result (`!T`, `!` for none); `raise` is
    # `return error(...)`, `?` is `!`
    def retType(m: DeclMethod): str
        var ret = .vType(m.return_type)
        if m.throws_
            return "!" + ret
        return ret

    def genFunction(m: DeclMethod)
        var ret = .retType(m)
        var head = "fn " + vSafe(m.name) + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + ret
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .in_method = false
        .resetLocals(m.params)
        if m.stmts as body
            .genStmts(body)
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── classes ────────────────────────────────────────────────────────────
    def genClass(c: DeclClass)
        if c.type_params.count() > 0
            .refuse("class " + c.name + " with type parameters", c.span)
        if c.ifaces.count() > 0 or c.mixins.count() > 0
            .refuse("class " + c.name + " implements / mixes in (interfaces are outside the subset)", c.span)
        .line("struct " + c.name + " {")
        .line("mut:")
        .depth = .depth + 1
        for mem in c.members
            branch mem
                on Decl.var_ as f
                    .line(vSafe(f.name) + " " + .vType(f.type_))
                else
                    pass
        .depth = .depth - 1
        .line("}")
        .line("")
        .current_class = c.name
        .current_fields = fieldNames(c.members)
        .field_types = .fieldTypes(c.members)
        .current_methods = methodNames(c.members, false)
        .current_statics = methodNames(c.members, true)
        var had_init: bool = false
        for mem in c.members
            branch mem
                on Decl.init as ini
                    had_init = true
                    .genInit(ini, c.name, c.members)
                on Decl.method as mth
                    if mth.mods.is_static
                        .genStaticMethod(mth, c.name)
                    else
                        .genMethod(mth, c.name)
                on Decl.var_
                    pass
                else
                    .refuse("a member kind the subset does not spell in class " + c.name, c.span)
        if not had_init
            .line("fn new_" + snakeCase(c.name) + "() &" + c.name + " {")
            .depth = .depth + 1
            .line("return " + .structLit(c.name, c.members))
            .depth = .depth - 1
            .line("}")
            .line("")
        .current_class = ""
        .current_methods = List(str)()
        .current_statics = List(str)()
        .current_fields = List(str)()

    # `&Name{ ... }` with every reference field initialised (V refuses an
    # uninitialised reference field): a container by its constructor, a
    # class-typed field by `unsafe { nil }` (Zebra's zero for it)
    def structLit(owner: str, members: List(Decl), by_ref: bool = true): str
        var out: str = owner + "{"
        if by_ref
            out = "&" + out
        var any: bool = false
        for mem in members
            branch mem
                on Decl.var_ as f
                    var ft = .vType(f.type_)
                    if ft.startsWith("&")
                        var field_init: str = "unsafe { nil }"   # (not `init`: it shadows a declaration in the emitted Zig)
                        if ft.startsWith("&ZList[") or ft.startsWith("&ZMap[")
                            field_init = .zeroOf(ft)
                        if not any
                            out = out + "\n"
                        any = true
                        out = out + "\t" + vSafe(f.name) + ": " + field_init + "\n"
                else
                    pass
        return out + "}"

    # ── value structs: V structs by value, a constructor by value, methods
    #    `mut` when the body assigns to a field ──────────────────────────────
    def genStruct(st: DeclStruct)
        if st.ifaces.count() > 0
            .refuse("struct " + st.name + " implements (interfaces are outside the subset)", st.span)
        var heap: bool = .isHeapName(st.name)
        var ret_name: str = st.name
        if heap
            .line("@[heap]")
            ret_name = "&" + st.name
        .line("struct " + st.name + " {")
        .line("pub mut:")
        .depth = .depth + 1
        for mem in st.members
            branch mem
                on Decl.var_ as f
                    .line(vSafe(f.name) + " " + .vType(f.type_))
                else
                    pass
        .depth = .depth - 1
        .line("}")
        .line("")
        .current_class = st.name
        .current_fields = fieldNames(st.members)
        .field_types = .fieldTypes(st.members)
        .current_methods = methodNames(st.members, false)
        .current_statics = methodNames(st.members, true)
        var had_init: bool = false
        for mem in st.members
            branch mem
                on Decl.init as ini
                    had_init = true
                    .line("fn new_" + snakeCase(st.name) + "(" + .genParams(ini.params) + ") " + ret_name + " {")
                    .depth = .depth + 1
                    .resetLocals(ini.params)
                    .line("mut self := " + .structLit(st.name, st.members, heap))
                    if ini.stmts as body
                        .genStmts(body)
                    .line("return self")
                    .depth = .depth - 1
                    .line("}")
                    .line("")
                on Decl.method as mth
                    .genValueMethod(mth, st.name)
                on Decl.var_
                    pass
                else
                    .refuse("a member kind the subset does not spell in struct " + st.name, st.span)
        if not had_init
            # the implicit constructor: every field a parameter, in order
            var ps: str = ""
            var lit: str = st.name + "{"
            var any: bool = false
            for mem in st.members
                branch mem
                    on Decl.var_ as f
                        if ps != ""
                            ps = ps + ", "
                        if .isRefType(f.type_)
                            ps = ps + "mut "   # (the recorded signature flags it: the call passes `mut`)
                        ps = ps + vSafe(f.name) + " " + .vType(f.type_)
                        if not any
                            lit = lit + "\n"
                        any = true
                        lit = lit + "\t" + vSafe(f.name) + ": " + vSafe(f.name) + "\n"
                    else
                        pass
            if heap
                lit = "&" + lit
            .line("fn new_" + snakeCase(st.name) + "(" + ps + ") " + ret_name + " {")
            .depth = .depth + 1
            .line("return " + lit + "}")
            .depth = .depth - 1
            .line("}")
            .line("")
        .current_class = ""
        .current_methods = List(str)()
        .current_statics = List(str)()
        .current_fields = List(str)()

    # a struct's method: `mut self` only when the body assigns to a field
    # (V refuses a mutation through an immutable receiver, and warns on a
    # `mut` never used); `cue toString()` is V's str()
    def genValueMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var mname = vSafe(m.name)
        if m.name == "toString" and m.params.count() == 0
            mname = "str"
        var recv: str = "self " + owner
        if m.stmts as body0
            if stmtsAssignThis(body0)
                recv = "mut self " + owner
        var head = "fn (" + recv + ") " + mname + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + ret
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .in_method = true
        .resetLocals(m.params)
        if m.stmts as body
            .genStmts(body)
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── enums ──────────────────────────────────────────────────────────────
    def genEnum(en: DeclEnum)
        if en.base != nil
            .refuse("enum " + en.name + " with a base type", en.span)
        .line("enum " + en.name + " {")
        .depth = .depth + 1
        for mem in en.members
            if mem.value != nil
                .refuse("enum member " + en.name + "." + mem.name + " with a value", mem.span)
            .line(vSafe(mem.name))
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── unions: a V sum type over one struct per variant (`U_v { payload T }`,
    #    empty when the variant carries none) ─────────────────────────────────
    def genUnion(un: DeclUnion)
        var names: str = ""
        for v in un.variants
            var vname = un.name + "_" + v.name
            if names != ""
                names = names + " | "
            names = names + vname
            if v.payload as pt
                .line("struct " + vname + " {")
                .line("pub mut:")
                .line("\tpayload " + .vType(pt))
                .line("}")
            else
                .line("struct " + vname + " {}")
            .line("")
        .line("type " + un.name + " = " + names)
        .line("")

    def genInit(ini: DeclInit, owner: str, members: List(Decl))
        .line("fn new_" + snakeCase(owner) + "(" + .genParams(ini.params) + ") &" + owner + " {")
        .depth = .depth + 1
        .resetLocals(ini.params)
        .line("mut self := " + .structLit(owner, members))
        if ini.stmts as body
            .genStmts(body)
        .line("return self")
        .depth = .depth - 1
        .line("}")
        .line("")

    # a `static def` is a free function named <class>_<method>; a call on the
    # class's name reaches it
    def genStaticMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var head = "fn " + snakeCase(owner) + "_" + vSafe(m.name) + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + ret
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .in_method = false
        .resetLocals(m.params)
        var saved = .current_fields
        .current_fields = List(str)()   # no self in a static method
        if m.stmts as body
            .genStmts(body)
        .current_fields = saved
        .depth = .depth - 1
        .line("}")
        .line("")

    def resetLocals(params: List(Param))
        .local_names = List(str)()
        .local_types = HashMap(str, str)()
        for p in params
            .local_names.add(p.name)
            var pt: str = .vType(p.type_)
            if pt != ""
                .local_types.set(p.name, pt)

    def fieldTypes(members: List(Decl)): HashMap(str, str)
        var out = HashMap(str, str)()
        for mem in members
            branch mem
                on Decl.var_ as f
                    out.set(f.name, .vType(f.type_))
                else
                    pass
        return out

    # the V type of a name or a field access, "" when the emitter does not
    # know it (a call's result, an element): a local or a param first, then
    # a field of the enclosing type (bare, or through self)
    def vTypeOf(e: Expr): str
        branch e
            on Expr.ident as id
                if .local_types.get(id.name) as lt
                    return lt
                if .isCurrentField(id.name)
                    if .field_types.get(id.name) as ft
                        return ft
                if .global_types.get(id.name) as gt
                    return gt
                return ""
            on Expr.member as m
                if exprRootIsThis(m.object)
                    if .field_types.get(m.member) as ft
                        return ft
                var ot: str = .vTypeOf(m.object)
                if ot.startsWith("&")
                    ot = ot.substring(1, ot.len)
                if ot != ""
                    if .all_field_types.get(ot + "." + m.member) as ft2
                        return ft2
                return ""
            on Expr.call as c
                # `xs.at(i)`: the list's element type; else the callee's return type
                branch c.callee
                    on Expr.member as cm
                        if cm.member == "at" and c.args.count() == 1
                            return .elemOf(.vTypeOf(cm.object))
                        return .retOf(c)
                    else
                        return .retOf(c)
            on Expr.try_ as t
                return .vTypeOf(t.expr)   # `f()?`: the result's type
            else
                return ""

    # a binding of this type is `mut`: a struct, a class or a container may
    # be passed on as `mut x.field`, which V refuses through an immutable one
    def needsMut(vt: str): bool
        # a reference (a class, a heap struct, a container), or a value struct;
        # V refuses `mut` on a sum type, an enum or a function type
        if vt.startsWith("&")
            return true
        return .isStructName(vt)

    # the element type of a list's V type ("" when it is not a list)
    def elemOf(vt: str): str
        if vt.startsWith("&ZList[") and vt.endsWith("]")
            return vt.substring(7, vt.len - 1)
        return ""

    def isContainerType(vt: str): bool
        return vt.startsWith("&ZList[") or vt.startsWith("&ZMap[") or vt.startsWith("&ZSet[")

    # the V type a constructor call makes, "" when it is not one
    def ctorTypeOf(e: Expr): str
        branch e
            on Expr.call as c
                branch c.callee
                    on Expr.ident as id
                        if .isClassName(id.name)
                            return "&" + id.name
                        if .isStructName(id.name)
                            return id.name
                        if id.name == "StringBuilder"
                            return "&ZStringBuilder"
                        return ""
                    on Expr.call as inner
                        branch inner.callee
                            on Expr.ident as cid
                                if cid.name == "List" and inner.args.count() == 1
                                    return "&ZList[" + .typeArgStr(inner.args.at(0).value) + "]"
                                if cid.name == "HashMap" and inner.args.count() == 2
                                    return "&ZMap[" + .typeArgStr(inner.args.at(0).value) + ", " + .typeArgStr(inner.args.at(1).value) + "]"
                                if cid.name == "Set" and inner.args.count() == 1
                                    return "&ZSet[" + .typeArgStr(inner.args.at(0).value) + "]"
                                return ""
                            else
                                return ""
                    else
                        return ""
            else
                return ""

    # the union a variant expression belongs to, "" when it is not one:
    # `U.v(x)`, `U.v()`, `U.v`
    def unionOfExpr(e: Expr): str
        branch e
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        var owner: str = .staticOwner(m.object)
                        if .isUnionName(owner)
                            return owner
                        return ""
                    else
                        return ""
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner
                return ""
            else
                return ""

    def isMethodName(name: str): bool
        for n in .current_methods
            if n == name
                return true
        return false

    def isStaticName(name: str): bool
        for n in .current_statics
            if n == name
                return true
        return false

    def isLocalName(name: str): bool
        for n in .local_names
            if n == name
                return true
        return false

    def isCurrentField(name: str): bool
        for f in .current_fields
            if f == name
                return true
        return false

    def genMethod(m: DeclMethod, owner: str)
        var ret = .retType(m)
        var head = "fn (mut self " + owner + ") " + vSafe(m.name) + "(" + .genParams(m.params) + ")"
        if ret != ""
            head = head + " " + ret
        .line(head + " {")
        .depth = .depth + 1
        .current_params = m.params
        .current_ret = ret
        .in_method = true
        .resetLocals(m.params)
        if m.stmts as body
            .genStmts(body)
        .depth = .depth - 1
        .line("}")
        .line("")

    # ── statements ─────────────────────────────────────────────────────────
    def genStmts(stmts: List(Stmt))
        for s in stmts
            .genStmt(s)

    def genStmt(s: Stmt)
        branch s
            on Stmt.var_ as v
                .genLocal(v)
            on Stmt.assign as a
                var tt: str = .vTypeOf(a.target)
                if isBareCtor(a.value) and tt != ""
                    .line(.exprStr(a.target) + " " + assignOpV(a.op) + " " + .zeroOf(tt))   # `out = List()`: the target's type
                else
                    .line(.exprStr(a.target) + " " + assignOpV(a.op) + " " + .exprStr(a.value))
            on Stmt.expr as e
                .genExprStmt(e)
            on Stmt.if_ as i
                .genIf(i)
            on Stmt.while_ as w
                .line("for " + condStr(.exprStr(w.cond)) + " {")
                .depth = .depth + 1
                .genStmts(w.stmts)
                .depth = .depth - 1
                .line("}")
            on Stmt.for_in as fi
                .genForIn(fi)
            on Stmt.for_num as fnum
                var v = vSafe(fnum.var_)
                .local_names.add(fnum.var_)
                var step: str = "++"
                if fnum.step != nil
                    step = " += " + .exprStr(fnum.step!)
                .line("for " + v + " := i64(" + .exprStr(fnum.start) + "); " + v + " < " + .exprStr(fnum.stop_) + "; " + v + step + " {")
                .depth = .depth + 1
                .genStmts(fnum.stmts)
                .depth = .depth - 1
                .line("}")
            on Stmt.return_ as r
                if r.value as rv
                    .line("return " + .exprStr(rv))
                else
                    .line("return")
            on Stmt.assert_ as asrt
                if asrt.message as msg
                    .line("assert " + .exprStr(asrt.cond) + ", " + .exprStr(msg))
                else
                    .line("assert " + .exprStr(asrt.cond))
            on Stmt.print_ as p
                .genPrint(p)
            on Stmt.break_
                .line("break")
            on Stmt.continue_
                .line("continue")
            on Stmt.pass_
                pass
            on Stmt.branch_ as b
                .genBranch(b)
            on Stmt.raise_ as r
                .genRaise(r)
            on Stmt.try_catch as tc
                .genTryCatch(tc)
            else
                .refused.add("a statement kind the subset does not spell (with, in, destructure, allocate, copy-out, contract, yield)")

    # an expression statement; a mutating method on a call's RESULT binds a
    # temporary first (V: "cannot pass expression as mut"): `rows.at(0).add(7)`
    def genExprStmt(e: Expr)
        branch e
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        if isCallExpr(m.object)
                            .tmpN = .tmpN + 1
                            var t = "zt" + .tmpN.toString()   # (V refuses a name beginning with `_`)
                            .line("mut " + t + " := " + .exprStr(m.object))
                            .line(.mappedCall(t, m.member, c.args, c.span))
                            return
                    else
                        pass
            else
                pass
        .line(.exprStr(e))

    # `raise msg` -> `return error(msg)`; the details, when given, appended to
    # the message (V's error carries one string; nothing dropped)
    def genRaise(r: StmtRaise)
        var msg: str = "'raised'"
        if r.message as m
            msg = .exprStr(m)
        if r.details as d
            msg = "(" + msg + " + ': ' + " + .exprStr(d) + ")"
        .line("return error(" + msg + ")")

    # the def-level `catch |e|`: the body as a result-returning closure over
    # the def's parameters, the catch as its `or` block (V has no try
    # statement; a `return` inside the or block returns from the def, V's own
    # rule, so a value-returning def's catch must return or V says so)
    def genTryCatch(tc: StmtTryCatch)
        if tc.clauses.count() != 1
            .refuse("a catch with " + tc.clauses.count().toString() + " clauses (one is the subset)", tc.span)
        var caps: str = ""
        if .in_method
            caps = "mut self"   # the receiver captured (V allows it; probed)
        for p in .current_params
            if caps != ""
                caps = caps + ", "
            if .isRefType(p.type_)
                caps = caps + "mut " + vSafe(p.name)
            else
                caps = caps + vSafe(p.name)
        var capList: str = ""
        if caps != ""
            capList = "[" + caps + "] "
        var inner: str = .current_ret
        if not inner.startsWith("!")
            inner = "!" + inner
        var lead: str = ""
        if .current_ret != "" and not (.current_ret == "!")
            lead = "return "
        .line(lead + "fn " + capList + "() " + inner + " {")
        .depth = .depth + 1
        .genStmts(tc.stmts)
        .depth = .depth - 1
        .line("}() or {")
        .depth = .depth + 1
        for cl in tc.clauses
            if cl.type_ != nil
                .refuse("a typed catch clause", cl.span)
            if cl.binding as b
                .line(vSafe(b) + " := err")
                .catch_bindings.add(vSafe(b))
                if cl.stmts.count() == 0
                    .line("_ = " + vSafe(b))
            .genStmts(cl.stmts)
            if cl.binding != nil
                .catch_bindings = dropLast(.catch_bindings)
        .depth = .depth - 1
        .line("}")

    # `branch x` as V's `match` on a bound temporary (V smart-casts an
    # identifier, not an expression); a union arm's binding reads the
    # variant's payload; an `else` is always present (V wants exhaustiveness)
    def genBranch(b: StmtBranch)
        .matchN = .matchN + 1
        var t = "zm" + .matchN.toString()   # (V refuses a name beginning with `_`)
        .line(t + " := " + .exprStr(b.expr))
        .line("match " + t + " {")
        .depth = .depth + 1
        for arm in b.cases
            if arm.guard_expr.count() > 0
                .refuse("a branch arm with a guard", arm.span)
            if arm.struct_pat != nil
                .refuse("a branch arm with a struct pattern", arm.span)
            var vals: str = ""
            var first: bool = true
            for v in arm.values
                if not first
                    vals = vals + ", "
                first = false
                vals = vals + .armValueStr(v)
            .line(vals + " {")
            .depth = .depth + 1
            if arm.binding as bnd
                .local_names.add(bnd)
                var lead: str = ""
                if arm.values.count() == 1
                    var vk: str = .armValueStr(arm.values.at(0))
                    if .union_payloads.get(vk) as pt
                        .local_types.set(bnd, pt)
                        if .needsMut(pt)
                            lead = "mut "   # V refuses `mut x.field` through an immutable binding
                .line(lead + vSafe(bnd) + " := " + t + ".payload")
                if arm.stmts.count() == 0
                    .line("_ = " + vSafe(bnd))
            .genStmts(arm.stmts)
            .depth = .depth - 1
            .line("}")
        # V wants a match exhaustive OR with an else, and refuses an else on
        # an exhaustive one: over a union or an enum the arms are counted
        # against the type's members; over a plain value an else is always needed
        var exhaustive: bool = .armsExhaustive(b)
        if b.else_ as es
            if exhaustive
                .line("// (the branch's else: unreachable, every member is an arm; V refuses it)")
            else
                .line("else {")
                .depth = .depth + 1
                .genStmts(es)
                .depth = .depth - 1
                .line("}")
        else if not exhaustive
            .line("else {}")
        .depth = .depth - 1
        .line("}")

    def armsExhaustive(b: StmtBranch): bool
        var subject: str = ""
        var seen = List(str)()
        for arm in b.cases
            for v in arm.values
                branch v
                    on Expr.member as m
                        branch m.object
                            on Expr.ident as id
                                if .isUnionName(id.name) or .isEnumName(id.name)
                                    subject = id.name
                                    var key = m.member
                                    var had: bool = false
                                    for sn in seen
                                        if sn == key
                                            had = true
                                    if not had
                                        seen.add(key)
                            else
                                pass
                    else
                        pass
        if subject == ""
            return false
        return seen.count() >= (.member_counts.get(subject) orelse 0)

    # an arm's value: a union variant (`U.v`, the variant's struct type), an
    # enum member, or a plain value
    def armValueStr(v: Expr): str
        branch v
            on Expr.member as m
                var owner: str = .staticOwner(m.object)
                if .isUnionName(owner)
                    return owner + "_" + m.member
                if .isEnumName(owner)
                    return "." + vSafe(m.member)   # a match on an enum spells its arms `.member`
                return .exprStr(v)
            on Expr.binary as rb
                if rb.op == BinaryOp.dotdot
                    # `on c'0'..c'9'`: V's inclusive range arm, three dots
                    return .exprStr(rb.left) + "..." + .exprStr(rb.right)
                return .exprStr(v)
            else
                return .exprStr(v)

    # `var x: int = 5` -> `mut x := i64(5)`; the type carried onto a numeric
    # literal, since V's untyped int is 32-bit and Zebra's is 64
    def genLocal(v: DeclVar)
        .local_names.add(v.name)
        var name = vSafe(v.name)
        if v.init_expr as ie
            var tname: str = ""
            if v.type_ as t
                tname = .vType(t)
            var rhs: str = ""
            if isUntypedListLit(ie) and tname.startsWith("&ZList[")
                # `var xs: List(int) = [...]`: the element type is the variable's
                rhs = .listLitWith(ie, tname.substring(7, tname.len - 1))
            else if isBareCtor(ie) and tname != ""
                rhs = .zeroOf(tname)   # `var xs: List(int) = List()`: the type is the variable's
            else
                rhs = .exprStr(ie)
                var un: str = .unionOfExpr(ie)
                if un != ""
                    # a variant is a value of its union: V would type the variable
                    # by the variant and refuse the next assignment
                    rhs = un + "(" + rhs + ")"
                    if tname == ""
                        tname = un
            if tname == ""
                tname = .ctorTypeOf(ie)
            if tname != ""
                .local_types.set(v.name, tname)
            if tname.startsWith("?") and isNilLit(ie)
                rhs = tname + "(none)"   # `var x: T? = nil`: V types `none` alone as none
            else if tname == "i64"
                rhs = "i64(" + rhs + ")"   # (whatever the initializer: `-1` is V's int, a call's i64 is unchanged)
            else if tname == "f64"
                rhs = "f64(" + rhs + ")"
            else if tname == "" and isIntLit(ie)
                rhs = "i64(" + rhs + ")"
            .line("mut " + name + " := " + rhs)
        else
            if v.type_ as t
                .local_types.set(v.name, .vType(t))
                .line("mut " + name + " := " + .zeroOf(.vType(t)))
            else
                .refuse("var " + v.name + " without a type or a value", v.span)

    def zeroOf(vt: str): str
        if vt == "i64": return "i64(0)"
        if vt == "f64": return "f64(0)"
        if vt == "string": return "''"
        if vt == "bool": return "false"
        if vt.startsWith("&ZList["): return "new_zlist" + vt.substring(6, vt.len) + "()"
        if vt.startsWith("&ZMap["): return "new_zmap" + vt.substring(5, vt.len) + "()"
        if vt.startsWith("&ZSet["): return "new_zset" + vt.substring(5, vt.len) + "()"
        if vt == "&ZStringBuilder": return "new_zstring_builder()"
        if vt.startsWith("&"): return vt.substring(1, vt.len) + "{}"
        return vt + "{}"

    def genIf(i: StmtIf)
        var captured: str = ""
        if i.is_capture as cap
            captured = .genIfCapture(cap, i.cond)
        else
            .line("if " + condStr(.exprStr(i.cond)) + " {")
        .depth = .depth + 1
        if captured != ""
            .line(captured)
        .genStmts(i.then_stmts)
        .depth = .depth - 1
        for ei in i.else_ifs
            if ei.is_capture as ecap
                .line("} else if " + vSafe(ecap) + " := " + .exprStr(ei.cond) + " {")
            else
                .line("} else if " + condStr(.exprStr(ei.cond)) + " {")
            .depth = .depth + 1
            .genStmts(ei.stmts)
            .depth = .depth - 1
        if i.else_stmts as es
            .line("} else {")
            .depth = .depth + 1
            .genStmts(es)
            .depth = .depth - 1
        .line("}")

    # `if cond as name`: a nilable's binding (`if name := cond {`), or a union
    # check's (`if x is U_v {` then `name := x.payload`, V's smart cast on an
    # identifier); returns the then-block's first line when there is one
    def genIfCapture(cap: str, cond: Expr): str
        branch cond
            on Expr.type_check as tc
                if tc.variant_name as vn
                    var subj = .exprStr(tc.expr)
                    if isCallExpr(tc.expr)
                        # V smart-casts a name, not a call's result: the subject bound first
                        .tmpN = .tmpN + 1
                        var zs = "zs" + .tmpN.toString()
                        .line(zs + " := " + subj)
                        subj = zs
                    .line("if " + subj + " is " + tc.type_name + "_" + vn + " {")
                    .local_names.add(cap)
                    var lead: str = ""
                    if .union_payloads.get(tc.type_name + "_" + vn) as pt
                        .local_types.set(cap, pt)
                        if .needsMut(pt)
                            lead = "mut "
                    return lead + vSafe(cap) + " := " + subj + ".payload"
                .refuse("`is` on a class (not a union variant)", tc.span)
                .line("if true {")
                return ""
            else
                var ct: str = .vTypeOf(cond)
                var lead: str = ""
                if ct.startsWith("?")
                    var inner: str = ct.substring(1, ct.len)
                    .local_types.set(cap, inner)
                    if .needsMut(inner)
                        lead = "mut "   # V refuses `mut y.field` through an immutable binding
                .local_names.add(cap)
                .line("if " + lead + vSafe(cap) + " := " + .exprStr(cond) + " {")
                return ""

    def genForIn(fi: StmtForIn)
        if fi.vars.count() == 2
            # `for k, v in m`: a map's entries; V iterates the runtime's inner map
            var kname: str = fi.vars.at(0)
            var vname: str = fi.vars.at(1)
            .local_names.add(kname)
            .local_names.add(vname)
            var mt: str = .vTypeOf(fi.iter)
            if mt.startsWith("&ZMap[")
                var inner: str = mt.substring(6, mt.len - 1)
                var cut: int = inner.indexOf(", ")
                if cut > 0
                    .local_types.set(kname, inner.substring(0, cut))
                    .local_types.set(vname, inner.substring(cut + 2, inner.len))
            .line("for " + vSafe(kname) + ", " + vSafe(vname) + " in " + .exprStr(fi.iter) + ".m {")
            .depth = .depth + 1
            .genStmts(fi.stmts)
            .depth = .depth - 1
            .line("}")
            return
        if fi.vars.count() != 1
            .refuse("for with " + fi.vars.count().toString() + " loop variables", fi.span)
            return
        if fi.filter != nil
            .refuse("for ... if (a filtered loop)", fi.span)
        var v = vSafe(fi.vars.at(0))
        .local_names.add(fi.vars.at(0))
        # `for i in a..b`: a numeric range
        branch fi.iter
            on Expr.binary as rb
                if rb.op == BinaryOp.dotdot
                    .line("for " + v + " := i64(" + .exprStr(rb.left) + "); " + v + " < " + .exprStr(rb.right) + "; " + v + "++ {")
                    .depth = .depth + 1
                    .genStmts(fi.stmts)
                    .depth = .depth - 1
                    .line("}")
                    return
            else
                pass
        # `for i in a.to(b)`: a numeric range
        branch fi.iter
            on Expr.call as c
                branch c.callee
                    on Expr.member as m
                        if m.member == "to" and c.args.count() == 1
                            .line("for " + v + " := i64(" + .exprStr(m.object) + "); " + v + " < " + .exprStr(c.args.at(0).value) + "; " + v + "++ {")
                            .depth = .depth + 1
                            .genStmts(fi.stmts)
                            .depth = .depth - 1
                            .line("}")
                            return
                    else
                        pass
            else
                pass
        var et: str = .elemOf(.vTypeOf(fi.iter))
        if et != ""
            .local_types.set(fi.vars.at(0), et)
            if .needsMut(et)
                # an element passed on as `mut x.field`: by index, the element
                # copied into a mutable local (V's `for mut x` makes a reference
                # to the element and needs the list's root mutable)
                .tmpN = .tmpN + 1
                var it = "zit" + .tmpN.toString()
                var ix = "zix" + .tmpN.toString()
                .line(it + " := " + .exprStr(fi.iter))
                .line("for " + ix + " := 0; " + ix + " < " + it + ".count(); " + ix + "++ {")
                .depth = .depth + 1
                .line("mut " + v + " := " + it + ".at(" + ix + ")")
                .genStmts(fi.stmts)
                .depth = .depth - 1
                .line("}")
                return
        .line("for " + v + " in " + .exprStr(fi.iter) + ".items {")   # a list's items (the subset iterates lists)
        .depth = .depth + 1
        .genStmts(fi.stmts)
        .depth = .depth - 1
        .line("}")

    def genPrint(p: StmtPrint)
        var fnname: str = "println"
        if not p.newline
            fnname = "print"
        if p.args.count() == 1
            .line(fnname + "(" + .exprStr(p.args.at(0)) + ")")
            return
        var parts: str = ""
        var first: bool = true
        for a in p.args
            if not first
                parts = parts + " "
            first = false
            parts = parts + "\${" + .exprStr(a) + "}"
        .line(fnname + "('" + parts + "')")

    # ── expressions ────────────────────────────────────────────────────────
    def exprStr(e: Expr): str
        branch e
            on Expr.int_lit as il
                return il.text
            on Expr.float_lit as fl
                return fl.text
            on Expr.bool_lit as bl
                if bl.value
                    return "true"
                return "false"
            on Expr.string_lit as sl
                return .vStringLit(sl.text)
            on Expr.string_interp as si
                return .vInterp(si)
            on Expr.this_
                return "self"
            on Expr.ident as id
                if .isCurrentField(id.name) and not .isLocalName(id.name)
                    return "self." + vSafe(id.name)   # a bare field name inside its class (Zebra allows it)
                return vSafe(id.name)
            on Expr.member as m
                return .memberStr(m)
            on Expr.call as c
                return .callStr(c)
            on Expr.index as ix
                return .exprStr(ix.object) + "[" + .exprStr(ix.index) + "]"
            on Expr.binary as b
                return .binaryStr(b)
            on Expr.unary as u
                if u.op == UnaryOp.neg
                    return "(-" + .exprStr(u.operand) + ")"
                if u.op == UnaryOp.not_
                    return "(!" + .exprStr(u.operand) + ")"
                return "(~" + .exprStr(u.operand) + ")"
            on Expr.list_lit as ll
                return .listLitStr(ll)
            on Expr.if_expr as ie
                return "(if " + .exprStr(ie.cond) + " { " + .exprStr(ie.then_expr) + " } else { " + .exprStr(ie.else_expr) + " })"
            on Expr.type_check as tc
                if tc.variant_name as vn
                    if .isEnumName(tc.type_name)
                        return "(" + .exprStr(tc.expr) + " == ." + vSafe(vn) + ")"   # `x is Enum.member`
                    return "(" + .exprStr(tc.expr) + " is " + tc.type_name + "_" + vn + ")"
                .refuse("`is` on a class (not a union variant)", tc.span)
                return "true"
            on Expr.nil_
                return "none"
            on Expr.orelse_ as oe
                return "(" + .exprStr(oe.expr) + " or { " + .exprStr(oe.fallback) + " })"
            on Expr.to_non_nil as tnn
                return "zunwrap(" + .exprStr(tnn.expr) + ")"   # (a helper: V smart-casts a name after `!= none` and refuses `or` on it)
            on Expr.dict_lit as dl
                .refuse("a dict literal (maps are next)", dl.span)
                return "map[string]i64{}"
            on Expr.try_ as t
                return .exprStr(t.expr) + "!"
            on Expr.char_lit as cl
                return .charLitStr(cl.text)
            on Expr.slice as sl
                var a: str = ""
                var b: str = ""
                if sl.start as st
                    a = .exprStr(st)
                if sl.stop_ as sp
                    b = .exprStr(sp)
                return .exprStr(sl.object) + "[" + a + ".." + b + "]"
            on Expr.cast as ca
                return .vType(ca.target) + "(" + .exprStr(ca.expr) + ")"
            on Expr.chained_cmp as cc
                # a < b < c -> (a < b) && (b < c); the middle operands are spelled twice
                var out: str = "("
                var i: int = 0
                while i < cc.ops.count()
                    if i > 0
                        out = out + " && "
                    out = out + "(" + .exprStr(cc.operands.at(i)) + " " + cc.ops.at(i) + " " + .exprStr(cc.operands.at(i + 1)) + ")"
                    i = i + 1
                return out + ")"
            on Expr.lambda as lam
                return .lambdaStr(lam)
            on Expr.tuple_lit as tl
                .refuse("a tuple literal", tl.span)
                return "0"
            on Expr.set_lit as stl
                .refuse("a set literal", stl.span)
                return "new_zset[i64]()"
            on Expr.array_lit as al
                .refuse("an array literal", al.span)
                return "0"
            on Expr.zig_lit as zl
                if zl.text == "_error_ctx.message"
                    return "err.msg()"   # the compiler's own idiom for the caught error's message (inside a catch: V's err)
                if zl.text == "_zbr_version"
                    return "zbr_version"   # the compiler's own version string: a runtime const on this backend
                .refuse("a zig literal (Zig-backend code; no V for it)", zl.span)
                return "0"
            on Expr.opt_chain as oc
                .refuse("an optional chain (?.)", oc.span)
                return .exprStr(oc.base)
            on Expr.old_ as ol
                .refuse("an `old` expression (contracts)", ol.span)
                return .exprStr(ol.operand)
            on Expr.except_ as ex
                .refuse("an `except` expression", ex.span)
                return .exprStr(ex.base)
            on Expr.result_ as rs
                .refuse("`result` (contracts)", rs)
                return "0"
            on Expr.catch_ as c
                # `expr catch |e| fallback` -> `(expr or { e := err  fallback })`:
                # the or block's last expression is its value
                if c.err_var as ev
                    .catch_bindings.add(vSafe(ev))
                    var out = "(" + .exprStr(c.expr) + " or {\n" + vSafe(ev) + " := err\n_ = " + vSafe(ev) + "\n" + .exprStr(c.fallback) + "\n})"
                    .catch_bindings = dropLast(.catch_bindings)
                    return out
                return "(" + .exprStr(c.expr) + " or { " + .exprStr(c.fallback) + " })"
            else
                .refused.add("an expression kind the subset does not spell")
                return "0"

    # `c'A'` -> u8(`A`): Zebra's char is a byte; V's rune literal cast to u8
    # (the AST keeps the raw text, c-prefix and quotes included)
    def charLitStr(text: str): str
        var inner: str = text
        if inner.startsWith("c'") and inner.endsWith("'") and inner.len >= 3
            inner = inner.substring(2, inner.len - 1)
        else if inner.startsWith("'") and inner.endsWith("'") and inner.len >= 2
            inner = inner.substring(1, inner.len - 1)
        if inner == "\\'"
            inner = "'"
        if inner == "`"
            inner = "\\`"
        return "u8(`" + inner + "`)"

    # a lambda as V's anonymous function, its captures listed (V captures by
    # value unless `mut`; a captured container or class is a reference anyway)
    def lambdaStr(lam: ExprLambda): str
        var caps: str = ""
        for cv in lam.captures
            if caps != ""
                caps = caps + ", "
            if .isRefType(cv.type_)
                caps = caps + "mut " + vSafe(cv.name)
            else
                caps = caps + vSafe(cv.name)
        var capList: str = ""
        if caps != ""
            capList = "[" + caps + "] "
        var ret = .vType(lam.return_type)
        var head = "fn " + capList + "(" + .genParams(lam.params) + ")"
        if ret != ""
            head = head + " " + ret
        var saved_locals = .local_names.copy()   # (a container is a reference: the restore needs its own copy)
        for p in lam.params
            .local_names.add(p.name)
        var body: str = ""
        branch lam.body_
            on LambdaBody.expr_ as e
                body = "\n\treturn " + .exprStr(e) + "\n"
            on LambdaBody.stmts as sts
                # the statements through a nested writer: the lines are joined
                var inner = VGen()
                inner.class_names = .class_names
                inner.struct_names = .struct_names
                inner.enum_names = .enum_names
                inner.union_names = .union_names
                inner.sigs = .sigs
                inner.member_counts = .member_counts
                inner.current_fields = .current_fields
                inner.local_names = .local_names
                inner.catch_bindings = .catch_bindings
                inner.depth = 1
                inner.genStmts(sts)
                for r in inner.refused
                    .refused.add(r)
                body = "\n" + inner.sb.build()
        .local_names = saved_locals
        return head + " {" + body + "}"

    # "text" -> 'text' with V's escapes: a $ or a ' inside is escaped
    def vStringLit(text: str): str
        return "'" + .vEscape(text) + "'"

    # the text of a Zebra string (its escapes raw, as the lexer keeps them)
    # as V's: `\"` is a plain quote, `\$` stays one escape (not an escaped
    # backslash before an interpolation), a `$` or `'` is escaped
    def vEscape(text: str): str
        var out: str = ""
        var i: int = 0
        var n: int = text.len
        while i < n
            var ch = text[i]   # (a byte: compared with a char literal, appended as a one-byte substring)
            if ch == '\\' and i + 1 < n
                var nx = text[i + 1]
                if nx == '"'
                    out = out + "\""
                else if nx == '$'
                    out = out + "\\$"
                else if nx == '\''
                    out = out + "\\'"
                else
                    out = out + "\\" + text.substring(i + 1, i + 2)
                i = i + 2
            else
                if ch == '$'
                    out = out + "\\$"
                else if ch == '\''
                    out = out + "\\'"
                else
                    out = out + text.substring(i, i + 1)
                i = i + 1
        return out

    def vInterp(si: ExprStringInterp): str
        var out: str = "'"
        for part in si.parts
            branch part
                on StringPart.literal as lit
                    out = out + .vEscape(lit)
                on StringPart.expr_ as ex
                    out = out + "\${" + .exprStr(ex) + "}"
                on StringPart.format as f
                    # a format spec FOLLOWS its expression in the parts: spliced
                    # into the `${...}` just emitted (V's own spelling, `${x:.4f}`)
                    if out.endsWith("}")
                        out = out.substring(0, out.len - 1) + ":" + f + "}"
                    else
                        .refused.add("a format spec (" + f + ") with no expression before it")
        return out + "'"

    def listLitStr(ll: ExprListLit): str
        var et: str = ""
        if ll.elem_type as t
            et = .vType(t)
        if et == ""
            .refused.add("a list literal without an element type (write `var xs: List(T) = [...]`)")
            return "new_zlist[i64]()"
        return .listLitWith(Expr.list_lit(ll), et)

    # a list literal as the runtime's boxed list of a known element type
    def listLitWith(e: Expr, et: str): str
        branch e
            on Expr.list_lit as ll
                if ll.elems.count() == 0
                    return "new_zlist[" + et + "]()"
                var out: str = "zlist_of[" + et + "](["
                var first: bool = true
                for el in ll.elems
                    if not first
                        out = out + ", "
                    first = false
                    if et == "i64" and isIntLit(el)
                        out = out + "i64(" + .exprStr(el) + ")"
                    else if .isUnionName(et)
                        out = out + et + "(" + .exprStr(el) + ")"   # a sum type's element: cast, or V infers the first variant
                    else
                        out = out + .exprStr(el)
                return out + "])"
            else
                return .exprStr(e)

    # `.x` on this -> self.x; `a.len` (a property) -> a.len; else a.b
    def memberStr(m: ExprMember): str
        var owner: str = .staticOwner(m.object)
        if owner == "Math" and m.member == "PI"
            return "math.pi"
        if .isEnumName(owner)
            return owner + "." + vSafe(m.member)
        if .isUnionName(owner)
            return owner + "_" + m.member + "{}"   # a payload-less variant as a value
        if .isModuleIdent(m.object)
            return vSafe(m.member)   # `Mod.name`: the used module's declaration, in this file
        var obj = .exprStr(m.object)
        if m.member == "len"
            if .isContainerType(.vTypeOf(m.object))
                return obj + ".count()"   # Zebra's `.len` on a container
            return obj + ".len"
        if m.member == "message" and .isCatchBinding(obj)
            return obj + ".msg()"   # V's IError
        return obj + "." + vSafe(m.member)

    def isCatchBinding(name: str): bool
        for b in .catch_bindings
            if b == name
                return true
        return false

    def isSigConflict(name: str): bool
        for c in .sig_conflicts
            if c == name
                return true
        return false

    def argsStr(args: List(Arg), callee: str = ""): str
        var sigOpt: FnSig? = nil
        if callee != "" and not .isSigConflict(callee)
            sigOpt = .sigs.get(callee)
        if sigOpt as fsig
            return .argsBySig(args, fsig)
        # an unknown callee (the stdlib, a method the pass did not see): by position
        var out: str = ""
        var first: bool = true
        for a in args
            if not first
                out = out + ", "
            first = false
            if a.name != nil
                .refuse("a named argument (" + a.name! + ") to a callee the emitter has no signature for", a.span)
            out = out + .exprStr(a.value)
        return out

    # the arguments in the callee's order: a named argument to its parameter,
    # the unnamed ones in sequence to the rest, a missing one from its default
    def argsBySig(args: List(Arg), fsig: FnSig): str
        var slots = List(str)()
        var filled = List(bool)()
        for n in fsig.names
            slots.add("")
            filled.add(false)
        var pos: int = 0
        for a in args
            if a.name as an
                var k: int = 0
                var found: bool = false
                for n in fsig.names
                    if n == an
                        slots.set(k, .exprStr(a.value))
                        filled.set(k, true)
                        found = true
                    k = k + 1
                if not found
                    .refuse("a named argument (" + an + ") the callee has no parameter for", a.span)
            else
                while pos < fsig.names.count() and filled.at(pos)
                    pos = pos + 1
                if pos < fsig.names.count()
                    slots.set(pos, .exprStr(a.value))
                    filled.set(pos, true)
                    pos = pos + 1
                else
                    .refuse("more arguments than the callee has parameters", a.span)
        var out: str = ""
        var i: int = 0
        while i < fsig.names.count()
            if i > 0
                out = out + ", "
            if not filled.at(i)
                if fsig.has_default.at(i)
                    slots.set(i, .exprStr(fsig.defaults.at(i)))
                else
                    .refused.add("a missing argument (" + fsig.names.at(i) + ") with no default")
                    slots.set(i, "0")
            if fsig.refs.at(i)
                var slot: str = slots.at(i)
                if slot.indexOf("(") >= 0 or slot.indexOf("[") >= 0 or (slot.indexOf(".") >= 0 and not slot.startsWith("self."))
                    # V takes `mut` on an lvalue only: a call's result (a fresh
                    # container, an element) is bound first; the line lands
                    # before the statement being built. A field path not rooted
                    # at self is bound too: V refuses `mut p.field` through an
                    # immutable parameter or binding, and a reference field
                    # copied is the same container
                    .tmpN = .tmpN + 1
                    var t = "zt" + .tmpN.toString()
                    .line("mut " + t + " := " + slot)
                    slots.set(i, t)
                out = out + "mut "
            out = out + slots.at(i)
            i = i + 1
        return out

    def callStr(c: ExprCall): str
        branch c.callee
            on Expr.member as m
                if .isModuleIdent(m.object) and not .isModuleClassStatic(m)
                    return .identCallStr(m.member, c.args)   # `Mod.Name(args)`: the used module's declaration
                return .methodCallStr(m, c.args, c.span)
            on Expr.ident as id
                return .identCallStr(id.name, c.args)
            on Expr.call as inner
                # List(T)() / HashMap(K, V)(): the runtime's constructors
                branch inner.callee
                    on Expr.ident as cid
                        if cid.name == "List" and inner.args.count() == 1
                            return "new_zlist[" + .typeArgStr(inner.args.at(0).value) + "]()"
                        if cid.name == "HashMap" and inner.args.count() == 2
                            return "new_zmap[" + .typeArgStr(inner.args.at(0).value) + ", " + .typeArgStr(inner.args.at(1).value) + "]()"
                        if cid.name == "Set" and inner.args.count() == 1
                            return "new_zset[" + .typeArgStr(inner.args.at(0).value) + "]()"
                    else
                        pass
                .refuse("a call on a call's result", c.span)
                return .exprStr(c.callee) + "(" + .argsStr(c.args) + ")"
            else
                .refuse("a call on an expression that is not a name or a member", c.span)
                return .exprStr(c.callee) + "(" + .argsStr(c.args) + ")"

    # `Mod.x(args)` where Mod is a used module AND a class of that name (Zebra's
    # `use Lexer` then `Lexer.tokenize(src)`): the class's static method --
    # unless x names a type (`Token.Token(...)` is the class's constructor)
    def isModuleClassStatic(m: ExprMember): bool
        branch m.object
            on Expr.ident as id
                if not (.isClassName(id.name) or .isStructName(id.name))
                    return false
                if .isClassName(m.member) or .isStructName(m.member) or .isUnionName(m.member) or .isEnumName(m.member)
                    return false
                return true
            else
                return false

    # a call on a bare name: a class or a struct constructed (Name(args) ->
    # new_name(args)), else a free function
    def identCallStr(name: str, args: List(Arg)): str
        if .isClassName(name) or .isStructName(name)
            return "new_" + snakeCase(name) + "(" + .argsStr(args, "new_" + snakeCase(name)) + ")"
        if name == "StringBuilder"
            return "new_zstring_builder()"
        if (name == "List" or name == "HashMap" or name == "Set") and args.count() == 0
            .refused.add("an untyped " + name + "() where the emitter does not know the target's type (a typed var or a field takes it)")
            return "new_zlist[i64]()"
        # a bare call naming a method of the enclosing class (Zebra allows it)
        if .in_method and .isMethodName(name)
            return "self." + vSafe(name) + "(" + .argsStr(args, vSafe(name)) + ")"
        if .isStaticName(name)
            return snakeCase(.current_class) + "_" + vSafe(name) + "(" + .argsStr(args, vSafe(name)) + ")"
        return vSafe(name) + "(" + .argsStr(args, vSafe(name)) + ")"

    # a type named as a constructor's argument (`List(int)`, `HashMap(str, Box)`)
    def typeArgStr(e: Expr): str
        branch e
            on Expr.ident as id
                return .vNamed(id.name)
            on Expr.member as mm
                if .isModuleIdent(mm.object)
                    return .vNamed(mm.member)   # `List(Mod.Name)`
                .refused.add("a type argument the subset does not spell (a member)")
                return "voidptr"
            on Expr.call as c
                # a nested container type: List(List(int))
                branch c.callee
                    on Expr.ident as cid
                        if cid.name == "List" and c.args.count() == 1
                            return "&ZList[" + .typeArgStr(c.args.at(0).value) + "]"
                        if cid.name == "HashMap" and c.args.count() == 2
                            return "&ZMap[" + .typeArgStr(c.args.at(0).value) + ", " + .typeArgStr(c.args.at(1).value) + "]"
                        if cid.name == "Set" and c.args.count() == 1
                            return "&ZSet[" + .typeArgStr(c.args.at(0).value) + "]"
                    else
                        pass
                .refused.add("a type argument the subset does not spell")
                return "voidptr"
            else
                .refused.add("a type argument the subset does not spell")
                return "voidptr"

    # the stdlib surface the subset maps by hand: str, List, Math, the conversions
    def methodCallStr(m: ExprMember, args: List(Arg), span: Span): str
        var name = m.member
        var isMath: bool = false
        var owner: str = .staticOwner(m.object)
        if owner == "Math"
            isMath = true
        # a static method: Class.method(args) -> class_method(args)
        if .isClassName(owner) or .isStructName(owner)
            return snakeCase(owner) + "_" + vSafe(name) + "(" + .argsStr(args, vSafe(name)) + ")"
        # a union variant constructed: U.v(x) -> U_v{ payload: x }, U.v() -> U_v{}
        if .isUnionName(owner)
            if args.count() == 0
                return owner + "_" + name + "{}"
            return owner + "_" + name + "{ payload: " + .exprStr(args.at(0).value) + " }"
        if isMath
            .needs_math = true
            if name == "sqrt" or name == "abs" or name == "floor" or name == "ceil" or name == "sin" or name == "cos" or name == "tan" or name == "pow" or name == "min" or name == "max" or name == "atan2"
                return "math." + name + "(" + .argsStr(args) + ")"
            if name == "round": return "zmath_round(" + .argsStr(args) + ")"
            if name == "clamp": return "zmath_clamp(" + .argsStr(args) + ")"
            .refuse("Math." + name, span)
            return "math." + name + "(" + .argsStr(args) + ")"
        var statics: str = .staticCall(m, args, span)
        if statics != ""
            return statics
        var obj = .exprStr(m.object)
        var rtype: str = .vTypeOf(m.object)
        if rtype.startsWith("&ZList[")
            # the list's own, where the string's would be taken by name (the
            # comparing ones are free functions: see zebra_rt.v)
            if name == "indexOf" and args.count() == 1: return "zlist_index_of(" + obj + ", " + .argsStr(args) + ")"
            if name == "contains" and args.count() == 1: return "zlist_contains(" + obj + ", " + .argsStr(args) + ")"
            if name == "toString" and args.count() == 0: return "zlist_str(" + obj + ")"
            if name == "sort" and args.count() == 0
                var et: str = .elemOf(rtype)
                if et == "string": return "zsort_str(mut " + obj + ")"
                if et == "i64": return "zsort_i64(mut " + obj + ")"
                if et == "f64": return "zsort_f64(mut " + obj + ")"
                .refuse("List(" + et + ").sort (the runtime sorts i64, f64 and str)", span)
                return "zsort_str(mut " + obj + ")"
            if name == "remove" and args.count() == 1: return obj + ".remove_at(" + .argsStr(args) + ")"   # Zebra's List.remove(i) is by index
            if name == "reverse" and args.count() == 0: return obj + ".reversed()"
        return .mappedCall(obj, name, args, span)

    # File / Path / sys as static calls onto the runtime's wrappers ("" when
    # the object is not one of them); Json is the next slice
    def staticCall(m: ExprMember, args: List(Arg), span: Span): str
        var ns: str = .staticOwner(m.object)
        if ns == ""
            return ""
        var name = m.member
        var a = .argsStr(args)
        if ns == "File"
            if name == "exists": return "zfile_exists(" + a + ")"
            if name == "read": return "zfile_read(" + a + ")"
            if name == "write": return "zfile_write(" + a + ")"
            if name == "append": return "zfile_append(" + a + ")"
            if name == "listDir": return "zfile_list_dir(" + a + ")"
            .refuse("File." + name, span)
            return "zfile_" + snakeCase(name) + "(" + a + ")"
        if ns == "Path"
            if name == "dirname": return "zpath_dirname(" + a + ")"
            if name == "basename": return "zpath_basename(" + a + ")"
            if name == "stem": return "zpath_stem(" + a + ")"
            if name == "join": return "zpath_join(" + a + ")"
            .refuse("Path." + name, span)
            return "zpath_" + snakeCase(name) + "(" + a + ")"
        if ns == "sys"
            if name == "exit": return "exit(int(" + a + "))"
            if name == "errln": return "eprintln(" + a + ")"
            if name == "cwd": return "os.getwd()"
            if name == "args": return "zlist_of[string](os.args)"
            .refuse("sys." + name, span)
            return "zsys_" + snakeCase(name) + "(" + a + ")"
        if ns == "Dir"
            if name == "exists": return "os.is_dir(" + a + ")"
            .refuse("Dir." + name, span)
            return "zdir_" + snakeCase(name) + "(" + a + ")"
        if ns == "Json"
            .refuse("Json." + name + " (the Json value type is the next slice: V's json2.Any has the same shape)", span)
            return "none"
        return ""

    # the call on an object already spelled (a temporary, or the member's object)
    def mappedCall(obj: str, name: str, args: List(Arg), span: Span): str
        if name == "toString" and args.count() == 0: return obj + ".str()"
        if name == "toFloat" and args.count() == 0: return "f64(" + obj + ")"
        if name == "toInt" and args.count() == 0: return "i64(" + obj + ")"
        # the containers: the runtime's ZList / ZMap methods, by their names
        if name == "count" and args.count() == 0: return obj + ".count()"
        if name == "at" and args.count() == 1: return obj + ".at(" + .argsStr(args) + ")"
        if name == "add" and args.count() == 1: return obj + ".add(" + .argsStr(args) + ")"
        if name == "set" and args.count() == 2: return obj + ".set(" + .argsStr(args) + ")"
        if name == "get" and args.count() == 1: return obj + ".get(" + .argsStr(args) + ")"
        if name == "has" and args.count() == 1: return obj + ".has(" + .argsStr(args) + ")"
        if name == "keys" and args.count() == 0: return obj + ".keys()"
        if name == "remove" and args.count() == 1: return obj + ".remove(" + .argsStr(args) + ")"
        if name == "copy" and args.count() == 0: return obj + ".copy()"
        if name == "last" and args.count() == 0: return obj + ".last()"
        if name == "isEmpty" and args.count() == 0: return obj + ".is_empty()"
        if name == "values" and args.count() == 0: return obj + ".values()"
        if name == "put" and args.count() == 2: return obj + ".set(" + .argsStr(args) + ")"
        if name == "items" and args.count() == 0: return obj + ".items()"
        if name == "insert" or name == "removeAt"
            .refuse("List." + name + " (V 0.5.2 miscompiles array.insert on a generic element under two instantiations; vlang/v#30253)", span)
        # str (V's own names; a list's split / lines / chars come back boxed)
        if name == "split" and args.count() == 1: return "zstr_split(" + obj + ", " + .argsStr(args) + ")"
        if name == "lines" and args.count() == 0: return "zstr_lines(" + obj + ")"
        if name == "chars" and args.count() == 0: return "zlist_of[u8](" + obj + ".bytes())"   # Zebra's char is a byte
        if name == "join" and args.count() == 1: return "zjoin(" + obj + ", " + .argsStr(args) + ")"
        if name == "charAt" and args.count() == 1
            .refuse("str.charAt (Zebra's char is a number whose toString prints it; V has no char type to match -- the next slice decides a char's spelling)", span)
            return "zstr_char_at(" + obj + ", " + .argsStr(args) + ")"
        if name == "padLeft" and args.count() == 2: return "zstr_pad_left(" + obj + ", " + .argsStr(args) + ")"
        if name == "padRight" and args.count() == 2: return "zstr_pad_right(" + obj + ", " + .argsStr(args) + ")"
        if name == "tryInt" and args.count() == 0: return "zstr_try_int(" + obj + ")"
        if name == "tryFloat" and args.count() == 0: return "zstr_try_float(" + obj + ")"
        if name == "indexOf" and args.count() == 1: return "zstr_index_of(" + obj + ", " + .argsStr(args) + ")"
        if name == "replace" and args.count() == 2: return obj + ".replace(" + .argsStr(args) + ")"
        if name == "replaceAll" and args.count() == 2: return obj + ".replace(" + .argsStr(args) + ")"
        if name == "repeat" and args.count() == 1: return obj + ".repeat(int(" + .argsStr(args) + "))"
        if name == "reverse" and args.count() == 0: return obj + ".reverse()"
        if name == "trimLeft" and args.count() == 0: return obj + ".trim_space_left()"
        if name == "trimRight" and args.count() == 0: return obj + ".trim_space_right()"
        if name == "equals" and args.count() == 1: return "(" + obj + " == " + .argsStr(args) + ")"
        if name == "eqlIgnoreCase" and args.count() == 1: return "(" + obj + ".to_lower() == (" + .argsStr(args) + ").to_lower())"
        if name == "build" and args.count() == 0: return obj + ".build()"
        if name == "append" and args.count() == 1: return obj + ".append(" + .argsStr(args) + ")"
        if name == "lastIndexOf" and args.count() == 1: return "zstr_last_index_of(" + obj + ", " + .argsStr(args) + ")"
        if name == "sort" or name == "sortBy" or name == "map" or name == "filter" or name == "reduce" or name == "pop"
            .refuse("." + name + " (needs the receiver's type or a closure: the next slices)", span)
        if name == "contains" and args.count() == 1: return obj + ".contains(" + .argsStr(args) + ")"
        if name == "startsWith" and args.count() == 1: return obj + ".starts_with(" + .argsStr(args) + ")"
        if name == "endsWith" and args.count() == 1: return obj + ".ends_with(" + .argsStr(args) + ")"
        if name == "substring" and args.count() == 2: return obj + "[" + .exprStr(args.at(0).value) + ".." + .exprStr(args.at(1).value) + "]"
        if name == "split" and args.count() == 1: return obj + ".split(" + .argsStr(args) + ")"
        if name == "trim" and args.count() == 0: return obj + ".trim_space()"
        if (name == "upper" or name == "toUpper") and args.count() == 0: return obj + ".to_upper()"
        if (name == "lower" or name == "toLower") and args.count() == 0: return obj + ".to_lower()"
        if name == "clear" and args.count() == 0: return obj + ".clear()"
        # a method on one of the program's own classes: self.m(...) / obj.m(...)
        return obj + "." + vSafe(name) + "(" + .argsStr(args, vSafe(name)) + ")"

    def binaryStr(b: ExprBinary): str
        var l = .exprStr(b.left)
        var r = .exprStr(b.right)
        if b.op == BinaryOp.pow
            .needs_math = true
            return "math.pow(" + l + ", " + r + ")"
        if b.op == BinaryOp.in_
            return r + ".contains(" + l + ")"
        if b.op == BinaryOp.eq or b.op == BinaryOp.ne
            # `kind == TokenKind.at_id` (a payload-less variant): V compares a sum
            # type with a variant by `is`, never by `==`
            var vt: str = .variantTypeName(b.right)
            var sub: str = l
            if vt == ""
                vt = .variantTypeName(b.left)
                sub = r
            if vt != ""
                if b.op == BinaryOp.eq
                    return "(" + sub + " is " + vt + ")"
                return "!(" + sub + " is " + vt + ")"
        if b.op == BinaryOp.dotdot
            .refused.add("a .. range expression")
            return l
        if b.op == BinaryOp.or_ or b.op == BinaryOp.and_ or b.op == BinaryOp.add
            # a left-leaning chain of one operator, flat; past thirty terms an
            # `or` / `and` goes through zany / zall over a list (V's checker
            # gives up at forty nested levels, flat or not: the tree is the
            # depth) -- every term evaluated there, no short-circuit
            if b.op != BinaryOp.add and .chainLen(b) > 30
                var terms = List(str)()
                .chainTerms(b, terms)
                var fn_: str = "zany"
                if b.op == BinaryOp.and_
                    fn_ = "zall"
                return fn_ + "([" + zjoinStr(terms, ", ") + "])"
            return "(" + .chainStr(b) + ")"
        return "(" + l + " " + binaryOpV(b.op) + " " + r + ")"

    def chainLen(b: ExprBinary): int
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    return .chainLen(lb) + 1
                return 2
            else
                return 2

    def chainTerms(b: ExprBinary, out: List(str))
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    .chainTerms(lb, out)
                else
                    out.add(.exprStr(b.left))
            else
                out.add(.exprStr(b.left))
        out.add(.exprStr(b.right))

    def chainStr(b: ExprBinary): str
        var l: str = ""
        branch b.left
            on Expr.binary as lb
                if lb.op == b.op
                    l = .chainStr(lb)
                else
                    l = .exprStr(b.left)
            else
                l = .exprStr(b.left)
        return l + " " + binaryOpV(b.op) + " " + .exprStr(b.right)

def binaryOpV(op: BinaryOp): str
    if op == BinaryOp.add: return "+"
    if op == BinaryOp.sub: return "-"
    if op == BinaryOp.mul: return "*"
    if op == BinaryOp.div: return "/"
    if op == BinaryOp.int_div: return "/"
    if op == BinaryOp.mod: return "%"
    if op == BinaryOp.bit_and: return "&"
    if op == BinaryOp.bit_or: return "|"
    if op == BinaryOp.bit_xor: return "^"
    if op == BinaryOp.shl: return "<<"
    if op == BinaryOp.shr: return ">>"
    if op == BinaryOp.eq: return "=="
    if op == BinaryOp.ne: return "!="
    if op == BinaryOp.lt: return "<"
    if op == BinaryOp.le: return "<="
    if op == BinaryOp.gt: return ">"
    if op == BinaryOp.ge: return ">="
    if op == BinaryOp.and_: return "&&"
    if op == BinaryOp.or_: return "||"
    return "?"

def assignOpV(op: AssignOp): str
    if op == AssignOp.assign: return "="
    if op == AssignOp.plus_eq: return "+="
    if op == AssignOp.minus_eq: return "-="
    if op == AssignOp.star_eq: return "*="
    if op == AssignOp.slash_eq: return "/="
    if op == AssignOp.slashslash_eq: return "/="
    if op == AssignOp.percent_eq: return "%="
    if op == AssignOp.ampersand_eq: return "&="
    if op == AssignOp.vertical_bar_eq: return "|="
    if op == AssignOp.caret_eq: return "^="
    if op == AssignOp.double_lt_eq: return "<<="
    if op == AssignOp.double_gt_eq: return ">>="
    return "="

def zjoinStr(xs: List(str), sep: str): str
    var out: str = ""
    var first: bool = true
    for x in xs
        if not first
            out = out + sep
        first = false
        out = out + x
    return out

def isIntLit(e: Expr): bool
    branch e
        on Expr.int_lit
            return true
        else
            return false

def isNilLit(e: Expr): bool
    branch e
        on Expr.nil_
            return true
        else
            return false

def isUntypedListLit(e: Expr): bool
    branch e
        on Expr.list_lit as ll
            return ll.elem_type == nil
        else
            return false

# whether a body assigns to a field of this (`.x = ...`), through if / while /
# for bodies: a struct method that does needs a `mut` receiver
def stmtsAssignThis(stmts: List(Stmt)): bool
    for s in stmts
        if stmtAssignsThis(s)
            return true
    return false

def stmtAssignsThis(s: Stmt): bool
    branch s
        on Stmt.assign as a
            return exprRootIsThis(a.target)
        on Stmt.if_ as i
            if stmtsAssignThis(i.then_stmts)
                return true
            for ei in i.else_ifs
                if stmtsAssignThis(ei.stmts)
                    return true
            if i.else_stmts as es
                return stmtsAssignThis(es)
            return false
        on Stmt.while_ as w
            return stmtsAssignThis(w.stmts)
        on Stmt.for_in as fi
            return stmtsAssignThis(fi.stmts)
        on Stmt.for_num as fnum
            return stmtsAssignThis(fnum.stmts)
        on Stmt.branch_ as b
            for arm in b.cases
                if stmtsAssignThis(arm.stmts)
                    return true
            if b.else_ as es
                return stmtsAssignThis(es)
            return false
        else
            return false

def exprRootIsThis(e: Expr): bool
    branch e
        on Expr.member as m
            return exprRootIsThis(m.object)
        on Expr.index as ix
            return exprRootIsThis(ix.object)
        on Expr.this_
            return true
        else
            return false

def dropLast(xs: List(str)): List(str)
    var out = List(str)()
    var i: int = 0
    while i < xs.count() - 1
        out.add(xs.at(i))
        i = i + 1
    return out

def methodNames(members: List(Decl), statics: bool): List(str)
    var out = List(str)()
    for mem in members
        branch mem
            on Decl.method as mth
                if mth.mods.is_static == statics
                    out.add(mth.name)
            else
                pass
    return out

def isBareCtor(e: Expr): bool
    branch e
        on Expr.call as c
            if c.args.count() != 0
                return false
            branch c.callee
                on Expr.ident as id
                    return id.name == "List" or id.name == "HashMap" or id.name == "Set"
                else
                    return false
        else
            return false

def fieldNames(members: List(Decl)): List(str)
    var out = List(str)()
    for mem in members
        branch mem
            on Decl.var_ as f
                out.add(f.name)
            else
                pass
    return out

def isCallExpr(e: Expr): bool
    branch e
        on Expr.call
            return true
        else
            return false

# a condition without its outer parentheses (V warns on `if (x) {`): one
# balanced outer pair is stripped, never an inner one
def condStr(s: str): str
    if s.len < 2 or not s.startsWith("(") or not s.endsWith(")")
        return s
    var depth: int = 0
    var i: int = 0
    for ch in s.chars()
        if ch == '('
            depth = depth + 1
        else if ch == ')'
            depth = depth - 1
            if depth == 0 and i < s.len - 1
                return s   # the first pair closes before the end: not an outer pair
        i = i + 1
    return s.substring(1, s.len - 1)

def isFloatLit(e: Expr): bool
    branch e
        on Expr.float_lit
            return true
        else
            return false

# the entry: the V source for a module, with the refusals
def generateV(ms: List(Module), runtime: str): VResult
    var g = VGen()
    var body = g.genModules(ms)
    var head: str = "// generated by zebra --target v (proof of concept, 2026-10-13); do not edit\n"
    # the runtime (inlined below) uses math, os and strconv: always imported
    # (an import the program itself never reaches is used by the runtime's
    # functions, so V does not warn)
    head = head + "import math\nimport os\nimport strconv\n"
    head = head + "\n// -- the Zebra runtime for V (selfhost/zebra_rt.v), inlined so one file runs --\n" + runtime + "\n// -- the program --\n"
    return VResult(source: head + body, refused: g.refused, needs_math: g.needs_math, has_globals: g.has_globals)
