# Phase 4: Resolver - Resolver.zbr
# Self-hosting demo: walk a PNode parse tree, build a scope tree, and report
# undefined-name errors.
#
# Design notes:
#   - Two passes:
#       Pass 1 (bind)    - hoist all top-level class/union names into module scope
#       Pass 2 (resolve) - walk method bodies; declare locals in source order;
#                          check every expr_id against the current scope chain
#   - Scope chain is represented: three flat HashMaps on the Resolver instance
#     (module / class / method level) rather than a pointer-linked tree.  This
#     sidesteps the Zebra limitation that ^T cannot be used: a parameter type.
#   - Helper methods receive individual scalar/list fields extracted from ^T union
#     payloads (e.g. m.name, m.stmts) rather than the whole struct, avoiding the
#     need to pass ^PMethod directly.
#   - Type resolution is NOT performed here; that is Phase 5 (TypeChecker).
#
# Language features exercised:
#   - HashMap(str, int) for scope tables; has()/set()/fetch()
#   - List(ResolveError) accumulation
#   - branch dispatch on PNode union variants across module/class/method layers
#   - Recursive tree walking: resolveStmt - resolveExpr
#   - ^T field auto-deref: c.name, m.stmts etc. work through *PClass/*PMethod

use Parser exposing PNode, PParam, POptChain, PIfExpr, PCaptureVar, PExprId, PPos
use CgHelpers exposing isStdlibNs, isBuiltinTypeName

# -- Symbol kind encoding (stored: int in scope HashMaps) -------------------
# 0 = class / union
# 1 = method
# 2 = field
# 3 = param
# 4 = local
# 5 = use_alias

# -- Result types -------------------------------------------------------------

struct ResolveError
    var message: str
    cue init(message: str)
        .message = message

# BUG-569 (docs/design/closure_capture.md): one lambda being resolved. `own` holds every
# name the lambda binds itself -- parameters, `capture` names, locals in its body. A name it
# reads that is not its own but IS a local or parameter of the enclosing function is an
# IMPLICIT CAPTURE: appended to the lambda's `capture` list when the function's walk ends
# (so a pass that ignores this resolver's errors never gets a capture that should have been
# refused), unless something rebinds the name -- a copy would go stale, so that is refused.
class LamFrame
    var own: HashMap(str, int)
    var caps: List(PCaptureVar)
    var implicit: List(str)
    var first_line: HashMap(str, int)
    var first_col: HashMap(str, int)
    var is_thread: bool
    # Where the lambda first reads `this` (or a bare `.name`); 0 = it does not.
    var this_line: int
    var this_col: int

    cue init(caps: List(PCaptureVar), is_thread: bool)
        .own = HashMap()
        .caps = caps
        .implicit = List(str)()
        .first_line = HashMap()
        .first_col = HashMap()
        .is_thread = is_thread
        .this_line = 0
        .this_col = 0

# -- Resolver -----------------------------------------------------------------
# Results are accessed via getter methods (errorCount, firstError, symbolCount)
# rather than a result struct, so the test can use primitive return values
# (int, str) and avoid cross-module List field TC-type inference issues.

class Resolver
    # Scope levels (each maps name - kind-int)
    var module_scope: HashMap(str, int)   # class and union names + use aliases
    var class_scope : HashMap(str, int)   # current class's fields and methods
    var method_scope: HashMap(str, int)   # current method's locals (params implicit)

    var errors      : List(ResolveError)
    var symbol_count: int
    var file_name   : str
    # Full source text for caret-rendered diagnostics; "" → no caret.
    var source      : str
    # BUG-569: the lambdas being walked (innermost last), every lambda of the current
    # function, the first REBINDING of each function-level name, the locals bound to a
    # capture-less lambda (a comptime function Zig folds; capturing one would make the
    # closure struct comptime-only), and whether the next lambda is a `sys.go` argument.
    var lam_stack   : List(LamFrame)
    var fn_lams     : List(LamFrame)
    var fn_written_line: HashMap(str, int)
    var fn_written_col : HashMap(str, int)
    var foldable    : HashMap(str, int)
    var next_lambda_thread: bool
    var last_lambda_captures: int
    # What `this` is in the methods being walked: 0 none (a top-level def), 1 a class
    # instance (a reference -- a closure copies the pointer and shares the object), 2 a
    # struct value (a copy would silently diverge, so a closure reading it is refused).
    var this_kind: int
    # BUG-615: where each member of the class being walked, and each top-level name of the
    # module, was first declared -- Zig has no overloading, so a second declaration of one
    # name is a "duplicate struct member" inside zig. 0 = declared without a position.
    var member_lines: HashMap(str, int)
    var top_lines: HashMap(str, int)

    cue init(file_name: str, source: str = "")
        .module_scope  = HashMap()
        .class_scope   = HashMap()
        .method_scope  = HashMap()
        .errors        = List(ResolveError)()
        .symbol_count  = 0
        .file_name     = file_name
        .source        = source
        .lam_stack     = List(LamFrame)()
        .fn_lams       = List(LamFrame)()
        .fn_written_line = HashMap()
        .fn_written_col  = HashMap()
        .foldable      = HashMap()
        .next_lambda_thread = false
        .last_lambda_captures = 0
        .this_kind = 0
        .member_lines = HashMap()
        .top_lines = HashMap()

    # `file:line:col: error: msg`, plus the offending source line and a `^` under
    # the column when the source is available (li/col are 1-based).
    def fmtErrAt(line: int, col: int, msg: str): str
        var head = .file_name + ":" + line.toString() + ":" + col.toString() + ": error: " + msg
        var src_line = .sourceLine(line - 1)
        if src_line.len > 0
            var caret = StringBuilder()
            var c = 1
            while c < col
                caret.append(" ")
                c = c + 1
            caret.append("^")
            return head + "\n" + src_line + "\n" + caret.build()
        return head

    # Return the (0-based) source line, or "" if out of range / no source.
    def sourceLine(li: int): str
        if .source.len == 0 or li < 0
            return ""
        var idx = 0
        for ln in .source.split("\n")
            if idx == li
                return ln
            idx = idx + 1
        return ""

    # -- Result accessors (return primitives for cross-module use) -------------

    def errorCount(): int
        return .errors.len

    def symbolCount(): int
        return .symbol_count

    def firstError(): str
        if .errors.len > 0
            return .errors.at(0).message
        return ""

    def allErrorMessages(): str
        var b: StringBuilder = StringBuilder()
        for e in .errors
            b.append(e.message)
            b.append("\n")
        return b.build()

    # -- Public entry point ----------------------------------------------------

    def resolve(root: PNode) throws
        .bindPass1(root)?
        .resolvePass2(root)?

    # -- Pass 1: Bind - hoist all top-level names ------------------------------

    def bindPass1(root: PNode) throws
        if root is PNode.module_ as m
            for decl in m.decls
                .bindTopDecl(decl)?
    # BUG-615: a second top-level declaration of one name IN ONE KIND was a "duplicate struct
    # member" inside zig. The kinds are the emitted namespaces: a function is `_zbr_fn_<n>`,
    # a type (class, struct, enum, union, interface, sig) `_zbr_ty_<n>`, a module var
    # `_zbr_mv_<n>` -- so a `def` and a class sharing a name never meet in zig and build
    # today (measured on the compiler before this check); only a same-kind pair collides.
    # A struct and an interface parse as a PClass, positioned like a class.
    def declareTop(kind: str, name: str, line: int, col: int)
        var key: str = kind + ":" + name
        if .top_lines.contains(key)
            if line > 0
                var first: int = .top_lines.fetch(key)
                var top_at: str = ""
                if first > 0
                    top_at = " (line " + first.toString() + ")"
                .errors.add(ResolveError(.fmtErrAt(line, col, "`" + name + "` is already declared at the top of this module" + top_at + " -- two declarations cannot share a name; rename one")))
        else
            .top_lines.put(key, line)

    def bindTopDecl(decl: PNode) throws
        branch decl
            on PNode.class_ as c
                .declareTop("type", c.name, c.line, c.col)
                .module_scope.put(c.name, 0)
                .symbol_count = .symbol_count + 1
            on PNode.struct_ as s
                .declareTop("type", s.name, s.line, s.col)
                .module_scope.put(s.name, 0)
                .symbol_count = .symbol_count + 1
            on PNode.union_decl as u
                .declareTop("type", u.name, u.line, u.col)
                .module_scope.put(u.name, 0)
                .symbol_count = .symbol_count + 1
            on PNode.enum_ as e
                .declareTop("type", e.name, e.line, e.col)
                .module_scope.put(e.name, 0)
                .symbol_count = .symbol_count + 1
            on PNode.sig_ as sg
                .declareTop("type", sg.name, sg.line, sg.col)
                .module_scope.put(sg.name, 0)
                .symbol_count = .symbol_count + 1
            on PNode.interface_ as i
                # B5(a): register interface names so `obj is IFace` resolves the
                # interface name (previously "undefined name: 'IFace'").
                .declareTop("type", i.name, i.line, i.col)
                .module_scope.put(i.name, 0)
                .symbol_count = .symbol_count + 1
            on PNode.method_ as m
                .declareTop("fn", m.name, m.line, m.col)
                .module_scope.put(m.name, 1)
                .symbol_count = .symbol_count + 1
            on PNode.stmt_var as v
                .declareTop("var", v.name, v.line, v.col)
                # Module-level var/const: hoist its name into module scope so bare
                # references from function bodies resolve (emitted as a file-scope
                # `pub var`/`pub const` by CodeGen).
                .module_scope.put(v.name, 0)
                .symbol_count = .symbol_count + 1
            on PNode.use_ as u
                .module_scope.put(u.path, 5)
                for name in u.exposed
                    .module_scope.put(name, 5)
            on PNode.namespace_decl as ns
                # Register the root component in module scope.
                var ns_root_parts: List(str) = ns.name.split(".")
                .module_scope.put(ns_root_parts.at(0), 0)
                .symbol_count = .symbol_count + 1
            else
                pass

    # -- Pass 2: Resolve - walk class bodies -----------------------------------

    def resolvePass2(root: PNode) throws
        if root is PNode.module_ as m
            for decl in m.decls
                .resolveTopDecl(decl)?
    def resolveTopDecl(decl: PNode) throws
        branch decl
            on PNode.class_ as c
                .this_kind = 1
                .enterClass(c.name, c.members, c.type_params)?
                .this_kind = 0
            on PNode.struct_ as s
                .this_kind = 2
                .enterClass(s.name, s.members, s.type_params)?
                .this_kind = 0
            on PNode.method_ as m
                .enterMethod(m.params, m.stmts)?
            on PNode.stmt_var as mv
                # A MODULE var's initializer: only module scope is visible. It was never
                # resolved, so `var q = undefinedThing + 2` passed `-c` and failed in Zig.
                .class_scope = HashMap()
                .method_scope = HashMap()
                for mve in mv.init_expr
                    .resolveExpr(mve)?
            on PNode.namespace_decl as ns
                # Resolve method bodies inside the namespace (all levels).
                for ns_d in ns.decls
                    branch ns_d
                        on PNode.method_ as nm
                            .enterMethod(nm.params, nm.stmts)?
                        on PNode.namespace_decl as inner_ns
                            for inner_d in inner_ns.decls
                                if inner_d is PNode.method_ as im
                                    .enterMethod(im.params, im.stmts)?
                        else
                            pass
            else
                pass

    # Enter a class: collect all member names first, then resolve method bodies.
    # `members` is passed by value (shallow copy of the List header) - safe for
    # read-only iteration; the underlying array is shared with the parse tree.
    def enterClass(name: str, members: List(PNode), type_params: List(str)) throws
        .class_scope = HashMap()
        .member_lines = HashMap()
        # Register generic type params so they resolve: valid names in method bodies.
        # A constrained parameter arrives as "T|Comparable(T)" (Parser.parseConstraintClause);
        # the NAME is the part before the bar -- registering the whole string made
        # `List(T)()` inside a `where`-constrained class "undefined name: 'T'" (2026-09-16).
        for tp in type_params
            var tp_name: str = tp
            var bar: int = tp.indexOf("|")
            if bar >= 0
                tp_name = tp.substring(0, bar)
            .class_scope.put(tp_name, 6)
            .symbol_count = .symbol_count + 1
        # Sub-pass: collect field and method names before resolving any body
        for member in members
            .collectMember(member)?
        # Resolve bodies
        for member in members
            .resolveMember(member)?

    # BUG-615: two members of one class or struct with one name -- two methods (Zebra has no
    # overloading), two fields, a field and a method, a static and an instance method -- were
    # a "duplicate struct member" inside zig.
    def declareMember(name: str, line: int, col: int)
        if .member_lines.contains(name)
            if line > 0
                var mfirst: int = .member_lines.fetch(name)
                var mwhere: str = ""
                if mfirst > 0
                    mwhere = " (line " + mfirst.toString() + ")"
                .errors.add(ResolveError(.fmtErrAt(line, col, "`" + name + "` is already a member of this type" + mwhere + " -- two members cannot share a name (Zebra has no overloading); rename one")))
        else
            .member_lines.put(name, line)

    def collectMember(member: PNode) throws
        branch member
            on PNode.method_ as m
                .declareMember(m.name, m.line, m.col)
                .class_scope.put(m.name, 1)
                .symbol_count = .symbol_count + 1
            on PNode.field_ as f
                .declareMember(f.name, f.line, f.col)
                .class_scope.put(f.name, 2)
                .symbol_count = .symbol_count + 1
            else
                pass

    def resolveMember(member: PNode) throws
        branch member
            on PNode.method_ as m
                .enterMethod(m.params, m.stmts)?
            on PNode.init_ as i
                .enterMethod(i.params, i.stmts)?
            on PNode.field_ as f
                # BUG-602: a field's default was never resolved, so `var c: int = NOPE`
                # passed `-c` and failed inside zig, pointing into the generated file. The
                # class's own names are in scope (a static field or method may be named);
                # no locals, as for a module var's initializer.
                .method_scope = HashMap()
                for fe in f.init_expr
                    .resolveExpr(fe)?
            else
                pass

    # Enter a method: reset the method scope, declare params, then walk statements.
    def enterMethod(params: List(PParam), stmts: List(PNode)) throws
        .method_scope = HashMap()
        .fn_lams = List(LamFrame)()
        .fn_written_line = HashMap()
        .fn_written_col = HashMap()
        .foldable = HashMap()
        for p in params
            .declare(p.name, 3)
            .symbol_count = .symbol_count + 1
        .resolveStmts(stmts)?
        .finishCaptures()

    # A name bound in the current scope -- and, inside a lambda, one of the lambda's own.
    def declare(name: str, kind: int)
        .method_scope.put(name, kind)
        if .foldable.contains(name)
            .foldable.remove(name)
        if .lam_stack.len > 0
            .lam_stack.at(.lam_stack.len - 1).own.put(name, kind)

    # BUG-613: a local declared INSIDE a lambda whose name is already visible -- a local or
    # parameter of the enclosing function, an outer lambda's local, the lambda's own
    # parameter -- is a Zig shadowing error ("local constant shadows local constant from
    # outer scope"): the lambda is a nested function, and Zig forbids its locals from
    # shadowing. `method_scope` is block-scoped (BUG-589), so a sibling block's name is not
    # visible here and is not refused. Lambda PARAMETERS keep BUG-233's rename; captures are
    # struct fields; neither goes through here.
    def declareLocal(name: str, line: int, col: int)
        if .lam_stack.len > 0 and name != "_" and .method_scope.contains(name)
            .errors.add(ResolveError(.fmtErrAt(line, col, "`" + name + "` is already declared where this lambda can see it -- a lambda's local cannot reuse the name (Zig forbids shadowing); rename one of them")))
        .declare(name, 4)

    # BUG-569: `name` was read at line:col. If a lambda is being walked and the name is a
    # local or parameter of the enclosing function -- not the lambda's own -- every lambda
    # between the read and the function captures it (an outer lambda must carry the value
    # in for an inner one to copy).
    def noteCapture(name: str, line: int, col: int)
        if .lam_stack.len == 0 or not .method_scope.contains(name) or .foldable.contains(name)
            return
        var i: int = .lam_stack.len - 1
        while i >= 0
            var fr = .lam_stack.at(i)
            if fr.own.contains(name)
                return
            if not fr.first_line.contains(name)
                fr.implicit.add(name)
                fr.first_line.put(name, line)
                fr.first_col.put(name, col)
            i = i - 1

    # BUG-569: the lambdas being walked read `this` (or a bare `.name`) at line:col. Every
    # frame from the innermost out carries it: an outer lambda must hold `this` for an
    # inner one to copy.
    def noteThis(line: int, col: int)
        for fr in .lam_stack
            if fr.this_line == 0
                fr.this_line = line
                fr.this_col = col

    # A pipeline's right side `x -> .lower()` is a member with no base that is NOT `this`
    # -- it is applied to the left side. Resolve it without noting `this`.
    def resolvePipeRhs(e: PNode) throws
        if e is PNode.expr_member as pm
            if pm.base.len == 0
                return
        if e is PNode.expr_call as pc
            if pc.callee.len == 1
                if pc.callee.at(0) is PNode.expr_member as pcm
                    if pcm.base.len == 0
                        for a in pc.args
                            .resolveExpr(a)?
                        return
        .resolveExpr(e)?

    # BUG-569: `name` is REBOUND at line:col (`=`, a compound assignment, `<<-`). Only a
    # rebinding of the function's own variable counts: one of a lambda's own locals or
    # `capture` names is that lambda's business.
    def noteWrite(name: str, line: int, col: int)
        var i: int = .lam_stack.len - 1
        while i >= 0
            if .lam_stack.at(i).own.contains(name)
                return
            i = i - 1
        if not .fn_written_line.contains(name)
            .fn_written_line.put(name, line)
            .fn_written_col.put(name, col)

    # BUG-569: the function's walk is over, so every implicit capture is known. A name
    # something rebinds is refused (a closure's copy would not see the change, and shared
    # capture -- design note step 4 -- is not built); a `sys.go` closure keeps the explicit
    # rule QUICKSTART states; the rest become `capture` entries, exactly as if written.
    # A pass that ignores this resolver's errors therefore never gets a refused capture --
    # the lambda still names a runtime local and zig refuses it, loudly.
    def finishCaptures()
        var refused: HashMap(str, int) = HashMap()
        for fr in .fn_lams
            if fr.is_thread and fr.implicit.len > 0
                var tn: str = fr.implicit.at(0)
                .errors.add(ResolveError(.fmtErrAt(fr.first_line.fetch(tn), fr.first_col.fetch(tn), "a `sys.go` closure names what it uses in a `capture` block (QUICKSTART §19.1): `capture` / `var " + tn + ": T = " + tn + "`")))
            else if fr.is_thread and fr.this_line > 0
                .errors.add(ResolveError(.fmtErrAt(fr.this_line, fr.this_col, "a `sys.go` closure names what it uses in a `capture` block (QUICKSTART §19.1): `capture` / `var me = this`")))
            else
                # `this` in a CLASS method is a reference: the closure copies the pointer and
                # shares the object, which is exactly by-reference. In a STRUCT method it is a
                # value, and a change made through the copy would be lost -- refused, naming
                # the local that works.
                if fr.this_line > 0 and .this_kind == 2
                    .errors.add(ResolveError(.fmtErrAt(fr.this_line, fr.this_col, "a closure in a struct method cannot read `this` -- a struct is a value, and the closure would get a copy; bind what it needs to a local first (`var n = .n`)")))
                else if fr.this_line > 0 and .this_kind == 1
                    var this_init = List(PNode)()
                    this_init.add(PNode.expr_this(PPos(fr.this_line, fr.this_col)))
                    fr.caps.add(PCaptureVar("_zbr_this", "", this_init, true, true))
                for nm in fr.implicit
                    if .fn_written_line.contains(nm)
                        if not refused.contains(nm)
                            refused.put(nm, 1)
                            .errors.add(ResolveError(.fmtErrAt(.fn_written_line.fetch(nm), .fn_written_col.fetch(nm), "'" + nm + "' is changed here, and a closure reads it (line " + fr.first_line.fetch(nm).toString() + ") -- a closure gets a copy, which would not see the change; shared capture is not built yet (BUG-569). Keep the state in the closure with a `capture` block, or pass the value in as an argument")))
                    else
                        var cap_init = List(PNode)()
                        cap_init.add(PNode.expr_id(PExprId(nm, fr.first_line.fetch(nm), fr.first_col.fetch(nm))))
                        fr.caps.add(PCaptureVar(nm, "", cap_init, true, true))
        .fn_lams = List(LamFrame)()

    # -- Statement walking -----------------------------------------------------

    def resolveStmts(stmts: List(PNode)) throws
        for stmt in stmts
            .resolveStmt(stmt)?

    # BUG-589: a BLOCK is a scope. `method_scope` was one flat table per function, so a
    # local declared inside an `if` stayed visible to the rest of the function -- `zebra -c`
    # accepted a read of it from a SIBLING block, and zig, whose blocks are scopes, refused
    # "use of undeclared identifier". Every nested statement list -- and every binding a
    # construct introduces (`if x as y`, loop variables, a catch binding, a branch arm's) --
    # now lives in a scope that ends with its block: a snapshot of the table, restored after.
    def resolveBlock(stmts: List(PNode)) throws
        var saved = .method_scope.copy()
        .resolveStmts(stmts)?
        .method_scope = saved

    # pnode-stmt-walker: exhaustive
    # pnode-stmt-walker-ok: stmt_with its TOP-LEVEL bare calls and assignments are a rewrite to `obj.name` (QUICKSTART §39), which this walker cannot tell from an undefined name -- the body is not walked; its target is
    def resolveStmt(stmt: PNode) throws
        branch stmt
            on PNode.stmt_var as v
                # Resolve init before declaring - so `var x = x` errors
                for expr in v.init_expr
                    .resolveExpr(expr)?
                .declareLocal(v.name, v.line, v.col)
                .symbol_count = .symbol_count + 1
                # BUG-569: a local bound to a lambda that captures nothing is a comptime
                # function in the emit; another lambda reads it without capturing it.
                if v.init_expr.len == 1
                    if v.init_expr.at(0) is PNode.expr_lambda
                        if .last_lambda_captures == 0
                            .foldable.put(v.name, 1)
            on PNode.stmt_destruct as d
                for expr in d.init_expr
                    .resolveExpr(expr)?
                for nm in d.names
                    .declareLocal(nm, d.line, d.col)
                    .symbol_count = .symbol_count + 1
            on PNode.stmt_return as r
                for expr in r.value
                    .resolveExpr(expr)?
            on PNode.stmt_yield as y
                for expr in y.value
                    .resolveExpr(expr)?
            on PNode.stmt_if as i
                for expr in i.cond
                    .resolveExpr(expr)?
                var if_saved = .method_scope.copy()
                if i.is_capture as ic
                    .declare(ic, 4)
                    .symbol_count = .symbol_count + 1
                .resolveStmts(i.then_stmts)?
                .method_scope = if_saved
                .resolveBlock(i.else_stmts)?
            on PNode.stmt_while as w
                for expr in w.cond
                    .resolveExpr(expr)?
                .resolveBlock(w.stmts)?
            on PNode.stmt_for_in as f
                for expr in f.iter
                    .resolveExpr(expr)?
                var fi_saved = .method_scope.copy()
                for var_name in f.var_names
                    .declareLocal(var_name, f.line, f.col)
                # BUG-593: the `for x in xs if <filter>` condition was never walked.
                for expr in f.filter
                    .resolveExpr(expr)?
                .resolveStmts(f.stmts)?
                .method_scope = fi_saved
                .resolveBlock(f.else_stmts)?
            on PNode.stmt_for_num as fnum
                # BUG-593: a numeric `for` was not walked at all -- bounds or body.
                for expr in fnum.start
                    .resolveExpr(expr)?
                for expr in fnum.stop_
                    .resolveExpr(expr)?
                for expr in fnum.step
                    .resolveExpr(expr)?
                var fn_saved = .method_scope.copy()
                .declare(fnum.var_name, 4)
                .resolveStmts(fnum.stmts)?
                .method_scope = fn_saved
                .resolveBlock(fnum.else_stmts)?
            on PNode.stmt_assign as a
                for expr in a.target
                    .resolveExpr(expr)?
                    if expr is PNode.expr_id as a_id
                        .noteWrite(a_id.name, a.line, a.col)       # BUG-569
                for expr in a.value
                    .resolveExpr(expr)?
            on PNode.stmt_assert as a
                for expr in a.cond
                    .resolveExpr(expr)?
                for expr in a.message
                    .resolveExpr(expr)?
            on PNode.stmt_raise as r
                for expr in r.message
                    .resolveExpr(expr)?
            on PNode.stmt_try_catch as tc
                .resolveBlock(tc.body_stmts)?
                var tc_saved = .method_scope.copy()
                if tc.catch_binding != ""
                    .declare(tc.catch_binding, 4)
                .resolveStmts(tc.catch_stmts)?
                .method_scope = tc_saved
            on PNode.stmt_branch as br
                for expr in br.subject
                    .resolveExpr(expr)?
                for arm in br.arms
                    var arm_saved = .method_scope.copy()
                    if arm.binding != ""
                        .declare(arm.binding, 4)
                    .resolveStmts(arm.stmts)?
                    .method_scope = arm_saved
                .resolveBlock(br.else_stmts)?
            on PNode.stmt_with as wi
                # The body is NOT walked (see the waiver above); its target is.
                for expr in wi.target
                    .resolveExpr(expr)?
            on PNode.stmt_in as ins
                # BUG-593: `in EXPR` and its block were not walked.
                for expr in ins.expr
                    .resolveExpr(expr)?
                .resolveBlock(ins.stmts)?
            on PNode.stmt_allocate as al
                # BUG-593: `allocate SOURCE` and its block were not walked.
                for expr in al.source
                    .resolveExpr(expr)?
                .resolveBlock(al.stmts)?
            on PNode.stmt_require as rq
                for expr in rq
                    .resolveExpr(expr)?
            on PNode.stmt_ensure as en
                for expr in en
                    .resolveExpr(expr)?
            on PNode.stmt_copy_out as co
                for expr in co.target
                    .resolveExpr(expr)?
                    if co.deep
                        if expr is PNode.expr_id as co_id
                            .noteWrite(co_id.name, co.line, co.col)   # BUG-569
                for expr in co.value
                    .resolveExpr(expr)?
            on PNode.stmt_expr as inner
                .resolveExpr(inner)?
            on PNode.stmt_print as arg_nodes
                var arg_list: List(PNode) = arg_nodes
                for an in arg_list
                    .resolveExpr(an)?
            on PNode.stmt_pass
                pass
            on PNode.stmt_break
                pass
            on PNode.stmt_continue
                pass
            else
                pass

    # -- Expression walking ----------------------------------------------------

    # BUG-571 (pattern search 1): this walker visited 13 of the 35 expression kinds, so an
    # undefined name inside a list / dict / set / tuple / array literal, `orelse`, `catch`, a
    # chained comparison, a pipeline, a named argument or a lambda passed the front end -- `zebra
    # -c` and the LSP said nothing, and zig reported "use of undeclared identifier" later, with
    # no column. Every expression-bearing kind is walked now; the rest are leaves (literals,
    # nil, this, result, zig"..." text, a format spec).
    # pnode-walker: exhaustive
    # pnode-walker-ok: expr_zig_lit its `${Type}` names are checked by the type checker, which reports an unknown one
    def resolveExpr(expr: PNode) throws
        branch expr
            on PNode.expr_orelse as por
                for e in por.expr
                    .resolveExpr(e)?
                for e in por.fallback
                    .resolveExpr(e)?
            on PNode.expr_catch as pca
                for e in pca.expr
                    .resolveExpr(e)?
                var pca_saved = .method_scope.copy()          # BUG-589: the binding is the fallback's
                if pca.binding != ""
                    .declare(pca.binding, 4)
                for e in pca.fallback
                    .resolveExpr(e)?
                .method_scope = pca_saved
            on PNode.expr_chained_cmp as pcc
                for e in pcc.operands
                    .resolveExpr(e)?
            on PNode.expr_pipeline as ppl
                for e in ppl.lhs
                    .resolveExpr(e)?
                for e in ppl.rhs
                    .resolvePipeRhs(e)?
            on PNode.expr_list_lit as pll
                for e in pll.elems
                    .resolveExpr(e)?
            on PNode.expr_set_lit as psl
                for e in psl.elems
                    .resolveExpr(e)?
            on PNode.expr_array_lit as pal
                for e in pal.elems
                    .resolveExpr(e)?
            on PNode.expr_tuple_lit as ptl
                for e in ptl.elems
                    .resolveExpr(e)?
            on PNode.expr_dict_lit as pdl
                for e in pdl.keys
                    .resolveExpr(e)?
                for e in pdl.values
                    .resolveExpr(e)?
            on PNode.expr_named_arg as pna
                for e in pna.value
                    .resolveExpr(e)?
            on PNode.expr_lambda as plm
                var plm_saved = .method_scope.copy()          # BUG-589: a lambda's names are its own
                var plm_thread: bool = .next_lambda_thread
                .next_lambda_thread = false
                # A `capture` initialiser runs where the closure is MADE, so it reads the
                # enclosing scope: resolve it before this lambda's frame exists (BUG-569 --
                # a name it reads is captured by the lambda around this one, if any).
                for lc in plm.captures
                    for e in lc.init_expr
                        .resolveExpr(e)?
                var plm_frame = LamFrame(plm.captures, plm_thread)
                .lam_stack.add(plm_frame)
                .fn_lams.add(plm_frame)
                for lp in plm.params
                    .declare(lp.name, 3)
                for lc in plm.captures
                    .declare(lc.name, 4)
                    if lc.name == "_zbr_this"
                        plm_frame.this_line = -1      # already captured: a second pass adds none
                for e in plm.body_expr
                    .resolveExpr(e)?
                .resolveStmts(plm.body_stmts)?
                var _ = .lam_stack.pop()?
                .method_scope = plm_saved
                .last_lambda_captures = plm.captures.len + plm_frame.implicit.len
            on PNode.expr_id as id
                if not .isInScope(id.name)
                    .errors.add(ResolveError(.fmtErrAt(id.line, id.col, "undefined name: '" + id.name + "'")))
                else
                    .noteCapture(id.name, id.line, id.col)
            on PNode.expr_binary as b
                for e in b.left
                    .resolveExpr(e)?
                for e in b.right
                    .resolveExpr(e)?
            on PNode.expr_unary as u
                for e in u.operand
                    .resolveExpr(e)?
            on PNode.expr_call as c
                for e in c.callee
                    .resolveExpr(e)?
                # BUG-338: the arguments of a builtin GENERIC constructor are TYPES, not
                # values -- `List(JsonValue)()` / `HashMap(int, SysProcess)()`. Primitives
                # were already builtins; the stdlib type names were "undefined name".
                var generic_ctor: bool = false
                for ce in c.callee
                    if ce is PNode.expr_id as cid
                        if cid.name == "List" or cid.name == "HashMap" or cid.name == "Set" or cid.name == "Atomic" or cid.name == "Chan" or cid.name == "ObjectPool"
                            generic_ctor = true
                # BUG-569: a lambda handed straight to `sys.go` keeps the explicit-capture
                # rule (QUICKSTART §19.1); finishCaptures refuses an implicit one by name.
                var go_call: bool = false
                for ce2 in c.callee
                    if ce2 is PNode.expr_member as gm
                        if gm.member == "go" and gm.base.len == 1
                            if gm.base.at(0) is PNode.expr_id as gid
                                go_call = gid.name == "sys"
                for e in c.args
                    var skip_e: bool = false
                    if generic_ctor
                        if e is PNode.expr_id as aid
                            if isBuiltinTypeName(aid.name)
                                skip_e = true
                    if not skip_e
                        if go_call and e is PNode.expr_lambda
                            .next_lambda_thread = true
                        .resolveExpr(e)?
            on PNode.expr_index as ix
                for e in ix.object
                    .resolveExpr(e)?
                for e in ix.index
                    .resolveExpr(e)?
            on PNode.expr_slice as sl
                for e in sl.object
                    .resolveExpr(e)?
                for e in sl.start
                    .resolveExpr(e)?
                for e in sl.stop_
                    .resolveExpr(e)?
            on PNode.expr_member as m
                for e in m.base
                    .resolveExpr(e)?
                if m.base.len == 0
                    .noteThis(m.line, m.col)          # `.name` is `this.name` (BUG-569)
            on PNode.expr_this as pthis
                .noteThis(pthis.line, pthis.col)
                # member name is accessed via dot notation - not a scope reference
            on PNode.expr_try
                # ^PNode payload - skip deep resolution (same limitation: stmt_expr)
                pass
            on PNode.expr_to_bang
                # ^PNode payload - skip deep resolution
                pass
            on PNode.expr_except as ex
                for e in ex.base
                    .resolveExpr(e)?
                for f in ex.fields
                    for v in f.value
                        .resolveExpr(v)?
            on PNode.expr_string_interp as si
                for part in si.parts
                    .resolveExpr(part)?
            on PNode.expr_opt_chain as poc
                for e in poc.base
                    .resolveExpr(e)?
                for e in poc.args
                    .resolveExpr(e)?
            on PNode.expr_if_expr as pie
                for e in pie.cond
                    .resolveExpr(e)?
                for e in pie.then_expr
                    .resolveExpr(e)?
                for e in pie.else_expr
                    .resolveExpr(e)?
            else
                # Literals (int, float, bool, str, nil, this) need no resolution
                pass

    # -- Scope lookup ----------------------------------------------------------

    def isInScope(name: str): bool
        if .method_scope.contains(name)
            return true
        if .class_scope.contains(name)
            return true
        if .module_scope.contains(name)
            return true
        if .isBuiltin(name)
            return true
        return false

    def isBuiltin(name: str): bool
        # Language primitives and special names
        if name == "int" or name == "str" or name == "bool" or name == "float"
            return true
        # char / uint are keyword primitives too, but were missing here — so in
        # type position (e.g. the generic arg `List(char)`) they were rejected as
        # "undefined name" even though typeFromName + codegen handle them
        # (char -> u21). This was BUG-172.
        if name == "char" or name == "uint"
            return true
        # Sized numerics as generic type args — `List(float32)()` for SIMD (BUG-197,
        # Tier 2). The parser now admits them (isSizedTypeName); typeFromName + genType
        # map them (float32 -> f32, int32 -> i32, …). Accept both the `floatNN` spelling
        # and the bare `fNN`/`iNN`/`uNN` identifier forms.
        if name == "int8" or name == "int16" or name == "int32" or name == "int64"
            return true
        if name == "uint8" or name == "uint16" or name == "uint32" or name == "uint64"
            return true
        if name == "float16" or name == "float32" or name == "float64"
            return true
        if name == "f16" or name == "f32" or name == "f64"
            return true
        if name == "nil" or name == "true" or name == "false"
            return true
        if name == "this" or name == "print" or name == "assert"
            return true
        # Standard library entry points
        if name == "List" or name == "HashMap" or name == "StringBuilder" or name == "Chan"
            return true
        if name == "Atomic" or name == "ThreadPool" or name == "ObjectPool" or name == "Set"
            return true
        if name == "DynLib"
            return true
        # Stdlib namespaces (no `use` required) — the SHARED source of truth.
        # `CgHelpers.isStdlibNs` is the single list consulted by both this resolver
        # check and `CodeGen.isStdlibNamespace`, so the set can no longer drift (the
        # `Build`-was-a-namespace-in-codegen-but-undefined-here bug the divergence
        # audit found). Add a new stdlib namespace in CgHelpers.isStdlibNs, once.
        if isStdlibNs(name)
            return true
        # Builtins that are NOT dispatch-namespaces (kept here, not in isStdlibNs, so
        # `X.method()` codegen doesn't mistake them for a stdlib namespace): the WS
        # connection handle, extra stdlib value types, allocators, low-level escapes.
        if name == "WsConn" or name == "CsvWriter" or name == "Calendar"
            return true
        # CodeEditor: a value type / constructor (CodeEditor() and
        # CodeEditor.forZebra()), NOT a dispatch namespace — kept here, out of
        # isStdlibNs, so `CodeEditor.forZebra()` codegen isn't mistaken for a
        # stdlib-namespace call. Ported from bootstrap Builtins.zig.
        if name == "CodeEditor"
            return true
        if name == "SqliteDb" or name == "SqliteRow" or name == "Base64"
            return true
        if name == "Allocator" or name == "Arena"
            return true
        if name == "Debug" or name == "FixedBuffer" or name == "StackFallback"
            return true
        if name == "Page" or name == "Smp" or name == "C"
            return true
        if isSimdName(name)
            return true
        return false

    def isSimdName(name: str): bool
        # SIMD vector type: {elemType}x{lanes}, e.g. f32x8, i16x16, u8x32
        if not name.contains("x")
            return false
        var parts: List(str) = name.split("x")
        if parts.len != 2
            return false
        if parts.at(1) == ""
            return false
        var prefix = parts.at(0)
        if prefix == "f16" or prefix == "f32" or prefix == "f64"
            return true
        if prefix == "i8" or prefix == "i16" or prefix == "i32" or prefix == "i64"
            return true
        if prefix == "u8" or prefix == "u16" or prefix == "u32" or prefix == "u64"
            return true
        if prefix == "bool"
            return true
        return false

# -- Main ----------------------------------------------------------------------

def main()
    print("resolver: loaded (run resolver_test.zbr to exercise)")
