# selfhost/main.zbr -- Phase 22: Zebra self-hosted compiler (primary binary)
#
# Phase 22 cutover: this file compiles to the production `zebra` binary.
# The Zig-implemented compiler (src/) is now the bootstrap artifact only.
#
# Self-hosting pipeline (all phases complete):
#   Phase 1  ✅ Lexer        (selfhost/Lexer.zbr)          — tokenizes source
#   Phase 2  ✅ AST types    (selfhost/Ast.zbr)             — node type definitions
#   Phase 3  ✅ Parser       (selfhost/Parser.zbr)          — builds PNode parse tree
#   Phase 4  ✅ Resolver     (selfhost/Resolver.zbr)        — scope + name checking
#   Phase 5  ✅ TypeChecker  (selfhost/tc_*.zbr)            — type inference + checks
#   Phase 6  ✅ CG helpers   (selfhost/CgHelpers.zbr)      — escape/mutation analysis
#   Phase 7  ✅ CodeGen      (selfhost/CodeGen.zbr)         — Zig emission from Ast.zbr
#   Phase 8  ✅ Main / CLI   (this file)                    — argument parsing + dispatch
#   Phase 9  ✅ ASTBuilder   (selfhost/AstBuilder.zbr)      — PNode → Ast.zbr Module
#   Phase 10 ✅ Full pipeline (this file)                   — Lex→Parse→ASTBuilder→CodeGen
#   Phase 11 ✅ Complete output (this file)                 — preamble + decls + entry thunk
#   Phase 22 ✅ Cutover       (build.zig)                   — selfhost IS the production binary
#
# Pipeline modes:
#   default:            selfhost pipeline; writes .zig file and invokes zig run
#   --emit-zig:         selfhost pipeline; outputs complete Zig source to stdout
#   --selfhost-compile: backward-compat alias for default mode (accepted, no-op)
#
# Usage (run from repo root where build.zig lives):
#   zebra <source.zbr>                       compile and run (selfhost pipeline)
#   zebra -c <source.zbr>                    compile only (selfhost pipeline)
#   zebra --emit-zig <source.zbr>            print generated Zig to stdout
#   zebra --emit-zig --output-dir DIR        emit .zig files to DIR
#   zebra --keep-temp <source.zbr>           keep the scratch build (BUG-244); the
#                                            emitted .zig and binary are removed after a
#                                            CLEAN run and always kept after a failing one
#   zebra --version                          print version and exit
#
# Preamble file: selfhost/stdlib_preamble.zig (~1465 lines)
#   Update: zig build run -- --emit-zig /tmp/counter.zbr | head -1464 | tail -n +3 > selfhost/stdlib_preamble.zig

# File, Arg, sys, Shell are built-in stdlib globals — no `use` needed.

use Parser exposing PNode, PUse, PModule, PClass
use Resolver
use AstBuilder exposing ASTBuilder
use Ast exposing Module, Decl, DeclMethod, DeclClass, DeclStruct, DeclVar, Stmt, Param, TypeRef, Span, DeclInterface, DeclEnum, DeclUnion, DeclSig, DeclNamespace, DeclInit
use CodeGen exposing generateModule, generateFull, generateFullWith, generateFullWithDeps, generateFullWithDepsTest, generateEntryPoint, generateTestEntryPoint, generateDep, generateDepWith, generateNodeAddon, generateNodeDts, implicitTrySites, inferenceGuessSites, setSingleFile, singleFile, generateSingleFileCombined, generateSingleFileDepStruct, setBuildMode, setListTargetsMode, setGuiBackend, setGuiSection, setRuntimeModule, runtimeModule, rtRuntimeText, addNativeCUse, addNativeLibUse, emittedExtern, emittedDynLib, rtReservedNames, setTestOnly, listTestEntries
use CgHelpers exposing typeRefStr
use TypeChecker exposing ModuleTypes, populateModuleTypes, buildModuleTypes, InferCtx, Diagnostic, checkModule, TcResult, walkStmts, inferExpr, typeTag, typeFromRef
use Checker exposing runCheck

# ── Multi-file compiler ──────────────────────────────────────────────────────

class MultiCompiler
    var visited: List(str)
    # BUG-295: the modules currently BEING compiled, innermost last. `visited` alone
    # cannot detect an import cycle, because it conflates two very different skips:
    # a module already FINISHED (a diamond dependency — benign, and the common case)
    # and a module still IN PROGRESS (a cycle — the only one that can bite). One set
    # cannot tell them apart; this stack can, and it carries the PATH for free, since
    # the stack IS the chain.
    var in_progress: List(str)
    # BUG-295 (b): one entry per distinct import EDGE, "dep|importer". Recorded even
    # when the dep is skipped as already-visited -- the skipped imports are exactly the
    # ones that make a module SHARED, so counting only first visits would see nothing.
    var import_edges: List(str)
    # Modules declaring a module-level `var`. A shared module of pure functions and
    # types has no instance to share, so it is not worth a word; this is what keeps the
    # end-of-compilation note from listing every module in a healthy dependency graph.
    var stateful_mods: List(str)
    # Sean's call: report, do not refuse. A cycle is currently UNDEFINED rather than
    # wrong — Zebra has no answer for module-init order across one — so the honest
    # move is to say so where the user is already looking, and decide error-vs-warning
    # after watching it fire on real code. Flip this one line to refuse.
    var cycle_is_error: bool
    var dep_class_names: List(str)
    var dep_types: ModuleTypes
    var preamble_path: str
    var output_dir: str
    var c_sources: List(str)   # paths to .c deps discovered via `use`
    var zig_sources: List(str) # BUG-262: native .zig deps, COPIED beside the emit (see below)
    var lib_sources: List(str) # BUG-266: prebuilt .lib/.a/.so/.dylib deps to LINK
    var c_i_dirs: List(str)    # deduplicated -I dirs for C deps that have a .h
    var strip_contracts: bool  # --turbo: strip require/ensure/invariant from all output
    var library_mode: bool     # --library-mode: omit `defer _arena.deinit()` from main() (script linked into a host process)
    var test_mode: bool        # true when invoked as `zebra test <file.zbr>`
    var tag_filter: str?       # --tag X: only run tests matching this tag
    var warn_non_exhaustive: bool  # --warn-non-exhaustive: warn branch...else missing variants
    var uses_sqlite: bool      # true when root generated code calls Sqlite.open/query
    var module_path: str       # --module-path DIR: extra search dir for `use` deps
    var type_scanned: List(str)  # deps scanned for types only (not emitted)
    var node_addon: bool       # --target node-addon: emit N-API glue + .js/.d.ts for root
    # Single-file Phase 2: dep modules are accumulated as `const _mod_X = struct {…}`
    # bodies (in topological/post-order) instead of written per-file; the root assembles
    # them into one combined .zig. See docs/single_file_emit_design.md §7b.
    var sf_dep_bodies: List(str)
    var sf_dep_names: List(str)
    # Runtime-module emission: the rendered zebra_rt.zig text, and the path it was
    # last written to. Both are per-process caches — see writeRuntimeModule.
    var rt_text: str
    var rt_written: str

    cue init(preamble_path: str, output_dir: str)
        .visited = List(str)()
        .in_progress = List(str)()
        .import_edges = List(str)()
        .stateful_mods = List(str)()
        .cycle_is_error = false
        .dep_class_names = List(str)()
        .dep_types = ModuleTypes()
        .preamble_path = preamble_path
        .output_dir = output_dir
        .c_sources = List(str)()
        .zig_sources = List(str)()
        .lib_sources = List(str)()
        .c_i_dirs = List(str)()
        .strip_contracts = false
        .library_mode = false
        .test_mode = false
        .tag_filter = nil
        .warn_non_exhaustive = false
        .uses_sqlite = false
        .module_path = ""
        .type_scanned = List(str)()
        .node_addon = false
        .rt_text = ""
        .rt_written = ""
        .sf_dep_bodies = List(str)()
        .sf_dep_names = List(str)()

    def alreadyVisited(p: str): bool
        var i: int = 0
        while i < visited.len
            var v: str = visited.at(i)
            if v == p
                return true
            i = i + 1
        return false

    # Index of `p` in the in-progress stack, or -1. Exact path comparison, never a
    # substring test — one module path can be a prefix of another.
    def inProgressIndex(p: str): int
        var i: int = 0
        while i < in_progress.len
            if in_progress.at(i) == p
                return i
            i = i + 1
        return -1

    def popInProgress()
        var rebuilt: List(str) = List(str)()
        var i: int = 0
        while i < in_progress.len - 1
            rebuilt.add(in_progress.at(i))
            i = i + 1
        in_progress = rebuilt

    # `A -> B -> A`, from the first occurrence of the re-entered module to the end,
    # then back to it. The repeat at both ends is deliberate: it is what makes the
    # cycle visible rather than leaving the reader to spot it.
    def importCyclePath(start: int, p: str): str
        var out: str = ""
        var i: int = start
        while i < in_progress.len
            out = out + .moduleNameOf(in_progress.at(i)) + " -> "
            i = i + 1
        return out + .moduleNameOf(p)

    def reportImportCycle(start: int, p: str)
        var kind: str = "warning"
        if cycle_is_error
            kind = "error"
        sys.errln(kind + ": import cycle: " + .importCyclePath(start, p))
        sys.errln("  a module in a cycle is compiled ONCE and the first import wins, so")
        sys.errln("  the second module sees a PARTIAL view of the first. That is well")
        sys.errln("  defined for functions and types and UNDEFINED for module-level state:")
        sys.errln("  no initialisation order satisfies both directions.")
        sys.errln("  fix: move the names they share into a third module that both import.")
        if cycle_is_error
            sys.exit(1)

    def hasListed(xs: List(str), v: str): bool
        var i: int = 0
        while i < xs.len
            if xs.at(i) == v
                return true
            i = i + 1
        return false

    # One entry per distinct (dep, importer) pair. Duplicated `use` lines in one file
    # must not make a module look shared with itself.
    def recordImportEdge(dep_path: str, parent_path: str)
        var edge: str = .moduleNameOf(dep_path) + "|" + .moduleNameOf(parent_path)
        if not .hasListed(import_edges, edge)
            import_edges.add(edge)

    # The edge is "dep|importer"; split on the separator rather than slicing, which
    # is the idiom this codebase already uses (see extractAfterDot).
    def importersOf(mod_name: str): List(str)
        var out: List(str) = List(str)()
        var i: int = 0
        while i < import_edges.len
            var e: str = import_edges.at(i)
            var parts: List(str) = e.split("|")
            if parts.len == 2
                if parts.at(0) == mod_name
                    out.add(parts.at(1))
            i = i + 1
        return out

    # BUG-295 (b), Sean's ask. Named for what it IS rather than what it looks like:
    # a module imported from two places is a DIAMOND, which is ordinary and fine, and
    # the only thing worth saying about it is that its module-level state is ONE
    # INSTANCE SHARED BY EVERY IMPORTER.
    #
    # BOTH FACTS BELOW WERE MEASURED BEFORE THIS WAS WRITTEN, and the obvious guess was
    # wrong. A leaf's initialiser does NOT run once per importer -- the root emits one
    # `_initModuleVars()` per entry of a DEDUPLICATED transitive list, so it runs
    # exactly once, before main. Warning about repeated initialisation would have sent
    # someone hunting a bug that does not exist. What IS true is the sharing: a probe
    # mutated a leaf's counter twice through one importer and read 2 through the other.
    #
    # SCOPED TO STATEFUL MODULES ON PURPOSE. Most modules in a healthy graph are shared
    # -- `Ast` is imported eight times by the selfhost -- and listing them all would be
    # a wall nobody reads. A module with no `var` has no instance to share.
    def reportSharedStatefulModules()
        var listed: List(str) = List(str)()
        var i: int = 0
        while i < stateful_mods.len
            var m: str = stateful_mods.at(i)
            if not .hasListed(listed, m)
                var imps: List(str) = .importersOf(m)
                if imps.len >= 2
                    listed.add(m)
            i = i + 1
        if listed.len == 0
            return
        sys.errln("note: " + listed.len.toString() + " module(s) imported by more than one module AND declaring module-level state:")
        var j: int = 0
        while j < listed.len
            var mn: str = listed.at(j)
            var imps2: List(str) = .importersOf(mn)
            var who: str = ""
            var k: int = 0
            while k < imps2.len
                if k > 0
                    who = who + ", "
                who = who + imps2.at(k)
                k = k + 1
            sys.errln("  " + mn + " — imported by " + who)
            j = j + 1
        sys.errln("  their state is ONE instance shared by every importer, not a copy per")
        sys.errln("  importer: a mutation through one is visible through the others. Each is")
        sys.errln("  initialised exactly once, before main.")

    def compileDep(zbr_path: str, is_root: bool) throws
        # BUG-295: check the IN-PROGRESS stack before the visited early-return -- on a
        # cycle the re-entry is also `alreadyVisited`, so testing that first would
        # return and say nothing, which is exactly today's silence.
        var cyc: int = .inProgressIndex(zbr_path)
        if cyc >= 0
            .reportImportCycle(cyc, zbr_path)
            return
        if .alreadyVisited(zbr_path)
            return
        visited.add(zbr_path)
        in_progress.add(zbr_path)
        sys.errln("compiling: " + zbr_path)

        var src: str = File.read(zbr_path)

        # Step 1: Parse
        sys.errln("  parsing...")
        const pm_node = Parser.Parser.parse(src, zbr_path)?
        sys.errln("  parsed OK")

        # Step 2: Resolve names
        var resolver = Resolver.Resolver(zbr_path, src)
        resolver.resolve(pm_node)?
        if resolver.errorCount() > 0
            sys.errln(resolver.allErrorMessages())
            sys.exit(1)
        sys.errln("  resolved OK")

        # Step 3: Discover and compile dependencies first
        branch pm_node
            on PNode.module_ as pm
                for decl in pm.decls
                    branch decl
                        on PNode.use_ as u
                            .compileDep_use(u, zbr_path)?
                        on PNode.class_ as cls
                            var cname: str = cls.name
                            dep_class_names.add(cname)
                        else
                            pass

                # Step 3b: Merge partial sibling files (Foo.extra.zbr → Foo.zbr)
                var merged_pm = .mergePartials_pmodule(pm, zbr_path)?

                # Step 4: Build AST from merged PModule
                const module = ASTBuilder.build(merged_pm, zbr_path)?

                # Step 4.5: Selfhost type-check pass (primitive mismatch detection)
                var tc_mt: ModuleTypes = buildModuleTypes(module)
                var tc_ctx: InferCtx = InferCtx(tc_mt, "")
                tc_ctx.withSource(src)
                tc_ctx.withDepTypes(dep_types)
                if warn_non_exhaustive
                    tc_ctx.enableWarnNonExhaustive()
                tc_ctx.withReservedRuntimeNames(rtReservedNames(.preamble_path))   # BUG-359
                var tc_result: TcResult = checkModule(module, zbr_path, tc_ctx)
                if tc_ctx.hasErrors()
                    sys.errln(tc_ctx.errorMessages())
                    sys.exit(1)
                if tc_ctx.hasWarnings()
                    sys.errln(tc_ctx.warningMessages())

                # Step 5: Generate Zig
                var zig_src: str = ""
                if is_root
                    # All transitive deps have been compiled above and are in
                    # `visited`. Pass their module names (basenames without
                    # `.zbr`) so _zbr_error_msg() can walk every module's
                    # _error_ctx, not just the root's direct uses.
                    var all_deps: List(str) = List(str)()
                    var vi: int = 0
                    while vi < visited.len
                        var vpath: str = visited.at(vi)
                        if vpath != zbr_path
                            all_deps.add(.moduleNameOf(vpath))
                        vi = vi + 1
                    if node_addon
                        # --target node-addon: N-API glue instead of an entry thunk,
                        # plus the JS require() shim and TypeScript declarations,
                        # written next to the SOURCE (not the temp .zig dir).
                        zig_src = generateNodeAddon(module, zbr_path, preamble_path, "selfhost/napi_preamble.zig", strip_contracts)?
                        var stem_na: str = zbr_path
                        if stem_na.endsWith(".zbr")
                            for s in zbr_path.split(".zbr")
                                stem_na = s
                                break
                        var base_na: str = stem_na
                        for seg in stem_na.split("/")
                            base_na = seg
                        File.write(stem_na + ".js", "// Auto-generated by zebra --target node-addon. Do not edit.\n'use strict';\nmodule.exports = require('./" + base_na + ".node');\n")
                        File.write(stem_na + ".d.ts", generateNodeDts(module, zbr_path))
                    else if singleFile() and sf_dep_names.len > 0
                        # Phase 2: multi-module single-file — assemble ALL modules into
                        # one combined .zig (deps accumulated below during their compileDep).
                        var fstem: str = .moduleNameOf(zbr_path)
                        if test_mode
                            zig_src = generateSingleFileCombined(module, zbr_path, preamble_path, sf_dep_bodies, sf_dep_names, dep_class_names, dep_types, strip_contracts, tc_result, library_mode, true, fstem, tag_filter)?
                        else
                            zig_src = generateSingleFileCombined(module, zbr_path, preamble_path, sf_dep_bodies, sf_dep_names, dep_class_names, dep_types, strip_contracts, tc_result, library_mode, false, "", nil)?
                    else if test_mode
                        zig_src = generateFullWithDepsTest(module, zbr_path, preamble_path, dep_class_names, dep_types, all_deps, strip_contracts, tc_result, tag_filter)?
                    else
                        zig_src = generateFullWithDeps(module, zbr_path, preamble_path, dep_class_names, dep_types, all_deps, strip_contracts, tc_result, library_mode)?
                    # Detect SQLite usage in generated root Zig. The preamble
                    # inlines the `fn _sqlite_open` DEFINITION into every program,
                    # so a plain `contains` false-positives for ALL programs —
                    # which disabled the fast-run path and linked sqlite3.c into
                    # every compile (BUG-209). A real Sqlite.open/query call adds a
                    # SECOND occurrence, so detect by count (>1), not presence.
                    # (Bind the split to a List first — a chained `.split(x).len`
                    # emits a Zig split *iterator*, which has no `.len`.)
                    var sqParts: List(str) = zig_src.split("_sqlite_open")
                    if sqParts.len > 2
                        uses_sqlite = true
                else
                    # node-addon emits the root unwrapped (exports must stay at file scope —
                    # Phase 4), so its deps must remain separate @import'd files too; single-file
                    # assembly is disabled for a node-addon build to avoid accumulating dep
                    # structs the N-API root would never emit.
                    if singleFile() and not node_addon
                        # Phase 2: accumulate this dep's namespace struct (topological order);
                        # do NOT write a per-dep file — the root emits one combined .zig.
                        sf_dep_bodies.add(generateSingleFileDepStruct(module, zbr_path, .moduleNameOf(zbr_path), dep_class_names, dep_types, strip_contracts))
                        sf_dep_names.add(.moduleNameOf(zbr_path))
                    else
                        zig_src = generateDepWith(module, zbr_path, preamble_path, dep_class_names, dep_types, strip_contracts)?

                # Step 6: Write .zig file (single-file deps are accumulated, not written)
                if not (singleFile() and not node_addon and not is_root)
                    var zig_path: str = .zbrToZig(zbr_path)
                    File.write(zig_path, zig_src)
                    sys.errln("wrote " + zig_path)
                    # Runtime-module: the program `@import("zebra_rt.zig")`s relative to
                    # its own directory, so the runtime has to sit beside it.  Every emit
                    # route — --emit-zig, --output-dir, the run-mode temp dir, `-c`, the
                    # fast backend — resolves its destination through zbrToZig, so writing
                    # it here reaches all of them from one place.
                    #
                    # Written UNCONDITIONALLY, never "only if absent": the runtime's
                    # content varies (GUI backend selection), and compileGuiProject already
                    # shipped this exact bug once — it wrote build.zig only when missing, so
                    # a stale scaffold silently kept an old dependency pin.
                    if runtimeModule()
                        .writeRuntimeModule(zig_path)
                    # BUG-262: a native `.zig` dep is @import-ed BY the emitted file, so it
                    # must land beside it. Placed here for the same reason the runtime
                    # module is: every emit route (--emit-zig, --output-dir, the run-mode
                    # temp dir, -c, the fast backend) resolves its destination through
                    # zbrToZig, so one copy site covers all of them.
                    .writeNativeZigDeps(zig_path)

                # Step 7: Contribute this module's types to dep_types so
                # subsequent deps (and the root) can resolve cross-module
                # class/struct symbols. Root's own types are built fresh by
                # generateModuleWith (module_types); root additions here
                # are harmless but unused.
                if not is_root
                    populateModuleTypes(dep_types, module)
                # BUG-295 (b): does this module declare module-level state? Derived
                # from the AST, not guessed from a name -- a top-level `var` is the
                # only thing that makes a shared module worth mentioning.
                for mdecl in module.decls
                    if mdecl is Decl.var_
                        if not .hasListed(stateful_mods, .moduleNameOf(zbr_path))
                            stateful_mods.add(.moduleNameOf(zbr_path))
            else
                raise "expected module"
        # The `raise` above aborts compilation, so a missed pop there cannot mislead
        # a later lookup -- there is no later.
        .popInProgress()

    def compileDep_use(u: PUse, parent_path: str) throws
        # Resolve dep path: same directory: parent. Try .zbr first, then .c.
        var src_dir: str = .dirOf(parent_path)
        var dep_name: str = u.path
        var dep_path: str = dep_name + ".zbr"
        if src_dir != ""
            dep_path = src_dir + "/" + dep_name + ".zbr"
        if File.exists(dep_path)
            .recordImportEdge(dep_path, parent_path)
            .compileDep(dep_path, false)?
            return
        # BUG-125: dep not adjacent to the source.  Try the --module-path dir.
        # A dep found there (e.g. an engine's zbra/ecs.zbr next to a game
        # script under game/scripts/) is parsed for TYPES ONLY — its decls
        # populate dep_types so the codegen can classify exposed unions/
        # enums/classes correctly (Component.X(v) → Component{ .X = v }).
        # It is NOT emitted: the host build provides the dep's .zig module.
        if module_path != ""
            var mp_path: str = module_path + "/" + dep_name + ".zbr"
            if File.exists(mp_path)
                .scanDepForTypes(mp_path)?
                return
        # Native C dep: collect path and optional -I dir; zig handles compilation.
        var c_path: str = dep_name + ".c"
        if src_dir != ""
            c_path = src_dir + "/" + dep_name + ".c"
        if File.exists(c_path)
            c_sources.add(c_path)
            var h_path: str = dep_name + ".h"
            if src_dir != ""
                h_path = src_dir + "/" + dep_name + ".h"
            # BUG-261: tell the codegen this `use` is native C.  Without this the
            # path below records the -I dir and the .c file for zig, but genUse
            # still emits `@import("<dep>.zig")` for a file that does not exist.
            # Registered on `u.path` (the name as WRITTEN in the `use`), because
            # that is the key genUse looks up — not the resolved filesystem path.
            addNativeCUse(u.path, File.exists(h_path))
            if File.exists(h_path)
                var c_dir: str = .dirOf(c_path)
                if c_dir == ""
                    c_dir = "."
                var already_added: bool = false
                var dchk: int = 0
                while dchk < c_i_dirs.len
                    if c_i_dirs.at(dchk) == c_dir
                        already_added = true
                    dchk = dchk + 1
                if not already_added
                    c_i_dirs.add(c_dir)
            # A source dep is fully handled; do not fall through to the library scan
            # below, so a `foo.c` beside a stale `foo.lib` keeps compiling the source.
            return

        # BUG-266: a PREBUILT library dep -- `use foo` where foo.lib / foo.a / foo.so /
        # foo.dylib sits beside the source (or on --module-path). zig takes these as
        # positional LINK inputs, so the whole mechanism is the same as the `.c` case
        # one step up, minus the compiling: register it so genUse stops emitting an
        # @import, and append the path to the zig command line.
        #
        # This is what made third-party FFI unreachable. The ABI was already correct
        # against real MSVC-built code, but nothing could tell zig WHICH library to
        # link: `BuildTarget.linkLib` takes another Zebra build target, not a path,
        # and the CLI has no passthrough. Every foreign call before this had to be
        # linked by hand. The kernel32 probes hid it, because `-lc` drags kernel32
        # in for free.
        #
        # Checked AFTER .zbr and .c so a source dep always wins; a `foo.c` and a
        # stale `foo.lib` side by side keeps compiling the source.
        # Built with .add rather than an annotated literal: BUG-230 (an annotated,
        # NON-EMPTY list literal does not compile) is still open, and this file must
        # compile under both compilers.
        var lib_exts: List(str) = List(str)()
        lib_exts.add("lib")
        lib_exts.add("a")
        lib_exts.add("so")
        lib_exts.add("dylib")
        var lx: int = 0
        while lx < lib_exts.len
            var lib_name: str = dep_name + "." + lib_exts.at(lx)
            var lib_path: str = lib_name
            if src_dir != ""
                lib_path = src_dir + "/" + lib_name
            if not File.exists(lib_path) and module_path != ""
                lib_path = module_path + "/" + lib_name
            if File.exists(lib_path)
                lib_sources.add(lib_path)
                addNativeLibUse(u.path)
                return
            lx = lx + 1
        # BUG-262: a native `.zig` dep, and it is LAST on purpose.
        #
        # It differs from the `.c` case in HOW zig consumes it: a `.c` is passed to
        # `zig build-exe` as an ARGUMENT and can live anywhere, while a `.zig` is reached
        # through the `@import("<dep>.zig")` genUse already emits -- so it has to sit NEXT
        # TO the emitted file. The selfhost emits to a TEMP directory and copied nothing
        # there, so `use ZigMath` failed with `unable to load 'ZigMath.zig': FileNotFound`
        # while the BOOTSTRAP (which emits beside the source) worked. The shipping compiler
        # was the broken one, which is why it survived so long.
        #
        # WHY AFTER THE LIBRARY SCAN, and not beside the `.c` branch where it reads more
        # naturally: a `.zig` may be the SOURCE OF a prebuilt library rather than an
        # importable module. `tools/ffi_lib_check.sh` is exactly that shape -- it builds
        # `zzlib.lib` from `zzlib.zig` and then asserts the emit does NOT @import it. So
        # the rule here is the OPPOSITE of the `.c` rule ("a foo.c beside a stale foo.lib
        # keeps compiling the source"): a prebuilt library WINS over a same-named `.zig`,
        # and only a bare `.zig` with no library beside it is an importable dep. An earlier
        # attempt put this branch first and turned that gate red.
        var zig_dep_path: str = dep_name + ".zig"
        if src_dir != ""
            zig_dep_path = src_dir + "/" + dep_name + ".zig"
        if File.exists(zig_dep_path)
            var zs_seen: bool = false
            var zsi: int = 0
            while zsi < zig_sources.len
                if zig_sources.at(zsi) == zig_dep_path
                    zs_seen = true
                zsi = zsi + 1
            if not zs_seen
                zig_sources.add(zig_dep_path)
            return
        # Nothing matched. Until 2026-09-16 this fell off the end and compilation went on
        # with the `use` unresolved -- genUse still emitted `@import("<dep>.zig")`, the
        # checker never saw the module, and the failure surfaced (if at all) as zig
        # errors about types it had never been told about. Say it here, by name.
        var looked: str = "beside " + parent_path
        if src_dir == ""
            looked = "in the current directory"
        if module_path != ""
            looked = looked + " or on --module-path " + module_path
        # Worded "module not found" so tools/doc_example_check.py files a doc fragment
        # whose `use` target is not beside it as an ARTIFACT, not a broken example.
        raise "`use " + u.path + "`: module not found -- no " + dep_name + ".zbr (or .c / .lib / .a / .so / .dylib / .zig) " + looked

    def alreadyTypeScanned(p: str): bool
        var i: int = 0
        while i < type_scanned.len
            if type_scanned.at(i) == p
                return true
            i = i + 1
        return false

    # BUG-125: parse a module-path dep for its type declarations only.
    # Populates dep_types (union/enum/class names + variant/field shapes)
    # so the root's codegen can classify exposed cross-module symbols.
    # Does NOT emit a .zig file — the host build provides the dep module.
    # Resolution errors are tolerated: we only need the declaration shapes,
    # not fully-resolved cross-module references (the dep's own transitive
    # `use` targets may not be reachable, which is fine for type extraction).
    def scanDepForTypes(zbr_path: str) throws
        if .alreadyTypeScanned(zbr_path)
            return
        type_scanned.add(zbr_path)

        var src: str = File.read(zbr_path)
        const pm_node = Parser.Parser.parse(src, zbr_path)?
        branch pm_node
            on PNode.module_ as pm
                # Scan this dep's own module-path uses first so its field
                # types (e.g. ecs's `use math exposing Vector3`) are known.
                for decl in pm.decls
                    branch decl
                        on PNode.use_ as sub_use
                            var sub_name: str = sub_use.path
                            var sub_dir: str = .dirOf(zbr_path)
                            var sub_adj: str = sub_name + ".zbr"
                            if sub_dir != ""
                                sub_adj = sub_dir + "/" + sub_name + ".zbr"
                            if File.exists(sub_adj)
                                .scanDepForTypes(sub_adj)?
                            else if module_path != ""
                                var sub_mp: str = module_path + "/" + sub_name + ".zbr"
                                if File.exists(sub_mp)
                                    .scanDepForTypes(sub_mp)?
                        else
                            pass
                # Register the dep's class names so the codegen emits class-
                # typed fields/params as `*T` (reference types) rather than
                # by-value.  compileDep does this for adjacent deps; a
                # module-path dep needs it too, else a script that stores a
                # cross-module class instance in a field (e.g. a Vector3Tween)
                # gets a value-typed field and a *T-vs-T assignment mismatch.
                for decl2 in pm.decls
                    if decl2 is PNode.class_ as cls2
                        dep_class_names.add(cls2.name)
                # Resolve for name annotations; ignore recorded errors.
                var resolver = Resolver.Resolver(zbr_path, "")
                resolver.resolve(pm_node)?
                var merged_pm = .mergePartials_pmodule(pm, zbr_path)?
                const module = ASTBuilder.build(merged_pm, zbr_path)?
                populateModuleTypes(dep_types, module)
            else
                pass

    # Write zebra_rt.zig into the same directory as an emitted program.  Deps and the
    # root all emit into one directory, so this is called once per module and rewrites
    # the same path each time.
    #
    # Skips the write when the bytes on disk already match — NOT an "only if absent"
    # check, which is the bug that shipped once in compileGuiProject (a stale scaffold
    # silently kept an old dependency pin).  Comparing CONTENT can never go stale: any
    # difference, including a GUI-backend change, still rewrites.
    #
    # The reason it matters is concurrency.  Without --output-dir the emit goes to a
    # shared temp dir, so with runtime-module emission on by default every `zebra run`
    # targets the SAME zebra_rt.zig — unlike the per-program .zig, which only collides
    # between same-named programs.  Two concurrent runs would otherwise truncate-and-
    # rewrite it under each other, and a reader could see a partial file.  Identical
    # content is the overwhelmingly common case, so this removes nearly all of that
    # window.  It does not close it entirely; a genuinely concurrent FIRST run in a
    # fresh temp dir still races, and --output-dir avoids the shared path altogether.
    # CACHED per process, in two layers, because this is called once per MODULE and
    # the runtime text is ~186 KB. Rendering and re-reading it each time cost 3.6x on
    # the front end (60 ms -> 219 ms for a hello-world emit) — unacceptable in a
    # compiler whose front end is otherwise 57 ms and whose `-c` is 62 ms.
    #   * rt_text    — the rendered runtime, which depends only on the preamble and
    #                  the GUI backend, both fixed for the life of the process.
    #   * rt_written — the path already written this run. Every module of a program
    #                  emits into the same directory, so after the first module there
    #                  is nothing left to decide.
    def writeRuntimeModule(zig_path: str)
        var dir: str = .dirOf(zig_path)
        var rt_path: str = "zebra_rt.zig"
        if dir != ""
            rt_path = dir + "/zebra_rt.zig"
        if .rt_written == rt_path
            return
        if .rt_text == ""
            .rt_text = rtRuntimeText(File.read(.preamble_path))
        # Content compare, not existence: a stale file from an earlier run with a
        # different GUI backend must still be replaced.
        if File.exists(rt_path)
            if File.read(rt_path) == .rt_text
                .rt_written = rt_path
                return
        File.write(rt_path, .rt_text)
        .rt_written = rt_path

    def zbrToZig(zbr_path: str): str
        # Replace ".zbr" extension with ".zig"
        # If output_dir is set, write to output_dir/basename.zig
        var stem: str = zbr_path
        if zbr_path.endsWith(".zbr")
            for s in zbr_path.split(".zbr")
                stem = s
                break
        # Extract just the filename part (after the last path separator).
        # Handle both '/' and Windows '\' so a backslash source path
        # (e.g. C:\dir\file.zbr) doesn't leave the whole path as the
        # basename — which produced a garbage "out/C:\dir\file.zig".
        var base: str = stem
        if base.contains("/")
            var parts: List(str) = List(str)()
            for p in base.split("/")
                parts.add(p)
            base = parts.at(parts.len - 1)
        if base.contains("\\")
            var bparts: List(str) = List(str)()
            for bp in base.split("\\")
                bparts.add(bp)
            base = bparts.at(bparts.len - 1)
        if output_dir != ""
            return output_dir + "/" + base + ".zig"
        # No --output-dir: write the intermediate .zig to a temp dir rather
        # than next to the source. Run-mode smoke tests (`zebra file.zbr`)
        # otherwise drop a generated test/<name>.zig beside every fixture,
        # polluting the source tree (#230). All deps land in the same temp
        # dir, so basename @import("Dep.zig") references still resolve.
        var tdir: str = "."
        if sys.getenv("TEMP") as te
            tdir = te
        else if sys.getenv("TMPDIR") as tm
            tdir = tm
        else if sys.getenv("TMP") as tp
            tdir = tp
        else if File.exists("/tmp")
            # POSIX with none of the three set (a bare container, a cron job): "." here
            # meant every `zebra file.zbr` littered the CURRENT directory with the scratch
            # .zig and its binaries — the exact #230 pollution, one level up (2026-09-09).
            tdir = "/tmp"
        return tdir + "/" + base + ".zig"

    # BUG-262: place every collected native `.zig` dep beside the emitted output.
    #
    # Unconditional overwrite, matching writeRuntimeModule's reasoning: a dep left over
    # from an earlier run in the same directory is the stale-artifact hazard
    # `compileGuiProject` shipped once by writing only when the file was absent.
    #
    # The no-op guard is on the PATH, not on existence -- when the emit lands beside the
    # source, src and dst are the same file and copying it onto itself would truncate the
    # user's own dep.
    def writeNativeZigDeps(zig_path: str)
        var out_dir: str = .dirOf(zig_path)
        var i: int = 0
        while i < zig_sources.len
            var src_path: str = zig_sources.at(i)
            # moduleNameOf strips a directory prefix and a `.zbr` suffix; for a path that
            # already ends in `.zig` it returns the BASENAME unchanged, which is what is
            # wanted. Appending ".zig" would give ZigMath.zig.zig.
            var base: str = .moduleNameOf(src_path)
            var dst_path: str = base
            if out_dir != ""
                dst_path = out_dir + "/" + base
            if dst_path != src_path
                File.write(dst_path, File.read(src_path))
            i = i + 1

    def moduleNameOf(zbr_path_in: str): str
        # Return the Zig module basename for a .zbr path: strip any dir prefix
        # and the .zbr extension. E.g. "selfhost/Lexer.zbr" -> "Lexer".
        var zbr_path: str = zbr_path_in.replace("\\", "/")   # Windows paths (see dirOf)
        var base: str = zbr_path
        if zbr_path.contains("/")
            var parts: List(str) = List(str)()
            for p in zbr_path.split("/")
                parts.add(p)
            base = parts.at(parts.len - 1)
        if base.endsWith(".zbr")
            for s in base.split(".zbr")
                base = s
                break
        return base

    def dirOf(path_in: str): str
        # Find directory part by splitting on "/". A Windows path arrives with
        # backslashes (`src\ide.zbr` from PowerShell) and until 2026-09-16 the dir came
        # back "" -- every `use` then looked in the CWD, found nothing, and compilation
        # went on SILENTLY with the deps unresolved: no checker for them, no cross-module
        # types, and the scaffold picked up whatever stale .zig sat in the temp dir.
        # Seven zig errors against code that had not changed. Normalise first.
        var path: str = path_in.replace("\\", "/")
        if not path.contains("/")
            return ""
        var parts: List(str) = List(str)()
        for part in path.split("/")
            parts.add(part)
        if parts.len <= 1
            return ""
        # Rejoin all parts except the last
        var out: str = parts.at(0)
        var i: int = 1
        var last: int = parts.len - 1
        while i < last
            out = out + "/"
            out = out + parts.at(i)
            i = i + 1
        return out

    # ── Partial-file merging ──────────────────────────────────────────────────
    #
    # Returns a new PModule with partial class members merged in.
    # Functional (no in-place mutation) because Zebra branch bindings produce
    # const copies: `const rcls = rcls_ptr.*` — mutations through them fail.
    # Duplicate methods (same name already present in root class) are filtered
    # out before merging — matching src/main.zig:415-443.

    def hasDupMethod(method_name: str, root_members: List(PNode)): bool
        var i: int = 0
        while i < root_members.len
            if root_members.at(i) is PNode.method_ as rm
                var rm_name: str = rm.name
                if rm_name == method_name
                    return true
            i = i + 1
        return false

    def mergePartials_pmodule(pm: PModule, zbr_path: str): PModule throws
        var base: str = zbr_path
        if zbr_path.contains("/")
            var parts = List(str)()
            for p in zbr_path.split("/")
                parts.add(p)
            base = parts.at(parts.len - 1)
        if not base.endsWith(".zbr")
            return pm
        # Get stem via split (avoids str.len arithmetic, which returns uint)
        var stem: str = base
        for s in base.split(".zbr")
            stem = s
            break
        if stem.contains(".")
            return pm
        var list_dir: str = .dirOf(zbr_path)
        if list_dir == ""
            list_dir = "."
        var entries = Dir.list(list_dir)
        var partial_paths = List(str)()
        var prefix: str = stem + "."
        var ei = 0
        while ei < entries.len
            var ename: str = entries.at(ei)
            if ename.startsWith(prefix) and ename.endsWith(".zbr") and ename != base
                var full_path: str = ename
                if list_dir != "."
                    full_path = list_dir + "/" + ename
                partial_paths.add(full_path)
            ei = ei + 1
        if partial_paths.len == 0
            return pm
        partial_paths.sort()
        # Parse each partial into a PModule list
        var partial_pms = List(PModule)()
        var pi = 0
        while pi < partial_paths.len
            var ppath: str = partial_paths.at(pi)
            var psrc_raw: str = File.read(ppath)
            var psrc: str = psrc_raw
            const ppm_node = Parser.Parser.parse(psrc, ppath)?
            if ppm_node is PNode.module_ as ppm
                partial_pms.add(ppm)
            pi = pi + 1
        # Rebuild root decl list, merging partial class members into matching classes
        var merged_decls = List(PNode)()
        var ri = 0
        while ri < pm.decls.len
            var rdecl = pm.decls.at(ri)
            branch rdecl
                on PNode.class_ as rcls
                    # Collect any extra members from partials with the same class name.
                    # Extract name: str explicitly so == emits std.mem.eql (not raw ==).
                    var rcls_name: str = rcls.name
                    var extra_members = List(PNode)()
                    var pmi = 0
                    while pmi < partial_pms.len
                        var partial_pm = partial_pms.at(pmi)
                        var pdi = 0
                        while pdi < partial_pm.decls.len
                            var pdecl = partial_pm.decls.at(pdi)
                            if pdecl is PNode.class_ as pcls
                                var pcls_name: str = pcls.name
                                if pcls_name == rcls_name
                                    var memi = 0
                                    while memi < pcls.members.len
                                        var pmem = pcls.members.at(memi)
                                        var keep: bool = true
                                        if pmem is PNode.method_ as pmth
                                            var pmth_name: str = pmth.name
                                            keep = not .hasDupMethod(pmth_name, rcls.members)
                                        if keep
                                            extra_members.add(pmem)
                                        memi = memi + 1
                            pdi = pdi + 1
                        pmi = pmi + 1
                    if extra_members.len == 0
                        merged_decls.add(rdecl)
                    else
                        var new_members = List(PNode)()
                        var mi = 0
                        while mi < rcls.members.len
                            new_members.add(rcls.members.at(mi))
                            mi = mi + 1
                        mi = 0
                        while mi < extra_members.len
                            new_members.add(extra_members.at(mi))
                            mi = mi + 1
                        merged_decls.add(PNode.class_(PClass(rcls_name, rcls.type_params, rcls.ifaces, rcls.mixins, new_members, List(PNode)(), rcls.is_reflectable, false, false, false, nil, rcls.line, rcls.col)))
                else
                    merged_decls.add(rdecl)
            ri = ri + 1
        # Append any non-class top-level decls from partials (use_, etc.)
        var pmi = 0
        while pmi < partial_pms.len
            var partial_pm = partial_pms.at(pmi)
            var pdi = 0
            while pdi < partial_pm.decls.len
                var pdecl = partial_pm.decls.at(pdi)
                branch pdecl
                    on PNode.class_
                        pass
                    else
                        merged_decls.add(pdecl)
                pdi = pdi + 1
            pmi = pmi + 1
        return PModule(merged_decls)

# ── typecheck-merge helpers ───────────────────────────────────────────────────

# Extract one side of a conflict-marked file while preserving line numbers.
# Lines not included in the wanted side are replaced with a blank line so
# diagnostic line numbers stay aligned with the original conflict-marked file.
# Handles both standard (3-way) and diff3 (|||||||) conflict styles.
# BUG-322 (2026-09-01) was here: bootstrapExePath(), the resolver for the bootstrap
# delegations (repl / debug / build / --zig-backend) that crashed for every user outside
# this repo when they used a relative path. Every delegation has since been ported or
# retired (bootstrap_sunset.md Step 1, 2026-09-15), so the resolver went with them.


# BUG-321: one usage text, two destinations. `--help` is a REQUEST and its answer
# belongs on stdout with exit 0; the same text shown because the user got the
# invocation wrong is a DIAGNOSTIC and belongs on stderr with a non-zero exit.
# BUG-321/323: ONE usage text, reachable from both the `--help` request and the
# unrecognised-flag refusal, so the two can never drift apart.
def emitUsage(to_stdout: bool)
    usageLine("usage:", to_stdout)
    usageLine("  zebra <source.zbr>                       compile and run (selfhost pipeline)", to_stdout)
    usageLine("  zebra repl                               start interactive REPL", to_stdout)
    usageLine("  zebra build                              run build.zbr (Build stdlib)", to_stdout)
    usageLine("  zebra build --build-file=FILE            run alternate build script", to_stdout)
    usageLine("  zebra build --list-targets               output JSON target graph", to_stdout)
    usageLine("  zebra test <source.zbr>                  run def test_*() functions", to_stdout)
    usageLine("  zebra test --tag <tag> <source.zbr>      run only tests matching tag", to_stdout)
    usageLine("  zebra test --only a,B.test_b <source.zbr> run only the named tests (label or bare name)", to_stdout)
    usageLine("  zebra test --list <source.zbr>           print `label<TAB>line` per test that would run; no build", to_stdout)
    usageLine("  zebra debug <source.zbr>                 compile + DAP debug proxy (requires lldb-dap)", to_stdout)
    usageLine("  zebra debug --dump-map <file>          print the .zbr <-> .zig line map", to_stdout)
    usageLine("  zebra debug --dump-transform <file>    show what the DAP relay would forward (stdin)", to_stdout)
    usageLine("  zebra -c <source.zbr>                    FAST check: front end only (~60ms), does not run zig", to_stdout)
    usageLine("                                           -> can pass on code that `zebra run` fails to build", to_stdout)
    usageLine("  zebra --check-full <source.zbr>           full check: front end + zig semantic analysis (slower, total)", to_stdout)
    usageLine("  zebra --emit-zig <source.zbr>            print generated Zig to stdout", to_stdout)
    usageLine("  zebra --emit-zig --output-dir DIR        emit .zig files to DIR", to_stdout)
    usageLine("  zebra --shared <lib.zbr>                 build a shared library (.so/.dll/.dylib) next to the source;", to_stdout)
    usageLine("                                           `@export(\"sym\") class` factories are its symbols (QUICKSTART §44)", to_stdout)
    usageLine("  zebra --turbo <source.zbr>               strip require/ensure/invariant checks", to_stdout)
    usageLine("  zebra --warn-non-exhaustive <source.zbr> warn branch...else that silently catches union variants", to_stdout)
    usageLine("  zebra --gui-backend=BACKEND <source.zbr> compile GUI app: tui or libui_ng", to_stdout)
    usageLine("  zebra --keep-temp <source.zbr>           keep the scratch build (kept anyway on failure)", to_stdout)
    usageLine("  zebra --gui-backend=X --scaffold-only <f>  write the GUI project beside the emit; do not build or run it", to_stdout)
    usageLine("  zebra --version                          print version and exit", to_stdout)
    usageLine("  zebra typecheck-merge <file.zbr>         type-check both sides of a conflict", to_stdout)
    usageLine("  zebra check <file.zbr>                   dead code detection (arms, phantoms, unreachable fns)", to_stdout)
    usageLine("  zebra types <file.zbr>                   print inferred types at each var declaration", to_stdout)
    usageLine("  zebra fmt <file.zbr>                     normalize formatting in-place (tabs→spaces, trim whitespace)", to_stdout)
    usageLine("  zebra fmt --check <file.zbr>             exit 1 if file would be reformatted", to_stdout)
    usageLine("  zebra fmt --print <file.zbr>             print normalized output to stdout", to_stdout)
    usageLine("  zebra up                                 update the installed release (--check: report only; --to VER: a specific version)", to_stdout)
    usageLine("", to_stdout)
    usageLine("flag conventions: whole words take two dashes (--turbo); single letters", to_stdout)
    usageLine("                  take one (-c, -h). Flags are case-sensitive, and an", to_stdout)
    usageLine("                  unrecognized flag is an error rather than ignored.", to_stdout)

# ── REPL ──────────────────────────────────────────────────────────────────────
#
# PORTED FROM src/Repl.zig 2026-09-02, part of retiring the bootstrap. `zebra repl`
# delegated to zebra-bootstrap.exe (BUG-322 made that delegation resolve correctly from any
# directory; this removes the need for it entirely).
#
# IT LIVES IN main.zbr RATHER THAN A NEW selfhost/Repl.zbr ON PURPOSE. A new module must be
# added to the FILES list in bootstrap_check.sh and rebuild.sh and to the build's import
# set -- the regeneration machinery that was rewritten hours earlier for criterion 2.
# Adding to that set unsupervised, to gain an architectural nicety, is a poor trade.
#
# HOW A CELL IS EVALUATED, and it is simpler than the Zig original. That version compiled
# in-process, injected a sentinel `debug.print` into the emitted Zig at the line where the
# new cell began, ran it, and showed whatever appeared after the sentinel. Here the session
# is written as an ordinary .zbr and compiled by re-invoking OURSELVES -- so the entire
# compile-and-run path is reused rather than reimplemented -- and the new output is the
# SUFFIX beyond what the previous run produced. The session replays deterministically, so
# prior cells reprint identically and everything past the old length is what this cell did.
#
# That trade is deliberate: a process spawn per cell instead of an in-process compile, in
# exchange for no duplicated pipeline and no sentinel injection to keep in step with codegen.
#
# NOTE ON STREAMS: the Zig original captures STDERR, because Zebra's `print` used to write
# there. Since BUG-318 it writes to STDOUT, so a faithful port would have captured the wrong
# stream and shown nothing.

def replIsDeclCell(cell: str): bool
    var t: str = cell.trimLeft()
    var starters: List(str) = List(str)()
    starters.add("def ")
    starters.add("class ")
    starters.add("struct ")
    starters.add("interface ")
    starters.add("extend ")
    starters.add("union ")
    starters.add("enum ")
    starters.add("use ")
    for k in starters
        if t.startsWith(k)
            return true
    return false

# A decl header with no indented body yet can never be complete, whatever the parser says.
def replHeaderOnly(src: str): bool
    var t: str = src.trimLeft()
    var isDecl: bool = false
    var hdrs: List(str) = List(str)()
    hdrs.add("def ")
    hdrs.add("class ")
    hdrs.add("struct ")
    hdrs.add("interface ")
    hdrs.add("extend ")
    for k in hdrs
        if t.startsWith(k)
            isDecl = true
    if not isDecl
        return false
    return not src.contains("\n    ") and not src.contains("\n\t")

# Assemble the whole session plus the new cell. Decl cells go at top level; statement cells
# go inside `def main()` after every statement committed so far.
def replBuildSource(decls: List(str), stmts: List(str), cell: str, isDecl: bool): str
    var sb: str = ""
    for d in decls
        sb = sb + d + "\n"
    if isDecl
        if decls.len > 0
            sb = sb + "\n"
        sb = sb + cell + "\n"
        if stmts.len > 0
            sb = sb + "\ndef main()\n"
            for s in stmts
                sb = sb + "    " + s + "\n"
        return sb
    if decls.len > 0
        sb = sb + "\n"
    sb = sb + "def main()\n"
    for s in stmts
        sb = sb + "    " + s + "\n"
    sb = sb + "    " + cell + "\n"
    return sb

def replHelp()
    print("  :help  :h              show this message")
    print("  :clear                 reset the session (definitions and variables)")
    print("  :history               show all inputs in this session")
    print("  :save <file.zbr>       write the session to a .zbr file")
    print("  :quit  :q  Ctrl-D      exit")
    print("")
    print("Multi-line: indent continuation lines, then press Enter twice to submit.")

def replRun(): int
    print("Zebra REPL  (:help for commands, Ctrl-D to exit)")

    var decls: List(str) = List(str)()
    var stmts: List(str) = List(str)()
    var history: List(str) = List(str)()
    var accum: str = ""
    var prevOut: str = ""

    # Same temp-dir resolution main.zbr already uses for its emitted .zig scratch.
    var tmpdir: str = "."
    if sys.getenv("TEMP") as te
        tmpdir = te
    else if sys.getenv("TMPDIR") as tm
        tmpdir = tm
    else if sys.getenv("TMP") as tp
        tmpdir = tp
    else if File.exists("/tmp")
        tmpdir = "/tmp"
    var sessionPath: str = tmpdir + "/zbr_repl_session.zbr"
    var selfPath: str = sys.selfExe()

    while true
        if accum == ""
            sys.err(">>> ")
        else
            sys.err("... ")

        var lineOpt = sys.readLine()
        if lineOpt == nil
            print("")
            break
        var line: str = lineOpt!.trimRight()

        if accum != ""
            accum = accum + "\n" + line
        else
            accum = line

        var cell: str = accum.trim()

        # A blank line submits an accumulated multi-line cell, or clears an empty one.
        if cell == ""
            accum = ""
            continue
        if line == "" and accum.contains("\n")
            history.add(cell)
            prevOut = replEval(decls, stmts, cell, sessionPath, selfPath, prevOut)
            accum = ""
            continue

        # Commands are only recognised at the start of a fresh cell.
        if accum == line
            if cell == ":quit" or cell == ":q"
                break
            if cell == ":help" or cell == ":h"
                replHelp()
                accum = ""
                continue
            if cell == ":clear"
                decls = List(str)()
                stmts = List(str)()
                prevOut = ""
                print("session cleared")
                accum = ""
                continue
            if cell == ":history"
                var hi: int = 0
                while hi < history.len
                    print("[${hi + 1}] ${history[hi]}")
                    hi = hi + 1
                accum = ""
                continue
            if cell.startsWith(":save ")
                var fname: str = cell[6..cell.len].trim()
                var body: str = replBuildSource(decls, stmts, "", false)
                File.write(fname, body)
                print("saved " + fname)
                accum = ""
                continue

        if replHeaderOnly(accum)
            continue

        history.add(cell)
        prevOut = replEval(decls, stmts, cell, sessionPath, selfPath, prevOut)
        accum = ""

    return 0

# Compile-and-run the session with `cell` appended. Returns the output this run produced,
# so the next cell can show only what is new. On failure the session is left unchanged and
# the compiler's own diagnostics are shown -- they already name file, line and column.
def replEval(decls: List(str), stmts: List(str), cell: str, sessionPath: str, selfPath: str, prevOut: str): str
    var isDecl: bool = replIsDeclCell(cell)
    var src: str = replBuildSource(decls, stmts, cell, isDecl)
    File.write(sessionPath, src)

    var argv: List(str) = List(str)()
    argv.add(selfPath)
    # A DECL CELL IS CHECKED, NOT RUN, and that is not an optimisation -- it is required.
    # A session holding only declarations has no `def main()`, so running it fails with
    # "root source file has no member named 'main'". Worse, the failure then prevented the
    # decl from being committed, so the NEXT cell reported the name as undefined -- one bug
    # presenting as two. Found by driving a real session; both the front-end check and the
    # build were green.
    if isDecl
        argv.add("-c")
    argv.add(sessionPath)
    var r = sys.run(argv)

    if r.exit_code != 0
        # The compiler has already said what is wrong, with a position. Show it and leave
        # the session untouched so the user can retype the cell.
        if r.stderr != ""
            sys.err(replStripNoise(r.stderr))
        if r.stdout != "" and r.stdout.len > prevOut.len
            print(r.stdout[prevOut.len..r.stdout.len])
        return prevOut

    if isDecl
        # Checked only: nothing ran, so the replay baseline is untouched.
        decls.add(cell)
        return prevOut

    var out: str = r.stdout
    if out.len > prevOut.len
        var fresh: str = out[prevOut.len..out.len]
        if fresh.trim() != ""
            Terminal.write(fresh)
    stmts.add(cell)
    return out

# The session file is compiled whole every time, so a variable declared in one cell and not
# yet used looks unused to the backend. That is expected in a REPL, not a user error.
def replStripNoise(s: str): str
    var keep: str = ""
    for ln in s.split("\n")
        if ln.contains("unused local") or ln.contains("unused variable") or ln.contains("pointless discard")
            continue
        if ln.trim() == ""
            continue
        keep = keep + ln + "\n"
    return keep

def usageLine(s: str, to_stdout: bool)
    if to_stdout
        print(s)
    else
        sys.errln(s)

def extractConflictSide(src: str, want_ours: bool): str
    var sb: StringBuilder = StringBuilder()
    var state: int = 0   # 0=normal  1=in_ours  2=in_base(diff3)  3=in_theirs
    for line in src.split("\n")
        if line.startsWith("<<<<<<<")
            state = 1
            sb.append("\n")
        else if line.startsWith("|||||||")
            state = 2
            sb.append("\n")
        else if line.startsWith("=======")
            state = 3
            sb.append("\n")
        else if line.startsWith(">>>>>>>")
            state = 0
            sb.append("\n")
        else if state == 0
            sb.append(line + "\n")
        else if state == 1 and want_ours
            sb.append(line + "\n")
        else if state == 3 and not want_ours
            sb.append(line + "\n")
        else
            sb.append("\n")
    return sb.build()

# Run the selfhost TC pipeline on src (a string), collecting diagnostics into diags.
# Catches parse/resolve/build errors and reports them as diagnostic strings so the
# caller gets a clean list regardless. Does not compile to Zig.
# The preamble lives in the repo (selfhost/) or, for an installed zebra.exe, next
# to the binary. One resolver, used by the compile route and by the side-check
# route (`tcCheckSide`) so BUG-359's reserved-name check sees the same runtime.
def defaultPreamblePath(): str
    var pp: str = "selfhost/stdlib_preamble.zig"
    if not File.exists(pp)
        var pre_exe_dir: str = Path.dirname(sys.selfExe())
        if pre_exe_dir == ""
            pre_exe_dir = "."
        pp = pre_exe_dir + "/stdlib_preamble.zig"
    return pp

def tcCheckSide(src: str, path: str, diags: List(str))
    var pm_node = Parser.Parser.parse(src, path)?
    var resolver = Resolver.Resolver(path, src)
    resolver.resolve(pm_node)?
    if resolver.errorCount() > 0
        for line in resolver.allErrorMessages().split("\n")
            if line.trimLeft() != ""
                diags.add(line)
        return
    if pm_node is PNode.module_ as pm
        var module = ASTBuilder.build(pm, path)?
        var tc_mt: ModuleTypes = buildModuleTypes(module)
        var tc_ctx: InferCtx = InferCtx(tc_mt, "")
        tc_ctx.withSource(src)
        tc_ctx.enableStrict()
        tc_ctx.withReservedRuntimeNames(rtReservedNames(defaultPreamblePath()))   # BUG-359
        checkModule(module, path, tc_ctx)
        if tc_ctx.hasErrors()
            for line in tc_ctx.errorMessages().split("\n")
                if line.trimLeft() != ""
                    diags.add(line)
catch |e|
    diags.add("error: " + e.message)

# ── LSP diagnostics (JSON seam) ───────────────────────────────────────────────
# `zebra diagnostics <file>` runs the front-end (parse → resolve → typecheck) and
# emits a JSON array of {line, col, severity, message} to stdout.  This is the
# structured seam an editor / LSP server consumes for live squiggles.  Positions
# are compiler-native (1-based line, 0-based col); the LSP layer converts to the
# 0-based LSP coordinate space.

struct LspDiag
    var line: int
    var col: int
    var severity: str
    var message: str

    cue init(line: int, col: int, severity: str, message: str)
        .line = line
        .col = col
        .severity = severity
        .message = message

def diagAllDigits(s: str): bool
    if s.len == 0
        return false
    for c in s.chars()
        if c < '0' or c > '9'
            return false
    return true

# JSON-escape a string for a "..." literal (backslash first so we don't
# double-escape the escapes we add).
def diagJsonEscape(s: str): str
    var r = s.replace("\\", "\\\\")
    r = r.replace("\"", "\\\"")
    r = r.replace("\n", "\\n")
    r = r.replace("\t", "\\t")
    r = r.replace("\r", "")
    return r

# Parse one compiler diagnostic line "path:line:col: severity: message" into a
# structured record, or nil for non-header lines (source/caret decoration).  The
# path may contain ':' (Windows drive letter), so line/col are the LAST two
# ':'-separated numeric fields of the prefix — never the drive or path segments.
def parseDiagLine(s: str): LspDiag?
    var sev: str = "error"
    var sep: str = ": error: "
    if not s.contains(sep)
        sev = "warning"
        sep = ": warning: "
        if not s.contains(sep)
            sev = "note"
            sep = ": note: "
            if not s.contains(sep)
                return nil
    var parts: List(str) = List(str)()
    for p in s.split(sep)
        parts.add(p)
    if parts.len < 2
        return nil
    var prefix: str = parts.at(0)
    var message: str = ""
    var mi: int = 1
    while mi < parts.len
        if mi > 1
            message = message + sep
        message = message + parts.at(mi)
        mi = mi + 1
    var pparts: List(str) = List(str)()
    for pp in prefix.split(":")
        pparts.add(pp)
    if pparts.len < 2
        return nil
    var last: str = pparts.at(pparts.len - 1)
    var second: str = pparts.at(pparts.len - 2)
    if not diagAllDigits(last)
        return nil
    var line: int = 0
    var col: int = 0
    if diagAllDigits(second)
        line = second.toInt()
        col = last.toInt()
    else
        line = last.toInt()
    return LspDiag(line, col, sev, message)

# Run the front-end on a source buffer and return structured diagnostics.
def collectLspDiags(src: str, path: str): List(LspDiag)
    var raw: List(str) = List(str)()
    tcCheckSide(src, path, raw)
    var diags: List(LspDiag) = List(LspDiag)()
    for entry in raw
        for ln in entry.split("\n")
            var d = parseDiagLine(ln)
            if d as dd
                diags.add(dd)
    return diags

def buildDiagnosticsJson(path: str): str throws
    if not File.exists(path)
        return "[]"
    var src: str = File.read(path)
    var diags: List(LspDiag) = collectLspDiags(src, path)
    var out: StringBuilder = StringBuilder()
    out.append("[")
    var first: bool = true
    for dd in diags
        if not first
            out.append(",")
        first = false
        out.append("{\"line\":")
        out.append(dd.line.toString())
        out.append(",\"col\":")
        out.append(dd.col.toString())
        out.append(",\"severity\":\"")
        out.append(dd.severity)
        out.append("\",\"message\":\"")
        out.append(diagJsonEscape(dd.message))
        out.append("\"}")
    out.append("]")
    return out.build()

# `--out <file>` writes the JSON to a file (the unambiguous interface for an LSP
# server / CI, since `print` lands on stderr on the Windows fast-backend build).
# Without `--out` the JSON goes to `print` (stderr) for manual viewing.
def runDiagnostics(path: str, out_path: str) throws
    var json: str = buildDiagnosticsJson(path)?
    if out_path != ""
        File.write(out_path, json)
    else
        print(json)

# ── LSP server (`zebra lsp`) ──────────────────────────────────────────────────
# A minimal Language Server over stdio (JSON-RPC, Content-Length framed).  Reuses
# the front-end in-process for live diagnostics.  Requests are read from stdin
# (sys.readLine for headers, sys.readBytes for the exact body); responses go to
# stdout via Terminal.write (real stdout — pipe-capable, unlike `print`).

# Read one framed message body from stdin, or nil at EOF.
def lspReadMessage(): str?
    var content_len: int = 0
    while true
        var hdr = sys.readLine()
        if hdr == nil
            return nil
        # Defensive trim: LSP headers end in \r\n. (The Linux hang seen 2026-09-06 was
        # NOT this — it was per-call stdin read-ahead in the runtime, BUG-334 — but a
        # trimmed header costs nothing and tolerates a client that sends bare \n.)
        var h: str = hdr!.trim()
        if h == ""
            break
        if h.startsWith("Content-Length:")
            var hp: List(str) = List(str)()
            for p in h.split(":")
                hp.add(p)
            if hp.len >= 2
                content_len = hp.at(1).trim().toInt()
    if content_len <= 0
        return ""
    var body = sys.readBytes(content_len)
    if body == nil
        return nil
    return body!

def lspWriteMessage(body: str)
    Terminal.write("Content-Length: " + body.len.toString() + "\r\n\r\n")
    Terminal.write(body)

def lspRespond(id: int, result_json: str)
    lspWriteMessage("{\"jsonrpc\":\"2.0\",\"id\":" + id.toString() + ",\"result\":" + result_json + "}")

def lspRespondError(id: int, code: int, message: str)
    lspWriteMessage("{\"jsonrpc\":\"2.0\",\"id\":" + id.toString() + ",\"error\":{\"code\":" + code.toString() + ",\"message\":\"" + diagJsonEscape(message) + "\"}}")

def lspClearDiagnostics(uri: str)
    lspWriteMessage("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"" + diagJsonEscape(uri) + "\",\"diagnostics\":[]}}")

# Run the front-end on `src` and push a publishDiagnostics notification for `uri`.
# Compiler positions are 1-based line / 0-based col; LSP wants 0-based both.
def lspPublishDiagnostics(uri: str, src: str)
    var diags: List(LspDiag) = collectLspDiags(src, uri)
    var sb: StringBuilder = StringBuilder()
    sb.append("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"")
    sb.append(diagJsonEscape(uri))
    sb.append("\",\"diagnostics\":[")
    var first: bool = true
    for d in diags
        if not first
            sb.append(",")
        first = false
        var lsp_line: int = d.line - 1
        if lsp_line < 0
            lsp_line = 0
        var sev_num: int = 1
        if d.severity == "warning"
            sev_num = 2
        else if d.severity == "note"
            sev_num = 3
        sb.append("{\"range\":{\"start\":{\"line\":")
        sb.append(lsp_line.toString())
        sb.append(",\"character\":")
        sb.append(d.col.toString())
        sb.append("},\"end\":{\"line\":")
        sb.append(lsp_line.toString())
        sb.append(",\"character\":")
        sb.append((d.col + 1).toString())
        sb.append("}},\"severity\":")
        sb.append(sev_num.toString())
        sb.append(",\"message\":\"")
        sb.append(diagJsonEscape(d.message))
        sb.append("\"}")
    sb.append("]}}")
    lspWriteMessage(sb.build())

# LSP range JSON from a compiler Span (compiler is 1-based line / 0-based col;
# LSP wants 0-based both).
def lspSpanRange(sp: Span): str
    var sl: int = sp.line - 1
    if sl < 0
        sl = 0
    var el: int = sp.end_line - 1
    if el < sl
        el = sl
    return "{\"start\":{\"line\":" + sl.toString() + ",\"character\":" + sp.col.toString() + "},\"end\":{\"line\":" + el.toString() + ",\"character\":" + sp.end_col.toString() + "}}"

# One LSP DocumentSymbol object.  `kind` is an LSP SymbolKind number.
def lspDocSymbol(name: str, kind: int, sp: Span, children: str): str
    var r: str = lspSpanRange(sp)
    return "{\"name\":\"" + diagJsonEscape(name) + "\",\"kind\":" + kind.toString() + ",\"range\":" + r + ",\"selectionRange\":" + r + ",\"children\":[" + children + "]}"

# Child symbols for a class/struct/interface: methods (6), fields (8), init (9).
def lspMemberSymbols(members: List(Decl)): str
    var sb: StringBuilder = StringBuilder()
    var first: bool = true
    for m in members
        var msym: str = ""
        branch m
            on Decl.method as dm
                msym = lspDocSymbol(dm.name, 6, dm.span, "")
            on Decl.var_ as dv
                msym = lspDocSymbol(dv.name, 8, dv.span, "")
            on Decl.init as di
                msym = lspDocSymbol("init", 9, di.span, "")
            else
                pass
        if msym != ""
            if not first
                sb.append(",")
            first = false
            sb.append(msym)
    return sb.build()

# Parse `text` and return an LSP DocumentSymbol[] JSON array (top-level decls,
# with class/struct/interface members nested).  Returns [] if the buffer doesn't
# parse (mid-edit).
def lspCollectDocSymbols(text: str, path: str): str
    var pm_node = Parser.Parser.parse(text, path)?
    if pm_node is PNode.module_ as pm
        var module = ASTBuilder.build(pm, path)?
        var sb: StringBuilder = StringBuilder()
        var first: bool = true
        for decl in module.decls
            var sym: str = ""
            branch decl
                on Decl.class_ as c
                    sym = lspDocSymbol(c.name, 5, c.span, lspMemberSymbols(c.members))
                on Decl.struct_ as s
                    sym = lspDocSymbol(s.name, 23, s.span, lspMemberSymbols(s.members))
                on Decl.interface_ as ifc
                    sym = lspDocSymbol(ifc.name, 11, ifc.span, lspMemberSymbols(ifc.members))
                on Decl.enum_ as e
                    sym = lspDocSymbol(e.name, 10, e.span, "")
                on Decl.union_ as u
                    sym = lspDocSymbol(u.name, 10, u.span, "")
                on Decl.method as dm
                    sym = lspDocSymbol(dm.name, 12, dm.span, "")
                on Decl.sig_ as sg
                    sym = lspDocSymbol(sg.name, 12, sg.span, "")
                on Decl.namespace_ as ns
                    sym = lspDocSymbol(ns.name, 3, ns.span, "")
                else
                    pass
            if sym != ""
                if not first
                    sb.append(",")
                first = false
                sb.append(sym)
        return "[" + sb.build() + "]"
    return "[]"
catch |e|
    return "[]"

# `zebra test --list FILE`: front end only (lex, parse, AST), then CodeGen's own
# inclusion rule decides what is printed -- the same function the harness uses, so
# the list and the run cannot disagree. A parse failure is reported the way `-c`
# would report it and exits 1; the IDE treats that as "the file does not compile",
# not as "no tests".
def runTestList(path: str, tag_filter: str?)
    var text: str = File.read(path)
    var pm_node = Parser.Parser.parse(text, path)?
    if pm_node is PNode.module_ as pm
        var module = ASTBuilder.build(pm, path)?
        for entry in listTestEntries(module, lspStemOf(path), tag_filter)
            print(entry)
    return
catch |e|
    sys.errln("zebra test --list: " + path + ": " + e.message)
    sys.exit(1)

# A TextEdit[] that replaces the whole document with its formatted form.
def lspFormatEdits(text: str): str
    var formatted: str = fmtNormalize(text)
    var nlines: int = 1
    for c in text.chars()
        if c == '\n'
            nlines = nlines + 1
    return "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":" + nlines.toString() + ",\"character\":0}},\"newText\":\"" + diagJsonEscape(formatted) + "\"}]"


# ── References / rename (name-based, whole-word, comments+strings skipped) ────
# The LSP here is a declaration index, not a resolver, so "references" means: every
# whole-identifier occurrence of the name in every open document, outside `#`
# comments and string literals. Good enough for a simple IDE's find-references and
# rename; a scope-aware version is a Resolver job, docketed for zebra-ide P3.

# All whole-word occurrences of `name` in `text` as LSP ranges (0-based lines and cols).
def lspOccurrences(text: str, name: str): List(Span)
    var out: List(Span) = List(Span)()
    if name == ""
        return out
    var line_no: int = 0
    for l in text.split("\n")
        var n: int = l.len
        var i: int = 0
        var in_str: bool = false
        while i < n
            var c: char = lspCharAt(l, i)
            if in_str
                if c == '\\' and i + 1 < n
                    i = i + 2
                    continue
                if c == '"'
                    in_str = false
                i = i + 1
                continue
            if c == '#'
                break
            if c == '"'
                in_str = true
                i = i + 1
                continue
            if lspIsIdentChar(c)
                var j: int = i
                while j < n and lspIsIdentChar(lspCharAt(l, j))
                    j = j + 1
                if l[i..j] == name
                    # Span is 1-based line / 0-based col (lspSpanRange subtracts one).
                    out.add(Span(line_no + 1, i, line_no + 1, j))
                i = j
                continue
            i = i + 1
        line_no = line_no + 1
    return out

# JSON array of Location objects for `name` across every open document.
def lspReferencesJson(docs: HashMap(str, str), name: str): str
    var sb: StringBuilder = StringBuilder()
    sb.append("[")
    var first: bool = true
    for u in docs.keys()
        if docs.get(u) as dt
            for sp in lspOccurrences(dt, name)
                if not first
                    sb.append(",")
                first = false
                sb.append("{\"uri\":\"" + diagJsonEscape(u) + "\",\"range\":" + lspSpanRange(sp) + "}")
    sb.append("]")
    return sb.build()

# WorkspaceEdit JSON renaming every occurrence of `name` to `new_name` in every open
# document. Refused (returns "null") when new_name is not a plain identifier, so a
# rename can never introduce a token the lexer would split.
def lspRenameJson(docs: HashMap(str, str), name: str, new_name: str): str
    if name == "" or new_name == ""
        return "null"
    var k: int = 0
    while k < new_name.len
        if not lspIsIdentChar(lspCharAt(new_name, k))
            return "null"
        k = k + 1
    var sb: StringBuilder = StringBuilder()
    sb.append("{\"changes\":{")
    var first_doc: bool = true
    for u in docs.keys()
        if docs.get(u) as dt
            var occ: List(Span) = lspOccurrences(dt, name)
            if occ.len == 0
                continue
            if not first_doc
                sb.append(",")
            first_doc = false
            sb.append("\"" + diagJsonEscape(u) + "\":[")
            var first: bool = true
            for sp in occ
                if not first
                    sb.append(",")
                first = false
                sb.append("{\"range\":" + lspSpanRange(sp) + ",\"newText\":\"" + diagJsonEscape(new_name) + "\"}")
            sb.append("]")
    sb.append("}}")
    return sb.build()

# ── Workspace: the `use` graph around one document ────────────────────────────
# References / rename / definition used to see OPEN documents only, so a rename at a
# call site left the `use`d module's definition untouched and Definition into an
# unopened module answered null (zebra-ide's rename_workspace_test, 2026-09-08).
# lspWorkspaceDocs widens `docs` with, from disk: every module the document `use`s
# (dotted names → nested paths, resolved beside the document) and every .zbr in
# the document's directory that `use`s IT (dependents; one directory, not
# recursive). Open documents keep their in-memory text; disk copies fill the gaps.

def lspUriToPath(u: str): str
    var p: str = u
    if p.startsWith("file:///") and p.len > 9 and p[9..10] == ":"
        p = p[8..p.len]                                   # file:///C:/x → C:/x
    else if p.startsWith("file://")
        p = p[7..p.len]
    return p.replace("%20", " ")

def lspPathToUri(p: str): str
    var n: str = p.replace("\\", "/")
    if n.len > 1 and n[1..2] == ":"
        return "file:///" + n
    return "file://" + n

# BUG-430: a client may spell a drive path `file://C:/x` (two slashes -- zebra-ide's
# rename_workspace_test does; the spec form is `file:///C:/x`). LSP says URIs are opaque
# and compared as strings, so the disk-resolved modules this server ADDS to a workspace
# must be spelled the way the requesting document was, or the client's own edit list
# never matches them: on torial the rename named `file:///C:/.../geo.zbr` beside the
# client's `file://C:/.../main.zbr` and the edit for geo.zbr was dropped as unknown.
def lspSpellLike(template: str, u: str): str
    if template.startsWith("file://") and not template.startsWith("file:///") and u.startsWith("file:///")
        return "file://" + u[8..u.len]
    return u

def lspDirOfPath(p: str): str
    var n: str = p.replace("\\", "/")
    var i: int = n.lastIndexOf("/")
    if i < 0
        return "."
    if i == 0
        return "/"
    return n[0..i]

def lspStemOf(p: str): str
    var n: str = p.replace("\\", "/")
    var i: int = n.lastIndexOf("/")
    var b: str = n
    if i >= 0
        b = n[i+1..n.len]
    if b.endsWith(".zbr")
        b = b[0..b.len-4]
    return b

# The module names a document `use`s: the first token after `use`, before any
# `exposing` / `as`. Dotted names are returned as written (a.b → resolved to a/b.zbr).
def lspUseNames(text: str): List(str)
    var out: List(str) = List(str)()
    for l in text.split("\n")
        var t: str = l.trim()
        if not t.startsWith("use ")
            continue
        var rest: str = t[4..t.len].trim()
        var name: str = rest
        var sp: int = rest.indexOf(" ")
        if sp >= 0
            name = rest[0..sp]
        if name != "" and not out.contains(name)
            out.add(name)
    return out

# Does `text` `use` the module called `stem`? (word-exact: `use geo` and `use geo exposing`, not `use geometry`)
def lspUsesModule(text: str, stem: str): bool
    for n in lspUseNames(text)
        if n == stem
            return true
        if n.endsWith("." + stem)
            return true
    return false

def lspWorkspaceDocs(docs: HashMap(str, str), uri: str): HashMap(str, str)
    var ws: HashMap(str, str) = HashMap(str, str)()
    for u in docs.keys()
        if docs.get(u) as t
            ws.set(u, t)
    var text: str = ""
    if docs.get(uri) as dt
        text = dt
    else
        return ws
    var path: str = lspUriToPath(uri)
    var dir: str = lspDirOfPath(path)
    # forward: the modules this document uses
    for n in lspUseNames(text)
        var rel: str = n.replace(".", "/") + ".zbr"
        var mp: str = dir + "/" + rel
        if File.exists(mp)
            var mu: str = lspSpellLike(uri, lspPathToUri(mp))
            if ws.get(mu) == nil
                ws.set(mu, File.read(mp))
    # dependents: siblings that use this document's module
    var stem: str = lspStemOf(path)
    if File.exists(dir) and File.isDir(dir)
        for entry in File.listDir(dir)
            if not entry.endsWith(".zbr")
                continue
            var sp: str = dir + "/" + entry
            var su: str = lspSpellLike(uri, lspPathToUri(sp))
            if ws.get(su) != nil
                continue
            if File.isDir(sp)
                continue
            var st: str = File.read(sp)
            if lspUsesModule(st, stem)
                ws.set(su, st)
    return ws

# ── Position → symbol (hover / go-to-definition) ──────────────────────────────
# Name-based: extract the identifier under the cursor, look it up in a per-buffer
# declaration index.  Not scope-aware (top-level + members), but covers the common
# "jump to this function/type/method" case.

def lspIsIdentChar(c: char): bool
    if c >= 'a' and c <= 'z'
        return true
    if c >= 'A' and c <= 'Z'
        return true
    if c >= '0' and c <= '9'
        return true
    if c == '_'
        return true
    return false

# The identifier under LSP position (line, col) — both 0-based; col is a UTF-16
# offset, treated as a char/byte index (valid for ASCII identifiers).
def lspWordAt(text: str, line: int, col: int): str
    var lines: List(str) = List(str)()
    for l in text.split("\n")
        lines.add(l)
    if line < 0 or line >= lines.len
        return ""
    var s: str = lines.at(line)
    var n: int = s.len
    if n == 0
        return ""
    var pos: int = col
    if pos >= n
        pos = n - 1
    if pos < 0
        return ""
    if not lspIsIdentChar(lspCharAt(s, pos))
        if pos > 0 and lspIsIdentChar(lspCharAt(s, pos - 1))
            pos = pos - 1
        else
            return ""
    var start: int = pos
    while start > 0 and lspIsIdentChar(lspCharAt(s, start - 1))
        start = start - 1
    var wend: int = pos
    while wend < n - 1 and lspIsIdentChar(lspCharAt(s, wend + 1))
        wend = wend + 1
    return s[start..wend + 1]

struct LspDeclInfo
    var name: str
    var detail: str   # a one-line signature/kind for hover
    var span: Span

    cue init(name: str, detail: str, span: Span)
        .name = name
        .detail = detail
        .span = span

def lspMethodSig(m: DeclMethod): str
    var sb: StringBuilder = StringBuilder()
    sb.append("def ")
    sb.append(m.name)
    sb.append("(")
    var first: bool = true
    for p in m.params
        if not first
            sb.append(", ")
        first = false
        sb.append(p.name)
        if p.type_ != nil
            sb.append(": ")
            sb.append(typeRefStr(p.type_!))
    sb.append(")")
    if m.return_type != nil
        sb.append(": ")
        sb.append(typeRefStr(m.return_type!))
    return sb.build()

def lspVarSig(v: DeclVar): str
    if v.type_ != nil
        return "var " + v.name + ": " + typeRefStr(v.type_!)
    return "var " + v.name

def lspMemberInfos(members: List(Decl)): List(LspDeclInfo)
    var out: List(LspDeclInfo) = List(LspDeclInfo)()
    for m in members
        branch m
            on Decl.method as dm
                out.add(LspDeclInfo(dm.name, lspMethodSig(dm), dm.span))
            on Decl.var_ as dv
                out.add(LspDeclInfo(dv.name, lspVarSig(dv), dv.span))
            else
                pass
    return out

# Parse the buffer and index every named declaration (top-level + class/struct/
# interface members) by name → (detail, span).  Empty on a mid-edit parse failure.
def lspBuildDeclIndex(text: str, path: str): List(LspDeclInfo)
    var out: List(LspDeclInfo) = List(LspDeclInfo)()
    var pm_node = Parser.Parser.parse(text, path)?
    if pm_node is PNode.module_ as pm
        var module = ASTBuilder.build(pm, path)?
        for decl in module.decls
            branch decl
                on Decl.class_ as c
                    out.add(LspDeclInfo(c.name, "class " + c.name, c.span))
                    for mi in lspMemberInfos(c.members)
                        out.add(mi)
                on Decl.struct_ as s
                    out.add(LspDeclInfo(s.name, "struct " + s.name, s.span))
                    for mi in lspMemberInfos(s.members)
                        out.add(mi)
                on Decl.interface_ as ifc
                    out.add(LspDeclInfo(ifc.name, "interface " + ifc.name, ifc.span))
                    for mi in lspMemberInfos(ifc.members)
                        out.add(mi)
                on Decl.enum_ as e
                    out.add(LspDeclInfo(e.name, "enum " + e.name, e.span))
                on Decl.union_ as u
                    out.add(LspDeclInfo(u.name, "union " + u.name, u.span))
                on Decl.method as dm
                    out.add(LspDeclInfo(dm.name, lspMethodSig(dm), dm.span))
                on Decl.sig_ as sg
                    out.add(LspDeclInfo(sg.name, "sig " + sg.name, sg.span))
                on Decl.var_ as dv
                    out.add(LspDeclInfo(dv.name, lspVarSig(dv), dv.span))
                else
                    pass
    return out
catch |e|
    return List(LspDeclInfo)()

# Look up the declaration for `name` (first match).
def lspFindDecl(text: str, path: str, name: str): LspDeclInfo?
    if name == ""
        return nil
    for d in lspBuildDeclIndex(text, path)
        if d.name == name
            return d
    return nil

def lspCharAt(s: str, i: int): char
    var idx: int = 0
    for c in s.chars()
        if idx == i
            return c
        idx = idx + 1
    return ' '

# Locate a declaration's source line by text search (the selfhost AST carries no
# real spans — zspan()).  Matches the TRIMMED line starting with "<keyword> <name>"
# + a name boundary, so uses (`print(helper())`) and comments (`# def helper`) are
# not matched.  Returns a compiler-native Span (1-based line) or (0,0,0,0).
def lspDeclPosition(text: str, detail: str, name: str): Span
    var kw: str = "def"
    for w in detail.split(" ")
        kw = w
        break
    var needle: str = kw + " " + name
    var lineno: int = 0
    for l in text.split("\n")
        var t: str = l.trimLeft()
        if t.startsWith(needle)
            if not lspIsIdentChar(lspCharAt(t, needle.len))
                # Point at the NAME (indent + keyword + one space), highlight it.
                var col: int = (l.len - t.len) + kw.len + 1
                return Span(lineno + 1, col, lineno + 1, col + name.len)
        lineno = lineno + 1
    return Span(0, 0, 0, 0)

# LSP CompletionItemKind from a decl detail's leading keyword.
def lspCompletionKind(detail: str): int
    var kw: str = "def"
    for w in detail.split(" ")
        kw = w
        break
    if kw == "class"
        return 7
    if kw == "struct"
        return 22
    if kw == "interface"
        return 8
    if kw == "enum" or kw == "union"
        return 13
    if kw == "var"
        return 5
    return 3

# The source line at 0-based `line` (empty if out of range).
def lspLineAt(text: str, line: int): str
    var idx: int = 0
    for l in text.split("\n")
        if idx == line
            return l
        idx = idx + 1
    return ""

# Read an identifier token starting at `start` (stops at the first non-ident char).
def lspReadTypeTokenAt(s: str, start: int): str
    var e: int = start
    var n: int = s.len
    while e < n and lspIsIdentChar(lspCharAt(s, e))
        e = e + 1
    if e == start
        return ""
    return s[start..e]

# If the cursor at `col` on line text `s` is completing a member access
# (`receiver.<partial>` or a leading-dot `.<partial>`), return the receiver:
# an identifier, or "." for a leading-dot self access.  "" = not a member context.
def lspMemberReceiver(s: str, col: int): str
    var i: int = col - 1
    # Skip the partial member identifier already typed before the cursor.
    while i >= 0 and lspIsIdentChar(lspCharAt(s, i))
        i = i - 1
    if i < 0 or lspCharAt(s, i) != '.'
        return ""
    # A `..` (range/slice) is not a member access.
    if i > 0 and lspCharAt(s, i - 1) == '.'
        return ""
    var j: int = i - 1
    if j >= 0 and lspIsIdentChar(lspCharAt(s, j))
        var rs: int = j
        while rs > 0 and lspIsIdentChar(lspCharAt(s, rs - 1))
            rs = rs - 1
        var recv: str = s[rs..j + 1]
        # A digit-led receiver is a float literal (`1.5`), not a member access.
        var c0: char = lspCharAt(recv, 0)
        if c0 >= '0' and c0 <= '9'
            return ""
        return recv
    # Leading-dot self access: `.field`.
    return "."

# The nearest class/struct/interface/mixin whose body encloses `line`, by
# indentation (walks outward past intervening defs).  "" if not inside a type.
def lspEnclosingType(text: str, line: int): str
    var lines: List(str) = List(str)()
    for l in text.split("\n")
        lines.add(l)
    var ln: int = line
    if ln >= lines.len
        ln = lines.len - 1
    if ln < 0
        return ""
    var target: int = lines.at(ln).len - lines.at(ln).trimLeft().len
    var i: int = ln - 1
    while i >= 0
        var raw: str = lines.at(i)
        var t: str = raw.trimLeft()
        if t.len == 0 or t.startsWith("#")
            i = i - 1
            continue
        var ind: int = raw.len - t.len
        if ind < target
            if t.startsWith("class ") or t.startsWith("struct ") or t.startsWith("interface ") or t.startsWith("mixin ")
                var sp: str = t.substring(t.indexOf(" ") + 1, t.len)
                return lspReadTypeTokenAt(sp.trimLeft(), 0)
            target = ind
        i = i - 1
    return ""

# An explicit type annotation for `name` on line `l` (`name: Type`, with a name
# boundary), e.g. `var name: Type`, a param `(name: Type)`.  "" if none.
def lspAnnotatedTypeInLine(l: str, name: str): str
    var s: str = l
    var n: int = s.len
    var nl: int = name.len
    var i: int = 0
    while i + nl <= n
        if s[i..i + nl] == name
            var before_ok: bool = i == 0 or not lspIsIdentChar(lspCharAt(s, i - 1))
            var k: int = i + nl
            while k < n and lspCharAt(s, k) == ' '
                k = k + 1
            if before_ok and k < n and lspCharAt(s, k) == ':'
                k = k + 1
                while k < n and lspCharAt(s, k) == ' '
                    k = k + 1
                return lspReadTypeTokenAt(s, k)
        i = i + 1
    return ""

# A constructor-init type for `name` on line `l` (`[var|const ]name = Type(`). "".
def lspCtorTypeInLine(l: str, name: str): str
    var t: str = l.trimLeft()
    var nd: str = ""
    if t.startsWith("var " + name + " = ")
        nd = "var " + name + " = "
    else if t.startsWith("const " + name + " = ")
        nd = "const " + name + " = "
    else if t.startsWith(name + " = ")
        nd = name + " = "
    else
        return ""
    var rest: str = t.substring(nd.len, t.len)
    var tok: str = lspReadTypeTokenAt(rest, 0)
    if tok != "" and rest.len > tok.len and lspCharAt(rest, tok.len) == '('
        return tok
    return ""

# The declared type of local/param/field `name`, searching upward from `from_line`
# so the nearest declaration above the cursor wins.  "" if not found.
def lspTypeOfName(text: str, name: str, from_line: int): str
    var lines: List(str) = List(str)()
    for l in text.split("\n")
        lines.add(l)
    var i: int = from_line
    if i >= lines.len
        i = lines.len - 1
    while i >= 0
        var a: str = lspAnnotatedTypeInLine(lines.at(i), name)
        if a != ""
            return a
        var c: str = lspCtorTypeInLine(lines.at(i), name)
        if c != ""
            return c
        i = i - 1
    return ""

# Resolve a member-access receiver to a type name.
def lspResolveReceiverType(text: str, path: str, recv: str, line: int): str
    if recv == "." or recv == "self" or recv == "this"
        return lspEnclosingType(text, line)
    # The receiver may itself be a type (enum/static access: `Color.`, `Type.`).
    if lspFindDecl(text, path, recv) as di
        if di.detail.startsWith("class ") or di.detail.startsWith("struct ") or di.detail.startsWith("interface ") or di.detail.startsWith("enum ") or di.detail.startsWith("union ")
            return recv
    return lspTypeOfName(text, recv, line)

# The members of the named type (methods + fields, or enum variants).
def lspTypeMembers(text: str, path: str, typename: str): List(LspDeclInfo)
    var out: List(LspDeclInfo) = List(LspDeclInfo)()
    var pm_node = Parser.Parser.parse(text, path)?
    if pm_node is PNode.module_ as pm
        var module = ASTBuilder.build(pm, path)?
        for decl in module.decls
            branch decl
                on Decl.class_ as c
                    if c.name == typename
                        for mi in lspMemberInfos(c.members)
                            out.add(mi)
                on Decl.struct_ as s
                    if s.name == typename
                        for mi in lspMemberInfos(s.members)
                            out.add(mi)
                on Decl.interface_ as ifc
                    if ifc.name == typename
                        for mi in lspMemberInfos(ifc.members)
                            out.add(mi)
                on Decl.enum_ as e
                    if e.name == typename
                        for em in e.members
                            out.add(LspDeclInfo(em.name, "variant of " + typename, em.span))
                else
                    pass
    return out
catch |e|
    return List(LspDeclInfo)()

# Member-completion items for `receiver.` — the receiver's members only.  "[]" if
# the receiver's type or its members can't be resolved.
def lspMemberCompletionItems(text: str, path: str, recv: str, line: int): str
    var tname: str = lspResolveReceiverType(text, path, recv, line)
    if tname == ""
        return "[]"
    var mems: List(LspDeclInfo) = lspTypeMembers(text, path, tname)
    var sb: StringBuilder = StringBuilder()
    sb.append("[")
    var first: bool = true
    var seen: HashMap(str, bool) = HashMap(str, bool)()
    for m in mems
        if seen.get(m.name) == nil
            seen.set(m.name, true)
            if not first
                sb.append(",")
            first = false
            sb.append("{\"label\":\"" + diagJsonEscape(m.name) + "\",\"kind\":" + lspCompletionKind(m.detail).toString() + ",\"detail\":\"" + diagJsonEscape(m.detail) + "\"}")
    sb.append("]")
    return sb.build()

# Completion items: language keywords + every declared symbol in the buffer
# (functions, types, methods, fields).  After `receiver.` it narrows to the
# receiver's members (self/this/leading-dot → enclosing type; a type name →
# its members; an annotated/constructed local → its type's members).  Symbols
# are REAL, with kinds + signatures, which VS Code filters by the typed prefix.
def lspCompletionItems(text: str, path: str, line: int, col: int): str
    var recv: str = lspMemberReceiver(lspLineAt(text, line), col)
    if recv != ""
        return lspMemberCompletionItems(text, path, recv, line)
    var seen: HashMap(str, bool) = HashMap(str, bool)()
    var sb: StringBuilder = StringBuilder()
    sb.append("[")
    var first: bool = true
    var kws: str = "def var const class struct union interface enum mixin namespace sig type if else while for in return branch on break continue pass and or not is as true false nil this print use exposing require ensure invariant throws raise try catch cue static private public where capture with"
    for kw in kws.split(" ")
        if seen.get(kw) == nil
            seen.set(kw, true)
            if not first
                sb.append(",")
            first = false
            sb.append("{\"label\":\"" + kw + "\",\"kind\":14}")
    for d in lspBuildDeclIndex(text, path)
        if seen.get(d.name) == nil
            seen.set(d.name, true)
            if not first
                sb.append(",")
            first = false
            sb.append("{\"label\":\"" + diagJsonEscape(d.name) + "\",\"kind\":" + lspCompletionKind(d.detail).toString() + ",\"detail\":\"" + diagJsonEscape(d.detail) + "\"}")
    sb.append("]")
    return sb.build()

struct LspSigCtx
    var name: str
    var active: int

    cue init(name: str, active: int)
        .name = name
        .active = active

# Given the current line text and the cursor column, find the innermost enclosing
# call: the callee identifier and the 0-based index of the argument the cursor is
# in (top-level comma count at that paren depth).  nil if not inside a call.
# Single-line (a call spanning lines isn't tracked yet); string/char/comment
# content is skipped so a `(` or `,` inside a literal doesn't miscount.
def lspSignatureContext(line: str, col: int): LspSigCtx?
    var n: int = col
    if n > line.len
        n = line.len
    var callees: List(str) = List(str)()
    var commas: List(int) = List(int)()
    var sp: int = 0
    var i: int = 0
    var in_str: bool = false
    var in_chr: bool = false
    while i < n
        var ch: str = line[i..i + 1]
        if in_str
            if ch == "\\" and i + 1 < n
                i = i + 2
                continue
            if ch == "\""
                in_str = false
            i = i + 1
            continue
        if in_chr
            if ch == "\\" and i + 1 < n
                i = i + 2
                continue
            if ch == "'"
                in_chr = false
            i = i + 1
            continue
        if ch == "#"
            i = n
            continue
        if ch == "\""
            in_str = true
            i = i + 1
            continue
        if ch == "'"
            in_chr = true
            i = i + 1
            continue
        if ch == "("
            var st: int = i
            while st > 0 and lspIsIdentChar(lspCharAt(line, st - 1))
                st = st - 1
            var callee: str = ""
            if st < i
                callee = line[st..i]
            if sp < callees.len
                callees.set(sp, callee)
                commas.set(sp, 0)
            else
                callees.add(callee)
                commas.add(0)
            sp = sp + 1
            i = i + 1
            continue
        if ch == ")"
            if sp > 0
                sp = sp - 1
            i = i + 1
            continue
        if ch == ","
            if sp > 0
                commas.set(sp - 1, commas.at(sp - 1) + 1)
            i = i + 1
            continue
        i = i + 1
    if sp > 0
        return LspSigCtx(callees.at(sp - 1), commas.at(sp - 1))
    return nil

# Split a parameter string on TOP-LEVEL commas (depth-aware, so `HashMap(str, int)`
# stays one parameter).  Leading whitespace on each part is trimmed.
def lspSplitParams(params: str): List(str)
    var out: List(str) = List(str)()
    var depth: int = 0
    var start: int = 0
    var i: int = 0
    var n: int = params.len
    while i < n
        var ch: str = params[i..i + 1]
        if ch == "(" or ch == "["
            depth = depth + 1
        else if ch == ")" or ch == "]"
            depth = depth - 1
        else if ch == "," and depth == 0
            out.add(params[start..i].trimLeft())
            start = i + 1
        i = i + 1
    if start < n
        out.add(params[start..n].trimLeft())
    return out

# Extract the parameter list from a `def name(...): ret` detail string.
def lspParamsFromDetail(detail: str): List(str)
    var n: int = detail.len
    var i: int = 0
    while i < n and detail[i..i + 1] != "("
        i = i + 1
    if i >= n
        return List(str)()
    var depth: int = 0
    var start: int = i + 1
    var j: int = i
    while j < n
        var ch: str = detail[j..j + 1]
        if ch == "("
            depth = depth + 1
        else if ch == ")"
            depth = depth - 1
            if depth == 0
                break
        j = j + 1
    if j >= n or start >= j
        return List(str)()
    return lspSplitParams(detail[start..j])

# LSP SignatureHelp JSON for the call under the cursor (functions/methods only).
def lspSignatureHelp(text: str, path: str, line: int, col: int): str
    if lspSignatureContext(lspLineAt(text, line), col) as ctx
        if ctx.name == ""
            return "null"
        if lspFindDecl(text, path, ctx.name) as di
            if not di.detail.startsWith("def ")
                return "null"
            var params: List(str) = lspParamsFromDetail(di.detail)
            var sb: StringBuilder = StringBuilder()
            sb.append("{\"signatures\":[{\"label\":\"")
            sb.append(diagJsonEscape(di.detail))
            sb.append("\",\"parameters\":[")
            var first: bool = true
            for p in params
                if not first
                    sb.append(",")
                first = false
                sb.append("{\"label\":\"" + diagJsonEscape(p) + "\"}")
            var active: int = ctx.active
            if active < 0
                active = 0
            sb.append("]}],\"activeSignature\":0,\"activeParameter\":" + active.toString() + "}")
            return sb.build()
    return "null"

def runLsp()
    var docs: HashMap(str, str) = HashMap(str, str)()
    # Diagnostics are debounced.  A background reader forwards each stdin message
    # to a channel; the main loop recvTimeout()s it, so a ~200ms lull (or EOF)
    # flushes pending analysis.  didChange only marks a doc dirty — the flush
    # then runs ONE parse+typecheck per lull, not one per keystroke.  didOpen
    # still publishes immediately (opening a file should show its state now).
    # Requests are always answered promptly on the current buffer text.
    var evCh: Chan(str) = Chan(str)(256)
    var eof: Atomic(bool) = Atomic(bool)(false)
    var dirty: HashMap(str, bool) = HashMap(str, bool)()
    sys.go(def()
        capture
            var evCh: Chan(str) = evCh
            var eof: Atomic(bool) = eof
        while true
            var rm = lspReadMessage()
            if rm == nil
                eof.store(true)
                evCh.close()
                break
            evCh.send(rm!)
    )
    while true
        var evo = evCh.recvTimeout(0.2)
        if evo == nil
            # A ~200ms lull (or EOF): publish coalesced diagnostics for changed docs.
            for du in dirty.keys()
                if docs.get(du) as dtext
                    lspPublishDiagnostics(du, dtext)
            dirty = HashMap(str, bool)()
            if eof.load()
                break
            continue
        var body: str = evo!
        if body == ""
            continue
        var jv = Json.parse(body)
        if jv == nil
            continue
        var j = jv!
        var method: str = j.getStr("method")
        if method == "initialize"
            lspRespond(j.getInt("id"), "{\"capabilities\":{\"textDocumentSync\":1,\"documentFormattingProvider\":true,\"documentSymbolProvider\":true,\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"renameProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}}}")
        else if method == "shutdown"
            lspRespond(j.getInt("id"), "null")
        else if method == "exit"
            break
        else if method == "textDocument/didOpen"
            var td = j.getObj("params").getObj("textDocument")
            var uri: str = td.getStr("uri")
            var text: str = td.getStr("text")
            docs.set(uri, text)
            lspPublishDiagnostics(uri, text)
        else if method == "textDocument/didChange"
            var params = j.getObj("params")
            var uri: str = params.getObj("textDocument").getStr("uri")
            var new_text: str = ""
            for ch in params.getList("contentChanges")
                new_text = ch.getStr("text")
            docs.set(uri, new_text)
            dirty.set(uri, true)   # debounced — flushed on the next lull
        else if method == "textDocument/didClose"
            lspClearDiagnostics(j.getObj("params").getObj("textDocument").getStr("uri"))
        else if method == "textDocument/formatting"
            var uri: str = j.getObj("params").getObj("textDocument").getStr("uri")
            var edits: str = "[]"
            if docs.get(uri) as dt
                edits = lspFormatEdits(dt)
            lspRespond(j.getInt("id"), edits)
        else if method == "textDocument/documentSymbol"
            var uri: str = j.getObj("params").getObj("textDocument").getStr("uri")
            var syms: str = "[]"
            if docs.get(uri) as dt
                syms = lspCollectDocSymbols(dt, uri)
            lspRespond(j.getInt("id"), syms)
        else if method == "textDocument/hover"
            var params = j.getObj("params")
            var uri: str = params.getObj("textDocument").getStr("uri")
            var pos = params.getObj("position")
            var result: str = "null"
            if docs.get(uri) as dt
                var word: str = lspWordAt(dt, pos.getInt("line"), pos.getInt("character"))
                if lspFindDecl(dt, uri, word) as di
                    result = "{\"contents\":{\"kind\":\"markdown\",\"value\":\"```zebra\\n" + diagJsonEscape(di.detail) + "\\n```\"}}"
            lspRespond(j.getInt("id"), result)
        else if method == "textDocument/definition"
            var params = j.getObj("params")
            var uri: str = params.getObj("textDocument").getStr("uri")
            var pos = params.getObj("position")
            var result: str = "null"
            if docs.get(uri) as dt
                var word: str = lspWordAt(dt, pos.getInt("line"), pos.getInt("character"))
                if lspFindDecl(dt, uri, word) as di
                    # Prefer the real AST span; fall back to text search only when
                    # the parser didn't capture a position (e.g. mid-edit).
                    var dsp: Span = di.span
                    if dsp.line <= 0
                        dsp = lspDeclPosition(dt, di.detail, di.name)
                    if dsp.end_line > 0 or dsp.line > 0
                        result = "{\"uri\":\"" + diagJsonEscape(uri) + "\",\"range\":" + lspSpanRange(dsp) + "}"
                else
                    # not declared here: look in the modules this document `use`s
                    var wsd: HashMap(str, str) = lspWorkspaceDocs(docs, uri)
                    for wu in wsd.keys()
                        if wu == uri
                            continue
                        if wsd.get(wu) as wt
                            if lspFindDecl(wt, wu, word) as wdi
                                var wsp: Span = wdi.span
                                if wsp.line <= 0
                                    wsp = lspDeclPosition(wt, wdi.detail, wdi.name)
                                if wsp.end_line > 0 or wsp.line > 0
                                    result = "{\"uri\":\"" + diagJsonEscape(wu) + "\",\"range\":" + lspSpanRange(wsp) + "}"
                                    break
            lspRespond(j.getInt("id"), result)
        else if method == "textDocument/references"
            var params = j.getObj("params")
            var uri: str = params.getObj("textDocument").getStr("uri")
            var pos = params.getObj("position")
            var result: str = "[]"
            if docs.get(uri) as dt
                var word: str = lspWordAt(dt, pos.getInt("line"), pos.getInt("character"))
                result = lspReferencesJson(lspWorkspaceDocs(docs, uri), word)
            lspRespond(j.getInt("id"), result)
        else if method == "textDocument/rename"
            var params = j.getObj("params")
            var uri: str = params.getObj("textDocument").getStr("uri")
            var pos = params.getObj("position")
            var result: str = "null"
            if docs.get(uri) as dt
                var word: str = lspWordAt(dt, pos.getInt("line"), pos.getInt("character"))
                result = lspRenameJson(lspWorkspaceDocs(docs, uri), word, params.getStr("newName"))
            lspRespond(j.getInt("id"), result)
        else if method == "textDocument/completion"
            var params = j.getObj("params")
            var uri: str = params.getObj("textDocument").getStr("uri")
            var pos = params.getObj("position")
            var items: str = "[]"
            if docs.get(uri) as dt
                items = lspCompletionItems(dt, uri, pos.getInt("line"), pos.getInt("character"))
            lspRespond(j.getInt("id"), items)
        else if method == "textDocument/signatureHelp"
            var params = j.getObj("params")
            var uri: str = params.getObj("textDocument").getStr("uri")
            var pos = params.getObj("position")
            var result: str = "null"
            if docs.get(uri) as dt
                result = lspSignatureHelp(dt, uri, pos.getInt("line"), pos.getInt("character"))
            lspRespond(j.getInt("id"), result)
        else
            # Unknown method.  JSON-RPC requests carry an id; reply MethodNotFound
            # (-32601) so a client isn't left waiting.  Notifications have no id and
            # are ignored.  _json_get_int returns 0 for a missing id; a client's
            # first request is always `initialize` (handled above), so any
            # unimplemented request has a non-zero id — 0 means "notification".
            var rid: int = j.getInt("id")
            if rid != 0
                lspRespondError(rid, -32601, "method not found: " + method)

# Type-check both sides of a conflict-marked .zbr file and report results.
# Exit code is always 0 (informational); wrap in a stricter hook if you want
# blocking behaviour. Integrates as a git pre-merge-commit hook via
# tools/install_merge_hook.sh.
def runTypecheckMerge(path: str) throws
    if not File.exists(path)
        raise "typecheck-merge: file not found: " + path
    var src: str = File.read(path)
    if not src.contains("<<<<<<<")
        sys.errln("typecheck-merge: no conflict markers in " + path)
        return

    var ours_src: str = extractConflictSide(src, true)
    var theirs_src: str = extractConflictSide(src, false)
    var ours_diags: List(str) = List(str)()
    var theirs_diags: List(str) = List(str)()
    tcCheckSide(ours_src, path, ours_diags)
    tcCheckSide(theirs_src, path, theirs_diags)

    sys.errln("typecheck-merge: " + path)
    if ours_diags.len == 0
        sys.errln("  ours (HEAD): CLEAN")
    else
        sys.errln("  ours (HEAD): " + ours_diags.len.toString() + " type error(s)")
        var oi: int = 0
        while oi < ours_diags.len
            sys.errln("    " + ours_diags.at(oi))
            oi = oi + 1
    if theirs_diags.len == 0
        sys.errln("  theirs: CLEAN")
    else
        sys.errln("  theirs: " + theirs_diags.len.toString() + " type error(s)")
        var ti: int = 0
        while ti < theirs_diags.len
            sys.errln("    " + theirs_diags.at(ti))
            ti = ti + 1

# ── zebra types — expression type dumper ─────────────────────────────────────
#
# Walks all methods in the module and prints inferred types for local variable
# declarations. Useful for debugging type inference: shows what the selfhost TC
# knows at each `var`/`const` declaration site.
#
# Output format (one line per top-level var declaration):
#   file:line  Owner.method  var name: TAG
#
# Where TAG is from typeTag(): str/int/bool/named(Foo)/list(str)/etc.

def dumpMethodVars(owner: str, meth_name: str, stmts: List(Stmt), params: List(Param), mt: ModuleTypes, file: str, dep_mt: ModuleTypes)
    var ctx: InferCtx = InferCtx(mt, owner)
    ctx.withDepTypes(dep_mt)
    for pp in params
        if pp.type_ != nil
            ctx.bind(pp.name, typeFromRef(pp.type_!))
    # Walk all statements first to populate ctx with all local variable types.
    walkStmts(stmts, ctx)
    # Then iterate top-level statements and print var declarations with their types.
    var prefix: str = owner + "." + meth_name
    if owner == ""
        prefix = meth_name
    for s in stmts
        if s is Stmt.var_ as dv
            var tag: str = "unk"
            if ctx.hasLocal(dv.name)
                tag = typeTag(ctx.localType(dv.name))
            sys.errln("  " + file + ":" + dv.span.line.toString() + "  " + prefix + "  var " + dv.name + ": " + tag)

def runTypes(path: str) throws
    var src: str = File.read(path)
    const pm_node = Parser.Parser.parse(src, path)?
    var resolver = Resolver.Resolver(path, src)
    resolver.resolve(pm_node)?
    if resolver.errorCount() > 0
        sys.errln(resolver.allErrorMessages())
        sys.exit(1)
    if pm_node is PNode.module_ as pm
        const module = ASTBuilder.build(pm, path)?
        var mt: ModuleTypes = buildModuleTypes(module)
        var dep_mt: ModuleTypes = ModuleTypes()

        sys.errln("types: " + path)
        for decl in module.decls
            branch decl
                on Decl.method as dm
                    if dm.stmts as dm_stmts
                        dumpMethodVars("", dm.name, dm_stmts, dm.params, mt, path, dep_mt)
                on Decl.class_ as dc
                    for mem in dc.members
                        if mem is Decl.method as dm
                            if dm.stmts as dm_stmts
                                dumpMethodVars(dc.name, dm.name, dm_stmts, dm.params, mt, path, dep_mt)
                on Decl.struct_ as ds
                    for mem in ds.members
                        if mem is Decl.method as dm
                            if dm.stmts as dm_stmts
                                dumpMethodVars(ds.name, dm.name, dm_stmts, dm.params, mt, path, dep_mt)
                else
                    pass

# ── zebra fmt — source normalizer ────────────────────────────────────────────
#
# Normalizes Zebra source files to canonical style:
#   - Tabs replaced with spaces (4 per indent level)
#   - Trailing whitespace stripped from each line
#   - File ends with exactly one newline
#   - No windows CRLF line endings
#
# Usage:
#   zebra fmt <file.zbr>          normalize in-place
#   zebra fmt --check <file.zbr>  exit 1 if file would change (CI check)
#   zebra fmt --print <file.zbr>  print normalized output without writing

# Result of formatting one source line: the transformed text plus whether the
# line ends INSIDE an open triple-quoted (`"""`) block (the only string form that
# spans lines — carried to the next line so its content is preserved verbatim).
struct FmtLine
    var out: str
    var in_triple: bool

    cue init(out: str, in_triple: bool)
        .out = out
        .in_triple = in_triple

# Format one line, given whether it starts inside an open `"""` block.
#
# String-preservation is the whole point: interior multiple spaces collapse to
# one and tabs normalize, but ONLY in *code* regions.  Everything inside a string
# (`"…"`, `'…'`, raw `r"…"`, no-sub `ns'…'`), a triple-quoted block, or a `#`
# comment is copied byte-for-byte.  Leading indentation is preserved as-is.
#
# Safety: the scanner never deletes or rewrites a non-space character — it only
# ever collapses runs of spaces in code.  Regular strings honour `\` escapes;
# any mis-read makes the scanner stay *inside* a string (under-collapse, benign)
# rather than exit early (which would be the only way to touch string content).
# Line strings can't span newlines, so a mis-read is bounded to a single line.
def fmtLine(line: str, start_in_triple: bool): FmtLine
    var n: int = line.len
    var sb: StringBuilder = StringBuilder()
    var i: int = 0
    var triple: bool = start_in_triple
    # Have we emitted any non-space code content on this line yet?  Until we have,
    # leading spaces are indentation and are preserved verbatim.
    var seen_content: bool = start_in_triple
    var prev_space: bool = false
    while i < n
        if triple
            # Inside a `"""` block: copy verbatim until the closing `"""`.
            if i + 3 <= n and line[i..i + 3] == "\"\"\""
                sb.append("\"\"\"")
                triple = false
                seen_content = true
                prev_space = false
                i = i + 3
            else
                sb.append(line[i..i + 1])
                i = i + 1
            continue
        var ch: str = line[i..i + 1]
        # Line comment: copy the rest of the line verbatim.
        if ch == "#"
            sb.append(line[i..n])
            i = n
            continue
        # Triple-quoted open (check before the single-quote case).
        if ch == "\"" and i + 3 <= n and line[i..i + 3] == "\"\"\""
            sb.append("\"\"\"")
            triple = true
            seen_content = true
            prev_space = false
            i = i + 3
            continue
        # Regular / raw / no-sub double-quoted string: copy to the closing quote.
        if ch == "\""
            sb.append(ch)
            seen_content = true
            prev_space = false
            i = i + 1
            while i < n
                if line[i..i + 1] == "\\" and i + 1 < n
                    sb.append(line[i..i + 2])
                    i = i + 2
                    continue
                var c2: str = line[i..i + 1]
                sb.append(c2)
                i = i + 1
                if c2 == "\""
                    break
            continue
        # Single-quoted string / char literal: copy to the closing quote.
        if ch == "'"
            sb.append(ch)
            seen_content = true
            prev_space = false
            i = i + 1
            while i < n
                if line[i..i + 1] == "\\" and i + 1 < n
                    sb.append(line[i..i + 2])
                    i = i + 2
                    continue
                var c3: str = line[i..i + 1]
                sb.append(c3)
                i = i + 1
                if c3 == "'"
                    break
            continue
        # A space: preserve leading indentation; collapse interior runs to one.
        if ch == " "
            if not seen_content
                sb.append(" ")
            else if not prev_space
                sb.append(" ")
                prev_space = true
            i = i + 1
            continue
        # A tab: 4 spaces in leading indentation; a single space between tokens.
        if ch == "\t"
            if not seen_content
                sb.append("    ")
            else if not prev_space
                sb.append(" ")
                prev_space = true
            i = i + 1
            continue
        # Ordinary code character.
        sb.append(ch)
        seen_content = true
        prev_space = false
        i = i + 1
    return FmtLine(sb.build(), triple)

def fmtNormalize(src: str): str
    var sb: StringBuilder = StringBuilder()
    var in_triple: bool = false
    for line in src.split("\n")
        var res: FmtLine = fmtLine(line, in_triple)
        var text: str = res.out
        # Trailing-whitespace trim, but only when the line ends in code — trailing
        # spaces inside an open `"""` block are string content and must survive.
        if not res.in_triple
            text = text.trimRight()
        sb.append(text + "\n")
        in_triple = res.in_triple
    var result: str = sb.build()
    # Trim trailing blank lines, leave exactly one trailing newline.
    result = result.trimRight() + "\n"
    return result


# ── `zebra up` -- update the installed compiler to the latest release (2026-09-14) ──────
# V has `v up`; a language whose first release is meant for strangers needs the same. The
# installers (install/install.sh, install.ps1) lay out `~/.zebra/current/` with the
# compiler, its bundled Zig, QUICKSTART and examples; `up` replaces that folder.
#
#   zebra up             download, verify, unpack, swap; prints old -> new
#   zebra up --check     say whether a newer release exists; change nothing
#   zebra up --to VER    a specific tag's version (e.g. 0.9.0-rc2_zig0.16), not latest
#
# HOW IT FINDS THE RELEASE WITHOUT THE API. `releases/latest/download/SHA256SUMS.txt`
# redirects to the newest release's checksum file, whose lines NAME the assets --
# `zebra-<ver>-<os>-<arch>.<ext>` -- so one unauthenticated GET yields the version, the
# asset name and the checksum, and there is no rate limit to hit (the API's is 60/hour
# per IP, which a shared address exhausts by lunchtime).
#
# THE SWAP IS THE ONLY PLATFORM-SPECIFIC PART. On POSIX a directory holding a running
# executable can be renamed, so `current` becomes `previous` and the unpacked folder
# becomes `current` in-process. On Windows the running zebra.exe pins its folder, so a
# helper batch file is started DETACHED; it waits for this process to exit, then does the
# two renames and prints the result into its own console. Either way `previous/` is kept
# once, so a bad update is one rename away from undone.
#
# REFUSES, by name, when this binary is not inside an installer layout (its folder is not
# called `current`): a source build at zig-out/bin is not something `up` should overwrite,
# and guessing where to put a release would be worse than saying so.

def upOs(): str
    if dbgIsWindows()
        return "windows"
    var mac: bool = zig"builtin.os.tag == .macos"
    if mac
        return "macos"
    return "linux"

def upArch(): str
    var a: str = zig"@as([]const u8, @tagName(builtin.cpu.arch))"
    return a

def upFetch(url: str): str throws
    var r = Http.get(url)
    if r as resp
        if resp.status != 200
            raise "GET " + url + " -> HTTP " + resp.status.toString()
        return resp.text
    raise "GET " + url + " failed (no response)"

def runUp(check_only: bool, want: str) throws
    # Where are we? Only an installer layout is managed -- decided BEFORE any network
    # traffic, so the refusal is instant, offline, and gate-able (cli_check).
    var exe_dir: str = Path.dirname(sys.selfExe())
    if not check_only and Path.basename(exe_dir) != "current"
        sys.errln("zebra up: REFUSING -- this binary is not an installed release (" + exe_dir + " is not .../current).")
        sys.errln("  `zebra up` manages the layout install.sh / install.ps1 create; for a source build, git pull and zig build.")
        sys.exit(2)
    var os_: str = upOs()
    var arch: str = upArch()
    var ext: str = if(os_ == "windows", "zip", "tar.gz")
    var suffix: str = "-" + os_ + "-" + arch + "." + ext
    var base: str = "https://github.com/torial/zebra-language/releases/"
    var rel: str = if(want == "", "latest/download/", "download/v" + want + "/")
    var sums: str = upFetch(base + rel + "SHA256SUMS.txt")?

    # Find our asset's line: "<sha256>  <asset>".
    var asset: str = ""
    var want_sha: str = ""
    for line in sums.lines()
        var t: str = line.trim()
        if t.endsWith(suffix)
            var sp: int = t.indexOf(" ")
            if sp > 0
                want_sha = t.substring(0, sp)
                asset = t.substring(sp, t.len).trim()
    if asset == ""
        raise "no release asset for this platform (" + os_ + "-" + arch + ") in SHA256SUMS.txt"
    # zebra-<ver>-<os>-<arch>.<ext>  ->  <ver>
    var latest: str = asset.substring(6, asset.len - suffix.len)
    var installed: str = zig"_zbr_version"
    var uptodate: bool = latest.startsWith(installed)
    print("zebra up: installed " + installed + ", latest " + latest + (if(uptodate, " -- up to date", " -- update available")))
    if check_only or (uptodate and want == "")
        return

    var root: str = Path.dirname(exe_dir)
    var downloads: str = root + "/downloads"
    var versions: str = root + "/versions"
    Dir.createAll(downloads)
    Dir.createAll(versions)

    # Download and verify. The checksum is the contract; a mismatch deletes the file.
    print("zebra up: downloading " + asset + " ...")
    var body: str = upFetch(base + rel + asset)?
    var got_sha: str = Hash.sha256(body)
    if got_sha != want_sha
        raise "checksum mismatch for " + asset + ": expected " + want_sha + ", got " + got_sha
    var archive: str = downloads + "/" + asset
    File.write(archive, body)
    print("zebra up: verified sha256 " + got_sha.substring(0, 12) + "... (" + (body.len / 1048576).toString() + " MB)")

    # Unpack with the platform's tar (bsdtar on Windows reads zip; Windows 10 1803+).
    var folder: str = asset.substring(0, asset.len - ext.len - 1)
    if Dir.exists(versions + "/" + folder)
        Dir.deleteAll(versions + "/" + folder)
    var targv: List(str) = List(str)()
    targv.add("tar")
    targv.add("-xf")
    targv.add(archive)
    targv.add("-C")
    targv.add(versions)
    var tr = sys.run(targv)
    if tr.exit_code != 0
        raise "tar failed (exit " + tr.exit_code.toString() + "): " + tr.stderr
    if not Dir.exists(versions + "/" + folder)
        raise "archive did not unpack to " + versions + "/" + folder
    File.delete(archive)

    var previous: str = root + "/previous"
    var current: str = root + "/current"
    if dbgIsWindows()
        # Detached helper: wait for this process to release its folder, then swap.
        var pid: int = zig"@as(i64, @intCast(std.os.windows.GetCurrentProcessId()))"
        var cmd: str = "@echo off\r\n"
        cmd = cmd + ":wait\r\n"
        cmd = cmd + "tasklist /FI \"PID eq " + pid.toString() + "\" 2>nul | find \"" + pid.toString() + "\" >nul && (timeout /t 1 /nobreak >nul & goto wait)\r\n"
        cmd = cmd + "if exist \"" + previous.replace("/", "\\") + "\" rmdir /s /q \"" + previous.replace("/", "\\") + "\"\r\n"
        cmd = cmd + "move \"" + current.replace("/", "\\") + "\" \"" + previous.replace("/", "\\") + "\" >nul\r\n"
        cmd = cmd + "move \"" + (versions + "/" + folder).replace("/", "\\") + "\" \"" + current.replace("/", "\\") + "\" >nul\r\n"
        cmd = cmd + "echo zebra up: installed " + latest + " (previous kept in previous\\). Open a new terminal.\r\n"
        var script: str = root + "/up_swap.cmd"
        File.write(script, cmd)
        var sargv: List(str) = List(str)()
        sargv.add("cmd")
        sargv.add("/c")
        sargv.add("start")
        sargv.add("\"zebra up\"")
        sargv.add("/min")
        sargv.add("cmd")
        sargv.add("/c")
        sargv.add(script.replace("/", "\\"))
        var sr = sys.run(sargv)
        if sr.exit_code != 0
            raise "could not start the swap helper: " + sr.stderr
        print("zebra up: " + installed + " -> " + latest + " will be swapped in as soon as this process exits.")
        return

    if Dir.exists(previous)
        Dir.deleteAll(previous)
    File.rename(current, previous)
    File.rename(versions + "/" + folder, current)
    print("zebra up: " + installed + " -> " + latest + " (previous kept in " + previous + ")")
    var vargv: List(str) = List(str)()
    vargv.add(current + "/zebra")
    vargv.add("--version")
    var vr = sys.run(vargv)
    if vr.stdout != ""
        print(vr.stdout.trim())

def runFmt(path: str, check_only: bool, print_only: bool) throws
    if not File.exists(path)
        raise "fmt: file not found: " + path
    var original: str = File.read(path)
    var formatted: str = fmtNormalize(original)
    if check_only
        if original != formatted
            sys.errln("fmt: " + path + " would be reformatted")
            sys.exit(1)
        sys.exit(0)
    if print_only
        print(formatted)
        sys.exit(0)
    if original == formatted
        sys.errln("fmt: " + path + " already formatted")
        sys.exit(0)
    File.write(path, formatted)
    sys.errln("fmt: " + path + " reformatted")

# ── GUI-via-selfhost: --gui-backend=tui scaffold driver ─────────────────────
# Wrap the emitted zig (already using the tui backend) in a minimal `zig build`
# project with the zigzag dependency, then build/run it. Ported from
# src/main.zig compileGuiProject; uses --build-file/--cache-dir so no cwd change
# is needed. sys.exec_inherit streams output live (no BUG-208 pipe block).
def tuiBuildZig(): str
    return """
const std = @import("std");
pub fn build(b: *std.Build) void {
    const target   = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});
    const zz_dep = b.dependency("zigzag", .{
        .target   = target,
        .optimize = optimize,
    });
    const app_mod = b.createModule(.{
        .root_source_file = b.path("src/main.zig"),
        .target           = target,
        .optimize         = optimize,
    });
    app_mod.addImport("zigzag", zz_dep.module("zigzag"));
    const exe = b.addExecutable(.{
        .name        = "app",
        .root_module = app_mod,
    });
    b.installArtifact(exe);
    const run_step = b.addRunArtifact(exe);
    if (b.args) |args| run_step.addArgs(args);   // `zebra app.zbr -- a b` reaches the program
    b.step("run", "Run the app").dependOn(&run_step.step);
}
"""

def tuiBuildZon(): str
    return """
.{
    .name                 = .app,
    .version              = "0.0.1",
    .minimum_zig_version  = "0.16.0",
    .fingerprint          = 0xc96e70cf4d3a38ad,
    .dependencies = .{
        .zigzag = .{
            .url  = "git+https://github.com/meszmate/zigzag#v0.1.5",
            .hash = "zigzag-0.1.2-YXwYS17aEQBlpxPETTrhY5leFh7vV0DpnXJbHogs4Lsv",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src" },
}
"""

def luiBuildZig(): str
    return """
const std = @import("std");
pub fn build(b: *std.Build) void {
    const target   = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});
    const lui_dep  = b.dependency("zig_libui_ng", .{
        .target   = target,
        .optimize = optimize,
    });
    const app_mod = b.createModule(.{
        .root_source_file = b.path("src/main.zig"),
        .target           = target,
        .optimize         = optimize,
    });
    app_mod.addImport("ui",  lui_dep.module("ui"));
    app_mod.addImport("sci", lui_dep.module("sci"));
    const exe = b.addExecutable(.{
        .name          = "app",
        .root_module   = app_mod,
        // libui is linked STATICALLY here, so the Common-Controls v6 manifest
        // that libui-ng only embeds in a *shared* build is absent — a static
        // consumer exe must supply it or window/control init fails on Windows
        // (see libui-ng windows/resources.rc + test/test.static.manifest).
        .win32_manifest = b.path("app.manifest"),
    });
    b.installArtifact(exe);
    const run_step = b.addRunArtifact(exe);
    if (b.args) |args| run_step.addArgs(args);   // `zebra app.zbr -- a b` reaches the program
    b.step("run", "Run the app").dependOn(&run_step.step);
}
"""

# Path `target` expressed relative to directory `from_dir`: both made absolute against the
# cwd, separators normalised to `/`, Windows drive letters compared case-insensitively.
# On different drives there is no relative spelling and `target` comes back as given.
def absPath(p_in: str): str
    var p: str = p_in.replace("\\", "/")
    if p.startsWith("/") or (p.len > 1 and p[1..2] == ":")
        return p
    return sys.cwd().replace("\\", "/") + "/" + p

def pathParts(p: str): List(str)
    var out: List(str) = List(str)()
    for part in p.split("/")
        if part == "" or part == "."
            continue
        out.add(part)
    return out

def relativePath(from_dir: str, target: str): str
    var a: List(str) = pathParts(absPath(from_dir))
    var b: List(str) = pathParts(absPath(target))
    if a.len > 0 and b.len > 0 and a.at(0).endsWith(":") and b.at(0).endsWith(":")
        if a.at(0).lower() != b.at(0).lower()
            return target.replace("\\", "/")
    var i: int = 0
    while i < a.len and i < b.len and a.at(i) == b.at(i)
        i = i + 1
    var out: str = ""
    var k: int = i
    while k < a.len
        out = out + "../"
        k = k + 1
    var j: int = i
    while j < b.len
        out = out + b.at(j)
        if j + 1 < b.len
            out = out + "/"
        j = j + 1
    if out == ""
        return "."
    if out.endsWith("/")
        out = out[0 .. out.len - 1]
    return out

# ZEBRA_LIBUI_PATH (2026-09-08): point the GUI dependency at a LOCAL zig-libui-ng
# checkout instead of the pinned URL — `.path = ...` needs no push and no hash. This
# is how unpushed shim work (OnNotify, OnKey) is tried on Windows before the pin
# moves: `set ZEBRA_LIBUI_PATH=C:\Projects\zig-libui-ng` then run the program.
# Never the default: a pin is reproducible, a path is whatever is on that disk.
#
# zig refuses an ABSOLUTE `.path` ("expected path relative to build root"), so the
# value is emitted relative to the scaffold directory `proj`. Found 2026-09-16 on the
# first Windows run of the override (the doc said it worked; nothing had run it).
def luiBuildZon(proj: str): str
    var dep: str = """        .zig_libui_ng = .{
            .url  = "git+https://github.com/torial/zig-libui-ng?ref=main#93c7f54b2051d17b9f69d203ff3cd4500e60d285",
            .hash = "bindings_libui_ng-0.1.0-p2CY9VwQQgApSplQXciuuEWGImM_PPrHwvCG9f_SXioP",
        },
"""
    if sys.getenv("ZEBRA_LIBUI_PATH") as lp
        if lp != ""
            dep = "        .zig_libui_ng = .{ .path = \"" + relativePath(proj, lp) + "\" },\n"
    return """
.{
    .name         = .app,
    .version      = "0.0.1",
    .fingerprint  = 0xc96e70cfe3b36b0a,
    .dependencies = .{
""" + dep + """    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "app.manifest" },
}
"""

# Common-Controls v6 application manifest. libui-ng embeds this only in a
# *shared* build; a static consumer exe (what we emit) must supply it itself
# or window/control creation fails on Windows (verbatim from libui-ng's
# test/test.static.manifest — "we DO need comctl6 in the static case").
def luiManifest(): str
    return """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
<assemblyIdentity
    version="1.0.0.0"
    processorArchitecture="*"
    name="Zebra.Gui.Application"
    type="win32"
/>
<description>Zebra libui_ng application.</description>
<dependency>
    <dependentAssembly>
        <assemblyIdentity
            type="win32"
            name="Microsoft.Windows.Common-Controls"
            version="6.0.0.0"
            processorArchitecture="*"
            publicKeyToken="6595b64144ccf1df"
            language="*"
        />
    </dependentAssembly>
</dependency>
<compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
        <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
        <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
</compatibility>
</assembly>
"""

# BUG-340: a GUI program with `use` deps emitted lsp.zig/sci.zig BESIDE the
# source (where the non-GUI path expects them) but main.zig was COPIED into
# <proj>/src, so its `@import("lsp.zig")` failed with FileNotFound. Walk the
# emitted file's `@import("X.zig")` lines (transitively) and copy each module
# that exists next to the emitted main into the project's src dir.
def copyGuiDeps(zig_path: str, srcDir: str)
    var dir: str = Path.dirname(zig_path)
    if dir == ""
        dir = "."
    var todo: List(str) = List(str)()
    var seen: List(str) = List(str)()
    todo.add(zig_path)
    while todo.len > 0
        var cur: str = todo.at(todo.len - 1)
        todo.remove(todo.len - 1)
        var text: str = File.read(cur)
        var parts: List(str) = text.split("@import(\"")
        var first: bool = true
        for part in parts
            if first
                first = false
                continue
            var q: int = part.indexOf("\"")
            if q <= 0
                continue
            var name: str = part[0..q]
            if not name.endsWith(".zig") or name.contains("/") or name.contains("\\")
                continue
            if seen.contains(name)
                continue
            seen.add(name)
            var from: str = dir + "/" + name
            if File.exists(from)
                File.copy(from, srcDir + "/" + name)
                todo.add(from)

def compileGuiProject(zig_path: str, mode_run: bool, backend: str, scaffold_only: bool, prog_args: List(str)): int
    var suffix: str = "_gui_tui"
    if backend == "libui_ng"
        suffix = "_gui_libui_ng"
    var stem: str = zig_path
    if stem.endsWith(".zig")
        stem = stem[0 .. stem.len - 4]
    var proj: str = stem + suffix
    var srcDir: str = proj + "/src"
    Dir.createAll(srcDir)
    File.copy(zig_path, srcDir + "/main.zig")
    copyGuiDeps(zig_path, srcDir)
    var bz: str = tuiBuildZig()
    var bzon: str = tuiBuildZon()
    if backend == "libui_ng"
        bz = luiBuildZig()
        bzon = luiBuildZon(proj)
    # Always (re)write the generated build files — they are templates, and a
    # stale scaffold from a prior run must pick up an updated dependency pin
    # rather than silently keeping the old one.
    File.write(proj + "/build.zig", bz)
    File.write(proj + "/build.zig.zon", bzon)
    if backend == "libui_ng"
        File.write(proj + "/app.manifest", luiManifest())
    if scaffold_only
        sys.errln("wrote " + proj + "/ (scaffold only; not built)")
        return 0
    var argv = List(str)()
    argv.add(zigExe())
    argv.add("build")
    argv.add("--build-file")
    argv.add(proj + "/build.zig")
    argv.add("--cache-dir")
    argv.add(proj + "/.zig-cache")
    if mode_run
        argv.add("run")
        # BUG-429 (2026-09-17): the GUI run path dropped the `--` program arguments and
        # did not hand the child ZEBRA_COMPILER -- both of which the non-GUI run paths
        # do. zebra-ide opened with no files and "could not start `zebra lsp`".
        if prog_args.len > 0
            argv.add("--")
            for pa in prog_args
                argv.add(pa)
        if sys.getenv("ZEBRA_COMPILER") == nil
            sys.setenv("ZEBRA_COMPILER", sys.selfExe())
    return sys.exec_inherit(argv)

# BUG-300 WORKAROUND — retry the scratch unlink instead of assuming it took.
#
# THIS IS A WORKAROUND AND IS LABELLED ONE. BUG-244 made `zebra <file>.zbr` clean up its
# ~20 MB scratch executable; on 2026-08-20 that stopped working -- 5/5 deterministic, and
# 3/3 against a compiler built from HEAD, so it was not a source regression. Then it
# stopped reproducing again with no relevant change. What moves it is NOT established;
# see BUG-300. This makes the existing BUG-244 cleanup robust against the timing rather
# than dependent on it.
#
# What IS established: `rm` from a shell immediately afterwards succeeds, so the handle is
# released a moment later and the compiler's unlink simply runs too early -- the classic
# delete-a-just-executed-image shape on Windows. `File.delete` cannot report failure,
# which is why this was invisible without the gate.
#
# COSTS NOTHING ON THE COMMON PATH: when the first delete works, `File.exists` is false
# and this returns without ever sleeping. Bound is 12 x 25 ms; a file still held after
# 300 ms is a different problem and is left alone rather than spun on.
#
# TOP-LEVEL, not a method: both call sites are inside `def main()`, and a `.method()`
# contextual-self call there is "'this' used outside a class/struct method" -- which is
# exactly how the first version of this failed, silently, inside a regen whose stderr
# goes to /dev/null.
def deleteScratch(path: str)
    # Early out: a `.pdb` only exists on the LLVM path, so most calls have nothing to do
    # and must not pay a syscall for it.
    if not File.exists(path)
        return
    # EXPONENTIAL, not flat. The old bound was 12 x 25 ms = 300 ms, which held in
    # isolation and did NOT hold under sustained load -- measured 2026-08-23, 9 executables
    # leaked during a single --daily. Windows releases the image of a just-executed process
    # asynchronously, and under load that lag exceeds 300 ms. 5-10-20-...-640 reaches ~1.3 s
    # in ten tries while still costing NOTHING on the common path, where the first delete
    # works and the loop exits before it ever sleeps.
    #
    # BUG-308: this loop USED TO BE UNREACHABLE for the failure it exists to survive.
    # `File.delete` panics on every error except FileNotFound, and a Windows lock is not
    # FileNotFound -- so the very first attempt aborted the compiler and no retry ever
    # happened. The backoff was dead code, and the `File.exists` guard above meant the one
    # error `delete` tolerated was the one that could not occur on this path.
    #
    # `File.tryDelete` reports rather than panics: TRUE iff the file is absent afterwards.
    var tries: int = 0
    var wait: int = 5
    while tries < 10
        if File.tryDelete(path)
            return
        sys.sleep(wait)
        wait = wait * 2
        tries = tries + 1

# -- DAP source map (`zebra debug`) --------------------------------------------
# Codegen stamps `// zbr:<file>:<line>` above the code it emits for each Zebra
# statement. Those comments are the ONLY link between the .zbr line a user set a
# breakpoint on and the .zig line the debugger actually knows about, so every
# coordinate crossing the DAP relay is translated through the markers below.

class DbgMarker
    var zig_line: int    # 1-based line of the COMMENT itself
    var file: str        # zbr path, forward-slash normalised -- the map key
    var zbr_line: int

# A Windows IDE sends `C:\p\a.zbr` for what codegen wrote as `C:/p/a.zbr`.
def dbgNormSep(p: str): str
    return p.replace("\\", "/")

def dbgAllDigits(s: str): bool
    if s == ""
        return false
    var i: int = 0
    while i < s.len
        var c: char = s[i]
        branch c
            on c'0'..c'9'
                i = i + 1
            else
                return false
    return true

# Every marker in the generated Zig, in ascending zig_line order.
def dbgLoadMarkers(zig_src: str): List(DbgMarker)
    var out: List(DbgMarker) = List(DbgMarker)()
    var zig_line: int = 0
    for line in zig_src.split("\n")
        zig_line = zig_line + 1
        var t: str = line.trim()
        if t.startsWith("// zbr:")
            var payload: str = t.substring(7, t.len)
            # Split on the LAST colon -- a Windows path carries colons of its own,
            # so `C:/p/a.zbr:10` must not split at the drive letter.
            var lc: int = payload.lastIndexOf(":")
            if lc > 0
                var f: str = payload.substring(0, lc)
                var n: str = payload.substring(lc + 1, payload.len)
                # A malformed marker is SKIPPED, never defaulted to a line number:
                # a fabricated coordinate sends a debugger somewhere confidently wrong.
                if dbgAllDigits(n) and f != ""
                    var m: DbgMarker = DbgMarker()
                    m.zig_line = zig_line
                    m.file = dbgNormSep(f)
                    m.zbr_line = n.toInt()
                    out.add(m)
    return out

# zbr (file, line) -> the zig line a breakpoint should be set on.
# Returns the CODE line (marker + 1), never the comment, so the breakpoint lands
# on something executable. Picks the first marker at or after `line`; if `line` is
# past the last statement in the file it clamps to the highest one, matching what
# a debugger does with a breakpoint set below the end of a function.
def dbgZbrToZig(markers: List(DbgMarker), file: str, line: int): int?
    var key: str = dbgNormSep(file)
    var best: int = -1
    var best_zbr: int = 0
    var clamp: int = -1
    var clamp_zbr: int = -1
    for m in markers
        if m.file == key
            if m.zbr_line > clamp_zbr
                clamp_zbr = m.zbr_line
                clamp = m.zig_line + 1
            if m.zbr_line >= line
                if best < 0 or m.zbr_line < best_zbr
                    best_zbr = m.zbr_line
                    best = m.zig_line + 1
    if best >= 0
        return best
    if clamp >= 0
        return clamp
    # Unknown file: nil, never a guess. The caller leaves the coordinate alone.
    return nil

# zig line -> the zbr location of the nearest marker at or before it.
def dbgZigToZbr(markers: List(DbgMarker), zig_line: int): DbgMarker?
    var found: DbgMarker? = nil
    var found_line: int = 0
    for m in markers
        if m.zig_line <= zig_line
            if found == nil or m.zig_line > found_line
                found = m
                found_line = m.zig_line
    return found

# The emitted key that best suffix-matches an IDE-supplied absolute path.
def dbgCanonicalZbr(markers: List(DbgMarker), abs_path: str): str?
    var norm: str = dbgNormSep(abs_path)
    var best: str? = nil
    var best_len: int = 0
    for m in markers
        if norm.endsWith(m.file) and m.file.len > best_len
            best = m.file
            best_len = m.file.len
    return best

# -- DAP message transform ----------------------------------------------------
# The relay rewrites coordinates in exactly TWO message kinds and copies every other
# message through byte for byte. That asymmetry is the design: a debug adapter protocol
# carries fields this relay does not model, and inventing a schema for them would break
# clients that use them. Anything not understood is forwarded unaltered.

# JSON-escape a string for emission. DAP keys are plain identifiers, but PATHS are not:
# a Windows path is full of backslashes and would otherwise produce invalid JSON.
def dbgJsonStr(v: str): str
    var out: str = "\""
    var i: int = 0
    while i < v.len
        var c: char = v[i]
        branch c
            on c'"'
                out = out + "\\\""
            on c'\\'
                out = out + "\\\\"
            on c'\n'
                out = out + "\\n"
            on c'\r'
                out = out + "\\r"
            on c'\t'
                out = out + "\\t"
            else
                out = out + v.substring(i, i + 1)
        i = i + 1
    return out + "\""

# Re-emit `obj` with `key` replaced by the RAW json text `newval`. Every other field is
# copied through by stringifying it, whatever its type -- which is why Json.keys()/at()
# had to exist: the typed getters cannot copy a field they cannot name the type of.
def dbgWithKey(obj: JsonValue, key: str, newval: str): str
    var out: str = "{"
    var first: bool = true
    var oks: List(str) = obj.keys()
    for k in oks
        if not first
            out = out + ","
        first = false
        out = out + dbgJsonStr(k) + ":"
        if k == key
            out = out + newval
        else
            out = out + Json.stringify(obj.at(k))
    return out + "}"

# ide -> lldb. A breakpoint arrives against a .zbr path and a .zbr line; the debugger
# only knows the generated .zig, so both are rewritten. A request naming any other file
# is passed through -- the IDE may legitimately breakpoint something we did not emit.
def dbgRemapSetBreakpoints(markers: List(DbgMarker), root: JsonValue, body: str, zig_abs: str): str
    var args_v: JsonValue = root.at("arguments")
    if args_v.isNull()
        return body
    var src_v: JsonValue = args_v.at("source")
    if src_v.isNull()
        return body
    var zbr_path: str = src_v.getStr("path")
    if not (zbr_path.endsWith(".zbr") or zbr_path.endsWith(".ZBR"))
        return body

    # The map key is whichever emitted path best suffix-matches what the IDE sent.
    var key: str = dbgNormSep(zbr_path)
    if dbgCanonicalZbr(markers, zbr_path) as canon
        key = canon

    var new_src: str = dbgWithKey(src_v, "path", dbgJsonStr(zig_abs))

    var bps: str = "["
    var bfirst: bool = true
    for bp in args_v.getList("breakpoints")
        if not bfirst
            bps = bps + ","
        bfirst = false
        var zbr_line: int = bp.getInt("line")
        var mapped: str = zbr_line.toString()
        if dbgZbrToZig(markers, key, zbr_line) as zl
            mapped = zl.toString()
        bps = bps + dbgWithKey(bp, "line", mapped)
    bps = bps + "]"

    var new_args: str = "{"
    var afirst: bool = true
    var aks: List(str) = args_v.keys()
    for k in aks
        if not afirst
            new_args = new_args + ","
        afirst = false
        new_args = new_args + dbgJsonStr(k) + ":"
        if k == "source"
            new_args = new_args + new_src
        else if k == "breakpoints"
            new_args = new_args + bps
        else
            new_args = new_args + Json.stringify(args_v.at(k))
    new_args = new_args + "}"
    return dbgWithKey(root, "arguments", new_args)

# lldb -> ide. A stack frame comes back pointing into the generated .zig; the user is
# looking at .zbr. Frames whose source is NOT our .zig are left alone -- a frame inside
# the Zig standard library is not ours to rewrite, and pretending otherwise would send
# the editor to a .zbr line that has nothing to do with it.
def dbgRemapStackTrace(markers: List(DbgMarker), root: JsonValue, body: str, zig_abs: str): str
    # Only OUR generated file may be remapped. The Zig original tested
    # endsWith(".zig"), which also matches the Zig standard library -- a frame in
    # std/mem.zig would be rewritten to an unrelated .zbr line, sending the editor
    # somewhere confidently wrong. Compare the FILE NAME instead.
    var zig_base: str = dbgNormSep(zig_abs)
    var zbi: int = zig_base.lastIndexOf("/")
    if zbi >= 0
        zig_base = zig_base.substring(zbi + 1, zig_base.len)
    var body_v: JsonValue = root.at("body")
    if body_v.isNull()
        return body

    var frames: str = "["
    var ffirst: bool = true
    for fr in body_v.getList("stackFrames")
        if not ffirst
            frames = frames + ","
        ffirst = false
        var fsrc: JsonValue = fr.at("source")
        var zig_line: int = fr.getInt("line")
        var did: bool = false
        if not fsrc.isNull()
            var fpath: str = fsrc.getStr("path")
            if dbgNormSep(fpath).endsWith(zig_base) and zig_line > 0
                if dbgZigToZbr(markers, zig_line) as loc
                    var new_src: str = dbgWithKey(fsrc, "path", dbgJsonStr(loc.file))
                    var inner: str = "{"
                    var ifirst: bool = true
                    var fks: List(str) = fr.keys()
                    for k in fks
                        if not ifirst
                            inner = inner + ","
                        ifirst = false
                        inner = inner + dbgJsonStr(k) + ":"
                        if k == "line"
                            inner = inner + loc.zbr_line.toString()
                        else if k == "source"
                            inner = inner + new_src
                        else
                            inner = inner + Json.stringify(fr.at(k))
                    frames = frames + inner + "}"
                    did = true
        if not did
            frames = frames + Json.stringify(fr)
    frames = frames + "]"
    return dbgWithKey(root, "body", dbgWithKey(body_v, "stackFrames", frames))

# The relay's whole rewriting surface. Anything that is not one of the two coordinate
# carriers -- and anything malformed -- returns the ORIGINAL bytes, never a guess.
def dbgTransform(markers: List(DbgMarker), body: str, ide_to_lldb: bool, zig_abs: str): str
    if Json.parse(body) as root
        if not root.isObject()
            return body
        if ide_to_lldb
            if root.getStr("command") == "setBreakpoints"
                return dbgRemapSetBreakpoints(markers, root, body, zig_abs)
            return body
        if root.getStr("type") == "response" and root.getStr("command") == "stackTrace"
            return dbgRemapStackTrace(markers, root, body, zig_abs)
        return body
    return body

# `zebra debug --dump-map <file.zig|file.zbr>` -- print the provenance map.
# This is a diagnostic in its own right (it answers "why did my breakpoint land
# THERE?"), and it is also what makes the remapping gate-able without an
# installed lldb-dap: it reports the round-trip computed by the SHIPPING
# functions, so a checker can assert the property without a second copy of them.
# Resolve a .zbr (by emitting it) or a .zig (directly) to the generated Zig on disk.
# Shared by --dump-map and --dump-transform so the two cannot disagree about which file
# the map came from -- they are meant to describe the same thing.
def dbgResolveZig(path: str, who: str): str?
    var zig_path: str = path
    if path.endsWith(".zbr")
        var out_dir: str = ".zig-cache/zbr-dumpmap"
        Dir.createAll(out_dir)
        var argv: List(str) = List(str)()
        argv.add(sys.selfExe())
        argv.add("--emit-zig")
        argv.add("--output-dir")
        argv.add(out_dir)
        argv.add(path)
        var r = sys.run(argv)
        if r.exit_code != 0
            sys.errln("zebra debug " + who + ": could not compile '" + path + "'")
            if r.stderr != ""
                sys.err(r.stderr)
            return nil
        var stem: str = path
        var si: int = stem.lastIndexOf("/")
        if si >= 0
            stem = stem.substring(si + 1, stem.len)
        var bi: int = stem.lastIndexOf("\\")
        if bi >= 0
            stem = stem.substring(bi + 1, stem.len)
        zig_path = out_dir + "/" + stem.substring(0, stem.len - 4) + ".zig"
    if not File.exists(zig_path)
        sys.errln("zebra debug " + who + ": no such file: " + zig_path)
        return nil
    return zig_path

# -- The DAP relay itself (`zebra debug <file.zbr>`), native since 2026-09-07 --------
# Ported off the bootstrap (src/Debugger.zig), which was the last subcommand that
# needed it. Same contract: emit + compile with debug info, exe named after the stem
# under .zig-cache/zbr-debug/ (was the cwd until 2026-09-09), lldb-dap on stdio, coordinates translated by dbgTransform
# in both directions, everything else forwarded byte for byte. Single-threaded: both
# pipes are polled without blocking (sys.readStdinAvailable / proc.readAvailable),
# which is also what makes it free of the read-ahead defect the Zig relay had (BUG-349).
#
# Not ported: `--listen PORT` (TCP mode) -- retired with the bootstrap 2026-09-15; the flag is refused. That
# binary exists, and says so otherwise.

# Split complete `Content-Length` frames off the front of `buf`; the unconsumed tail
# is returned in the last element (so callers do `rest = frames.at(frames.len - 1)`).
def dbgTakeFrames(buf: str): List(str)
    var out: List(str) = List(str)()
    var b: str = buf
    while true
        var hdr_end: int = b.indexOf("\r\n\r\n")
        if hdr_end < 0
            break
        var header: str = b[0..hdr_end]
        var content_len: int = -1
        for h in header.split("\r\n")
            if h.startsWith("Content-Length:")
                content_len = h[15..h.len].trim().toInt()
        if content_len < 0
            b = b[hdr_end + 4..b.len]
            continue
        var body_start: int = hdr_end + 4
        if b.len < body_start + content_len
            break
        out.add(b[body_start..body_start + content_len])
        b = b[body_start + content_len..b.len]
    out.add(b)
    return out

def dbgFrame(body: str): str
    return "Content-Length: " + body.len.toString() + "\r\n\r\n" + body

def dbgIsWindows(): bool
    # Comptime, like the macOS test beside it. It used to read the OS / SystemRoot
    # environment variables, and under Git Bash on torial one of them was absent, so
    # `--shared` wrote `libgreeter.so` ON WINDOWS and the dynlib gate failed the first
    # --daily that ran it there (2026-09-10). The target is a property of the binary,
    # not of the environment it happens to run in.
    return zig"builtin.os.tag == .windows"

# lldb-dap (or the older lldb-vscode) must be on PATH; try each name by spawning.
def dbgFindLldb(): str
    var names: List(str) = List(str)()
    if dbgIsWindows()
        names.add("lldb-dap.exe")
        names.add("lldb-vscode.exe")
    else
        names.add("lldb-dap")
        names.add("lldb-vscode")
    for n in names
        var argv: List(str) = List(str)()
        argv.add(n)
        argv.add("--help")
        var r = sys.run(argv)
        if r.exit_code == 0 or r.exit_code == 1
            return n
    return ""

def dbgRunSession(path: str, cpu_flag: str): int
    var zig_opt = dbgResolveZig(path, "session")
    if zig_opt == nil
        return 1
    var zig_path: str = zig_opt!
    var markers: List(DbgMarker) = dbgLoadMarkers(File.read(zig_path))
    sys.errln("zebra debug: source map built (" + markers.len.toString() + " markers)")

    # 2. compile with debug info; the exe lands in the cwd named after the stem
    var stem: str = dbgNormSep(path)
    var si: int = stem.lastIndexOf("/")
    if si >= 0
        stem = stem[si + 1..stem.len]
    if stem.endsWith(".zbr")
        stem = stem[0..stem.len - 4]
    # The debug binary lives under .zig-cache/zbr-debug/ (beside the emitted .zig in
    # .zig-cache/zbr-dumpmap/), NOT in the cwd. It used to land in the cwd named after
    # the stem, which is how 134 fixture executables and their .pdb files accumulated
    # in the repo root (2026-09-09). Clients: zebra-ide computes the same path; the
    # relay also prints it, so a launch.json can be pointed at it.
    var dbg_dir: str = ".zig-cache/zbr-debug"
    Dir.createAll(dbg_dir)
    var exe: str = dbg_dir + "/" + stem
    if dbgIsWindows()
        exe = exe + ".exe"
    sys.errln("zebra debug: compiling '" + path + "' -> " + exe + " ...")
    var zargv: List(str) = List(str)()
    zargv.add(zigExe())
    zargv.add("build-exe")
    zargv.add(zig_path)
    zargv.add("-femit-bin=" + exe)
    zargv.add("-lc")
    if cpu_flag != ""
        zargv.add("-mcpu=" + cpu_flag)
    var zr = sys.run(zargv)
    if zr.stderr != ""
        sys.err(zr.stderr)
    if zr.exit_code != 0
        sys.errln("zebra debug: compile failed (exit " + zr.exit_code.toString() + ")")
        return 1

    # 3. lldb-dap
    var lldb: str = dbgFindLldb()
    if lldb == ""
        sys.errln("zebra debug: lldb-dap not found on PATH.")
        sys.errln("  Windows : winget install LLVM.LLVM  (then add <LLVM>\\bin to PATH)")
        sys.errln("  Ubuntu  : sudo apt install lldb")
        sys.errln("  macOS   : brew install llvm  OR  xcode-select --install")
        return 1
    sys.errln("zebra debug: using " + lldb)
    if dbgIsWindows()
        sys.setenv("LLDB_DISABLE_PYTHON", "1")
    var largv: List(str) = List(str)()
    largv.add(lldb)
    var p = sys.spawnPiped(largv)
    if not p.isRunning()
        sys.errln("zebra debug: could not start " + lldb)
        return 1

    # 4. relay until lldb-dap exits (it does after `disconnect`)
    var zig_abs: str = zig_path
    if not (zig_abs.startsWith("/") or (zig_abs.len > 1 and zig_abs[1..2] == ":"))
        zig_abs = dbgNormSep(sys.cwd()) + "/" + dbgNormSep(zig_abs)
    var in_buf: str = ""
    var out_buf: str = ""
    var idle: int = 0
    var hung_up: bool = false
    while p.isRunning()
        var busy: bool = false
        var a: str = sys.readStdinAvailable()
        if a != ""
            busy = true
            in_buf = in_buf + a
            var fr: List(str) = dbgTakeFrames(in_buf)
            in_buf = fr.at(fr.len - 1)
            var i: int = 0
            while i < fr.len - 1
                p.write(dbgFrame(dbgTransform(markers, fr.at(i), true, zig_abs)))
                i = i + 1
        var b: str = p.readAvailable()
        if b != ""
            busy = true
            out_buf = out_buf + b
            var fr2: List(str) = dbgTakeFrames(out_buf)
            out_buf = fr2.at(fr2.len - 1)
            var j: int = 0
            while j < fr2.len - 1
                sys.writeStdout(dbgFrame(dbgTransform(markers, fr2.at(j), false, zig_abs)))
                j = j + 1
        var e: str = p.readErrAvailable()
        if e != ""
            sys.err(e)
        if a == "" and sys.stdinClosed()
            # the IDE hung up: pass EOF on so lldb-dap exits the same way it would
            # have with a direct pipe, then drain what it says on the way out
            p.closeStdin()
            hung_up = true
            var grace: int = 0
            while p.isRunning() and grace < 40
                sys.sleep(50)
                grace = grace + 1
            if p.isRunning()
                p.kill()
        if busy
            idle = 0
        else
            idle = idle + 1
            if idle > 5
                sys.sleep(3)
    var tail: str = p.readAvailable()
    if tail != ""
        out_buf = out_buf + tail
        var fr3: List(str) = dbgTakeFrames(out_buf)
        var k: int = 0
        while k < fr3.len - 1
            sys.writeStdout(dbgFrame(dbgTransform(markers, fr3.at(k), false, zig_abs)))
            k = k + 1
    # lldb-dap 18 aborts (SIGABRT, 134) on stdin EOF after a disconnect; that is the
    # normal end of a session, not a relay failure, so a hang-up ends with 0.
    if hung_up
        return 0
    return p.exitCode()

# `zebra debug --dump-transform <file.zbr|file.zig> [--from-lldb]` -- read ONE DAP
# message as JSON on stdin, print what the relay would forward. It answers "why did my
# breakpoint land THERE?" one step further along than --dump-map does: the map says
# where a line goes, this says what the debugger is actually told.
def dbgDumpTransform(path: str, from_lldb: bool): int
    if dbgResolveZig(path, "--dump-transform") as zig_path
        var markers: List(DbgMarker) = dbgLoadMarkers(File.read(zig_path))
        var msg: str = ""
        while true
            var line = sys.readLine()
            if line == nil
                break
            msg = msg + line!
        if msg == ""
            sys.errln("zebra debug --dump-transform: no message on stdin")
            return 1
        print(dbgTransform(markers, msg, not from_lldb, zig_path))
        return 0
    return 1

def dbgDumpMap(path: str): int
    var zig_path: str = path
    if path.endsWith(".zbr")
        var out_dir: str = ".zig-cache/zbr-dumpmap"
        Dir.createAll(out_dir)
        var argv: List(str) = List(str)()
        argv.add(sys.selfExe())
        argv.add("--emit-zig")
        argv.add("--output-dir")
        argv.add(out_dir)
        argv.add(path)
        var r = sys.run(argv)
        if r.exit_code != 0
            sys.errln("zebra debug --dump-map: could not compile '" + path + "'")
            if r.stderr != ""
                sys.err(r.stderr)
            return 1
        var stem: str = path
        var si: int = stem.lastIndexOf("/")
        if si >= 0
            stem = stem.substring(si + 1, stem.len)
        var bi: int = stem.lastIndexOf("\\")
        if bi >= 0
            stem = stem.substring(bi + 1, stem.len)
        zig_path = out_dir + "/" + stem.substring(0, stem.len - 4) + ".zig"
    if not File.exists(zig_path)
        sys.errln("zebra debug --dump-map: no such file: " + zig_path)
        return 1

    var markers: List(DbgMarker) = dbgLoadMarkers(File.read(zig_path))
    var files: List(str) = List(str)()
    for m in markers
        var seen: bool = false
        for f in files
            if f == m.file
                seen = true
        if not seen
            files.add(m.file)

    print("zbr-map: " + markers.len.toString() + " markers, " + files.len.toString() + " files")
    print("zbr-map-source: " + zig_path)
    # Columns: zig_line, zbr_file, zbr_line, then the ROUND TRIP through the two
    # shipping lookups. A checker asserts rt_file/rt_line equal the input pair.
    print("# M\tzig_line\tzbr_file\tzbr_line\trt_zig\trt_file\trt_line")
    for m in markers
        var rt_zig: str = "-"
        var rt_file: str = "-"
        var rt_line: str = "-"
        if dbgZbrToZig(markers, m.file, m.zbr_line) as z
            rt_zig = z.toString()
            if dbgZigToZbr(markers, z) as back
                rt_file = back.file
                rt_line = back.zbr_line.toString()
        print("M\t" + m.zig_line.toString() + "\t" + m.file + "\t" + m.zbr_line.toString()
              + "\t" + rt_zig + "\t" + rt_file + "\t" + rt_line)
    return 0


# ── Toolchain resolution (release packaging, 2026-09-10) ─────────────────────────
# Zig is a RUNTIME dependency of the compiler (every program is emitted as Zig and
# built with `zig build-exe`), so a release zip bundles a pinned Zig next to the
# binary as `zig/`. Resolution order: $ZEBRA_ZIG (an explicit path), then the
# bundled sibling `<exe dir>/zig/zig[.exe]`, then a bare `zig` on PATH -- so a
# source build behaves exactly as before and a release build never depends on
# whatever `zig` the user happens to have. One function; every spawn site uses it
# (the six `argv.add("zig")` lines were the whole surface).
var _zig_exe_cache: str = ""
def zigExe(): str
    if _zig_exe_cache != ""
        return _zig_exe_cache
    var env_zig: str? = sys.getenv("ZEBRA_ZIG")
    if env_zig as ez
        if ez != ""
            _zig_exe_cache = ez
            return ez
    var d: str = Path.dirname(sys.selfExe())
    if d == ""
        d = "."
    if File.exists(d + "/zig/zig.exe")
        _zig_exe_cache = d + "/zig/zig.exe"
    else if File.exists(d + "/zig/zig")
        _zig_exe_cache = d + "/zig/zig"
    else
        _zig_exe_cache = "zig"
    return _zig_exe_cache

# The version banner's ONE source is `_zbr_version` in selfhost/stdlib_preamble.zig
# (the runtime every program carries); the release workflow refuses a tag that
# does not match it. The Zig version is the one this binary was built with.
def versionBanner(): str
    var v: str = zig"_zbr_version"
    var zv: str = zig"builtin.zig_version_string"
    return "zebra " + v + " (zig " + zv + ")"

def main()
    var args = Arg.parse()

    # BUG-323: an unrecognised flag used to be SILENTLY IGNORED, so a typo'd --turbo
    # handed you the opposite build with a successful-looking run. The repo already
    # has the receipt for that harm one step later in the pipeline: BUG-228 shipped
    # Debug from --release for four days under 19 green gates.
    #
    # The list is every flag this file actually consults. Case is NOT folded (Sean,
    # 2026-09-01): with unknown flags now refused, --TURBO becomes a NAMED ERROR
    # rather than either being ignored or silently starting to work -- the user sees
    # the problem instead of getting a build they did not ask for.
    var known_flags: str = "--allow-implicit-try --build-file --check --check-full --cpu --emit-zig --gui-backend --help --keep-temp --dump-map --dump-transform --from-lldb --library-mode --list --list-targets --module-path --no-runtime-module --only --out --output-dir --print --release --scaffold-only --selfhost-compile --shared --single-file --single-threaded --tag --target --to --turbo --version --warn-inference-guess --warn-non-exhaustive -c -h"
    var bad_flag: str = args.unknownFlag(known_flags)
    if bad_flag != ""
        sys.errln("zebra: unrecognized flag: " + bad_flag)
        sys.errln("")
        emitUsage(false)
        sys.exit(2)

    # -- Version -----------------------------------------------------------

    if args.contains("--version")
        # BUG-321: a version banner is an ANSWER to a question the user asked, so it
        # belongs on stdout. On stderr `zebra --version > v.txt` wrote an empty file.
        print(versionBanner())
        sys.exit(0)

    var cpu_flag: str = args.option("--cpu", "")

    # -- typecheck-merge subcommand ----------------------------------------

    if args.positional(0) as first_pos
        if first_pos == "typecheck-merge"
            if args.positional(1) as merge_file
                runTypecheckMerge(merge_file)?
                sys.exit(0)
            else
                sys.errln("usage: zebra typecheck-merge <file.zbr>")
                sys.exit(1)

    # -- types subcommand --------------------------------------------------
    # `zebra types <file.zbr>` — print inferred types for all local variable
    # declarations. Shows what the selfhost TC knows at each var/const site.

    if args.positional(0) as types_pos
        if types_pos == "types"
            if args.positional(1) as types_file
                runTypes(types_file)?
                sys.exit(0)
            else
                sys.errln("usage: zebra types <file.zbr>")
                sys.exit(1)

    # -- diagnostics subcommand (LSP seam) ---------------------------------
    # `zebra diagnostics <file.zbr>` — emit front-end diagnostics as JSON.

    if args.positional(0) as diag_pos
        if diag_pos == "diagnostics"
            if args.positional(1) as diag_file
                var diag_out: str = args.option("--out", "")
                runDiagnostics(diag_file, diag_out)?
                sys.exit(0)
            else
                sys.errln("usage: zebra diagnostics <file.zbr> [--out <file.json>]")
                sys.exit(1)

    # -- lsp subcommand ----------------------------------------------------
    # `zebra lsp` — run the Language Server over stdio (JSON-RPC).

    if args.positional(0) as lsp_pos
        if lsp_pos == "lsp"
            runLsp()
            sys.exit(0)

    # -- fmt subcommand ----------------------------------------------------
    # `zebra fmt <file.zbr>` — normalize source formatting in-place.
    # `zebra fmt --check <file.zbr>` — check without writing (CI).
    # `zebra fmt --print <file.zbr>` — print normalized output to stdout.

    if args.positional(0) as fmt_pos
        if fmt_pos == "fmt"
            var fmt_check: bool = args.contains("--check")
            var fmt_print: bool = args.contains("--print")
            if args.positional(1) as fmt_file
                runFmt(fmt_file, fmt_check, fmt_print)?
                sys.exit(0)
            else
                sys.errln("usage: zebra fmt [--check|--print] <file.zbr>")
                sys.exit(1)

    # -- up subcommand -----------------------------------------------------
    # `zebra up [--check] [--to VER]` — update the installed release.

    if args.positional(0) as up_pos
        if up_pos == "up"
            var up_check: bool = args.contains("--check")
            var up_to: str = args.option("--to", "")
            runUp(up_check, up_to)?
            sys.exit(0)

    # -- check subcommand --------------------------------------------------
    # `zebra check <file.zbr>` — dead code detection across all dep modules.
    # Reports dead union arms, phantom variants, and unreachable module-level fns.

    if args.positional(0) as chk_pos
        if chk_pos == "check"
            if args.positional(1) as chk_file
                var had_issues: bool = runCheck(chk_file)?
                if had_issues
                    sys.exit(1)
                sys.exit(0)
            else
                sys.errln("usage: zebra check <file.zbr>")
                sys.exit(1)

    # -- repl subcommand ---------------------------------------------------
    # `zebra repl` — interactive REPL, delegated to bootstrap binary which
    # contains src/Repl.zig.

    if args.positional(0) as repl_pos
        if repl_pos == "repl"
            # PORTED 2026-09-02. This used to delegate to zebra-bootstrap.exe; the REPL is now
            # native (replRun, further up this file). One of the three runtime jobs that kept
            # the bootstrap alive after criterion 4 removed its last GATE job.
            sys.exit(replRun())

    # `zebra build` carriers: set by the build subcommand below, consumed by the
    # source-path scan further down. The subcommand no longer exits -- it falls
    # through into the ordinary compile-and-run path with the build file as source.
    var build_subcmd: bool = false
    var build_src_file: str = ""

    # -- debug subcommand --------------------------------------------------
    # `zebra debug <file.zbr>` — the native DAP relay (dbgRunSession, ported off
    # src/Debugger.zig 2026-09-08), stdio only.

    if args.positional(0) as debug_pos
        if debug_pos == "debug"
            # --dump-map: print the .zbr <-> .zig provenance map and exit. Handled
            # before the relay so it needs neither lldb-dap nor a built binary.
            if args.contains("--dump-map") or args.contains("--dump-transform")
                var dm_target: str = args.option("--dump-map", "")
                if dm_target == ""
                    dm_target = args.option("--dump-transform", "")
                if dm_target == ""
                    var dmi: int = 1
                    while dmi < 10
                        var dp2 = args.positional(dmi)
                        if dp2 == nil
                            dmi = 10
                        else
                            var dpv2: str = dp2!
                            if dpv2.endsWith(".zbr") or dpv2.endsWith(".zig")
                                dm_target = dpv2
                                dmi = 10
                            else
                                dmi = dmi + 1
                if dm_target == ""
                    sys.errln("usage: zebra debug --dump-map <source.zbr|generated.zig>")
                    sys.exit(1)
                if args.contains("--dump-transform")
                    sys.exit(dbgDumpTransform(dm_target, args.contains("--from-lldb")))
                sys.exit(dbgDumpMap(dm_target))
            # Find the .zbr file
            var dbg_file: str? = nil
            var dpi: int = 1
            while dpi < 10
                var dp = args.positional(dpi)
                if dp == nil
                    break
                var dpv: str = dp!
                if dpv.endsWith(".zbr")
                    dbg_file = dpv
                    break
                dpi = dpi + 1
            if dbg_file as debug_file
                # stdio only. `--listen PORT` (TCP) delegated to the bootstrap and was
                # retired with it (bootstrap_sunset.md Step 1, 2026-09-15): it left
                # known_flags, so the BUG-323 unknown-flag refusal names it. zebra-ide
                # drives the relay over stdio.
                sys.exit(dbgRunSession(debug_file, cpu_flag))
            else
                sys.errln("usage: zebra debug <file.zbr>")
                sys.exit(1)

    # -- build subcommand --------------------------------------------------
    # `zebra build` compiles build.zbr (or --build-file=FILE) and runs it. Native
    # since 2026-09-04; it used to delegate to the bootstrap binary.

    if args.positional(0) as bld_pos
        if bld_pos == "build"
            # PORTED off the bootstrap 2026-09-04. `zebra build` was never a separate
            # pipeline: the bootstrap's whole implementation is "set the source path to
            # build.zbr and run it as an ordinary program", which this compiler already
            # does for any file.
            #
            # WHAT THE DELEGATION WAS REALLY CARRYING were two CODEGEN modes the selfhost
            # did not have, and BOTH fail silently with exit 0 -- measured, not reasoned:
            # without build mode a build file that never calls b.run() compiles, runs and
            # produces NOTHING (the bootstrap builds the target for identical source);
            # without list-targets mode `--list-targets` BUILDS instead of listing. See
            # CodeGen.setBuildMode / setListTargetsMode.
            build_subcmd = true
            var bld_file_opt: str = args.option("--build-file", "")
            if bld_file_opt != ""
                build_src_file = bld_file_opt
            else
                build_src_file = "build.zbr"
            if not File.exists(build_src_file)
                sys.errln("zebra build: no build file at '" + build_src_file + "'")
                sys.errln("  create build.zbr here, or pass --build-file=PATH")
                sys.exit(1)
            # BUG-327 layer 2: the generated build program must be TOLD where the compiler
            # is. It used to ask for its OWN executable path, which answers "where am I?"
            # when the question is "where is the compiler?" -- so it re-invoked itself
            # forever. We know the answer here and the child inherits our environment.
            # An installer can set the same variable.
            sys.setenv("ZEBRA_COMPILER", sys.selfExe())
            setBuildMode(true)
            if args.contains("--list-targets")
                setListTargetsMode(true)

    # -- test subcommand ---------------------------------------------------
    # `zebra test <file.zbr>` discovers def test_*() and runs them.

    var run_test_mode: bool = false
    if args.positional(0) as test_pos
        if test_pos == "test"
            run_test_mode = true

    var run_tag_filter: str? = nil
    if args.contains("--tag")
        var tag_val: str = args.option("--tag", "")
        if tag_val != ""
            run_tag_filter = tag_val
    # `--only a,b` (run a subset by label) and `--list` (print what would run, no
    # build). Both exist for zebra-ide's tests pane (2026-09-09): discovery must come
    # from the harness's own rule rather than a grep, and "re-run the failed ones"
    # must not rebuild-and-run the whole file.
    var run_test_list: bool = run_test_mode and args.contains("--list")
    if run_test_mode and args.contains("--only")
        var only_val: str = args.option("--only", "")
        if only_val != ""
            setTestOnly(only_val)

    # -- Source path -------------------------------------------------------
    # BUG-347: `zebra prog.zbr -- a b` forwards `a b` to the program (compile-and-run
    # had no passthrough at all; `zebra src/gates.zbr manifest.json` could not see its
    # manifest). Everything after a literal `--` is the program's; the compiler never
    # looks at it (ArgResult.unknownFlag stops there too).
    var prog_args: List(str) = List(str)()
    var raw_args: List(str) = sys.args()
    var seen_dashdash: bool = false
    for ra in raw_args
        if seen_dashdash
            prog_args.add(ra)
        else if ra == "--"
            seen_dashdash = true
    # Scan positionals for the .zbr file (skip option values like --output-dir DIR)

    var src_path: str? = nil
    var pi: int = 0
    while pi < 10
        var candidate = args.positional(pi)
        if candidate == nil
            break
        var cval: str = candidate!
        if cval.endsWith(".zbr") or cval.endsWith(".cobra")
            src_path = cval
            break
        pi = pi + 1
    # `zebra build` supplies its own source: the positional is "build", not a .zbr,
    # so the scan above finds nothing and this is what makes the subcommand resolve.
    if src_path == nil and build_subcmd
        src_path = build_src_file

    if src_path == nil
        # BUG-321: `--help` was never a recognised flag -- it fell through to this
        # "no source file" path, so `zebra --help` printed usage to STDERR and exited 1.
        # `zebra --help | less` therefore showed nothing, which is among the first three
        # things anyone tries on an unfamiliar compiler.
        #
        # ASKED-FOR usage goes to STDOUT and exits 0; usage shown BECAUSE the invocation
        # was wrong stays on STDERR and exits non-zero. Same text, two situations, and
        # conflating them is what made it unpipeable.
        var help_mode: bool = args.contains("--help") or args.contains("-h")
        emitUsage(help_mode)
        if help_mode
            sys.exit(0)
        sys.exit(1)

    var path = src_path!

    # -- Validate file exists ----------------------------------------------

    if not File.exists(path)
        sys.errln("zebra: source file not found: '" + path + "'")
        sys.exit(1)

    # -- `zebra test --list FILE`: front end only, one `label<TAB>line` per test ------
    if run_test_list
        runTestList(path, run_tag_filter)
        sys.exit(0)

    # -- Pipeline selection ------------------------------------------------

    var mode_c               = args.contains("-c")
    # #4 (strategy decided 2026-07-29): `-c` is FRONT-END ONLY. It runs lex, resolve,
    # type-check and codegen, then stops — it does NOT invoke zig. That is the whole
    # point: a check the front end can answer costs ~60 ms instead of ~810 ms, and the
    # IDE Check button is the dominant caller.
    #
    # `--check-full` keeps the old behaviour (emit, then `zig build-exe -fno-emit-bin`).
    #
    # THE ASYMMETRY IS REAL AND MUST STAY DOCUMENTED. A fast check can pass on a program
    # that `zebra run` then fails to build, because some errors only `zig` can see.
    # Demonstrated by `test/witness_zig_backend_literal.zbr`, whose asymmetry is PERMANENT:
    # a `zig"…"` backend literal is passed through to the emitted Zig UNPARSED by design, so
    # the front end cannot judge it even in principle. `tools/check_mode_check.sh` gates
    # exactly that, so the claim cannot quietly stop being true.
    #
    # This comment used to name three BUG FIXTURES instead. Two of them were not evidence of
    # a limit at all — the bootstrap rejects bug099_unresolved_test and
    # bug106_heterogeneous_list_test, so a Zebra front end demonstrably CAN catch them and
    # the selfhost had merely not been given the checks. Citing missing features as proof of
    # a boundary is circular. BUG-106's check was ported 2026-08-04; BUG-099's is BUG-252. A check whose limits are undocumented is the same
    # class of problem as a gate that cannot fail.
    var check_full           = args.contains("--check-full")
    var mode_emit            = args.contains("--emit-zig")
    var mode_shared          = args.contains("--shared")   # BUG-356 leg 1
    var release              = args.contains("--release")
    # BUG-244: `zebra <file>` built an executable into TMPDIR and never removed it.
    # ~20 MB per run, 6,413 files / 120 GB observed on Sean's machine, and a single
    # `selfhost_smoke.sh` run leaks ~5.7 GB because 285 fixtures take this path.
    # Verified it is NOT a cache before deleting anything: the binary's mtime changes
    # on every run, so it is re-linked each time and nothing is ever reused.
    var keep_temp            = args.contains("--keep-temp")
    # A GUI gate needs the scaffold, not a build: on Windows with the bindings fetchable,
    # `zig build run` LAUNCHED the app and the first --daily sat behind a window (2026-09-10).
    var scaffold_only        = args.contains("--scaffold-only")
    var turbo                = args.contains("--turbo")
    var lib_mode             = args.contains("--library-mode")
    # §28j: --single-threaded — the program commits to spawning NO threads (no
    # ThreadPool/sys.go/Chan across threads). Compiles with -fsingle-threaded, which makes
    # `builtin.single_threaded` true so the program allocator's mutex wrapper compiles out
    # (bare arena). Using threads under this flag is UB; the default is thread-safe.
    var single_threaded      = args.contains("--single-threaded")
    # --single-file: emit the user region inside one `const _Mod = struct {…}` with a
    # single file-scope preamble (closes F5).  Currently single-module only (Phase 2 =
    # multi-module merge).  See docs/single_file_emit_design.md §7a.
    if args.contains("--single-file")
        setSingleFile(true)
    # Runtime-module emission: write the runtime ONCE as zebra_rt.zig beside the
    # program and `@import` it, instead of splicing 3,767 lines into every emitted
    # file.  DEFAULT ON since 2026-07-28; `--no-runtime-module` restores the inline
    # runtime.  `--runtime-module` is still accepted as an explicit no-op so existing
    # scripts and the gates keep working.  See docs/runtime_module_design.md.
    var runtime_module = not args.contains("--no-runtime-module")
    # --single-file also restructures file scope, and the combination has no tested
    # meaning.  Now that runtime-module is the default, this is a silent fallback
    # rather than an error: --single-file is an explicit request, so honour it and
    # drop the default rather than refusing a flag the user did pass.
    if runtime_module and args.contains("--single-file")
        runtime_module = false
    # §28c (revised 2026-07-21): the else-catches-unnamed-variants WARNING is now
    # OFF by default (it was noisy — N warnings per else branch); opt in with
    # --warn-non-exhaustive.  --no-warn-non-exhaustive is kept as an accepted no-op.
    # The hard exhaustiveness ERROR (no else + missing variant) is unaffected.
    var warn_ne              = args.contains("--warn-non-exhaustive")
    var gui_backend: str     = args.option("--gui-backend", "")
    # --gui-backend=tui|libui_ng are emitted+scaffolded by this compiler; no flag is the
    # stub backend (prints to stderr, for tests), and `--gui-backend=stub` is the same
    # thing said explicitly. `glfw` (and the explicit `stub` spelling) used to delegate
    # to the bootstrap; the delegation went with it (bootstrap_sunset.md Step 1,
    # 2026-09-15), so glfw is refused by name and stub is handled here.
    if gui_backend == "stub"
        gui_backend = ""
    var has_gui              = gui_backend != ""
    var gui_selfhost         = gui_backend == "tui" or gui_backend == "libui_ng"
    if has_gui and not gui_selfhost
        sys.errln("zebra: --gui-backend=" + gui_backend + " is not a backend; tui and libui_ng are, and stub (or no flag) is the test backend. glfw was retired with the bootstrap, 2026-09-15")
        sys.exit(2)
    setGuiBackend(gui_backend)
    # --target node-addon: compile to a Node.js native addon (.node + .js + .d.ts)
    var target_opt: str      = args.option("--target", "")
    var mode_node            = target_opt == "node-addon" or target_opt == "node_addon"
    # node-addon emits N-API glue at file scope and is built by a separate driver that
    # would also have to learn to place zebra_rt.zig, so it FALLS BACK to the inline
    # runtime silently. (GUI backends used to as well; see below.)
    #
    # This has to be a fallback, not an error, now that runtime-module is the default:
    # refusing here would mean `--gui-backend=tui` and `--target node-addon` simply stop
    # working, which is a far worse outcome than emitting the shape they emitted
    # yesterday. Covering them is tracked in NEXT_STEPS under #1.
    # GUI backends: covered since 2026-09-08 — the section is pub-marked into
    # zebra_rt.zig (rtPubMarkSection) and copyGuiDeps carries it into the project,
    # so a GUI program's modules share ONE runtime and ONE section (BUG-355/357).
    if runtime_module and mode_node
        runtime_module = false
    setRuntimeModule(runtime_module)
    # Preamble resolution (BUG: cwd-dependent File.read).  Prefer the repo-relative
    # path so every gate (all run from the repo root) is byte-identical; fall back to
    # a copy installed alongside the exe so `zebra.exe` works when invoked from any
    # directory — mirrors the sqlite3.c exe-dir pattern below.  The bootstrap embeds
    # the preamble via build_options; this brings the selfhost to the same "runs
    # anywhere" behaviour without embedding.
    var preamble_path        = defaultPreamblePath()
    # GUI-via-selfhost: for tui/libui_ng, load the matching backend section (lives
    # next to the preamble) so codegen can substitute it for the stub (see
    # CodeGen.guiSelectPreamble).
    if gui_selfhost
        var sec_file: str = "gui_tui_section.zig"
        if gui_backend == "libui_ng"
            sec_file = "gui_libui_ng_section.zig"
        var gui_sec_path: str = preamble_path.replace("stdlib_preamble.zig", sec_file)
        if not File.exists(gui_sec_path)
            sys.errln("zebra: " + sec_file + " not found next to the preamble (" + gui_sec_path + ")")
            sys.exit(1)
        setGuiSection(File.read(gui_sec_path))
    # --output-dir=DIR style to avoid positional arg confusion
    var output_dir: str    = args.option("--output-dir", "")
    # BUG-282: the directory was never checked, so a path that did not exist reached
    # File.write and PANICKED — `thread NNNNN panic: File.write error`, empty stack
    # trace, AFTER `parsed OK` / `resolved OK`. Every part of that points the reader at
    # their PROGRAM, which is the one place the fault is not.
    #
    # CREATED rather than refused, and then ANNOUNCED. The ticket framed this as
    # create-or-refuse and both beat a panic, but each alone fails one half of UNGIT:
    # refusing is pure friction when the fix is a `mkdir` the tool could have done
    # (a refusal that can be worked around must price the workaround), while creating
    # silently means a typo'd `--output-dir /tmp/oputput` quietly builds a junk tree and
    # says nothing. Creating AND saying so costs the user nothing and hides nothing —
    # a mistyped path is visible on the line that reports it.
    #
    # Checked HERE, at argument-parsing time, not at first write: the flag is known at
    # startup, so "declarations are checked when declared" rather than discovered broken
    # three phases later.
    if output_dir != "" and not Dir.exists(output_dir)
        Dir.createAll(output_dir)
        if Dir.exists(output_dir)
            sys.errln("zebra: created output directory " + output_dir)
        else
            sys.errln("zebra: --output-dir " + output_dir +
                      " does not exist and could not be created — check the path and permissions")
            sys.exit(1)
    # --module-path DIR: extra search dir for `use` deps not adjacent to the
    # source (e.g. an engine's zbra/ next to game/scripts/).  Found deps are
    # parsed for types only, not emitted — BUG-125.
    var module_path: str   = args.option("--module-path", "")

    # ── Selfhost pipeline (the only pipeline since 2026-09-15; --zig-backend is gone) ──
    # ── Selfhost pipeline: Lex → Resolve → Parse → ASTBuilder → CodeGen ──
    # Multi-file: discovers dependencies via `use` decls, compiles each to .zig.
    # Compile the root file and all its dependencies
    var mc = MultiCompiler(preamble_path, output_dir)
    mc.strip_contracts = turbo
    mc.library_mode = lib_mode
    mc.test_mode = run_test_mode
    mc.tag_filter = run_tag_filter
    mc.warn_non_exhaustive = warn_ne
    mc.module_path = module_path
    mc.node_addon = mode_node
    mc.compileDep(path, true)?
    # BUG-295 (b): after the whole graph is known, name the shared STATEFUL modules.
    mc.reportSharedStatefulModules()

    # §28b step 5 (the flip): reject implicit error propagation (a throws call
    # the user did not mark with `?`) unless --allow-implicit-try.  compileDep
    # accumulated every auto-`try` site across deps + root; a valid `try` was
    # still emitted, so this is a clean driver rejection.
    if not args.contains("--allow-implicit-try")
        var itry_sites: List(str) = implicitTrySites()
        if itry_sites.len > 0
            for itry_site in itry_sites
                sys.errln(itry_site + ": error: throws call needs '?' (auto error-propagation was removed; add '?', or pass --allow-implicit-try)")
            sys.exit(1)

    # §28a step 1 (selfhost measure): --warn-inference-guess reports every
    # type-dispatch site that guessed the emit without a proven type (numeric
    # add / len fallback / name-based List routing).  Measure mode — reports to
    # stderr, no exit.  compileDep accumulated the sites across deps + root.
    # The flip (guess → compile error, gated by --allow-inference-guess) follows
    # the §28b template above.
    if args.contains("--warn-inference-guess")
        var ig_sites: List(str) = inferenceGuessSites()
        for ig_site in ig_sites
            sys.errln("INFER_GUESS: " + ig_site)

    if mode_emit
        # --emit-zig: print(root file's Zig source to stdout)
        var zig_path: str = mc.zbrToZig(path)
        var zig_src: str = File.read(zig_path)
        print(zig_src)
        # BUG-325 (selfhost half): the root of a MULTI-MODULE program imports its
        # dependencies' .zig files, and stdout carries only the root -- so the text
        # a reader captured cannot build on its own, and nothing said so. Say so.
        # (`visited` is every module compiled, root included; the runtime module is
        # written beside the root, not through stdout, so it counts too.)
        var em_deps: int = 0
        for vm in mc.visited
            if vm != path
                em_deps += 1
        if em_deps > 0
            sys.errln("note: " + em_deps.toString() + " dependency module(s) were compiled with the root, and `--emit-zig` prints only the root -- use `--output-dir DIR` to get every .zig this program needs")
        sys.exit(0)

    if mode_shared
        # --shared: emit, then `zig build-lib -dynamic` the root module into a shared
        # library NEXT TO THE SOURCE (like node-addon's .node). The library links libc
        # like every other build; a Zebra host that loads it must too (BUG-356 leg 4).
        var sh_zig: str = mc.zbrToZig(path)
        var sh_dir: str = Path.dirname(path)
        if sh_dir == ""
            sh_dir = "."
        var sh_stem: str = Path.basename(path)
        if sh_stem.endsWith(".zbr")
            sh_stem = sh_stem[0 .. sh_stem.len - 4]
        var sh_out: str = sh_dir + "/lib" + sh_stem + ".so"
        if dbgIsWindows()
            sh_out = sh_dir + "/" + sh_stem + ".dll"
        else if zig"builtin.os.tag == .macos"
            sh_out = sh_dir + "/lib" + sh_stem + ".dylib"
        var sargv = List(str)()
        sargv.add(zigExe())
        sargv.add("build-lib")
        sargv.add(sh_zig)
        sargv.add("-dynamic")
        sargv.add("-lc")
        sargv.add("--name")
        sargv.add(sh_stem)
        sargv.add("-femit-bin=" + sh_out)
        if release
            sargv.add("-OReleaseFast")
        if cpu_flag != ""
            sargv.add("-mcpu=" + cpu_flag)
        var sr = sys.run(sargv)
        if sr.stdout != ""
            Terminal.write(sr.stdout, "")
        if sr.stderr != ""
            sys.err(remapZigErrors(sr.stderr, sh_zig))
        if sr.exit_code != 0
            sys.exit(1)
        sys.errln("wrote " + sh_out)
        sys.exit(0)

    if mode_node
        # node-addon: compileDep wrote <stem>.zig (+ .js + .d.ts); build the
        # loadable .node via `zig build-lib -dynamic` against the Node headers.
        var na_zig: str = mc.zbrToZig(path)   # intermediate .zig (temp dir)
        # Output .node next to the SOURCE (matching the .js/.d.ts written above).
        var na_stem: str = path
        if na_stem.endsWith(".zbr")
            for s in path.split(".zbr")
                na_stem = s
                break
        if resolveNodeApi() as api
            var nargv = List(str)()
            nargv.add(zigExe())
            nargv.add("build-lib")
            nargv.add(na_zig)
            nargv.add("-dynamic")
            nargv.add("-lc")
            nargv.add("-I" + api.include)
            if api.lib != ""
                nargv.add(api.lib)
            # Phase 10 cross-platform N-API symbol resolution: Windows links
            # node.lib (above); Linux allows undefined `.so` symbols by default
            # (resolveNodeApi returns no lib); macOS needs `-undefined
            # dynamic_lookup` so ld64 defers the N-API symbols to load time.
            # `builtin` is in scope in the emitted main.zig.
            var na_is_macos: bool = zig"builtin.os.tag == .macos"
            if na_is_macos
                nargv.add("-Wl,-undefined,dynamic_lookup")
            nargv.add("-femit-bin=" + na_stem + ".node")
            if release
                nargv.add("-OReleaseFast")
            if cpu_flag != ""
                nargv.add("-mcpu=" + cpu_flag)
            var nr = sys.run(nargv)
            if nr.stdout != ""
                Terminal.write(nr.stdout, "")
            if nr.stderr != ""
                sys.err(remapZigErrors(nr.stderr, na_zig))
            if nr.exit_code != 0
                sys.exit(1)
            sys.errln("wrote " + na_stem + ".node")
            sys.exit(0)
        else
            sys.errln("zebra: could not find the Node.js N-API headers.")
            sys.errln("  Fetch them once with:   npx --yes node-gyp install")
            sys.errln("  Or set ZEBRA_NODE_INCLUDE=<path-to>/include/node (and, on Windows, ZEBRA_NODE_LIB=<path-to>/node.lib)")
            sys.exit(1)

    # --selfhost-compile: invoke zig to compile/run the generated file
    var zig_path: str = mc.zbrToZig(path)

    # #4: fast check mode. Everything the front end can answer has been answered by
    # now — parse, resolve, type-check and codegen all ran, and any diagnostic they
    # produce has already been reported and exited. Emission also stays IN the fast
    # path deliberately: it is cheap next to zig and it is what catches a codegen
    # crash, so skipping it would trade real coverage for a few milliseconds.
    # What is skipped is only the `zig build-exe` invocation below.
    if mode_c and not check_full
        sys.exit(0)

    # GUI-via-selfhost: tui/libui_ng wrap the emitted zig (already using the
    # chosen backend via guiSelectPreamble) in a minimal `zig build` project
    # with the backend's dependency, then build/run it. Replaces the old
    # delegate-to-bootstrap path.
    if gui_selfhost
        var grc: int = compileGuiProject(zig_path, not mode_c, gui_backend, scaffold_only, prog_args)
        if grc != 0
            sys.exit(1)
        sys.exit(0)

    # Debug fast path (run mode, no C deps): build a temp exe with Zig's
    # self-hosted x86_64 backend + self-hosted linker (-fno-llvm -fno-lld),
    # then execute it.  ~3x faster than LLVM+LLD for the compile-run dev loop.
    # Skipped when C deps are present: the self-hosted linker does not error on
    # unresolved C/libc symbols (it emits a crashing exe), so compile-failure
    # fallback can't protect those.  A pure-Zig backend gap is a real compile
    # error, so falling through to the LLVM path below stays safe.
    # CHECK MODE joins the fast path too (2026-07-28).  `-c` used to be excluded
    # here and fell through to LLVM+LLD, so *checking* a program cost ~4 s while
    # *running* it cost ~0.7 s — the compiler's most latency-sensitive command,
    # and the one the IDE Check button calls, took the slowest available route.
    # The same compile-failure fallback protects it: if the self-hosted backend
    # cannot build the program we fall through to the authoritative LLVM path
    # below, so a backend gap can never be reported as a user error.
    #
    # A check also needs no BINARY, only the semantic analysis that produces the
    # diagnostics, so it passes `-fno-emit-bin` and skips linking entirely —
    # measured as most of the cost (LLVM: 6.2 s with a binary vs 0.96 s without).
    # Verified that `-fno-emit-bin` reports the identical diagnostics.
    # BUG-265: `emittedExtern()` and `lib_sources` join the exclusions here.
    #
    # The self-hosted backend does not resolve a DLL import correctly: it COMPILES
    # CLEANLY and emits a binary that faults at the foreign call. The comment above
    # justifies this fast path on the premise that "a pure-Zig backend gap is a real
    # compile error, so falling through to the LLVM path stays safe" -- which is
    # exactly the premise this case breaks, so the fallback never fires. Measured:
    # `zig build-exe a.zig` works, `zig build-exe a.zig -fno-llvm -fno-lld` segfaults,
    # on identical source. Any program declaring a foreign symbol therefore takes the
    # authoritative LLVM path; everything else keeps the ~6x faster backend.
    # BUG-356: DynLib.open needs libc (dlopen); the fast path links none.
    if not release and mc.c_sources.len == 0 and mc.lib_sources.len == 0 and not mc.uses_sqlite and not emittedExtern() and not emittedDynLib()
        var fast_exe: str = zig_path + ".fast.exe"
        var fargv = List(str)()
        fargv.add(zigExe())
        fargv.add("build-exe")
        fargv.add(zig_path)
        fargv.add("-fno-llvm")
        fargv.add("-fno-lld")
        if mode_c
            fargv.add("-fno-emit-bin")
        else
            fargv.add("-femit-bin=" + fast_exe)
        if single_threaded
            fargv.add("-fsingle-threaded")
        if cpu_flag != ""
            fargv.add("-mcpu=" + cpu_flag)
        var fr = sys.run(fargv)
        if fr.exit_code == 0
            # Check mode: a clean compile IS the answer; nothing to execute.
            if mode_c
                if fr.stderr != ""
                    sys.err(remapZigErrors(fr.stderr, zig_path))
                sys.exit(0)
            # Run the compiled program with INHERITED stdio, not captured.
            # sys.run() pipes the child's stdout/stderr; the reader blocks once
            # the OS pipe buffer (~4 KB) fills, hanging any program that prints
            # more than a few KB (BUG-208). Inheriting streams output live and
            # never blocks — matching the bootstrap's run path (src/main.zig).
            var rargv = List(str)()
            rargv.add(fast_exe)
            for pa in prog_args
                rargv.add(pa)
            # A program run by the compiler can ask for the compiler (`zebra lsp`,
            # `zebra build`, a nested compile) the same way a `zebra build` program
            # can (BUG-327 layer 2): the child inherits ZEBRA_COMPILER. Set only if
            # the environment does not already name one (an installer may).
            if sys.getenv("ZEBRA_COMPILER") == nil
                sys.setenv("ZEBRA_COMPILER", sys.selfExe())
            var rc: int = sys.exec_inherit(rargv)
            # BUG-244: remove the scratch build ONLY on a clean exit. If the program
            # failed, the emitted .zig IS the debugging evidence and deleting it would
            # take away the one thing worth looking at. The BINARY is not evidence --
            # `zig build-exe <the .zig>` reproduces it in one command -- so it goes
            # either way. (Changed 2026-08-23; the old policy kept the binary too and
            # cost ~20 MB per failing run.)
            # `--keep-temp` opts out entirely.
            # ...and ONLY when the output is scratch. `--output-dir` means "put the
            # output HERE", so deleting it there destroys what the user asked for.
            # Caught by contract_mode_check, which runs `--turbo --output-dir DIR`
            # and then reads the .zig: its two --turbo legs went blind because
            # stripped contracts make the program EXIT 0, which is exactly the
            # branch that deletes. The passing legs were passing only because their
            # contracts fired and the non-zero exit kept the files.
            # NOT gated on rc: see the note above. The executable goes either way.
            if not keep_temp and output_dir == ""
                deleteScratch(fast_exe)                 # BUG-300
                # The DEBUG-INFO sibling. Measured 2026-08-23: 435 `.pdb` files
                # totalling 1.4 GB in %TEMP% -- a bigger leak than the executables
                # BUG-300 is named after, at a 100% rate rather than a transient one,
                # because no call site existed. The fast path does not normally emit
                # one (-fno-llvm), so this is a no-op there and costs one File.exists.
                deleteScratch(zig_path + ".fast.pdb")
                # The EMITTED SOURCE is the diagnostic artifact, so it -- and only it --
                # survives a failure.
                if rc == 0
                    deleteScratch(zig_path)
            if rc != 0
                sys.exit(1)
            sys.exit(0)

    var argv2 = List(str)()
    argv2.add(zigExe())
    # Non-`-c` run: build an exe (capturing only the small compile output for
    # error remapping), then run it with INHERITED stdio below. Using `zig run`
    # + sys.run() captured the *program's* output through a pipe that blocks at
    # ~4 KB (BUG-208). Mirrors src/main.zig (pipe the compile, inherit the run).
    var llvm_exe: str = zig_path + ".run.exe"
    if mode_c
        argv2.add("build-exe")
        argv2.add(zig_path)
        # A check needs diagnostics, not an executable.  Skipping the link step
        # is most of the cost (6.2 s -> 0.96 s on a hello-world) and reports the
        # identical errors, since they come from semantic analysis.
        argv2.add("-fno-emit-bin")
        if release
            argv2.add("-OReleaseFast")
    else
        argv2.add("build-exe")
        argv2.add(zig_path)
        argv2.add("-femit-bin=" + llvm_exe)
        # BUG-228. THIS is the branch that actually emits an executable, and it was the
        # only one of the three `release` consumers that never passed an optimize flag —
        # so `zebra --release` switched to LLVM (20 MB -> 2 MB, a real change) while Zig
        # silently defaulted to **Debug**. Anyone shipping with the flag shipped an
        # unoptimised build believing otherwise, which is the flag's entire purpose.
        # The sibling `mode_c` branch above already had it; that one emits no binary.
        #
        # ReleaseFast rather than ReleaseSafe, per Sean's 2026-07-30 direction: make
        # ReleaseFast good enough that ReleaseSafe does not buy much, and settle the
        # question by A/B testing with users rather than by argument. That is the
        # Design-by-Contract position — contracts are checked in development and
        # stripped for release BECAUSE they established the property, so a release build
        # should not re-check at runtime what the contracts already proved.
        #
        # ORDERING WAS LOAD-BEARING: this flag also turns on `unreachable`-is-UB, which
        # A4 removed on 2026-07-30. Adding it earlier would have converted an
        # unoptimised-but-safe build straight into an optimised one with UB on OOM.
        # `tools/lint_oom_unreachable.py` was confirmed clean (0 hazards) before this
        # line was written, and it stays in the QUICK tier to keep it that way.
        if release
            argv2.add("-OReleaseFast")
    if single_threaded
        argv2.add("-fsingle-threaded")

    # Append any C source files discovered during dep walk
    var csi: int = 0
    while csi < mc.c_sources.len
        argv2.add(mc.c_sources.at(csi))
        csi = csi + 1
    # BUG-266: prebuilt libraries are positional link inputs, same as the .c files
    # above -- zig distinguishes them by extension, so no flag is needed.
    var lsi: int = 0
    while lsi < mc.lib_sources.len
        argv2.add(mc.lib_sources.at(lsi))
        lsi = lsi + 1
    # -I flags for C deps that have a matching .h header
    var idi: int = 0
    while idi < mc.c_i_dirs.len
        argv2.add("-I" + mc.c_i_dirs.at(idi))
        idi = idi + 1
    # Append sqlite3.c when the program calls Sqlite.open/query
    if mc.uses_sqlite
        var self_exe_path: str = sys.selfExe()
        var exe_dir: str = Path.dirname(self_exe_path)
        if exe_dir == ""
            exe_dir = "."
        var sqlite_c: str = exe_dir + "/vendor/sqlite/sqlite3.c"
        if File.exists(sqlite_c)
            argv2.add(sqlite_c)
    # CPU target: pass -mcpu=VALUE when --cpu was specified
    if cpu_flag != ""
        argv2.add("-mcpu=" + cpu_flag)
    # Always link libc — the stdlib preamble requires it
    argv2.add("-lc")

    var r2 = sys.run(argv2)
    if r2.stdout != ""
        Terminal.write(r2.stdout, "")
    if r2.stderr != ""
        var remapped: str = remapZigErrors(r2.stderr, zig_path)
        sys.err(remapped)
    if r2.exit_code != 0
        # The compile FAILED, so the .zig stays for inspection -- but both candidate
        # binaries go. The fast path may already have produced a .fast.exe before
        # falling back here, and nothing used to remove it: a plain compile error
        # leaked ~20 MB, on the most ordinary failure a user can hit.
        # BUG-324: UNCONDITIONALLY -- `--output-dir` and `--keep-temp` keep the
        # .zig (the evidence), never a binary from a build that FAILED. Zig can leave
        # a stub at `-femit-bin` that segfaults with no output; anything reading the
        # directory instead of the exit code would find it and run it.
        deleteScratch(zig_path + ".fast.exe")
        deleteScratch(zig_path + ".fast.pdb")
        deleteScratch(llvm_exe)
        deleteScratch(zig_path + ".run.pdb")
        sys.exit(1)
    if not mode_c
        # Run the freshly built exe with inherited stdio — output streams live
        # and never blocks, no matter how much the program prints (BUG-208).
        var rargv2 = List(str)()
        rargv2.add(llvm_exe)
        for pa2 in prog_args
            rargv2.add(pa2)
        var rc2: int = sys.exec_inherit(rargv2)
        # BUG-244, same rule as the fast path above: clean on success, keep on
        # failure. This branch is taken by any program with a C dep, sqlite, an
        # extern, or --release, so leaving it out would fix only half the leak.
        if not keep_temp and output_dir == ""
            deleteScratch(llvm_exe)                     # BUG-300
            # THIS is the one that was leaking 1.4 GB: the LLVM path emits a .pdb
            # beside every executable and nothing ever removed it.
            deleteScratch(zig_path + ".run.pdb")
            if rc2 == 0
                deleteScratch(zig_path)
        if rc2 != 0
            sys.exit(1)
    sys.exit(0)

catch |e|
    sys.errln(e.message)
    sys.exit(1)

# ── Node.js N-API path discovery (--target node-addon) ───────────────────────

struct NodeApiPaths
    var include: str
    var lib: str          # "" when not needed/found (non-Windows links lazily)
    cue init(include: str, lib: str)
        .include = include
        .lib = lib

# Locate the Node headers (+ Windows node.lib).  ZEBRA_NODE_INCLUDE /
# ZEBRA_NODE_LIB override; else scan the node-gyp cache.  nil → not found.
def resolveNodeApi(): NodeApiPaths?
    var env_inc: str = ""
    if sys.getenv("ZEBRA_NODE_INCLUDE") as ei
        env_inc = ei
    var env_lib: str = ""
    if sys.getenv("ZEBRA_NODE_LIB") as el
        env_lib = el
    if env_inc != ""
        return NodeApiPaths(env_inc, env_lib)

    var base: str = ""
    if sys.getenv("LOCALAPPDATA") as la
        var lad: str = la                  # typed local: str-concat detection
        base = lad + "/node-gyp/Cache"
    else if sys.getenv("HOME") as ho
        var hod: str = ho
        base = hod + "/.cache/node-gyp"
    if base == "" or not Dir.exists(base)
        return nil

    # Pick the lexically-greatest version dir whose headers are present.
    var versions = List(str)()
    var entries = Dir.list(base)
    var ei: int = 0
    while ei < entries.len
        var entry: str = entries.at(ei)
        var hdr: str = base + "/" + entry + "/include/node/node_api.h"
        if File.exists(hdr)
            versions.add(entry)
        ei = ei + 1
    if versions.len == 0
        return nil
    versions.sort()
    var best: str = versions.at(versions.len - 1)

    var include: str = base + "/" + best + "/include/node"
    var lib: str = env_lib
    if lib == ""
        var cand: str = base + "/" + best + "/x64/node.lib"
        if File.exists(cand)
            lib = cand
    return NodeApiPaths(include, lib)

# ── Error remapping helpers ───────────────────────────────────────────────────

def pathBasename(p: str): str
    var last: str = p
    for part in p.split("/")
        last = part
    return last

# Walk backward from err_line (1-based) through zig_lines to find the
# nearest // zbr:filename:N marker. Returns "filename:N" or "".
def findZbrComment(zig_lines: List(str), err_line: int): str
    if err_line <= 0 or zig_lines.len == 0
        return ""
    var i: int = err_line - 1
    if i >= zig_lines.len
        i = zig_lines.len - 1
    while i >= 0
        var line: str = zig_lines.at(i)
        var trimmed: str = line.trimLeft()
        if trimmed.startsWith("// zbr:")
            var payload: str = ""
            var found_pfx: bool = false
            for seg in trimmed.split("// zbr:")
                if found_pfx
                    payload = seg
                    break
                found_pfx = true
            if payload != ""
                return payload
        i = i - 1
    return ""

# Remap Zig compiler error lines referencing zig_path back to Zebra
# source locations using // zbr: markers embedded in the generated file.
# Lines that cannot be remapped pass through unchanged.
# Context lines (indented source + caret) following a remapped error are
# suppressed since they show Zig internals the user never wrote.
# Rewrite Zig type spellings in a diagnostic message back to their Zebra names so
# a method/field-not-found error reads in Zebra terms (`str`, not `[]const u8`;
# `Foo`, not `module.Foo`) instead of leaking generated-code internals.
def humanizeZigTypes(msg: str, mod_name: str): str
    # BUG-410: the missing-`return` error, in the user's words.
    if "implicitly returns" in msg and "non-void return type" in msg
        var rt_name: str = msg
        var q1: int = rt_name.indexOf("'")
        if q1 >= 0
            rt_name = rt_name.substring(q1 + 1, rt_name.len)
            var q2: int = rt_name.indexOf("'")
            if q2 >= 0
                rt_name = rt_name.substring(0, q2)
        rt_name = humanizeZigTypes2(rt_name, mod_name)
        # Whole-name primitives: the user wrote `int`/`float`, never `i64`/`f64`.
        if rt_name == "i64"
            rt_name = "int"
        else if rt_name == "f64"
            rt_name = "float"
        else if rt_name == "?i64"
            rt_name = "int?"
        else if rt_name == "?f64"
            rt_name = "float?"
        else if rt_name == "?str"
            rt_name = "str?"
        return "error: this def is declared to return " + rt_name + " but can reach the end of its body without a `return` -- every path needs one"
    return humanizeZigTypes2(msg, mod_name)

def humanizeZigTypes2(msg: str, mod_name: str): str
    var m: str = msg
    m = m.replace("[]const u8", "str")
    m = m.replace("[]u8", "str")
    # BUG-281 B: a Zebra type emits as `_zbr_ty_<name>`, and Zig quotes that spelling
    # back in its own diagnostics — `no field named 'y' in struct '_zbr_ty_P'`.  The
    # user wrote `struct P` and has never seen the prefix, so showing it is the exact
    # generated-code leak this function exists to close.
    # NOT done here: `_zbr_fn_` and `_zbr_mv_`, which have leaked the same way since
    # BUG-220 / BUG-137.  Same one-line shape, but changing them would move messages
    # this change is not responsible for.
    m = m.replace("_zbr_ty_", "")
    if mod_name != ""
        m = m.replace(mod_name + ".", "")
    return m

def remapZigErrors(stderr_text: str, zig_path: str): str
    var zig_lines: List(str) = File.readLines(zig_path)
    var zig_base: str = pathBasename(zig_path)
    var mod_name: str = zig_base.replace(".zig", "")
    var stderr_lines: List(str) = List(str)()
    for sln in stderr_text.split("\n")
        stderr_lines.add(sln)
    var out: str = ""
    var skip_context: bool = false
    var li: int = 0
    while li < stderr_lines.len
        var line: str = stderr_lines.at(li)
        var emit_raw: bool = true
        if skip_context
            # Skip a suppressed diagnostic's trailing context (source line + caret,
            # which may be non-indented like `pub const P = struct {`) up to the
            # next blank line that separates Zig diagnostics.
            if line == ""
                skip_context = false
                emit_raw = false
            else
                emit_raw = false
        # Zig's "referenced by:" call-trace points only at std/runtime internals —
        # pure noise for a Zebra user. Suppress the whole block.
        if emit_raw and line.startsWith("referenced by:")
            skip_context = true
            emit_raw = false
        if emit_raw
            if zig_base in line
                var marker: str = zig_base + ":"
                var after: str = ""
                var found_m: bool = false
                for seg in line.split(marker)
                    if found_m
                        after = seg
                        break
                    found_m = true
                if after != ""
                    var colon_parts: List(str) = List(str)()
                    for cp in after.split(":")
                        colon_parts.add(cp)
                    if colon_parts.len >= 4
                        var line_num_str: str = colon_parts.at(0)
                        var zig_line: int = line_num_str.toInt()
                        var sev_msg: str = ""
                        var ai: int = 2
                        while ai < colon_parts.len
                            if ai > 2
                                sev_msg = sev_msg + ":"
                            sev_msg = sev_msg + colon_parts.at(ai)
                            ai = ai + 1
                        var sev_msg_t: str = sev_msg.trimLeft()
                        var is_diag: bool = sev_msg_t.startsWith("error:") or sev_msg_t.startsWith("warning:") or sev_msg_t.startsWith("note:")
                        if is_diag and zig_line > 0
                            var zbr_loc: str = findZbrComment(zig_lines, zig_line)
                            if zbr_loc != ""
                                out = out + zbr_loc + ": " + humanizeZigTypes(sev_msg_t, mod_name) + "\n"
                                skip_context = true
                                emit_raw = false
                            else if sev_msg_t.startsWith("note:")
                                # An unmappable `note:` pointing into the generated
                                # .zig (e.g. "struct declared here") is pure noise —
                                # the user never wrote that file. Suppress it and its
                                # source/caret context lines.
                                skip_context = true
                                emit_raw = false
        if emit_raw
            out = out + line + "\n"
        li = li + 1
    return out
